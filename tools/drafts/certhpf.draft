def rest2_h($KLH, +eqs: List<&2, E.QExpr>, +n: Nat, +yc: N.KVec(~K), +yr: N.KVec(~K), +q: N.NC(K), +ym: N.KMat(~K), +pc: N.KVec(~K), +pr: N.KVec(~K)) -> {CK.rest2(~L, eqs, n, $hv yc), $hv yr), $h q), $hm ym), $hv pc), $hv pr)) == CK.rest2(~K, eqs, n, yc, yr, q, ym, pc, pr) : Bool}:
  %ccon_h($T, eqs, n, yc, yr, q, ym, pc, pr) : {CK.rest2(~L, eqs, n, $hv yc), $hv yr), $h q), $hm ym), $hv pc), $hv pr)) == KA.band(_, CK.rest3(~K, eqs, n, yc, yr, ym, pc, pr)) : Bool}
  %rest3_h($T, eqs, n, yc, yr, ym, pc, pr) : {CK.rest2(~L, eqs, n, $hv yc), $hv yr), $h q), $hm ym), $hv pc), $hv pr)) == KA.band(CK.ccon(~L, eqs, n, $hv yc), $hv yr), $h q), $hm ym), $hv pc), $hv pr)), _) : Bool}
  {==}

def rest1_h($KLH, +eqs: List<&2, E.QExpr>, +n: Nat, +yc: N.KVec(~K), +yr: N.KVec(~K), +q: N.NC(K), +ym: N.KMat(~K), +pc: N.KVec(~K), +pr: N.KVec(~K)) -> {CK.rest1(~L, eqs, n, $hv yc), $hv yr), $h q), $hm ym), $hv pc), $hv pr)) == CK.rest1(~K, eqs, n, yc, yr, q, ym, pc, pr) : Bool}:
  %factor_h($T, q) : {CK.rest1(~L, eqs, n, $hv yc), $hv yr), $h q), $hm ym), $hv pc), $hv pr)) == KA.band(_, CK.rest2(~K, eqs, n, yc, yr, q, ym, pc, pr)) : Bool}
  %rest2_h($T, eqs, n, yc, yr, q, ym, pc, pr) : {CK.rest1(~L, eqs, n, $hv yc), $hv yr), $h q), $hm ym), $hv pc), $hv pr)) == KA.band(CK.factor(~L, $h q)), _) : Bool}
  {==}

def check_go_h($KLH, +eqs: List<&2, E.QExpr>, +n: Nat, +yc: N.KVec(~K), +yr: N.KVec(~K), +q: N.NC(K), +ym: N.KMat(~K), +pc: N.KVec(~K), +pr: N.KVec(~K)) -> {CK.check.go(~L, eqs, n, $hv yc), $hv yr), $h q), $hm ym), $hv pc), $hv pr)) == CK.check.go(~K, eqs, n, yc, yr, q, ym, pc, pr) : Bool}:
  %shape_h($T, eqs, n, yc, yr, ym, pc, pr) : {CK.check.go(~L, eqs, n, $hv yc), $hv yr), $h q), $hm ym), $hv pc), $hv pr)) == KA.band(_, CK.rest1(~K, eqs, n, yc, yr, q, ym, pc, pr)) : Bool}
  %rest1_h($T, eqs, n, yc, yr, q, ym, pc, pr) : {CK.check.go(~L, eqs, n, $hv yc), $hv yr), $h q), $hm ym), $hv pc), $hv pr)) == KA.band(CK.shape(~L, eqs, n, $hv yc), $hv yr), $hm ym), $hv pc), $hv pr)), _) : Bool}
  {==}

def check_c_h($KLH, +eqs: List<&2, E.QExpr>, +n: Nat, c: C.Cert<K>) -> {CK.check.c(~L, eqs, n, $hc c)) == CK.check.c(~K, eqs, n, c) : Bool}:
  match c:
    case C.Cert{+yc, +yr, +q, +ym, +pc, +pr}:
      check_go_h($T, eqs, n, yc, yr, q, ym, pc, pr)

# the checker's verdict on a certificate's image is its verdict on the
# certificate
def ccheck_h($KLH, b: C.Block, c: C.Cert<K>) -> {CK.check(~L, b, $hc c)) == CK.check(~K, b, c) : Bool}:
  match b:
    case C.Block{+eqs, +n}:
      check_c_h($T, eqs, n, c)
