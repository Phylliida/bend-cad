      {==}

# every side condition holds over the box's image exactly when over the box
def check_sides_h($KLH, +sides: List<&2, SK.Side>, +gc: N.KVec(~K), +gr: N.KVec(~K)) -> {PL.check_sides(~L, sides, $hv gc), $hv gr)) == PL.check_sides(~K, sides, gc, gr) : Bool}:
  %KP.kvle_h($T, Nil{}, gr) : {PL.check_sides(~L, sides, $hv gc), $hv gr)) == KA.band(_, PL.sides_ok(~K, CK.zipb(~K, gc, gr), sides)) : Bool}
  %sides_ok_h($T, CK.zipb(~K, gc, gr), sides) : {PL.check_sides(~L, sides, $hv gc), $hv gr)) == KA.band(KA.kvle(~L, Nil{}, $hv gr)), _) : Bool}
  %CH.zipb_h($T, gc, gr) : {PL.check_sides(~L, sides, $hv gc), $hv gr)) == KA.band(KA.kvle(~L, Nil{}, $hv gr)), PL.sides_ok(~L, _, sides)) : Bool}
  {==}
