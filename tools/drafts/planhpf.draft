  %KP.klen_h($T, gc) : {PL.check.r(~L, eqs, $hv gc), $hv gr), vp, ep, np, $hpbs bs)) == KA.band(PL.present(vp, KA.klen(~L, $hv gc)), 0n), KA.band(PL.pars_ok(_, vp), KA.band(PL.present(ep, CK.eqlen(eqs), 0n), KA.band(PL.pars_ok(CK.eqlen(eqs), ep), KA.band(PL.eqs_below(KA.klen(~K, gc), eqs), PL.check.p(~K, PL.reorder(vp, eqs, ep), PL.kperm(~K, gc, vp), PL.kperm(~K, gr, vp), np, bs)))))) : Bool}
