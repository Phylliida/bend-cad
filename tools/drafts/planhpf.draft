# the plan checks against the box's image and the plan's image exactly when
# it checks against the box and the plan
def pcheck_h($KLH, +eqs: List<&2, E.QExpr>, +gc: N.KVec(~K), +gr: N.KVec(~K), p: PL.Plan<K>) -> {PL.check(~L, eqs, $hv gc), $hv gr), $hp p)) == PL.check(~K, eqs, gc, gr, p) : Bool}:
  match p:
    case PL.Plan{+vp, +ep, +np, +bs}:
      check_r_h($T, eqs, gc, gr, vp, ep, np, bs)

# Side conditions
# ---------------

def side_ok_h($KLH, +box: List<&2, KB.KB<K>>, s: SK.Side) -> {PL.side_ok(~L, $hbv box), s) == PL.side_ok(~K, box, s) : Bool}:
  match s:
    case SK.Gt0{+e}:
      %KP.held_h($T, e) : {KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(_, KA.klt(~K, $zK, KA.ksub(~K, KB.KB.c(K, KB.kball(~K, box, e)), KB.KB.r(K, KB.kball(~K, box, e))))) : Bool}
      %KP.klt0_h($T, KA.ksub(~K, KB.KB.c(K, KB.kball(~K, box, e)), KB.KB.r(K, KB.kball(~K, box, e)))) : {KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), _) : Bool}
      %KP.ksub_h($T, KB.KB.c(K, KB.kball(~K, box, e)), KB.KB.r(K, KB.kball(~K, box, e))) : {KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), KA.klt(~L, $zL, _)) : Bool}
      %KP.kbc_h($T, KB.kball(~K, box, e)) : {KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, _, $h KB.KB.r(K, KB.kball(~K, box, e)))))) : Bool}
      %KP.kball_h($T, box, e) : {KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, KB.KB.c(L, _), $h KB.KB.r(K, KB.kball(~K, box, e)))))) : Bool}
      %KP.kbr_h($T, KB.kball(~K, box, e)) : {KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), _))) : Bool}
      %KP.kball_h($T, box, e) : {KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), KA.klt(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, _)))) : Bool}
      {==}
    case SK.Ge0{+e}:
      %KP.held_h($T, e) : {KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(_, KA.kle(~K, $zK, KA.ksub(~K, KB.KB.c(K, KB.kball(~K, box, e)), KB.KB.r(K, KB.kball(~K, box, e))))) : Bool}
      %KP.kle0_h($T, KA.ksub(~K, KB.KB.c(K, KB.kball(~K, box, e)), KB.KB.r(K, KB.kball(~K, box, e)))) : {KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), _) : Bool}
      %KP.ksub_h($T, KB.KB.c(K, KB.kball(~K, box, e)), KB.KB.r(K, KB.kball(~K, box, e))) : {KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), KA.kle(~L, $zL, _)) : Bool}
      %KP.kbc_h($T, KB.kball(~K, box, e)) : {KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, _, $h KB.KB.r(K, KB.kball(~K, box, e)))))) : Bool}
      %KP.kball_h($T, box, e) : {KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, KB.KB.c(L, _), $h KB.KB.r(K, KB.kball(~K, box, e)))))) : Bool}
      %KP.kbr_h($T, KB.kball(~K, box, e)) : {KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), _))) : Bool}
      %KP.kball_h($T, box, e) : {KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, KB.kball(~L, $hbv box), e))))) == KA.band(KB.held(~L, e), KA.kle(~L, $zL, KA.ksub(~L, KB.KB.c(L, KB.kball(~L, $hbv box), e)), KB.KB.r(L, _)))) : Bool}
      {==}

def sides_ok_h($KLH, +box: List<&2, KB.KB<K>>, ss: List<&2, SK.Side>) -> {PL.sides_ok(~L, $hbv box), ss) == PL.sides_ok(~K, box, ss) : Bool}:
  match ss:
    case Nil{}:
      {==}
    case Con{+s, +t}:
      %side_ok_h($T, box, s) : {KA.band(PL.side_ok(~L, $hbv box), s), PL.sides_ok(~L, $hbv box), t)) == KA.band(_, PL.sides_ok(~K, box, t)) : Bool}
