  %kperm_h($T, gc, vp) : {PL.check.r(~L, eqs, $hv gc), $hv gr), vp, ep, np, $hpbs bs)) == KA.band(PL.present(vp, KA.klen(~L, $hv gc)), 0n), KA.band(PL.pars_ok(KA.klen(~L, $hv gc)), vp), KA.band(PL.present(ep, CK.eqlen(eqs), 0n), KA.band(PL.pars_ok(CK.eqlen(eqs), ep), KA.band(PL.eqs_below(KA.klen(~L, $hv gc)), eqs), PL.check.p(~L, PL.reorder(vp, eqs, ep), _, $hv PL.kperm(~K, gr, vp)), np, $hpbs bs))))))) : Bool}
