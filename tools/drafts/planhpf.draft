  %ktake_h($T, n, PL.kdrop(~K, o, gc)) : {PL.block_ok(~L, $hv gc), $hv gr), es, o, n, pars, $hc c)) == KA.band(KA.natle(n, CK.eqlen(es)), KA.band(KA.natle(Nat.add(o, n), KA.klen(~L, $hv gc))), KA.band(PL.pars_ok(o, pars), KA.band(PL.eqs_below(Nat.add(o, n), PL.takeq(n, es)), KA.band(CK.check(~L, C.Block{PL.renames(o, n, pars, PL.takeq(n, es)), n}, $hc c)), KA.band(PL.kveq(~L, C.Cert.yc(L, $hc c)), _), KA.band(PL.kveq(~K, KA.kfit(~K, n, C.Cert.yr(K, c)), PL.ktake(~K, n, PL.kdrop(~K, o, gr))), PL.pcont(~K, gc, gr, pars, C.Cert.pc(K, c), C.Cert.pr(K, c))))))))) : Bool}
