# bend-cad: the plan checker (lib/plan.bend) gives the same verdict through
# a map of computing numbers h : K -> L (lib/khom.bend): PL.check in L of the
# box's and the plan's images is PL.check in K of the box and the plan, and
# so is PL.check_sides. Untrusted; for the word verdict (PLAN-sk13w W5).

@MACRO KLH ~K: N.Num, ~L: N.Num, ~H: KH.Hom<K, L>
@MACRO T ~K, ~L, ~H
@MACRO h KH.hmap(K, L, H,
@MACRO hv KH.hv(~K, ~L, ~H,
@MACRO hb KH.hball(~K, ~L, ~H,
@MACRO hbv KH.hbv(~K, ~L, ~H,
@MACRO hc KH.hcert(~K, ~L, ~H,
@MACRO hpbs KH.hpbs(~K, ~L, ~H,
@MACRO hp KH.hplan(~K, ~L, ~H,
@MACRO VL N.KVec(~L)
@MACRO HADD KH.h_add(K, L, H)
@MACRO HCMP KH.h_cmp(K, L, H)
@MACRO zK N.nzero(K)
@MACRO zL N.nzero(L)

import Base
import ../spec/ring.bend as E
import ../spec/knum.bend as N
import ../spec/sketch.bend as SK
import ./certdef.bend as C
import ./karith.bend as KA
import ./kball.bend as KB
import ./cert.bend as CK
import ./plan.bend as PL
import ./khom.bend as KH
import ./khompf.bend as KP
import ./certhpf.bend as CH

# Lists and equality
# ------------------

def ktake_h($KLH, n: Nat, u: N.KVec(~K)) -> {PL.ktake(~L, n, $hv u)) == $hv PL.ktake(~K, n, u)) : $VL}:
  match n u:
    case 0n u:
      {==}
    case 1n++k Nil{}:
      {==}
    case 1n++k Con{+a, +t}:
      %ktake_h($T, k, t) : {Con{$h a), PL.ktake(~L, k, $hv t))} == Con{$h a), _} : $VL}
      {==}

def pkdrop_h($KLH, n: Nat, u: N.KVec(~K)) -> {PL.kdrop(~L, n, $hv u)) == $hv PL.kdrop(~K, n, u)) : $VL}:
  match n u:
    case 0n u:
      {==}
    case 1n+k Nil{}:
      {==}
    case 1n+k Con{a, t}:
      pkdrop_h($T, k, t)

def keq_h($KLH, +a: N.NC(K), +b: N.NC(K)) -> {PL.keq(~L, $h a), $h b)) == PL.keq(~K, a, b) : Bool}:
  %$HCMP(a, b) : {PL.keq.go(N.ncmp(L, $h a), $h b))) == PL.keq.go(_) : Bool}
  {==}

def keq0r_h($KLH, +a: N.NC(K)) -> {PL.keq(~L, $h a), $zL) == PL.keq(~K, a, $zK) : Bool}:
  %KP.hz_r($T) : {PL.keq(~L, $h a), _) == PL.keq(~K, a, $zK) : Bool}
  keq_h($T, a, $zK)

def kveq_h($KLH, u: N.KVec(~K), w: N.KVec(~K)) -> {PL.kveq(~L, $hv u), $hv w)) == PL.kveq(~K, u, w) : Bool}:
  match u w:
    case Nil{} Nil{}:
      {==}
    case Nil{} Con{+b, +ws}:
      {==}
    case Con{+a, +us} Nil{}:
      {==}
    case Con{+a, +us} Con{+b, +ws}:
      %keq_h($T, a, b) : {KA.band(PL.keq(~L, $h a), $h b)), PL.kveq(~L, $hv us), $hv ws))) == KA.band(_, PL.kveq(~K, us, ws)) : Bool}
      %kveq_h($T, us, ws) : {KA.band(PL.keq(~L, $h a), $h b)), PL.kveq(~L, $hv us), $hv ws))) == KA.band(PL.keq(~L, $h a), $h b)), _) : Bool}
      {==}

def pinz_h($KLH, np: Nat, gr: N.KVec(~K)) -> {PL.pinz(~L, np, $hv gr)) == PL.pinz(~K, np, gr) : Bool}:
  match np gr:
    case 0n gr:
      {==}
    case 1n++k Nil{}:
      {==}
    case 1n++k Con{+x, +t}:
      %keq0r_h($T, x) : {KA.band(PL.keq(~L, $h x), $zL), PL.pinz(~L, k, $hv t))) == KA.band(_, PL.pinz(~K, k, t)) : Bool}
      %pinz_h($T, k, t) : {KA.band(PL.keq(~L, $h x), $zL), PL.pinz(~L, k, $hv t))) == KA.band(PL.keq(~L, $h x), $zL), _) : Bool}
      {==}

# The checker
# -----------

def pcont_h($KLH, +gc: N.KVec(~K), +gr: N.KVec(~K), pars: List<&2, Nat>, pc: N.KVec(~K), pr: N.KVec(~K)) -> {PL.pcont(~L, $hv gc), $hv gr), pars, $hv pc), $hv pr)) == PL.pcont(~K, gc, gr, pars, pc, pr) : Bool}:
  match pars pc pr:
    case Nil{} Nil{} Nil{}:
      {==}
    case Nil{} Nil{} Con{+r, +rs}:
      {==}
    case Nil{} Con{+c, +cs} Nil{}:
      {==}
    case Nil{} Con{+c, +cs} Con{+r, +rs}:
      {==}
    case Con{+v, +vs} Nil{} Nil{}:
      {==}
    case Con{+v, +vs} Nil{} Con{+r, +rs}:
      {==}
    case Con{+v, +vs} Con{+c, +cs} Nil{}:
      {==}
    case Con{+v, +vs} Con{+c, +cs} Con{+r, +rs}:
      %KP.kle_h($T, N.nadd(K, KA.kabs(~K, KA.ksub(~K, KB.klook(~K, gc, v), c)), KB.klook(~K, gr, v)), r) : {KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, KA.ksub(~L, KB.klook(~L, $hv gc), v), $h c))), KB.klook(~L, $hv gr), v)), $h r)), PL.pcont(~L, $hv gc), $hv gr), vs, $hv cs), $hv rs))) == KA.band(_, PL.pcont(~K, gc, gr, vs, cs, rs)) : Bool}
      %$HADD(KA.kabs(~K, KA.ksub(~K, KB.klook(~K, gc, v), c)), KB.klook(~K, gr, v)) : {KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, KA.ksub(~L, KB.klook(~L, $hv gc), v), $h c))), KB.klook(~L, $hv gr), v)), $h r)), PL.pcont(~L, $hv gc), $hv gr), vs, $hv cs), $hv rs))) == KA.band(KA.kle(~L, _, $h r)), PL.pcont(~K, gc, gr, vs, cs, rs)) : Bool}
      %KP.kabs_h($T, KA.ksub(~K, KB.klook(~K, gc, v), c)) : {KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, KA.ksub(~L, KB.klook(~L, $hv gc), v), $h c))), KB.klook(~L, $hv gr), v)), $h r)), PL.pcont(~L, $hv gc), $hv gr), vs, $hv cs), $hv rs))) == KA.band(KA.kle(~L, N.nadd(L, _, $h KB.klook(~K, gr, v))), $h r)), PL.pcont(~K, gc, gr, vs, cs, rs)) : Bool}
      %KP.ksub_h($T, KB.klook(~K, gc, v), c) : {KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, KA.ksub(~L, KB.klook(~L, $hv gc), v), $h c))), KB.klook(~L, $hv gr), v)), $h r)), PL.pcont(~L, $hv gc), $hv gr), vs, $hv cs), $hv rs))) == KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, _), $h KB.klook(~K, gr, v))), $h r)), PL.pcont(~K, gc, gr, vs, cs, rs)) : Bool}
      %KP.klook_h($T, gc, v) : {KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, KA.ksub(~L, KB.klook(~L, $hv gc), v), $h c))), KB.klook(~L, $hv gr), v)), $h r)), PL.pcont(~L, $hv gc), $hv gr), vs, $hv cs), $hv rs))) == KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, KA.ksub(~L, _, $h c))), $h KB.klook(~K, gr, v))), $h r)), PL.pcont(~K, gc, gr, vs, cs, rs)) : Bool}
      %KP.klook_h($T, gr, v) : {KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, KA.ksub(~L, KB.klook(~L, $hv gc), v), $h c))), KB.klook(~L, $hv gr), v)), $h r)), PL.pcont(~L, $hv gc), $hv gr), vs, $hv cs), $hv rs))) == KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, KA.ksub(~L, KB.klook(~L, $hv gc), v), $h c))), _), $h r)), PL.pcont(~K, gc, gr, vs, cs, rs)) : Bool}
      %pcont_h($T, gc, gr, vs, cs, rs) : {KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, KA.ksub(~L, KB.klook(~L, $hv gc), v), $h c))), KB.klook(~L, $hv gr), v)), $h r)), PL.pcont(~L, $hv gc), $hv gr), vs, $hv cs), $hv rs))) == KA.band(KA.kle(~L, N.nadd(L, KA.kabs(~L, KA.ksub(~L, KB.klook(~L, $hv gc), v), $h c))), KB.klook(~L, $hv gr), v)), $h r)), _) : Bool}
      {==}

# a block's checks
def block_ok_h($KLH, +gc: N.KVec(~K), +gr: N.KVec(~K), +es: List<&2, E.QExpr>, +o: Nat, +n: Nat, +pars: List<&2, Nat>, +c: C.Cert<K>) -> {PL.block_ok(~L, $hv gc), $hv gr), es, o, n, pars, $hc c)) == PL.block_ok(~K, gc, gr, es, o, n, pars, c) : Bool}:
