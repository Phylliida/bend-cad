  %KP.kfit_h($T, n, C.Cert.yr(K, c)) : {PL.block_ok(~L, $hv gc), $hv gr), es, o, n, pars, $hc c)) == KA.band(KA.natle(n, CK.eqlen(es)), KA.band(KA.natle(Nat.add(o, n), KA.klen(~L, $hv gc))), KA.band(PL.pars_ok(o, pars), KA.band(PL.eqs_below(Nat.add(o, n), PL.takeq(n, es)), KA.band(CK.check(~L, C.Block{PL.renames(o, n, pars, PL.takeq(n, es)), n}, $hc c)), KA.band(PL.kveq(~L, C.Cert.yc(L, $hc c)), PL.ktake(~L, n, PL.kdrop(~L, o, $hv gc)))), KA.band(PL.kveq(~L, _, $hv PL.ktake(~K, n, PL.kdrop(~K, o, gr)))), PL.pcont(~K, gc, gr, pars, C.Cert.pc(K, c), C.Cert.pr(K, c))))))))) : Bool}
  %CH.yr_h($T, c) : {PL.block_ok(~L, $hv gc), $hv gr), es, o, n, pars, $hc c)) == KA.band(KA.natle(n, CK.eqlen(es)), KA.band(KA.natle(Nat.add(o, n), KA.klen(~L, $hv gc))), KA.band(PL.pars_ok(o, pars), KA.band(PL.eqs_below(Nat.add(o, n), PL.takeq(n, es)), KA.band(CK.check(~L, C.Block{PL.renames(o, n, pars, PL.takeq(n, es)), n}, $hc c)), KA.band(PL.kveq(~L, C.Cert.yc(L, $hc c)), PL.ktake(~L, n, PL.kdrop(~L, o, $hv gc)))), KA.band(PL.kveq(~L, KA.kfit(~L, n, _), $hv PL.ktake(~K, n, PL.kdrop(~K, o, gr)))), PL.pcont(~K, gc, gr, pars, C.Cert.pc(K, c), C.Cert.pr(K, c))))))))) : Bool}
  %ktake_h($T, n, PL.kdrop(~K, o, gr)) : {PL.block_ok(~L, $hv gc), $hv gr), es, o, n, pars, $hc c)) == KA.band(KA.natle(n, CK.eqlen(es)), KA.band(KA.natle(Nat.add(o, n), KA.klen(~L, $hv gc))), KA.band(PL.pars_ok(o, pars), KA.band(PL.eqs_below(Nat.add(o, n), PL.takeq(n, es)), KA.band(CK.check(~L, C.Block{PL.renames(o, n, pars, PL.takeq(n, es)), n}, $hc c)), KA.band(PL.kveq(~L, C.Cert.yc(L, $hc c)), PL.ktake(~L, n, PL.kdrop(~L, o, $hv gc)))), KA.band(PL.kveq(~L, KA.kfit(~L, n, C.Cert.yr(L, $hc c))), _), PL.pcont(~K, gc, gr, pars, C.Cert.pc(K, c), C.Cert.pr(K, c))))))))) : Bool}
  %pkdrop_h($T, o, gr) : {PL.block_ok(~L, $hv gc), $hv gr), es, o, n, pars, $hc c)) == KA.band(KA.natle(n, CK.eqlen(es)), KA.band(KA.natle(Nat.add(o, n), KA.klen(~L, $hv gc))), KA.band(PL.pars_ok(o, pars), KA.band(PL.eqs_below(Nat.add(o, n), PL.takeq(n, es)), KA.band(CK.check(~L, C.Block{PL.renames(o, n, pars, PL.takeq(n, es)), n}, $hc c)), KA.band(PL.kveq(~L, C.Cert.yc(L, $hc c)), PL.ktake(~L, n, PL.kdrop(~L, o, $hv gc)))), KA.band(PL.kveq(~L, KA.kfit(~L, n, C.Cert.yr(L, $hc c))), PL.ktake(~L, n, _)), PL.pcont(~K, gc, gr, pars, C.Cert.pc(K, c), C.Cert.pr(K, c))))))))) : Bool}
