  %look0_vhd(~F, GJ.vdrop(~F, c, x)) : {@A(@N(M.dot(~F, GJ.vtake(~F, c, x), pcol(~F, s, c))), @A(@M(_, @1), @0)) == @A(@N(M.dot(~F, GJ.vtake(~F, c, x), pcol(~F, s, c))), @A(@M(O.lookup(~F, x, c), @1), @0)) : @T}
