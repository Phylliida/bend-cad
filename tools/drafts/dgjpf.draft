def ac2_nn(~F: O.OField, +bb: @T, +st: KS(~F), +hb: O.le(~F, @0, bb), +hk: KNN(~F, st)) -> O.le(~F, @0, ac2(~F, bb, st)):
  FO.nonneg_add(~F, @FT[ac | (G * ((b + b) * H))], @FT[ac | (G * ((b + b) * H))], FO.mul_nonneg(~F, @FT[ac | G], @FT[ac | ((b + b) * H)], knn_g(~F, st, hk), FO.mul_nonneg(~F, @FT[ac | (b + b)], @FT[ac | H], FO.nonneg_add(~F, @FT[ac | b], @FT[ac | b], hb, hb), knn_h(~F, st, hk))), FO.mul_nonneg(~F, @FT[ac | G], @FT[ac | ((b + b) * H)], knn_g(~F, st, hk), FO.mul_nonneg(~F, @FT[ac | (b + b)], @FT[ac | H], FO.nonneg_add(~F, @FT[ac | b], @FT[ac | b], hb, hb), knn_h(~F, st, hk))))

