      GJ.all_at(~(q => M.bnd(~F, @S(O.lookup(~F, x, q), GJ.dl(~F, KA.nateq(i, q))), ph)), c, hf, j, (%GJ.len_vadd(~F, GJ.vtake(~F, c, x), M.vneg(~F, GJ.unit(~F, c, i)), c, Equal.sym(Nat, c, M.len(~F, GJ.vtake(~F, c, x)), GJ.len_vtake(~F, c, x, hcx)), Equal.trans(Nat, M.len(~F, M.vneg(~F, GJ.unit(~F, c, i))), M.len(~F, GJ.unit(~F, c, i)), c, Equal.sym(Nat, M.len(~F, GJ.unit(~F, c, i)), M.len(~F, M.vneg(~F, GJ.unit(~F, c, i))), GJ.len_vneg(~F, GJ.unit(~F, c, i))), Equal.sym(Nat, c, M.len(~F, GJ.unit(~F, c, i)), GJ.len_unit(~F, c, i)))) : {KA.natle(1n+j, _) == True{} : Bool} hj)))))

# |(x_<c - e_i) . p| <= c phi G
def dd_bnd(~F: O.OField, +x: M.Vec(~F), +c: Nat, +i: Nat, +ph: @T, +gg: @T, +p: M.Vec(~F), +hf: fin(~F, x, i, c, ph), +hcx: {KA.natle(c, M.len(~F, x)) == True{} : Bool}, +hp: M.vbnd.all(~F, p, gg), +lp: {M.len(~F, p) == c : Nat}, +hgg: O.le(~F, @0, gg), +hph: O.le(~F, @0, ph)) -> M.bnd(~F, M.dot(~F, M.vadd(~F, GJ.vtake(~F, c, x), M.vneg(~F, GJ.unit(~F, c, i))), p), @M(@M(FR.ofn(~F, c), ph), gg)):
