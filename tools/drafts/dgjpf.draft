    FM.bnd_add(~F, O.ofq(~F, S.Q.div(S.D.toq(NU.done()), S.D.toq(x))), FV.fabs(~F, O.ofq(~F, S.Q.div(S.D.toq(NU.done()), S.D.toq(x)))), @S(M.ofd(~F, NU.dsdiv(w, NU.done(), x)), O.ofq(~F, S.Q.div(S.D.toq(NU.done()), S.D.toq(x)))), @M(FV.fabs(~F, O.ofq(~F, S.Q.div(S.D.toq(NU.done()), S.D.toq(x)))), M.ofd(~F, S.D{S.Zpos{S.XH{}}, w})), FV.fabs_bnd(~F, O.ofq(~F, S.Q.div(S.D.toq(NU.done()), S.D.toq(x)))), s_err(~F, w, x)))

# the pivot row's invariant, read at index c
def col_hx(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +rows: List<&2, List<&2, S.D>>, +c: Nat, +r: Nat, +gg: @T, +dd: @T, +ph: @T, +hs: rinv(~F, n, jm, M.ofdm(~F, NU.dswap(rows, c, r)), 0n, c, gg, dd, ph), +hnt: {GJ.nrows(~F, M.ofdm(~F, NU.dswap(rows, c, r))) == n : Nat}, +hc: {KA.natle(1n+c, n) == True{} : Bool}) -> rowinv(~F, n, jm, M.ofdv(~F, NU.drow(NU.dswap(rows, c, r), c)), c, c, gg, dd, ph):
