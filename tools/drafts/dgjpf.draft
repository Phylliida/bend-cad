def pc_hi(~F: O.OField, +s: M.Mat(~F), +c: Nat, +i: Nat, +h: {KA.natle(c, i) == True{} : Bool}) -> {O.lookup(~F, pcol(~F, s, c), i) == @0 : @T}:
