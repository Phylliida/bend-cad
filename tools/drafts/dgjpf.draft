# every row of the cleared matrix, rows numbered from i
def clear_ok(~F: O.OField, rows: List<&2, List<&2, S.D>>, +n: Nat, +jm: M.Mat(~F), +w: Nat, +p: List<&2, S.D>, +c: Nat, +gg: @T, +dd: @T, +ph: @T, +gp: @T, +dp: @T, +pp: @T, +g: @T, +hp: rowinv(~F, n, jm, M.ofdv(~F, p), c, 1n+c, gp, dp, pp), +hgg: O.le(~F, @0, gg), +hdd: O.le(~F, @0, dd), +hph: O.le(~F, @0, ph), +hgp: O.le(~F, @0, gp), +hdp: O.le(~F, @0, dp), +hpp: O.le(~F, @0, pp), +hj: mall(~F, jm, g), +hg: O.le(~F, @0, g), +hn: {GJ.nrows(~F, jm) == n : Nat}, +hu: O.le(~F, M.ofd(~F, S.D{S.Zpos{S.XH{}}, w}), @1), +i: Nat, h: rinv(~F, n, jm, M.ofdm(~F, rows), i, c, gg, dd, ph)) -> rinv(~F, n, jm, M.ofdm(~F, NU.dclear(rows, w, p, c, i)), i, 1n+c, gnew(~F, gg, gp, @M(@A(gg, @A(@A(@M(gg, gp), @M(gg, gp)), @M(gg, gp))), M.ofd(~F, S.D{S.Zpos{S.XH{}}, w}))), dnew(~F, n, g, gg, dd, dp, @M(@A(gg, @A(@A(@M(gg, gp), @M(gg, gp)), @M(gg, gp))), M.ofd(~F, S.D{S.Zpos{S.XH{}}, w}))), pnew(~F, gg, ph, pp, @M(@A(gg, @A(@A(@M(gg, gp), @M(gg, gp)), @M(gg, gp))), M.ofd(~F, S.D{S.Zpos{S.XH{}}, w})))):
