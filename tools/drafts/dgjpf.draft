# x_<c . p = (x_<c - e_i) . p + p_i
def dsplit(~F: O.OField, +x: M.Vec(~F), +c: Nat, +i: Nat, +p: M.Vec(~F), +hl: {KA.natle(M.len(~F, p), c) == True{} : Bool}) -> {M.dot(~F, GJ.vtake(~F, c, x), p) == @A(M.dot(~F, M.vadd(~F, GJ.vtake(~F, c, x), M.vneg(~F, GJ.unit(~F, c, i))), p), O.lookup(~F, p, i)) : @T}:
