@ATOMS pt = b=bb,, H=hh,, cc=FR.ofn(~F, c),, nn=FR.ofn(~F, n),, G=gg,, D=kd,, P=kp,, m,, u

# the pivot bound with the smallness: 1 <= 2 beta H m
def piv_two(~F: O.OField, +n: Nat, +c: Nat, +bb: @T, +hh: @T, +gg: @T, +kd: @T, +kp: @T, +m: @T, +u: @T, +hk: O.le(~F, @1, @M(@M(bb, hh), @A(@A(@M(@M(FR.ofn(~F, c), @M(kp, u)), gg), m), @M(@M(FR.ofn(~F, n), @M(kd, u)), @A(@1, gg))))), +ha: O.le(~F, @M(u, @FT[pt | ((b*H) + (b*H))*((cc*P)*G + (nn*D)*(1 + G))]), @1)) -> O.le(~F, @1, @M(@A(@M(bb, hh), @M(bb, hh)), m)):
  FV.le_of_sub(~F, @1, @M(@A(@M(bb, hh), @M(bb, hh)), m), FM.nn_eq(~F, @S(@M(@A(@M(bb, hh), @M(bb, hh)), m), @1), @FT[pt | ((((b*H)*((((cc*(P*u))*G) + m) + (nn*(D*u))*(1 + G))) - 1) + (((b*H)*((((cc*(P*u))*G) + m) + (nn*(D*u))*(1 + G))) - 1)) + (1 - u*(((b*H) + (b*H))*((cc*P)*G + (nn*D)*(1 + G))))],
    @ZEQ[pt | ((((b*H)*((((cc*(P*u))*G) + m) + (nn*(D*u))*(1 + G))) - 1) + (((b*H)*((((cc*(P*u))*G) + m) + (nn*(D*u))*(1 + G))) - 1)) + (1 - u*(((b*H) + (b*H))*((cc*P)*G + (nn*D)*(1 + G)))) | ((b*H) + (b*H))*m - 1],
    FO.nonneg_add(~F, @FT[pt | (((b*H)*((((cc*(P*u))*G) + m) + (nn*(D*u))*(1 + G))) - 1) + (((b*H)*((((cc*(P*u))*G) + m) + (nn*(D*u))*(1 + G))) - 1)], @FT[pt | 1 - u*(((b*H) + (b*H))*((cc*P)*G + (nn*D)*(1 + G)))],
      FO.nonneg_add(~F, @FT[pt | ((b*H)*((((cc*(P*u))*G) + m) + (nn*(D*u))*(1 + G))) - 1], @FT[pt | ((b*H)*((((cc*(P*u))*G) + m) + (nn*(D*u))*(1 + G))) - 1], FM.sub_nonneg(~F, @1, @FT[pt | (b*H)*((((cc*(P*u))*G) + m) + (nn*(D*u))*(1 + G))], hk), FM.sub_nonneg(~F, @1, @FT[pt | (b*H)*((((cc*(P*u))*G) + m) + (nn*(D*u))*(1 + G))], hk)),
      FM.sub_nonneg(~F, @FT[pt | u*(((b*H) + (b*H))*((cc*P)*G + (nn*D)*(1 + G)))], @1, ha))))

@ATOMS qb = aq=FV.fabs(~F, q),, ap=FV.fabs(~F, p),, B=bv

# 1 <= B m, m <= |p| and q p = 1: |q| <= B
def qle(~F: O.OField, +q: @T, +p: @T, +m: @T, +bv: @T, +h1: O.le(~F, @1, @M(bv, m)), +hmp: O.le(~F, m, FV.fabs(~F, p)), +hq: {@M(q, p) == @1 : @T}, +hb0: O.le(~F, @0, bv)) -> O.le(~F, FV.fabs(~F, q), bv):
  FV.le_of_sub(~F, FV.fabs(~F, q), bv, FM.nn_eq(~F, @S(bv, FV.fabs(~F, q)), @FT[qb | aq*(B*ap - 1)], @CERTEQ[qb | aq*(B*ap - 1) | B - aq | B ; aq*ap - 1 || FO.sub_of_eq(~F, @M(FV.fabs(~F, q), FV.fabs(~F, p)), @1, fabs_inv(~F, q, p, hq))],
    FO.mul_nonneg(~F, FV.fabs(~F, q), @FT[qb | B*ap - 1], FV.fabs_nn(~F, q), FM.sub_nonneg(~F, @1, @M(bv, FV.fabs(~F, p)), DM.le_trans(~F, @1, @M(bv, m), @M(bv, FV.fabs(~F, p)), h1, FV.mul_le(~F, bv, m, FV.fabs(~F, p), hb0, hmp))))))

# a zero pivot would make every candidate 0
def pnz(~F: O.OField, +x: S.D, +bv: @T, +h1: O.le(~F, @1, @M(bv, M.ofd(~F, NU.dabs(x)))), +hb0: O.le(~F, @0, bv), +e: {M.ofd(~F, x) == @0 : @T}) -> Empty:
  RL.le_lt_absurd(~F, @1, @0, (%@ZEQ[B=bv | B*0 | 0] : O.le(~F, @1, _)
      DM.le_trans(~F, @1, @M(bv, M.ofd(~F, NU.dabs(x))), @M(bv, @0), h1, FV.mul_le(~F, bv, M.ofd(~F, NU.dabs(x)), @0, hb0,
        BP.kabs_le(~KI.dnum(), ~F, ~KI.demb(~F), x, @0, (%Equal.sym(@T, M.ofd(~F, x), @0, e) : M.bnd(~F, _, @0)
          FM.bnd_zero(~F, @0, FO.le_refl(~F, @0))))))),
    O.zero_lt_one(F))

# the scan's candidate bounds, read in F
def cbF(~F: O.OField, +rows: List<&2, List<&2, S.D>>, +c: Nat, +m: @T, +n: Nat, h: GJ.All(~(j => cb(~F, rows, c, c, m, j)), GJ.nrows(~F, M.ofdm(~F, rows))), +hns: {GJ.nrows(~F, M.ofdm(~F, rows)) == n : Nat}) -> GJ.All(~(j => cnd(KA.natle(c, j), M.bnd(~F, O.lookup(~F, DV.mrow(~F, M.ofdm(~F, rows), j), c), m))), n):
  %hns : GJ.All(~(j => cnd(KA.natle(c, j), M.bnd(~F, O.lookup(~F, DV.mrow(~F, M.ofdm(~F, rows), j), c), m))), _)
  all_map(~(j => cb(~F, rows, c, c, m, j)), ~(j => cnd(KA.natle(c, j), M.bnd(~F, O.lookup(~F, DV.mrow(~F, M.ofdm(~F, rows), j), c), m))), ~(j => q =>
    (%drow_ofd(~F, rows, j) : cnd(KA.natle(c, j), M.bnd(~F, O.lookup(~F, _, c), m))
      (%dget_ofd(~F, NU.drow(rows, j), c) : cnd(KA.natle(c, j), M.bnd(~F, _, m))
        q))), GJ.nrows(~F, M.ofdm(~F, rows)), h)

def hc1(+c: Nat, +rest: Nat, +n: Nat, +hrest: {Nat.add(c, 1n+rest) == n : Nat}) -> {KA.natle(1n+c, n) == True{} : Bool}:
  %hrest : {KA.natle(1n+c, _) == True{} : Bool}
  %LN.add_succ(c, rest) : {KA.natle(1n+c, _) == True{} : Bool}
  le_add_r(c, rest)

@ATOMS sq0 = aq=FV.fabs(~F, q),, u,, b=bb,, H=hh
@ATOMS sq = aq=FV.fabs(~F, q),, u,, b=bb,, H=hh,, G=gg

# |s| <= |q| (1 + u) <= 4 beta H
def sg_le(~F: O.OField, +q: @T, +u: @T, +bb: @T, +hh: @T, +hq: O.le(~F, FV.fabs(~F, q), @A(@M(bb, hh), @M(bb, hh))), +hu: O.le(~F, u, @1)) -> O.le(~F, @A(FV.fabs(~F, q), @M(FV.fabs(~F, q), u)), sgb(~F, bb, hh)):
  FV.le_of_sub(~F, @A(FV.fabs(~F, q), @M(FV.fabs(~F, q), u)), sgb(~F, bb, hh), FM.nn_eq(~F, @S(sgb(~F, bb, hh), @A(FV.fabs(~F, q), @M(FV.fabs(~F, q), u))), @FT[sq0 | (((b*H + b*H) - aq) + ((b*H + b*H) - aq)) + aq*(1 - u)], @ZEQ[sq0 | (((b*H + b*H) - aq) + ((b*H + b*H) - aq)) + aq*(1 - u) | ((b + b)*H + (b + b)*H) - (aq + aq*u)],
    FO.nonneg_add(~F, @FT[sq0 | ((b*H + b*H) - aq) + ((b*H + b*H) - aq)], @FT[sq0 | aq*(1 - u)], FO.nonneg_add(~F, @FT[sq0 | (b*H + b*H) - aq], @FT[sq0 | (b*H + b*H) - aq], FM.sub_nonneg(~F, FV.fabs(~F, q), @A(@M(bb, hh), @M(bb, hh)), hq), FM.sub_nonneg(~F, FV.fabs(~F, q), @A(@M(bb, hh), @M(bb, hh)), hq)), FO.mul_nonneg(~F, FV.fabs(~F, q), @S(@1, u), FV.fabs_nn(~F, q), FM.sub_nonneg(~F, u, @1, hu)))))

# 2 G |q| u <= 1, for col_low
def hsm_of(~F: O.OField, +q: @T, +u: @T, +bb: @T, +hh: @T, +gg: @T, +hq: O.le(~F, FV.fabs(~F, q), @A(@M(bb, hh), @M(bb, hh))), +ha: O.le(~F, @M(u, @A(@M(gg, @M(@A(bb, bb), hh)), @M(gg, @M(@A(bb, bb), hh)))), @1), +hu0: O.le(~F, @0, u), +hg0: O.le(~F, @0, gg)) -> O.le(~F, @A(@M(gg, @M(FV.fabs(~F, q), u)), @M(gg, @M(FV.fabs(~F, q), u))), @1):
  FV.le_of_sub(~F, @A(@M(gg, @M(FV.fabs(~F, q), u)), @M(gg, @M(FV.fabs(~F, q), u))), @1, FM.nn_eq(~F, @S(@1, @A(@M(gg, @M(FV.fabs(~F, q), u)), @M(gg, @M(FV.fabs(~F, q), u)))), @FT[sq | (1 - u*(G*((b + b)*H) + G*((b + b)*H))) + ((G*u) + (G*u))*((b*H + b*H) - aq)], @ZEQ[sq | (1 - u*(G*((b + b)*H) + G*((b + b)*H))) + ((G*u) + (G*u))*((b*H + b*H) - aq) | 1 - (G*(aq*u) + G*(aq*u))],
    FO.nonneg_add(~F, @FT[sq | 1 - u*(G*((b + b)*H) + G*((b + b)*H))], @FT[sq | ((G*u) + (G*u))*((b*H + b*H) - aq)], FM.sub_nonneg(~F, @FT[sq | u*(G*((b + b)*H) + G*((b + b)*H))], @1, ha),
      FO.mul_nonneg(~F, @FT[sq | (G*u) + (G*u)], @FT[sq | (b*H + b*H) - aq], FO.nonneg_add(~F, @M(gg, u), @M(gg, u), FO.mul_nonneg(~F, gg, u, hg0, hu0), FO.mul_nonneg(~F, gg, u, hg0, hu0)), FM.sub_nonneg(~F, FV.fabs(~F, q), @A(@M(bb, hh), @M(bb, hh)), hq)))))

@ATOMS hbB = s=sg,, G=gg,, u=M.ofd(~F, S.D{S.Zpos{S.XH{}}, w}),, H=hh,, nn=FR.ofn(~F, n)

