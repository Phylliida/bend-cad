        ri_at(~F, n, jm, M.ofdm(~F, rows), 0n, c, gg, dd, ph, c, h, (%Equal.sym(Nat, GJ.nrows(~F, M.ofdm(~F, rows)), n, hn) : {KA.natle(1n+c, _) == True{} : Bool}
