# Right halves
# ------------
# The right parts R of the rows keep an inverse of bounded norm. Read
# against a vector u, a row x gives zr(x) = R_x . u; one column step
# changes these numbers by the step's row operations and a rounding term,
# and inverting that by hand bounds |R u| by |R' u| and |u|.

def zr(~F: O.OField, +n: Nat, +x: M.Vec(~F), +u: M.Vec(~F)) -> @T:
  M.dot(~F, GJ.vdrop(~F, n, x), u)

# zr of x - y
def zr_sub(~F: O.OField, +n: Nat, +x: M.Vec(~F), +y: M.Vec(~F), +u: M.Vec(~F)) -> {zr(~F, n, M.vadd(~F, x, M.vneg(~F, y)), u) == @S(zr(~F, n, x, u), zr(~F, n, y, u)) : @T}:
  %drop_vadd(~F, n, x, M.vneg(~F, y)) : {M.dot(~F, _, u) == @S(zr(~F, n, x, u), zr(~F, n, y, u)) : @T}
  %drop_vneg(~F, n, y) : {M.dot(~F, M.vadd(~F, GJ.vdrop(~F, n, x), _), u) == @S(zr(~F, n, x, u), zr(~F, n, y, u)) : @T}
  %FM.dot_vadd(~F, GJ.vdrop(~F, n, x), M.vneg(~F, GJ.vdrop(~F, n, y)), u) : {_ == @S(zr(~F, n, x, u), zr(~F, n, y, u)) : @T}
  %FM.dot_vneg(~F, GJ.vdrop(~F, n, y), u) : {@A(M.dot(~F, GJ.vdrop(~F, n, x), u), _) == @S(zr(~F, n, x, u), zr(~F, n, y, u)) : @T}
  @ZEQ[zx=M.dot(~F, GJ.vdrop(~F, n, x), u),, zy=M.dot(~F, GJ.vdrop(~F, n, y), u) | zx + -zy | zx - zy]

# zr of x + (-m) p
def zr_axpy(~F: O.OField, +n: Nat, +x: M.Vec(~F), +m: @T, +p: M.Vec(~F), +u: M.Vec(~F)) -> {zr(~F, n, M.vadd(~F, x, M.vscale(~F, @N(m), p)), u) == @A(zr(~F, n, x, u), @M(@N(m), zr(~F, n, p, u))) : @T}:
  %drop_vadd(~F, n, x, M.vscale(~F, @N(m), p)) : {M.dot(~F, _, u) == @A(zr(~F, n, x, u), @M(@N(m), zr(~F, n, p, u))) : @T}
  %drop_vscale(~F, n, @N(m), p) : {M.dot(~F, M.vadd(~F, GJ.vdrop(~F, n, x), _), u) == @A(zr(~F, n, x, u), @M(@N(m), zr(~F, n, p, u))) : @T}
  %FM.dot_vadd(~F, GJ.vdrop(~F, n, x), M.vscale(~F, @N(m), GJ.vdrop(~F, n, p)), u) : {_ == @A(zr(~F, n, x, u), @M(@N(m), zr(~F, n, p, u))) : @T}
  %FM.dot_vscale(~F, @N(m), GJ.vdrop(~F, n, p), u) : {@A(M.dot(~F, GJ.vdrop(~F, n, x), u), _) == @A(zr(~F, n, x, u), @M(@N(m), zr(~F, n, p, u))) : @T}
  {==}

# zr of s x
def zr_scale(~F: O.OField, +n: Nat, +s: @T, +x: M.Vec(~F), +u: M.Vec(~F)) -> {zr(~F, n, M.vscale(~F, s, x), u) == @M(s, zr(~F, n, x, u)) : @T}:
  %drop_vscale(~F, n, s, x) : {M.dot(~F, _, u) == @M(s, zr(~F, n, x, u)) : @T}
  %FM.dot_vscale(~F, s, GJ.vdrop(~F, n, x), u) : {_ == @M(s, zr(~F, n, x, u)) : @T}
  {==}

# an error row: |zr(e)| <= n eps |u|
def zerr(~F: O.OField, +n: Nat, +e: M.Vec(~F), +u: M.Vec(~F), +ep: @T, +he: M.vbnd.all(~F, e, ep), +hep: O.le(~F, @0, ep), lu: {M.len(~F, u) == n : Nat}) -> M.bnd(~F, zr(~F, n, e, u), @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u))):
  FM.bnd_mono(~F, zr(~F, n, e, u), @M(NP.rowabs(~F, GJ.vdrop(~F, n, e), n), NP.vn(~F, u)), @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)),
    (%lu : M.bnd(~F, zr(~F, n, e, u), @M(NP.rowabs(~F, GJ.vdrop(~F, n, e), _), NP.vn(~F, u)))
      NP.dot_le(~F, GJ.vdrop(~F, n, e), u, NP.vn(~F, u), FV.vmax_all(~F, u), FV.vmax_nn(~F, u))),
    FM.sub_nonneg(~F, @M(NP.rowabs(~F, GJ.vdrop(~F, n, e), n), NP.vn(~F, u)), @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)), FV.mul_le_r(~F, NP.rowabs(~F, GJ.vdrop(~F, n, e), n), @M(FR.ofn(~F, n), ep), NP.vn(~F, u), FV.vmax_nn(~F, u), rowabs_le(~F, GJ.vdrop(~F, n, e), n, ep, vall_drop(~F, n, e, ep, he), hep))))

@ATOMS zo = zx=zr(~F, n, x, u),, z2=zr(~F, n, x2, u),, zp=zr(~F, n, p, u),, m

# a row other than the pivot: x2 = x - m p + err, so
# |zr(x)| <= |zr(x2)| + |m| |zr(p)| + n eps |u|
def zo_bnd(~F: O.OField, +n: Nat, +x2: M.Vec(~F), +x: M.Vec(~F), +m: @T, +p: M.Vec(~F), +u: M.Vec(~F), +ep: @T, +he: M.vbnd.all(~F, M.vadd(~F, x2, M.vneg(~F, M.vadd(~F, x, M.vscale(~F, @N(m), p)))), ep), +hep: O.le(~F, @0, ep), +lu: {M.len(~F, u) == n : Nat}, +y: @T, +gg: @T, +h2: M.bnd(~F, zr(~F, n, x2, u), y), +hm: M.bnd(~F, m, gg), +hp: M.bnd(~F, zr(~F, n, p, u), y)) -> M.bnd(~F, zr(~F, n, x, u), @A(@A(y, @M(gg, y)), @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)))):
  three(~F, zr(~F, n, x, u), zr(~F, n, x2, u), m, zr(~F, n, p, u), y, gg, y, @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)), h2, hm, hp,
    KB.bnd_val(~F, @FT[zo | -(z2 - (zx + (-m)*zp))], @FT[zo | zx - (z2 + m*zp)], @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)), @ZEQ[zo | -(z2 - (zx + (-m)*zp)) | zx - (z2 + m*zp)],
      FM.bnd_neg(~F, @FT[zo | z2 - (zx + (-m)*zp)], @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)),
        (%zr_axpy(~F, n, x, m, p, u) : M.bnd(~F, @S(zr(~F, n, x2, u), _), @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)))
          (%zr_sub(~F, n, x2, M.vadd(~F, x, M.vscale(~F, @N(m), p)), u) : M.bnd(~F, _, @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)))
            zerr(~F, n, M.vadd(~F, x2, M.vneg(~F, M.vadd(~F, x, M.vscale(~F, @N(m), p)))), u, ep, he, hep, lu))))))

@ATOMS zq = zx=zr(~F, n, x, u),, zp=zr(~F, n, p, u),, s

# the pivot row: p = s x + err, so |s zr(x)| <= |zr(p)| + n eps |u|
def zp_bnd(~F: O.OField, +n: Nat, +x: M.Vec(~F), +s: @T, +p: M.Vec(~F), +u: M.Vec(~F), +ep: @T, +he: M.vbnd.all(~F, M.vadd(~F, p, M.vneg(~F, M.vscale(~F, s, x))), ep), +hep: O.le(~F, @0, ep), +lu: {M.len(~F, u) == n : Nat}, +y: @T, +hp: M.bnd(~F, zr(~F, n, p, u), y)) -> M.bnd(~F, @M(s, zr(~F, n, x, u)), @A(y, @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)))):
  KB.bnd_val(~F, @FT[zq | zp + -(zp - s*zx)], @FT[zq | s*zx], @A(y, @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u))), @ZEQ[zq | zp + -(zp - s*zx) | s*zx],
    FM.bnd_add(~F, zr(~F, n, p, u), y, @N(@FT[zq | zp - s*zx]), @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)), hp,
      FM.bnd_neg(~F, @FT[zq | zp - s*zx], @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)),
        (%zr_scale(~F, n, s, x, u) : M.bnd(~F, @S(zr(~F, n, p, u), _), @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)))
          (%zr_sub(~F, n, p, M.vscale(~F, s, x), u) : M.bnd(~F, _, @M(@M(FR.ofn(~F, n), ep), NP.vn(~F, u)))
            zerr(~F, n, M.vadd(~F, p, M.vneg(~F, M.vscale(~F, s, x))), u, ep, he, hep, lu))))))

@ATOMS pl = z,, s,, q,, pi,, gg,, u,, y,, a=FV.fabs(~F, z),, aq=FV.fabs(~F, q)

# dividing by the rounded pivot reciprocal loses at most a factor 2G:
# q pi = 1, |pi| <= G, |s - q| <= |q| u and 2 G |q| u <= 1 give
# |z| <= 2G |s z|
def piv_low(~F: O.OField, +z: @T, +s: @T, +q: @T, +pi: @T, +gg: @T, +u: @T, +y: @T, +hq: {@M(q, pi) == @1 : @T}, +hpi: M.bnd(~F, pi, gg), +hs: M.bnd(~F, @S(s, q), @M(FV.fabs(~F, q), u)), +hsm: O.le(~F, @A(@M(gg, @M(FV.fabs(~F, q), u)), @M(gg, @M(FV.fabs(~F, q), u))), @1), +hy: M.bnd(~F, @M(s, z), y)) -> M.bnd(~F, z, @M(@A(gg, gg), y)):
  +h2 = KB.bnd_val(~F, @FT[pl | s*z + -((s - q)*z)], @FT[pl | q*z], @FT[pl | y + (aq*u)*a], @ZEQ[pl | s*z + -((s - q)*z) | q*z],
    FM.bnd_add(~F, @M(s, z), y, @N(@M(@S(s, q), z)), @FT[pl | (aq*u)*a], hy, FM.bnd_neg(~F, @M(@S(s, q), z), @FT[pl | (aq*u)*a], FM.bnd_mul(~F, @S(s, q), @M(FV.fabs(~F, q), u), z, FV.fabs(~F, z), hs, FV.fabs_bnd(~F, z)))))
  +h4 = FV.fabs_le(~F, z, @FT[pl | gg*(y + (aq*u)*a)], KB.bnd_val(~F, @FT[pl | pi*(q*z)], z, @FT[pl | gg*(y + (aq*u)*a)], @CERTEQ[pl | pi*(q*z) | z | z ; q*pi - 1 || FO.sub_of_eq(~F, @M(q, pi), @1, hq)],
    FM.bnd_mul(~F, pi, gg, @M(q, z), @FT[pl | y + (aq*u)*a], hpi, h2)))
  +s1 = FM.sub_nonneg(~F, FV.fabs(~F, z), @FT[pl | gg*(y + (aq*u)*a)], h4)
  +s3 = FM.sub_nonneg(~F, @FT[pl | gg*(aq*u) + gg*(aq*u)], @1, hsm)
  FM.bnd_mono(~F, z, FV.fabs(~F, z), @M(@A(gg, gg), y), FV.fabs_bnd(~F, z), FM.sub_nonneg(~F, FV.fabs(~F, z), @M(@A(gg, gg), y),
    FV.le_of_sub(~F, FV.fabs(~F, z), @M(@A(gg, gg), y), FM.nn_eq(~F, @FT[pl | (gg + gg)*y - a], @FT[pl | ((gg*(y + (aq*u)*a) - a) + (gg*(y + (aq*u)*a) - a)) + a*(1 - (gg*(aq*u) + gg*(aq*u)))], @ZEQ[pl | ((gg*(y + (aq*u)*a) - a) + (gg*(y + (aq*u)*a) - a)) + a*(1 - (gg*(aq*u) + gg*(aq*u))) | (gg + gg)*y - a],
      FO.nonneg_add(~F, @FT[pl | (gg*(y + (aq*u)*a) - a) + (gg*(y + (aq*u)*a) - a)], @FT[pl | a*(1 - (gg*(aq*u) + gg*(aq*u)))], FO.nonneg_add(~F, @FT[pl | gg*(y + (aq*u)*a) - a], @FT[pl | gg*(y + (aq*u)*a) - a], s1, s1), FO.mul_nonneg(~F, FV.fabs(~F, z), @FT[pl | 1 - (gg*(aq*u) + gg*(aq*u))], FV.fabs_nn(~F, z), s3))))))

# the right parts of a matrix's rows
def rmat(~F: O.OField, +n: Nat, a: M.Mat(~F)) -> M.Mat(~F):
  match a:
    case Nil{}:
      Nil{}
    case Con{r, t}:
      Con{GJ.vdrop(~F, n, r), rmat(~F, n, t)}

def vdrop_nil(~F: O.OField, n: Nat) -> {Nil{} == GJ.vdrop(~F, n, Nil{}) : M.Vec(~F)}:
  match n:
    case 0n:
      {==}
    case 1n+j:
      {==}

def mrow_rmat(~F: O.OField, +n: Nat, a: M.Mat(~F), k: Nat) -> {DV.mrow(~F, rmat(~F, n, a), k) == GJ.vdrop(~F, n, DV.mrow(~F, a, k)) : M.Vec(~F)}:
  match a k:
    case Nil{} k:
      vdrop_nil(~F, n)
    case Con{r, t} 0n:
      {==}
    case Con{r, t} 1n+j:
      mrow_rmat(~F, n, t, j)

def nrows_rmat(~F: O.OField, +n: Nat, a: M.Mat(~F)) -> {GJ.nrows(~F, rmat(~F, n, a)) == GJ.nrows(~F, a) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{r, t}:
      %Equal.sym(Nat, GJ.nrows(~F, rmat(~F, n, t)), GJ.nrows(~F, t), nrows_rmat(~F, n, t)) : {1n+_ == 1n+GJ.nrows(~F, t) : Nat}
      {==}

# entry k of R u reads row k's right part against u
def look_rmv(~F: O.OField, +n: Nat, +a: M.Mat(~F), +u: M.Vec(~F), +k: Nat) -> {O.lookup(~F, M.matvec(~F, rmat(~F, n, a), u), k) == zr(~F, n, DV.mrow(~F, a, k), u) : @T}:
  %mrow_rmat(~F, n, a, k) : {O.lookup(~F, M.matvec(~F, rmat(~F, n, a), u), k) == M.dot(~F, _, u) : @T}
  GJ.look_matvec(~F, rmat(~F, n, a), u, k)

def len_rmv(~F: O.OField, +n: Nat, +a: M.Mat(~F), +u: M.Vec(~F)) -> {M.len(~F, M.matvec(~F, rmat(~F, n, a), u)) == GJ.nrows(~F, a) : Nat}:
  Equal.trans(Nat, M.len(~F, M.matvec(~F, rmat(~F, n, a), u)), GJ.nrows(~F, rmat(~F, n, a)), GJ.nrows(~F, a), Equal.sym(Nat, GJ.nrows(~F, rmat(~F, n, a)), M.len(~F, M.matvec(~F, rmat(~F, n, a), u)), GJ.len_matvec(~F, rmat(~F, n, a), u)), nrows_rmat(~F, n, a))

def len_vdrop(~F: O.OField, k: Nat, x: M.Vec(~F), +m: Nat, h: {M.len(~F, x) == Nat.add(k, m) : Nat}) -> {M.len(~F, GJ.vdrop(~F, k, x)) == m : Nat}:
  match k x:
    case 0n x:
      h
    case 1n+j Nil{}:
      FO.absurd({0n == m : Nat}, GJ.zero_ne(Nat.add(j, m), h))
    case 1n++j Con{a, +xs}:
      len_vdrop(~F, j, xs, m, GJ.succ_inj(M.len(~F, xs), Nat.add(j, m), h))

# the rows of R have n entries
def rw_all(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +s: M.Mat(~F), +c: Nat, +gg: @T, +dd: @T, +ph: @T, +h: rinv(~F, n, jm, s, 0n, c, gg, dd, ph), +hn: {GJ.nrows(~F, s) == n : Nat}) -> GJ.All(~(i => GJ.roww(~F, rmat(~F, n, s), n, i)), n):
  GJ.all_mk(~n, ~(i => GJ.roww(~F, rmat(~F, n, s), n, i)), ~(i => hi =>
    (%Equal.sym(M.Vec(~F), DV.mrow(~F, rmat(~F, n, s), i), GJ.vdrop(~F, n, DV.mrow(~F, s, i)), mrow_rmat(~F, n, s, i)) : {M.len(~F, _) == n : Nat}
      len_vdrop(~F, n, DV.mrow(~F, s, i), n, ri_len(~F, n, jm, DV.mrow(~F, s, i), Nat.add(i, 0n), c, gg, dd, ph, ri_at(~F, n, jm, s, 0n, c, gg, dd, ph, i, h, (%Equal.sym(Nat, GJ.nrows(~F, s), n, hn) : {KA.natle(1n+i, _) == True{} : Bool} hi)))))), n, GJ.le_refl(n))

# row k of the cleared rows is the pivot row (k = c) or row k less a
# multiple of it
def drow_dclear(~F: O.OField, rows: List<&2, List<&2, S.D>>, +w: Nat, +p: List<&2, S.D>, +c: Nat, +i: Nat, k: Nat, hk: {KA.natle(1n+k, GJ.nrows(~F, M.ofdm(~F, rows))) == True{} : Bool}) -> {NU.drow(NU.dclear(rows, w, p, c, i), k) == NU.dclear.go(KA.nateq(Nat.add(k, i), c), w, NU.drow(rows, k), p, c) : List<&2, S.D>}:
  match rows k:
    case Nil{} 0n:
      FO.absurd({NU.drow(Nil{}, 0n) == NU.dclear.go(KA.nateq(i, c), w, NU.drow(Nil{}, 0n), p, c) : List<&2, S.D>}, KA.ft(hk))
    case Nil{} 1n++j:
      FO.absurd({NU.drow(Nil{}, 1n+j) == NU.dclear.go(KA.nateq(1n+Nat.add(j, i), c), w, NU.drow(Nil{}, 1n+j), p, c) : List<&2, S.D>}, KA.ft(hk))
    case Con{r, t} 0n:
      {==}
    case Con{r, t} 1n++j:
      %Equal.sym(Nat, 1n+Nat.add(j, i), Nat.add(j, 1n+i), LN.add_succ(j, i)) : {NU.drow(NU.dclear(t, w, p, c, 1n+i), j) == NU.dclear.go(KA.nateq(_, c), w, NU.drow(t, j), p, c) : List<&2, S.D>}
      drow_dclear(~F, t, w, p, c, 1n+i, j, hk)

# row k's invariant, read from the rows' invariant
def row_at(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +rows: List<&2, List<&2, S.D>>, +c: Nat, +gg: @T, +dd: @T, +ph: @T, +k: Nat, +hs: rinv(~F, n, jm, M.ofdm(~F, rows), 0n, c, gg, dd, ph), +hk: {KA.natle(1n+k, GJ.nrows(~F, M.ofdm(~F, rows))) == True{} : Bool}) -> rowinv(~F, n, jm, M.ofdv(~F, NU.drow(rows, k)), k, c, gg, dd, ph):
  (%Equal.sym(M.Vec(~F), M.ofdv(~F, NU.drow(rows, k)), DV.mrow(~F, M.ofdm(~F, rows), k), drow_ofd(~F, rows, k)) : rowinv(~F, n, jm, _, k, c, gg, dd, ph)
    (%Equal.sym(Nat, k, Nat.add(k, 0n), LN.add_zero(k)) : rowinv(~F, n, jm, DV.mrow(~F, M.ofdm(~F, rows), k), _, c, gg, dd, ph)
      ri_at(~F, n, jm, M.ofdm(~F, rows), 0n, c, gg, dd, ph, k, hs, hk)))

# a per-index bound below the length
def vall_lt(~F: O.OField, ~v: M.Vec(~F), ~t: @T, ~f: @k: Nat -> {KA.natle(1n+k, M.len(~F, v)) == True{} : Bool} -> M.bnd(~F, O.lookup(~F, v, k), t)) -> M.vbnd.all(~F, v, t):
  vall_of_all(~F, v, t, GJ.all_mk(~M.len(~F, v), ~(k => M.bnd(~F, O.lookup(~F, v, k), t)), ~f, M.len(~F, v), GJ.le_refl(M.len(~F, v))))

# |R u|: the size of rows2's right parts read against u
def yv(~F: O.OField, +n: Nat, +rows2: List<&2, List<&2, S.D>>, +u: M.Vec(~F)) -> @T:
  NP.vn(~F, M.matvec(~F, rmat(~F, n, M.ofdm(~F, rows2)), u))

def zat(~F: O.OField, +n: Nat, +rows2: List<&2, List<&2, S.D>>, +u: M.Vec(~F), +k: Nat) -> {O.lookup(~F, M.matvec(~F, rmat(~F, n, M.ofdm(~F, rows2)), u), k) == zr(~F, n, M.ofdv(~F, NU.drow(rows2, k)), u) : @T}:
  %Equal.sym(M.Vec(~F), M.ofdv(~F, NU.drow(rows2, k)), DV.mrow(~F, M.ofdm(~F, rows2), k), drow_ofd(~F, rows2, k)) : {O.lookup(~F, M.matvec(~F, rmat(~F, n, M.ofdm(~F, rows2)), u), k) == zr(~F, n, _, u) : @T}
  look_rmv(~F, n, M.ofdm(~F, rows2), u, k)

def yat(~F: O.OField, +n: Nat, +rows2: List<&2, List<&2, S.D>>, +u: M.Vec(~F), +k: Nat) -> M.bnd(~F, zr(~F, n, M.ofdv(~F, NU.drow(rows2, k)), u), yv(~F, n, rows2, u)):
  %zat(~F, n, rows2, u, k) : M.bnd(~F, _, yv(~F, n, rows2, u))
  look_bnd(~F, M.matvec(~F, rmat(~F, n, M.ofdm(~F, rows2)), u), k, yv(~F, n, rows2, u), FV.vmax_all(~F, M.matvec(~F, rmat(~F, n, M.ofdm(~F, rows2)), u)), FV.vmax_nn(~F, M.matvec(~F, rmat(~F, n, M.ofdm(~F, rows2)), u)))

# the cleared row k against the new |R' u|
def ynew(~F: O.OField, +n: Nat, +tr: List<&2, List<&2, S.D>>, +w: Nat, +p: List<&2, S.D>, +c: Nat, +u: M.Vec(~F), +k: Nat, +hk: {KA.natle(1n+k, GJ.nrows(~F, M.ofdm(~F, tr))) == True{} : Bool}) -> M.bnd(~F, zr(~F, n, M.ofdv(~F, NU.dclear.go(KA.nateq(k, c), w, NU.drow(tr, k), p, c)), u), yv(~F, n, NU.dclear(tr, w, p, c, 0n), u)):
  %Equal.sym(Nat, k, Nat.add(k, 0n), LN.add_zero(k)) : M.bnd(~F, zr(~F, n, M.ofdv(~F, NU.dclear.go(KA.nateq(_, c), w, NU.drow(tr, k), p, c)), u), yv(~F, n, NU.dclear(tr, w, p, c, 0n), u))
  %drow_dclear(~F, tr, w, p, c, 0n, k, hk) : M.bnd(~F, zr(~F, n, M.ofdv(~F, _), u), yv(~F, n, NU.dclear(tr, w, p, c, 0n), u))
  yat(~F, n, NU.dclear(tr, w, p, c, 0n), u, k)

# the new pivot row against |R' u|
def ypiv(~F: O.OField, +n: Nat, +tr: List<&2, List<&2, S.D>>, +w: Nat, +p: List<&2, S.D>, +c: Nat, +u: M.Vec(~F), +hc: {KA.natle(1n+c, GJ.nrows(~F, M.ofdm(~F, tr))) == True{} : Bool}) -> M.bnd(~F, zr(~F, n, M.ofdv(~F, p), u), yv(~F, n, NU.dclear(tr, w, p, c, 0n), u)):
  %GJ.nateq_refl(c) : M.bnd(~F, zr(~F, n, M.ofdv(~F, NU.dclear.go(_, w, NU.drow(tr, c), p, c)), u), yv(~F, n, NU.dclear(tr, w, p, c, 0n), u))
  ynew(~F, n, tr, w, p, c, u, c, hc)


# a cleared row's rounding: (G + 3 G G_P) u
def ekx(~F: O.OField, +gg: @T, +gp: @T, +w: Nat) -> @T:
  @M(@A(gg, @A(@A(@M(gg, gp), @M(gg, gp)), @M(gg, gp))), M.ofd(~F, S.D{S.Zpos{S.XH{}}, w}))

def ek_nn(~F: O.OField, +gg: @T, +gp: @T, +w: Nat, +hgg: O.le(~F, @0, gg), +hgp0: O.le(~F, @0, gp)) -> O.le(~F, @0, ekx(~F, gg, gp, w)):
  FO.mul_nonneg(~F, @A(gg, @A(@A(@M(gg, gp), @M(gg, gp)), @M(gg, gp))), M.ofd(~F, S.D{S.Zpos{S.XH{}}, w}), FO.nonneg_add(~F, gg, @A(@A(@M(gg, gp), @M(gg, gp)), @M(gg, gp)), hgg, FO.nonneg_add(~F, @A(@M(gg, gp), @M(gg, gp)), @M(gg, gp), FO.nonneg_add(~F, @M(gg, gp), @M(gg, gp), FO.mul_nonneg(~F, gg, gp, hgg, hgp0), FO.mul_nonneg(~F, gg, gp, hgg, hgp0)), FO.mul_nonneg(~F, gg, gp, hgg, hgp0))), u_nn(~F, w))

# the bounds on a row's |zr| from the two cases, and their sum
def xk(~F: O.OField, +n: Nat, +gg: @T, +gp: @T, +w: Nat, +y: @T, +uv: @T) -> @T:
  @A(@A(y, @M(gg, y)), @M(@M(FR.ofn(~F, n), ekx(~F, gg, gp, w)), uv))

def xp(~F: O.OField, +n: Nat, +gg: @T, +ep: @T, +y: @T, +uv: @T) -> @T:
  @M(@A(gg, gg), @A(y, @M(@M(FR.ofn(~F, n), ep), uv)))

