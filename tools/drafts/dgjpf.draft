# entry j of x_<c - e_i is x_j - [i = j]
def eq_dd(~F: O.OField, +x: M.Vec(~F), +c: Nat, +i: Nat, +j: Nat, +hj: {KA.natle(1n+j, c) == True{} : Bool}) -> {@S(O.lookup(~F, x, j), GJ.dl(~F, KA.nateq(i, j))) == O.lookup(~F, M.vadd(~F, GJ.vtake(~F, c, x), M.vneg(~F, GJ.unit(~F, c, i))), j) : @T}:
