@ATOMS kc = V=NP.vn(~F, vk(~F, s, c, rest)),, W=NP.vn(~F, M.matvec(~F, jm, vk(~F, s, c, rest))),, Z=NP.vn(~F, M.matvec(~F, rmat(~F, n, s), M.matvec(~F, jm, vk(~F, s, c, rest)))),, b=bb,, H=hh,, cg=@M(@M(FR.ofn(~F, c), ph), gg),, m,, nd=@M(FR.ofn(~F, n), dd),, g=gg

# the pivot bound: with |cand| <= m for every candidate,
# 1 <= beta H ((c phi G + m) + n Delta (1 + G))
def kern(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +s: M.Mat(~F), +c: Nat, +rest: Nat, +gg: @T, +dd: @T, +ph: @T, +m: @T, +h: rinv(~F, n, jm, s, 0n, c, gg, dd, ph), +hns: {GJ.nrows(~F, s) == n : Nat}, +hrest: {Nat.add(c, 1n+rest) == n : Nat}, +hm: GJ.All(~(j => cnd(KA.natle(c, j), M.bnd(~F, O.lookup(~F, DV.mrow(~F, s, j), c), m))), n), +hm0: O.le(~F, @0, m), +hgg: O.le(~F, @0, gg), +hdd: O.le(~F, @0, dd), +hph: O.le(~F, @0, ph), +bb: @T, +hh: @T, +hJ: NP.InvB(~F, jm, n, bb), +hjn: {GJ.nrows(~F, jm) == n : Nat}, +hR: NP.InvB(~F, rmat(~F, n, s), n, hh)) -> O.le(~F, @1, @M(@M(bb, hh), @A(@A(@M(@M(FR.ofn(~F, c), ph), gg), m), @M(@M(FR.ofn(~F, n), dd), @A(@1, gg))))):
  +h1 = one_le_vk(~F, s, c, rest, hcs(~F, s, c, rest, n, hrest, hns))
  +h2 = NP.lowb(~F, jm, n, bb, hJ, hjn, vk(~F, s, c, rest), Equal.trans(Nat, M.len(~F, vk(~F, s, c, rest)), Nat.add(c, 1n+rest), n, len_vk(~F, s, c, rest, hcs(~F, s, c, rest, n, hrest, hns)), hrest))
  +h3 = NP.lowb(~F, rmat(~F, n, s), n, hh, hR, Equal.trans(Nat, GJ.nrows(~F, rmat(~F, n, s)), GJ.nrows(~F, s), n, nrows_rmat(~F, n, s), hns), M.matvec(~F, jm, vk(~F, s, c, rest)), Equal.trans(Nat, M.len(~F, M.matvec(~F, jm, vk(~F, s, c, rest))), GJ.nrows(~F, jm), n, Equal.sym(Nat, GJ.nrows(~F, jm), M.len(~F, M.matvec(~F, jm, vk(~F, s, c, rest))), GJ.len_matvec(~F, jm, vk(~F, s, c, rest))), hjn))
  +h4 = rjv_le(~F, n, jm, s, c, rest, gg, dd, ph, m, h, hns, hrest, hm, hm0, hgg, hdd, hph)
  +h5 = vk_le(~F, s, c, rest, gg, rinv_mall(~F, n, jm, s, 0n, c, gg, dd, ph, h), hgg)
  +hb0 = NP.invb_nn(~F, jm, n, bb, hJ)
  +hh0 = NP.invb_nn(~F, rmat(~F, n, s), n, hh, hR)
  +hnd = FO.mul_nonneg(~F, FR.ofn(~F, n), dd, ofn_nn(~F, n), hdd)
  +s1 = FM.sub_nonneg(~F, @1, NP.vn(~F, vk(~F, s, c, rest)), h1)
  +s2 = FM.sub_nonneg(~F, NP.vn(~F, vk(~F, s, c, rest)), @M(bb, NP.vn(~F, M.matvec(~F, jm, vk(~F, s, c, rest)))), h2)
  +s3 = FM.sub_nonneg(~F, NP.vn(~F, M.matvec(~F, jm, vk(~F, s, c, rest))), @M(hh, NP.vn(~F, M.matvec(~F, rmat(~F, n, s), M.matvec(~F, jm, vk(~F, s, c, rest))))), h3)
  +s4 = FM.sub_nonneg(~F, NP.vn(~F, M.matvec(~F, rmat(~F, n, s), M.matvec(~F, jm, vk(~F, s, c, rest)))), @A(@A(@M(@M(FR.ofn(~F, c), ph), gg), m), @M(@M(FR.ofn(~F, n), dd), NP.vn(~F, vk(~F, s, c, rest)))), h4)
  +s5 = FM.sub_nonneg(~F, NP.vn(~F, vk(~F, s, c, rest)), @A(@1, gg), h5)
  FV.le_of_sub(~F, @1, @M(@M(bb, hh), @A(@A(@M(@M(FR.ofn(~F, c), ph), gg), m), @M(@M(FR.ofn(~F, n), dd), @A(@1, gg)))), FM.nn_eq(~F, @S(@M(@M(bb, hh), @A(@A(@M(@M(FR.ofn(~F, c), ph), gg), m), @M(@M(FR.ofn(~F, n), dd), @A(@1, gg)))), @1), @FT[kc | ((((V - 1) + (b*W - V)) + b*(H*Z - W)) + (b*H)*(((cg + m) + nd*V) - Z)) + ((b*H)*nd)*((1 + g) - V)],
    @ZEQ[kc | ((((V - 1) + (b*W - V)) + b*(H*Z - W)) + (b*H)*(((cg + m) + nd*V) - Z)) + ((b*H)*nd)*((1 + g) - V) | (b*H)*((cg + m) + nd*(1 + g)) - 1],
    FO.nonneg_add(~F, @FT[kc | (((V - 1) + (b*W - V)) + b*(H*Z - W)) + (b*H)*(((cg + m) + nd*V) - Z)], @FT[kc | ((b*H)*nd)*((1 + g) - V)],
      FO.nonneg_add(~F, @FT[kc | ((V - 1) + (b*W - V)) + b*(H*Z - W)], @FT[kc | (b*H)*(((cg + m) + nd*V) - Z)],
        FO.nonneg_add(~F, @FT[kc | (V - 1) + (b*W - V)], @FT[kc | b*(H*Z - W)], FO.nonneg_add(~F, @FT[kc | V - 1], @FT[kc | b*W - V], s1, s2), FO.mul_nonneg(~F, bb, @FT[kc | H*Z - W], hb0, s3)),
        FO.mul_nonneg(~F, @M(bb, hh), @FT[kc | ((cg + m) + nd*V) - Z], FO.mul_nonneg(~F, bb, hh, hb0, hh0), s4)),
      FO.mul_nonneg(~F, @M(@M(bb, hh), @M(FR.ofn(~F, n), dd)), @FT[kc | (1 + g) - V], FO.mul_nonneg(~F, @M(bb, hh), @M(FR.ofn(~F, n), dd), FO.mul_nonneg(~F, bb, hh, hb0, hh0), hnd), s5))))

# Constants of the elimination
# ----------------------------
# Column c's invariant uses entry bound G_c, inverse bound H_c, defect
# KD_c u and finished columns KP_c u, computed jointly with u = 2^-w
# taken out (u <= 1 absorbed); sigma = 4 beta H bounds the rounded
# reciprocal once the pivot is at least 1/(2 beta H).

def KS(~F: O.OField) -> Data:
  M.Both(@T, M.Both(@T, M.Both(@T, @T)))

def kg(~F: O.OField, st: KS(~F)) -> @T:
  match st:
    case (a, r):
      a

def kh(~F: O.OField, st: KS(~F)) -> @T:
  match st:
    case (a, r):
      match r:
        case (b, r2):
          b

def kd(~F: O.OField, st: KS(~F)) -> @T:
  match st:
    case (a, r):
      match r:
        case (b, r2):
          match r2:
            case (d, p):
              d

def kp(~F: O.OField, st: KS(~F)) -> @T:
  match st:
    case (a, r):
      match r:
        case (b, r2):
          match r2:
            case (d, p):
              p

def sgb(~F: O.OField, +bb: @T, +hh: @T) -> @T:
  @A(@M(@A(bb, bb), hh), @M(@A(bb, bb), hh))

def gpc(~F: O.OField, +sg: @T, +gg: @T) -> @T:
  @A(@M(sg, gg), @M(sg, gg))

def ekc(~F: O.OField, +gg: @T, +gp: @T) -> @T:
  @A(gg, @A(@A(@M(gg, gp), @M(gg, gp)), @M(gg, gp)))

def kdpc(~F: O.OField, +n: Nat, +g: @T, +sg: @T, +gg: @T, +kd: @T) -> @T:
  @A(@M(sg, kd), @M(@M(sg, gg), @A(@1, @M(FR.ofn(~F, n), g))))

def kppc(~F: O.OField, +sg: @T, +gg: @T, +kp: @T) -> @T:
  @A(@A(@M(sg, kp), @1), @M(sg, gg))

def kstep.go(~F: O.OField, +n: Nat, +g: @T, +bb: @T, +gg: @T, +hh: @T, +kd: @T, +kp: @T) -> KS(~F):
  (gnew(~F, gg, gpc(~F, sgb(~F, bb, hh), gg), ekc(~F, gg, gpc(~F, sgb(~F, bb, hh), gg))), (@M(@A(hh, hh), aco(~F, gg)), (dnew(~F, n, g, gg, kd, kdpc(~F, n, g, sgb(~F, bb, hh), gg, kd), ekc(~F, gg, gpc(~F, sgb(~F, bb, hh), gg))), pnew(~F, gg, kp, kppc(~F, sgb(~F, bb, hh), gg, kp), ekc(~F, gg, gpc(~F, sgb(~F, bb, hh), gg))))))

def kstep(~F: O.OField, +n: Nat, +g: @T, +bb: @T, +st: KS(~F)) -> KS(~F):
  kstep.go(~F, n, g, bb, kg(~F, st), kh(~F, st), kd(~F, st), kp(~F, st))

# the constants after c columns, from |J_ij| <= g and |J^-1| <= beta
def kst(~F: O.OField, +n: Nat, +g: @T, +bb: @T, c: Nat) -> KS(~F):
  match c:
    case 0n:
      (@A(g, @1), (@1, (@0, @0)))
    case 1n+j:
      kstep(~F, n, g, bb, kst(~F, n, g, bb, j))

def KNN(~F: O.OField, +st: KS(~F)) -> Data:
  M.Both(O.le(~F, @0, kg(~F, st)), M.Both(O.le(~F, @0, kh(~F, st)), M.Both(O.le(~F, @0, kd(~F, st)), O.le(~F, @0, kp(~F, st)))))

@ATOMS kn = G=kg(~F, st),, H=kh(~F, st),, D=kd(~F, st),, P=kp(~F, st),, b=bb,, g,, nn=FR.ofn(~F, n),, sgb(~F, bb, hh):=((b + b)*H + (b + b)*H),, GP:=(sgb(~F, bb, hh)*G + sgb(~F, bb, hh)*G),, EK:=(G + ((G*GP + G*GP) + G*GP)),, KDP:=(sgb(~F, bb, hh)*D + (sgb(~F, bb, hh)*G)*(1 + nn*g)),, KPP:=((sgb(~F, bb, hh)*P + 1) + sgb(~F, bb, hh)*G)

def knn_g(~F: O.OField, +st: KS(~F), h: KNN(~F, st)) -> O.le(~F, @0, kg(~F, st)):
  match h:
    case (a, r):
      a

def knn_h(~F: O.OField, +st: KS(~F), h: KNN(~F, st)) -> O.le(~F, @0, kh(~F, st)):
  match h:
    case (a, r):
      match r:
        case (b, r2):
          b

def knn_d(~F: O.OField, +st: KS(~F), h: KNN(~F, st)) -> O.le(~F, @0, kd(~F, st)):
  match h:
    case (a, r):
      match r:
        case (b, r2):
          match r2:
            case (d, q):
              d

def knn_p(~F: O.OField, +st: KS(~F), h: KNN(~F, st)) -> O.le(~F, @0, kp(~F, st)):
  match h:
    case (a, r):
      match r:
        case (b, r2):
          match r2:
            case (d, q):
              q

def knn_step(~F: O.OField, +n: Nat, +g: @T, +bb: @T, +st: KS(~F), +hg: O.le(~F, @0, g), +hb: O.le(~F, @0, bb), +h: KNN(~F, st)) -> KNN(~F, kstep(~F, n, g, bb, st)):
  +h1 = knn_g(~F, st, h)
  +h2 = knn_h(~F, st, h)
  +h3 = knn_d(~F, st, h)
  +h4 = knn_p(~F, st, h)
  (FO.nonneg_add(~F, @FT[kn | (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G))], @FT[kn | ((G + (G * (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G)))) + (G + (((G * (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G))) + (G * (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G)))) + (G * (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G))))))], FO.nonneg_add(~F, @FT[kn | ((((b + b) * H) + ((b + b) * H)) * G)], @FT[kn | ((((b + b) * H) + ((b + b) * H)) * G)], FO.mul_nonneg(~F, @FT[kn | (((b + b) * H) + ((b + b) * H))], @FT[kn | G], FO.nonneg_add(~F, @FT[kn | ((b + b) * H)], @FT[kn | ((b + b) * H)], FO.mul_nonneg(~F, @FT[kn | (b + b)], @FT[kn | H], FO.nonneg_add(~F, @FT[kn | b], @FT[kn | b], hb, hb), h2), FO.mul_nonneg(~F, @FT[kn | (b + b)], @FT[kn | H], FO.nonneg_add(~F, @FT[kn | b], @FT[kn | b], hb, hb), h2)), h1), FO.mul_nonneg(~F, @FT[kn | (((b + b) * H) + ((b + b) * H))], @FT[kn | G], FO.nonneg_add(~F, @FT[kn | ((b + b) * H)], @FT[kn | ((b + b) * H)], FO.mul_nonneg(~F, @FT[kn | (b + b)], @FT[kn | H], FO.nonneg_add(~F, @FT[kn | b], @FT[kn | b], hb, hb), h2), FO.mul_nonneg(~F, @FT[kn | (b + b)], @FT[kn | H], FO.nonneg_add(~F, @FT[kn | b], @FT[kn | b], hb, hb), h2)), h1)), FO.nonneg_add(~F, @FT[kn | (G + (G * (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G))))], @FT[kn | (G + (((G * (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G))) + (G * (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G)))) + (G * (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G)))))], FO.nonneg_add(~F, @FT[kn | G], @FT[kn | (G * (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G)))], h1, FO.mul_nonneg(~F, @FT[kn | G], @FT[kn | (((((b + b) * H) + ((b + b) * H)) * G) + ((((b + b) * H) + ((b + b) * H)) * G))], h1, FO