# One column
# ----------

# s is near q = 1/pivot: |s| <= |q| (1 + u)
def s_bnd(~F: O.OField, +w: Nat, +x: S.D) -> M.bnd(~F, M.ofd(~F, NU.dsdiv(w, NU.done(), x)), @A(FV.fabs(~F, O.ofq(~F, S.Q.div(S.D.toq(NU.done()), S.D.toq(x)))), @M(FV.fabs(~F, O.ofq(~F, S.Q.div(S.D.toq(NU.done()), S.D.toq(x)))), M.ofd(~F, S.D{S.Zpos{S.XH{}}, w})))):
