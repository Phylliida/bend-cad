# the step's constants: |u| <= H |R u| <= H (A |R' u| + B |u|)
def aco(~F: O.OField, +gg: @T) -> @T:
  @A(@A(@1, gg), @A(gg, gg))

def bco(~F: O.OField, +n: Nat, +gg: @T, +gp: @T, +ep: @T, +w: Nat) -> @T:
  @A(@M(FR.ofn(~F, n), ekx(~F, gg, gp, w)), @M(@A(gg, gg), @M(FR.ofn(~F, n), ep)))

