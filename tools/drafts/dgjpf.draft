  %GJ.look_vneg(~F, GJ.unit(~F, c, i), j) : {@S(O.lookup(~F, x, j), GJ.dl(~F, KA.nateq(i, j))) == @A(O.lookup(~F, GJ.vtake(~F, c, x), j), _) : @T}
  %GJ.look_take_lo(~F, c, x, j, hj) : {@S(O.lookup(~F, x, j), GJ.dl(~F, KA.nateq(i, j))) == @A(_, @N(O.lookup(~F, GJ.unit(~F, c, i), j))) : @T}
  %GJ.look_unit(~F, c, i, j, hj) : {@S(O.lookup(~F, x, j), GJ.dl(~F, KA.nateq(i, j))) == @A(O.lookup(~F, x, j), @N(_)) : @T}
  %GJ.nateq_sym(j, i) : {@S(O.lookup(~F, x, j), GJ.dl(~F, _)) == @A(O.lookup(~F, x, j), @N(GJ.dl(~F, KA.nateq(j, i)))) : @T}
  @ZEQ[lx=O.lookup(~F, x, j),, d=GJ.dl(~F, KA.nateq(j, i)) | lx - d | lx + -d]

def vall_dd(~F: O.OField, +x: M.Vec(~F), +c: Nat, +i: Nat, +ph: @T, +hf: fin(~F, x, i, c, ph), +hcx: {KA.natle(c, M.len(~F, x)) == True{} : Bool}) -> M.vbnd.all(~F, M.vadd(~F, GJ.vtake(~F, c, x), M.vneg(~F, GJ.unit(~F, c, i))), ph):
