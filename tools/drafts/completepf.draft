  %AP.ofkv_d(~F, ~H, grf) : BX.rbnd(~F, BX.vsub(~F, $XV, N.ofkv($DN, ~F, ~H, gcf)), _)
  %kt_eq(gcf, $NV, hlc) : BX.rbnd(~F, BX.vsub(~F, $XV, N.ofkv($DN, ~F, ~H, _)), N.ofkv($DN, ~F, ~H, grf))
  %kt_eq(grf, $NV, hlr) : BX.rbnd(~F, BX.vsub(~F, $XV, N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NV, gcf))), N.ofkv($DN, ~F, ~H, _))
  AP.both_r({M.len(~F, $XV) == $NV : Nat}, BX.rbnd(~F, BX.vsub(~F, $XV, N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NV, gcf))), N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NV, grf))), hpb)

# the blocks' centers are within |x| + rho
def cen_b($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, $PGF, +rho: O.C(F), +hvr: M.vbnd.all(~F, M.ofdv(~F, grf), rho)) -> M.vbnd.all(~F, M.ofdv(~F, gcf), O.add(F, NP.vn(~F, x), rho)):
  +lx = AP.both_l({M.len(~F, $XV) == $NV : Nat}, BX.rbnd(~F, BX.vsub(~F, $XV, N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NV, gcf))), N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NV, grf))), hpb)
  +hl = Equal.trans(Nat, M.len(~F, BX.vsub(~F, $XV, M.ofdv(~F, gcf))), $NV, M.len(~F, M.ofdv(~F, grf)), CP.len_vsub(~F, $XV, M.ofdv(~F, gcf), $NV, lx, Equal.trans(Nat, M.len(~F, M.ofdv(~F, gcf)), KA.klen($DN, gcf), $NV, PB.len_ofdv(~F, gcf), hlc)), Equal.sym(Nat, M.len(~F, M.ofdv(~F, grf)), $NV, Equal.trans(Nat, M.len(~F, M.ofdv(~F, grf)), KA.klen($DN, grf), $NV, PB.len_ofdv(~F, grf), hlr)))
  NP.vsub_bound(~F, $XV, M.ofdv(~F, gcf), NP.vn(~F, x), rho, FV.vmax_nn(~F, x), PB.vall_xp(~F, x, $VP), rbv(~F, BX.vsub(~F, $XV, M.ofdv(~F, gcf)), M.ofdv(~F, grf), rho, rb_of($SKA, x, gcf, grf, hlc, hlr, hpb), hvr, hl))

@MACRO BBS O.add(F, O.add(F, NP.vn(~F, x), O.one(F)), O.one(F))

def bb_le(~F: O.OField, +v: O.C(F), +rho: O.C(F), +h: O.le(~F, rho, O.one(F))) -> O.le(~F, O.add(F, v, rho), O.sub(~F, O.add(F, O.add(F, v, O.one(F)), O.one(F)), rho)):
  FV.le_of_sub(~F, O.add(F, v, rho), O.sub(~F, O.add(F, O.add(F, v, O.one(F)), O.one(F)), rho), FM.nn_eq(~F, O.sub(~F, O.sub(~F, O.add(F, O.add(F, v, O.one(F)), O.one(F)), rho), O.add(F, v, rho)), O.add(F, O.sub(~F, O.one(F), rho), O.sub(~F, O.one(F), rho)), @ZEQ[v,, rho | (1 - rho) + (1 - rho) | (((v + 1) + 1) - rho) - (v + rho)], FO.nonneg_add(~F, O.sub(~F, O.one(F), rho), O.sub(~F, O.one(F), rho), FM.sub_nonneg(~F, rho, O.one(F), h), FM.sub_nonneg(~F, rho, O.one(F), h))))

def bbs_nn(~F: O.OField, +x: M.Vec(~F)) -> O.le(~F, O.zero(F), $BBS):
  FO.nonneg_add(~F, O.add(F, NP.vn(~F, x), O.one(F)), O.one(F), FO.nonneg_add(~F, NP.vn(~F, x), O.one(F), FV.vmax_nn(~F, x), FO.one_nn(~F)), FO.one_nn(~F))

@MACRO RBP +rho: O.C(F), +hr0: O.le(~F, O.zero(F), rho), +hr1: O.le(~F, rho, O.one(F)), +hvr: M.vbnd.all(~F, M.ofdv(~F, grf), rho)
@MACRO RBA rho, hr0, hr1, hvr

# the read-back box: graded at rho and bb = |x| + 2
def gbox_ans($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, $PGF, $RBP) -> BP.gbox($DN, ~F, ~H, rho, $BBS, CK.zipb($DN, $GCU, $GRU)):
  +hc0 = DM.le_trans(~F, O.zero(F), O.add(F, NP.vn(~F, x), rho), O.sub(~F, $BBS, rho), FO.nonneg_add(~F, NP.vn(~F, x), rho, FV.vmax_nn(~F, x), hr0), bb_le(~F, NP.vn(~F, x), rho, hr1))
  +hc = up_vall(~F, $NV, gcf, $VP, O.sub(~F, $BBS, rho), hc0, PB.vall_mono(~F, M.ofdv(~F, gcf), O.add(F, NP.vn(~F, x), rho), O.sub(~F, $BBS, rho), cen_b($SKA, x, g, $PGA, rho, hvr), bb_le(~F, NP.vn(~F, x), rho, hr1)))
  RD.gbox_zip($DN, ~F, ~H, $GCU, $GRU, rho, $BBS, vk_of(~F, ~H, $GCU, O.sub(~F, $BBS, rho), hc), rk_of(~F, ~H, $GRU, up_rnn(~F, $NV, grf, $VP, hrn)), vk_of(~F, ~H, $GRU, rho, up_vall(~F, $NV, grf, $VP, rho, hr0, hvr)), Equal.trans(Nat, KA.klen($DN, $GCU), $NV, KA.klen($DN, $GRU), klen_up($NV, 0n, gcf, $VP), Equal.sym(Nat, KA.klen($DN, $GRU), $NV, klen_up($NV, 0n, grf, $VP))))

@MACRO SDK SK.Sketch.sides(SV.mark(SV.cat(SV.reds(SO.cls_of(sk)), SV.ambers(SO.cls_of(sk))), sk))

# the read-back box has radius 0 at a pin
def rz_pin($SKP, +g: List<&2, S.D>, +gcf: List<&2, S.D>, +grf: List<&2, S.D>, +hkr: {PL.ktake($DN, $NP, grf) == $GR0 : List<&2, S.D>}, +v: Nat, +hvf: {SV.mem(v, $FS) == True{} : Bool}) -> {N.emap(KI.dnum(), F, H, KB.KB.r(KI.dnum(), KB.blook($DN, CK.zipb($DN, $GCU, $GRU), v))) == O.zero(F) : O.C(F)}:
  %Equal.sym(N.NC(KI.dnum()), KB.KB.r(KI.dnum(), KB.blook($DN, CK.zipb($DN, $GCU, $GRU), v)), KB.klook($DN, $GRU, v), bl_zr($DN, $GCU, $GRU, v)) : {N.emap(KI.dnum(), F, H, _) == O.zero(F) : O.C(F)}
  %PB.dl_kl($GRU, v) : {N.emap(KI.dnum(), F, H, _) == O.zero(F) : O.C(F)}
  %Equal.sym(S.D, NU.dlook($GRU, v), NU.dzero(), ru_eq($SKA, g, grf, hkr, v, hvf)) : {N.emap(KI.dnum(), F, H, _) == O.zero(F) : O.C(F)}
  Equal.sym(O.C(F), O.zero(F), N.emap(KI.dnum(), F, H, N.nzero(KI.dnum())), KA.ez($DN, ~F, ~H))

def rz_ans($SKP, +g: List<&2, S.D>, +gcf: List<&2, S.D>, +grf: List<&2, S.D>, +hkr: {PL.ktake($DN, $NP, grf) == $GR0 : List<&2, S.D>}, ws: List<&2, Nat>, +hs: {L.subl(ws, $FS) == True{} : Bool}) -> RZ($DN, ~F, ~H, CK.zipb($DN, $GCU, $GRU), ws):
  match ws:
    case Nil{}:
      Unit{}
    case Con{+v, +t}:
      (rz_pin($SKA, g, gcf, grf, hkr, v, L.subl_hd(v, t, $FS, hs)), rz_ans($SKA, g, gcf, grf, hkr, t, L.subl_tl(v, t, $FS, hs)))

# the side conditions over the read-back box
def sides_ans($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, $PGF, $RBP, +dy: {SV.dyadic(SV.mark($RC, sk)) == True{} : Bool}, +hbud: SBud(~F, $BBS, rho, x, $SDK, $PINS)) -> {PL.check_sides($DN, $SDK, $GCU, $GRU) == True{} : Bool}:
  +hrk = rk_of(~F, ~H, $GRU, up_rnn(~F, $NV, grf, $VP, hrn))
  +inb = inbox_ans($SKA, x, g, hl, $PGA)
  +hx = CP.rbnd_inbox($DN, ~F, ~H, x, $GCU, $GRU, AP.both_r({M.len(~F, x) == M.len(~F, N.ofkv($DN, ~F, ~H, $GCU)) : Nat}, BX.rbnd(~F, BX.vsub(~F, x, N.ofkv($DN, ~F, ~H, $GCU)), N.ofkv($DN, ~F, ~H, $GRU)), inb), hrk)
  KA.band_i(KA.kvle($DN, Nil{}, $GRU), PL.sides_ok($DN, CK.zipb($DN, $GCU, $GRU), $SDK), kvle_nil(~F, ~H, $GRU, up_rnn(~F, $NV, grf, $VP, hrn)), sides_of(~F, ~H, CK.zipb($DN, $GCU, $GRU), rho, $BBS, hr0, bbs_nn(~F, x), gbox_ans($SKA, x, g, $PGA, $RBA), x, hx, $SDK, ds_sub($RC, $AC, sk, L.band_r(SV.dyeqs(SK.Sketch.eqs(SV.mark($RC, sk))), SV.dysides(SK.Sketch.sides(SV.mark($RC, sk))), dy)), $PINS, rz_ans($SKA, g, gcf, grf, hkr, $FS, L.subl_refl($FS)), hbud))

# The verdict at P
# ----------------

@MACRO PLF PL.Plan{$VP, $EP, $NP, bsf}
@MACRO VH SV.held(SO.pins_of(sk), g, $GCU, $GRU)
@MACRO VW WF.wf_dec(SV.mark(SV.reds(SO.cls_of(sk)), sk))
@MACRO VI BX.Sketch.within(SV.mark(SV.reds(SO.cls_of(sk)), sk), List.length(&2, N.NC(KI.dnum()), $GCU))
@MACRO VC PL.check($DN, SO.kept(sk), $GCU, $GRU, $PLF)
@MACRO VX VD.exact(sk, SO.cls_of(sk))
@MACRO VS PL.check_sides($DN, $SDK, $GCU, $GRU)
@MACRO VXP +hwf: {WF.wf_dec(sk) == True{} : Bool}, +cov: {BX.Sketch.within(sk, $NV) == True{} : Bool}, +dy: {SV.dyadic(SV.mark($RC, sk)) == True{} : Bool}, +hex: {VD.exact(sk, SO.cls_of(sk)) == True{} : Bool}
@MACRO VXA hwf, cov, dy, hex

def held_ans($SKP, +g: List<&2, S.D>, +gcf: List<&2, S.D>, +grf: List<&2, S.D>, +hkc: {PL.ktake($DN, $NP, gcf) == $GC0 : List<&2, S.D>}, +hkr: {PL.ktake($DN, $NP, grf) == $GR0 : List<&2, S.D>}) -> {$VH == True{} : Bool}:
  held_go($SKA, g, gcf, grf, hkc, hkr, $FS, L.subl_refl($FS))

def within_ans($SKP, +cov: {BX.Sketch.within(sk, $NV) == True{} : Bool}, +gcf: List<&2, S.D>) -> {$VI == True{} : Bool}:
  %Equal.sym(Nat, List.length(&2, S.D, $GCU), $NV, length_up($NV, 0n, gcf, $VP)) : {BX.Sketch.within(SV.mark(SV.reds(SO.cls_of(sk)), sk), _) == True{} : Bool}
  w_mark(SV.reds(SO.cls_of(sk)), sk, $NV, cov)

# the whole verdict on the answer read back from the blocks' result
def ans_ok($SKP, $VXP, +x: M.Vec(~F), +g: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, $PGF, $RBP, +hbud: SBud(~F, $BBS, rho, x, $SDK, $PINS)) -> {SO.accept(NU.POk{NU.NP{$PLF, $GCU, $GRU}}, sk, g, SO.cls_of(sk), SO.pins_of(sk)) == True{} : Bool}:
  KA.band_i($VH, KA.band($VW, KA.band($VI, KA.band($VC, KA.band($VS, $VX)))), held_ans($SKA, g, gcf, grf, hkc, hkr),
  KA.band_i($VW, KA.band($VI, KA.band($VC, KA.band($VS, $VX))), WC.wf_mark(SV.reds(SO.cls_of(sk)), sk, hwf),
  KA.band_i($VI, KA.band($VC, KA.band($VS, $VX)), within_ans($SKA, cov, gcf),
  KA.band_i($VC, KA.band($VS, $VX), cr_ok($SKA, hwf, cov, x, g, $PGA),
  KA.band_i($VS, $VX, sides_ans($SKA, x, g, hl, $PGA, $RBA, dy, hbud), hex)))))

# the answer at one precision passes the verdict and holds x
def AnsOK(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +sk: SK.Sketch, +g: List<&2, S.D>, +x: M.Vec(~F), nx: NU.PR) -> Data:
  M.Both({SO.accept(nx, sk, g, SO.cls_of(sk), SO.pins_of(sk)) == True{} : Bool}, BX.inbox($DN, ~F, ~H, SO.pr.gc(nx), SO.pr.gr(nx), x))

@MACRO RHT O.mul(F, NW.hnw(~F, p), tf)

def ans_r.go($SKP, $VXP, +x: M.Vec(~F), +g: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, +p: Nat, +tf: O.C(F), +htf: O.le(~F, O.zero(F), tf), +hr1: O.le(~F, $RHT, O.one(F)), +hbud: SBud(~F, $BBS, $RHT, x, $SDK, $PINS), +bsf: List<&2, PL.PBlock<KI.dnum()>>, +gcf: List<&2, S.D>, +grf: List<&2, S.D>, +hw: {PL.walk($DN, gcf, grf, bsf, $SYS, $NP) == True{} : Bool}, +hkc: {PL.ktake($DN, $NP, gcf) == $GC0 : List<&2, S.D>}, +hkr: {PL.ktake($DN, $NP, grf) == $GR0 : List<&2, S.D>}, +hlc: {KA.klen($DN, gcf) == $NV : Nat}, +hlr: {KA.klen($DN, grf) == $NV : Nat}, +hpb: PP.pbox($DN, ~F, ~H, gcf, grf, $NV, $XV), +hrn: FV.rnn(~F, M.ofdv(~F, grf)), +hvb: M.vbnd.all(~F, M.ofdv(~F, grf), $RHT)) -> AnsOK(~F, ~H, sk, g, x, NU.plan.fin($VP, $EP, $NP, $NV, NU.PBOk{NU.PB{bsf, gcf, grf}})):
  +hr0 = FO.mul_nonneg(~F, NW.hnw(~F, p), tf, NW.hnw_nn(~F, p), htf)
  (ans_ok($SKA, $VXA, x, g, hl, $PGA, $RHT, hr0, hr1, hvb, hbud), inbox_ans($SKA, x, g, hl, $PGA))

def ans_r($SKP, $VXP, +x: M.Vec(~F), +g: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, +p: Nat, +tf: O.C(F), +htf: O.le(~F, O.zero(F), tf), +hr1: O.le(~F, $RHT, O.one(F)), +hbud: SBud(~F, $BBS, $RHT, x, $SDK, $PINS), r: NU.PBR, hpg: PB.PG(~F, ~H, $VP, $NV, x, p, $NP, $GC0, $GR0, $SYS, tf, r)) -> AnsOK(~F, ~H, sk, g, x, NU.plan.fin($VP, $EP, $NP, $NV, r)):
  match r:
    case NU.PBOk{NU.PB{+bsf, +gcf, +grf}}:
      (hw, (hkc, (hkr, (hlc, (hlr, (hpb, (hrn, hvb))))))) = hpg
      ans_r.go($SKA, $VXA, x, g, hl, p, tf, htf, hr1, hbud, bsf, gcf, grf, hw, hkc, hkr, hlc, hlr, hpb, hrn, hvb)
    case NU.PBRetry{}:
      absurd(AnsOK(~F, ~H, sk, g, x, NU.plan.fin($VP, $EP, $NP, $NV, NU.PBRetry{})), hpg)
    case NU.PBStop{}:
      absurd(AnsOK(~F, ~H, sk, g, x, NU.plan.fin($VP, $EP, $NP, $NV, NU.PBStop{})), hpg)

# the plan at precision p, over a system s in block order
def pgo(+sk: SK.Sketch, +g: List<&2, S.D>, +p: Nat, +s: List<&2, E.QExpr>) -> NU.PR:
  NU.plan.fin($VP, $EP, $NP, $NV, NU.pblocks($BSS, NU.bcert($BSS, s, $G0B, p, $NP, $GC0, $GR0), s, $G0B, p, $NP, $GC0, $GR0, Nil{}))

# the solver's plan at p is the blocks in turn over the full system's
# reordering
def plan_is($SKP, +g: List<&2, S.D>, +p: Nat) -> {NU.plan(SO.kept(sk), $NV, SO.skel_of(sk), g, p) == pgo(sk, g, p, $SYS) : NU.PR}:
  %SD.kept_reorder_d(sk, ha, $VP, ST.alleqs($KB), SP.sfacts_gc($SFA)) : {pgo(sk, g, p, PL.reorder($VP, SO.kept(sk), $EP)) == pgo(sk, g, p, _) : NU.PR}
  {==}

@MACRO TCH PB.tch($CA, $KB, binv, $NP, @0)

# at P: the answer passes the verdict and holds x
def plan_ans($TP, $VXP, +hl: {M.len(~F, x) == $NV : Nat}, +hr1: O.le(~F, O.mul(F, NW.hnw(~F, p), $TCH), O.one(F)), +hbud: SBud(~F, $BBS, O.mul(F, NW.hnw(~F, p), $TCH), x, $SDK, $PINS)) -> AnsOK(~F, ~H, sk, g, x, NU.plan(SO.kept(sk), $NV, SO.skel_of(sk), g, p)):
  %Equal.sym(NU.PR, NU.plan(SO.kept(sk), $NV, SO.skel_of(sk), g, p), pgo(sk, g, p, $SYS), plan_is($SKA, g, p)) : AnsOK(~F, ~H, sk, g, x, _)
  ans_r($SKA, $VXA, x, g, hl, p, $TCH, PB.tch_nn(~F, ~H, $FULL, $GOOD, $VP, x, $KB, binv, $NP, @0, FO.le_refl(~F, @0)), hr1, hbud, NU.pblocks($BSS, NU.bcert($BSS, $SYS, $G0B, p, $NP, $GC0, $GR0), $SYS, $G0B, p, $NP, $GC0, $GR0, Nil{}), plan_pg($TA))

# The top (C6d-4)
# ---------------
# Level l's precisions start at P_l = pfirst(l, 64, 96) >= 64 + 2l, so
# t = 2^-floor(P_l/2) <= 2^-l, and l 2^-l <= 1: with Q < l, t Q < 1.

def pfirst(l: Nat, +p: Nat, +q: Nat) -> Nat:
  match l:
    case 0n:
      p
    case 1n+m:
      pfirst(m, q, Nat.add(p, p))

def ptail(l: Nat, +c: Nat, +p: Nat, +q: Nat) -> List<&2, Nat>:
  match l:
    case 0n:
      SO.precs(c, q, Nat.add(p, p))
    case 1n+m:
      ptail(m, c, q, Nat.add(p, p))

def pf_head(l: Nat, +c: Nat, +p: Nat, +q: Nat) -> {SO.precs.from(l, 1n+c, p, q) == Con{pfirst(l, p, q), ptail(l, c, p, q)} : List<&2, Nat>}:
  match l:
    case 0n:
      {==}
    case 1n+m:
      pf_head(m, c, q, Nat.add(p, p))

def pf_h2(+p: Nat, +q: Nat, +h1: {KA.natle(1n+(1n+p), q) == True{} : Bool}) -> {KA.natle(1n+(1n+Nat.add(p, p)), Nat.add(q, q)) == True{} : Bool}:
  +a3 = KA.natle_trans(Nat.add(1n+(1n+p), 1n+(1n+p)), Nat.add(q, 1n+(1n+p)), Nat.add(q, q), KA.natle_add_rr(1n+(1n+p), q, 1n+(1n+p), h1), KA.natle_add_mono(q, 1n+(1n+p), q, h1))
  KA.natle_trans(1n+(1n+Nat.add(p, p)), Nat.add(1n+(1n+p), 1n+(1n+p)), Nat.add(q, q), KA.natle_add_mono(p, p, 1n+(1n+p), KA.natle_succ(p, 1n+p, KA.natle_succ(p, p, KA.natle_refl(p)))), a3)

def pf_rw(+k: Nat, +m: Nat, +pf: Nat, h: {KA.natle(1n+(1n+Nat.add(k, Nat.add(m, m))), pf) == True{} : Bool}) -> {KA.natle(Nat.add(k, Nat.add(1n+m, 1n+m)), pf) == True{} : Bool}:
  %LN.add_succ(m, m) : {KA.natle(Nat.add(k, 1n+_), pf) == True{} : Bool}
  %LN.add_succ(k, 1n+Nat.add(m, m)) : {KA.natle(_, pf) == True{} : Bool}
  %LN.add_succ(k, Nat.add(m, m)) : {KA.natle(1n+_, pf) == True{} : Bool}
  h

# the first components grow by at least 2 a step
def pf_ge(m: Nat, +p: Nat, +q: Nat, +k: Nat, +hk: {KA.natle(k, p) == True{} : Bool}, +h1: {KA.natle(1n+(1n+p), q) == True{} : Bool}, +h2: {KA.natle(1n+(1n+q), Nat.add(p, p)) == True{} : Bool}) -> {KA.natle(Nat.add(k, Nat.add(m, m)), pfirst(m, p, q)) == True{} : Bool}:
  match m:
    case 0n:
      %LN.add_zero(k) : {KA.natle(_, p) == True{} : Bool}
      hk
    case 1n++j:
      pf_rw(k, j, pfirst(j, q, Nat.add(p, p)), pf_ge(j, q, Nat.add(p, p), 1n+(1n+k), KA.natle_trans(1n+(1n+k), 1n+(1n+p), q, hk, h1), h2, pf_h2(p, q, h1)))

@MACRO PL0 pfirst(l, 64n, 96n)

def pl_ge(+l: Nat) -> {KA.natle(Nat.add(64n, Nat.add(l, l)), $PL0) == True{} : Bool}:
  pf_ge(l, 64n, 96n, 64n, KA.natle_refl(64n), {==}, {==})

def half_le(l: Nat, d: Nat, h: {KA.natle(Nat.add(l, l), 1n+Nat.add(d, d)) == True{} : Bool}) -> {KA.natle(l, d) == True{} : Bool}:
  match l d:
    case 0n d:
      {==}
    case 1n++i 0n:
      FO.absurd({KA.natle(1n+i, 0n) == True{} : Bool}, KA.ft((%Equal.sym(Nat, 1n+Nat.add(i, i), Nat.add(i, 1n+i), LN.add_succ(i, i)) : {KA.natle(_, 0n) == True{} : Bool}
        h)))
    case 1n++i 1n++j:
      half_le(i, j, (%Equal.sym(Nat, 1n+Nat.add(i, i), Nat.add(i, 1n+i), LN.add_succ(i, i)) : {KA.natle(_, 1n+(1n+Nat.add(j, j))) == True{} : Bool}
        (%Equal.sym(Nat, 1n+Nat.add(j, j), Nat.add(j, 1n+j), LN.add_succ(j, j)) : {KA.natle(Nat.add(i, 1n+i), 1n+_) == True{} : Bool}
          h)))

def mul2(+d: Nat) -> {Nat.mul(d, 2n) == Nat.add(d, d) : Nat}:
  %Equal.sym(Nat, d, Nat.mul(d, 1n), LN.mul_one(d)) : {Nat.mul(d, 2n) == Nat.add(d, _) : Nat}
  Equal.sym(Nat, Nat.add(d, Nat.mul(d, 1n)), Nat.mul(d, 2n), LN.mul_succ(d, 1n))

def dm_le(+s: Nat) -> {KA.natle(s, 1n+Nat.add(Nat.div(s, 2n), Nat.div(s, 2n))) == True{} : Bool}:
  %Equal.sym(Nat, s, Nat.add(Nat.mod(s, 2n), Nat.mul(Nat.div(s, 2n), 2n)), NO.divmod_eq(s, 1n)) : {KA.natle(_, 1n+Nat.add(Nat.div(s, 2n), Nat.div(s, 2n))) == True{} : Bool}
  %mul2(Nat.div(s, 2n)) : {KA.natle(Nat.add(Nat.mod(s, 2n), Nat.mul(Nat.div(s, 2n), 2n)), 1n+_) == True{} : Bool}
  KA.natle_add_rr(Nat.mod(s, 2n), 1n, Nat.mul(Nat.div(s, 2n), 2n), SC.le_of_Le(Nat.mod(s, 2n), 1n, NO.mod_le(s, 1n)))

# floor(s/2) >= l for s >= 2l
def div_ge(+l: Nat, +s: Nat, h: {KA.natle(Nat.add(l, l), s) == True{} : Bool}) -> {KA.natle(l, Nat.div(s, 2n)) == True{} : Bool}:
  half_le(l, Nat.div(s, 2n), KA.natle_trans(Nat.add(l, l), s, 1n+Nat.add(Nat.div(s, 2n), Nat.div(s, 2n)), h, dm_le(s)))

def pl_half(+l: Nat) -> {KA.natle(l, Nat.div($PL0, 2n)) == True{} : Bool}:
  div_ge(l, $PL0, KA.natle_trans(Nat.add(l, l), Nat.add(64n, Nat.add(l, l)), $PL0, (%LN.add_comm(Nat.add(l, l), 64n) : {KA.natle(Nat.add(l, l), _) == True{} : Bool}
    KA.natle_add_r(Nat.add(l, l), 64n)), pl_ge(l)))

@MACRO U1 M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n})

def nv_s(~F: O.OField, +n: O.C(F), +v: O.C(F), hI: O.le(~F, O.mul(F, n, v), O.one(F)), hv: O.le(~F, v, O.one(F))) -> O.le(~F, O.mul(F, O.add(F, n, O.one(F)), O.mul(F, $U1, v)), O.one(F)):
  +hi = RO.inv_nn(~F, S.Pos.pow2(1n))
  FV.le_of_sub(~F, O.mul(F, O.add(F, n, O.one(F)), O.mul(F, $U1, v)), O.one(F), FM.nn_eq(~F, O.sub(~F, O.one(F), O.mul(F, O.add(F, n, O.one(F)), O.mul(F, $U1, v))), O.add(F, O.mul(F, O.inv(F, O.ofp(~F, S.Pos.pow2(1n))), O.sub(~F, O.one(F), O.mul(F, n, v))), O.mul(F, O.inv(F, O.ofp(~F, S.Pos.pow2(1n))), O.sub(~F, O.one(F), v))),
    @CERTEQ[n,, v,, i=O.inv(F, O.ofp(~F, S.Pos.pow2(1n))) | i*(1 - n*v) + i*(1 - v) | 1 - (n + 1)*((1*i)*v) | 1 ; (1 + 1)*i - 1 || QE.ofp_rel(~F, S.Pos.pow2(1n))],
    FO.nonneg_add(~F, O.mul(F, O.inv(F, O.ofp(~F, S.Pos.pow2(1n))), O.sub(~F, O.one(F), O.mul(F, n, v))), O.mul(F, O.inv(F, O.ofp(~F, S.Pos.pow2(1n))), O.sub(~F, O.one(F), v)), FO.mul_nonneg(~F, O.inv(F, O.ofp(~F, S.Pos.pow2(1n))), O.sub(~F, O.one(F), O.mul(F, n, v)), hi, FM.sub_nonneg(~F, O.mul(F, n, v), O.one(F), hI)), FO.mul_nonneg(~F, O.inv(F, O.ofp(~F, S.Pos.pow2(1n))), O.sub(~F, O.one(F), v), hi, FM.sub_nonneg(~F, v, O.one(F), hv)))))

# l 2^-l <= 1
def nv_le(~F: O.OField, l: Nat) -> O.le(~F, O.mul(F, CR.nat(~F, l), AP.vbit(~F, l)), O.one(F)):
  match l:
    case 0n:
      FV.le_of_sub(~F, O.mul(F, O.zero(F), AP.vbit(~F, 0n)), O.one(F), FM.nn_eq(~F, O.sub(~F, O.one(F), O.mul(F, O.zero(F), AP.vbit(~F, 0n))), O.one(F), @ZEQ[v=AP.vbit(~F, 0n) | 1 | 1 - 0*v], FO.one_nn(~F)))
    case 1n++m:
      %DM.ofd_mul(~F, S.D{S.Zpos{S.XH{}}, 1n}, S.D{S.Zpos{S.XH{}}, m}) : O.le(~F, O.mul(F, O.add(F, CR.nat(~F, m), O.one(F)), _), O.one(F))
      nv_s(~F, CR.nat(~F, m), AP.vbit(~F, m), nv_le(~F, m), DG.u_le1(~F, m))

# The side budget
# ---------------
# a side with variables needs 2 lp T / e(x) of the budget: then
# t (2 lp T / e(x)) < 1 gives 2 lp h T <= 2 lp t T < e(x)

@MACRO EX O.eval(~F, x, e)
@MACRO SBE O.mul(F, O.mul(F, O.add(F, BP.lp(~F, bb, e), BP.lp(~F, bb, e)), tf), O.inv(F, $EX))

def sbg(~F: O.OField, b: Bool, +bb: O.C(F), +tf: O.C(F), +x: M.Vec(~F), +e: E.QExpr) -> O.C(F):
  match b:
    case True{}:
      O.zero(F)
    case False{}:
      $SBE

def sbs(~F: O.OField, +bb: O.C(F), +tf: O.C(F), +x: M.Vec(~F), ss: List<&2, SK.Side>, +pins: List<&2, Nat>) -> O.C(F):
  match ss:
    case Nil{}:
      O.zero(F)
    case Con{SK.Gt0{+e}, t}:
      O.add(F, $SBE, sbs(~F, bb, tf, x, t, pins))
    case Con{SK.Ge0{+e}, t}:
      O.add(F, sbg(~F, SV.inside(e, pins), bb, tf, x, e), sbs(~F, bb, tf, x, t, pins))

@MACRO SBP +bb: O.C(F), +hb: O.le(~F, O.zero(F), bb), +tf: O.C(F), +htf: O.le(~F, O.zero(F), tf), +x: M.Vec(~F)
@MACRO SBA bb, hb, tf, htf, x

def sbe_nn(~F: O.OField, $SBP, +e: E.QExpr, +hex: O.lt(F, O.zero(F), $EX)) -> O.le(~F, O.zero(F), $SBE):
  +hl = PB.lp_nn(~F, bb, hb, e)
  FO.mul_nonneg(~F, O.mul(F, O.add(F, BP.lp(~F, bb, e), BP.lp(~F, bb, e)), tf), O.inv(F, $EX), FO.mul_nonneg(~F, O.add(F, BP.lp(~F, bb, e), BP.lp(~F, bb, e)), tf, FO.nonneg_add(~F, BP.lp(~F, bb, e), BP.lp(~F, bb, e), hl, hl), htf), FO.lt_le(~F, O.zero(F), O.inv(F, $EX), FO.inv_pos(~F, $EX, hex)))

def sbg_nn(~F: O.OField, $SBP, +e: E.QExpr, b: Bool, hs: SV.Strict.ge(~F, b, x, e)) -> O.le(~F, O.zero(F), sbg(~F, b, bb, tf, x, e)):
  match b:
    case True{}:
      FO.le_refl(~F, O.zero(F))
    case False{}:
      sbe_nn(~F, $SBA, e, hs)

def sbs_nn(~F: O.OField, $SBP, ss: List<&2, SK.Side>, +pins: List<&2, Nat>, hs: SV.Strict(~F, x, ss, pins)) -> O.le(~F, O.zero(F), sbs(~F, bb, tf, x, ss, pins)):
  match ss:
    case Nil{}:
      FO.le_refl(~F, O.zero(F))
    case Con{SK.Gt0{+e}, +t}:
      (h1, h2) = hs
      FO.nonneg_add(~F, $SBE, sbs(~F, bb, tf, x, t, pins), sbe_nn(~F, $SBA, e, h1), sbs_nn(~F, $SBA, t, pins, h2))
    case Con{SK.Ge0{+e}, +t}:
      (h1, h2) = hs
      FO.nonneg_add(~F, sbg(~F, SV.inside(e, pins), bb, tf, x, e), sbs(~F, bb, tf, x, t, pins), sbg_nn(~F, $SBA, e, SV.inside(e, pins), h1), sbs_nn(~F, $SBA, t, pins, h2))

@MACRO WW O.mul(F, O.add(F, lp, lp), tf)
@MACRO MM O.mul(F, lp, O.mul(F, h, tf))

# one side's room: 2 lp h T < e(x)
def gt_side(~F: O.OField, +lp: O.C(F), +h: O.C(F), +tf: O.C(F), +t: O.C(F), +ex: O.C(F), +hlp: O.le(~F, O.zero(F), lp), +htf: O.le(~F, O.zero(F), tf), +hht: O.le(~F, h, t), +hex: O.lt(F, O.zero(F), ex), hts: O.lt(F, O.mul(F, t, O.mul(F, $WW, O.inv(F, ex))), O.one(F))) -> O.lt(F, O.add(F, $MM, $MM), ex):
  +hw = FO.mul_nonneg(~F, O.add(F, lp, lp), tf, FO.nonneg_add(~F, lp, lp, hlp, hlp), htf)
  +h1 = FV.le_of_sub(~F, O.add(F, $MM, $MM), O.mul(F, t, $WW), FM.nn_eq(~F, O.sub(~F, O.mul(F, t, $WW), O.add(F, $MM, $MM)), O.mul(F, O.sub(~F, t, h), $WW), @ZEQ[lp,, h,, tf,, t | (t - h)*((lp + lp)*tf) | t*((lp + lp)*tf) - (lp*(h*tf) + lp*(h*tf))], FO.mul_nonneg(~F, O.sub(~F, t, h), $WW, FM.sub_nonneg(~F, h, t, hht), hw)))
  +pr = O.mul(F, ex, O.sub(~F, O.one(F), O.mul(F, t, O.mul(F, $WW, O.inv(F, ex)))))
  +h2 = QE.lt_of_sub(~F, O.mul(F, t, $WW), ex, FO.lt_subst_r(~F, pr, O.sub(~F, ex, O.mul(F, t, $WW)), O.zero(F), @CERTEQ[ex,, t,, lp,, tf,, i=O.inv(F, ex) | ex*(1 - t*(((lp + lp)*tf)*i)) | ex - t*((lp + lp)*tf) | -(t*((lp + lp)*tf)) ; ex*i - 1 || FO.inv_rel(~F, ex, FO.ne_of_gt(~F, ex, O.zero(F), hex))], O.lt_mul(F)(ex, O.sub(~F, O.one(F), O.mul(F, t, O.mul(F, $WW, O.inv(F, ex)))), hex, RL.sub_pos(~F, O.mul(F, t, O.mul(F, $WW, O.inv(F, ex))), O.one(F), hts))))
  FO.le_lt_trans(~F, O.add(F, $MM, $MM), O.mul(F, t, $WW), ex, h1, h2)

# a side over pins only needs no room
def ge_go(~F: O.OField, $SBP, +h: O.C(F), +t: O.C(F), +hht: O.le(~F, h, t), +ht0: O.le(~F, O.zero(F), t), +e: E.QExpr, b: Bool, hs1: SV.Strict.ge(~F, b, x, e), +S: O.C(F), hle: O.le(~F, sbg(~F, b, bb, tf, x, e), S), +hq: O.lt(F, O.mul(F, t, S), O.one(F))) -> SBud.ge(~F, b, bb, O.mul(F, h, tf), x, e):
  match b:
    case True{}:
      hs1
    case False{}:
      FO.lt_le(~F, O.add(F, O.mul(F, BP.lp(~F, bb, e), O.mul(F, h, tf)), O.mul(F, BP.lp(~F, bb, e), O.mul(F, h, tf))), $EX, gt_side(~F, BP.lp(~F, bb, e), h, tf, t, $EX, PB.lp_nn(~F, bb, hb, e), htf, hht, hs1, FO.le_lt_trans(~F, O.mul(F, t, $SBE), O.mul(F, t, S), O.one(F), FV.mul_le(~F, t, $SBE, S, ht0, hle), hq)))

# t S < 1 with the sides' budget within S: every side has its room
def sbud_of(~F: O.OField, $SBP, +h: O.C(F), +t: O.C(F), +hht: O.le(~F, h, t), +ht0: O.le(~F, O.zero(F), t), ss: List<&2, SK.Side>, +pins: List<&2, Nat>, +hs: SV.Strict(~F, x, ss, pins), +S: O.C(F), +hS: O.le(~F, sbs(~F, bb, tf, x, ss, pins), S), +hq: O.lt(F, O.mul(F, t, S), O.one(F))) -> SBud(~F, bb, O.mul(F, h, tf), x, ss, pins):
  match ss:
    case Nil{}:
      Unit{}
    case Con{SK.Gt0{+e}, +r}:
      +h1 = AP.both_l(O.lt(F, O.zero(F), $EX), SV.Strict(~F, x, r, pins), hs)
      +h2 = AP.both_r(O.lt(F, O.zero(F), $EX), SV.Strict(~F, x, r, pins), hs)
      +hle = DM.le_trans(~F, $SBE, O.add(F, $SBE, sbs(~F, bb, tf, x, r, pins)), S, FV.le_addr(~F, $SBE, sbs(~F, bb, tf, x, r, pins), sbs_nn(~F, $SBA, r, pins, h2)), hS)
      +hlr = DM.le_trans(~F, sbs(~F, bb, tf, x, r, pins), O.add(F, $SBE, sbs(~F, bb, tf, x, r, pins)), S, FV.le_addl(~F, $SBE, sbs(~F, bb, tf, x, r, pins), sbe_nn(~F, $SBA, e, h1)), hS)
      (gt_side(~F, BP.lp(~F, bb, e), h, tf, t, $EX, PB.lp_nn(~F, bb, hb, e), htf, hht, h1, FO.le_lt_trans(~F, O.mul(F, t, $SBE), O.mul(F, t, S), O.one(F), FV.mul_le(~F, t, $SBE, S, ht0, hle), hq)), sbud_of(~F, $SBA, h, t, hht, ht0, r, pins, h2, S, hlr, hq))
    case Con{SK.Ge0{+e}, +r}:
      +gb = sbg(~F, SV.inside(e, pins), bb, tf, x, e)
      +h1 = AP.both_l(SV.Strict.ge(~F, SV.inside(e, pins), x, e), SV.Strict(~F, x, r, pins), hs)
      +h2 = AP.both_r(SV.Strict.ge(~F, SV.inside(e, pins), x, e), SV.Strict(~F, x, r, pins), hs)
      +hle = DM.le_trans(~F, gb, O.add(F, gb, sbs(~F, bb, tf, x, r, pins)), S, FV.le_addr(~F, gb, sbs(~F, bb, tf, x, r, pins), sbs_nn(~F, $SBA, r, pins, h2)), hS)
      +hlr = DM.le_trans(~F, sbs(~F, bb, tf, x, r, pins), O.add(F, gb, sbs(~F, bb, tf, x, r, pins)), S, FV.le_addl(~F, gb, sbs(~F, bb, tf, x, r, pins), sbg_nn(~F, $SBA, e, SV.inside(e, pins), h1)), hS)
      (ge_go(~F, $SBA, h, t, hht, ht0, e, SV.inside(e, pins), h1, S, hle, hq), sbud_of(~F, $SBA, h, t, hht, ht0, r, pins, h2, S, hlr, hq))

# The whole budget
# ----------------
# Q = the blocks' smallness + T + the sides' budget; t Q < 1 gives all
# three facts plan_ans needs.

@MACRO QCH PB.qch($CA, $KB, binv, $NP, @0)
@MACRO SBX sbs(~F, $BBS, $TCH, x, $SDK, $PINS)
@MACRO QQ O.add(F, $QCH, O.add(F, $TCH, $SBX))

def budget($SKP, +x: M.Vec(~F), +binv: BI.BInv(~F, x, $FULL, $KB), +hs: SV.Strict(~F, x, $SDK, $PINS), +p: Nat, +ht: O.lt(F, O.mul(F, $VB, $QQ), O.one(F))) -> M.Both(O.lt(F, O.mul(F, $VB, $QCH), O.one(F)), M.Both(O.le(~F, O.mul(F, NW.hnw(~F, p), $TCH), O.one(F)), SBud(~F, $BBS, O.mul(F, NW.hnw(~F, p), $TCH), x, $SDK, $PINS))):
  +hq0 = PB.qch_nn(~F, ~H, $FULL, $GOOD, $VP, x, $KB, binv, $NP, @0, FO.le_refl(~F, @0))
  +htc = PB.tch_nn(~F, ~H, $FULL, $GOOD, $VP, x, $KB, binv, $NP, @0, FO.le_refl(~F, @0))
  +hsb = sbs_nn(~F, $BBS, bbs_nn(~F, x), $TCH, htc, x, $SDK, $PINS, hs)
  +ht0 = BK.vb_nn(~F, p)
  +hht = SC.h_le_t(~F, p)
  +hlq = FV.le_addl(~F, $QCH, O.add(F, $TCH, $SBX), hq0)
  (FO.le_lt_trans(~F, O.mul(F, $VB, $QCH), O.mul(F, $VB, $QQ), O.one(F), FV.mul_le(~F, $VB, $QCH, $QQ, ht0, FV.le_addr(~F, $QCH, O.add(F, $TCH, $SBX), FO.nonneg_add(~F, $TCH, $SBX, htc, hsb))), ht),
  (FO.lt_le(~F, O.mul(F, NW.hnw(~F, p), $TCH), O.one(F), FO.le_lt_trans(~F, O.mul(F, NW.hnw(~F, p), $TCH), O.mul(F, $VB, $QQ), O.one(F), DM.le_trans(~F, O.mul(F, NW.hnw(~F, p), $TCH), O.mul(F, $VB, $TCH), O.mul(F, $VB, $QQ), FV.mul_le_r(~F, NW.hnw(~F, p), $VB, $TCH, htc, hht), FV.mul_le(~F, $VB, $TCH, $QQ, ht0, DM.le_trans(~F, $TCH, O.add(F, $TCH, $SBX), $QQ, FV.le_addr(~F, $TCH, $SBX, hsb), hlq))), ht)),
  sbud_of(~F, $BBS, bbs_nn(~F, x), $TCH, htc, x, NW.hnw(~F, p), $VB, hht, ht0, $SDK, $PINS, hs, $QQ, DM.le_trans(~F, $SBX, O.add(F, $TCH, $SBX), $QQ, FV.le_addl(~F, $TCH, $SBX, htc), hlq), ht)))

# at level l = arch(Q): t Q < 1 at l's first precision
def tq_lt(~F: O.OField, ~R: CR.Complete<F>, +q: O.C(F)) -> O.lt(F, O.mul(F, AP.vbit(~F, Nat.div(pfirst(CR.arch(F, R, q), 64n, 96n), 2n)), q), O.one(F)):
  +l = CR.arch(F, R, q)
  +t = AP.vbit(~F, Nat.div(pfirst(l, 64n, 96n), 2n))
  RL.lt_rw_l(~F, O.mul(F, q, t), O.mul(F, t, q), O.one(F), O.mul_comm(F)(q, t), FO.lt_le_trans(~F, O.mul(F, q, t), O.mul(F, CR.nat(~F, l), t), O.one(F), RL.lt_mul_r(~F, q, CR.nat(~F, l), t, CR.arch_ok(F, R)(q), DM.dpos(~F, S.XH{}, Nat.div(pfirst(l, 64n, 96n), 2n))), DM.le_trans(~F, O.mul(F, CR.nat(~F, l), t), O.mul(F, CR.nat(~F, l), AP.vbit(~F, l)), O.one(F), FV.mul_le(~F, CR.nat(~F, l), t, AP.vbit(~F, l), RL.nat_nn(~F, l), SC.pw_le(~F, l, Nat.div(pfirst(l, 64n, 96n), 2n), pl_half(l))), nv_le(~F, l))))

# The answer at P, from the budget
# --------------------------------

def sub1(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+m:
      m

def sub_eq1(m: Nat, h: {KA.natle(1n, m) == True{} : Bool}) -> {m == 1n+sub1(m) : Nat}:
  match m:
    case 0n:
      FO.absurd({0n == 1n+sub1(0n) : Nat}, KA.ft(h))
    case 1n+k:
      {==}

def sub2_eq(n: Nat, h: {KA.natle(2n, n) == True{} : Bool}) -> {n == 1n+(1n+sub1(sub1(n))) : Nat}:
  match n:
    case 0n:
      FO.absurd({0n == 1n+(1n+sub1(sub1(0n))) : Nat}, KA.ft(h))
    case 1n+m:
      %sub_eq1(m, h) : {1n+m == 1n+_ : Nat}
      {==}

@MACRO BUA O.lt(F, O.mul(F, $VB, $QCH), O.one(F))
@MACRO BUB O.le(~F, O.mul(F, NW.hnw(~F, p), $TCH), O.one(F))
@MACRO BUC SBud(~F, $BBS, O.mul(F, NW.hnw(~F, p), $TCH), x, $SDK, $PINS)

# the system solved has dyadic constants: those of the sketch less its red
# constraints are
def hdy_of(+sk: SK.Sketch, +ha: {D.adjb($ADJ, $NV) == True{} : Bool}, +dy: {SV.dyadic(SV.mark($RC, sk)) == True{} : Bool}) -> {SV.dyeqs(KP.pickk($FULL, 0n, $GOOD)) == True{} : Bool}:
  %SD.kept_good_d(sk, ha) : {SV.dyeqs(_) == True{} : Bool}
  VR.dy_solved(sk, $RC, SV.dropped(SO.cls_of(sk)), L.band_l(SV.dyeqs(SK.Sketch.eqs(SV.mark($RC, sk))), SV.dysides(SK.Sketch.sides(SV.mark($RC, sk))), dy))

def plan_top($SKP, $VXP, +x: M.Vec(~F), +g: List<&2, S.D>, +g0: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, +hz: SK.Zeros(~F, x, SO.kept(sk)), +hpa: SV.PinnedAt($DN, ~F, ~H, x, $PINS, g0), +hs: SV.Strict(~F, x, $SDK, $PINS), +binv: BI.BInv(~F, x, $FULL, $KB), +p: Nat, +hp2: {KA.natle(2n, p) == True{} : Bool}, +hN: SV.Near($DN, ~F, ~H, $NV, 0n, g, x, NW.hnw(~F, p), $PINS, g0), +ht: O.lt(F, O.mul(F, $VB, $QQ), O.one(F))) -> AnsOK(~F, ~H, sk, g, x, NU.plan(SO.kept(sk), $NV, SO.skel_of(sk), g, p)):
  +bu = budget($SKA, x, binv, hs, p, ht)
  +bu2 = AP.both_r($BUA, M.Both($BUB, $BUC), bu)
  plan_ans($SKA, x, g, g0, p, sub1(sub1(p)), sub2_eq(p, hp2), NW.hnw(~F, p), NW.hnw_nn(~F, p), FO.le_refl(~F, NW.hnw(~F, p)), hdy_of(sk, ha, dy), hz, hN, hpa, binv, AP.both_l($BUA, M.Both($BUB, $BUC), bu), $VXA, hl, AP.both_l($BUB, $BUC, bu2), AP.both_r($BUB, $BUC, bu2))

# The precision loop
# ------------------

def ploop_true(t: List<&2, Nat>, +cur: NU.PR, +sk: SK.Sketch, +g0: List<&2, S.D>, +cls: List<&2, SV.Class>, +pins: List<&2, Nat>, +es: List<&2, E.QExpr>, +nv: Nat, +skel: ST.Skel) -> {SO.ploop(t, True{}, cur, sk, g0, cls, pins, es, nv, skel) == cur : NU.PR}:
  match t:
    case Nil{}:
      {==}
    case Con{p, r}:
      {==}

def final_of(nx: NU.PR, +sk: SK.Sketch, +g0: List<&2, S.D>, +cls: List<&2, SV.Class>, +pins: List<&2, Nat>, h: {SO.accept(nx, sk, g0, cls, pins) == True{} : Bool}) -> {SO.final(sk, g0, SO.found(cls, pins, nx)) == True{} : Bool}:
  match nx:
    case NU.POk{+y}:
      h
    case NU.PRetry{}:
      FO.absurd({SO.final(sk, g0, SO.found(cls, pins, NU.PRetry{})) == True{} : Bool}, KA.ft(h))
    case NU.PStop{}:
      FO.absurd({SO.final(sk, g0, SO.found(cls, pins, NU.PStop{})) == True{} : Bool}, KA.ft(h))

# the answer the solver gives, and it holds x
def Fin(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +x: M.Vec(~F), o: SO.Out) -> Data:
  M.Both({SO.Out.ok(o) == True{} : Bool}, BX.inbox($DN, ~F, ~H, SO.Out.gc(o), SO.Out.gr(o), x))

def slp(+sk: SK.Sketch, +g: List<&2, S.D>, +ps: List<&2, Nat>) -> SO.Out:
  SO.seal(sk, g, SO.found(SO.cls_of(sk), SO.pins_of(sk), SO.ploop.start(ps, sk, g, SO.cls_of(sk), SO.pins_of(sk), SO.kept(sk), SO.nvars(sk), SO.skel_of(sk))))

@MACRO NXL NU.plan(SO.kept(sk), SO.nvars(sk), SO.skel_of(sk), g, $PL0)
@MACRO RWP SO.cls_of(sk), SO.pins_of(sk)
@MACRO RST SO.kept(sk), SO.nvars(sk), SO.skel_of(sk)

def fin_go(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +sk: SK.Sketch, +g: List<&2, S.D>, +x: M.Vec(~F), +l: Nat, +hacc: {SO.accept($NXL, sk, g, $RWP) == True{} : Bool}, inb: BX.inbox($DN, ~F, ~H, SO.pr.gc($NXL), SO.pr.gr($NXL), x)) -> Fin(~F, ~H, x, SO.solve_l(sk, g, l)):
  %Equal.sym(List<&2, Nat>, SO.precs.from(l, 1n+6n, 64n, 96n), Con{$PL0, ptail(l, 6n, 64n, 96n)}, pf_head(l, 6n, 64n, 96n)) : Fin(~F, ~H, x, slp(sk, g, _))
  %Equal.sym(Bool, SO.accept($NXL, sk, g, $RWP), True{}, hacc) : Fin(~F, ~H, x, SO.seal(sk, g, SO.found($RWP, SO.ploop(ptail(l, 6n, 64n, 96n), _, $NXL, sk, g, $RWP, $RST))))
  %Equal.sym(NU.PR, SO.ploop(ptail(l, 6n, 64n, 96n), True{}, $NXL, sk, g, $RWP, $RST), $NXL, ploop_true(ptail(l, 6n, 64n, 96n), $NXL, sk, g, $RWP, $RST)) : Fin(~F, ~H, x, SO.seal(sk, g, SO.found($RWP, _)))
  (final_of($NXL, sk, g, $RWP, hacc), inb)

# level l's search stops at its first precision, with that answer
def fin_of(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +sk: SK.Sketch, +g: List<&2, S.D>, +x: M.Vec(~F), +l: Nat, h: AnsOK(~F, ~H, sk, g, x, $NXL)) -> Fin(~F, ~H, x, SO.solve_l(sk, g, l)):
  (hacc, inb) = h
  fin_go(~F, ~H, sk, g, x, l, hacc, inb)

# The top
# -------

# Fin as the law states it
def top_pair(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +x: M.Vec(~F), +o: SO.Out, h: Fin(~F, ~H, x, o)) -> ({SO.Out.ok(o) == True{} : Bool} & BX.inbox($DN, ~F, ~H, SO.Out.gc(o), SO.Out.gr(o), x)):
  (h1, h2) = h
  (h1, h2)

@MACRO LQ CR.arch(F, R, $QQ)

def top(~F: O.OField, ~R: CR.Complete<F>, ~H: N.Emb<KI.dnum(), F>, +sk: SK.Sketch, +ha: {D.adjb($ADJ, $NV) == True{} : Bool}, $VXP, +x: M.Vec(~F), +g0: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, +hz: SK.Zeros(~F, x, SO.kept(sk)), +hpa: SV.PinnedAt($DN, ~F, ~H, x, $PINS, g0), +hs: SV.Strict(~F, x, $SDK, $PINS), +binv: BI.BInv(~F, x, $FULL, $KB), +g: List<&2, S.D>, +hN: SV.Near($DN, ~F, ~H, $NV, 0n, g, x, NW.hnw(~F, pfirst($LQ, 64n, 96n)), $PINS, g0)) -> Fin(~F, ~H, x, SO.solve_l(sk, g, $LQ)):
  +l = $LQ
  fin_of(~F, ~H, sk, g, x, l, plan_top(~F, ~H, sk, ha, $VXA, x, g, g0, hl, hz, hpa, hs, binv, pfirst(l, 64n, 96n), KA.natle_trans(2n, Nat.add(64n, Nat.add(l, l)), pfirst(l, 64n, 96n), {==}, pl_ge(l)), hN, tq_lt(~F, ~R, $QQ)))

def top_at(~F: O.OField, ~R: CR.Complete<F>, ~H: N.Emb<KI.dnum(), F>, +sk: SK.Sketch, +ha: {D.adjb($ADJ, $NV) == True{} : Bool}, $VXP, +x: M.Vec(~F), +g0: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, +hz: SK.Zeros(~F, x, SO.kept(sk)), +hpa: SV.PinnedAt($DN, ~F, ~H, x, $PINS, g0), +hs: SV.Strict(~F, x, $SDK, $PINS), +binv: BI.BInv(~F, x, $FULL, $KB), +g: List<&2, S.D>, +hN: SV.Near($DN, ~F, ~H, $NV, 0n, g, x, NW.hnw(~F, pfirst($LQ, 64n, 96n)), $PINS, g0)) -> ({SO.Out.ok(SO.solve_l(sk, g, $LQ)) == True{} : Bool} & BX.inbox($DN, ~F, ~H, SO.Out.gc(SO.solve_l(sk, g, $LQ)), SO.Out.gr(SO.solve_l(sk, g, $LQ)), x)):
  top_pair(~F, ~H, x, SO.solve_l(sk, g, $LQ), top(~F, ~R, ~H, sk, ha, $VXA, x, g0, hl, hz, hpa, hs, binv, g, hN))

@MACRO RC SV.reds(SO.cls_of(sk))
@MACRO AC SV.ambers(SO.cls_of(sk))
@MACRO SOL SV.solved(sk, SV.reds(SO.cls_of(sk)), SV.dropped(SO.cls_of(sk)))

# near a regular solution x of the system solved (the pins at their drawn
# values, the sides of the constraints neither red nor amber strict), every
# drawing close enough to x at the pins' complement gives, at some level,
# a verdict that passes and a box that holds x. The exact checks pass
# whatever the drawing (lib/ckpf.bend: ck_pass).
def complete.go(~F: O.OField, ~R: CR.Complete<F>, ~H: N.Emb<KI.dnum(), F>, +sk: SK.Sketch, w: SK.Sketch.wf(sk), +cov: {BX.Sketch.within(sk, SO.nvars(sk)) == True{} : Bool}, +dy: {SV.dyadic(SV.mark($RC, sk)) == True{} : Bool}, +g0: List<&2, S.D>, +x: M.Vec(~F), +hl: {M.len(~F, x) == SO.nvars(sk) : Nat}, +hp: SV.PinnedAt(~KI.dnum(), ~F, ~H, x, SO.pins_of(sk), g0), +hz: SK.Zeros(~F, x, $SOL), +hs: SV.Strict(~F, x, SK.Sketch.sides(SV.mark(SV.cat($RC, $AC), sk)), SO.pins_of(sk)), hr: DV.Regular(~F, x, $SOL, SV.free(SO.nvars(sk), 0n, SO.pins_of(sk))))
  -> &d: O.C(F) -> (O.lt(F, O.zero(F), d) & (&l: Nat -> (@g: List<&2, S.D> -> SV.Near(~KI.dnum(), ~F, ~H, SO.nvars(sk), 0n, g, x, d, SO.pins_of(sk), g0) -> ({SO.Out.ok(SO.solve_l(sk, g, l)) == True{} : Bool} & BX.inbox(~KI.dnum(), ~F, ~H, SO.Out.gc(SO.solve_l(sk, g, l)), SO.Out.gr(SO.solve_l(sk, g, l)), x))))):
  +hwf = WC.wf_dec_ok(sk, w)
  +ha = CV.cov(sk, SO.nvars(sk), cov, hwf)
  +hex = CKP.ck_pass(sk, GM.adjb_dadjs($FULL, $NV, ha))
  +binv = SD.block_invs_d(~F, sk, ha, x, hr)
  +l = $LQ
  +d = NW.hnw(~F, pfirst(l, 64n, 96n))
  (d, (DM.dpos(~F, S.XH{}, 1n+pfirst(l, 64n, 96n)), (l, g => hN => top_at(~F, ~R, ~H, sk, ha, hwf, cov, dy, hex, x, g0, hl, hz, hp, hs, binv, g, hN))))

# LAW 10 (ROADMAP solve_complete): near a regular solution x of the system
# solved (the pins at their drawn values, the sides of the constraints
# neither red nor amber strict, except that a >= 0 side over pins only
# may hold with equality), with the constants of the sketch less its red
# constraints dyadic, every drawing close enough to x at the pins'
# complement certifies at some level, with x in the box.
def solve_complete(~F: O.OField, ~R: CR.Complete<F>, ~H: N.Emb<KI.dnum(), F>, +sk: SK.Sketch, w: SK.Sketch.wf(sk), +cov: {BX.Sketch.within(sk, SO.nvars(sk)) == True{} : Bool}, +dy: {SV.dyadic(SV.mark(SV.reds(SO.cls_of(sk)), sk)) == True{} : Bool}, +g0: List<&2, S.D>, +x: M.Vec(~F), +hl: {M.len(~F, x) == SO.nvars(sk) : Nat}, +hp: SV.PinnedAt(~KI.dnum(), ~F, ~H, x, SO.pins_of(sk), g0), hz: SK.Zeros(~F, x, SV.solved(sk, SV.reds(SO.cls_of(sk)), SV.dropped(SO.cls_of(sk)))), hs: SV.Strict(~F, x, SK.Sketch.sides(SV.mark(SV.cat(SV.reds(SO.cls_of(sk)), SV.ambers(SO.cls_of(sk))), sk)), SO.pins_of(sk)), hr: DV.Regular(~F, x, SV.solved(sk, SV.reds(SO.cls_of(sk)), SV.dropped(SO.cls_of(sk))), SV.free(SO.nvars(sk), 0n, SO.pins_of(sk)))) -> &d: O.C(F) -> (O.lt(F, O.zero(F), d) & (&l: Nat -> (@g: List<&2, S.D> -> SV.Near(~KI.dnum(), ~F, ~H, SO.nvars(sk), 0n, g, x, d, SO.pins_of(sk), g0) -> ({SO.Out.ok(SO.solve_l(sk, g, l)) == True{} : Bool} & BX.inbox(~KI.dnum(), ~F, ~H, SO.Out.gc(SO.solve_l(sk, g, l)), SO.Out.gr(SO.solve_l(sk, g, l)), x))))):
  complete.go(~F, ~R, ~H, sk, w, cov, dy, g0, x, hl, hp, hz, hs, hr)
