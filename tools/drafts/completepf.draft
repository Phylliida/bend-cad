def absurd(-A: Type, x: Empty) -> A:
  match x:

@MACRO DN ~KI.dnum()
@MACRO FULL SK.Sketch.eqs(sk)
@MACRO ADJ ST.adj($FULL)
@MACRO NQ0 ST.len.q($FULL)
@MACRO NV SO.nvars(sk)
@MACRO GOOD SO.good_of(sk)
@MACRO KVS MX.kvs($ADJ, $NQ0, $NV, $GOOD)
@MACRO VM ST.KD.vm($KVS)
@MACRO FS ST.KD.red($KVS)
@MACRO KB SP.kblocks($ADJ, $NQ0, $NV, $GOOD, $VM, $FS)
@MACRO VP ST.app($FS, ST.allvars($KB))
@MACRO EP ST.positions(ST.alleqs($KB), $GOOD)
@MACRO NP ST.len($FS)
@MACRO BSS ST.renum.bs(ST.skbs($KB, $ADJ, $VP), $GOOD)
@MACRO SYS PL.reorder($VP, $FULL, ST.alleqs($KB))
@MACRO G0B NU.dpick(g, $VP)
@MACRO GC0 NU.dtake($NP, $G0B)
@MACRO GR0 NU.dreps($NP, NU.dzero())
@MACRO XV LC.xperm(~F, x, $VP)
@MACRO HH NW.hnw(~F, p)
@MACRO SKO SP.struct_ok(sk, ha)
@MACRO SF SP.skok_sf($FULL, $NV, $GOOD, $VM, $FS, $KB, $SKO)
@MACRO SFA $ADJ, $NV, $GOOD, $VM, $FS, $KB, $SF

# Lists
# -----

def nt_app(a: List<&2, Nat>, +b: List<&2, Nat>) -> {SO.ntake(ST.len(a), ST.app(a, b)) == a : List<&2, Nat>}:
  match a:
    case Nil{}:
      {==}
    case Con{+h, t}:
      %nt_app(t, b) : {Con{h, SO.ntake(ST.len(t), ST.app(t, b))} == Con{h, _} : List<&2, Nat>}
      {==}

def nlen_st(xs: List<&2, Nat>) -> {PL.nlen(xs) == ST.len(xs) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{h, t}:
      %nlen_st(t) : {1n+PL.nlen(t) == 1n+_ : Nat}
      {==}

def klen_dreps(n: Nat, +z: S.D) -> {KA.klen($DN, NU.dreps(n, z)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      %klen_dreps(m, z) : {1n+KA.klen($DN, NU.dreps(m, z)) == 1n+_ : Nat}
      {==}

def dtake_pick(+g: List<&2, S.D>, +a: List<&2, Nat>, +b: List<&2, Nat>) -> {NU.dtake(ST.len(a), NU.dpick(g, ST.app(a, b))) == NU.dpick(g, a) : List<&2, S.D>}:
  %Equal.sym(List<&2, S.D>, NU.dpick(g, ST.app(a, b)), NU.dapp(NU.dpick(g, a), NU.dpick(g, b)), PB.dpick_app(g, a, b)) : {NU.dtake(ST.len(a), _) == NU.dpick(g, a) : List<&2, S.D>}
  %Equal.trans(Nat, KA.klen($DN, NU.dpick(g, a)), PL.nlen(a), ST.len(a), PB.klen_pick(g, a), nlen_st(a)) : {NU.dtake(_, NU.dapp(NU.dpick(g, a), NU.dpick(g, b))) == NU.dpick(g, a) : List<&2, S.D>}
  PB.dtake_dapp(NU.dpick(g, a), NU.dpick(g, b))

def ft_xperm(~F: O.OField, +x: M.Vec(~F), +a: List<&2, Nat>, +b: List<&2, Nat>) -> {PP.ftake(~F, ST.len(a), LC.xperm(~F, x, ST.app(a, b))) == LC.xperm(~F, x, a) : M.Vec(~F)}:
  %Equal.sym(M.Vec(~F), LC.xperm(~F, x, ST.app(a, b)), C.app(~F, LC.xperm(~F, x, a), LC.xperm(~F, x, b)), PB.xperm_app(~F, x, a, b)) : {PP.ftake(~F, ST.len(a), _) == LC.xperm(~F, x, a) : M.Vec(~F)}
  %Equal.trans(Nat, M.len(~F, LC.xperm(~F, x, a)), SV.len(a), ST.len(a), PB.len_xperm(~F, x, a), Equal.sym(Nat, ST.len(a), SV.len(a), TJ.len_sv(a))) : {PP.ftake(~F, _, C.app(~F, LC.xperm(~F, x, a), LC.xperm(~F, x, b))) == LC.xperm(~F, x, a) : M.Vec(~F)}
  PB.ftake_app(~F, LC.xperm(~F, x, a), LC.xperm(~F, x, b))

# The pins' box holds x
# ---------------------

def pin_zero(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +x: M.Vec(~F), +g: List<&2, S.D>, +g0: List<&2, S.D>, +v: Nat, +h1: {O.lookup(~F, x, v) == O.lookup(~F, N.ofkv($DN, ~F, ~H, g0), v) : @T}, +h2: {O.lookup(~F, N.ofkv($DN, ~F, ~H, g), v) == O.lookup(~F, N.ofkv($DN, ~F, ~H, g0), v) : @T}) -> M.bnd(~F, @S(O.lookup(~F, x, v), M.ofd(~F, NU.dlook(g, v))), M.ofd(~F, NU.dzero())):
  %DM.ofd_zero(~F) : M.bnd(~F, @S(O.lookup(~F, x, v), M.ofd(~F, NU.dlook(g, v))), _)
  %Equal.sym(@T, @S(O.lookup(~F, x, v), M.ofd(~F, NU.dlook(g, v))), @0, FO.sub_of_eq(~F, O.lookup(~F, x, v), M.ofd(~F, NU.dlook(g, v)), Equal.trans(@T, O.lookup(~F, x, v), O.lookup(~F, N.ofkv($DN, ~F, ~H, g0), v), M.ofd(~F, NU.dlook(g, v)), h1, Equal.trans(@T, O.lookup(~F, N.ofkv($DN, ~F, ~H, g0), v), O.lookup(~F, N.ofkv($DN, ~F, ~H, g), v), M.ofd(~F, NU.dlook(g, v)), Equal.sym(@T, O.lookup(~F, N.ofkv($DN, ~F, ~H, g), v), O.lookup(~F, N.ofkv($DN, ~F, ~H, g0), v), h2), PB.lk_kv(~F, ~H, g, v))))) : M.bnd(~F, _, @0)
  FM.bnd_zero(~F, @0, FO.le_refl(~F, @0))

def pin_g(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +nv: Nat, +v: Nat, +g: List<&2, S.D>, +x: M.Vec(~F), +d: @T, +pins: List<&2, Nat>, +g0: List<&2, S.D>, +hm: {SV.mem(v, pins) == True{} : Bool}, +hv: {KA.natle(1n+v, nv) == True{} : Bool}, +hN: SV.Near($DN, ~F, ~H, nv, 0n, g, x, d, pins, g0)) -> {O.lookup(~F, N.ofkv($DN, ~F, ~H, g), v) == O.lookup(~F, N.ofkv($DN, ~F, ~H, g0), v) : @T}:
  %hm : SV.Near.go($DN, ~F, ~H, _, g, x, d, g0, v)
  PB.near_at(~F, ~H, nv, 0n, v, g, x, d, pins, g0, {==}, hv, hN)

# |x - g| <= 0 at every pin
def pins_rb(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +nv: Nat, +g: List<&2, S.D>, +x: M.Vec(~F), +d: @T, +pins: List<&2, Nat>, +g0: List<&2, S.D>, +hN: SV.Near($DN, ~F, ~H, nv, 0n, g, x, d, pins, g0), ws: List<&2, Nat>, +hs: {L.subl(ws, pins) == True{} : Bool}, +hb: {SV.below(ws, nv) == True{} : Bool}, hpa: SV.PinnedAt($DN, ~F, ~H, x, ws, g0)) -> BX.rbnd(~F, BX.vsub(~F, LC.xperm(~F, x, ws), M.ofdv(~F, NU.dpick(g, ws))), M.ofdv(~F, NU.dreps(ST.len(ws), NU.dzero()))):
  match ws:
    case Nil{}:
      Unit{}
    case Con{+v, +t}:
      match hpa:
        case (h1, ht):
          (pin_zero(~F, ~H, x, g, g0, v, h1, pin_g(~F, ~H, nv, v, g, x, d, pins, g0, L.subl_hd(v, t, pins, hs), (%L.lt_sv(v, nv) : {_ == True{} : Bool}
            L.band_l(SV.lt(v, nv), SV.below(t, nv), hb)), hN)),
          pins_rb(~F, ~H, nv, g, x, d, pins, g0, hN, t, L.subl_tl(v, t, pins, hs), L.band_r(SV.lt(v, nv), SV.below(t, nv), hb), ht))

def kt_eq(+u: List<&2, S.D>, +n: Nat, +h: {KA.klen($DN, u) == n : Nat}) -> {PL.ktake($DN, n, u) == u : List<&2, S.D>}:
  %h : {PL.ktake($DN, _, u) == u : List<&2, S.D>}
  PB.kt_len($DN, u)

def rnn_dreps(~F: O.OField, n: Nat) -> FV.rnn(~F, M.ofdv(~F, NU.dreps(n, NU.dzero()))):
  match n:
    case 0n:
      Unit{}
    case 1n+m:
      ((%DM.ofd_zero(~F) : O.le(~F, @0, _)
        FO.le_refl(~F, @0)), rnn_dreps(~F, m))

def vb_dreps(~F: O.OField, n: Nat, +c: @T, +hc: O.le(~F, @0, c)) -> M.vbnd.all(~F, M.ofdv(~F, NU.dreps(n, NU.dzero())), c):
  match n:
    case 0n:
      Unit{}
    case 1n+m:
      ((%DM.ofd_zero(~F) : M.bnd(~F, _, c)
        FM.bnd_zero(~F, c, hc)), vb_dreps(~F, m, c, hc))

@MACRO SKP ~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +sk: SK.Sketch, +ha: {D.adjb($ADJ, $NV) == True{} : Bool}
@MACRO SKA ~F, ~H, sk, ha
@MACRO PINS SO.pins_of(sk)

def fs_pins($SKP) -> {SO.ntake($NP, $VP) == $FS : List<&2, Nat>}:
  nt_app($FS, ST.allvars($KB))

# the pins' box, with x at the pins
def pbox0($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, +g0: List<&2, S.D>, +d: @T, +hN: SV.Near($DN, ~F, ~H, $NV, 0n, g, x, d, $PINS, g0), +hpa: SV.PinnedAt($DN, ~F, ~H, x, $PINS, g0)) -> PP.pbox($DN, ~F, ~H, $GC0, $GR0, $NP, PP.ftake(~F, $NP, $XV)):
  +kg = Equal.trans(Nat, KA.klen($DN, NU.dpick(g, $FS)), PL.nlen($FS), $NP, PB.klen_pick(g, $FS), nlen_st($FS))
  %Equal.sym(M.Vec(~F), PP.ftake(~F, $NP, $XV), LC.xperm(~F, x, $FS), ft_xperm(~F, x, $FS, ST.allvars($KB))) : PP.pbox($DN, ~F, ~H, $GC0, $GR0, $NP, _)
  %Equal.sym(List<&2, S.D>, $GC0, NU.dpick(g, $FS), dtake_pick(g, $FS, ST.allvars($KB))) : PP.pbox($DN, ~F, ~H, _, $GR0, $NP, LC.xperm(~F, x, $FS))
  %Equal.sym(List<&2, S.D>, PL.ktake($DN, $NP, NU.dpick(g, $FS)), NU.dpick(g, $FS), kt_eq(NU.dpick(g, $FS), $NP, kg)) : M.Both({M.len(~F, LC.xperm(~F, x, $FS)) == $NP : Nat}, BX.rbnd(~F, BX.vsub(~F, LC.xperm(~F, x, $FS), N.ofkv($DN, ~F, ~H, _)), N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NP, $GR0))))
  %Equal.sym(List<&2, S.D>, PL.ktake($DN, $NP, $GR0), $GR0, kt_eq($GR0, $NP, klen_dreps($NP, NU.dzero()))) : M.Both({M.len(~F, LC.xperm(~F, x, $FS)) == $NP : Nat}, BX.rbnd(~F, BX.vsub(~F, LC.xperm(~F, x, $FS), N.ofkv($DN, ~F, ~H, NU.dpick(g, $FS))), N.ofkv($DN, ~F, ~H, _)))
  %Equal.sym(M.Vec(~F), N.ofkv($DN, ~F, ~H, NU.dpick(g, $FS)), M.ofdv(~F, NU.dpick(g, $FS)), AP.ofkv_d(~F, ~H, NU.dpick(g, $FS))) : M.Both({M.len(~F, LC.xperm(~F, x, $FS)) == $NP : Nat}, BX.rbnd(~F, BX.vsub(~F, LC.xperm(~F, x, $FS), _), N.ofkv($DN, ~F, ~H, $GR0)))
  %Equal.sym(M.Vec(~F), N.ofkv($DN, ~F, ~H, $GR0), M.ofdv(~F, $GR0), AP.ofkv_d(~F, ~H, $GR0)) : M.Both({M.len(~F, LC.xperm(~F, x, $FS)) == $NP : Nat}, BX.rbnd(~F, BX.vsub(~F, LC.xperm(~F, x, $FS), M.ofdv(~F, NU.dpick(g, $FS))), _))
  (Equal.trans(Nat, M.len(~F, LC.xperm(~F, x, $FS)), SV.len($FS), $NP, PB.len_xperm(~F, x, $FS), Equal.sym(Nat, $NP, SV.len($FS), TJ.len_sv($FS))),
  pins_rb(~F, ~H, $NV, g, x, d, $PINS, g0, hN, $FS, (%Equal.sym(List<&2, Nat>, SO.ntake($NP, $VP), $FS, fs_pins($SKA)) : {L.subl($FS, _) == True{} : Bool}
    L.subl_refl($FS)), PB.below_app_l($FS, ST.allvars($KB), $NV, SP.sfacts_vpb($SFA)), (%fs_pins($SKA) : SV.PinnedAt($DN, ~F, ~H, x, _, g0)
    hpa)))

@MACRO VB AP.vbit(~F, Nat.div(p, 2n))
@MACRO CA ~F, $FULL, $GOOD, $VP, x
@MACRO TP $SKP, +x: M.Vec(~F), +g: List<&2, S.D>, +g0: List<&2, S.D>, +p: Nat, +q2: Nat, +hp2: {p == 1n+(1n+q2) : Nat}, +d: @T, +hd0: O.le(~F, @0, d), +hdh: O.le(~F, d, $HH), +hdy: {SV.dyeqs($FULL) == True{} : Bool}, +hz: SK.Zeros(~F, x, SO.kept(sk)), +hN: SV.Near($DN, ~F, ~H, $NV, 0n, g, x, d, $PINS, g0), +hpa: SV.PinnedAt($DN, ~F, ~H, x, $PINS, g0), +binv: BI.BInv(~F, x, $FULL, $KB), +hsq: O.lt(F, @M($VB, PB.qch($CA, $KB, binv, $NP, @0)), @1)
@MACRO TA $SKA, x, g, g0, p, q2, hp2, d, hd0, hdh, hdy, hz, hN, hpa, binv, hsq

# the blocks in turn from the pins' box
def plan_pg($TP) -> PB.PG(~F, ~H, $VP, $NV, x, p, $NP, $GC0, $GR0, $SYS, PB.tch($CA, $KB, binv, $NP, @0), NU.pblocks($BSS, NU.bcert($BSS, $SYS, $G0B, p, $NP, $GC0, $GR0), $SYS, $G0B, p, $NP, $GC0, $GR0, Nil{})):
  +hvd = SP.sfacts_vpd($SFA)
  PB.pb_ok(~F, ~H, $FULL, $GOOD, $VP, $NV, $VM, x, g, g0, $PINS, p, q2, hp2, d, hd0, hdh, hdy, (%KP.kept_good(sk, ha) : SK.Zeros(~F, x, _)
    hz), hN, hvd, L.eq_ok(SV.len($VP), $NV, SP.sfacts_vpl($SFA)),
    $KB, binv, $FS, $NP, Equal.sym(Nat, ST.len($FS), SV.len($FS), TJ.len_sv($FS)), {==}, SP.skok_sw($FULL, $NV, $GOOD, $VM, $FS, $KB, $SKO), SP.sfacts_ch($SFA), SP.sfacts_lk($SFA), SP.sfacts_gc($SFA),
    (%Equal.sym(List<&2, Nat>, SO.ntake($NP, $VP), $FS, fs_pins($SKA)) : {MX.disj(ST.allvars($KB), _) == True{} : Bool}
      BI.disj_swap($FS, ST.allvars($KB), BI.dist_disj($FS, ST.allvars($KB), hvd))),
    PB.below_app_r($FS, ST.allvars($KB), $NV, SP.sfacts_vpb($SFA)),
    $GC0, $GR0,
    (%Equal.sym(List<&2, S.D>, $GC0, NU.dpick(g, $FS), dtake_pick(g, $FS, ST.allvars($KB))) : {KA.klen($DN, _) == $NP : Nat}
      Equal.trans(Nat, KA.klen($DN, NU.dpick(g, $FS)), PL.nlen($FS), $NP, PB.klen_pick(g, $FS), nlen_st($FS))),
    klen_dreps($NP, NU.dzero()), pbox0($SKA, x, g, g0, d, hN, hpa), rnn_dreps(~F, $NP), @0, FO.le_refl(~F, @0), vb_dreps(~F, $NP, @M($HH, @0), FO.mul_nonneg(~F, $HH, @0, NW.hnw_nn(~F, p), FO.le_refl(~F, @0))), hsq)

# The answer at P
# ---------------
# PG's facts about the blocks' result (gcf, grf in block order) give the
# whole verdict about the answer the solver reads back (unperm).

# lookups agree
def dnth_dl(xs: List<&2, S.D>, k: Nat) -> {SV.dnth(xs, k) == NU.dlook(xs, k) : S.D}:
  match xs k:
    case Nil{} k:
      {==}
    case Con{h, t} 0n:
      {==}
    case Con{h, t} 1n+j:
      dnth_dl(t, j)

def dlook_pick(+g: List<&2, S.D>, ks: List<&2, Nat>, j: Nat, h: {KA.natle(1n+j, PL.nlen(ks)) == True{} : Bool}) -> {NU.dlook(NU.dpick(g, ks), j) == NU.dlook(g, PL.nthn(ks, j)) : S.D}:
  match ks j:
    case Nil{} j:
      FO.absurd({NU.dlook(Nil{}, j) == NU.dlook(g, PL.nthn(Nil{}, j)) : S.D}, KA.ft(h))
    case Con{k, t} 0n:
      {==}
    case Con{k, t} 1n+i:
      dlook_pick(g, t, i, h)

def dlook_dreps(n: Nat, +z: S.D, j: Nat, h: {KA.natle(1n+j, n) == True{} : Bool}) -> {NU.dlook(NU.dreps(n, z), j) == z : S.D}:
  match n j:
    case 0n j:
      FO.absurd({NU.dlook(Nil{}, j) == z : S.D}, KA.ft(h))
    case 1n+m 0n:
      {==}
    case 1n+m 1n+i:
      dlook_dreps(m, z, i, h)

# the box in the system's order at variable j is the block-order box at
# j's position
def up_kl(n: Nat, +k: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>, j: Nat, h: {KA.natle(1n+j, n) == True{} : Bool}) -> {KB.klook($DN, NU.unperm(n, k, u, vp), j) == KB.klook($DN, u, PL.pos(Nat.add(j, k), vp)) : S.D}:
  match n j:
    case 0n j:
      FO.absurd({KB.klook($DN, Nil{}, j) == KB.klook($DN, u, PL.pos(Nat.add(j, k), vp)) : S.D}, KA.ft(h))
    case 1n+m 0n:
      %SP.pos_eq(k, vp) : {NU.dlook(u, _) == KB.klook($DN, u, PL.pos(k, vp)) : S.D}
      PB.dl_kl(u, PL.pos(k, vp))
    case 1n+m 1n++i:
      %Equal.sym(Nat, 1n+Nat.add(i, k), Nat.add(i, 1n+k), LN.add_succ(i, k)) : {KB.klook($DN, NU.unperm(m, 1n+k, u, vp), i) == KB.klook($DN, u, PL.pos(_, vp)) : S.D}
      up_kl(m, 1n+k, u, vp, i, h)

def up_kl0(+n: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>, +j: Nat, h: {KA.natle(1n+j, n) == True{} : Bool}) -> {KB.klook($DN, NU.unperm(n, 0n, u, vp), j) == KB.klook($DN, u, PL.pos(j, vp)) : S.D}:
  %Equal.sym(Nat, j, Nat.add(j, 0n), LN.add_zero(j)) : {KB.klook($DN, NU.unperm(n, 0n, u, vp), j) == KB.klook($DN, u, PL.pos(_, vp)) : S.D}
  up_kl(n, 0n, u, vp, j, h)

def klen_up(n: Nat, +k: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>) -> {KA.klen($DN, NU.unperm(n, k, u, vp)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      %Equal.sym(Nat, KA.klen($DN, NU.unperm(m, 1n+k, u, vp)), m, klen_up(m, 1n+k, u, vp)) : {1n+_ == 1n+m : Nat}
      {==}

def length_up(n: Nat, +k: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>) -> {List.length(&2, S.D, NU.unperm(n, k, u, vp)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      %Equal.sym(Nat, List.length(&2, S.D, NU.unperm(m, 1n+k, u, vp)), m, length_up(m, 1n+k, u, vp)) : {1n+_ == 1n+m : Nat}
      {==}

# kdrop peels one entry
def kd_con(k: Nat, u: List<&2, S.D>, h: {KA.natle(1n+k, KA.klen($DN, u)) == True{} : Bool}) -> {PL.kdrop($DN, k, u) == Con{KB.klook($DN, u, k), PL.kdrop($DN, 1n+k, u)} : List<&2, S.D>}:
  match k u:
    case k Nil{}:
      FO.absurd({PL.kdrop($DN, k, Nil{}) == Con{KB.klook($DN, Nil{}, k), PL.kdrop($DN, 1n+k, Nil{})} : List<&2, S.D>}, KA.ft(h))
    case 0n Con{a, t}:
      {==}
    case 1n+i Con{a, t}:
      kd_con(i, t, h)

def kd_all(u: List<&2, S.D>) -> {PL.kdrop($DN, KA.klen($DN, u), u) == Nil{} : List<&2, S.D>}:
  match u:
    case Nil{}:
      {==}
    case Con{a, t}:
      kd_all(t)

def kp_up.hk(+k: Nat, +lt: Nat, +u: List<&2, S.D>, hl: {Nat.add(k, 1n+lt) == KA.klen($DN, u) : Nat}) -> {KA.natle(1n+k, KA.klen($DN, u)) == True{} : Bool}:
  %hl : {KA.natle(1n+k, _) == True{} : Bool}
  %LN.add_succ(k, lt) : {KA.natle(1n+k, _) == True{} : Bool}
  L.le_add_r(k, lt)

def lt_nl(+w: Nat, +n: Nat, h: {SV.lt(w, n) == True{} : Bool}) -> {KA.natle(1n+w, n) == True{} : Bool}:
  %L.lt_sv(w, n) : {_ == True{} : Bool}
  h

def kl_at(+n: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>, +w: Nat, +k: Nat, hp: {PL.pos(w, vp) == k : Nat}, hw: {KA.natle(1n+w, n) == True{} : Bool}) -> {KB.klook($DN, NU.unperm(n, 0n, u, vp), w) == KB.klook($DN, u, k) : S.D}:
  %hp : {KB.klook($DN, NU.unperm(n, 0n, u, vp), w) == KB.klook($DN, u, _) : S.D}
  up_kl0(n, u, vp, w, hw)

# read back in block order from position k on: the block-order box from k
def kp_up(+n: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>, ws: List<&2, Nat>, +k: Nat, +hr: {LC.posrun(vp, ws, 0n, k) == True{} : Bool}, +hb: {SV.below(ws, n) == True{} : Bool}, +hl: {Nat.add(k, SV.len(ws)) == KA.klen($DN, u) : Nat}) -> {PL.kperm($DN, NU.unperm(n, 0n, u, vp), ws) == PL.kdrop($DN, k, u) : List<&2, S.D>}:
  match ws:
    case Nil{}:
      %Equal.sym(Nat, k, KA.klen($DN, u), Equal.trans(Nat, k, Nat.add(k, 0n), KA.klen($DN, u), LN.add_zero(k), hl)) : {Nil{} == PL.kdrop($DN, _, u) : List<&2, S.D>}
      Equal.sym(List<&2, S.D>, PL.kdrop($DN, KA.klen($DN, u), u), Nil{}, kd_all(u))
    case Con{+w, +t}:
      +hp = GJ.nateq_ok(PL.pos(w, vp), k, L.band_l(KA.nateq(PL.pos(w, vp), k), LC.posrun(vp, t, 0n, 1n+k), hr))
      +hw = lt_nl(w, n, L.band_l(SV.lt(w, n), SV.below(t, n), hb))
      %Equal.sym(List<&2, S.D>, PL.kdrop($DN, k, u), Con{KB.klook($DN, u, k), PL.kdrop($DN, 1n+k, u)}, kd_con(k, u, kp_up.hk(k, SV.len(t), u, hl))) : {Con{KB.klook($DN, NU.unperm(n, 0n, u, vp), w), PL.kperm($DN, NU.unperm(n, 0n, u, vp), t)} == _ : List<&2, S.D>}
      %kp_up(n, u, vp, t, 1n+k, L.band_r(KA.nateq(PL.pos(w, vp), k), LC.posrun(vp, t, 0n, 1n+k), hr), L.band_r(SV.lt(w, n), SV.below(t, n), hb), Equal.trans(Nat, 1n+Nat.add(k, SV.len(t)), Nat.add(k, 1n+SV.len(t)), KA.klen($DN, u), LN.add_succ(k, SV.len(t)), hl)) : {Con{KB.klook($DN, NU.unperm(n, 0n, u, vp), w), PL.kperm($DN, NU.unperm(n, 0n, u, vp), t)} == Con{KB.klook($DN, u, k), _} : List<&2, S.D>}
      %kl_at(n, u, vp, w, k, hp, hw) : {Con{KB.klook($DN, NU.unperm(n, 0n, u, vp), w), PL.kperm($DN, NU.unperm(n, 0n, u, vp), t)} == Con{_, PL.kperm($DN, NU.unperm(n, 0n, u, vp), t)} : List<&2, S.D>}
      {==}

# the solver's read-back box, put back in block order, is the blocks' box
def kp_vp($SKP, +u: List<&2, S.D>, +hu: {KA.klen($DN, u) == $NV : Nat}) -> {PL.kperm($DN, NU.unperm($NV, 0n, u, $VP), $VP) == u : List<&2, S.D>}:
  +hvd = SP.sfacts_vpd($SFA)
  +hl = Equal.trans(Nat, SV.len($VP), $NV, KA.klen($DN, u), L.eq_ok(SV.len($VP), $NV, SP.sfacts_vpl($SFA)), Equal.sym(Nat, KA.klen($DN, u), $NV, hu))
  kp_up($NV, u, $VP, $VP, 0n, PB.posrun_of($VP, $VP, Nil{}, Nil{}, 0n, 0n, Equal.sym(List<&2, Nat>, ST.app($VP, Nil{}), $VP, TJ.app_nil($VP)), {==}, hvd), SP.sfacts_vpb($SFA), hl)

# The permutations: vp and ep
# ---------------------------

# each of the c numbers from i0 (c + i0 = n) is in xs, all below n being
def pres_of(~xs: List<&2, Nat>, ~n: Nat, ~hm: @i: Nat -> {KA.natle(1n+i, n) == True{} : Bool} -> {SV.mem(i, xs) == True{} : Bool}, c: Nat, +i0: Nat, +e: {Nat.add(c, i0) == n : Nat}) -> {PL.present(xs, c, i0) == True{} : Bool}:
  match c:
    case 0n:
      {==}
    case 1n++d:
      AP.band_t(KA.natle(1n+PL.pos(i0, xs), PL.nlen(xs)), PL.present(xs, d, 1n+i0), LC.pos_lt(i0, xs, hm(i0, BA.natle_of(d, i0, n, e))), pres_of(~xs, ~n, ~hm, d, 1n+i0, BA.lk_next(d, i0, n, e)))

def pars_of(+o: Nat, xs: List<&2, Nat>, +h: {SV.below(xs, o) == True{} : Bool}) -> {PL.pars_ok(o, xs) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+v, +t}:
      AP.band_t(KA.natle(1n+v, o), PL.pars_ok(o, t), lt_nl(v, o, L.band_l(SV.lt(v, o), SV.below(t, o), h)), pars_of(o, t, L.band_r(SV.lt(v, o), SV.below(t, o), h)))

# every variable is in vp (pigeonhole: nv distinct ones below nv)
def vp_le($SKP) -> {KA.natle(SV.len(ST.down($NV)), SV.len($VP)) == True{} : Bool}:
  %Equal.sym(Nat, SV.len(ST.down($NV)), $NV, MX.down_len($NV)) : {KA.natle(_, SV.len($VP)) == True{} : Bool}
  %Equal.sym(Nat, SV.len($VP), $NV, L.eq_ok(SV.len($VP), $NV, SP.sfacts_vpl($SFA))) : {KA.natle($NV, _) == True{} : Bool}
  L.le_refl($NV)

def vp_down($SKP) -> {L.subl(ST.down($NV), $VP) == True{} : Bool}:
  SP.pigc($VP, ST.down($NV), SP.sfacts_vpd($SFA), SP.below_down($VP, $NV, SP.sfacts_vpb($SFA)), vp_le($SKA))

def vp_has($SKP, +i: Nat, hi: {KA.natle(1n+i, $NV) == True{} : Bool}) -> {SV.mem(i, $VP) == True{} : Bool}:
  L.subl_mem(i, ST.down($NV), $VP, SP.mem_down(i, $NV, hi), vp_down($SKA))

def vp_pres($SKP) -> {PL.present($VP, $NV, 0n) == True{} : Bool}:
  pres_of(~$VP, ~$NV, ~(i => hi => vp_has($SKA, i, hi)), $NV, 0n, BA.lk_end($NV))

def mem_nth(xs: List<&2, Nat>, i: Nat, h: {KA.natle(1n+i, PL.nlen(xs)) == True{} : Bool}) -> {SV.mem(PL.nthn(xs, i), xs) == True{} : Bool}:
  match xs i:
    case Nil{} i:
      FO.absurd({SV.mem(PL.nthn(Nil{}, i), Nil{}) == True{} : Bool}, KA.ft(h))
    case Con{+x, t} 0n:
      L.bor_l(SV.eq(x, x), SV.mem(x, t), L.eq_refl(x))
    case Con{+x, +t} 1n++j:
      L.bor_r(SV.eq(PL.nthn(t, j), x), SV.mem(PL.nthn(t, j), t), mem_nth(t, j, h))

def ne_go(+y: Nat, +x: Nat, +t: List<&2, Nat>, b: Bool, e: {KA.nateq(y, x) == b : Bool}, hy: {SV.mem(y, t) == True{} : Bool}, hx: {SV.mem(x, t) == False{} : Bool}) -> {b == False{} : Bool}:
  match b:
    case True{}:
      FO.absurd({True{} == False{} : Bool}, KA.ft((%hx : {_ == True{} : Bool}
        (%GJ.nateq_ok(y, x, e) : {SV.mem(_, t) == True{} : Bool}
          hy))))
    case False{}:
      {==}

# in a distinct list, the k-th entry is at position k
def pos_nth_d(xs: List<&2, Nat>, i: Nat, +hd: {SV.distinct(xs) == True{} : Bool}, +h: {KA.natle(1n+i, PL.nlen(xs)) == True{} : Bool}) -> {PL.pos(PL.nthn(xs, i), xs) == i : Nat}:
  match xs i:
    case Nil{} i:
      FO.absurd({PL.pos(PL.nthn(Nil{}, i), Nil{}) == i : Nat}, KA.ft(h))
    case Con{+x, t} 0n:
      %Equal.sym(Bool, KA.nateq(x, x), True{}, GJ.nateq_refl(x)) : {PL.pos.go(_, PL.pos(x, t)) == 0n : Nat}
      {==}
    case Con{+x, +t} 1n++j:
      +y = PL.nthn(t, j)
      %Equal.sym(Bool, KA.nateq(y, x), False{}, ne_go(y, x, t, KA.nateq(y, x), {==}, mem_nth(t, j, h), L.dist_hd(x, t, hd))) : {PL.pos.go(_, PL.pos(y, t)) == 1n+j : Nat}
      %Equal.sym(Nat, PL.pos(y, t), j, pos_nth_d(t, j, L.dist_tl(x, t, hd), h)) : {1n+_ == 1n+j : Nat}
      {==}

def mp_go(+y: Nat, +x: Nat, +t: List<&2, Nat>, +good: List<&2, Nat>, b: Bool, e: {SV.eq(y, x) == b : Bool}, h: {SV.bor(b, SV.mem(y, t)) == True{} : Bool}, ih: {SV.mem(y, t) == True{} : Bool} -> {SV.mem(ST.pos(y, good), ST.positions(t, good)) == True{} : Bool}) -> {SV.bor(SV.eq(ST.pos(y, good), ST.pos(x, good)), SV.mem(ST.pos(y, good), ST.positions(t, good))) == True{} : Bool}:
  match b:
    case True{}:
      %L.eq_ok(y, x, e) : {SV.bor(SV.eq(ST.pos(y, good), ST.pos(_, good)), SV.mem(ST.pos(y, good), ST.positions(t, good))) == True{} : Bool}
      L.bor_l(SV.eq(ST.pos(y, good), ST.pos(y, good)), SV.mem(ST.pos(y, good), ST.positions(t, good)), L.eq_refl(ST.pos(y, good)))
    case False{}:
      L.bor_r(SV.eq(ST.pos(y, good), ST.pos(x, good)), SV.mem(ST.pos(y, good), ST.positions(t, good)), ih(h))

# a member's position is among the positions
def mem_positions(+y: Nat, ws: List<&2, Nat>, +good: List<&2, Nat>, h: {SV.mem(y, ws) == True{} : Bool}) -> {SV.mem(ST.pos(y, good), ST.positions(ws, good)) == True{} : Bool}:
  match ws:
    case Nil{}:
      absurd({SV.mem(ST.pos(y, good), Nil{}) == True{} : Bool}, L.mem_nil(y, h))
    case Con{+x, +t}:
      mp_go(y, x, t, good, SV.eq(y, x), {==}, h, hm => mem_positions(y, t, good, hm))

def gd_kd(kd: ST.KD, +nq: Nat, +nv: Nat, +good: List<&2, Nat>, hv: {SP.vsides(nq, nv, good, kd) == True{} : Bool}) -> {SV.distinct(good) == True{} : Bool}:
  match kd:
    case ST.KD{+vm, +fs, dd}:
      SP.vside_gd(nq, nv, good, vm, fs, hv)

def ni_rw(+xs: List<&2, Nat>, +i: Nat, h: {KA.natle(1n+i, SV.len(xs)) == True{} : Bool}) -> {KA.natle(1n+i, PL.nlen(xs)) == True{} : Bool}:
  %Equal.sym(Nat, PL.nlen(xs), SV.len(xs), PB.nlen_sv(xs)) : {KA.natle(1n+i, _) == True{} : Bool}
  h

def pos_i(+y: Nat, +good: List<&2, Nat>, +i: Nat, +hgd: {SV.distinct(good) == True{} : Bool}, +hi: {KA.natle(1n+i, PL.nlen(good)) == True{} : Bool}, hy: {y == PL.nthn(good, i) : Nat}) -> {ST.pos(y, good) == i : Nat}:
  %SP.pos_eq(y, good) : {_ == i : Nat}
  %Equal.sym(Nat, y, PL.nthn(good, i), hy) : {PL.pos(_, good) == i : Nat}
  pos_nth_d(good, i, hgd, hi)

# every equation number is in ep: alleqs kb holds every good one
def ep_has($SKP, +i: Nat, hi: {KA.natle(1n+i, SV.len($GOOD)) == True{} : Bool}) -> {SV.mem(i, $EP) == True{} : Bool}:
  +hgd = gd_kd($KVS, $NQ0, $NV, $GOOD, SP.vend(sk, ha))
  +hi2 = ni_rw($GOOD, i, hi)
  +y = PL.nthn($GOOD, i)
  %pos_i(y, $GOOD, i, hgd, hi2, {==}) : {SV.mem(_, $EP) == True{} : Bool}
  mem_positions(y, ST.alleqs($KB), $GOOD, L.subl_mem(y, $GOOD, ST.alleqs($KB), mem_nth($GOOD, i, hi2), SP.sfacts_cg($SFA)))

def ep_pres($SKP) -> {PL.present($EP, SV.len($GOOD), 0n) == True{} : Bool}:
  pres_of(~$EP, ~SV.len($GOOD), ~(i => hi => ep_has($SKA, i, hi)), SV.len($GOOD), 0n, BA.lk_end(SV.len($GOOD)))

def pos_in(+x: Nat, +good: List<&2, Nat>, h: {SV.mem(x, good) == True{} : Bool}) -> {KA.natle(1n+ST.pos(x, good), SV.len(good)) == True{} : Bool}:
  %SP.pos_eq(x, good) : {KA.natle(1n+_, SV.len(good)) == True{} : Bool}
  %PB.nlen_sv(good) : {KA.natle(1n+PL.pos(x, good), _) == True{} : Bool}
  LC.pos_lt(x, good, h)

# and only those
def pp_of(ws: List<&2, Nat>, +good: List<&2, Nat>, +hs: {L.subl(ws, good) == True{} : Bool}) -> {PL.pars_ok(SV.len(good), ST.positions(ws, good)) == True{} : Bool}:
  match ws:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      AP.band_t(KA.natle(1n+ST.pos(x, good), SV.len(good)), PL.pars_ok(SV.len(good), ST.positions(t, good)), pos_in(x, good, L.subl_hd(x, t, good, hs)), pp_of(t, good, L.subl_tl(x, t, good, hs)))

def eqlen_lq(es: List<&2, E.QExpr>) -> {CK.eqlen(es) == ST.len.q(es) : Nat}:
  match es:
    case Nil{}:
      {==}
    case Con{e, t}:
      %Equal.sym(Nat, CK.eqlen(t), ST.len.q(t), eqlen_lq(t)) : {1n+_ == 1n+ST.len.q(t) : Nat}
      {==}

def kept_eqlen($SKP) -> {CK.eqlen(SO.kept(sk)) == SV.len($GOOD) : Nat}:
  Equal.trans(Nat, CK.eqlen(SO.kept(sk)), ST.len.q(SO.kept(sk)), SV.len($GOOD), eqlen_lq(SO.kept(sk)), Equal.trans(Nat, ST.len.q(SO.kept(sk)), SV.neqs(SO.kept(sk)), SV.len($GOOD), KP.lenq_neqs(SO.kept(sk)), KP.kept_len(sk, ha)))

# The kept equations use only variables below nv
# ---------------------------------------------

def wc_mark(+red: List<&2, Nat>, cs: List<&2, SK.Rec>, +i: Nat, +n: Nat, +h: {BX.Sketch.within.cons(cs, n) == True{} : Bool}) -> {BX.Sketch.within.cons(SV.mark.cons(red, cs, i), n) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case Con{SK.Rec{id, dr, +k}, +t}:
      CV.and_i(BX.Constraint.within(k, n), BX.Sketch.within.cons(SV.mark.cons(red, t, 1n+i), n), CV.and_l(BX.Constraint.within(k, n), BX.Sketch.within.cons(t, n), h), wc_mark(red, t, 1n+i, n, CV.and_r(BX.Constraint.within(k, n), BX.Sketch.within.cons(t, n), h)))

# marking constraints driven moves no variable
def w_mark(+red: List<&2, Nat>, sk: SK.Sketch, +n: Nat, +h: {BX.Sketch.within(sk, n) == True{} : Bool}) -> {BX.Sketch.within(SV.mark(red, sk), n) == True{} : Bool}:
  match sk:
    case SK.Sketch{vs, +es, +cs}:
      CV.and_i(BX.Sketch.within.ents(es, n), BX.Sketch.within.cons(SV.mark.cons(red, cs, 0n), n), CV.and_l(BX.Sketch.within.ents(es, n), BX.Sketch.within.cons(cs, n), h), wc_mark(red, cs, 0n, n, CV.and_r(BX.Sketch.within.ents(es, n), BX.Sketch.within.cons(cs, n), h)))

def ew_sk(sk: SK.Sketch, +n: Nat, +hcov: {BX.Sketch.within(sk, n) == True{} : Bool}, +hwf: {WF.wf_dec(sk) == True{} : Bool}) -> {CV.ewithin(SK.Sketch.eqs(sk), n) == True{} : Bool}:
  match sk:
    case SK.Sketch{vs, +es, +cs}:
      CV.eqs_go(es, cs, n, CV.and_r(BX.Sketch.within.ents(es, n), BX.Sketch.within.cons(cs, n), hcov), KA.band_r(WF.ents(es, es), WF.cons(es, cs), hwf), CV.and_l(BX.Sketch.within.ents(es, n), BX.Sketch.within.cons(cs, n), hcov), KA.band_l(WF.ents(es, es), WF.cons(es, cs), hwf))

def bxlt(a: Nat, b: Nat) -> {BX.lt(a, b) == KA.natle(1n+a, b) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+j:
      {==}
    case 1n+i 0n:
      {==}
    case 1n+i 1n+j:
      bxlt(i, j)

def slb(e: E.QExpr, +n: Nat, +h: {BX.QExpr.within(e, n) == True{} : Bool}) -> {SL.below(n, e) == True{} : Bool}:
  match e:
    case E.QVar{+j}:
      %bxlt(j, n) : {_ == True{} : Bool}
      h
    case E.QCst{q}:
      {==}
    case E.QAdd{+a, +b}:
      AP.band_t(SL.below(n, a), SL.below(n, b), slb(a, n, CV.and_l(BX.QExpr.within(a, n), BX.QExpr.within(b, n), h)), slb(b, n, CV.and_r(BX.QExpr.within(a, n), BX.QExpr.within(b, n), h)))
    case E.QSub{+a, +b}:
      AP.band_t(SL.below(n, a), SL.below(n, b), slb(a, n, CV.and_l(BX.QExpr.within(a, n), BX.QExpr.within(b, n), h)), slb(b, n, CV.and_r(BX.QExpr.within(a, n), BX.QExpr.within(b, n), h)))
    case E.QMul{+a, +b}:
      AP.band_t(SL.below(n, a), SL.below(n, b), slb(a, n, CV.and_l(BX.QExpr.within(a, n), BX.QExpr.within(b, n), h)), slb(b, n, CV.and_r(BX.QExpr.within(a, n), BX.QExpr.within(b, n), h)))
    case E.QNeg{a}:
      slb(a, n, h)

def eqsb_of(es: List<&2, E.QExpr>, +n: Nat, +h: {CV.ewithin(es, n) == True{} : Bool}) -> {PL.eqs_below(n, es) == True{} : Bool}:
  match es:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      AP.band_t(SL.below(n, e), PL.eqs_below(n, t), slb(e, n, CV.and_l(BX.QExpr.within(e, n), CV.ewithin(t, n), h)), eqsb_of(t, n, CV.and_r(BX.QExpr.within(e, n), CV.ewithin(t, n), h)))

def kept_below(+sk: SK.Sketch, +hwf: {WF.wf_dec(sk) == True{} : Bool}, +cov: {BX.Sketch.within(sk, SO.nvars(sk)) == True{} : Bool}) -> {PL.eqs_below(SO.nvars(sk), SO.kept(sk)) == True{} : Bool}:
  eqsb_of(SO.kept(sk), SO.nvars(sk), ew_sk(SV.mark(SO.red_of(sk), sk), SO.nvars(sk), w_mark(SO.red_of(sk), sk, SO.nvars(sk), cov), WC.wf_mark(SO.red_of(sk), sk, hwf)))

# The pins are held
# -----------------

def deq_go(~F: O.OField, +a: S.D, c: Cmp, e: {KI.dcmp(a, a) == c : Cmp}) -> {SV.iseq(c) == True{} : Bool}:
  match c:
    case LT{}:
      FO.absurd({SV.iseq(LT{}) == True{} : Bool}, O.lt_irrefl(F)(M.ofd(~F, a))(KI.dcmp_sound.go(~F, a, a, LT{}, e)))
    case EQ{}:
      {==}
    case GT{}:
      FO.absurd({SV.iseq(GT{}) == True{} : Bool}, O.lt_irrefl(F)(M.ofd(~F, a))(KI.dcmp_sound.go(~F, a, a, GT{}, e)))

# a = a as numbers (read in any ordered field)
def deq_self(~F: O.OField, +a: S.D) -> {SV.deq(a, a) == True{} : Bool}:
  deq_go(~F, a, KI.dcmp(a, a), {==})

def pa_go(+v: Nat, +h: Nat, +t: List<&2, Nat>, +b2: List<&2, Nat>, b: Bool, e: {KA.nateq(v, h) == b : Bool}, hm: {SV.bor(SV.eq(v, h), SV.mem(v, t)) == True{} : Bool}, ih: {SV.mem(v, t) == True{} : Bool} -> {PL.pos(v, ST.app(t, b2)) == PL.pos(v, t) : Nat}) -> {PL.pos.go(b, PL.pos(v, ST.app(t, b2))) == PL.pos.go(b, PL.pos(v, t)) : Nat}:
  match b:
    case True{}:
      {==}
    case False{}:
      %Equal.sym(Nat, PL.pos(v, ST.app(t, b2)), PL.pos(v, t), ih(L.bor_rf(SV.eq(v, h), SV.mem(v, t), hm, (%Equal.sym(Bool, SV.eq(v, h), KA.nateq(v, h), L.eq_sv(v, h)) : {_ == False{} : Bool}
        e)))) : {1n+_ == 1n+PL.pos(v, t) : Nat}
      {==}

# a member of a sits at the same position in a ++ b
def pos_app_l(+v: Nat, a: List<&2, Nat>, +b: List<&2, Nat>, h: {SV.mem(v, a) == True{} : Bool}) -> {PL.pos(v, ST.app(a, b)) == PL.pos(v, a) : Nat}:
  match a:
    case Nil{}:
      absurd({PL.pos(v, b) == 0n : Nat}, L.mem_nil(v, h))
    case Con{+hd, +t}:
      pa_go(v, hd, t, b, KA.nateq(v, hd), {==}, h, hm => pos_app_l(v, t, b, hm))

@MACRO GCU NU.unperm($NV, 0n, gcf, $VP)
@MACRO GRU NU.unperm($NV, 0n, grf, $VP)

# the read-back box at a pin is the blocks' box at the pin's place
def up_pin($SKP, +u: List<&2, S.D>, +v: Nat, +hvf: {SV.mem(v, $FS) == True{} : Bool}) -> {NU.dlook(NU.unperm($NV, 0n, u, $VP), v) == KB.klook($DN, u, PL.pos(v, $FS)) : S.D}:
  +hvn = TJ.lt_nq(v, $FS, $NV, hvf, PB.below_app_l($FS, ST.allvars($KB), $NV, SP.sfacts_vpb($SFA)))
  %Equal.sym(S.D, NU.dlook(NU.unperm($NV, 0n, u, $VP), v), KB.klook($DN, NU.unperm($NV, 0n, u, $VP), v), PB.dl_kl(NU.unperm($NV, 0n, u, $VP), v)) : {_ == KB.klook($DN, u, PL.pos(v, $FS)) : S.D}
  %Equal.sym(S.D, KB.klook($DN, NU.unperm($NV, 0n, u, $VP), v), KB.klook($DN, u, PL.pos(v, $VP)), up_kl0($NV, u, $VP, v, hvn)) : {_ == KB.klook($DN, u, PL.pos(v, $FS)) : S.D}
  %Equal.sym(Nat, PL.pos(v, $VP), PL.pos(v, $FS), pos_app_l(v, $FS, ST.allvars($KB), hvf)) : {KB.klook($DN, u, _) == KB.klook($DN, u, PL.pos(v, $FS)) : S.D}
  {==}

def hj_of($SKP, +v: Nat, hvf: {SV.mem(v, $FS) == True{} : Bool}) -> {KA.natle(1n+PL.pos(v, $FS), $NP) == True{} : Bool}:
  %nlen_st($FS) : {KA.natle(1n+PL.pos(v, $FS), _) == True{} : Bool}
  LC.pos_lt(v, $FS, hvf)

def cu_eq($SKP, +g: List<&2, S.D>, +gcf: List<&2, S.D>, +hkc: {PL.ktake($DN, $NP, gcf) == $GC0 : List<&2, S.D>}, +v: Nat, +hvf: {SV.mem(v, $FS) == True{} : Bool}) -> {NU.dlook($GCU, v) == NU.dlook(g, v) : S.D}:
  +j = PL.pos(v, $FS)
  +hj = LC.pos_lt(v, $FS, hvf)
  %Equal.sym(S.D, NU.dlook($GCU, v), KB.klook($DN, gcf, j), up_pin($SKA, gcf, v, hvf)) : {_ == NU.dlook(g, v) : S.D}
  %Equal.sym(S.D, KB.klook($DN, gcf, j), NU.dlook($GC0, j), PB.kl_pre(gcf, $GC0, $NP, j, hkc, hj_of($SKA, v, hvf))) : {_ == NU.dlook(g, v) : S.D}
  %Equal.sym(List<&2, S.D>, $GC0, NU.dpick(g, $FS), dtake_pick(g, $FS, ST.allvars($KB))) : {NU.dlook(_, j) == NU.dlook(g, v) : S.D}
  %Equal.sym(S.D, NU.dlook(NU.dpick(g, $FS), j), NU.dlook(g, PL.nthn($FS, j)), dlook_pick(g, $FS, j, hj)) : {_ == NU.dlook(g, v) : S.D}
  %Equal.sym(Nat, PL.nthn($FS, j), v, PP.pos_nth(v, $FS, hj)) : {NU.dlook(g, _) == NU.dlook(g, v) : S.D}
  {==}

def ru_eq($SKP, +g: List<&2, S.D>, +grf: List<&2, S.D>, +hkr: {PL.ktake($DN, $NP, grf) == $GR0 : List<&2, S.D>}, +v: Nat, +hvf: {SV.mem(v, $FS) == True{} : Bool}) -> {NU.dlook($GRU, v) == NU.dzero() : S.D}:
  +j = PL.pos(v, $FS)
  +hjn = hj_of($SKA, v, hvf)
  %Equal.sym(S.D, NU.dlook($GRU, v), KB.klook($DN, grf, j), up_pin($SKA, grf, v, hvf)) : {_ == NU.dzero() : S.D}
  %Equal.sym(S.D, KB.klook($DN, grf, j), NU.dlook($GR0, j), PB.kl_pre(grf, $GR0, $NP, j, hkr, hjn)) : {_ == NU.dzero() : S.D}
  dlook_dreps($NP, NU.dzero(), j, hjn)

def held_r($SKP, +g: List<&2, S.D>, +grf: List<&2, S.D>, +hkr: {PL.ktake($DN, $NP, grf) == $GR0 : List<&2, S.D>}, +v: Nat, +hvf: {SV.mem(v, $FS) == True{} : Bool}) -> {SV.deq(SV.dnth($GRU, v), SV.dzero()) == True{} : Bool}:
  %Equal.sym(S.D, SV.dnth($GRU, v), NU.dlook($GRU, v), dnth_dl($GRU, v)) : {SV.deq(_, SV.dzero()) == True{} : Bool}
  %Equal.sym(S.D, NU.dlook($GRU, v), NU.dzero(), ru_eq($SKA, g, grf, hkr, v, hvf)) : {SV.deq(_, SV.dzero()) == True{} : Bool}
  deq_self(~F, NU.dzero())

def held_c($SKP, +g: List<&2, S.D>, +gcf: List<&2, S.D>, +hkc: {PL.ktake($DN, $NP, gcf) == $GC0 : List<&2, S.D>}, +v: Nat, +hvf: {SV.mem(v, $FS) == True{} : Bool}) -> {SV.deq(SV.dnth($GCU, v), SV.dnth(g, v)) == True{} : Bool}:
  %Equal.sym(S.D, SV.dnth($GCU, v), NU.dlook($GCU, v), dnth_dl($GCU, v)) : {SV.deq(_, SV.dnth(g, v)) == True{} : Bool}
  %Equal.sym(S.D, SV.dnth(g, v), NU.dlook(g, v), dnth_dl(g, v)) : {SV.deq(NU.dlook($GCU, v), _) == True{} : Bool}
  %Equal.sym(S.D, NU.dlook($GCU, v), NU.dlook(g, v), cu_eq($SKA, g, gcf, hkc, v, hvf)) : {SV.deq(_, NU.dlook(g, v)) == True{} : Bool}
  deq_self(~F, NU.dlook(g, v))

def held_go($SKP, +g: List<&2, S.D>, +gcf: List<&2, S.D>, +grf: List<&2, S.D>, +hkc: {PL.ktake($DN, $NP, gcf) == $GC0 : List<&2, S.D>}, +hkr: {PL.ktake($DN, $NP, grf) == $GR0 : List<&2, S.D>}, ws: List<&2, Nat>, +hs: {L.subl(ws, $FS) == True{} : Bool}) -> {SV.held(ws, g, $GCU, $GRU) == True{} : Bool}:
  match ws:
    case Nil{}:
      {==}
    case Con{+v, +t}:
      +hvf = L.subl_hd(v, t, $FS, hs)
      L.band_i(SV.deq(SV.dnth($GRU, v), SV.dzero()), SV.band(SV.deq(SV.dnth($GCU, v), SV.dnth(g, v)), SV.held(t, g, $GCU, $GRU)), held_r($SKA, g, grf, hkr, v, hvf), L.band_i(SV.deq(SV.dnth($GCU, v), SV.dnth(g, v)), SV.held(t, g, $GCU, $GRU), held_c($SKA, g, gcf, hkc, v, hvf), held_go($SKA, g, gcf, grf, hkc, hkr, t, L.subl_tl(v, t, $FS, hs))))

# The plan checks
# ---------------

def pinz_kt(n: Nat, u: List<&2, S.D>) -> {PL.pinz($DN, n, PL.ktake($DN, n, u)) == PL.pinz($DN, n, u) : Bool}:
  match n u:
    case 0n u:
      {==}
    case 1n+k Nil{}:
      {==}
    case 1n+k Con{r, t}:
      %Equal.sym(Bool, PL.pinz($DN, k, PL.ktake($DN, k, t)), PL.pinz($DN, k, t), pinz_kt(k, t)) : {KA.band(PL.keq($DN, r, N.nzero(KI.dnum())), _) == KA.band(PL.keq($DN, r, N.nzero(KI.dnum())), PL.pinz($DN, k, t)) : Bool}
      {==}

def pinz_dreps(n: Nat) -> {PL.pinz($DN, n, NU.dreps(n, NU.dzero())) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n++m:
      AP.band_t(PL.keq($DN, NU.dzero(), N.nzero(KI.dnum())), PL.pinz($DN, m, NU.dreps(m, NU.dzero())), {==}, pinz_dreps(m))

def pinz_of(+n: Nat, +u: List<&2, S.D>, h: {PL.ktake($DN, n, u) == NU.dreps(n, NU.dzero()) : List<&2, S.D>}) -> {PL.pinz($DN, n, u) == True{} : Bool}:
  %pinz_kt(n, u) : {_ == True{} : Bool}
  %Equal.sym(List<&2, S.D>, PL.ktake($DN, n, u), NU.dreps(n, NU.dzero()), h) : {PL.pinz($DN, n, _) == True{} : Bool}
  pinz_dreps(n)

def kvle_nil(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +grf: List<&2, S.D>, hrn: FV.rnn(~F, M.ofdv(~F, grf))) -> {KA.kvle($DN, Nil{}, grf) == True{} : Bool}:
  AP.kvle_of($DN, ~F, ~H, Nil{}, grf, (%Equal.sym(M.Vec(~F), N.ofkv($DN, ~F, ~H, grf), M.ofdv(~F, grf), AP.ofkv_d(~F, ~H, grf)) : FV.rle(~F, Nil{}, _)
    hrn))

def np_le($SKP, +gcf: List<&2, S.D>, hlc: {KA.klen($DN, gcf) == $NV : Nat}) -> {KA.natle($NP, KA.klen($DN, gcf)) == True{} : Bool}:
  %Equal.sym(Nat, KA.klen($DN, gcf), $NV, hlc) : {KA.natle($NP, _) == True{} : Bool}
  %Equal.trans(Nat, ST.len($VP), SV.len($VP), $NV, TJ.len_sv($VP), L.eq_ok(SV.len($VP), $NV, SP.sfacts_vpl($SFA))) : {KA.natle($NP, _) == True{} : Bool}
  SP.len_app_ge($FS, ST.allvars($KB))

@MACRO PGF +gcf: List<&2, S.D>, +grf: List<&2, S.D>, +bsf: List<&2, PL.PBlock<KI.dnum()>>, +hw: {PL.walk($DN, gcf, grf, bsf, $SYS, $NP) == True{} : Bool}, +hkc: {PL.ktake($DN, $NP, gcf) == $GC0 : List<&2, S.D>}, +hkr: {PL.ktake($DN, $NP, grf) == $GR0 : List<&2, S.D>}, +hlc: {KA.klen($DN, gcf) == $NV : Nat}, +hlr: {KA.klen($DN, grf) == $NV : Nat}, +hpb: PP.pbox($DN, ~F, ~H, gcf, grf, $NV, $XV), +hrn: FV.rnn(~F, M.ofdv(~F, grf))
@MACRO PGA gcf, grf, bsf, hw, hkc, hkr, hlc, hlr, hpb, hrn

# in block order
def cp_ok($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, $PGF) -> {PL.check.p($DN, $SYS, gcf, grf, $NP, bsf) == True{} : Bool}:
  AP.band_t(KA.nateq(KA.klen($DN, grf), KA.klen($DN, gcf)), KA.band(KA.kvle($DN, Nil{}, grf), KA.band(KA.natle($NP, KA.klen($DN, gcf)), KA.band(PL.pinz($DN, $NP, grf), PL.walk($DN, gcf, grf, bsf, $SYS, $NP)))), PB.nateq_of(KA.klen($DN, grf), KA.klen($DN, gcf), Equal.trans(Nat, KA.klen($DN, grf), $NV, KA.klen($DN, gcf), hlr, Equal.sym(Nat, KA.klen($DN, gcf), $NV, hlc))),
  AP.band_t(KA.kvle($DN, Nil{}, grf), KA.band(KA.natle($NP, KA.klen($DN, gcf)), KA.band(PL.pinz($DN, $NP, grf), PL.walk($DN, gcf, grf, bsf, $SYS, $NP))), kvle_nil(~F, ~H, grf, hrn),
  AP.band_t(KA.natle($NP, KA.klen($DN, gcf)), KA.band(PL.pinz($DN, $NP, grf), PL.walk($DN, gcf, grf, bsf, $SYS, $NP)), np_le($SKA, gcf, hlc),
  AP.band_t(PL.pinz($DN, $NP, grf), PL.walk($DN, gcf, grf, bsf, $SYS, $NP), pinz_of($NP, grf, hkr), hw))))

@MACRO KL KA.klen($DN, $GCU)
@MACRO EQL CK.eqlen(SO.kept(sk))
@MACRO CPK PL.check.p($DN, PL.reorder($VP, SO.kept(sk), $EP), PL.kperm($DN, $GCU, $VP), PL.kperm($DN, $GRU, $VP), $NP, bsf)

def cpk_ok($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, $PGF) -> {$CPK == True{} : Bool}:
  %Equal.sym(List<&2, E.QExpr>, PL.reorder($VP, SO.kept(sk), $EP), $SYS, KP.kept_reorder(sk, ha, $VP, ST.alleqs($KB), SP.sfacts_gc($SFA))) : {PL.check.p($DN, _, PL.kperm($DN, $GCU, $VP), PL.kperm($DN, $GRU, $VP), $NP, bsf) == True{} : Bool}
  %Equal.sym(List<&2, S.D>, PL.kperm($DN, $GCU, $VP), gcf, kp_vp($SKA, gcf, hlc)) : {PL.check.p($DN, $SYS, _, PL.kperm($DN, $GRU, $VP), $NP, bsf) == True{} : Bool}
  %Equal.sym(List<&2, S.D>, PL.kperm($DN, $GRU, $VP), grf, kp_vp($SKA, grf, hlr)) : {PL.check.p($DN, $SYS, gcf, _, $NP, bsf) == True{} : Bool}
  cp_ok($SKA, x, g, $PGA)

# the plan against the kept system and the read-back box
def cr_ok($SKP, +hwf: {WF.wf_dec(sk) == True{} : Bool}, +cov: {BX.Sketch.within(sk, $NV) == True{} : Bool}, +x: M.Vec(~F), +g: List<&2, S.D>, $PGF) -> {PL.check.r($DN, SO.kept(sk), $GCU, $GRU, $VP, $EP, $NP, bsf) == True{} : Bool}:
  +ek = Equal.sym(Nat, $KL, $NV, klen_up($NV, 0n, gcf, $VP))
  +ee = Equal.sym(Nat, $EQL, SV.len($GOOD), kept_eqlen($SKA))
  AP.band_t(PL.present($VP, $KL, 0n), KA.band(PL.pars_ok($KL, $VP), KA.band(PL.present($EP, $EQL, 0n), KA.band(PL.pars_ok($EQL, $EP), KA.band(PL.eqs_below($KL, SO.kept(sk)), $CPK)))), (%ek : {PL.present($VP, _, 0n) == True{} : Bool}
    vp_pres($SKA)),
  AP.band_t(PL.pars_ok($KL, $VP), KA.band(PL.present($EP, $EQL, 0n), KA.band(PL.pars_ok($EQL, $EP), KA.band(PL.eqs_below($KL, SO.kept(sk)), $CPK))), (%ek : {PL.pars_ok(_, $VP) == True{} : Bool}
    pars_of($NV, $VP, SP.sfacts_vpb($SFA))),
  AP.band_t(PL.present($EP, $EQL, 0n), KA.band(PL.pars_ok($EQL, $EP), KA.band(PL.eqs_below($KL, SO.kept(sk)), $CPK)), (%ee : {PL.present($EP, _, 0n) == True{} : Bool}
    ep_pres($SKA)),
  AP.band_t(PL.pars_ok($EQL, $EP), KA.band(PL.eqs_below($KL, SO.kept(sk)), $CPK), (%ee : {PL.pars_ok(_, $EP) == True{} : Bool}
    pp_of(ST.alleqs($KB), $GOOD, SP.sfacts_gc($SFA))),
  AP.band_t(PL.eqs_below($KL, SO.kept(sk)), $CPK, (%ek : {PL.eqs_below(_, SO.kept(sk)) == True{} : Bool}
    kept_below(sk, hwf, cov)),
  cpk_ok($SKA, x, g, $PGA))))))

# The answer holds x
# ------------------

def kv_of($SKP, +k: Nat, hk: {KA.natle(1n+k, PL.nlen($VP)) == True{} : Bool}) -> {KA.natle(1n+k, $NV) == True{} : Bool}:
  %Equal.trans(Nat, PL.nlen($VP), SV.len($VP), $NV, PB.nlen_sv($VP), L.eq_ok(SV.len($VP), $NV, SP.sfacts_vpl($SFA))) : {KA.natle(1n+k, _) == True{} : Bool}
  hk

def nle_rw(+gcf: List<&2, S.D>, +nv: Nat, hlc: {KA.klen($DN, gcf) == nv : Nat}) -> {KA.natle(nv, KA.klen($DN, gcf)) == True{} : Bool}:
  %Equal.sym(Nat, KA.klen($DN, gcf), nv, hlc) : {KA.natle(nv, _) == True{} : Bool}
  L.le_refl(nv)

# x_v sits in the read-back box at v: it is x read in block order at v's
# position, in the blocks' box there
def box_at($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, $PGF, +v: Nat, +hv: {KA.natle(1n+v, $NV) == True{} : Bool}) -> M.bnd(~F, O.lookup(~F, BX.vsub(~F, x, N.ofkv($DN, ~F, ~H, $GCU)), v), O.lookup(~F, N.ofkv($DN, ~F, ~H, $GRU), v)):
  +k = PL.pos(v, $VP)
  +hk = LC.pos_lt(v, $VP, vp_has($SKA, v, hv))
  +b0 = PP.pbox_at($DN, ~F, ~H, gcf, grf, $NV, $XV, hpb, nle_rw(gcf, $NV, hlc), k, kv_of($SKA, k, hk))
  +ea = Equal.trans(O.C(F), O.lookup(~F, $XV, k), O.lookup(~F, x, PL.nthn($VP, k)), O.lookup(~F, x, v), LC.look_xperm(~F, x, $VP, k, hk), PP.look_vec_rw(~F, x, PL.nthn($VP, k), v, PP.pos_nth(v, $VP, hk)))
  +ec = Equal.trans(O.C(F), N.emap(KI.dnum(), F, H, KB.klook($DN, gcf, k)), N.emap(KI.dnum(), F, H, KB.klook($DN, $GCU, v)), O.lookup(~F, N.ofkv($DN, ~F, ~H, $GCU), v), PP.emap_rw($DN, ~F, ~H, KB.klook($DN, gcf, k), KB.klook($DN, $GCU, v), Equal.sym(S.D, KB.klook($DN, $GCU, v), KB.klook($DN, gcf, k), up_kl0($NV, gcf, $VP, v, hv))), CP.klook_ofk($DN, ~F, ~H, $GCU, v))
  +er = Equal.trans(O.C(F), N.emap(KI.dnum(), F, H, KB.klook($DN, grf, k)), N.emap(KI.dnum(), F, H, KB.klook($DN, $GRU, v)), O.lookup(~F, N.ofkv($DN, ~F, ~H, $GRU), v), PP.emap_rw($DN, ~F, ~H, KB.klook($DN, grf, k), KB.klook($DN, $GRU, v), Equal.sym(S.D, KB.klook($DN, $GRU, v), KB.klook($DN, grf, k), up_kl0($NV, grf, $VP, v, hv))), CP.klook_ofk($DN, ~F, ~H, $GRU, v))
  PP.unent(~F, x, N.ofkv($DN, ~F, ~H, $GCU), N.ofkv($DN, ~F, ~H, $GRU), v, PP.btr(~F, O.lookup(~F, $XV, k), O.lookup(~F, x, v), N.emap(KI.dnum(), F, H, KB.klook($DN, gcf, k)), O.lookup(~F, N.ofkv($DN, ~F, ~H, $GCU), v), N.emap(KI.dnum(), F, H, KB.klook($DN, grf, k)), O.lookup(~F, N.ofkv($DN, ~F, ~H, $GRU), v), ea, ec, er, b0))

def inbox_ans($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, $PGF) -> BX.inbox($DN, ~F, ~H, $GCU, $GRU, x):
  +lo = Equal.trans(Nat, M.len(~F, N.ofkv($DN, ~F, ~H, $GCU)), $KL, $NV, CP.len_ofkv($DN, ~F, ~H, $GCU), klen_up($NV, 0n, gcf, $VP))
  +d = BX.vsub(~F, x, N.ofkv($DN, ~F, ~H, $GCU))
  +hld = CP.len_vsub(~F, x, N.ofkv($DN, ~F, ~H, $GCU), $NV, hl, lo)
  (Equal.trans(Nat, M.len(~F, x), $NV, M.len(~F, N.ofkv($DN, ~F, ~H, $GCU)), hl, Equal.sym(Nat, M.len(~F, N.ofkv($DN, ~F, ~H, $GCU)), $NV, lo)),
   BA.rbnd_of_lk(~F, d, $NV, N.ofkv($DN, ~F, ~H, $GRU), hld, BA.lk_build(~F, ~d, ~N.ofkv($DN, ~F, ~H, $GRU), ~$NV, ~(v => hv => box_at($SKA, x, g, $PGA, v, hv)), $NV, 0n, BA.lk_end($NV))))

# The side conditions (C6d-3)
# ---------------------------
# Over a box whose balls have radius at most rho and centers and radii
# within bb (gbox), kball's center is e at the box's centers (kball_c),
# within lp rho of e(x) (eval_lip), and its radius is at most lp rho
# (kball_grade): c - r >= e(x) - 2 lp rho.

@MACRO KBE KB.kball($DN, box, e)
@MACRO LPR O.mul(F, BP.lp(~F, bb, e), rho)
@MACRO BXP +box: List<&2, KB.KB<KI.dnum()>>, +rho: O.C(F), +bb: O.C(F), +hr: O.le(~F, O.zero(F), rho), +hb: O.le(~F, O.zero(F), bb), +hg: BP.gbox($DN, ~F, ~H, rho, bb, box), +x: M.Vec(~F), +hx: KB.inbox($DN, ~F, ~H, x, box)
@MACRO BXA box, rho, bb, hr, hb, hg, x, hx

def held_e(e: E.QExpr, +h: {SV.dyconst(e) == True{} : Bool}) -> {KB.held($DN, e) == True{} : Bool}:
  match e:
    case E.QVar{v}:
      {==}
    case E.QCst{+q}:
      PB.held_c(q, h)
    case E.QAdd{+a, +b}:
      PB.kband_i(KB.held($DN, a), KB.held($DN, b), held_e(a, L.band_l(SV.dyconst(a), SV.dyconst(b), h)), held_e(b, L.band_r(SV.dyconst(a), SV.dyconst(b), h)))
    case E.QSub{+a, +b}:
      PB.kband_i(KB.held($DN, a), KB.held($DN, b), held_e(a, L.band_l(SV.dyconst(a), SV.dyconst(b), h)), held_e(b, L.band_r(SV.dyconst(a), SV.dyconst(b), h)))
    case E.QMul{+a, +b}:
      PB.kband_i(KB.held($DN, a), KB.held($DN, b), held_e(a, L.band_l(SV.dyconst(a), SV.dyconst(b), h)), held_e(b, L.band_r(SV.dyconst(a), SV.dyconst(b), h)))
    case E.QNeg{+a}:
      held_e(a, h)

def side_lb.c(~F: O.OField, +ec: O.C(F), +rv: O.C(F), +ex: O.C(F), +m: O.C(F), hl: M.bnd(~F, O.sub(~F, ex, ec), m), hrm: O.le(~F, rv, m)) -> O.le(~F, O.sub(~F, ex, O.add(F, m, m)), O.sub(~F, ec, rv)):
  FV.le_of_sub(~F, O.sub(~F, ex, O.add(F, m, m)), O.sub(~F, ec, rv), FM.nn_eq(~F, O.sub(~F, O.sub(~F, ec, rv), O.sub(~F, ex, O.add(F, m, m))), O.add(F, O.sub(~F, m, O.sub(~F, ex, ec)), O.sub(~F, m, rv)), @ZEQ[ec,, rv,, ex,, m | (m - (ex - ec)) + (m - rv) | (ec - rv) - (ex - (m + m))], FO.nonneg_add(~F, O.sub(~F, m, O.sub(~F, ex, ec)), O.sub(~F, m, rv), AP.both_l(O.le(~F, O.zero(F), O.sub(~F, m, O.sub(~F, ex, ec))), O.le(~F, O.zero(F), O.add(F, m, O.sub(~F, ex, ec))), hl), FM.sub_nonneg(~F, rv, m, hrm))))

# c - r >= e(x) - 2 lp rho
def side_lb(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, $BXP, +e: E.QExpr, +hh: {KB.held($DN, e) == True{} : Bool}) -> O.le(~F, O.sub(~F, O.eval(~F, x, e), O.add(F, $LPR, $LPR)), N.emap(KI.dnum(), F, H, KA.ksub($DN, KB.KB.c(KI.dnum(), $KBE), KB.KB.r(KI.dnum(), $KBE)))):
  +ec = O.eval(~F, BP.cen($DN, ~F, ~H, box), e)
  +rv = N.emap(KI.dnum(), F, H, KB.KB.r(KI.dnum(), $KBE))
  %KA.es($DN, ~F, ~H, KB.KB.c(KI.dnum(), $KBE), KB.KB.r(KI.dnum(), $KBE)) : O.le(~F, O.sub(~F, O.eval(~F, x, e), O.add(F, $LPR, $LPR)), _)
  %Equal.sym(O.C(F), N.emap(KI.dnum(), F, H, KB.KB.c(KI.dnum(), $KBE)), ec, BP.kball_c($DN, ~F, ~H, box, e, hh)) : O.le(~F, O.sub(~F, O.eval(~F, x, e), O.add(F, $LPR, $LPR)), O.sub(~F, _, rv))
  side_lb.c(~F, ec, rv, O.eval(~F, x, e), $LPR, BP.eval_lip($DN, ~F, ~H, rho, bb, hr, hb, box, hg, x, hx, e, hh), BP.gf_l(~F, rho, N.emap(KI.dnum(), F, H, KB.KB.c(KI.dnum(), $KBE)), rv, BP.mj(~F, bb, e), BP.lp(~F, bb, e), BP.kball_grade($DN, ~F, ~H, rho, bb, hr, hb, box, hg, e, hh)))

# each side condition with room 2 lp rho at x
def SBud(~F: O.OField, +bb: O.C(F), +rho: O.C(F), +x: M.Vec(~F), ss: List<&2, SK.Side>) -> Data:
  match ss:
    case Nil{}:
      Unit
    case Con{SK.Gt0{+e}, t}:
      M.Both(O.lt(F, O.add(F, $LPR, $LPR), O.eval(~F, x, e)), SBud(~F, bb, rho, x, t))
    case Con{SK.Ge0{+e}, t}:
      M.Both(O.le(~F, O.add(F, $LPR, $LPR), O.eval(~F, x, e)), SBud(~F, bb, rho, x, t))

@MACRO KCR KA.ksub($DN, KB.KB.c(KI.dnum(), $KBE), KB.KB.r(KI.dnum(), $KBE))

def gt_ok(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, $BXP, +e: E.QExpr, +hh: {KB.held($DN, e) == True{} : Bool}, hs: O.lt(F, O.add(F, $LPR, $LPR), O.eval(~F, x, e))) -> {KA.klt($DN, N.nzero(KI.dnum()), $KCR) == True{} : Bool}:
  AP.klt_of($DN, ~F, ~H, N.nzero(KI.dnum()), $KCR, FO.lt_subst_l(~F, O.zero(F), N.emap(KI.dnum(), F, H, N.nzero(KI.dnum())), N.emap(KI.dnum(), F, H, $KCR), KA.ez($DN, ~F, ~H), FO.lt_le_trans(~F, O.zero(F), O.sub(~F, O.eval(~F, x, e), O.add(F, $LPR, $LPR)), N.emap(KI.dnum(), F, H, $KCR), RL.sub_pos(~F, O.add(F, $LPR, $LPR), O.eval(~F, x, e), hs), side_lb(~F, ~H, $BXA, e, hh))))

def ge_ok(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, $BXP, +e: E.QExpr, +hh: {KB.held($DN, e) == True{} : Bool}, hs: O.le(~F, O.add(F, $LPR, $LPR), O.eval(~F, x, e))) -> {KA.kle($DN, N.nzero(KI.dnum()), $KCR) == True{} : Bool}:
  AP.kle_of($DN, ~F, ~H, N.nzero(KI.dnum()), $KCR, RL.le_rw_l(~F, O.zero(F), N.emap(KI.dnum(), F, H, N.nzero(KI.dnum())), N.emap(KI.dnum(), F, H, $KCR), KA.ez($DN, ~F, ~H), DM.le_trans(~F, O.zero(F), O.sub(~F, O.eval(~F, x, e), O.add(F, $LPR, $LPR)), N.emap(KI.dnum(), F, H, $KCR), FM.sub_nonneg(~F, O.add(F, $LPR, $LPR), O.eval(~F, x, e), hs), side_lb(~F, ~H, $BXA, e, hh))))

# with room at x, every side condition checks over the box
def sides_of(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, $BXP, ss: List<&2, SK.Side>, +hd: {SV.dysides(ss) == True{} : Bool}, +hs: SBud(~F, bb, rho, x, ss)) -> {PL.sides_ok($DN, box, ss) == True{} : Bool}:
  match ss:
    case Nil{}:
      {==}
    case Con{SK.Gt0{+e}, +t}:
      +hh = held_e(e, L.band_l(SV.dyconst(e), SV.dysides(t), hd))
      AP.band_t(PL.side_ok($DN, box, SK.Gt0{e}), PL.sides_ok($DN, box, t), AP.band_t(KB.held($DN, e), KA.klt($DN, N.nzero(KI.dnum()), $KCR), hh, gt_ok(~F, ~H, $BXA, e, hh, AP.both_l(O.lt(F, O.add(F, $LPR, $LPR), O.eval(~F, x, e)), SBud(~F, bb, rho, x, t), hs))), sides_of(~F, ~H, $BXA, t, L.band_r(SV.dyconst(e), SV.dysides(t), hd), AP.both_r(O.lt(F, O.add(F, $LPR, $LPR), O.eval(~F, x, e)), SBud(~F, bb, rho, x, t), hs)))
    case Con{SK.Ge0{+e}, +t}:
      +hh = held_e(e, L.band_l(SV.dyconst(e), SV.dysides(t), hd))
      AP.band_t(PL.side_ok($DN, box, SK.Ge0{e}), PL.sides_ok($DN, box, t), AP.band_t(KB.held($DN, e), KA.kle($DN, N.nzero(KI.dnum()), $KCR), hh, ge_ok(~F, ~H, $BXA, e, hh, AP.both_l(O.le(~F, O.add(F, $LPR, $LPR), O.eval(~F, x, e)), SBud(~F, bb, rho, x, t), hs))), sides_of(~F, ~H, $BXA, t, L.band_r(SV.dyconst(e), SV.dysides(t), hd), AP.both_r(O.le(~F, O.add(F, $LPR, $LPR), O.eval(~F, x, e)), SBud(~F, bb, rho, x, t), hs)))

# Marking constraints driven only drops side conditions
# ----------------------------------------------------

def ds_l(a: List<&2, SK.Side>, +b: List<&2, SK.Side>, +h: {SV.dysides(SK.cats(a, b)) == True{} : Bool}) -> {SV.dysides(a) == True{} : Bool}:
  match a:
    case Nil{}:
      {==}
    case Con{SK.Gt0{+e}, +t}:
      L.band_i(SV.dyconst(e), SV.dysides(t), L.band_l(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h), ds_l(t, b, L.band_r(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h)))
    case Con{SK.Ge0{+e}, +t}:
      L.band_i(SV.dyconst(e), SV.dysides(t), L.band_l(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h), ds_l(t, b, L.band_r(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h)))

def ds_r(a: List<&2, SK.Side>, +b: List<&2, SK.Side>, +h: {SV.dysides(SK.cats(a, b)) == True{} : Bool}) -> {SV.dysides(b) == True{} : Bool}:
  match a:
    case Nil{}:
      h
    case Con{SK.Gt0{+e}, +t}:
      ds_r(t, b, L.band_r(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h))
    case Con{SK.Ge0{+e}, +t}:
      ds_r(t, b, L.band_r(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h))

def ds_cat(a: List<&2, SK.Side>, +b: List<&2, SK.Side>, +ha: {SV.dysides(a) == True{} : Bool}, +hb: {SV.dysides(b) == True{} : Bool}) -> {SV.dysides(SK.cats(a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{SK.Gt0{+e}, +t}:
      L.band_i(SV.dyconst(e), SV.dysides(SK.cats(t, b)), L.band_l(SV.dyconst(e), SV.dysides(t), ha), ds_cat(t, b, L.band_r(SV.dyconst(e), SV.dysides(t), ha), hb))
    case Con{SK.Ge0{+e}, +t}:
      L.band_i(SV.dyconst(e), SV.dysides(SK.cats(t, b)), L.band_l(SV.dyconst(e), SV.dysides(t), ha), ds_cat(t, b, L.band_r(SV.dyconst(e), SV.dysides(t), ha), hb))

def ds_go(+es: List<&2, SK.Ent>, +id: Nat, b: Bool, +k: SK.Constraint, +rest: List<&2, SK.Rec>, +ha: {SV.dysides(SK.Constraint.sides(es, k)) == True{} : Bool}, +hr: {SV.dysides(SK.Sketch.sides.cons(es, rest)) == True{} : Bool}) -> {SV.dysides(SK.Sketch.sides.cons(es, Con{SK.Rec{id, b, k}, rest})) == True{} : Bool}:
  match b:
    case True{}:
      hr
    case False{}:
      ds_cat(SK.Constraint.sides(es, k), SK.Sketch.sides.cons(es, rest), ha, hr)

def ds_mark(+es: List<&2, SK.Ent>, +red: List<&2, Nat>, cs: List<&2, SK.Rec>, +i: Nat, +h: {SV.dysides(SK.Sketch.sides.cons(es, cs)) == True{} : Bool}) -> {SV.dysides(SK.Sketch.sides.cons(es, SV.mark.cons(red, cs, i))) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case Con{SK.Rec{+id, True{}, +k}, +t}:
      ds_mark(es, red, t, 1n+i, h)
    case Con{SK.Rec{+id, False{}, +k}, +t}:
      ds_go(es, id, SV.mem(i, red), k, SV.mark.cons(red, t, 1n+i), ds_l(SK.Constraint.sides(es, k), SK.Sketch.sides.cons(es, t), h), ds_mark(es, red, t, 1n+i, ds_r(SK.Constraint.sides(es, k), SK.Sketch.sides.cons(es, t), h)))

def ds_sk(+red: List<&2, Nat>, sk: SK.Sketch, +h: {SV.dysides(SK.Sketch.sides(sk)) == True{} : Bool}) -> {SV.dysides(SK.Sketch.sides(SV.mark(red, sk))) == True{} : Bool}:
  match sk:
    case SK.Sketch{vs, +es, +cs}:
      ds_cat(SK.Sketch.sides.ents(es), SK.Sketch.sides.cons(es, SV.mark.cons(red, cs, 0n)), ds_l(SK.Sketch.sides.ents(es), SK.Sketch.sides.cons(es, cs), h), ds_mark(es, red, cs, 0n, ds_r(SK.Sketch.sides.ents(es), SK.Sketch.sides.cons(es, cs), h)))

# The read-back box is graded and holds x
# ---------------------------------------

def sposl(n: Nat, +k: Nat, +vp: List<&2, Nat>) -> List<&2, Nat>:
  match n:
    case 0n:
      Nil{}
    case 1n+m:
      Con{ST.pos(k, vp), sposl(m, 1n+k, vp)}

# reading back is picking at the variables' positions
def up_pick(n: Nat, +k: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>) -> {NU.unperm(n, k, u, vp) == NU.dpick(u, sposl(n, k, vp)) : List<&2, S.D>}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      %up_pick(m, 1n+k, u, vp) : {Con{NU.dlook(u, ST.pos(k, vp)), NU.unperm(m, 1n+k, u, vp)} == Con{NU.dlook(u, ST.pos(k, vp)), _} : List<&2, S.D>}
      {==}

def up_rnn(~F: O.OField, +n: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>, +h: FV.rnn(~F, M.ofdv(~F, u))) -> FV.rnn(~F, M.ofdv(~F, NU.unperm(n, 0n, u, vp))):
  %Equal.sym(List<&2, S.D>, NU.unperm(n, 0n, u, vp), NU.dpick(u, sposl(n, 0n, vp)), up_pick(n, 0n, u, vp)) : FV.rnn(~F, M.ofdv(~F, _))
  PB.rnn_pick(~F, u, sposl(n, 0n, vp), h)

def up_vall(~F: O.OField, +n: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>, +c: O.C(F), +hc: O.le(~F, O.zero(F), c), +h: M.vbnd.all(~F, M.ofdv(~F, u), c)) -> M.vbnd.all(~F, M.ofdv(~F, NU.unperm(n, 0n, u, vp)), c):
  %Equal.sym(List<&2, S.D>, NU.unperm(n, 0n, u, vp), NU.dpick(u, sposl(n, 0n, vp)), up_pick(n, 0n, u, vp)) : M.vbnd.all(~F, M.ofdv(~F, _), c)
  PB.vall_pick(~F, u, sposl(n, 0n, vp), c, hc, h)

def vk_of(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +u: List<&2, S.D>, +c: O.C(F), h: M.vbnd.all(~F, M.ofdv(~F, u), c)) -> M.vbnd.all(~F, N.ofkv($DN, ~F, ~H, u), c):
  %Equal.sym(M.Vec(~F), N.ofkv($DN, ~F, ~H, u), M.ofdv(~F, u), AP.ofkv_d(~F, ~H, u)) : M.vbnd.all(~F, _, c)
  h

def rk_of(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +u: List<&2, S.D>, h: FV.rnn(~F, M.ofdv(~F, u))) -> FV.rnn(~F, N.ofkv($DN, ~F, ~H, u)):
  %Equal.sym(M.Vec(~F), N.ofkv($DN, ~F, ~H, u), M.ofdv(~F, u), AP.ofkv_d(~F, ~H, u)) : FV.rnn(~F, _)
  h

# |d| <= r <= c entrywise gives |d| <= c
def rbv(~F: O.OField, d: M.Vec(~F), r: M.Vec(~F), +c: O.C(F), +h: BX.rbnd(~F, d, r), +hr: M.vbnd.all(~F, r, c), +hl: {M.len(~F, d) == M.len(~F, r) : Nat}) -> M.vbnd.all(~F, d, c):
  match d r:
    case Nil{} r:
      Unit{}
    case Con{a, t} Nil{}:
      absurd(M.vbnd.all(~F, Con{a, t}, c), FV.succ_ne(M.len(~F, t), hl))
    case Con{+a, +t} Con{+s, +rs}:
      (FM.bnd_mono(~F, a, s, c, AP.both_l(M.bnd(~F, a, s), BX.rbnd(~F, t, rs), h), AP.both_l(O.le(~F, O.zero(F), O.sub(~F, c, s)), O.le(~F, O.zero(F), O.add(F, c, s)), AP.both_l(M.bnd(~F, s, c), M.vbnd.all(~F, rs, c), hr))),
      rbv(~F, t, rs, c, AP.both_r(M.bnd(~F, a, s), BX.rbnd(~F, t, rs), h), AP.both_r(M.bnd(~F, s, c), M.vbnd.all(~F, rs, c), hr), FV.succ_inj(M.len(~F, t), M.len(~F, rs), hl)))

def rb_of($SKP, +x: M.Vec(~F), +gcf: List<&2, S.D>, +grf: List<&2, S.D>, +hlc: {KA.klen($DN, gcf) == $NV : Nat}, +hlr: {KA.klen($DN, grf) == $NV : Nat}, hpb: PP.pbox($DN, ~F, ~H, gcf, grf, $NV, $XV)) -> BX.rbnd(~F, BX.vsub(~F, $XV, M.ofdv(~F, gcf)), M.ofdv(~F, grf)):
  %AP.ofkv_d(~F, ~H, gcf) : BX.rbnd(~F, BX.vsub(~F, $XV, _), M.ofdv(~F, grf))
  %AP.ofkv_d(~F, ~H, grf) : BX.rbnd(~F, BX.vsub(~F, $XV, N.ofkv($DN, ~F, ~H, gcf)), _)
  %kt_eq(gcf, $NV, hlc) : BX.rbnd(~F, BX.vsub(~F, $XV, N.ofkv($DN, ~F, ~H, _)), N.ofkv($DN, ~F, ~H, grf))
  %kt_eq(grf, $NV, hlr) : BX.rbnd(~F, BX.vsub(~F, $XV, N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NV, gcf))), N.ofkv($DN, ~F, ~H, _))
  AP.both_r({M.len(~F, $XV) == $NV : Nat}, BX.rbnd(~F, BX.vsub(~F, $XV, N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NV, gcf))), N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NV, grf))), hpb)

# the blocks' centers are within |x| + rho
def cen_b($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, $PGF, +rho: O.C(F), +hvr: M.vbnd.all(~F, M.ofdv(~F, grf), rho)) -> M.vbnd.all(~F, M.ofdv(~F, gcf), O.add(F, NP.vn(~F, x), rho)):
  +lx = AP.both_l({M.len(~F, $XV) == $NV : Nat}, BX.rbnd(~F, BX.vsub(~F, $XV, N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NV, gcf))), N.ofkv($DN, ~F, ~H, PL.ktake($DN, $NV, grf))), hpb)
  +hl = Equal.trans(Nat, M.len(~F, BX.vsub(~F, $XV, M.ofdv(~F, gcf))), $NV, M.len(~F, M.ofdv(~F, grf)), CP.len_vsub(~F, $XV, M.ofdv(~F, gcf), $NV, lx, Equal.trans(Nat, M.len(~F, M.ofdv(~F, gcf)), KA.klen($DN, gcf), $NV, PB.len_ofdv(~F, gcf), hlc)), Equal.sym(Nat, M.len(~F, M.ofdv(~F, grf)), $NV, Equal.trans(Nat, M.len(~F, M.ofdv(~F, grf)), KA.klen($DN, grf), $NV, PB.len_ofdv(~F, grf), hlr)))
  NP.vsub_bound(~F, $XV, M.ofdv(~F, gcf), NP.vn(~F, x), rho, FV.vmax_nn(~F, x), PB.vall_xp(~F, x, $VP), rbv(~F, BX.vsub(~F, $XV, M.ofdv(~F, gcf)), M.ofdv(~F, grf), rho, rb_of($SKA, x, gcf, grf, hlc, hlr, hpb), hvr, hl))

@MACRO BBS O.add(F, O.add(F, NP.vn(~F, x), O.one(F)), O.one(F))

def bb_le(~F: O.OField, +v: O.C(F), +rho: O.C(F), +h: O.le(~F, rho, O.one(F))) -> O.le(~F, O.add(F, v, rho), O.sub(~F, O.add(F, O.add(F, v, O.one(F)), O.one(F)), rho)):
  FV.le_of_sub(~F, O.add(F, v, rho), O.sub(~F, O.add(F, O.add(F, v, O.one(F)), O.one(F)), rho), FM.nn_eq(~F, O.sub(~F, O.sub(~F, O.add(F, O.add(F, v, O.one(F)), O.one(F)), rho), O.add(F, v, rho)), O.add(F, O.sub(~F, O.one(F), rho), O.sub(~F, O.one(F), rho)), @ZEQ[v,, rho | (1 - rho) + (1 - rho) | (((v + 1) + 1) - rho) - (v + rho)], FO.nonneg_add(~F, O.sub(~F, O.one(F), rho), O.sub(~F, O.one(F), rho), FM.sub_nonneg(~F, rho, O.one(F), h), FM.sub_nonneg(~F, rho, O.one(F), h))))

def bbs_nn(~F: O.OField, +x: M.Vec(~F)) -> O.le(~F, O.zero(F), $BBS):
  FO.nonneg_add(~F, O.add(F, NP.vn(~F, x), O.one(F)), O.one(F), FO.nonneg_add(~F, NP.vn(~F, x), O.one(F), FV.vmax_nn(~F, x), NP.one_nn(~F)), NP.one_nn(~F))

@MACRO RBP +rho: O.C(F), +hr0: O.le(~F, O.zero(F), rho), +hr1: O.le(~F, rho, O.one(F)), +hvr: M.vbnd.all(~F, M.ofdv(~F, grf), rho)
@MACRO RBA rho, hr0, hr1, hvr

# the read-back box: graded at rho and bb = |x| + 2
def gbox_ans($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, $PGF, $RBP) -> BP.gbox($DN, ~F, ~H, rho, $BBS, CK.zipb($DN, $GCU, $GRU)):
  +hc0 = DM.le_trans(~F, O.zero(F), O.add(F, NP.vn(~F, x), rho), O.sub(~F, $BBS, rho), FO.nonneg_add(~F, NP.vn(~F, x), rho, FV.vmax_nn(~F, x), hr0), bb_le(~F, NP.vn(~F, x), rho, hr1))
  +hc = up_vall(~F, $NV, gcf, $VP, O.sub(~F, $BBS, rho), hc0, PB.vall_mono(~F, M.ofdv(~F, gcf), O.add(F, NP.vn(~F, x), rho), O.sub(~F, $BBS, rho), cen_b($SKA, x, g, $PGA, rho, hvr), bb_le(~F, NP.vn(~F, x), rho, hr1)))
  RD.gbox_zip($DN, ~F, ~H, $GCU, $GRU, rho, $BBS, vk_of(~F, ~H, $GCU, O.sub(~F, $BBS, rho), hc), rk_of(~F, ~H, $GRU, up_rnn(~F, $NV, grf, $VP, hrn)), vk_of(~F, ~H, $GRU, rho, up_vall(~F, $NV, grf, $VP, rho, hr0, hvr)), Equal.trans(Nat, KA.klen($DN, $GCU), $NV, KA.klen($DN, $GRU), klen_up($NV, 0n, gcf, $VP), Equal.sym(Nat, KA.klen($DN, $GRU), $NV, klen_up($NV, 0n, grf, $VP))))

@MACRO SDK SK.Sketch.sides(SV.mark(SO.red_of(sk), sk))

# the side conditions over the read-back box
def sides_ans($SKP, +x: M.Vec(~F), +g: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, $PGF, $RBP, +dy: {SV.dyadic(sk) == True{} : Bool}, +hbud: SBud(~F, $BBS, rho, x, $SDK)) -> {PL.check_sides($DN, $SDK, $GCU, $GRU) == True{} : Bool}:
  +hrk = rk_of(~F, ~H, $GRU, up_rnn(~F, $NV, grf, $VP, hrn))
  +inb = inbox_ans($SKA, x, g, hl, $PGA)
  +hx = CP.rbnd_inbox($DN, ~F, ~H, x, $GCU, $GRU, AP.both_r({M.len(~F, x) == M.len(~F, N.ofkv($DN, ~F, ~H, $GCU)) : Nat}, BX.rbnd(~F, BX.vsub(~F, x, N.ofkv($DN, ~F, ~H, $GCU)), N.ofkv($DN, ~F, ~H, $GRU)), inb), hrk)
  AP.band_t(KA.kvle($DN, Nil{}, $GRU), PL.sides_ok($DN, CK.zipb($DN, $GCU, $GRU), $SDK), kvle_nil(~F, ~H, $GRU, up_rnn(~F, $NV, grf, $VP, hrn)), sides_of(~F, ~H, CK.zipb($DN, $GCU, $GRU), rho, $BBS, hr0, bbs_nn(~F, x), gbox_ans($SKA, x, g, $PGA, $RBA), x, hx, $SDK, ds_sk(SO.red_of(sk), sk, L.band_r(SV.dyeqs(SK.Sketch.eqs(sk)), SV.dysides(SK.Sketch.sides(sk)), dy)), hbud))

# The verdict at P
# ----------------

@MACRO PLF PL.Plan{$VP, $EP, $NP, bsf}
@MACRO VH SV.held(SO.pins_of(sk), g, $GCU, $GRU)
@MACRO VE SV.explained(sk, SO.red_of(sk), SO.why_of(sk))
@MACRO VW WF.wf_dec(SV.mark(SO.red_of(sk), sk))
@MACRO VI BX.Sketch.within(SV.mark(SO.red_of(sk), sk), List.length(&2, N.NC(KI.dnum()), $GCU))
@MACRO VC PL.check($DN, SK.Sketch.eqs(SV.mark(SO.red_of(sk), sk)), $GCU, $GRU, $PLF)
@MACRO VS PL.check_sides($DN, $SDK, $GCU, $GRU)
@MACRO VXP +hwf: {WF.wf_dec(sk) == True{} : Bool}, +cov: {BX.Sketch.within(sk, $NV) == True{} : Bool}, +dy: {SV.dyadic(sk) == True{} : Bool}
@MACRO VXA hwf, cov, dy

def held_ans($SKP, +g: List<&2, S.D>, +gcf: List<&2, S.D>, +grf: List<&2, S.D>, +hkc: {PL.ktake($DN, $NP, gcf) == $GC0 : List<&2, S.D>}, +hkr: {PL.ktake($DN, $NP, grf) == $GR0 : List<&2, S.D>}) -> {$VH == True{} : Bool}:
  %Equal.sym(List<&2, Nat>, SO.ntake($NP, $VP), $FS, fs_pins($SKA)) : {SV.held(_, g, $GCU, $GRU) == True{} : Bool}
  held_go($SKA, g, gcf, grf, hkc, hkr, $FS, L.subl_refl($FS))

def within_ans($SKP, +cov: {BX.Sketch.within(sk, $NV) == True{} : Bool}, +gcf: List<&2, S.D>) -> {$VI == True{} : Bool}:
  %Equal.sym(Nat, List.length(&2, S.D, $GCU), $NV, length_up($NV, 0n, gcf, $VP)) : {BX.Sketch.within(SV.mark(SO.red_of(sk), sk), _) == True{} : Bool}
  w_mark(SO.red_of(sk), sk, $NV, cov)

# the whole verdict on the answer read back from the blocks' result
def ans_ok($SKP, $VXP, +x: M.Vec(~F), +g: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, $PGF, $RBP, +hbud: SBud(~F, $BBS, rho, x, $SDK)) -> {SO.accept(NU.POk{NU.NP{$PLF, $GCU, $GRU}}, sk, g, SO.red_of(sk), SO.why_of(sk), SO.pins_of(sk)) == True{} : Bool}:
  AP.band_t($VH, KA.band($VE, KA.band($VW, KA.band($VI, KA.band($VC, $VS)))), held_ans($SKA, g, gcf, grf, hkc, hkr),
  AP.band_t($VE, KA.band($VW, KA.band($VI, KA.band($VC, $VS))), RP.explained_of(sk, SO.red_of(sk), SO.why_of(sk), RP.red_good(sk, $NV, ha)),
  AP.band_t($VW, KA.band($VI, KA.band($VC, $VS)), WC.wf_mark(SO.red_of(sk), sk, hwf),
  AP.band_t($VI, KA.band($VC, $VS), within_ans($SKA, cov, gcf),
  AP.band_t($VC, $VS, cr_ok($SKA, hwf, cov, x, g, $PGA),
  sides_ans($SKA, x, g, hl, $PGA, $RBA, dy, hbud))))))

# the answer at one precision passes the verdict and holds x
def AnsOK(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +sk: SK.Sketch, +g: List<&2, S.D>, +x: M.Vec(~F), nx: NU.PR) -> Data:
  M.Both({SO.accept(nx, sk, g, SO.red_of(sk), SO.why_of(sk), SO.pins_of(sk)) == True{} : Bool}, BX.inbox($DN, ~F, ~H, SO.pr.gc(nx), SO.pr.gr(nx), x))

@MACRO RHT O.mul(F, NW.hnw(~F, p), tf)

def ans_r.go($SKP, $VXP, +x: M.Vec(~F), +g: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, +p: Nat, +tf: O.C(F), +htf: O.le(~F, O.zero(F), tf), +hr1: O.le(~F, $RHT, O.one(F)), +hbud: SBud(~F, $BBS, $RHT, x, $SDK), +bsf: List<&2, PL.PBlock<KI.dnum()>>, +gcf: List<&2, S.D>, +grf: List<&2, S.D>, +hw: {PL.walk($DN, gcf, grf, bsf, $SYS, $NP) == True{} : Bool}, +hkc: {PL.ktake($DN, $NP, gcf) == $GC0 : List<&2, S.D>}, +hkr: {PL.ktake($DN, $NP, grf) == $GR0 : List<&2, S.D>}, +hlc: {KA.klen($DN, gcf) == $NV : Nat}, +hlr: {KA.klen($DN, grf) == $NV : Nat}, +hpb: PP.pbox($DN, ~F, ~H, gcf, grf, $NV, $XV), +hrn: FV.rnn(~F, M.ofdv(~F, grf)), +hvb: M.vbnd.all(~F, M.ofdv(~F, grf), $RHT)) -> AnsOK(~F, ~H, sk, g, x, NU.plan.fin($VP, $EP, $NP, $NV, NU.PBOk{NU.PB{bsf, gcf, grf}})):
  +hr0 = FO.mul_nonneg(~F, NW.hnw(~F, p), tf, NW.hnw_nn(~F, p), htf)
  (ans_ok($SKA, $VXA, x, g, hl, $PGA, $RHT, hr0, hr1, hvb, hbud), inbox_ans($SKA, x, g, hl, $PGA))

def ans_r($SKP, $VXP, +x: M.Vec(~F), +g: List<&2, S.D>, +hl: {M.len(~F, x) == $NV : Nat}, +p: Nat, +tf: O.C(F), +htf: O.le(~F, O.zero(F), tf), +hr1: O.le(~F, $RHT, O.one(F)), +hbud: SBud(~F, $BBS, $RHT, x, $SDK), r: NU.PBR, hpg: PB.PG(~F, ~H, $VP, $NV, x, p, $NP, $GC0, $GR0, $SYS, tf, r)) -> AnsOK(~F, ~H, sk, g, x, NU.plan.fin($VP, $EP, $NP, $NV, r)):
  match r:
    case NU.PBOk{NU.PB{+bsf, +gcf, +grf}}:
      (hw, (hkc, (hkr, (hlc, (hlr, (hpb, (hrn, hvb))))))) = hpg
      ans_r.go($SKA, $VXA, x, g, hl, p, tf, htf, hr1, hbud, bsf, gcf, grf, hw, hkc, hkr, hlc, hlr, hpb, hrn, hvb)
    case NU.PBRetry{}:
      absurd(AnsOK(~F, ~H, sk, g, x, NU.plan.fin($VP, $EP, $NP, $NV, NU.PBRetry{})), hpg)
    case NU.PBStop{}:
      absurd(AnsOK(~F, ~H, sk, g, x, NU.plan.fin($VP, $EP, $NP, $NV, NU.PBStop{})), hpg)

# the plan at precision p, over a system s in block order
def pgo(+sk: SK.Sketch, +g: List<&2, S.D>, +p: Nat, +s: List<&2, E.QExpr>) -> NU.PR:
  NU.plan.fin($VP, $EP, $NP, $NV, NU.pblocks($BSS, NU.bcert($BSS, s, $G0B, p, $NP, $GC0, $GR0), s, $G0B, p, $NP, $GC0, $GR0, Nil{}))

# the solver's plan at p is the blocks in turn over the full system's
# reordering
def plan_is($SKP, +g: List<&2, S.D>, +p: Nat) -> {NU.plan(SO.kept(sk), $NV, SO.skel_of(sk), g, p) == pgo(sk, g, p, $SYS) : NU.PR}:
  %KP.kept_reorder(sk, ha, $VP, ST.alleqs($KB), SP.sfacts_gc($SFA)) : {pgo(sk, g, p, PL.reorder($VP, SO.kept(sk), $EP)) == pgo(sk, g, p, _) : NU.PR}
  {==}

@MACRO TCH PB.tch($CA, $KB, binv, $NP, @0)

# at P: the answer passes the verdict and holds x
def plan_ans($TP, $VXP, +hl: {M.len(~F, x) == $NV : Nat}, +hr1: O.le(~F, O.mul(F, NW.hnw(~F, p), $TCH), O.one(F)), +hbud: SBud(~F, $BBS, O.mul(F, NW.hnw(~F, p), $TCH), x, $SDK)) -> AnsOK(~F, ~H, sk, g, x, NU.plan(SO.kept(sk), $NV, SO.skel_of(sk), g, p)):
  %Equal.sym(NU.PR, NU.plan(SO.kept(sk), $NV, SO.skel_of(sk), g, p), pgo(sk, g, p, $SYS), plan_is($SKA, g, p)) : AnsOK(~F, ~H, sk, g, x, _)
  ans_r($SKA, $VXA, x, g, hl, p, $TCH, PB.tch_nn(~F, ~H, $FULL, $GOOD, $VP, x, $KB, binv, $NP, @0, FO.le_refl(~F, @0)), hr1, hbud, NU.pblocks($BSS, NU.bcert($BSS, $SYS, $G0B, p, $NP, $GC0, $GR0), $SYS, $G0B, p, $NP, $GC0, $GR0, Nil{}), plan_pg($TA))

# The top (C6d-4)
# ---------------
# Level l's precisions start at P_l = pfirst(l, 64, 96) >= 64 + 2l, so
# t = 2^-floor(P_l/2) <= 2^-l, and l 2^-l <= 1: with Q < l, t Q < 1.

def pfirst(l: Nat, +p: Nat, +q: Nat) -> Nat:
  match l:
    case 0n:
      p
    case 1n+m:
      pfirst(m, q, Nat.add(p, p))

def ptail(l: Nat, +c: Nat, +p: Nat, +q: Nat) -> List<&2, Nat>:
  match l:
    case 0n:
      SO.precs(c, q, Nat.add(p, p))
    case 1n+m:
      ptail(m, c, q, Nat.add(p, p))

def pf_head(l: Nat, +c: Nat, +p: Nat, +q: Nat) -> {SO.precs.from(l, 1n+c, p, q) == Con{pfirst(l, p, q), ptail(l, c, p, q)} : List<&2, Nat>}:
  match l:
    case 0n:
      {==}
    case 1n+m:
      pf_head(m, c, q, Nat.add(p, p))

def le_addl(c: Nat, +a: Nat, +b: Nat, h: {KA.natle(a, b) == True{} : Bool}) -> {KA.natle(Nat.add(c, a), Nat.add(c, b)) == True{} : Bool}:
  match c:
    case 0n:
      h
    case 1n+k:
      le_addl(k, a, b, h)

def pf_h2(+p: Nat, +q: Nat, +h1: {KA.natle(1n+(1n+p), q) == True{} : Bool}) -> {KA.natle(1n+(1n+Nat.add(p, p)), Nat.add(q, q)) == True{} : Bool}:
  +a3 = L.le_trans(Nat.add(1n+(1n+p), 1n+(1n+p)), Nat.add(q, 1n+(1n+p)), Nat.add(q, q), MX.le_add_rr(1n+(1n+p), q, 1n+(1n+p), h1), le_addl(q, 1n+(1n+p), q, h1))
  L.le_trans(1n+(1n+Nat.add(p, p)), Nat.add(1n+(1n+p), 1n+(1n+p)), Nat.add(q, q), le_addl(p, p, 1n+(1n+p), L.le_succ(p, 1n+p, L.le_succ(p, p, L.le_refl(p)))), a3)

def pf_rw(+k: Nat, +m: Nat, +pf: Nat, h: {KA.natle(1n+(1n+Nat.add(k, Nat.add(m, m))), pf) == True{} : Bool}) -> {KA.natle(Nat.add(k, Nat.add(1n+m, 1n+m)), pf) == True{} : Bool}:
  %LN.add_succ(m, m) : {KA.natle(Nat.add(k, 1n+_), pf) == True{} : Bool}
  %LN.add_succ(k, 1n+Nat.add(m, m)) : {KA.natle(_, pf) == True{} : Bool}
  %LN.add_succ(k, Nat.add(m, m)) : {KA.natle(1n+_, pf) == True{} : Bool}
  h

# the first components grow by at least 2 a step
def pf_ge(m: Nat, +p: Nat, +q: Nat, +k: Nat, +hk: {KA.natle(k, p) == True{} : Bool}, +h1: {KA.natle(1n+(1n+p), q) == True{} : Bool}, +h2: {KA.natle(1n+(1n+q), Nat.add(p, p)) == True{} : Bool}) -> {KA.natle(Nat.add(k, Nat.add(m, m)), pfirst(m, p, q)) == True{} : Bool}:
  match m:
    case 0n:
      %LN.add_zero(k) : {KA.natle(_, p) == True{} : Bool}
      hk
    case 1n++j:
      pf_rw(k, j, pfirst(j, q, Nat.add(p, p)), pf_ge(j, q, Nat.add(p, p), 1n+(1n+k), L.le_trans(1n+(1n+k), 1n+(1n+p), q, hk, h1), h2, pf_h2(p, q, h1)))

@MACRO PL0 pfirst(l, 64n, 96n)

def pl_ge(+l: Nat) -> {KA.natle(Nat.add(64n, Nat.add(l, l)), $PL0) == True{} : Bool}:
  pf_ge(l, 64n, 96n, 64n, L.le_refl(64n), {==}, {==})

def half_le(l: Nat, d: Nat, h: {KA.natle(Nat.add(l, l), 1n+Nat.add(d, d)) == True{} : Bool}) -> {KA.natle(l, d) == True{} : Bool}:
  match l d:
    case 0n d:
      {==}
    case 1n++i 0n:
      FO.absurd({KA.natle(1n+i, 0n) == True{} : Bool}, KA.ft((%Equal.sym(Nat, 1n+Nat.add(i, i), Nat.add(i, 1n+i), LN.add_succ(i, i)) : {KA.natle(_, 0n) == True{} : Bool}
        h)))
    case 1n++i 1n++j:
      half_le(i, j, (%Equal.sym(Nat, 1n+Nat.add(i, i), Nat.add(i, 1n+i), LN.add_succ(i, i)) : {KA.natle(_, 1n+(1n+Nat.add(j, j))) == True{} : Bool}
        (%Equal.sym(Nat, 1n+Nat.add(j, j), Nat.add(j, 1n+j), LN.add_succ(j, j)) : {KA.natle(Nat.add(i, 1n+i), 1n+_) == True{} : Bool}
          h)))

def mul2(+d: Nat) -> {Nat.mul(d, 2n) == Nat.add(d, d) : Nat}:
  %Equal.sym(Nat, d, Nat.mul(d, 1n), LN.mul_one(d)) : {Nat.mul(d, 2n) == Nat.add(d, _) : Nat}
  Equal.sym(Nat, Nat.add(d, Nat.mul(d, 1n)), Nat.mul(d, 2n), LN.mul_succ(d, 1n))

def dm_le(+s: Nat) -> {KA.natle(s, 1n+Nat.add(Nat.div(s, 2n), Nat.div(s, 2n))) == True{} : Bool}:
  %Equal.sym(Nat, s, Nat.add(Nat.mod(s, 2n), Nat.mul(Nat.div(s, 2n), 2n)), NO.divmod_eq(s, 1n)) : {KA.natle(_, 1n+Nat.add(Nat.div(s, 2n), Nat.div(s, 2n))) == True{} : Bool}
  %mul2(Nat.div(s, 2n)) : {KA.natle(Nat.add(Nat.mod(s, 2n), Nat.mul(Nat.div(s, 2n), 2n)), 1n+_) == True{} : Bool}
  MX.le_add_rr(Nat.mod(s, 2n), 1n, Nat.mul(Nat.div(s, 2n), 2n), SC.le_of_Le(Nat.mod(s, 2n), 1n, NO.mod_le(s, 1n)))

# floor(s/2) >= l for s >= 2l
def div_ge(+l: Nat, +s: Nat, h: {KA.natle(Nat.add(l, l), s) == True{} : Bool}) -> {KA.natle(l, Nat.div(s, 2n)) == True{} : Bool}:
  half_le(l, Nat.div(s, 2n), L.le_trans(Nat.add(l, l), s, 1n+Nat.add(Nat.div(s, 2n), Nat.div(s, 2n)), h, dm_le(s)))

def pl_half(+l: Nat) -> {KA.natle(l, Nat.div($PL0, 2n)) == True{} : Bool}:
  div_ge(l, $PL0, L.le_trans(Nat.add(l, l), Nat.add(64n, Nat.add(l, l)), $PL0, (%LN.add_comm(Nat.add(l, l), 64n) : {KA.natle(Nat.add(l, l), _) == True{} : Bool}
    L.le_add_r(Nat.add(l, l), 64n)), pl_ge(l)))
