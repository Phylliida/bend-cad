# bend-cad: the block's radius and box, for solve_complete (DESIGN §10.4,
# C5c). Proofs only.
#
# After Newton (lib/nwtpf.bend) the solver inverts the Jacobian at the
# center once more, rounds the inverse to Y, and searches radii from
# r0, the self-map bound at radius 0 times 65/64. This file shows that
# every radius between 2S and U passes the block checker (S the largest
# entry of that self-map bound), that the search reaches one, and that
# x_b lies in the box: |yc - x_b| <= (65/64) S <= r0 <= r.
#
# The self-map at radius r is compared entry by entry with the one at
# radius 0: the parameters' slope balls widen by at most ls r when the
# unknowns' radius grows from 0 to r (pair grades, below), so the
# comparison costs only first-order terms in r.

import Base
import ../spec/num.bend as S
import ../spec/ring.bend as E
import ../spec/field.bend as O
import ../spec/mat.bend as M
import ../spec/box.bend as BX
import ../spec/knum.bend as N
import ../spec/deriv.bend as DV
import ./karith.bend as KA
import ./kball.bend as KB
import ./cert.bend as CK
import ./certdef.bend as C
import ./certpf.bend as CP
import ./kinst.bend as KI
import ./numer.bend as NU
import ./struct.bend as ST
import ./flaws.bend as FL
import ./fring.bend as FR
import ./ford.bend as FO
import ./fmat.bend as FM
import ./fvec.bend as FV
import ./dmat.bend as DM
import ./gjpf.bend as GJ
import ./normpf.bend as NP
import ./dgjpf.bend as DG
import ./bndpf.bend as BP
import ./roundpf.bend as RP
import ./real.bend as RL
import ./qemb.bend as QE
import ./apxpf.bend as AP
import ./nwtpf.bend as NW
import ./slope.bend as SL

# K's absolute value is F's
# -------------------------

def kabs_eq(~K: N.Num, ~F: O.OField, ~H: N.Emb<K, F>, +a: N.NC(K)) -> {@H(KA.kabs(~K, a)) == FV.fabs(~F, @H(a)) : @T}:
  RL.le_antisymm(~F, @H(KA.kabs(~K, a)), FV.fabs(~F, @H(a)), BP.kabs_le(~K, ~F, ~H, a, FV.fabs(~F, @H(a)), FV.fabs_bnd(~F, @H(a))), FV.fabs_le(~F, @H(a), @H(KA.kabs(~K, a)), KA.kabs_bnd(~K, ~F, ~H, a)))

# Pair grades
# -----------
# Two balls with the same center over two boxes with the same centers,
# the second box's radii at least the first's and at most dl more: the
# second ball's radius is at least the first's and at most l dl more.

def pd(~F: O.OField, +dl: @T, +r0: @T, +r1: @T, +l: @T) -> Data:
  M.Both(O.le(~F, @0, r0), M.Both(O.le(~F, r0, r1), O.le(~F, @S(r1, r0), @M(l, dl))))

def pd_0(~F: O.OField, +dl: @T, +r0: @T, +r1: @T, +l: @T, h: pd(~F, dl, r0, r1, l)) -> O.le(~F, @0, r0):
  (a, b) = h
  a

def pd_12(~F: O.OField, +dl: @T, +r0: @T, +r1: @T, +l: @T, h: pd(~F, dl, r0, r1, l)) -> M.Both(O.le(~F, r0, r1), O.le(~F, @S(r1, r0), @M(l, dl))):
  (a, b) = h
  b

def pd_1(~F: O.OField, +dl: @T, +r0: @T, +r1: @T, +l: @T, +h: pd(~F, dl, r0, r1, l)) -> O.le(~F, r0, r1):
  AP.both_l(O.le(~F, r0, r1), O.le(~F, @S(r1, r0), @M(l, dl)), pd_12(~F, dl, r0, r1, l, h))

def pd_2(~F: O.OField, +dl: @T, +r0: @T, +r1: @T, +l: @T, +h: pd(~F, dl, r0, r1, l)) -> O.le(~F, @S(r1, r0), @M(l, dl)):
  AP.both_r(O.le(~F, r0, r1), O.le(~F, @S(r1, r0), @M(l, dl)), pd_12(~F, dl, r0, r1, l, h))

def pd_add(~F: O.OField, +dl: @T, +a0: @T, +a1: @T, +l1: @T, +b0: @T, +b1: @T, +l2: @T, +ha: pd(~F, dl, a0, a1, l1), +hb: pd(~F, dl, b0, b1, l2)) -> pd(~F, dl, @A(a0, b0), @A(a1, b1), @A(l1, l2)):
  (FO.nonneg_add(~F, a0, b0, pd_0(~F, dl, a0, a1, l1, ha), pd_0(~F, dl, b0, b1, l2, hb)),
   (RP.le_add2(~F, a0, a1, b0, b1, pd_1(~F, dl, a0, a1, l1, ha), pd_1(~F, dl, b0, b1, l2, hb)),
    FV.le_rw_r(~F, @S(@A(a1, b1), @A(a0, b0)), @A(@M(l1, dl), @M(l2, dl)), @M(@A(l1, l2), dl), FR.fring_eq(~F, [l1, l2, dl], E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{2n}}, E.ZMul{E.ZVar{1n}, E.ZVar{2n}}}, E.ZMul{E.ZAdd{E.ZVar{0n}, E.ZVar{1n}}, E.ZVar{2n}}, {==}),
      RL.le_rw_l(~F, @A(@S(a1, a0), @S(b1, b0)), @S(@A(a1, b1), @A(a0, b0)), @A(@M(l1, dl), @M(l2, dl)), FR.fring_eq(~F, [a0, a1, b0, b1], E.ZAdd{E.ZSub{E.ZVar{1n}, E.ZVar{0n}}, E.ZSub{E.ZVar{3n}, E.ZVar{2n}}}, E.ZSub{E.ZAdd{E.ZVar{1n}, E.ZVar{3n}}, E.ZAdd{E.ZVar{0n}, E.ZVar{2n}}}, {==}),
        RP.le_add2(~F, @S(a1, a0), @M(l1, dl), @S(b1, b0), @M(l2, dl), pd_2(~F, dl, a0, a1, l1, ha), pd_2(~F, dl, b0, b1, l2, hb))))))

def sub_nn(~F: O.OField, +a: @T, +b: @T, h: O.le(~F, a, b)) -> O.le(~F, @0, @S(b, a)):
  FM.sub_nonneg(~F, a, b, h)

# a product: |c1| = k1, |c2| = k2 (both boxes' centers agree), with
# k1 + a1 <= m1 and k2 + b1 <= m2 (the second box's grades)
def pd_mul(~F: O.OField, +dl: @T, +k1: @T, +k2: @T, +a0: @T, +a1: @T, +l1: @T, +m1: @T, +b0: @T, +b1: @T, +l2: @T, +m2: @T, +hk1: O.le(~F, @0, k1), +hk2: O.le(~F, @0, k2), +ha: pd(~F, dl, a0, a1, l1), +hb: pd(~F, dl, b0, b1, l2), +hm1: O.le(~F, @A(k1, a1), m1), +hm2: O.le(~F, @A(k2, b1), m2)) -> pd(~F, dl, @A(@A(@M(k1, b0), @M(k2, a0)), @M(a0, b0)), @A(@A(@M(k1, b1), @M(k2, a1)), @M(a1, b1)), @A(@M(m1, l2), @M(m2, l1))):
  +ha0 = pd_0(~F, dl, a0, a1, l1, ha)
  +hb0 = pd_0(~F, dl, b0, b1, l2, hb)
  +da = sub_nn(~F, a0, a1, pd_1(~F, dl, a0, a1, l1, ha))
  +db = sub_nn(~F, b0, b1, pd_1(~F, dl, b0, b1, l2, hb))
  +ea_ = sub_nn(~F, @S(a1, a0), @M(l1, dl), pd_2(~F, dl, a0, a1, l1, ha))
  +eb_ = sub_nn(~F, @S(b1, b0), @M(l2, dl), pd_2(~F, dl, b0, b1, l2, hb))
  +ha1 = DM.le_trans(~F, @0, a0, a1, ha0, pd_1(~F, dl, a0, a1, l1, ha))
  +hb1 = DM.le_trans(~F, @0, b0, b1, hb0, pd_1(~F, dl, b0, b1, l2, hb))
  +fm1 = sub_nn(~F, @A(k1, a1), m1, hm1)
  +fm2 = DM.le_trans(~F, @0, @S(m2, @A(k2, b1)), @S(m2, @A(k2, b0)), sub_nn(~F, @A(k2, b1), m2, hm2), FV.le_of_sub(~F, @S(m2, @A(k2, b1)), @S(m2, @A(k2, b0)), FM.nn_eq(~F, @S(@S(m2, @A(k2, b0)), @S(m2, @A(k2, b1))), @S(b1, b0), FR.fring_eq(~F, [m2, k2, b0, b1], E.ZSub{E.ZVar{3n}, E.ZVar{2n}}, E.ZSub{E.ZSub{E.ZVar{0n}, E.ZAdd{E.ZVar{1n}, E.ZVar{2n}}}, E.ZSub{E.ZVar{0n}, E.ZAdd{E.ZVar{1n}, E.ZVar{3n}}}}, {==}), db)))
  +m1n = DM.le_trans(~F, @0, @A(k1, a1), m1, FO.nonneg_add(~F, k1, a1, hk1, ha1), hm1)
  +m2n = DM.le_trans(~F, @0, @A(k2, b1), m2, FO.nonneg_add(~F, k2, b1, hk2, hb1), hm2)
  (FO.nonneg_add(~F, @A(@M(k1, b0), @M(k2, a0)), @M(a0, b0), FO.nonneg_add(~F, @M(k1, b0), @M(k2, a0), FO.mul_nonneg(~F, k1, b0, hk1, hb0), FO.mul_nonneg(~F, k2, a0, hk2, ha0)), FO.mul_nonneg(~F, a0, b0, ha0, hb0)),
   (FV.le_of_sub(~F, @A(@A(@M(k1, b0), @M(k2, a0)), @M(a0, b0)), @A(@A(@M(k1, b1), @M(k2, a1)), @M(a1, b1)),
      FM.nn_eq(~F, @S(@A(@A(@M(k1, b1), @M(k2, a1)), @M(a1, b1)), @A(@A(@M(k1, b0), @M(k2, a0)), @M(a0, b0))), @A(@M(@A(k1, a1), @S(b1, b0)), @M(@A(k2, b0), @S(a1, a0))),
        FR.fring_eq(~F, [k1, k2, a0, a1, b0, b1], E.ZAdd{E.ZMul{E.ZAdd{E.ZVar{0n}, E.ZVar{3n}}, E.ZSub{E.ZVar{5n}, E.ZVar{4n}}}, E.ZMul{E.ZAdd{E.ZVar{1n}, E.ZVar{4n}}, E.ZSub{E.ZVar{3n}, E.ZVar{2n}}}}, E.ZSub{E.ZAdd{E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{5n}}, E.ZMul{E.ZVar{1n}, E.ZVar{3n}}}, E.ZMul{E.ZVar{3n}, E.ZVar{5n}}}, E.ZAdd{E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{4n}}, E.ZMul{E.ZVar{1n}, E.ZVar{2n}}}, E.ZMul{E.ZVar{2n}, E.ZVar{4n}}}}, {==}),
        FO.nonneg_add(~F, @M(@A(k1, a1), @S(b1, b0)), @M(@A(k2, b0), @S(a1, a0)), FO.mul_nonneg(~F, @A(k1, a1), @S(b1, b0), FO.nonneg_add(~F, k1, a1, hk1, ha1), db), FO.mul_nonneg(~F, @A(k2, b0), @S(a1, a0), FO.nonneg_add(~F, k2, b0, hk2, hb0), da)))),
    FV.le_of_sub(~F, @S(@A(@A(@M(k1, b1), @M(k2, a1)), @M(a1, b1)), @A(@A(@M(k1, b0), @M(k2, a0)), @M(a0, b0))), @M(@A(@M(m1, l2), @M(m2, l1)), dl),
      FM.nn_eq(~F, @S(@M(@A(@M(m1, l2), @M(m2, l1)), dl), @S(@A(@A(@M(k1, b1), @M(k2, a1)), @M(a1, b1)), @A(@A(@M(k1, b0), @M(k2, a0)), @M(a0, b0)))), @A(@A(@M(@S(m1, @A(k1, a1)), @S(b1, b0)), @M(m1, @S(@M(l2, dl), @S(b1, b0)))), @A(@M(@S(m2, @A(k2, b0)), @S(a1, a0)), @M(m2, @S(@M(l1, dl), @S(a1, a0))))),
        FR.fring_eq(~F, [k1, k2, a0, a1, b0, b1, m1, m2, l1, l2, dl], E.ZAdd{E.ZAdd{E.ZMul{E.ZSub{E.ZVar{6n}, E.ZAdd{E.ZVar{0n}, E.ZVar{3n}}}, E.ZSub{E.ZVar{5n}, E.ZVar{4n}}}, E.ZMul{E.ZVar{6n}, E.ZSub{E.ZMul{E.ZVar{9n}, E.ZVar{10n}}, E.ZSub{E.ZVar{5n}, E.ZVar{4n}}}}}, E.ZAdd{E.ZMul{E.ZSub{E.ZVar{7n}, E.ZAdd{E.ZVar{1n}, E.ZVar{4n}}}, E.ZSub{E.ZVar{3n}, E.ZVar{2n}}}, E.ZMul{E.ZVar{7n}, E.ZSub{E.ZMul{E.ZVar{8n}, E.ZVar{10n}}, E.ZSub{E.ZVar{3n}, E.ZVar{2n}}}}}}, E.ZSub{E.ZMul{E.ZAdd{E.ZMul{E.ZVar{6n}, E.ZVar{9n}}, E.ZMul{E.ZVar{7n}, E.ZVar{8n}}}, E.ZVar{10n}}, E.ZSub{E.ZAdd{E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{5n}}, E.ZMul{E.ZVar{1n}, E.ZVar{3n}}}, E.ZMul{E.ZVar{3n}, E.ZVar{5n}}}, E.ZAdd{E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{4n}}, E.ZMul{E.ZVar{1n}, E.ZVar{2n}}}, E.ZMul{E.ZVar{2n}, E.ZVar{4n}}}}}, {==}),
        FO.nonneg_add(~F, @A(@M(@S(m1, @A(k1, a1)), @S(b1, b0)), @M(m1, @S(@M(l2, dl), @S(b1, b0)))), @A(@M(@S(m2, @A(k2, b0)), @S(a1, a0)), @M(m2, @S(@M(l1, dl), @S(a1, a0)))),
          FO.nonneg_add(~F, @M(@S(m1, @A(k1, a1)), @S(b1, b0)), @M(m1, @S(@M(l2, dl), @S(b1, b0))), FO.mul_nonneg(~F, @S(m1, @A(k1, a1)), @S(b1, b0), fm1, db), FO.mul_nonneg(~F, m1, @S(@M(l2, dl), @S(b1, b0)), m1n, eb_)),
          FO.nonneg_add(~F, @M(@S(m2, @A(k2, b0)), @S(a1, a0)), @M(m2, @S(@M(l1, dl), @S(a1, a0))), FO.mul_nonneg(~F, @S(m2, @A(k2, b0)), @S(a1, a0), fm2, da), FO.mul_nonneg(~F, m2, @S(@M(l1, dl), @S(a1, a0)), m2n, ea_)))))))

def pd_zero(~F: O.OField, +dl: @T, +x: @T, +hx: O.le(~F, @0, x)) -> pd(~F, dl, x, x, @0):
  (hx, (FO.le_refl(~F, x), FV.le_of_sub(~F, @S(x, x), @M(@0, dl), FM.nn_eq(~F, @S(@M(@0, dl), @S(x, x)), @0, FR.fring_eq(~F, [x, dl], E.ZCst{S.Z0{}}, E.ZSub{E.ZMul{E.ZCst{S.Z0{}}, E.ZVar{1n}}, E.ZSub{E.ZVar{0n}, E.ZVar{0n}}}, {==}), FO.le_refl(~F, @0)))))

def pd_one(~F: O.OField, +dl: @T, +x: @T, +hx: O.le(~F, @0, x), +hdl: O.le(~F, @0, dl)) -> pd(~F, dl, x, x, @1):
  (hx, (FO.le_refl(~F, x), FV.le_of_sub(~F, @S(x, x), @M(@1, dl), FM.nn_eq(~F, @S(@M(@1, dl), @S(x, x)), dl, FR.fring_eq(~F, [x, dl], E.ZVar{1n}, E.ZSub{E.ZMul{E.ZCst{S.Zpos{S.XH{}}}, E.ZVar{1n}}, E.ZSub{E.ZVar{0n}, E.ZVar{0n}}}, {==}), hdl))))

@MACRO KH ~K: N.Num, ~F: O.OField, ~H: N.Emb<K, F>
@MACRO KHA ~K, ~F, ~H

# Pairs of balls and of boxes
# ---------------------------

def bpd($KH, +dl: @T, x0: KB.KB<K>, x1: KB.KB<K>, +l: @T) -> Data:
  pd(~F, dl, @H(KB.KB.r(K, x0)), @H(KB.KB.r(K, x1)), l)

# two boxes ball by ball: radii 0 <= r0 <= r1 <= r0 + dl
def bpair($KH, +dl: @T, b0: List<&2, KB.KB<K>>, b1: List<&2, KB.KB<K>>) -> Data:
  match b0 b1:
    case Nil{} Nil{}:
      Unit
    case Nil{} Con{x1, t1}:
      Empty
    case Con{x0, t0} Nil{}:
      Empty
    case Con{x0, t0} Con{x1, t1}:
      M.Both(bpd($KHA, dl, x0, x1, @1), bpair($KHA, dl, t0, t1))

def blook_pd($KH, +dl: @T, +hdl: O.le(~F, @0, dl), b0: List<&2, KB.KB<K>>, b1: List<&2, KB.KB<K>>, i: Nat, h: bpair($KHA, dl, b0, b1)) -> bpd($KHA, dl, KB.blook(~K, b0, i), KB.blook(~K, b1, i), @1):
  match b0 b1 i:
    case Nil{} Nil{} i:
      pd_one(~F, dl, @H(N.nzero(K)), KB.e0_nonneg($KHA), hdl)
    case Nil{} Con{x1, t1} i:
      FO.absurd(bpd($KHA, dl, KB.blook(~K, Nil{}, i), KB.blook(~K, Con{x1, t1}, i), @1), h)
    case Con{x0, t0} Nil{} i:
      FO.absurd(bpd($KHA, dl, KB.blook(~K, Con{x0, t0}, i), KB.blook(~K, Nil{}, i), @1), h)
    case Con{+x0, +t0} Con{+x1, +t1} 0n:
      (h1, h2) = h
      h1
    case Con{+x0, +t0} Con{+x1, +t1} 1n+j:
      (h1, h2) = h
      blook_pd($KHA, dl, hdl, t0, t1, j, h2)

# with the same centers, K's |center| agrees for kball and ksl
def kc_eq($KH, +b0: List<&2, KB.KB<K>>, +b1: List<&2, KB.KB<K>>, +hcen: {BP.cen($KHA, b0) == BP.cen($KHA, b1) : M.Vec(~F)}, +e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}) -> {@H(KA.kabs(~K, KB.KB.c(K, KB.kball(~K, b0, e)))) == @H(KA.kabs(~K, KB.KB.c(K, KB.kball(~K, b1, e)))) : @T}:
  %Equal.sym(@T, @H(KA.kabs(~K, KB.KB.c(K, KB.kball(~K, b0, e)))), FV.fabs(~F, @H(KB.KB.c(K, KB.kball(~K, b0, e)))), kabs_eq($KHA, KB.KB.c(K, KB.kball(~K, b0, e)))) : {_ == @H(KA.kabs(~K, KB.KB.c(K, KB.kball(~K, b1, e)))) : @T}
  %Equal.sym(@T, @H(KA.kabs(~K, KB.KB.c(K, KB.kball(~K, b1, e)))), FV.fabs(~F, @H(KB.KB.c(K, KB.kball(~K, b1, e)))), kabs_eq($KHA, KB.KB.c(K, KB.kball(~K, b1, e)))) : {FV.fabs(~F, @H(KB.KB.c(K, KB.kball(~K, b0, e)))) == _ : @T}
  %Equal.sym(@T, @H(KB.KB.c(K, KB.kball(~K, b0, e))), O.eval(~F, BP.cen($KHA, b0), e), BP.kball_c($KHA, b0, e, hh)) : {FV.fabs(~F, _) == FV.fabs(~F, @H(KB.KB.c(K, KB.kball(~K, b1, e)))) : @T}
  %Equal.sym(@T, @H(KB.KB.c(K, KB.kball(~K, b1, e))), O.eval(~F, BP.cen($KHA, b1), e), BP.kball_c($KHA, b1, e, hh)) : {FV.fabs(~F, O.eval(~F, BP.cen($KHA, b0), e)) == FV.fabs(~F, _) : @T}
  %Equal.sym(M.Vec(~F), BP.cen($KHA, b0), BP.cen($KHA, b1), hcen) : {FV.fabs(~F, O.eval(~F, _, e)) == FV.fabs(~F, O.eval(~F, BP.cen($KHA, b1), e)) : @T}
  {==}

def sc_eq($KH, +b0: List<&2, KB.KB<K>>, +b1: List<&2, KB.KB<K>>, +hcen: {BP.cen($KHA, b0) == BP.cen($KHA, b1) : M.Vec(~F)}, +i: Nat, +e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}) -> {@H(KA.kabs(~K, KB.KB.c(K, KB.ksl(~K, i, b0, e)))) == @H(KA.kabs(~K, KB.KB.c(K, KB.ksl(~K, i, b1, e)))) : @T}:
  %Equal.sym(@T, @H(KA.kabs(~K, KB.KB.c(K, KB.ksl(~K, i, b0, e)))), FV.fabs(~F, @H(KB.KB.c(K, KB.ksl(~K, i, b0, e)))), kabs_eq($KHA, KB.KB.c(K, KB.ksl(~K, i, b0, e)))) : {_ == @H(KA.kabs(~K, KB.KB.c(K, KB.ksl(~K, i, b1, e)))) : @T}
  %Equal.sym(@T, @H(KA.kabs(~K, KB.KB.c(K, KB.ksl(~K, i, b1, e)))), FV.fabs(~F, @H(KB.KB.c(K, KB.ksl(~K, i, b1, e)))), kabs_eq($KHA, KB.KB.c(K, KB.ksl(~K, i, b1, e)))) : {FV.fabs(~F, @H(KB.KB.c(K, KB.ksl(~K, i, b0, e)))) == _ : @T}
  %Equal.sym(@T, @H(KB.KB.c(K, KB.ksl(~K, i, b0, e))), SL.sl(~F, i, BP.cen($KHA, b0), BP.cen($KHA, b0), e), BP.ksl_c($KHA, i, b0, e, hh)) : {FV.fabs(~F, _) == FV.fabs(~F, @H(KB.KB.c(K, KB.ksl(~K, i, b1, e)))) : @T}
  %Equal.sym(@T, @H(KB.KB.c(K, KB.ksl(~K, i, b1, e))), SL.sl(~F, i, BP.cen($KHA, b1), BP.cen($KHA, b1), e), BP.ksl_c($KHA, i, b1, e, hh)) : {FV.fabs(~F, SL.sl(~F, i, BP.cen($KHA, b0), BP.cen($KHA, b0), e)) == FV.fabs(~F, _) : @T}
  %Equal.sym(M.Vec(~F), BP.cen($KHA, b0), BP.cen($KHA, b1), hcen) : {FV.fabs(~F, SL.sl(~F, i, _, _, e)) == FV.fabs(~F, SL.sl(~F, i, BP.cen($KHA, b1), BP.cen($KHA, b1), e)) : @T}
  {==}

def pd_badd($KH, +dl: @T, x0: KB.KB<K>, y0: KB.KB<K>, x1: KB.KB<K>, y1: KB.KB<K>, +l1: @T, +l2: @T, +hx: bpd($KHA, dl, x0, x1, l1), +hy: bpd($KHA, dl, y0, y1, l2)) -> bpd($KHA, dl, KB.badd(~K, x0, y0), KB.badd(~K, x1, y1), @A(l1, l2)):
  match x0 y0 x1 y1:
    case KB.KB{+c1, +r1} KB.KB{+c2, +r2} KB.KB{+d1, +s1} KB.KB{+d2, +s2}:
      %KA.ea($KHA, r1, r2) : pd(~F, dl, _, @H(N.nadd(K, s1, s2)), @A(l1, l2))
      %KA.ea($KHA, s1, s2) : pd(~F, dl, @A(@H(r1), @H(r2)), _, @A(l1, l2))
      pd_add(~F, dl, @H(r1), @H(s1), l1, @H(r2), @H(s2), l2, hx, hy)

def pd_bneg($KH, +dl: @T, x0: KB.KB<K>, x1: KB.KB<K>, +l: @T, +hx: bpd($KHA, dl, x0, x1, l)) -> bpd($KHA, dl, KB.bneg(~K, x0), KB.bneg(~K, x1), l):
  match x0 x1:
    case KB.KB{+c1, +r1} KB.KB{+d1, +s1}:
      hx

# |c| + r <= m from a grade
def gr_m($KH, +rho: @T, +x: KB.KB<K>, +m: @T, +l: @T, +g: BP.grade($KHA, rho, x, m, l)) -> O.le(~F, @A(@H(KA.kabs(~K, KB.KB.c(K, x))), @H(KB.KB.r(K, x))), m):
  %Equal.sym(@T, @H(KA.kabs(~K, KB.KB.c(K, x))), FV.fabs(~F, @H(KB.KB.c(K, x))), kabs_eq($KHA, KB.KB.c(K, x))) : O.le(~F, @A(_, @H(KB.KB.r(K, x))), m)
  FV.le_of_sub(~F, @A(FV.fabs(~F, @H(KB.KB.c(K, x))), @H(KB.KB.r(K, x))), m, FM.nn_eq(~F, @S(m, @A(FV.fabs(~F, @H(KB.KB.c(K, x))), @H(KB.KB.r(K, x)))), @S(@S(m, @H(KB.KB.r(K, x))), FV.fabs(~F, @H(KB.KB.c(K, x)))), FR.fring_eq(~F, [m, @H(KB.KB.r(K, x)), FV.fabs(~F, @H(KB.KB.c(K, x)))], E.ZSub{E.ZSub{E.ZVar{0n}, E.ZVar{1n}}, E.ZVar{2n}}, E.ZSub{E.ZVar{0n}, E.ZAdd{E.ZVar{2n}, E.ZVar{1n}}}, {==}),
    FM.sub_nonneg(~F, FV.fabs(~F, @H(KB.KB.c(K, x))), @S(m, @H(KB.KB.r(K, x))), FV.fabs_le(~F, @H(KB.KB.c(K, x)), @S(m, @H(KB.KB.r(K, x))), BP.gf_c(~F, rho, @H(KB.KB.c(K, x)), @H(KB.KB.r(K, x)), m, l, g)))))

def pd_bmul($KH, +dl: @T, +rho: @T, x0: KB.KB<K>, y0: KB.KB<K>, x1: KB.KB<K>, y1: KB.KB<K>, +l1: @T, +m1: @T, +l2: @T, +m2: @T, +lx: @T, +ly: @T, +ek1: {@H(KA.kabs(~K, KB.KB.c(K, x0))) == @H(KA.kabs(~K, KB.KB.c(K, x1))) : @T}, +ek2: {@H(KA.kabs(~K, KB.KB.c(K, y0))) == @H(KA.kabs(~K, KB.KB.c(K, y1))) : @T}, +hx: bpd($KHA, dl, x0, x1, l1), +hy: bpd($KHA, dl, y0, y1, l2), +gx: BP.grade($KHA, rho, x1, m1, lx), +gy: BP.grade($KHA, rho, y1, m2, ly)) -> bpd($KHA, dl, KB.bmul(~K, x0, y0), KB.bmul(~K, x1, y1), @A(@M(m1, l2), @M(m2, l1))):
  match x0 y0 x1 y1:
    case KB.KB{+c1, +r1} KB.KB{+c2, +r2} KB.KB{+d1, +s1} KB.KB{+d2, +s2}:
      %Equal.sym(@T, @H(N.nadd(K, N.nadd(K, N.nmul(K, KA.kabs(~K, c1), r2), N.nmul(K, KA.kabs(~K, c2), r1)), N.nmul(K, r1, r2))), @A(@A(@M(@H(KA.kabs(~K, c1)), @H(r2)), @M(@H(KA.kabs(~K, c2)), @H(r1))), @M(@H(r1), @H(r2))), BP.bmul_r($KHA, c1, r1, c2, r2)) : pd(~F, dl, _, @H(N.nadd(K, N.nadd(K, N.nmul(K, KA.kabs(~K, d1), s2), N.nmul(K, KA.kabs(~K, d2), s1)), N.nmul(K, s1, s2))), @A(@M(m1, l2), @M(m2, l1)))
      %Equal.sym(@T, @H(N.nadd(K, N.nadd(K, N.nmul(K, KA.kabs(~K, d1), s2), N.nmul(K, KA.kabs(~K, d2), s1)), N.nmul(K, s1, s2))), @A(@A(@M(@H(KA.kabs(~K, d1)), @H(s2)), @M(@H(KA.kabs(~K, d2)), @H(s1))), @M(@H(s1), @H(s2))), BP.bmul_r($KHA, d1, s1, d2, s2)) : pd(~F, dl, @A(@A(@M(@H(KA.kabs(~K, c1)), @H(r2)), @M(@H(KA.kabs(~K, c2)), @H(r1))), @M(@H(r1), @H(r2))), _, @A(@M(m1, l2), @M(m2, l1)))
      %Equal.sym(@T, @H(KA.kabs(~K, c1)), @H(KA.kabs(~K, d1)), ek1) : pd(~F, dl, @A(@A(@M(_, @H(r2)), @M(@H(KA.kabs(~K, c2)), @H(r1))), @M(@H(r1), @H(r2))), @A(@A(@M(@H(KA.kabs(~K, d1)), @H(s2)), @M(@H(KA.kabs(~K, d2)), @H(s1))), @M(@H(s1), @H(s2))), @A(@M(m1, l2), @M(m2, l1)))
      %Equal.sym(@T, @H(KA.kabs(~K, c2)), @H(KA.kabs(~K, d2)), ek2) : pd(~F, dl, @A(@A(@M(@H(KA.kabs(~K, d1)), @H(r2)), @M(_, @H(r1))), @M(@H(r1), @H(r2))), @A(@A(@M(@H(KA.kabs(~K, d1)), @H(s2)), @M(@H(KA.kabs(~K, d2)), @H(s1))), @M(@H(s1), @H(s2))), @A(@M(m1, l2), @M(m2, l1)))
      pd_mul(~F, dl, @H(KA.kabs(~K, d1)), @H(KA.kabs(~K, d2)), @H(r1), @H(s1), l1, m1, @H(r2), @H(s2), l2, m2, KA.kabs_nonneg($KHA, d1), KA.kabs_nonneg($KHA, d2), hx, hy, gr_m($KHA, rho, KB.KB{d1, s1}, m1, lx, gx), gr_m($KHA, rho, KB.KB{d2, s2}, m2, ly, gy))

@MACRO PBP +dl: @T, +rho: @T, +bb: @T, +hdl: O.le(~F, @0, dl), +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +b0: List<&2, KB.KB<K>>, +b1: List<&2, KB.KB<K>>, +hcen: {BP.cen($KHA, b0) == BP.cen($KHA, b1) : M.Vec(~F)}, +hp: bpair($KHA, dl, b0, b1), +hg: BP.gbox($KHA, rho, bb, b1)
@MACRO PBA dl, rho, bb, hdl, hr, hb, b0, b1, hcen, hp, hg

# e's ball over the wider box: radius at most lp dl more
def kb_pd($KH, $PBP, e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}) -> bpd($KHA, dl, KB.kball(~K, b0, e), KB.kball(~K, b1, e), BP.lp(~F, bb, e)):
  match e:
    case E.QVar{i}:
      blook_pd($KHA, dl, hdl, b0, b1, i, hp)
    case E.QCst{+q}:
      pd_zero(~F, dl, @H(N.nzero(K)), KB.e0_nonneg($KHA))
    case E.QAdd{+a, +b}:
      pd_badd($KHA, dl, KB.kball(~K, b0, a), KB.kball(~K, b0, b), KB.kball(~K, b1, a), KB.kball(~K, b1, b), BP.lp(~F, bb, a), BP.lp(~F, bb, b), kb_pd($KHA, $PBA, a, KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)), kb_pd($KHA, $PBA, b, KA.band_r(KB.held(~K, a), KB.held(~K, b), hh)))
    case E.QSub{+a, +b}:
      pd_badd($KHA, dl, KB.kball(~K, b0, a), KB.bneg(~K, KB.kball(~K, b0, b)), KB.kball(~K, b1, a), KB.bneg(~K, KB.kball(~K, b1, b)), BP.lp(~F, bb, a), BP.lp(~F, bb, b), kb_pd($KHA, $PBA, a, KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)), pd_bneg($KHA, dl, KB.kball(~K, b0, b), KB.kball(~K, b1, b), BP.lp(~F, bb, b), kb_pd($KHA, $PBA, b, KA.band_r(KB.held(~K, a), KB.held(~K, b), hh))))
    case E.QMul{+a, +b}:
      +ha = KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)
      +hb2 = KA.band_r(KB.held(~K, a), KB.held(~K, b), hh)
      pd_bmul($KHA, dl, rho, KB.kball(~K, b0, a), KB.kball(~K, b0, b), KB.kball(~K, b1, a), KB.kball(~K, b1, b), BP.lp(~F, bb, a), BP.mj(~F, bb, a), BP.lp(~F, bb, b), BP.mj(~F, bb, b), BP.lp(~F, bb, a), BP.lp(~F, bb, b), kc_eq($KHA, b0, b1, hcen, a, ha), kc_eq($KHA, b0, b1, hcen, b, hb2), kb_pd($KHA, $PBA, a, ha), kb_pd($KHA, $PBA, b, hb2), BP.kball_grade($KHA, rho, bb, hr, hb, b1, hg, a, ha), BP.kball_grade($KHA, rho, bb, hr, hb, b1, hg, b, hb2))
    case E.QNeg{+a}:
      pd_bneg($KHA, dl, KB.kball(~K, b0, a), KB.kball(~K, b1, a), BP.lp(~F, bb, a), kb_pd($KHA, $PBA, a, hh))

def kind_pd($KH, +dl: @T, b: Bool) -> bpd($KHA, dl, KB.kind(~K, b), KB.kind(~K, b), @0):
  match b:
    case True{}:
      pd_zero(~F, dl, @H(N.nzero(K)), KB.e0_nonneg($KHA))
    case False{}:
      pd_zero(~F, dl, @H(N.nzero(K)), KB.e0_nonneg($KHA))

# e's slope ball in variable i over the wider box: radius at most ls dl more
def ks_pd($KH, $PBP, +i: Nat, e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}) -> bpd($KHA, dl, KB.ksl(~K, i, b0, e), KB.ksl(~K, i, b1, e), BP.ls(~F, bb, e)):
  match e:
    case E.QVar{j}:
      kind_pd($KHA, dl, KA.nateq(i, j))
    case E.QCst{q}:
      pd_zero(~F, dl, @H(N.nzero(K)), KB.e0_nonneg($KHA))
    case E.QAdd{+a, +b}:
      pd_badd($KHA, dl, KB.ksl(~K, i, b0, a), KB.ksl(~K, i, b0, b), KB.ksl(~K, i, b1, a), KB.ksl(~K, i, b1, b), BP.ls(~F, bb, a), BP.ls(~F, bb, b), ks_pd($KHA, $PBA, i, a, KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)), ks_pd($KHA, $PBA, i, b, KA.band_r(KB.held(~K, a), KB.held(~K, b), hh)))
    case E.QSub{+a, +b}:
      pd_badd($KHA, dl, KB.ksl(~K, i, b0, a), KB.bneg(~K, KB.ksl(~K, i, b0, b)), KB.ksl(~K, i, b1, a), KB.bneg(~K, KB.ksl(~K, i, b1, b)), BP.ls(~F, bb, a), BP.ls(~F, bb, b), ks_pd($KHA, $PBA, i, a, KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)), pd_bneg($KHA, dl, KB.ksl(~K, i, b0, b), KB.ksl(~K, i, b1, b), BP.ls(~F, bb, b), ks_pd($KHA, $PBA, i, b, KA.band_r(KB.held(~K, a), KB.held(~K, b), hh))))
    case E.QMul{+a, +b}:
      +ha = KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)
      +hb2 = KA.band_r(KB.held(~K, a), KB.held(~K, b), hh)
      pd_badd($KHA, dl, KB.bmul(~K, KB.kball(~K, b0, a), KB.ksl(~K, i, b0, b)), KB.bmul(~K, KB.kball(~K, b0, b), KB.ksl(~K, i, b0, a)), KB.bmul(~K, KB.kball(~K, b1, a), KB.ksl(~K, i, b1, b)), KB.bmul(~K, KB.kball(~K, b1, b), KB.ksl(~K, i, b1, a)), @A(@M(BP.mj(~F, bb, a), BP.ls(~F, bb, b)), @M(BP.ms(~F, bb, b), BP.lp(~F, bb, a))), @A(@M(BP.mj(~F, bb, b), BP.ls(~F, bb, a)), @M(BP.ms(~F, bb, a), BP.lp(~F, bb, b))),
        pd_bmul($KHA, dl, rho, KB.kball(~K, b0, a), KB.ksl(~K, i, b0, b), KB.kball(~K, b1, a), KB.ksl(~K, i, b1, b), BP.lp(~F, bb, a), BP.mj(~F, bb, a), BP.ls(~F, bb, b), BP.ms(~F, bb, b), BP.lp(~F, bb, a), BP.ls(~F, bb, b), kc_eq($KHA, b0, b1, hcen, a, ha), sc_eq($KHA, b0, b1, hcen, i, b, hb2), kb_pd($KHA, $PBA, a, ha), ks_pd($KHA, $PBA, i, b, hb2), BP.kball_grade($KHA, rho, bb, hr, hb, b1, hg, a, ha), BP.ksl_grade($KHA, rho, bb, hr, hb, b1, hg, i, b, hb2)),
        pd_bmul($KHA, dl, rho, KB.kball(~K, b0, b), KB.ksl(~K, i, b0, a), KB.kball(~K, b1, b), KB.ksl(~K, i, b1, a), BP.lp(~F, bb, b), BP.mj(~F, bb, b), BP.ls(~F, bb, a), BP.ms(~F, bb, a), BP.lp(~F, bb, b), BP.ls(~F, bb, a), kc_eq($KHA, b0, b1, hcen, b, hb2), sc_eq($KHA, b0, b1, hcen, i, a, ha), kb_pd($KHA, $PBA, b, hb2), ks_pd($KHA, $PBA, i, a, ha), BP.kball_grade($KHA, rho, bb, hr, hb, b1, hg, b, hb2), BP.ksl_grade($KHA, rho, bb, hr, hb, b1, hg, i, a, ha)))
    case E.QNeg{+a}:
      pd_bneg($KHA, dl, KB.ksl(~K, i, b0, a), KB.ksl(~K, i, b1, a), BP.ls(~F, bb, a), ks_pd($KHA, $PBA, i, a, hh))

# Lists in K and F
# ----------------

@MACRO DN ~KI.dnum()
@MACRO DH ~KI.dnum(), ~F, ~H

def kfit_dreps(n: Nat, +r: S.D) -> {KA.kfit($DN, n, NU.dreps(n, r)) == NU.dreps(n, r) : List<&2, S.D>}:
  match n:
    case 0n:
      {==}
    case 1n+k:
      %Equal.sym(List<&2, S.D>, KA.kfit($DN, k, NU.dreps(k, r)), NU.dreps(k, r), kfit_dreps(k, r)) : {Con{r, _} == Con{r, NU.dreps(k, r)} : List<&2, S.D>}
      {==}

def kfit_nil(n: Nat) -> {KA.kfit($DN, n, Nil{}) == NU.dreps(n, M.d0()) : List<&2, S.D>}:
  match n:
    case 0n:
      {==}
    case 1n+k:
      %Equal.sym(List<&2, S.D>, KA.kfit($DN, k, Nil{}), NU.dreps(k, M.d0()), kfit_nil(k)) : {Con{M.d0(), _} == Con{M.d0(), NU.dreps(k, M.d0())} : List<&2, S.D>}
      {==}

def klen_dreps(n: Nat, +r: S.D) -> {KA.klen($DN, NU.dreps(n, r)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+k:
      %Equal.sym(Nat, KA.klen($DN, NU.dreps(k, r)), k, klen_dreps(k, r)) : {1n+_ == 1n+k : Nat}
      {==}

def klen_app(~K: N.Num, u: N.KVec(~K), +w: N.KVec(~K)) -> {KA.klen(~K, KA.kapp(~K, u, w)) == Nat.add(KA.klen(~K, u), KA.klen(~K, w)) : Nat}:
  match u:
    case Nil{}:
      {==}
    case Con{a, us}:
      %Equal.sym(Nat, KA.klen(~K, KA.kapp(~K, us, w)), Nat.add(KA.klen(~K, us), KA.klen(~K, w)), klen_app(~K, us, w)) : {1n+_ == 1n+Nat.add(KA.klen(~K, us), KA.klen(~K, w)) : Nat}
      {==}

# n copies of x in F
def frep(~F: O.OField, n: Nat, +x: @T) -> M.Vec(~F):
  match n:
    case 0n:
      Nil{}
    case 1n+k:
      Con{x, frep(~F, k, x)}

def ofdv_dreps(~F: O.OField, n: Nat, +r: S.D) -> {M.ofdv(~F, NU.dreps(n, r)) == frep(~F, n, M.ofd(~F, r)) : M.Vec(~F)}:
  match n:
    case 0n:
      {==}
    case 1n+k:
      %Equal.sym(M.Vec(~F), M.ofdv(~F, NU.dreps(k, r)), frep(~F, k, M.ofd(~F, r)), ofdv_dreps(~F, k, r)) : {Con{M.ofd(~F, r), _} == Con{M.ofd(~F, r), frep(~F, k, M.ofd(~F, r))} : M.Vec(~F)}
      {==}

def len_frep(~F: O.OField, n: Nat, +x: @T) -> {M.len(~F, frep(~F, n, x)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+k:
      %Equal.sym(Nat, M.len(~F, frep(~F, k, x)), k, len_frep(~F, k, x)) : {1n+_ == 1n+k : Nat}
      {==}

def frep_all(~F: O.OField, n: Nat, +x: @T, +hx: O.le(~F, @0, x)) -> M.vbnd.all(~F, frep(~F, n, x), x):
  match n:
    case 0n:
      Unit{}
    case 1n+k:
      (FV.bnd_self(~F, x, hx), frep_all(~F, k, x, hx))

def frep_nn(~F: O.OField, n: Nat, +x: @T, +hx: O.le(~F, @0, x)) -> FV.rnn(~F, frep(~F, n, x)):
  match n:
    case 0n:
      Unit{}
    case 1n+k:
      (hx, frep_nn(~F, k, x, hx))

def vn_frep(~F: O.OField, +n: Nat, +x: @T, +hx: O.le(~F, @0, x)) -> O.le(~F, NP.vn(~F, frep(~F, n, x)), x):
  FV.vmax_lub(~F, frep(~F, n, x), x, frep_all(~F, n, x, hx), hx)

def klen_d(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +v: List<&2, S.D>) -> {KA.klen($DN, v) == M.len(~F, M.ofdv(~F, v)) : Nat}:
  %AP.ofkv_d(~F, ~H, v) : {KA.klen($DN, v) == M.len(~F, _) : Nat}
  Equal.sym(Nat, M.len(~F, N.ofkv($DH, v)), KA.klen($DN, v), CP.len_ofkv($DH, v))

# the centers of a zipped box are its center list
def bcen_zipb(~K: N.Num, cs: N.KVec(~K), rs: N.KVec(~K), hl: {KA.klen(~K, cs) == KA.klen(~K, rs) : Nat}) -> {KB.bcenters(~K, CK.zipb(~K, cs, rs)) == cs : N.KVec(~K)}:
  match cs rs:
    case Nil{} Nil{}:
      {==}
    case Nil{} Con{r, rt}:
      FO.absurd({KB.bcenters(~K, CK.zipb(~K, Nil{}, Con{r, rt})) == Nil{} : N.KVec(~K)}, FV.zero_ne(KA.klen(~K, rt), hl))
    case Con{c, ct} Nil{}:
      FO.absurd({KB.bcenters(~K, CK.zipb(~K, Con{c, ct}, Nil{})) == Con{c, ct} : N.KVec(~K)}, FV.succ_ne(KA.klen(~K, ct), hl))
    case Con{+c, +ct} Con{+r, +rt}:
      %Equal.sym(N.KVec(~K), KB.bcenters(~K, CK.zipb(~K, ct, rt)), ct, bcen_zipb(~K, ct, rt, FV.succ_inj(KA.klen(~K, ct), KA.klen(~K, rt), hl))) : {Con{c, _} == Con{c, ct} : N.KVec(~K)}
      {==}

# a zipped box whose centers are within bb - rho and radii in [0, rho] has grade (bb, 1)
def gbox_zip($KH, cs: N.KVec(~K), rs: N.KVec(~K), +rho: @T, +bb: @T, hc: M.vbnd.all(~F, N.ofkv($KHA, cs), @S(bb, rho)), hn: FV.rnn(~F, N.ofkv($KHA, rs)), hr: M.vbnd.all(~F, N.ofkv($KHA, rs), rho), hl: {KA.klen(~K, cs) == KA.klen(~K, rs) : Nat}) -> BP.gbox($KHA, rho, bb, CK.zipb(~K, cs, rs)):
  match cs rs:
    case Nil{} Nil{}:
      Unit{}
    case Nil{} Con{r, rt}:
      FO.absurd(BP.gbox($KHA, rho, bb, CK.zipb(~K, Nil{}, Con{r, rt})), FV.zero_ne(KA.klen(~K, rt), hl))
    case Con{c, ct} Nil{}:
      FO.absurd(BP.gbox($KHA, rho, bb, CK.zipb(~K, Con{c, ct}, Nil{})), FV.succ_ne(KA.klen(~K, ct), hl))
    case Con{+c, +ct} Con{+r, +rt}:
      (hc1, hc2) = hc
      (hn1, hn2) = hn
      (hr1, hr2) = hr
      +hrl = NP.bnd_lo(~F, @H(r), rho, hr1)
      ((hn1, (FM.bnd_mono(~F, @H(c), @S(bb, rho), @S(bb, @H(r)), hc1, FM.nn_eq(~F, @S(@S(bb, @H(r)), @S(bb, rho)), @S(rho, @H(r)), FR.fring_eq(~F, [bb, rho, @H(r)], E.ZSub{E.ZVar{1n}, E.ZVar{2n}}, E.ZSub{E.ZSub{E.ZVar{0n}, E.ZVar{2n}}, E.ZSub{E.ZVar{0n}, E.ZVar{1n}}}, {==}), FM.sub_nonneg(~F, @H(r), rho, hrl))), DM.le_trans(~F, @H(r), rho, @M(@1, rho), hrl, AP.le_one_mul(~F, rho)))),
       gbox_zip($KHA, ct, rt, rho, bb, hc2, hn2, hr2, FV.succ_inj(KA.klen(~K, ct), KA.klen(~K, rt), hl)))

# Slope radii over a graded box
# -----------------------------

def bnd_of01(~F: O.OField, +x: @T, +t: @T, +h0: O.le(~F, @0, x), +h1: O.le(~F, x, t)) -> M.bnd(~F, x, t):
  (FM.sub_nonneg(~F, x, t, h1), FO.nonneg_add(~F, t, x, DM.le_trans(~F, @0, x, t, h0, h1), h0))

def srad_cons($KH, +x: @T, +t: M.Vec(~F), +s: @T, +hb: M.bnd(~F, x, s), +h0: O.le(~F, @0, x), h: M.Both(M.vbnd.all(~F, t, s), FV.rnn(~F, t))) -> M.Both(M.vbnd.all(~F, Con{x, t}, s), FV.rnn(~F, Con{x, t})):
  (h1, h2) = h
  ((hb, h1), (h0, h2))

# one equation's slope radii: in [0, lam rho]
def srad_row($KH, +rho: @T, +bb: @T, +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +box: List<&2, KB.KB<K>>, +hg: BP.gbox($KHA, rho, bb, box), +e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}, +lam: @T, +hl: O.le(~F, BP.ls(~F, bb, e), lam), +hl0: O.le(~F, @0, lam), cnt: Nat, +lo: Nat) -> M.Both(M.vbnd.all(~F, N.ofkv($KHA, KB.bradii(~K, KB.krange(~K, box, e, cnt, lo))), @M(lam, rho)), FV.rnn(~F, N.ofkv($KHA, KB.bradii(~K, KB.krange(~K, box, e, cnt, lo))))):
  match cnt:
    case 0n:
      (Unit{}, Unit{})
    case 1n++k:
      +g = BP.ksl_grade($KHA, rho, bb, hr, hb, box, hg, lo, e, hh)
      +r0 = BP.gf_0(~F, rho, @H(KB.KB.c(K, KB.ksl(~K, lo, box, e))), @H(KB.KB.r(K, KB.ksl(~K, lo, box, e))), BP.ms(~F, bb, e), BP.ls(~F, bb, e), g)
      +r1 = DM.le_trans(~F, @H(KB.KB.r(K, KB.ksl(~K, lo, box, e))), @M(BP.ls(~F, bb, e), rho), @M(lam, rho), BP.gf_l(~F, rho, @H(KB.KB.c(K, KB.ksl(~K, lo, box, e))), @H(KB.KB.r(K, KB.ksl(~K, lo, box, e))), BP.ms(~F, bb, e), BP.ls(~F, bb, e), g), FV.mul_le_r(~F, BP.ls(~F, bb, e), lam, rho, hr, hl))
      srad_cons($KHA, @H(KB.KB.r(K, KB.ksl(~K, lo, box, e))), N.ofkv($KHA, KB.bradii(~K, KB.krange(~K, box, e, k, 1n+lo))), @M(lam, rho), bnd_of01(~F, @H(KB.KB.r(K, KB.ksl(~K, lo, box, e))), @M(lam, rho), r0, r1), r0, srad_row($KHA, rho, bb, hr, hb, box, hg, e, hh, lam, hl, hl0, k, 1n+lo))

def srad_mcons($KH, +r: M.Vec(~F), +t: M.Mat(~F), +cnt: Nat, +c: @T, +hr: O.le(~F, NP.rowabs(~F, r, cnt), c), +hn: FV.rnn(~F, r), h: M.Both(NP.rowsle(~F, t, cnt, c), FV.mnn(~F, t))) -> M.Both(NP.rowsle(~F, Con{r, t}, cnt, c), FV.mnn(~F, Con{r, t})):
  (h1, h2) = h
  ((hr, h1), (hn, h2))

# the slope radius matrix: rows sum to at most cnt lam rho, entries >= 0
def srad_mat($KH, +rho: @T, +bb: @T, +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +box: List<&2, KB.KB<K>>, +hg: BP.gbox($KHA, rho, bb, box), +lam: @T, +ms: @T, +hl0: O.le(~F, @0, lam), eqs: List<&2, E.QExpr>, +hq: AP.eqok(~F, bb, lam, ms, eqs), +hh: {CK.allheld(~K, eqs) == True{} : Bool}, +cnt: Nat, +lo: Nat) -> M.Both(NP.rowsle(~F, N.ofkm($KHA, CK.mradii(~K, CK.srows(~K, box, cnt, lo, eqs))), cnt, @M(FR.ofn(~F, cnt), @M(lam, rho))), FV.mnn(~F, N.ofkm($KHA, CK.mradii(~K, CK.srows(~K, box, cnt, lo, eqs))))):
  match eqs:
    case Nil{}:
      (Unit{}, Unit{})
    case Con{+e, +es}:
      +he = KA.band_l(KB.held(~K, e), CK.allheld(~K, es), hh)
      +hes = KA.band_r(KB.held(~K, e), CK.allheld(~K, es), hh)
      +row = srad_row($KHA, rho, bb, hr, hb, box, hg, e, he, lam, AP.eqok_ls(~F, bb, lam, ms, e, es, hq), hl0, cnt, lo)
      srad_mcons($KHA, N.ofkv($KHA, KB.bradii(~K, KB.krange(~K, box, e, cnt, lo))), N.ofkm($KHA, CK.mradii(~K, CK.srows(~K, box, cnt, lo, es))), cnt, @M(FR.ofn(~F, cnt), @M(lam, rho)),
        DG.rowabs_le(~F, N.ofkv($KHA, KB.bradii(~K, KB.krange(~K, box, e, cnt, lo))), cnt, @M(lam, rho), AP.both_l(M.vbnd.all(~F, N.ofkv($KHA, KB.bradii(~K, KB.krange(~K, box, e, cnt, lo))), @M(lam, rho)), FV.rnn(~F, N.ofkv($KHA, KB.bradii(~K, KB.krange(~K, box, e, cnt, lo)))), row), FO.mul_nonneg(~F, lam, rho, hl0, hr)),
        AP.both_r(M.vbnd.all(~F, N.ofkv($KHA, KB.bradii(~K, KB.krange(~K, box, e, cnt, lo))), @M(lam, rho)), FV.rnn(~F, N.ofkv($KHA, KB.bradii(~K, KB.krange(~K, box, e, cnt, lo)))), row),
        srad_mat($KHA, rho, bb, hr, hb, box, hg, lam, ms, hl0, es, AP.eqok_tl(~F, bb, lam, ms, e, es, hq), hes, cnt, lo))

def srad_mn($KH, +rho: @T, +bb: @T, +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +box: List<&2, KB.KB<K>>, +hg: BP.gbox($KHA, rho, bb, box), +lam: @T, +ms: @T, +hl0: O.le(~F, @0, lam), +eqs: List<&2, E.QExpr>, +hq: AP.eqok(~F, bb, lam, ms, eqs), +hh: {CK.allheld(~K, eqs) == True{} : Bool}, +cnt: Nat, +lo: Nat) -> O.le(~F, NP.mnorm(~F, N.ofkm($KHA, CK.mradii(~K, CK.srows(~K, box, cnt, lo, eqs))), cnt), @M(FR.ofn(~F, cnt), @M(lam, rho))):
  NP.mnorm_lub(~F, N.ofkm($KHA, CK.mradii(~K, CK.srows(~K, box, cnt, lo, eqs))), cnt, @M(FR.ofn(~F, cnt), @M(lam, rho)), AP.both_l(NP.rowsle(~F, N.ofkm($KHA, CK.mradii(~K, CK.srows(~K, box, cnt, lo, eqs))), cnt, @M(FR.ofn(~F, cnt), @M(lam, rho))), FV.mnn(~F, N.ofkm($KHA, CK.mradii(~K, CK.srows(~K, box, cnt, lo, eqs)))), srad_mat($KHA, rho, bb, hr, hb, box, hg, lam, ms, hl0, eqs, hq, hh, cnt, lo)), AP.lr_nn(~F, cnt, lam, rho, hl0, hr))

# The checker's box
# -----------------
# CK.box(n, yc, yr, pc, pr): centers yc ++ pc, radii kfit(n, yr) ++ pr.

@MACRO PTC C.app(~F, M.ofdv(~F, yc), M.ofdv(~F, pc))

def klen_ckb($KH, +n: Nat, +yc: N.KVec(~K), +yr: N.KVec(~K), +pc: N.KVec(~K), +pr: N.KVec(~K), +lyc: {KA.klen(~K, yc) == n : Nat}, +lpp: {KA.klen(~K, pc) == KA.klen(~K, pr) : Nat}) -> {KA.klen(~K, KA.kapp(~K, yc, pc)) == KA.klen(~K, KA.kapp(~K, KA.kfit(~K, n, yr), pr)) : Nat}:
  %Equal.sym(Nat, KA.klen(~K, KA.kapp(~K, yc, pc)), Nat.add(KA.klen(~K, yc), KA.klen(~K, pc)), klen_app(~K, yc, pc)) : {_ == KA.klen(~K, KA.kapp(~K, KA.kfit(~K, n, yr), pr)) : Nat}
  %Equal.sym(Nat, KA.klen(~K, KA.kapp(~K, KA.kfit(~K, n, yr), pr)), Nat.add(KA.klen(~K, KA.kfit(~K, n, yr)), KA.klen(~K, pr)), klen_app(~K, KA.kfit(~K, n, yr), pr)) : {Nat.add(KA.klen(~K, yc), KA.klen(~K, pc)) == _ : Nat}
  %Equal.sym(Nat, KA.klen(~K, yc), n, lyc) : {Nat.add(_, KA.klen(~K, pc)) == Nat.add(KA.klen(~K, KA.kfit(~K, n, yr)), KA.klen(~K, pr)) : Nat}
  %Equal.sym(Nat, KA.klen(~K, KA.kfit(~K, n, yr)), n, CP.klen_kfit(~K, n, yr)) : {Nat.add(n, KA.klen(~K, pc)) == Nat.add(_, KA.klen(~K, pr)) : Nat}
  %Equal.sym(Nat, KA.klen(~K, pc), KA.klen(~K, pr), lpp) : {Nat.add(n, _) == Nat.add(n, KA.klen(~K, pr)) : Nat}
  {==}

# the box's centers are yc's point, whatever the radii
def cen_ckb(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +yc: List<&2, S.D>, +yr: List<&2, S.D>, +pc: List<&2, S.D>, +pr: List<&2, S.D>, +lyc: {KA.klen($DN, yc) == n : Nat}, +lpp: {KA.klen($DN, pc) == KA.klen($DN, pr) : Nat}) -> {BP.cen($DH, CK.box($DN, n, yc, yr, pc, pr)) == $PTC : M.Vec(~F)}:
  %Equal.sym(List<&2, S.D>, KB.bcenters($DN, CK.zipb($DN, KA.kapp($DN, yc, pc), KA.kapp($DN, KA.kfit($DN, n, yr), pr))), KA.kapp($DN, yc, pc), bcen_zipb($DN, KA.kapp($DN, yc, pc), KA.kapp($DN, KA.kfit($DN, n, yr), pr), klen_ckb($DH, n, yc, yr, pc, pr, lyc, lpp))) : {N.ofkv($DH, _) == $PTC : M.Vec(~F)}
  %Equal.sym(M.Vec(~F), N.ofkv($DH, KA.kapp($DN, yc, pc)), C.app(~F, N.ofkv($DH, yc), N.ofkv($DH, pc)), CP.kapp_ofk($DH, yc, pc)) : {_ == $PTC : M.Vec(~F)}
  %Equal.sym(M.Vec(~F), N.ofkv($DH, yc), M.ofdv(~F, yc), AP.ofkv_d(~F, ~H, yc)) : {C.app(~F, _, N.ofkv($DH, pc)) == $PTC : M.Vec(~F)}
  %Equal.sym(M.Vec(~F), N.ofkv($DH, pc), M.ofdv(~F, pc), AP.ofkv_d(~F, ~H, pc)) : {C.app(~F, M.ofdv(~F, yc), _) == $PTC : M.Vec(~F)}
  {==}

def ofkv_kapp_d(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +u: List<&2, S.D>, +w: List<&2, S.D>) -> {N.ofkv($DH, KA.kapp($DN, u, w)) == C.app(~F, M.ofdv(~F, u), M.ofdv(~F, w)) : M.Vec(~F)}:
  %Equal.sym(M.Vec(~F), N.ofkv($DH, KA.kapp($DN, u, w)), C.app(~F, N.ofkv($DH, u), N.ofkv($DH, w)), CP.kapp_ofk($DH, u, w)) : {_ == C.app(~F, M.ofdv(~F, u), M.ofdv(~F, w)) : M.Vec(~F)}
  %Equal.sym(M.Vec(~F), N.ofkv($DH, u), M.ofdv(~F, u), AP.ofkv_d(~F, ~H, u)) : {C.app(~F, _, N.ofkv($DH, w)) == C.app(~F, M.ofdv(~F, u), M.ofdv(~F, w)) : M.Vec(~F)}
  %Equal.sym(M.Vec(~F), N.ofkv($DH, w), M.ofdv(~F, w), AP.ofkv_d(~F, ~H, w)) : {C.app(~F, M.ofdv(~F, u), _) == C.app(~F, M.ofdv(~F, u), M.ofdv(~F, w)) : M.Vec(~F)}
  {==}

def rnn_app(~F: O.OField, u: M.Vec(~F), +w: M.Vec(~F), hu: FV.rnn(~F, u), hw: FV.rnn(~F, w)) -> FV.rnn(~F, C.app(~F, u, w)):
  match u:
    case Nil{}:
      hw
    case Con{+a, +us}:
      (h1, h2) = hu
      (h1, rnn_app(~F, us, w, h2, hw))

def klen_ckw(+n: Nat, +yc: List<&2, S.D>, +pc: List<&2, S.D>, +pr: List<&2, S.D>, +w: S.D, +lyc: {KA.klen($DN, yc) == n : Nat}, +lpp: {KA.klen($DN, pc) == KA.klen($DN, pr) : Nat}) -> {KA.klen($DN, KA.kapp($DN, yc, pc)) == KA.klen($DN, KA.kapp($DN, NU.dreps(n, w), pr)) : Nat}:
  %Equal.sym(Nat, KA.klen($DN, KA.kapp($DN, yc, pc)), Nat.add(KA.klen($DN, yc), KA.klen($DN, pc)), klen_app($DN, yc, pc)) : {_ == KA.klen($DN, KA.kapp($DN, NU.dreps(n, w), pr)) : Nat}
  %Equal.sym(Nat, KA.klen($DN, KA.kapp($DN, NU.dreps(n, w), pr)), Nat.add(KA.klen($DN, NU.dreps(n, w)), KA.klen($DN, pr)), klen_app($DN, NU.dreps(n, w), pr)) : {Nat.add(KA.klen($DN, yc), KA.klen($DN, pc)) == _ : Nat}
  %Equal.sym(Nat, KA.klen($DN, yc), n, lyc) : {Nat.add(_, KA.klen($DN, pc)) == Nat.add(KA.klen($DN, NU.dreps(n, w)), KA.klen($DN, pr)) : Nat}
  %Equal.sym(Nat, KA.klen($DN, NU.dreps(n, w)), n, klen_dreps(n, w)) : {Nat.add(n, KA.klen($DN, pc)) == Nat.add(_, KA.klen($DN, pr)) : Nat}
  %Equal.sym(Nat, KA.klen($DN, pc), KA.klen($DN, pr), lpp) : {Nat.add(n, _) == Nat.add(n, KA.klen($DN, pr)) : Nat}
  {==}

# the checker's box with unknowns' radii w has grade (bb, 1) at rb
def gbox_ckb(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +yc: List<&2, S.D>, +yr: List<&2, S.D>, +pc: List<&2, S.D>, +pr: List<&2, S.D>, +lyc: {KA.klen($DN, yc) == n : Nat}, +lpp: {KA.klen($DN, pc) == KA.klen($DN, pr) : Nat}, +w: S.D, +hyr: {KA.kfit($DN, n, yr) == NU.dreps(n, w) : List<&2, S.D>}, +rb: @T, +bb: @T, hc: M.vbnd.all(~F, $PTC, @S(bb, rb)), +hw0: O.le(~F, @0, M.ofd(~F, w)), +hw1: O.le(~F, M.ofd(~F, w), rb), hpn: FV.rnn(~F, M.ofdv(~F, pr)), hpr: M.vbnd.all(~F, M.ofdv(~F, pr), rb)) -> BP.gbox($DH, rb, bb, CK.box($DN, n, yc, yr, pc, pr)):
  %Equal.sym(List<&2, S.D>, KA.kfit($DN, n, yr), NU.dreps(n, w), hyr) : BP.gbox($DH, rb, bb, CK.zipb($DN, KA.kapp($DN, yc, pc), KA.kapp($DN, _, pr)))
  gbox_zip($DH, KA.kapp($DN, yc, pc), KA.kapp($DN, NU.dreps(n, w), pr), rb, bb,
    (%Equal.sym(M.Vec(~F), N.ofkv($DH, KA.kapp($DN, yc, pc)), C.app(~F, M.ofdv(~F, yc), M.ofdv(~F, pc)), ofkv_kapp_d(~F, ~H, yc, pc)) : M.vbnd.all(~F, _, @S(bb, rb))
      hc),
    (%Equal.sym(M.Vec(~F), N.ofkv($DH, KA.kapp($DN, NU.dreps(n, w), pr)), C.app(~F, M.ofdv(~F, NU.dreps(n, w)), M.ofdv(~F, pr)), ofkv_kapp_d(~F, ~H, NU.dreps(n, w), pr)) : FV.rnn(~F, _)
      (%Equal.sym(M.Vec(~F), M.ofdv(~F, NU.dreps(n, w)), frep(~F, n, M.ofd(~F, w)), ofdv_dreps(~F, n, w)) : FV.rnn(~F, C.app(~F, _, M.ofdv(~F, pr)))
        rnn_app(~F, frep(~F, n, M.ofd(~F, w)), M.ofdv(~F, pr), frep_nn(~F, n, M.ofd(~F, w), hw0), hpn))),
    (%Equal.sym(M.Vec(~F), N.ofkv($DH, KA.kapp($DN, NU.dreps(n, w), pr)), C.app(~F, M.ofdv(~F, NU.dreps(n, w)), M.ofdv(~F, pr)), ofkv_kapp_d(~F, ~H, NU.dreps(n, w), pr)) : M.vbnd.all(~F, _, rb)
      (%Equal.sym(M.Vec(~F), M.ofdv(~F, NU.dreps(n, w)), frep(~F, n, M.ofd(~F, w)), ofdv_dreps(~F, n, w)) : M.vbnd.all(~F, C.app(~F, _, M.ofdv(~F, pr)), rb)
        NW.vall_app(~F, frep(~F, n, M.ofd(~F, w)), M.ofdv(~F, pr), rb, NW.vall_le(~F, frep(~F, n, M.ofd(~F, w)), M.ofd(~F, w), rb, frep_all(~F, n, M.ofd(~F, w), hw0), hw1), hpr))),
    klen_ckw(n, yc, pc, pr, w, lyc, lpp))

# radius lists pairwise: 0 <= a <= b <= a + dl
def rpair($KH, +dl: @T, rs0: N.KVec(~K), rs1: N.KVec(~K)) -> Data:
  match rs0 rs1:
    case Nil{} Nil{}:
      Unit
    case Nil{} Con{b, t1}:
      Empty
    case Con{a, t0} Nil{}:
      Empty
    case Con{a, t0} Con{b, t1}:
      M.Both(pd(~F, dl, @H(a), @H(b), @1), rpair($KHA, dl, t0, t1))

def bpair_zip($KH, +dl: @T, cs: N.KVec(~K), rs0: N.KVec(~K), rs1: N.KVec(~K), hp: rpair($KHA, dl, rs0, rs1), hl: {KA.klen(~K, cs) == KA.klen(~K, rs0) : Nat}) -> bpair($KHA, dl, CK.zipb(~K, cs, rs0), CK.zipb(~K, cs, rs1)):
  match cs rs0 rs1:
    case Nil{} Nil{} Nil{}:
      Unit{}
    case Nil{} Nil{} Con{b, t1}:
      FO.absurd(bpair($KHA, dl, CK.zipb(~K, Nil{}, Nil{}), CK.zipb(~K, Nil{}, Con{b, t1})), hp)
    case Nil{} Con{a, t0} Nil{}:
      FO.absurd(bpair($KHA, dl, CK.zipb(~K, Nil{}, Con{a, t0}), CK.zipb(~K, Nil{}, Nil{})), hp)
    case Nil{} Con{a, t0} Con{b, t1}:
      FO.absurd(bpair($KHA, dl, CK.zipb(~K, Nil{}, Con{a, t0}), CK.zipb(~K, Nil{}, Con{b, t1})), FV.zero_ne(KA.klen(~K, t0), hl))
    case Con{c, ct} Nil{} Nil{}:
      FO.absurd(bpair($KHA, dl, CK.zipb(~K, Con{c, ct}, Nil{}), CK.zipb(~K, Con{c, ct}, Nil{})), FV.succ_ne(KA.klen(~K, ct), hl))
    case Con{c, ct} Nil{} Con{b, t1}:
      FO.absurd(bpair($KHA, dl, CK.zipb(~K, Con{c, ct}, Nil{}), CK.zipb(~K, Con{c, ct}, Con{b, t1})), FV.succ_ne(KA.klen(~K, ct), hl))
    case Con{c, ct} Con{a, t0} Nil{}:
      FO.absurd(bpair($KHA, dl, CK.zipb(~K, Con{c, ct}, Con{a, t0}), CK.zipb(~K, Con{c, ct}, Nil{})), hp)
    case Con{+c, +ct} Con{+a, +t0} Con{+b, +t1}:
      (h1, h2) = hp
      (h1, bpair_zip($KHA, dl, ct, t0, t1, h2, FV.succ_inj(KA.klen(~K, ct), KA.klen(~K, t0), hl)))

def rpair_app($KH, +dl: @T, u0: N.KVec(~K), u1: N.KVec(~K), +w: N.KVec(~K), hu: rpair($KHA, dl, u0, u1), hw: rpair($KHA, dl, w, w)) -> rpair($KHA, dl, KA.kapp(~K, u0, w), KA.kapp(~K, u1, w)):
  match u0 u1:
    case Nil{} Nil{}:
      hw
    case Nil{} Con{b, t1}:
      FO.absurd(rpair($KHA, dl, KA.kapp(~K, Nil{}, w), KA.kapp(~K, Con{b, t1}, w)), hu)
    case Con{a, t0} Nil{}:
      FO.absurd(rpair($KHA, dl, KA.kapp(~K, Con{a, t0}, w), KA.kapp(~K, Nil{}, w)), hu)
    case Con{+a, +t0} Con{+b, +t1}:
      (h1, h2) = hu
      (h1, rpair_app($KHA, dl, t0, t1, w, h2, hw))

def rpair_self($KH, +dl: @T, +hdl: O.le(~F, @0, dl), w: N.KVec(~K), hn: FV.rnn(~F, N.ofkv($KHA, w))) -> rpair($KHA, dl, w, w):
  match w:
    case Nil{}:
      Unit{}
    case Con{+a, +t}:
      (h1, h2) = hn
      (pd_one(~F, dl, @H(a), h1, hdl), rpair_self($KHA, dl, hdl, t, h2))

def pd_0r(~F: O.OField, +z: @T, +x: @T, ez: {z == @0 : @T}, +hx: O.le(~F, @0, x)) -> pd(~F, x, z, x, @1):
  %Equal.sym(@T, z, @0, ez) : pd(~F, x, _, x, @1)
  (FO.le_refl(~F, @0), (hx, FV.le_of_sub(~F, @S(x, @0), @M(@1, x), FM.nn_eq(~F, @S(@M(@1, x), @S(x, @0)), @0, FR.fring_eq(~F, [x], E.ZCst{S.Z0{}}, E.ZSub{E.ZMul{E.ZCst{S.Zpos{S.XH{}}}, E.ZVar{0n}}, E.ZSub{E.ZVar{0n}, E.ZCst{S.Z0{}}}}, {==}), FO.le_refl(~F, @0)))))

# zeros against r's: each within H r
def rpair_dreps(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, n: Nat, +r: S.D, +hr: O.le(~F, @0, N.emap(KI.dnum(), F, H, r))) -> rpair($DH, N.emap(KI.dnum(), F, H, r), NU.dreps(n, M.d0()), NU.dreps(n, r)):
  match n:
    case 0n:
      Unit{}
    case 1n+k:
      (pd_0r(~F, N.emap(KI.dnum(), F, H, M.d0()), N.emap(KI.dnum(), F, H, r), N.e_zero(KI.dnum(), F, H), hr), rpair_dreps(~F, ~H, k, r, hr))

# the checker's boxes at radius 0 and r pair up, with dl = H r
def bpair_ckb(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +yc: List<&2, S.D>, +pc: List<&2, S.D>, +pr: List<&2, S.D>, +lyc: {KA.klen($DN, yc) == n : Nat}, +lpp: {KA.klen($DN, pc) == KA.klen($DN, pr) : Nat}, +r: S.D, +hr: O.le(~F, @0, N.emap(KI.dnum(), F, H, r)), hpn: FV.rnn(~F, N.ofkv($DH, pr))) -> bpair($DH, N.emap(KI.dnum(), F, H, r), CK.box($DN, n, yc, Nil{}, pc, pr), CK.box($DN, n, yc, NU.dreps(n, r), pc, pr)):
  %Equal.sym(List<&2, S.D>, KA.kfit($DN, n, Nil{}), NU.dreps(n, M.d0()), kfit_nil(n)) : bpair($DH, N.emap(KI.dnum(), F, H, r), CK.zipb($DN, KA.kapp($DN, yc, pc), KA.kapp($DN, _, pr)), CK.box($DN, n, yc, NU.dreps(n, r), pc, pr))
  %Equal.sym(List<&2, S.D>, KA.kfit($DN, n, NU.dreps(n, r)), NU.dreps(n, r), kfit_dreps(n, r)) : bpair($DH, N.emap(KI.dnum(), F, H, r), CK.zipb($DN, KA.kapp($DN, yc, pc), KA.kapp($DN, NU.dreps(n, M.d0()), pr)), CK.zipb($DN, KA.kapp($DN, yc, pc), KA.kapp($DN, _, pr)))
  bpair_zip($DH, N.emap(KI.dnum(), F, H, r), KA.kapp($DN, yc, pc), KA.kapp($DN, NU.dreps(n, M.d0()), pr), KA.kapp($DN, NU.dreps(n, r), pr),
    rpair_app($DH, N.emap(KI.dnum(), F, H, r), NU.dreps(n, M.d0()), NU.dreps(n, r), pr, rpair_dreps(~F, ~H, n, r, hr), rpair_self($DH, N.emap(KI.dnum(), F, H, r), hr, pr, hpn)),
    klen_ckw(n, yc, pc, pr, M.d0(), lyc, lpp))

# The parameter slopes, |center| + radius, over the two boxes
# ------------------------------------------------------------
# Row k of the checker's |J0z| + Dz grows by at most ls dl, entry by entry.

def mzr($KH, +box: List<&2, KB.KB<K>>, +e: E.QExpr, +cnt: Nat, +lo: Nat) -> N.KVec(~K):
  KA.kvadd(~K, KA.kvabs(~K, KB.bcenters(~K, KB.krange(~K, box, e, cnt, lo))), KB.bradii(~K, KB.krange(~K, box, e, cnt, lo)))

def mz_ent($KH, +dl: @T, +l: @T, +c0: N.NC(K), +r0: N.NC(K), +c1: N.NC(K), +r1: N.NC(K), +ek: {@H(KA.kabs(~K, c0)) == @H(KA.kabs(~K, c1)) : @T}, +hp: pd(~F, dl, @H(r0), @H(r1), l)) -> M.bnd(~F, @S(@H(N.nadd(K, KA.kabs(~K, c1), r1)), @H(N.nadd(K, KA.kabs(~K, c0), r0))), @M(l, dl)):
  %KA.ea($KHA, KA.kabs(~K, c1), r1) : M.bnd(~F, @S(_, @H(N.nadd(K, KA.kabs(~K, c0), r0))), @M(l, dl))
  %KA.ea($KHA, KA.kabs(~K, c0), r0) : M.bnd(~F, @S(@A(@H(KA.kabs(~K, c1)), @H(r1)), _), @M(l, dl))
  %Equal.sym(@T, @H(KA.kabs(~K, c0)), @H(KA.kabs(~K, c1)), ek) : M.bnd(~F, @S(@A(@H(KA.kabs(~K, c1)), @H(r1)), @A(_, @H(r0))), @M(l, dl))
  KB.bnd_val(~F, @S(@H(r1), @H(r0)), @S(@A(@H(KA.kabs(~K, c1)), @H(r1)), @A(@H(KA.kabs(~K, c1)), @H(r0))), @M(l, dl), FR.fring_eq(~F, [@H(KA.kabs(~K, c1)), @H(r0), @H(r1)], E.ZSub{E.ZVar{2n}, E.ZVar{1n}}, E.ZSub{E.ZAdd{E.ZVar{0n}, E.ZVar{2n}}, E.ZAdd{E.ZVar{0n}, E.ZVar{1n}}}, {==}),
    bnd_of01(~F, @S(@H(r1), @H(r0)), @M(l, dl), FM.sub_nonneg(~F, @H(r0), @H(r1), pd_1(~F, dl, @H(r0), @H(r1), l, hp)), pd_2(~F, dl, @H(r0), @H(r1), l, hp)))

def mz_row($KH, $PBP, +e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}, cnt: Nat, +lo: Nat) -> M.vbnd.all(~F, BX.vsub(~F, N.ofkv($KHA, mzr($KHA, b1, e, cnt, lo)), N.ofkv($KHA, mzr($KHA, b0, e, cnt, lo))), @M(BP.ls(~F, bb, e), dl)):
  match cnt:
    case 0n:
      Unit{}
    case 1n++k:
      (mz_ent($KHA, dl, BP.ls(~F, bb, e), KB.KB.c(K, KB.ksl(~K, lo, b0, e)), KB.KB.r(K, KB.ksl(~K, lo, b0, e)), KB.KB.c(K, KB.ksl(~K, lo, b1, e)), KB.KB.r(K, KB.ksl(~K, lo, b1, e)), sc_eq($KHA, b0, b1, hcen, lo, e, hh), ks_pd($KHA, $PBA, lo, e, hh)),
       mz_row($KHA, $PBA, e, hh, k, 1n+lo))

def mzm($KH, +box: List<&2, KB.KB<K>>, +cnt: Nat, +lo: Nat, +eqs: List<&2, E.QExpr>) -> N.KMat(~K):
  KA.kmadd(~K, KA.kmabs(~K, CK.mcenters(~K, CK.srows(~K, box, cnt, lo, eqs))), CK.mradii(~K, CK.srows(~K, box, cnt, lo, eqs)))

def mz_rows($KH, $PBP, +lam: @T, +ms: @T, +hl0: O.le(~F, @0, lam), eqs: List<&2, E.QExpr>, +hq: AP.eqok(~F, bb, lam, ms, eqs), +hh: {CK.allheld(~K, eqs) == True{} : Bool}, +cnt: Nat, +lo: Nat) -> NP.rowsle(~F, M.madd(~F, N.ofkm($KHA, mzm($KHA, b1, cnt, lo, eqs)), M.mneg(~F, N.ofkm($KHA, mzm($KHA, b0, cnt, lo, eqs)))), cnt, @M(FR.ofn(~F, cnt), @M(lam, dl))):
  match eqs:
    case Nil{}:
      Unit{}
    case Con{+e, +es}:
      +he = KA.band_l(KB.held(~K, e), CK.allheld(~K, es), hh)
      +hes = KA.band_r(KB.held(~K, e), CK.allheld(~K, es), hh)
      (DG.rowabs_le(~F, BX.vsub(~F, N.ofkv($KHA, mzr($KHA, b1, e, cnt, lo)), N.ofkv($KHA, mzr($KHA, b0, e, cnt, lo))), cnt, @M(lam, dl),
         NW.vall_le(~F, BX.vsub(~F, N.ofkv($KHA, mzr($KHA, b1, e, cnt, lo)), N.ofkv($KHA, mzr($KHA, b0, e, cnt, lo))), @M(BP.ls(~F, bb, e), dl), @M(lam, dl), mz_row($KHA, $PBA, e, he, cnt, lo), FV.mul_le_r(~F, BP.ls(~F, bb, e), lam, dl, hdl, AP.eqok_ls(~F, bb, lam, ms, e, es, hq))),
         FO.mul_nonneg(~F, lam, dl, hl0, hdl)),
       mz_rows($KHA, $PBA, lam, ms, hl0, es, AP.eqok_tl(~F, bb, lam, ms, e, es, hq), hes, cnt, lo))

# |(|J0z| + Dz)(box1) - (|J0z| + Dz)(box0)| <= cnt lam dl
def mz_mn($KH, $PBP, +lam: @T, +ms: @T, +hl0: O.le(~F, @0, lam), +eqs: List<&2, E.QExpr>, +hq: AP.eqok(~F, bb, lam, ms, eqs), +hh: {CK.allheld(~K, eqs) == True{} : Bool}, +cnt: Nat, +lo: Nat) -> O.le(~F, NP.mnorm(~F, M.madd(~F, N.ofkm($KHA, mzm($KHA, b1, cnt, lo, eqs)), M.mneg(~F, N.ofkm($KHA, mzm($KHA, b0, cnt, lo, eqs)))), cnt), @M(FR.ofn(~F, cnt), @M(lam, dl))):
  NP.mnorm_lub(~F, M.madd(~F, N.ofkm($KHA, mzm($KHA, b1, cnt, lo, eqs)), M.mneg(~F, N.ofkm($KHA, mzm($KHA, b0, cnt, lo, eqs)))), cnt, @M(FR.ofn(~F, cnt), @M(lam, dl)), mz_rows($KHA, $PBA, lam, ms, hl0, eqs, hq, hh, cnt, lo), AP.lr_nn(~F, cnt, lam, dl, hl0, hdl))

# K's |M| entrywise has F norm at most M's
# -----------------------------------------

def kabs_ent($KH, +x: N.NC(K)) -> O.le(~F, FV.fabs(~F, @H(KA.kabs(~K, x))), FV.fabs(~F, @H(x))):
  FV.fabs_le(~F, @H(KA.kabs(~K, x)), FV.fabs(~F, @H(x)),
    (%Equal.sym(@T, @H(KA.kabs(~K, x)), FV.fabs(~F, @H(x)), kabs_eq($KHA, x)) : M.bnd(~F, _, FV.fabs(~F, @H(x)))
      FV.bnd_self(~F, FV.fabs(~F, @H(x)), FV.fabs_nn(~F, @H(x)))))

def kabs_row($KH, r: N.KVec(~K), n: Nat) -> O.le(~F, NP.rowabs(~F, N.ofkv($KHA, KA.kvabs(~K, r)), n), NP.rowabs(~F, N.ofkv($KHA, r), n)):
  match r n:
    case Nil{} 0n:
      FO.le_refl(~F, @0)
    case Nil{} 1n++k:
      FO.le_refl(~F, @0)
    case Con{+x, +t} 0n:
      FO.le_refl(~F, @0)
    case Con{+x, +t} 1n++k:
      RP.le_add2(~F, FV.fabs(~F, @H(KA.kabs(~K, x))), FV.fabs(~F, @H(x)), NP.rowabs(~F, N.ofkv($KHA, KA.kvabs(~K, t)), k), NP.rowabs(~F, N.ofkv($KHA, t), k), kabs_ent($KHA, x), kabs_row($KHA, t, k))

def kabs_rows($KH, a: N.KMat(~K), +n: Nat, +c: @T, +hc: O.le(~F, NP.mnorm(~F, N.ofkm($KHA, a), n), c)) -> NP.rowsle(~F, N.ofkm($KHA, KA.kmabs(~K, a)), n, c):
  match a:
    case Nil{}:
      Unit{}
    case Con{+r, +t}:
      (DM.le_trans(~F, NP.rowabs(~F, N.ofkv($KHA, KA.kvabs(~K, r)), n), NP.rowabs(~F, N.ofkv($KHA, r), n), c, kabs_row($KHA, r, n), DM.le_trans(~F, NP.rowabs(~F, N.ofkv($KHA, r), n), NP.mnorm(~F, N.ofkm($KHA, Con{r, t}), n), c, AP.mnorm_ge_r(~F, N.ofkv($KHA, r), N.ofkm($KHA, t), n), hc)),
       kabs_rows($KHA, t, n, c, DM.le_trans(~F, NP.mnorm(~F, N.ofkm($KHA, t), n), NP.mnorm(~F, N.ofkm($KHA, Con{r, t}), n), c, AP.mnorm_ge_t(~F, N.ofkv($KHA, r), N.ofkm($KHA, t), n), hc)))

def kabs_mn($KH, +a: N.KMat(~K), +n: Nat, +c: @T, +hc0: O.le(~F, @0, c), +hc: O.le(~F, NP.mnorm(~F, N.ofkm($KHA, a), n), c)) -> O.le(~F, NP.mnorm(~F, N.ofkm($KHA, KA.kmabs(~K, a)), n), c):
  NP.mnorm_lub(~F, N.ofkm($KHA, KA.kmabs(~K, a)), n, c, kabs_rows($KHA, a, n, c, hc), hc0)

# the checker's I - A B in F
def ofkm_imm($KH, +n: Nat, +a: N.KMat(~K), +b: N.KMat(~K)) -> {N.ofkm($KHA, CK.imm(~K, n, a, b)) == M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, N.ofkm($KHA, a), N.ofkm($KHA, b)))) : M.Mat(~F)}:
  %KA.kmadd_ofk($KHA, KA.kident(~K, n), KA.kmneg(~K, KA.kmatmul(~K, a, b))) : {_ == M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, N.ofkm($KHA, a), N.ofkm($KHA, b)))) : M.Mat(~F)}
  %KA.kident_ofk($KHA, n) : {M.madd(~F, _, N.ofkm($KHA, KA.kmneg(~K, KA.kmatmul(~K, a, b)))) == M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, N.ofkm($KHA, a), N.ofkm($KHA, b)))) : M.Mat(~F)}
  %KA.kmneg_ofk($KHA, KA.kmatmul(~K, a, b)) : {M.madd(~F, M.ident(~F, n), _) == M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, N.ofkm($KHA, a), N.ofkm($KHA, b)))) : M.Mat(~F)}
  %KA.kmatmul_ofk($KHA, a, b) : {M.madd(~F, M.ident(~F, n), M.mneg(~F, _)) == M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, N.ofkm($KHA, a), N.ofkm($KHA, b)))) : M.Mat(~F)}
  {==}

# The window
# ----------
# Every radius r with 2S <= r and r + rho <= rb passes the checker, given
# |Y| <= yn, |I - Y Jc| <= thL, |I - Jc Y| <= thR < 1 and the smallness
# thL + yn n lam rb + yn m lam rho <= 1/2 (S the largest entry of the
# self-map bound at radius 0).

@MACRO WXP ~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +eqs: List<&2, E.QExpr>, +hn: {CK.eqlen(eqs) == n : Nat}, +hh: {CK.allheld($DN, eqs) == True{} : Bool}, +yc: List<&2, S.D>, +pc: List<&2, S.D>, +pr: List<&2, S.D>, +lyc: {KA.klen($DN, yc) == n : Nat}, +lpp: {KA.klen($DN, pc) == KA.klen($DN, pr) : Nat}, +ym: List<&2, List<&2, S.D>>, +bb: @T, +lam: @T, +ms: @T, +rb: @T, +hb: O.le(~F, @0, bb), +hl0: O.le(~F, @0, lam), +hrb: O.le(~F, @0, rb), +hq: AP.eqok(~F, bb, lam, ms, eqs), +hc: M.vbnd.all(~F, $PTC, @S(bb, rb)), +hpn: FV.rnn(~F, M.ofdv(~F, pr)), +hpr: M.vbnd.all(~F, M.ofdv(~F, pr), rb), +yn: @T, +thL: @T, +hyn: O.le(~F, NP.mnorm(~F, M.ofdm(~F, ym), n), yn), +hthl: O.le(~F, NP.mnorm(~F, M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, M.ofdm(~F, ym), NW.jc(~F, eqs, n, $PTC)))), n), thL), +hyn0: O.le(~F, @0, yn), +hthl0: O.le(~F, @0, thL)
@MACRO WXA ~F, ~H, n, eqs, hn, hh, yc, pc, pr, lyc, lpp, ym, bb, lam, ms, rb, hb, hl0, hrb, hq, hc, hpn, hpr, yn, thL, hyn, hthl, hyn0, hthl0

def nrows_srm($KH, +box: List<&2, KB.KB<K>>, +cnt: Nat, +lo: Nat, eqs: List<&2, E.QExpr>) -> {GJ.nrows(~F, N.ofkm($KHA, CK.mradii(~K, CK.srows(~K, box, cnt, lo, eqs)))) == CK.eqlen(eqs) : Nat}:
  match eqs:
    case Nil{}:
      {==}
    case Con{e, es}:
      %Equal.sym(Nat, GJ.nrows(~F, N.ofkm($KHA, CK.mradii(~K, CK.srows(~K, box, cnt, lo, es)))), CK.eqlen(es), nrows_srm($KHA, box, cnt, lo, es)) : {1n+_ == 1n+CK.eqlen(es) : Nat}
      {==}

def rf_eq(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +r: S.D) -> {N.ofkv($DH, NU.dreps(n, r)) == frep(~F, n, M.ofd(~F, r)) : M.Vec(~F)}:
  Equal.trans(M.Vec(~F), N.ofkv($DH, NU.dreps(n, r)), M.ofdv(~F, NU.dreps(n, r)), frep(~F, n, M.ofd(~F, r)), AP.ofkv_d(~F, ~H, NU.dreps(n, r)), ofdv_dreps(~F, n, r))

def lrf(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +r: S.D) -> {M.len(~F, N.ofkv($DH, NU.dreps(n, r))) == n : Nat}:
  %Equal.sym(M.Vec(~F), N.ofkv($DH, NU.dreps(n, r)), frep(~F, n, M.ofd(~F, r)), rf_eq(~F, ~H, n, r)) : {M.len(~F, _) == n : Nat}
  len_frep(~F, n, M.ofd(~F, r))

def vnrf(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +r: S.D, +hr0: O.le(~F, @0, M.ofd(~F, r))) -> O.le(~F, NP.vn(~F, N.ofkv($DH, NU.dreps(n, r))), M.ofd(~F, r)):
  %Equal.sym(M.Vec(~F), N.ofkv($DH, NU.dreps(n, r)), frep(~F, n, M.ofd(~F, r)), rf_eq(~F, ~H, n, r)) : O.le(~F, NP.vn(~F, _), M.ofd(~F, r))
  vn_frep(~F, n, M.ofd(~F, r), hr0)

# the checker's Jacobian centers at its box: Jc
def jc_ckb($WXP, +yr: List<&2, S.D>) -> {N.ofkm($DH, CK.mcenters($DN, CK.rowsy($DN, eqs, n, yc, yr, pc, pr))) == NW.jc(~F, eqs, n, $PTC) : M.Mat(~F)}:
  %cen_ckb(~F, ~H, n, yc, yr, pc, pr, lyc, lpp) : {N.ofkm($DH, CK.mcenters($DN, CK.rowsy($DN, eqs, n, yc, yr, pc, pr))) == DV.jac(~F, _, eqs, ST.iota(n, 0n)) : M.Mat(~F)}
  BP.mcen_jac($DH, CK.box($DN, n, yc, yr, pc, pr), n, 0n, eqs, hh)

# |I - Y J0y| in the checker's numbers is at most thL
def imm_mn($WXP, +yr: List<&2, S.D>) -> O.le(~F, NP.mnorm(~F, N.ofkm($DH, CK.imm($DN, n, ym, CK.mcenters($DN, CK.rowsy($DN, eqs, n, yc, yr, pc, pr)))), n), thL):
  %Equal.sym(M.Mat(~F), N.ofkm($DH, CK.imm($DN, n, ym, CK.mcenters($DN, CK.rowsy($DN, eqs, n, yc, yr, pc, pr)))), M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, N.ofkm($DH, ym), N.ofkm($DH, CK.mcenters($DN, CK.rowsy($DN, eqs, n, yc, yr, pc, pr)))))), ofkm_imm($DH, n, ym, CK.mcenters($DN, CK.rowsy($DN, eqs, n, yc, yr, pc, pr)))) : O.le(~F, NP.mnorm(~F, _, n), thL)
  %Equal.sym(M.Mat(~F), N.ofkm($DH, ym), M.ofdm(~F, ym), AP.ofkm_d(~F, ~H, ym)) : O.le(~F, NP.mnorm(~F, M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, _, N.ofkm($DH, CK.mcenters($DN, CK.rowsy($DN, eqs, n, yc, yr, pc, pr)))))), n), thL)
  %Equal.sym(M.Mat(~F), N.ofkm($DH, CK.mcenters($DN, CK.rowsy($DN, eqs, n, yc, yr, pc, pr))), NW.jc(~F, eqs, n, $PTC), jc_ckb($WXA, yr)) : O.le(~F, NP.mnorm(~F, M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, M.ofdm(~F, ym), _))), n), thL)
  hthl

def ym_mn($WXP) -> O.le(~F, NP.mnorm(~F, N.ofkm($DH, KA.kmabs($DN, ym)), n), yn):
  kabs_mn($DH, ym, n, yn, hyn0, (%Equal.sym(M.Mat(~F), N.ofkm($DH, ym), M.ofdm(~F, ym), AP.ofkm_d(~F, ~H, ym)) : O.le(~F, NP.mnorm(~F, _, n), yn)
    hyn))

# the contraction vector at radius r: |g| <= thL r + yn n lam rb r
def gvec_bnd($WXP, +r: S.D, +hr0: O.le(~F, @0, M.ofd(~F, r)), +hr1: O.le(~F, M.ofd(~F, r), rb)) -> O.le(~F, NP.vn(~F, N.ofkv($DH, CK.gvec($DN, eqs, n, yc, NU.dreps(n, r), ym, pc, pr))), @A(@M(thL, M.ofd(~F, r)), @M(yn, @M(@M(FR.ofn(~F, n), @M(lam, rb)), M.ofd(~F, r))))):
  +yrr = NU.dreps(n, r)
  +rF = N.ofkv($DH, yrr)
  +aK = CK.imm($DN, n, ym, CK.mcenters($DN, CK.rowsy($DN, eqs, n, yc, yrr, pc, pr)))
  +dK = CK.mradii($DN, CK.rowsy($DN, eqs, n, yc, yrr, pc, pr))
  +pP = M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, aK)), rF)
  +qQ = M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, ym)), M.matvec(~F, N.ofkm($DH, dK), rF))
  +ldk = Equal.trans(Nat, M.len(~F, M.matvec(~F, N.ofkm($DH, dK), rF)), GJ.nrows(~F, N.ofkm($DH, dK)), n, Equal.sym(Nat, GJ.nrows(~F, N.ofkm($DH, dK)), M.len(~F, M.matvec(~F, N.ofkm($DH, dK), rF)), GJ.len_matvec(~F, N.ofkm($DH, dK), rF)), Equal.trans(Nat, GJ.nrows(~F, N.ofkm($DH, dK)), CK.eqlen(eqs), n, nrows_srm($DH, CK.box($DN, n, yc, yrr, pc, pr), n, 0n, eqs), hn))
  +gb = gbox_ckb(~F, ~H, n, yc, yrr, pc, pr, lyc, lpp, r, kfit_dreps(n, r), rb, bb, hc, hr0, hr1, hpn, hpr)
  %Equal.sym(M.Vec(~F), N.ofkv($DH, CK.gvec($DN, eqs, n, yc, yrr, ym, pc, pr)), M.vadd(~F, pP, qQ), CP.gF_ok($DH, eqs, n, yc, yrr, ym, pc, pr)) : O.le(~F, NP.vn(~F, _), @A(@M(thL, M.ofd(~F, r)), @M(yn, @M(@M(FR.ofn(~F, n), @M(lam, rb)), M.ofd(~F, r)))))
  DM.le_trans(~F, NP.vn(~F, M.vadd(~F, pP, qQ)), @A(NP.vn(~F, pP), NP.vn(~F, qQ)), @A(@M(thL, M.ofd(~F, r)), @M(yn, @M(@M(FR.ofn(~F, n), @M(lam, rb)), M.ofd(~F, r)))),
    AP.vn_add(~F, pP, qQ),
    RP.le_add2(~F, NP.vn(~F, pP), @M(thL, M.ofd(~F, r)), NP.vn(~F, qQ), @M(yn, @M(@M(FR.ofn(~F, n), @M(lam, rb)), M.ofd(~F, r))),
      DM.le_trans(~F, NP.vn(~F, pP), @M(NP.mnorm(~F, N.ofkm($DH, KA.kmabs($DN, aK)), n), NP.vn(~F, rF)), @M(thL, M.ofd(~F, r)), NP.mv_n(~F, N.ofkm($DH, KA.kmabs($DN, aK)), n, rF, lrf(~F, ~H, n, r)),
        NW.mm_le(~F, NP.mnorm(~F, N.ofkm($DH, KA.kmabs($DN, aK)), n), thL, NP.vn(~F, rF), M.ofd(~F, r), FV.vmax_nn(~F, rF), hthl0, kabs_mn($DH, aK, n, thL, hthl0, imm_mn($WXA, yrr)), vnrf(~F, ~H, n, r, hr0))),
      DM.le_trans(~F, NP.vn(~F, qQ), @M(NP.mnorm(~F, N.ofkm($DH, KA.kmabs($DN, ym)), n), NP.vn(~F, M.matvec(~F, N.ofkm($DH, dK), rF))), @M(yn, @M(@M(FR.ofn(~F, n), @M(lam, rb)), M.ofd(~F, r))), NP.mv_n(~F, N.ofkm($DH, KA.kmabs($DN, ym)), n, M.matvec(~F, N.ofkm($DH, dK), rF), ldk),
        NW.mm_le(~F, NP.mnorm(~F, N.ofkm($DH, KA.kmabs($DN, ym)), n), yn, NP.vn(~F, M.matvec(~F, N.ofkm($DH, dK), rF)), @M(@M(FR.ofn(~F, n), @M(lam, rb)), M.ofd(~F, r)), FV.vmax_nn(~F, M.matvec(~F, N.ofkm($DH, dK), rF)), hyn0, ym_mn($WXA),
          DM.le_trans(~F, NP.vn(~F, M.matvec(~F, N.ofkm($DH, dK), rF)), @M(NP.mnorm(~F, N.ofkm($DH, dK), n), NP.vn(~F, rF)), @M(@M(FR.ofn(~F, n), @M(lam, rb)), M.ofd(~F, r)), NP.mv_n(~F, N.ofkm($DH, dK), n, rF, lrf(~F, ~H, n, r)),
            NW.mm_le(~F, NP.mnorm(~F, N.ofkm($DH, dK), n), @M(FR.ofn(~F, n), @M(lam, rb)), NP.vn(~F, rF), M.ofd(~F, r), FV.vmax_nn(~F, rF), AP.lr_nn(~F, n, lam, rb, hl0, hrb), srad_mn($DH, rb, bb, hrb, hb, CK.box($DN, n, yc, yrr, pc, pr), gb, lam, ms, hl0, eqs, hq, hh, n, 0n), vnrf(~F, ~H, n, r, hr0)))))))

# Lengths
# -------

def klen_kvadd(~K: N.Num, u: N.KVec(~K), w: N.KVec(~K), +n: Nat, hu: {KA.klen(~K, u) == n : Nat}, hw: {KA.klen(~K, w) == n : Nat}) -> {KA.klen(~K, KA.kvadd(~K, u, w)) == n : Nat}:
  match u w n:
    case Nil{} w n:
      hw
    case Con{a, us} Nil{} n:
      hu
    case Con{+a, +us} Con{+b, +ws} 0n:
      FO.absurd({KA.klen(~K, KA.kvadd(~K, Con{a, us}, Con{b, ws})) == 0n : Nat}, FV.succ_ne(KA.klen(~K, us), hu))
    case Con{+a, +us} Con{+b, +ws} 1n++k:
      %Equal.sym(Nat, KA.klen(~K, KA.kvadd(~K, us, ws)), k, klen_kvadd(~K, us, ws, k, FV.succ_inj(KA.klen(~K, us), k, hu), FV.succ_inj(KA.klen(~K, ws), k, hw))) : {1n+_ == 1n+k : Nat}
      {==}

def klen_kmatvec(~K: N.Num, a: N.KMat(~K), +v: N.KVec(~K)) -> {KA.klen(~K, KA.kmatvec(~K, a, v)) == CK.mlen(~K, a) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{r, rs}:
      %Equal.sym(Nat, KA.klen(~K, KA.kmatvec(~K, rs, v)), CK.mlen(~K, rs), klen_kmatvec(~K, rs, v)) : {1n+_ == 1n+CK.mlen(~K, rs) : Nat}
      {==}

def klen_kvabs(~K: N.Num, u: N.KVec(~K)) -> {KA.klen(~K, KA.kvabs(~K, u)) == KA.klen(~K, u) : Nat}:
  match u:
    case Nil{}:
      {==}
    case Con{a, us}:
      %Equal.sym(Nat, KA.klen(~K, KA.kvabs(~K, us)), KA.klen(~K, us), klen_kvabs(~K, us)) : {1n+_ == 1n+KA.klen(~K, us) : Nat}
      {==}

def mlen_kmabs(~K: N.Num, a: N.KMat(~K)) -> {CK.mlen(~K, KA.kmabs(~K, a)) == CK.mlen(~K, a) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{r, rs}:
      %Equal.sym(Nat, CK.mlen(~K, KA.kmabs(~K, rs)), CK.mlen(~K, rs), mlen_kmabs(~K, rs)) : {1n+_ == 1n+CK.mlen(~K, rs) : Nat}
      {==}

def mlen_kmneg(~K: N.Num, a: N.KMat(~K)) -> {CK.mlen(~K, KA.kmneg(~K, a)) == CK.mlen(~K, a) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{r, rs}:
      %Equal.sym(Nat, CK.mlen(~K, KA.kmneg(~K, rs)), CK.mlen(~K, rs), mlen_kmneg(~K, rs)) : {1n+_ == 1n+CK.mlen(~K, rs) : Nat}
      {==}

def mlen_kmatmul(~K: N.Num, a: N.KMat(~K), +b: N.KMat(~K)) -> {CK.mlen(~K, KA.kmatmul(~K, a, b)) == CK.mlen(~K, a) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{r, rs}:
      %Equal.sym(Nat, CK.mlen(~K, KA.kmatmul(~K, rs, b)), CK.mlen(~K, rs), mlen_kmatmul(~K, rs, b)) : {1n+_ == 1n+CK.mlen(~K, rs) : Nat}
      {==}

def mlen_kshift(~K: N.Num, a: N.KMat(~K)) -> {CK.mlen(~K, KA.kshift(~K, a)) == CK.mlen(~K, a) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{r, rs}:
      %Equal.sym(Nat, CK.mlen(~K, KA.kshift(~K, rs)), CK.mlen(~K, rs), mlen_kshift(~K, rs)) : {1n+_ == 1n+CK.mlen(~K, rs) : Nat}
      {==}

def mlen_kident(~K: N.Num, n: Nat) -> {CK.mlen(~K, KA.kident(~K, n)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n++k:
      %Equal.sym(Nat, CK.mlen(~K, KA.kshift(~K, KA.kident(~K, k))), CK.mlen(~K, KA.kident(~K, k)), mlen_kshift(~K, KA.kident(~K, k))) : {1n+_ == 1n+k : Nat}
      %Equal.sym(Nat, CK.mlen(~K, KA.kident(~K, k)), k, mlen_kident(~K, k)) : {1n+_ == 1n+k : Nat}
      {==}

def mlen_kmadd(~K: N.Num, a: N.KMat(~K), b: N.KMat(~K), +n: Nat, ha: {CK.mlen(~K, a) == n : Nat}, hb: {CK.mlen(~K, b) == n : Nat}) -> {CK.mlen(~K, KA.kmadd(~K, a, b)) == n : Nat}:
  match a b n:
    case Nil{} b n:
      hb
    case Con{r, rs} Nil{} n:
      ha
    case Con{+r, +rs} Con{+t, +ts} 0n:
      FO.absurd({CK.mlen(~K, KA.kmadd(~K, Con{r, rs}, Con{t, ts})) == 0n : Nat}, FV.succ_ne(CK.mlen(~K, rs), ha))
    case Con{+r, +rs} Con{+t, +ts} 1n++k:
      %Equal.sym(Nat, CK.mlen(~K, KA.kmadd(~K, rs, ts)), k, mlen_kmadd(~K, rs, ts, k, FV.succ_inj(CK.mlen(~K, rs), k, ha), FV.succ_inj(CK.mlen(~K, ts), k, hb))) : {1n+_ == 1n+k : Nat}
      {==}

def mlen_imm(~K: N.Num, +n: Nat, +a: N.KMat(~K), +b: N.KMat(~K), +ha: {CK.mlen(~K, a) == n : Nat}) -> {CK.mlen(~K, CK.imm(~K, n, a, b)) == n : Nat}:
  mlen_kmadd(~K, KA.kident(~K, n), KA.kmneg(~K, KA.kmatmul(~K, a, b)), n, mlen_kident(~K, n), Equal.trans(Nat, CK.mlen(~K, KA.kmneg(~K, KA.kmatmul(~K, a, b))), CK.mlen(~K, KA.kmatmul(~K, a, b)), n, mlen_kmneg(~K, KA.kmatmul(~K, a, b)), Equal.trans(Nat, CK.mlen(~K, KA.kmatmul(~K, a, b)), CK.mlen(~K, a), n, mlen_kmatmul(~K, a, b), ha)))

def mlen_mcen(~K: N.Num, +box: List<&2, KB.KB<K>>, +cnt: Nat, +lo: Nat, eqs: List<&2, E.QExpr>) -> {CK.mlen(~K, CK.mcenters(~K, CK.srows(~K, box, cnt, lo, eqs))) == CK.eqlen(eqs) : Nat}:
  match eqs:
    case Nil{}:
      {==}
    case Con{e, es}:
      %Equal.sym(Nat, CK.mlen(~K, CK.mcenters(~K, CK.srows(~K, box, cnt, lo, es))), CK.eqlen(es), mlen_mcen(~K, box, cnt, lo, es)) : {1n+_ == 1n+CK.eqlen(es) : Nat}
      {==}

def nrows_ofkm($KH, a: N.KMat(~K)) -> {GJ.nrows(~F, N.ofkm($KHA, a)) == CK.mlen(~K, a) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{r, rs}:
      %Equal.sym(Nat, GJ.nrows(~F, N.ofkm($KHA, rs)), CK.mlen(~K, rs), nrows_ofkm($KHA, rs)) : {1n+_ == 1n+CK.mlen(~K, rs) : Nat}
      {==}

def nrows_mzm($KH, +box: List<&2, KB.KB<K>>, +cnt: Nat, +lo: Nat, eqs: List<&2, E.QExpr>) -> {GJ.nrows(~F, N.ofkm($KHA, mzm($KHA, box, cnt, lo, eqs))) == CK.eqlen(eqs) : Nat}:
  match eqs:
    case Nil{}:
      {==}
    case Con{e, es}:
      %Equal.sym(Nat, GJ.nrows(~F, N.ofkm($KHA, mzm($KHA, box, cnt, lo, es))), CK.eqlen(es), nrows_mzm($KHA, box, cnt, lo, es)) : {1n+_ == 1n+CK.eqlen(es) : Nat}
      {==}

# the checker's vectors have n entries (Y has n rows)
def klen_gvec(~K: N.Num, +eqs: List<&2, E.QExpr>, +n: Nat, +yc: N.KVec(~K), +yr: N.KVec(~K), +ym: N.KMat(~K), +pc: N.KVec(~K), +pr: N.KVec(~K), +hym: {CK.mlen(~K, ym) == n : Nat}) -> {KA.klen(~K, CK.gvec(~K, eqs, n, yc, yr, ym, pc, pr)) == n : Nat}:
  +aK = CK.imm(~K, n, ym, CK.mcenters(~K, CK.rowsy(~K, eqs, n, yc, yr, pc, pr)))
  +dK = CK.mradii(~K, CK.rowsy(~K, eqs, n, yc, yr, pc, pr))
  klen_kvadd(~K, KA.kmatvec(~K, KA.kmabs(~K, aK), yr), KA.kmatvec(~K, KA.kmabs(~K, ym), KA.kmatvec(~K, dK, yr)), n,
    Equal.trans(Nat, KA.klen(~K, KA.kmatvec(~K, KA.kmabs(~K, aK), yr)), CK.mlen(~K, KA.kmabs(~K, aK)), n, klen_kmatvec(~K, KA.kmabs(~K, aK), yr), Equal.trans(Nat, CK.mlen(~K, KA.kmabs(~K, aK)), CK.mlen(~K, aK), n, mlen_kmabs(~K, aK), mlen_imm(~K, n, ym, CK.mcenters(~K, CK.rowsy(~K, eqs, n, yc, yr, pc, pr)), hym))),
    Equal.trans(Nat, KA.klen(~K, KA.kmatvec(~K, KA.kmabs(~K, ym), KA.kmatvec(~K, dK, yr))), CK.mlen(~K, KA.kmabs(~K, ym)), n, klen_kmatvec(~K, KA.kmabs(~K, ym), KA.kmatvec(~K, dK, yr)), Equal.trans(Nat, CK.mlen(~K, KA.kmabs(~K, ym)), CK.mlen(~K, ym), n, mlen_kmabs(~K, ym), hym)))

def klen_svec(~K: N.Num, +eqs: List<&2, E.QExpr>, +n: Nat, +yc: N.KVec(~K), +yr: N.KVec(~K), +ym: N.KMat(~K), +pc: N.KVec(~K), +pr: N.KVec(~K), +hym: {CK.mlen(~K, ym) == n : Nat}) -> {KA.klen(~K, CK.svec(~K, eqs, n, yc, yr, ym, pc, pr)) == n : Nat}:
  +fv = KA.kmatvec(~K, ym, CK.kvals(~K, KA.kapp(~K, yc, pc), eqs))
  +zv = KA.kmatvec(~K, KA.kmadd(~K, KA.kmabs(~K, CK.mcenters(~K, CK.rowsz(~K, eqs, n, yc, yr, pc, pr))), CK.mradii(~K, CK.rowsz(~K, eqs, n, yc, yr, pc, pr))), pr)
  klen_kvadd(~K, KA.kvadd(~K, KA.kvabs(~K, fv), KA.kmatvec(~K, KA.kmabs(~K, ym), zv)), CK.gvec(~K, eqs, n, yc, yr, ym, pc, pr), n,
    klen_kvadd(~K, KA.kvabs(~K, fv), KA.kmatvec(~K, KA.kmabs(~K, ym), zv), n,
      Equal.trans(Nat, KA.klen(~K, KA.kvabs(~K, fv)), KA.klen(~K, fv), n, klen_kvabs(~K, fv), Equal.trans(Nat, KA.klen(~K, fv), CK.mlen(~K, ym), n, klen_kmatvec(~K, ym, CK.kvals(~K, KA.kapp(~K, yc, pc), eqs)), hym)),
      Equal.trans(Nat, KA.klen(~K, KA.kmatvec(~K, KA.kmabs(~K, ym), zv)), CK.mlen(~K, KA.kmabs(~K, ym)), n, klen_kmatvec(~K, KA.kmabs(~K, ym), zv), Equal.trans(Nat, CK.mlen(~K, KA.kmabs(~K, ym)), CK.mlen(~K, ym), n, mlen_kmabs(~K, ym), hym))),
    klen_gvec(~K, eqs, n, yc, yr, ym, pc, pr, hym))

def klen_ivec(~K: N.Num, +eqs: List<&2, E.QExpr>, +n: Nat, +hn: {CK.eqlen(eqs) == n : Nat}, +yc: N.KVec(~K), +yr: N.KVec(~K), +ym: N.KMat(~K), +pc: N.KVec(~K), +pr: N.KVec(~K)) -> {KA.klen(~K, CK.ivec(~K, eqs, n, yc, yr, ym, pc, pr)) == n : Nat}:
  +mc = CK.mcenters(~K, CK.rowsy(~K, eqs, n, yc, yr, pc, pr))
  Equal.trans(Nat, KA.klen(~K, CK.ivec(~K, eqs, n, yc, yr, ym, pc, pr)), CK.mlen(~K, KA.kmabs(~K, CK.imm(~K, n, mc, ym))), n, klen_kmatvec(~K, KA.kmabs(~K, CK.imm(~K, n, mc, ym)), KA.kones(~K, n)),
    Equal.trans(Nat, CK.mlen(~K, KA.kmabs(~K, CK.imm(~K, n, mc, ym))), CK.mlen(~K, CK.imm(~K, n, mc, ym)), n, mlen_kmabs(~K, CK.imm(~K, n, mc, ym)), mlen_imm(~K, n, mc, ym, Equal.trans(Nat, CK.mlen(~K, mc), CK.eqlen(eqs), n, mlen_mcen(~K, CK.box(~K, n, yc, yr, pc, pr), n, 0n, eqs), hn))))

# The self-map at r against r = 0
# --------------------------------
# svec = |Y f| + B + G: |Y f| is the same at both radii, B grows by at
# most |Y| (m lam r) rho, G(r) is first order in r and G(0) = 0. With
# s0's entries at most S = dvmax(s0) <= r/2, every entry of svec(r) is
# at most r.

def dvmax_nn(~F: O.OField, xs: List<&2, S.D>) -> O.le(~F, @0, M.ofd(~F, NU.dvmax(xs))):
  match xs:
    case Nil{}:
      %DM.ofd_zero(~F) : O.le(~F, @0, _)
      FO.le_refl(~F, @0)
    case Con{+x, +t}:
      DM.le_trans(~F, @0, M.ofd(~F, NU.dvmax(t)), M.ofd(~F, NU.dmax(x, NU.dvmax(t))), dvmax_nn(~F, t), DG.ndmax_r(~F, x, NU.dvmax(t)))

def dvmax_at(~F: O.OField, xs: List<&2, S.D>, k: Nat) -> O.le(~F, O.lookup(~F, M.ofdv(~F, xs), k), M.ofd(~F, NU.dvmax(xs))):
  match xs k:
    case Nil{} k:
      dvmax_nn(~F, Nil{})
    case Con{+x, +t} 0n:
      DG.ndmax_l(~F, x, NU.dvmax(t))
    case Con{+x, +t} 1n++j:
      DM.le_trans(~F, O.lookup(~F, M.ofdv(~F, t), j), M.ofd(~F, NU.dvmax(t)), M.ofd(~F, NU.dmax(x, NU.dvmax(t))), dvmax_at(~F, t, j), DG.ndmax_r(~F, x, NU.dvmax(t)))

# n entries, each at most t: below n copies of t
def rle_of_all(~F: O.OField, u: M.Vec(~F), +n: Nat, +t: @T, +h: GJ.All(~(k => O.le(~F, O.lookup(~F, u, k), t)), M.len(~F, u)), lu: {M.len(~F, u) == n : Nat}) -> FV.rle(~F, u, frep(~F, n, t)):
  match u n:
    case Nil{} 0n:
      Unit{}
    case Nil{} 1n++k:
      FO.absurd(FV.rle(~F, Nil{}, frep(~F, 1n+k, t)), FV.zero_ne(k, lu))
    case Con{+a, +us} 0n:
      FO.absurd(FV.rle(~F, Con{a, us}, frep(~F, 0n, t)), FV.succ_ne(M.len(~F, us), lu))
    case Con{+a, +us} 1n++k:
      (GJ.all_at(~(j => O.le(~F, O.lookup(~F, Con{a, us}, j), t)), 1n+M.len(~F, us), h, 0n, {==}),
       rle_of_all(~F, us, k, t, DG.all_shift(~(j => O.le(~F, O.lookup(~F, Con{a, us}, j), t)), M.len(~F, us), h), FV.succ_inj(M.len(~F, us), k, lu)))

def rle_rep(~F: O.OField, ~u: M.Vec(~F), ~t: @T, ~f: @k: Nat -> O.le(~F, O.lookup(~F, u, k), t), +n: Nat, lu: {M.len(~F, u) == n : Nat}) -> FV.rle(~F, u, frep(~F, n, t)):
  rle_of_all(~F, u, n, t, GJ.all_mk(~M.len(~F, u), ~(k => O.le(~F, O.lookup(~F, u, k), t)), ~(k => hk => f(k)), M.len(~F, u), GJ.le_refl(M.len(~F, u))), lu)

def lk3(~F: O.OField, +a: M.Vec(~F), +b: M.Vec(~F), +g: M.Vec(~F), +k: Nat) -> {O.lookup(~F, M.vadd(~F, M.vadd(~F, a, b), g), k) == @A(@A(O.lookup(~F, a, k), O.lookup(~F, b, k)), O.lookup(~F, g, k)) : @T}:
  %GJ.look_vadd(~F, M.vadd(~F, a, b), g, k) : {_ == @A(@A(O.lookup(~F, a, k), O.lookup(~F, b, k)), O.lookup(~F, g, k)) : @T}
  %GJ.look_vadd(~F, a, b, k) : {@A(_, O.lookup(~F, g, k)) == @A(@A(O.lookup(~F, a, k), O.lookup(~F, b, k)), O.lookup(~F, g, k)) : @T}
  {==}

# a + br + gr <= sd + d1 + d2 + d3 from a + b0 + g0 <= sd, |br - b0| <= d1, |gr| <= d2, |g0| <= d3
def cs_ent(~F: O.OField, +a: @T, +br: @T, +gr: @T, +b0: @T, +g0: @T, +sd: @T, +d1: @T, +d2: @T, +d3: @T, +hy: O.le(~F, @A(@A(a, b0), g0), sd), h1: M.bnd(~F, @S(br, b0), d1), h2: M.bnd(~F, gr, d2), h3: M.bnd(~F, g0, d3)) -> O.le(~F, @A(@A(a, br), gr), @A(@A(@A(sd, d1), d2), d3)):
  (p1, q1) = h1
  (p2, q2) = h2
  (p3, q3) = h3
  FV.le_of_sub(~F, @A(@A(a, br), gr), @A(@A(@A(sd, d1), d2), d3), FM.nn_eq(~F, @S(@A(@A(@A(sd, d1), d2), d3), @A(@A(a, br), gr)), @A(@A(@A(@S(sd, @A(@A(a, b0), g0)), @S(d1, @S(br, b0))), @S(d2, gr)), @A(d3, g0)),
    FR.fring_eq(~F, [a, br, gr, b0, g0, sd, d1, d2, d3], E.ZAdd{E.ZAdd{E.ZAdd{E.ZSub{E.ZVar{5n}, E.ZAdd{E.ZAdd{E.ZVar{0n}, E.ZVar{3n}}, E.ZVar{4n}}}, E.ZSub{E.ZVar{6n}, E.ZSub{E.ZVar{1n}, E.ZVar{3n}}}}, E.ZSub{E.ZVar{7n}, E.ZVar{2n}}}, E.ZAdd{E.ZVar{8n}, E.ZVar{4n}}}, E.ZSub{E.ZAdd{E.ZAdd{E.ZAdd{E.ZVar{5n}, E.ZVar{6n}}, E.ZVar{7n}}, E.ZVar{8n}}, E.ZAdd{E.ZAdd{E.ZVar{0n}, E.ZVar{1n}}, E.ZVar{2n}}}, {==}),
    FO.nonneg_add(~F, @A(@A(@S(sd, @A(@A(a, b0), g0)), @S(d1, @S(br, b0))), @S(d2, gr)), @A(d3, g0), FO.nonneg_add(~F, @A(@S(sd, @A(@A(a, b0), g0)), @S(d1, @S(br, b0))), @S(d2, gr), FO.nonneg_add(~F, @S(sd, @A(@A(a, b0), g0)), @S(d1, @S(br, b0)), sub_nn(~F, @A(@A(a, b0), g0), sd, hy), p1), p2), q3)))

# the same, entry k of the vectors
def cs_at(~F: O.OField, +a: M.Vec(~F), +br: M.Vec(~F), +gr: M.Vec(~F), +b0: M.Vec(~F), +g0: M.Vec(~F), +sd: @T, +k: Nat, +hy: O.le(~F, O.lookup(~F, M.vadd(~F, M.vadd(~F, a, b0), g0), k), sd)) -> O.le(~F, O.lookup(~F, M.vadd(~F, M.vadd(~F, a, br), gr), k), @A(@A(@A(sd, NP.vn(~F, BX.vsub(~F, br, b0))), NP.vn(~F, gr)), NP.vn(~F, g0))):
  %Equal.sym(@T, O.lookup(~F, M.vadd(~F, M.vadd(~F, a, br), gr), k), @A(@A(O.lookup(~F, a, k), O.lookup(~F, br, k)), O.lookup(~F, gr, k)), lk3(~F, a, br, gr, k)) : O.le(~F, _, @A(@A(@A(sd, NP.vn(~F, BX.vsub(~F, br, b0))), NP.vn(~F, gr)), NP.vn(~F, g0)))
  cs_ent(~F, O.lookup(~F, a, k), O.lookup(~F, br, k), O.lookup(~F, gr, k), O.lookup(~F, b0, k), O.lookup(~F, g0, k), sd, NP.vn(~F, BX.vsub(~F, br, b0)), NP.vn(~F, gr), NP.vn(~F, g0),
    RL.le_rw_l(~F, O.lookup(~F, M.vadd(~F, M.vadd(~F, a, b0), g0), k), @A(@A(O.lookup(~F, a, k), O.lookup(~F, b0, k)), O.lookup(~F, g0, k)), sd, lk3(~F, a, b0, g0, k), hy),
    (%DG.look_diff(~F, br, b0, k) : M.bnd(~F, _, NP.vn(~F, BX.vsub(~F, br, b0)))
      AP.lkb(~F, BX.vsub(~F, br, b0), k)),
    AP.lkb(~F, gr, k), AP.lkb(~F, g0, k))

def vall_z(~F: O.OField, +v: M.Vec(~F), +c: @T, h: M.vbnd.all(~F, v, @M(c, @0))) -> M.vbnd.all(~F, v, @0):
  %FR.fring_eq(~F, [c], E.ZMul{E.ZVar{0n}, E.ZCst{S.Z0{}}}, E.ZCst{S.Z0{}}, {==}) : M.vbnd.all(~F, v, _)
  h

def vn_z(~F: O.OField, +v: M.Vec(~F), h: M.vbnd.all(~F, v, @0)) -> O.le(~F, NP.vn(~F, v), @0):
  FV.vmax_lub(~F, v, @0, h, FO.le_refl(~F, @0))

@MACRO SVP ~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +eqs: List<&2, E.QExpr>, +yc: List<&2, S.D>, +pc: List<&2, S.D>, +pr: List<&2, S.D>, +ym: List<&2, List<&2, S.D>>
@MACRO SVA ~F, ~H, n, eqs, yc, pc, pr, ym

# G at radius 0 (no unknowns' radii) is 0
def g0_bnd($SVP) -> O.le(~F, NP.vn(~F, N.ofkv($DH, CK.gvec($DN, eqs, n, yc, Nil{}, ym, pc, pr))), @0):
  +aK = CK.imm($DN, n, ym, CK.mcenters($DN, CK.rowsy($DN, eqs, n, yc, Nil{}, pc, pr)))
  +dK = CK.mradii($DN, CK.rowsy($DN, eqs, n, yc, Nil{}, pc, pr))
  +pP = M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, aK)), N.ofkv($DH, Nil{}))
  +dv = M.matvec(~F, N.ofkm($DH, dK), N.ofkv($DH, Nil{}))
  +qQ = M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, ym)), dv)
  %Equal.sym(M.Vec(~F), N.ofkv($DH, CK.gvec($DN, eqs, n, yc, Nil{}, ym, pc, pr)), M.vadd(~F, pP, qQ), CP.gF_ok($DH, eqs, n, yc, Nil{}, ym, pc, pr)) : O.le(~F, NP.vn(~F, _), @0)
  DM.le_trans(~F, NP.vn(~F, M.vadd(~F, pP, qQ)), @A(NP.vn(~F, pP), NP.vn(~F, qQ)), @0, AP.vn_add(~F, pP, qQ),
    FV.le_rw_r(~F, @A(NP.vn(~F, pP), NP.vn(~F, qQ)), @A(@0, @0), @0, FR.fring_eq(~F, [@0], E.ZAdd{E.ZCst{S.Z0{}}, E.ZCst{S.Z0{}}}, E.ZCst{S.Z0{}}, {==}),
      RP.le_add2(~F, NP.vn(~F, pP), @0, NP.vn(~F, qQ), @0,
        vn_z(~F, pP, vall_z(~F, pP, NP.mnorm(~F, N.ofkm($DH, KA.kmabs($DN, aK)), M.len(~F, N.ofkv($DH, Nil{}))), NP.mv_le(~F, N.ofkm($DH, KA.kmabs($DN, aK)), N.ofkv($DH, Nil{}), @0, Unit{}, FO.le_refl(~F, @0)))),
        vn_z(~F, qQ, vall_z(~F, qQ, NP.mnorm(~F, N.ofkm($DH, KA.kmabs($DN, ym)), M.len(~F, dv)), NP.mv_le(~F, N.ofkm($DH, KA.kmabs($DN, ym)), dv, @0, vall_z(~F, dv, NP.mnorm(~F, N.ofkm($DH, dK), M.len(~F, N.ofkv($DH, Nil{}))), NP.mv_le(~F, N.ofkm($DH, dK), N.ofkv($DH, Nil{}), @0, Unit{}, FO.le_refl(~F, @0))), FO.le_refl(~F, @0)))))))

# |Y f(center)|, and B = |Y| ((|J0z| + Dz) rho) over the box with unknowns' radii yr
def ayf($SVP) -> N.KVec($DN):
  KA.kvabs($DN, KA.kmatvec($DN, ym, CK.kvals($DN, KA.kapp($DN, yc, pc), eqs)))

def bk($SVP, +yr: List<&2, S.D>) -> N.KVec($DN):
  KA.kmatvec($DN, KA.kmabs($DN, ym), KA.kmatvec($DN, mzm($DH, CK.box($DN, n, yc, yr, pc, pr), KA.klen($DN, pc), n, eqs), pr))

def svec_f($SVP, +yr: List<&2, S.D>) -> {N.ofkv($DH, CK.svec($DN, eqs, n, yc, yr, ym, pc, pr)) == M.vadd(~F, M.vadd(~F, N.ofkv($DH, ayf($SVA)), N.ofkv($DH, bk($SVA, yr))), N.ofkv($DH, CK.gvec($DN, eqs, n, yc, yr, ym, pc, pr))) : M.Vec(~F)}:
  %KA.kvadd_ofk($DH, KA.kvadd($DN, ayf($SVA), bk($SVA, yr)), CK.gvec($DN, eqs, n, yc, yr, ym, pc, pr)) : {_ == M.vadd(~F, M.vadd(~F, N.ofkv($DH, ayf($SVA)), N.ofkv($DH, bk($SVA, yr))), N.ofkv($DH, CK.gvec($DN, eqs, n, yc, yr, ym, pc, pr))) : M.Vec(~F)}
  %KA.kvadd_ofk($DH, ayf($SVA), bk($SVA, yr)) : {M.vadd(~F, _, N.ofkv($DH, CK.gvec($DN, eqs, n, yc, yr, ym, pc, pr))) == M.vadd(~F, M.vadd(~F, N.ofkv($DH, ayf($SVA)), N.ofkv($DH, bk($SVA, yr))), N.ofkv($DH, CK.gvec($DN, eqs, n, yc, yr, ym, pc, pr))) : M.Vec(~F)}
  {==}

def bf_eq($SVP, +yr: List<&2, S.D>) -> {N.ofkv($DH, bk($SVA, yr)) == M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, ym)), M.matvec(~F, N.ofkm($DH, mzm($DH, CK.box($DN, n, yc, yr, pc, pr), KA.klen($DN, pc), n, eqs)), N.ofkv($DH, pr))) : M.Vec(~F)}:
  %KA.kmatvec_ofk($DH, KA.kmabs($DN, ym), KA.kmatvec($DN, mzm($DH, CK.box($DN, n, yc, yr, pc, pr), KA.klen($DN, pc), n, eqs), pr)) : {_ == M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, ym)), M.matvec(~F, N.ofkm($DH, mzm($DH, CK.box($DN, n, yc, yr, pc, pr), KA.klen($DN, pc), n, eqs)), N.ofkv($DH, pr))) : M.Vec(~F)}
  %KA.kmatvec_ofk($DH, mzm($DH, CK.box($DN, n, yc, yr, pc, pr), KA.klen($DN, pc), n, eqs), pr) : {M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, ym)), _) == M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, ym)), M.matvec(~F, N.ofkm($DH, mzm($DH, CK.box($DN, n, yc, yr, pc, pr), KA.klen($DN, pc), n, eqs)), N.ofkv($DH, pr))) : M.Vec(~F)}
  {==}

def e0_of(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +r: S.D, hr0: O.le(~F, @0, M.ofd(~F, r))) -> O.le(~F, @0, N.emap(KI.dnum(), F, H, r)):
  %Equal.sym(@T, N.emap(KI.dnum(), F, H, r), M.ofd(~F, r), AP.hofd(~F, ~H, r)) : O.le(~F, @0, _)
  hr0

def rnn_kv(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +v: List<&2, S.D>, h: FV.rnn(~F, M.ofdv(~F, v))) -> FV.rnn(~F, N.ofkv($DH, v)):
  %Equal.sym(M.Vec(~F), N.ofkv($DH, v), M.ofdv(~F, v), AP.ofkv_d(~F, ~H, v)) : FV.rnn(~F, _)
  h

@MACRO BDB @M(yn, @M(@M(FR.ofn(~F, KA.klen($DN, pc)), @M(lam, M.ofd(~F, r))), rb))

# B(r) - B(0): |Y| ((Mz(r) - Mz(0)) rho), at most yn (m lam r) rb
def bdiff_bnd($WXP, +r: S.D, +hr0: O.le(~F, @0, M.ofd(~F, r)), +hr1: O.le(~F, M.ofd(~F, r), rb)) -> O.le(~F, NP.vn(~F, BX.vsub(~F, N.ofkv($DH, bk($SVA, NU.dreps(n, r))), N.ofkv($DH, bk($SVA, Nil{})))), $BDB):
  +b0 = CK.box($DN, n, yc, Nil{}, pc, pr)
  +b1 = CK.box($DN, n, yc, NU.dreps(n, r), pc, pr)
  +m = KA.klen($DN, pc)
  +ya = N.ofkm($DH, KA.kmabs($DN, ym))
  +m0 = N.ofkm($DH, mzm($DH, b0, m, n, eqs))
  +m1 = N.ofkm($DH, mzm($DH, b1, m, n, eqs))
  +pv = N.ofkv($DH, pr)
  +md = M.madd(~F, m1, M.mneg(~F, m0))
  +w = M.matvec(~F, md, pv)
  +he0 = e0_of(~F, ~H, r, hr0)
  +hpk = rnn_kv(~F, ~H, pr, hpn)
  +hcen = Equal.trans(M.Vec(~F), BP.cen($DH, b0), $PTC, BP.cen($DH, b1), cen_ckb(~F, ~H, n, yc, Nil{}, pc, pr, lyc, lpp), Equal.sym(M.Vec(~F), BP.cen($DH, b1), $PTC, cen_ckb(~F, ~H, n, yc, NU.dreps(n, r), pc, pr, lyc, lpp)))
  +hp = bpair_ckb(~F, ~H, n, yc, pc, pr, lyc, lpp, r, he0, hpk)
  +hg = gbox_ckb(~F, ~H, n, yc, NU.dreps(n, r), pc, pr, lyc, lpp, r, kfit_dreps(n, r), rb, bb, hc, hr0, hr1, hpn, hpr)
  +lw = Equal.trans(Nat, M.len(~F, w), GJ.nrows(~F, md), n, Equal.sym(Nat, GJ.nrows(~F, md), M.len(~F, w), GJ.len_matvec(~F, md, pv)), NW.nrows_madd(~F, m1, M.mneg(~F, m0), n, Equal.trans(Nat, GJ.nrows(~F, m1), CK.eqlen(eqs), n, nrows_mzm($DH, b1, m, n, eqs), hn), Equal.trans(Nat, GJ.nrows(~F, M.mneg(~F, m0)), GJ.nrows(~F, m0), n, NW.nrows_mneg(~F, m0), Equal.trans(Nat, GJ.nrows(~F, m0), CK.eqlen(eqs), n, nrows_mzm($DH, b0, m, n, eqs), hn))))
  +lp = Equal.trans(Nat, M.len(~F, pv), KA.klen($DN, pr), m, CP.len_ofkv($DH, pr), Equal.sym(Nat, KA.klen($DN, pc), KA.klen($DN, pr), lpp))
  %Equal.sym(M.Vec(~F), N.ofkv($DH, bk($SVA, NU.dreps(n, r))), M.matvec(~F, ya, M.matvec(~F, m1, pv)), bf_eq($SVA, NU.dreps(n, r))) : O.le(~F, NP.vn(~F, BX.vsub(~F, _, N.ofkv($DH, bk($SVA, Nil{})))), $BDB)
  %Equal.sym(M.Vec(~F), N.ofkv($DH, bk($SVA, Nil{})), M.matvec(~F, ya, M.matvec(~F, m0, pv)), bf_eq($SVA, Nil{})) : O.le(~F, NP.vn(~F, BX.vsub(~F, M.matvec(~F, ya, M.matvec(~F, m1, pv)), _)), $BDB)
  %AP.mv_vsub(~F, ya, M.matvec(~F, m1, pv), M.matvec(~F, m0, pv)) : O.le(~F, NP.vn(~F, _), $BDB)
  %CP.sj_ok(~F, m1, m0, pv) : O.le(~F, NP.vn(~F, M.matvec(~F, ya, _)), $BDB)
  DM.le_trans(~F, NP.vn(~F, M.matvec(~F, ya, w)), @M(NP.mnorm(~F, ya, n), NP.vn(~F, w)), $BDB, NP.mv_n(~F, ya, n, w, lw),
    NW.mm_le(~F, NP.mnorm(~F, ya, n), yn, NP.vn(~F, w), @M(@M(FR.ofn(~F, m), @M(lam, M.ofd(~F, r))), rb), FV.vmax_nn(~F, w), hyn0, ym_mn($WXA),
      DM.le_trans(~F, NP.vn(~F, w), @M(NP.mnorm(~F, md, m), NP.vn(~F, pv)), @M(@M(FR.ofn(~F, m), @M(lam, M.ofd(~F, r))), rb), NP.mv_n(~F, md, m, pv, lp),
        NW.mm_le(~F, NP.mnorm(~F, md, m), @M(FR.ofn(~F, m), @M(lam, M.ofd(~F, r))), NP.vn(~F, pv), rb, FV.vmax_nn(~F, pv), AP.lr_nn(~F, m, lam, M.ofd(~F, r), hl0, hr0),
          (%AP.hofd(~F, ~H, r) : O.le(~F, NP.mnorm(~F, md, m), @M(FR.ofn(~F, m), @M(lam, _)))
            mz_mn($DH, N.emap(KI.dnum(), F, H, r), rb, bb, he0, hrb, hb, b0, b1, hcen, hp, hg, lam, ms, hl0, eqs, hq, hh, m, n)),
          (%Equal.sym(M.Vec(~F), N.ofkv($DH, pr), M.ofdv(~F, pr), AP.ofkv_d(~F, ~H, pr)) : O.le(~F, NP.vn(~F, _), rb)
            FV.vmax_lub(~F, M.ofdv(~F, pr), rb, hpr, hrb))))))

# ofd(1/2) twice is 1
def half_two(~F: O.OField) -> {@A(M.ofd(~F, NU.half()), M.ofd(~F, NU.half())) == @1 : @T}:
  @CERTEQ[i=O.inv(F, O.ofp(~F, S.Pos.pow2(1n))) | 1*i + 1*i | 1 | 1 ; (1 + 1)*i - 1 || QE.ofp_rel(~F, S.Pos.pow2(1n))]

# sd + db + dg + d0 <= R from sd <= q R, the bounds on db, dg and d0,
# and the window condition cw <= q (q + q = 1)
def cs_fin(~F: O.OField, +sd: @T, +db: @T, +dg: @T, +d0: @T, +R: @T, +q: @T, +thL: @T, +yn: @T, +nn: @T, +mm: @T, +lam: @T, +rb: @T, +hS: O.le(~F, sd, @M(q, R)), +hdb: O.le(~F, db, @M(yn, @M(@M(mm, @M(lam, R)), rb))), +hdg: O.le(~F, dg, @A(@M(thL, R), @M(yn, @M(@M(nn, @M(lam, rb)), R)))), +hd0: O.le(~F, d0, @0), +hw: O.le(~F, @A(@A(thL, @M(yn, @M(nn, @M(lam, rb)))), @M(yn, @M(mm, @M(lam, rb)))), q), +hR: O.le(~F, @0, R), +hq2: {@A(q, q) == @1 : @T}) -> O.le(~F, @A(@A(@A(sd, db), dg), d0), R):
  FV.le_rw_r(~F, @A(@A(@A(sd, db), dg), d0), @M(@A(q, q), R), R,
    (%Equal.sym(@T, @A(q, q), @1, hq2) : {@M(_, R) == R : @T}
      FR.fring_eq(~F, [R], E.ZMul{E.ZCst{S.Zpos{S.XH{}}}, E.ZVar{0n}}, E.ZVar{0n}, {==})),
    FV.le_of_sub(~F, @A(@A(@A(sd, db), dg), d0), @M(@A(q, q), R), FM.nn_eq(~F, @S(@M(@A(q, q), R), @A(@A(@A(sd, db), dg), d0)), @A(@A(@A(@A(@S(@M(q, R), sd), @M(@S(q, @A(@A(thL, @M(yn, @M(nn, @M(lam, rb)))), @M(yn, @M(mm, @M(lam, rb))))), R)), @S(@M(yn, @M(@M(mm, @M(lam, R)), rb)), db)), @S(@A(@M(thL, R), @M(yn, @M(@M(nn, @M(lam, rb)), R))), dg)), @S(@0, d0)),
      FR.fring_eq(~F, [sd, db, dg, d0, R, q, thL, yn, nn, mm, lam, rb], E.ZAdd{E.ZAdd{E.ZAdd{E.ZAdd{E.ZSub{E.ZMul{E.ZVar{5n}, E.ZVar{4n}}, E.ZVar{0n}}, E.ZMul{E.ZSub{E.ZVar{5n}, E.ZAdd{E.ZAdd{E.ZVar{6n}, E.ZMul{E.ZVar{7n}, E.ZMul{E.ZVar{8n}, E.ZMul{E.ZVar{10n}, E.ZVar{11n}}}}}, E.ZMul{E.ZVar{7n}, E.ZMul{E.ZVar{9n}, E.ZMul{E.ZVar{10n}, E.ZVar{11n}}}}}}, E.ZVar{4n}}}, E.ZSub{E.ZMul{E.ZVar{7n}, E.ZMul{E.ZMul{E.ZVar{9n}, E.ZMul{E.ZVar{10n}, E.ZVar{4n}}}, E.ZVar{11n}}}, E.ZVar{1n}}}, E.ZSub{E.ZAdd{E.ZMul{E.ZVar{6n}, E.ZVar{4n}}, E.ZMul{E.ZVar{7n}, E.ZMul{E.ZMul{E.ZVar{8n}, E.ZMul{E.ZVar{10n}, E.ZVar{11n}}}, E.ZVar{4n}}}}, E.ZVar{2n}}}, E.ZSub{E.ZCst{S.Z0{}}, E.ZVar{3n}}}, E.ZSub{E.ZMul{E.ZAdd{E.ZVar{5n}, E.ZVar{5n}}, E.ZVar{4n}}, E.ZAdd{E.ZAdd{E.ZAdd{E.ZVar{0n}, E.ZVar{1n}}, E.ZVar{2n}}, E.ZVar{3n}}}, {==}),
      FO.nonneg_add(~F, @A(@A(@A(@S(@M(q, R), sd), @M(@S(q, @A(@A(thL, @M(yn, @M(nn, @M(lam, rb)))), @M(yn, @M(mm, @M(lam, rb))))), R)), @S(@M(yn, @M(@M(mm, @M(lam, R)), rb)), db)), @S(@A(@M(thL, R), @M(yn, @M(@M(nn, @M(lam, rb)), R))), dg)), @S(@0, d0),
        FO.nonneg_add(~F, @A(@A(@S(@M(q, R), sd), @M(@S(q, @A(@A(thL, @M(yn, @M(nn, @M(lam, rb)))), @M(yn, @M(mm, @M(lam, rb))))), R)), @S(@M(yn, @M(@M(mm, @M(lam, R)), rb)), db)), @S(@A(@M(thL, R), @M(yn, @M(@M(nn, @M(lam, rb)), R))), dg),
          FO.nonneg_add(~F, @A(@S(@M(q, R), sd), @M(@S(q, @A(@A(thL, @M(yn, @M(nn, @M(lam, rb)))), @M(yn, @M(mm, @M(lam, rb))))), R)), @S(@M(yn, @M(@M(mm, @M(lam, R)), rb)), db),
            FO.nonneg_add(~F, @S(@M(q, R), sd), @M(@S(q, @A(@A(thL, @M(yn, @M(nn, @M(lam, rb)))), @M(yn, @M(mm, @M(lam, rb))))), R), sub_nn(~F, sd, @M(q, R), hS), FO.mul_nonneg(~F, @S(q, @A(@A(thL, @M(yn, @M(nn, @M(lam, rb)))), @M(yn, @M(mm, @M(lam, rb))))), R, sub_nn(~F, @A(@A(thL, @M(yn, @M(nn, @M(lam, rb)))), @M(yn, @M(mm, @M(lam, rb)))), q, hw), hR)),
            sub_nn(~F, db, @M(yn, @M(@M(mm, @M(lam, R)), rb)), hdb)),
          sub_nn(~F, dg, @A(@M(thL, R), @M(yn, @M(@M(nn, @M(lam, rb)), R))), hdg)),
        sub_nn(~F, d0, @0, hd0)))))
