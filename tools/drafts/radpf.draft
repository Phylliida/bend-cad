# bend-cad: the block's radius and box, for solve_complete (DESIGN §10.4,
# C5c). Proofs only.
#
# After Newton (lib/nwtpf.bend) the solver inverts the Jacobian at the
# center once more, rounds the inverse to Y, and searches radii from
# r0, the self-map bound at radius 0 times 65/64. This file shows that
# every radius between 2S and U passes the block checker (S the largest
# entry of that self-map bound), that the search reaches one, and that
# x_b lies in the box: |yc - x_b| <= (65/64) S <= r0 <= r.
#
# The self-map at radius r is compared entry by entry with the one at
# radius 0: the parameters' slope balls widen by at most ls r when the
# unknowns' radius grows from 0 to r (pair grades, below), so the
# comparison costs only first-order terms in r.

import Base
import ../spec/num.bend as S
import ../spec/ring.bend as E
import ../spec/field.bend as O
import ../spec/mat.bend as M
import ../spec/box.bend as BX
import ../spec/knum.bend as N
import ../spec/deriv.bend as DV
import ./karith.bend as KA
import ./kball.bend as KB
import ./cert.bend as CK
import ./certdef.bend as C
import ./certpf.bend as CP
import ./kinst.bend as KI
import ./numer.bend as NU
import ./struct.bend as ST
import ./flaws.bend as FL
import ./fring.bend as FR
import ./ford.bend as FO
import ./fmat.bend as FM
import ./fvec.bend as FV
import ./dmat.bend as DM
import ./gjpf.bend as GJ
import ./normpf.bend as NP
import ./dgjpf.bend as DG
import ./bndpf.bend as BP
import ./roundpf.bend as RP
import ./real.bend as RL
import ./qemb.bend as QE
import ./apxpf.bend as AP
import ./nwtpf.bend as NW
import ./slope.bend as SL

# K's absolute value is F's
# -------------------------

def kabs_eq(~K: N.Num, ~F: O.OField, ~H: N.Emb<K, F>, +a: N.NC(K)) -> {@H(KA.kabs(~K, a)) == FV.fabs(~F, @H(a)) : @T}:
  RL.le_antisymm(~F, @H(KA.kabs(~K, a)), FV.fabs(~F, @H(a)), BP.kabs_le(~K, ~F, ~H, a, FV.fabs(~F, @H(a)), FV.fabs_bnd(~F, @H(a))), FV.fabs_le(~F, @H(a), @H(KA.kabs(~K, a)), KA.kabs_bnd(~K, ~F, ~H, a)))

# Pair grades
# -----------
# Two balls with the same center over two boxes with the same centers,
# the second box's radii at least the first's and at most dl more: the
# second ball's radius is at least the first's and at most l dl more.

def pd(~F: O.OField, +dl: @T, +r0: @T, +r1: @T, +l: @T) -> Data:
  M.Both(O.le(~F, @0, r0), M.Both(O.le(~F, r0, r1), O.le(~F, @S(r1, r0), @M(l, dl))))

def pd_0(~F: O.OField, +dl: @T, +r0: @T, +r1: @T, +l: @T, h: pd(~F, dl, r0, r1, l)) -> O.le(~F, @0, r0):
  (a, b) = h
  a

def pd_12(~F: O.OField, +dl: @T, +r0: @T, +r1: @T, +l: @T, h: pd(~F, dl, r0, r1, l)) -> M.Both(O.le(~F, r0, r1), O.le(~F, @S(r1, r0), @M(l, dl))):
  (a, b) = h
  b

def pd_1(~F: O.OField, +dl: @T, +r0: @T, +r1: @T, +l: @T, +h: pd(~F, dl, r0, r1, l)) -> O.le(~F, r0, r1):
  AP.both_l(O.le(~F, r0, r1), O.le(~F, @S(r1, r0), @M(l, dl)), pd_12(~F, dl, r0, r1, l, h))

def pd_2(~F: O.OField, +dl: @T, +r0: @T, +r1: @T, +l: @T, +h: pd(~F, dl, r0, r1, l)) -> O.le(~F, @S(r1, r0), @M(l, dl)):
  AP.both_r(O.le(~F, r0, r1), O.le(~F, @S(r1, r0), @M(l, dl)), pd_12(~F, dl, r0, r1, l, h))

def pd_add(~F: O.OField, +dl: @T, +a0: @T, +a1: @T, +l1: @T, +b0: @T, +b1: @T, +l2: @T, +ha: pd(~F, dl, a0, a1, l1), +hb: pd(~F, dl, b0, b1, l2)) -> pd(~F, dl, @A(a0, b0), @A(a1, b1), @A(l1, l2)):
  (FO.nonneg_add(~F, a0, b0, pd_0(~F, dl, a0, a1, l1, ha), pd_0(~F, dl, b0, b1, l2, hb)),
   (RP.le_add2(~F, a0, a1, b0, b1, pd_1(~F, dl, a0, a1, l1, ha), pd_1(~F, dl, b0, b1, l2, hb)),
    FV.le_rw_r(~F, @S(@A(a1, b1), @A(a0, b0)), @A(@M(l1, dl), @M(l2, dl)), @M(@A(l1, l2), dl), FR.fring_eq(~F, [l1, l2, dl], E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{2n}}, E.ZMul{E.ZVar{1n}, E.ZVar{2n}}}, E.ZMul{E.ZAdd{E.ZVar{0n}, E.ZVar{1n}}, E.ZVar{2n}}, {==}),
      RL.le_rw_l(~F, @A(@S(a1, a0), @S(b1, b0)), @S(@A(a1, b1), @A(a0, b0)), @A(@M(l1, dl), @M(l2, dl)), FR.fring_eq(~F, [a0, a1, b0, b1], E.ZAdd{E.ZSub{E.ZVar{1n}, E.ZVar{0n}}, E.ZSub{E.ZVar{3n}, E.ZVar{2n}}}, E.ZSub{E.ZAdd{E.ZVar{1n}, E.ZVar{3n}}, E.ZAdd{E.ZVar{0n}, E.ZVar{2n}}}, {==}),
        RP.le_add2(~F, @S(a1, a0), @M(l1, dl), @S(b1, b0), @M(l2, dl), pd_2(~F, dl, a0, a1, l1, ha), pd_2(~F, dl, b0, b1, l2, hb))))))

def sub_nn(~F: O.OField, +a: @T, +b: @T, h: O.le(~F, a, b)) -> O.le(~F, @0, @S(b, a)):
  FM.sub_nonneg(~F, a, b, h)

# a product: |c1| = k1, |c2| = k2 (both boxes' centers agree), with
# k1 + a1 <= m1 and k2 + b1 <= m2 (the second box's grades)
def pd_mul(~F: O.OField, +dl: @T, +k1: @T, +k2: @T, +a0: @T, +a1: @T, +l1: @T, +m1: @T, +b0: @T, +b1: @T, +l2: @T, +m2: @T, +hk1: O.le(~F, @0, k1), +hk2: O.le(~F, @0, k2), +ha: pd(~F, dl, a0, a1, l1), +hb: pd(~F, dl, b0, b1, l2), +hm1: O.le(~F, @A(k1, a1), m1), +hm2: O.le(~F, @A(k2, b1), m2)) -> pd(~F, dl, @A(@A(@M(k1, b0), @M(k2, a0)), @M(a0, b0)), @A(@A(@M(k1, b1), @M(k2, a1)), @M(a1, b1)), @A(@M(m1, l2), @M(m2, l1))):
  +ha0 = pd_0(~F, dl, a0, a1, l1, ha)
  +hb0 = pd_0(~F, dl, b0, b1, l2, hb)
  +da = sub_nn(~F, a0, a1, pd_1(~F, dl, a0, a1, l1, ha))
  +db = sub_nn(~F, b0, b1, pd_1(~F, dl, b0, b1, l2, hb))
  +ea_ = sub_nn(~F, @S(a1, a0), @M(l1, dl), pd_2(~F, dl, a0, a1, l1, ha))
  +eb_ = sub_nn(~F, @S(b1, b0), @M(l2, dl), pd_2(~F, dl, b0, b1, l2, hb))
  +ha1 = DM.le_trans(~F, @0, a0, a1, ha0, pd_1(~F, dl, a0, a1, l1, ha))
  +hb1 = DM.le_trans(~F, @0, b0, b1, hb0, pd_1(~F, dl, b0, b1, l2, hb))
  +fm1 = sub_nn(~F, @A(k1, a1), m1, hm1)
  +fm2 = DM.le_trans(~F, @0, @S(m2, @A(k2, b1)), @S(m2, @A(k2, b0)), sub_nn(~F, @A(k2, b1), m2, hm2), FV.le_of_sub(~F, @S(m2, @A(k2, b1)), @S(m2, @A(k2, b0)), FM.nn_eq(~F, @S(@S(m2, @A(k2, b0)), @S(m2, @A(k2, b1))), @S(b1, b0), FR.fring_eq(~F, [m2, k2, b0, b1], E.ZSub{E.ZVar{3n}, E.ZVar{2n}}, E.ZSub{E.ZSub{E.ZVar{0n}, E.ZAdd{E.ZVar{1n}, E.ZVar{2n}}}, E.ZSub{E.ZVar{0n}, E.ZAdd{E.ZVar{1n}, E.ZVar{3n}}}}, {==}), db)))
  +m1n = DM.le_trans(~F, @0, @A(k1, a1), m1, FO.nonneg_add(~F, k1, a1, hk1, ha1), hm1)
  +m2n = DM.le_trans(~F, @0, @A(k2, b1), m2, FO.nonneg_add(~F, k2, b1, hk2, hb1), hm2)
  (FO.nonneg_add(~F, @A(@M(k1, b0), @M(k2, a0)), @M(a0, b0), FO.nonneg_add(~F, @M(k1, b0), @M(k2, a0), FO.mul_nonneg(~F, k1, b0, hk1, hb0), FO.mul_nonneg(~F, k2, a0, hk2, ha0)), FO.mul_nonneg(~F, a0, b0, ha0, hb0)),
   (FV.le_of_sub(~F, @A(@A(@M(k1, b0), @M(k2, a0)), @M(a0, b0)), @A(@A(@M(k1, b1), @M(k2, a1)), @M(a1, b1)),
      FM.nn_eq(~F, @S(@A(@A(@M(k1, b1), @M(k2, a1)), @M(a1, b1)), @A(@A(@M(k1, b0), @M(k2, a0)), @M(a0, b0))), @A(@M(@A(k1, a1), @S(b1, b0)), @M(@A(k2, b0), @S(a1, a0))),
        FR.fring_eq(~F, [k1, k2, a0, a1, b0, b1], E.ZAdd{E.ZMul{E.ZAdd{E.ZVar{0n}, E.ZVar{3n}}, E.ZSub{E.ZVar{5n}, E.ZVar{4n}}}, E.ZMul{E.ZAdd{E.ZVar{1n}, E.ZVar{4n}}, E.ZSub{E.ZVar{3n}, E.ZVar{2n}}}}, E.ZSub{E.ZAdd{E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{5n}}, E.ZMul{E.ZVar{1n}, E.ZVar{3n}}}, E.ZMul{E.ZVar{3n}, E.ZVar{5n}}}, E.ZAdd{E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{4n}}, E.ZMul{E.ZVar{1n}, E.ZVar{2n}}}, E.ZMul{E.ZVar{2n}, E.ZVar{4n}}}}, {==}),
        FO.nonneg_add(~F, @M(@A(k1, a1), @S(b1, b0)), @M(@A(k2, b0), @S(a1, a0)), FO.mul_nonneg(~F, @A(k1, a1), @S(b1, b0), FO.nonneg_add(~F, k1, a1, hk1, ha1), db), FO.mul_nonneg(~F, @A(k2, b0), @S(a1, a0), FO.nonneg_add(~F, k2, b0, hk2, hb0), da)))),
    FV.le_of_sub(~F, @S(@A(@A(@M(k1, b1), @M(k2, a1)), @M(a1, b1)), @A(@A(@M(k1, b0), @M(k2, a0)), @M(a0, b0))), @M(@A(@M(m1, l2), @M(m2, l1)), dl),
      FM.nn_eq(~F, @S(@M(@A(@M(m1, l2), @M(m2, l1)), dl), @S(@A(@A(@M(k1, b1), @M(k2, a1)), @M(a1, b1)), @A(@A(@M(k1, b0), @M(k2, a0)), @M(a0, b0)))), @A(@A(@M(@S(m1, @A(k1, a1)), @S(b1, b0)), @M(m1, @S(@M(l2, dl), @S(b1, b0)))), @A(@M(@S(m2, @A(k2, b0)), @S(a1, a0)), @M(m2, @S(@M(l1, dl), @S(a1, a0))))),
        FR.fring_eq(~F, [k1, k2, a0, a1, b0, b1, m1, m2, l1, l2, dl], E.ZAdd{E.ZAdd{E.ZMul{E.ZSub{E.ZVar{6n}, E.ZAdd{E.ZVar{0n}, E.ZVar{3n}}}, E.ZSub{E.ZVar{5n}, E.ZVar{4n}}}, E.ZMul{E.ZVar{6n}, E.ZSub{E.ZMul{E.ZVar{9n}, E.ZVar{10n}}, E.ZSub{E.ZVar{5n}, E.ZVar{4n}}}}}, E.ZAdd{E.ZMul{E.ZSub{E.ZVar{7n}, E.ZAdd{E.ZVar{1n}, E.ZVar{4n}}}, E.ZSub{E.ZVar{3n}, E.ZVar{2n}}}, E.ZMul{E.ZVar{7n}, E.ZSub{E.ZMul{E.ZVar{8n}, E.ZVar{10n}}, E.ZSub{E.ZVar{3n}, E.ZVar{2n}}}}}}, E.ZSub{E.ZMul{E.ZAdd{E.ZMul{E.ZVar{6n}, E.ZVar{9n}}, E.ZMul{E.ZVar{7n}, E.ZVar{8n}}}, E.ZVar{10n}}, E.ZSub{E.ZAdd{E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{5n}}, E.ZMul{E.ZVar{1n}, E.ZVar{3n}}}, E.ZMul{E.ZVar{3n}, E.ZVar{5n}}}, E.ZAdd{E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{4n}}, E.ZMul{E.ZVar{1n}, E.ZVar{2n}}}, E.ZMul{E.ZVar{2n}, E.ZVar{4n}}}}}, {==}),
        FO.nonneg_add(~F, @A(@M(@S(m1, @A(k1, a1)), @S(b1, b0)), @M(m1, @S(@M(l2, dl), @S(b1, b0)))), @A(@M(@S(m2, @A(k2, b0)), @S(a1, a0)), @M(m2, @S(@M(l1, dl), @S(a1, a0)))),
          FO.nonneg_add(~F, @M(@S(m1, @A(k1, a1)), @S(b1, b0)), @M(m1, @S(@M(l2, dl), @S(b1, b0))), FO.mul_nonneg(~F, @S(m1, @A(k1, a1)), @S(b1, b0), fm1, db), FO.mul_nonneg(~F, m1, @S(@M(l2, dl), @S(b1, b0)), m1n, eb_)),
          FO.nonneg_add(~F, @M(@S(m2, @A(k2, b0)), @S(a1, a0)), @M(m2, @S(@M(l1, dl), @S(a1, a0))), FO.mul_nonneg(~F, @S(m2, @A(k2, b0)), @S(a1, a0), fm2, da), FO.mul_nonneg(~F, m2, @S(@M(l1, dl), @S(a1, a0)), m2n, ea_)))))))

def pd_zero(~F: O.OField, +dl: @T, +x: @T, +hx: O.le(~F, @0, x)) -> pd(~F, dl, x, x, @0):
  (hx, (FO.le_refl(~F, x), FV.le_of_sub(~F, @S(x, x), @M(@0, dl), FM.nn_eq(~F, @S(@M(@0, dl), @S(x, x)), @0, FR.fring_eq(~F, [x, dl], E.ZCst{S.Z0{}}, E.ZSub{E.ZMul{E.ZCst{S.Z0{}}, E.ZVar{1n}}, E.ZSub{E.ZVar{0n}, E.ZVar{0n}}}, {==}), FO.le_refl(~F, @0)))))

def pd_one(~F: O.OField, +dl: @T, +x: @T, +hx: O.le(~F, @0, x), +hdl: O.le(~F, @0, dl)) -> pd(~F, dl, x, x, @1):
  (hx, (FO.le_refl(~F, x), FV.le_of_sub(~F, @S(x, x), @M(@1, dl), FM.nn_eq(~F, @S(@M(@1, dl), @S(x, x)), dl, FR.fring_eq(~F, [x, dl], E.ZVar{1n}, E.ZSub{E.ZMul{E.ZCst{S.Zpos{S.XH{}}}, E.ZVar{1n}}, E.ZSub{E.ZVar{0n}, E.ZVar{0n}}}, {==}), hdl))))

@MACRO KH ~K: N.Num, ~F: O.OField, ~H: N.Emb<K, F>
@MACRO KHA ~K, ~F, ~H

# Pairs of balls and of boxes
# ---------------------------

def bpd($KH, +dl: @T, x0: KB.KB<K>, x1: KB.KB<K>, +l: @T) -> Data:
  pd(~F, dl, @H(KB.KB.r(K, x0)), @H(KB.KB.r(K, x1)), l)

# two boxes ball by ball: radii 0 <= r0 <= r1 <= r0 + dl
def bpair($KH, +dl: @T, b0: List<&2, KB.KB<K>>, b1: List<&2, KB.KB<K>>) -> Data:
  match b0 b1:
    case Nil{} Nil{}:
      Unit
    case Nil{} Con{x1, t1}:
      Empty
    case Con{x0, t0} Nil{}:
      Empty
    case Con{x0, t0} Con{x1, t1}:
      M.Both(bpd($KHA, dl, x0, x1, @1), bpair($KHA, dl, t0, t1))

def blook_pd($KH, +dl: @T, +hdl: O.le(~F, @0, dl), b0: List<&2, KB.KB<K>>, b1: List<&2, KB.KB<K>>, i: Nat, h: bpair($KHA, dl, b0, b1)) -> bpd($KHA, dl, KB.blook(~K, b0, i), KB.blook(~K, b1, i), @1):
  match b0 b1 i:
    case Nil{} Nil{} i:
      pd_one(~F, dl, @H(N.nzero(K)), KB.e0_nonneg($KHA), hdl)
    case Nil{} Con{x1, t1} i:
      FO.absurd(bpd($KHA, dl, KB.blook(~K, Nil{}, i), KB.blook(~K, Con{x1, t1}, i), @1), h)
    case Con{x0, t0} Nil{} i:
      FO.absurd(bpd($KHA, dl, KB.blook(~K, Con{x0, t0}, i), KB.blook(~K, Nil{}, i), @1), h)
    case Con{+x0, +t0} Con{+x1, +t1} 0n:
      (h1, h2) = h
      h1
    case Con{+x0, +t0} Con{+x1, +t1} 1n+j:
      (h1, h2) = h
      blook_pd($KHA, dl, hdl, t0, t1, j, h2)

# with the same centers, K's |center| agrees for kball and ksl
def kc_eq($KH, +b0: List<&2, KB.KB<K>>, +b1: List<&2, KB.KB<K>>, +hcen: {BP.cen($KHA, b0) == BP.cen($KHA, b1) : M.Vec(~F)}, +e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}) -> {@H(KA.kabs(~K, KB.KB.c(K, KB.kball(~K, b0, e)))) == @H(KA.kabs(~K, KB.KB.c(K, KB.kball(~K, b1, e)))) : @T}:
  %Equal.sym(@T, @H(KA.kabs(~K, KB.KB.c(K, KB.kball(~K, b0, e)))), FV.fabs(~F, @H(KB.KB.c(K, KB.kball(~K, b0, e)))), kabs_eq($KHA, KB.KB.c(K, KB.kball(~K, b0, e)))) : {_ == @H(KA.kabs(~K, KB.KB.c(K, KB.kball(~K, b1, e)))) : @T}
  %Equal.sym(@T, @H(KA.kabs(~K, KB.KB.c(K, KB.kball(~K, b1, e)))), FV.fabs(~F, @H(KB.KB.c(K, KB.kball(~K, b1, e)))), kabs_eq($KHA, KB.KB.c(K, KB.kball(~K, b1, e)))) : {FV.fabs(~F, @H(KB.KB.c(K, KB.kball(~K, b0, e)))) == _ : @T}
  %Equal.sym(@T, @H(KB.KB.c(K, KB.kball(~K, b0, e))), O.eval(~F, BP.cen($KHA, b0), e), BP.kball_c($KHA, b0, e, hh)) : {FV.fabs(~F, _) == FV.fabs(~F, @H(KB.KB.c(K, KB.kball(~K, b1, e)))) : @T}
  %Equal.sym(@T, @H(KB.KB.c(K, KB.kball(~K, b1, e))), O.eval(~F, BP.cen($KHA, b1), e), BP.kball_c($KHA, b1, e, hh)) : {FV.fabs(~F, O.eval(~F, BP.cen($KHA, b0), e)) == FV.fabs(~F, _) : @T}
  %Equal.sym(M.Vec(~F), BP.cen($KHA, b0), BP.cen($KHA, b1), hcen) : {FV.fabs(~F, O.eval(~F, _, e)) == FV.fabs(~F, O.eval(~F, BP.cen($KHA, b1), e)) : @T}
  {==}

def sc_eq($KH, +b0: List<&2, KB.KB<K>>, +b1: List<&2, KB.KB<K>>, +hcen: {BP.cen($KHA, b0) == BP.cen($KHA, b1) : M.Vec(~F)}, +i: Nat, +e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}) -> {@H(KA.kabs(~K, KB.KB.c(K, KB.ksl(~K, i, b0, e)))) == @H(KA.kabs(~K, KB.KB.c(K, KB.ksl(~K, i, b1, e)))) : @T}:
  %Equal.sym(@T, @H(KA.kabs(~K, KB.KB.c(K, KB.ksl(~K, i, b0, e)))), FV.fabs(~F, @H(KB.KB.c(K, KB.ksl(~K, i, b0, e)))), kabs_eq($KHA, KB.KB.c(K, KB.ksl(~K, i, b0, e)))) : {_ == @H(KA.kabs(~K, KB.KB.c(K, KB.ksl(~K, i, b1, e)))) : @T}
  %Equal.sym(@T, @H(KA.kabs(~K, KB.KB.c(K, KB.ksl(~K, i, b1, e)))), FV.fabs(~F, @H(KB.KB.c(K, KB.ksl(~K, i, b1, e)))), kabs_eq($KHA, KB.KB.c(K, KB.ksl(~K, i, b1, e)))) : {FV.fabs(~F, @H(KB.KB.c(K, KB.ksl(~K, i, b0, e)))) == _ : @T}
  %Equal.sym(@T, @H(KB.KB.c(K, KB.ksl(~K, i, b0, e))), SL.sl(~F, i, BP.cen($KHA, b0), BP.cen($KHA, b0), e), BP.ksl_c($KHA, i, b0, e, hh)) : {FV.fabs(~F, _) == FV.fabs(~F, @H(KB.KB.c(K, KB.ksl(~K, i, b1, e)))) : @T}
  %Equal.sym(@T, @H(KB.KB.c(K, KB.ksl(~K, i, b1, e))), SL.sl(~F, i, BP.cen($KHA, b1), BP.cen($KHA, b1), e), BP.ksl_c($KHA, i, b1, e, hh)) : {FV.fabs(~F, SL.sl(~F, i, BP.cen($KHA, b0), BP.cen($KHA, b0), e)) == FV.fabs(~F, _) : @T}
  %Equal.sym(M.Vec(~F), BP.cen($KHA, b0), BP.cen($KHA, b1), hcen) : {FV.fabs(~F, SL.sl(~F, i, _, _, e)) == FV.fabs(~F, SL.sl(~F, i, BP.cen($KHA, b1), BP.cen($KHA, b1), e)) : @T}
  {==}

def pd_badd($KH, +dl: @T, x0: KB.KB<K>, y0: KB.KB<K>, x1: KB.KB<K>, y1: KB.KB<K>, +l1: @T, +l2: @T, +hx: bpd($KHA, dl, x0, x1, l1), +hy: bpd($KHA, dl, y0, y1, l2)) -> bpd($KHA, dl, KB.badd(~K, x0, y0), KB.badd(~K, x1, y1), @A(l1, l2)):
  match x0 y0 x1 y1:
    case KB.KB{+c1, +r1} KB.KB{+c2, +r2} KB.KB{+d1, +s1} KB.KB{+d2, +s2}:
      %KA.ea($KHA, r1, r2) : pd(~F, dl, _, @H(N.nadd(K, s1, s2)), @A(l1, l2))
      %KA.ea($KHA, s1, s2) : pd(~F, dl, @A(@H(r1), @H(r2)), _, @A(l1, l2))
      pd_add(~F, dl, @H(r1), @H(s1), l1, @H(r2), @H(s2), l2, hx, hy)

def pd_bneg($KH, +dl: @T, x0: KB.KB<K>, x1: KB.KB<K>, +l: @T, +hx: bpd($KHA, dl, x0, x1, l)) -> bpd($KHA, dl, KB.bneg(~K, x0), KB.bneg(~K, x1), l):
  match x0 x1:
    case KB.KB{+c1, +r1} KB.KB{+d1, +s1}:
      hx

# |c| + r <= m from a grade
def gr_m($KH, +rho: @T, +x: KB.KB<K>, +m: @T, +l: @T, +g: BP.grade($KHA, rho, x, m, l)) -> O.le(~F, @A(@H(KA.kabs(~K, KB.KB.c(K, x))), @H(KB.KB.r(K, x))), m):
  %Equal.sym(@T, @H(KA.kabs(~K, KB.KB.c(K, x))), FV.fabs(~F, @H(KB.KB.c(K, x))), kabs_eq($KHA, KB.KB.c(K, x))) : O.le(~F, @A(_, @H(KB.KB.r(K, x))), m)
  FV.le_of_sub(~F, @A(FV.fabs(~F, @H(KB.KB.c(K, x))), @H(KB.KB.r(K, x))), m, FM.nn_eq(~F, @S(m, @A(FV.fabs(~F, @H(KB.KB.c(K, x))), @H(KB.KB.r(K, x)))), @S(@S(m, @H(KB.KB.r(K, x))), FV.fabs(~F, @H(KB.KB.c(K, x)))), FR.fring_eq(~F, [m, @H(KB.KB.r(K, x)), FV.fabs(~F, @H(KB.KB.c(K, x)))], E.ZSub{E.ZSub{E.ZVar{0n}, E.ZVar{1n}}, E.ZVar{2n}}, E.ZSub{E.ZVar{0n}, E.ZAdd{E.ZVar{2n}, E.ZVar{1n}}}, {==}),
    FM.sub_nonneg(~F, FV.fabs(~F, @H(KB.KB.c(K, x))), @S(m, @H(KB.KB.r(K, x))), FV.fabs_le(~F, @H(KB.KB.c(K, x)), @S(m, @H(KB.KB.r(K, x))), BP.gf_c(~F, rho, @H(KB.KB.c(K, x)), @H(KB.KB.r(K, x)), m, l, g)))))

def pd_bmul($KH, +dl: @T, +rho: @T, x0: KB.KB<K>, y0: KB.KB<K>, x1: KB.KB<K>, y1: KB.KB<K>, +l1: @T, +m1: @T, +l2: @T, +m2: @T, +lx: @T, +ly: @T, +ek1: {@H(KA.kabs(~K, KB.KB.c(K, x0))) == @H(KA.kabs(~K, KB.KB.c(K, x1))) : @T}, +ek2: {@H(KA.kabs(~K, KB.KB.c(K, y0))) == @H(KA.kabs(~K, KB.KB.c(K, y1))) : @T}, +hx: bpd($KHA, dl, x0, x1, l1), +hy: bpd($KHA, dl, y0, y1, l2), +gx: BP.grade($KHA, rho, x1, m1, lx), +gy: BP.grade($KHA, rho, y1, m2, ly)) -> bpd($KHA, dl, KB.bmul(~K, x0, y0), KB.bmul(~K, x1, y1), @A(@M(m1, l2), @M(m2, l1))):
  match x0 y0 x1 y1:
    case KB.KB{+c1, +r1} KB.KB{+c2, +r2} KB.KB{+d1, +s1} KB.KB{+d2, +s2}:
      %Equal.sym(@T, @H(N.nadd(K, N.nadd(K, N.nmul(K, KA.kabs(~K, c1), r2), N.nmul(K, KA.kabs(~K, c2), r1)), N.nmul(K, r1, r2))), @A(@A(@M(@H(KA.kabs(~K, c1)), @H(r2)), @M(@H(KA.kabs(~K, c2)), @H(r1))), @M(@H(r1), @H(r2))), BP.bmul_r($KHA, c1, r1, c2, r2)) : pd(~F, dl, _, @H(N.nadd(K, N.nadd(K, N.nmul(K, KA.kabs(~K, d1), s2), N.nmul(K, KA.kabs(~K, d2), s1)), N.nmul(K, s1, s2))), @A(@M(m1, l2), @M(m2, l1)))
      %Equal.sym(@T, @H(N.nadd(K, N.nadd(K, N.nmul(K, KA.kabs(~K, d1), s2), N.nmul(K, KA.kabs(~K, d2), s1)), N.nmul(K, s1, s2))), @A(@A(@M(@H(KA.kabs(~K, d1)), @H(s2)), @M(@H(KA.kabs(~K, d2)), @H(s1))), @M(@H(s1), @H(s2))), BP.bmul_r($KHA, d1, s1, d2, s2)) : pd(~F, dl, @A(@A(@M(@H(KA.kabs(~K, c1)), @H(r2)), @M(@H(KA.kabs(~K, c2)), @H(r1))), @M(@H(r1), @H(r2))), _, @A(@M(m1, l2), @M(m2, l1)))
      %Equal.sym(@T, @H(KA.kabs(~K, c1)), @H(KA.kabs(~K, d1)), ek1) : pd(~F, dl, @A(@A(@M(_, @H(r2)), @M(@H(KA.kabs(~K, c2)), @H(r1))), @M(@H(r1), @H(r2))), @A(@A(@M(@H(KA.kabs(~K, d1)), @H(s2)), @M(@H(KA.kabs(~K, d2)), @H(s1))), @M(@H(s1), @H(s2))), @A(@M(m1, l2), @M(m2, l1)))
      %Equal.sym(@T, @H(KA.kabs(~K, c2)), @H(KA.kabs(~K, d2)), ek2) : pd(~F, dl, @A(@A(@M(@H(KA.kabs(~K, d1)), @H(r2)), @M(_, @H(r1))), @M(@H(r1), @H(r2))), @A(@A(@M(@H(KA.kabs(~K, d1)), @H(s2)), @M(@H(KA.kabs(~K, d2)), @H(s1))), @M(@H(s1), @H(s2))), @A(@M(m1, l2), @M(m2, l1)))
      pd_mul(~F, dl, @H(KA.kabs(~K, d1)), @H(KA.kabs(~K, d2)), @H(r1), @H(s1), l1, m1, @H(r2), @H(s2), l2, m2, KA.kabs_nonneg($KHA, d1), KA.kabs_nonneg($KHA, d2), hx, hy, gr_m($KHA, rho, KB.KB{d1, s1}, m1, lx, gx), gr_m($KHA, rho, KB.KB{d2, s2}, m2, ly, gy))

@MACRO PBP +dl: @T, +rho: @T, +bb: @T, +hdl: O.le(~F, @0, dl), +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +b0: List<&2, KB.KB<K>>, +b1: List<&2, KB.KB<K>>, +hcen: {BP.cen($KHA, b0) == BP.cen($KHA, b1) : M.Vec(~F)}, +hp: bpair($KHA, dl, b0, b1), +hg: BP.gbox($KHA, rho, bb, b1)
@MACRO PBA dl, rho, bb, hdl, hr, hb, b0, b1, hcen, hp, hg

# e's ball over the wider box: radius at most lp dl more
def kb_pd($KH, $PBP, e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}) -> bpd($KHA, dl, KB.kball(~K, b0, e), KB.kball(~K, b1, e), BP.lp(~F, bb, e)):
  match e:
    case E.QVar{i}:
      blook_pd($KHA, dl, hdl, b0, b1, i, hp)
    case E.QCst{+q}:
      pd_zero(~F, dl, @H(N.nzero(K)), KB.e0_nonneg($KHA))
    case E.QAdd{+a, +b}:
      pd_badd($KHA, dl, KB.kball(~K, b0, a), KB.kball(~K, b0, b), KB.kball(~K, b1, a), KB.kball(~K, b1, b), BP.lp(~F, bb, a), BP.lp(~F, bb, b), kb_pd($KHA, $PBA, a, KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)), kb_pd($KHA, $PBA, b, KA.band_r(KB.held(~K, a), KB.held(~K, b), hh)))
    case E.QSub{+a, +b}:
      pd_badd($KHA, dl, KB.kball(~K, b0, a), KB.bneg(~K, KB.kball(~K, b0, b)), KB.kball(~K, b1, a), KB.bneg(~K, KB.kball(~K, b1, b)), BP.lp(~F, bb, a), BP.lp(~F, bb, b), kb_pd($KHA, $PBA, a, KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)), pd_bneg($KHA, dl, KB.kball(~K, b0, b), KB.kball(~K, b1, b), BP.lp(~F, bb, b), kb_pd($KHA, $PBA, b, KA.band_r(KB.held(~K, a), KB.held(~K, b), hh))))
    case E.QMul{+a, +b}:
      +ha = KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)
      +hb2 = KA.band_r(KB.held(~K, a), KB.held(~K, b), hh)
      pd_bmul($KHA, dl, rho, KB.kball(~K, b0, a), KB.kball(~K, b0, b), KB.kball(~K, b1, a), KB.kball(~K, b1, b), BP.lp(~F, bb, a), BP.mj(~F, bb, a), BP.lp(~F, bb, b), BP.mj(~F, bb, b), BP.lp(~F, bb, a), BP.lp(~F, bb, b), kc_eq($KHA, b0, b1, hcen, a, ha), kc_eq($KHA, b0, b1, hcen, b, hb2), kb_pd($KHA, $PBA, a, ha), kb_pd($KHA, $PBA, b, hb2), BP.kball_grade($KHA, rho, bb, hr, hb, b1, hg, a, ha), BP.kball_grade($KHA, rho, bb, hr, hb, b1, hg, b, hb2))
    case E.QNeg{+a}:
      pd_bneg($KHA, dl, KB.kball(~K, b0, a), KB.kball(~K, b1, a), BP.lp(~F, bb, a), kb_pd($KHA, $PBA, a, hh))

def kind_pd($KH, +dl: @T, b: Bool) -> bpd($KHA, dl, KB.kind(~K, b), KB.kind(~K, b), @0):
  match b:
    case True{}:
      pd_zero(~F, dl, @H(N.nzero(K)), KB.e0_nonneg($KHA))
    case False{}:
      pd_zero(~F, dl, @H(N.nzero(K)), KB.e0_nonneg($KHA))

# e's slope ball in variable i over the wider box: radius at most ls dl more
def ks_pd($KH, $PBP, +i: Nat, e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}) -> bpd($KHA, dl, KB.ksl(~K, i, b0, e), KB.ksl(~K, i, b1, e), BP.ls(~F, bb, e)):
  match e:
    case E.QVar{j}:
      kind_pd($KHA, dl, KA.nateq(i, j))
    case E.QCst{q}:
      pd_zero(~F, dl, @H(N.nzero(K)), KB.e0_nonneg($KHA))
    case E.QAdd{+a, +b}:
      pd_badd($KHA, dl, KB.ksl(~K, i, b0, a), KB.ksl(~K, i, b0, b), KB.ksl(~K, i, b1, a), KB.ksl(~K, i, b1, b), BP.ls(~F, bb, a), BP.ls(~F, bb, b), ks_pd($KHA, $PBA, i, a, KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)), ks_pd($KHA, $PBA, i, b, KA.band_r(KB.held(~K, a), KB.held(~K, b), hh)))
    case E.QSub{+a, +b}:
      pd_badd($KHA, dl, KB.ksl(~K, i, b0, a), KB.bneg(~K, KB.ksl(~K, i, b0, b)), KB.ksl(~K, i, b1, a), KB.bneg(~K, KB.ksl(~K, i, b1, b)), BP.ls(~F, bb, a), BP.ls(~F, bb, b), ks_pd($KHA, $PBA, i, a, KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)), pd_bneg($KHA, dl, KB.ksl(~K, i, b0, b), KB.ksl(~K, i, b1, b), BP.ls(~F, bb, b), ks_pd($KHA, $PBA, i, b, KA.band_r(KB.held(~K, a), KB.held(~K, b), hh))))
    case E.QMul{+a, +b}:
      +ha = KA.band_l(KB.held(~K, a), KB.held(~K, b), hh)
      +hb2 = KA.band_r(KB.held(~K, a), KB.held(~K, b), hh)
      pd_badd($KHA, dl, KB.bmul(~K, KB.kball(~K, b0, a), KB.ksl(~K, i, b0, b)), KB.bmul(~K, KB.kball(~K, b0, b), KB.ksl(~K, i, b0, a)), KB.bmul(~K, KB.kball(~K, b1, a), KB.ksl(~K, i, b1, b)), KB.bmul(~K, KB.kball(~K, b1, b), KB.ksl(~K, i, b1, a)), @A(@M(BP.mj(~F, bb, a), BP.ls(~F, bb, b)), @M(BP.ms(~F, bb, b), BP.lp(~F, bb, a))), @A(@M(BP.mj(~F, bb, b), BP.ls(~F, bb, a)), @M(BP.ms(~F, bb, a), BP.lp(~F, bb, b))),
        pd_bmul($KHA, dl, rho, KB.kball(~K, b0, a), KB.ksl(~K, i, b0, b), KB.kball(~K, b1, a), KB.ksl(~K, i, b1, b), BP.lp(~F, bb, a), BP.mj(~F, bb, a), BP.ls(~F, bb, b), BP.ms(~F, bb, b), BP.lp(~F, bb, a), BP.ls(~F, bb, b), kc_eq($KHA, b0, b1, hcen, a, ha), sc_eq($KHA, b0, b1, hcen, i, b, hb2), kb_pd($KHA, $PBA, a, ha), ks_pd($KHA, $PBA, i, b, hb2), BP.kball_grade($KHA, rho, bb, hr, hb, b1, hg, a, ha), BP.ksl_grade($KHA, rho, bb, hr, hb, b1, hg, i, b, hb2)),
        pd_bmul($KHA, dl, rho, KB.kball(~K, b0, b), KB.ksl(~K, i, b0, a), KB.kball(~K, b1, b), KB.ksl(~K, i, b1, a), BP.lp(~F, bb, b), BP.mj(~F, bb, b), BP.ls(~F, bb, a), BP.ms(~F, bb, a), BP.lp(~F, bb, b), BP.ls(~F, bb, a), kc_eq($KHA, b0, b1, hcen, b, hb2), sc_eq($KHA, b0, b1, hcen, i, a, ha), kb_pd($KHA, $PBA, b, hb2), ks_pd($KHA, $PBA, i, a, ha), BP.kball_grade($KHA, rho, bb, hr, hb, b1, hg, b, hb2), BP.ksl_grade($KHA, rho, bb, hr, hb, b1, hg, i, a, ha)))
    case E.QNeg{+a}:
      pd_bneg($KHA, dl, KB.ksl(~K, i, b0, a), KB.ksl(~K, i, b1, a), BP.ls(~F, bb, a), ks_pd($KHA, $PBA, i, a, hh))
