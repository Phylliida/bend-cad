# E <= S + D, D <= (thL + yn nl) E and c65 (thL + yn nl) <= c65 - 1 give E <= S c65
def in_fin(~F: O.OField, +ee: @T, +s: @T, +dd: @T, +thL: @T, +yn: @T, +nl: @T, +c65: @T, +hE: O.le(~F, ee, @A(s, dd)), +hD: O.le(~F, dd, @A(@M(thL, ee), @M(yn, @M(nl, ee)))), +hk: O.le(~F, @M(c65, @A(thL, @M(yn, nl))), @S(c65, @1)), +hc0: O.le(~F, @0, c65), +hE0: O.le(~F, @0, ee)) -> O.le(~F, ee, @M(s, c65)):
  FV.le_of_sub(~F, ee, @M(s, c65), FM.nn_eq(~F, @S(@M(s, c65), ee), @A(@A(@M(c65, @S(@A(s, dd), ee)), @M(c65, @S(@A(@M(thL, ee), @M(yn, @M(nl, ee))), dd))), @M(@S(@S(c65, @1), @M(c65, @A(thL, @M(yn, nl)))), ee)),
    FR.fring_eq(~F, [ee, s, dd, thL, yn, nl, c65], E.ZAdd{E.ZAdd{E.ZMul{E.ZVar{6n}, E.ZSub{E.ZAdd{E.ZVar{1n}, E.ZVar{2n}}, E.ZVar{0n}}}, E.ZMul{E.ZVar{6n}, E.ZSub{E.ZAdd{E.ZMul{E.ZVar{3n}, E.ZVar{0n}}, E.ZMul{E.ZVar{4n}, E.ZMul{E.ZVar{5n}, E.ZVar{0n}}}}, E.ZVar{2n}}}}, E.ZMul{E.ZSub{E.ZSub{E.ZVar{6n}, E.ZCst{S.Zpos{S.XH{}}}}, E.ZMul{E.ZVar{6n}, E.ZAdd{E.ZVar{3n}, E.ZMul{E.ZVar{4n}, E.ZVar{5n}}}}}, E.ZVar{0n}}}, E.ZSub{E.ZMul{E.ZVar{1n}, E.ZVar{6n}}, E.ZVar{0n}}, {==}),
    FO.nonneg_add(~F, @A(@M(c65, @S(@A(s, dd), ee)), @M(c65, @S(@A(@M(thL, ee), @M(yn, @M(nl, ee))), dd))), @M(@S(@S(c65, @1), @M(c65, @A(thL, @M(yn, nl)))), ee),
      FO.nonneg_add(~F, @M(c65, @S(@A(s, dd), ee)), @M(c65, @S(@A(@M(thL, ee), @M(yn, @M(nl, ee))), dd)), FO.mul_nonneg(~F, c65, @S(@A(s, dd), ee), hc0, sub_nn(~F, ee, @A(s, dd), hE)), FO.mul_nonneg(~F, c65, @S(@A(@M(thL, ee), @M(yn, @M(nl, ee))), dd), hc0, sub_nn(~F, dd, @A(@M(thL, ee), @M(yn, @M(nl, ee))), hD))),
      FO.mul_nonneg(~F, @S(@S(c65, @1), @M(c65, @A(thL, @M(yn, nl)))), ee, sub_nn(~F, @M(c65, @A(thL, @M(yn, nl))), @S(c65, @1), hk), hE0))))

@MACRO YC M.ofdv(~F, yc)
@MACRO PZ M.ofdv(~F, pc)
@MACRO ZZ C.app(~F, $YC, xz)
@MACRO XBZ C.app(~F, xb, xz)
@MACRO EE BX.vsub(~F, $YC, xb)
@MACRO SP CP.smat(~F, $ZZ, $XBZ, eqs, n, 0n)
@MACRO YK N.ofkm($DH, ym)
@MACRO FZ C.fvals(~F, eqs, $ZZ)
@MACRO FP C.fvals(~F, eqs, $PTC)
@MACRO QV BX.vsub(~F, $EE, M.matvec(~F, $YK, M.matvec(~F, $SP, $EE)))
@MACRO BX0 CK.box($DN, n, yc, Nil{}, pc, pr)
@MACRO MZ0 N.ofkm($DH, mzm($DH, $BX0, KA.klen($DN, pc), n, eqs))
@MACRO JCP NW.jc(~F, eqs, n, $PTC)
@MACRO NL @M(FR.ofn(~F, n), @M(lam, rad))

def lyc_d(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +yc: List<&2, S.D>, +lyc: {KA.klen($DN, yc) == n : Nat}) -> {M.len(~F, M.ofdv(~F, yc)) == n : Nat}:
  Equal.trans(Nat, M.len(~F, M.ofdv(~F, yc)), KA.klen($DN, yc), n, Equal.sym(Nat, KA.klen($DN, yc), M.len(~F, M.ofdv(~F, yc)), klen_d(~F, ~H, yc)), lyc)

def fit_d(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +yc: List<&2, S.D>, +lyc: {KA.klen($DN, yc) == n : Nat}) -> {C.fit(~F, n, N.ofkv($DH, yc)) == M.ofdv(~F, yc) : M.Vec(~F)}:
  Equal.trans(M.Vec(~F), C.fit(~F, n, N.ofkv($DH, yc)), N.ofkv($DH, yc), M.ofdv(~F, yc), FV.fit_len(~F, n, N.ofkv($DH, yc), Equal.trans(Nat, M.len(~F, N.ofkv($DH, yc)), KA.klen($DN, yc), n, CP.len_ofkv($DH, yc), lyc)), AP.ofkv_d(~F, ~H, yc))

# a point with unknowns yc and parameters in the balls lies in the radius-0 box
def inb_d(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +yc: List<&2, S.D>, +pc: List<&2, S.D>, +pr: List<&2, S.D>, +lyc: {KA.klen($DN, yc) == n : Nat}, +z: M.Vec(~F), +hz: BX.rbnd(~F, BX.vsub(~F, z, N.ofkv($DH, pc)), N.ofkv($DH, pr)), +hnp: FV.rnn(~F, N.ofkv($DH, pr))) -> KB.inbox($DH, C.app(~F, M.ofdv(~F, yc), z), CK.box($DN, n, yc, Nil{}, pc, pr)):
  %fit_d(~F, ~H, n, yc, lyc) : KB.inbox($DH, C.app(~F, _, z), CK.box($DN, n, yc, Nil{}, pc, pr))
  CP.box_in($DH, n, N.ofkv($DH, yc), z, yc, Nil{}, pc, pr, FV.rbnd_self(~F, N.ofkv($DH, yc), N.ofkv($DH, Nil{}), Unit{}), Equal.trans(Nat, M.len(~F, N.ofkv($DH, yc)), KA.klen($DN, yc), n, CP.len_ofkv($DH, yc), lyc), lyc, Unit{}, hz, hnp)

def zr_k(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +xz: M.Vec(~F), +pc: List<&2, S.D>, +pr: List<&2, S.D>, +h: BX.rbnd(~F, BX.vsub(~F, xz, M.ofdv(~F, pc)), M.ofdv(~F, pr))) -> BX.rbnd(~F, BX.vsub(~F, xz, M.ofdv(~F, pc)), N.ofkv($DH, pr)):
  %Equal.sym(M.Vec(~F), N.ofkv($DH, pr), M.ofdv(~F, pr), AP.ofkv_d(~F, ~H, pr)) : BX.rbnd(~F, BX.vsub(~F, xz, M.ofdv(~F, pc)), _)
  h

def zr_kk(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +xz: M.Vec(~F), +pc: List<&2, S.D>, +pr: List<&2, S.D>, +h: BX.rbnd(~F, BX.vsub(~F, xz, M.ofdv(~F, pc)), M.ofdv(~F, pr))) -> BX.rbnd(~F, BX.vsub(~F, xz, N.ofkv($DH, pc)), N.ofkv($DH, pr)):
  %Equal.sym(M.Vec(~F), N.ofkv($DH, pc), M.ofdv(~F, pc), AP.ofkv_d(~F, ~H, pc)) : BX.rbnd(~F, BX.vsub(~F, xz, _), N.ofkv($DH, pr))
  zr_k(~F, ~H, xz, pc, pr, h)

def zr_p(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +pc: List<&2, S.D>, +pr: List<&2, S.D>, +hnp: FV.rnn(~F, N.ofkv($DH, pr))) -> BX.rbnd(~F, BX.vsub(~F, M.ofdv(~F, pc), N.ofkv($DH, pc)), N.ofkv($DH, pr)):
  %Equal.sym(M.Vec(~F), N.ofkv($DH, pc), M.ofdv(~F, pc), AP.ofkv_d(~F, ~H, pc)) : BX.rbnd(~F, BX.vsub(~F, M.ofdv(~F, pc), _), N.ofkv($DH, pr))
  FV.rbnd_self(~F, M.ofdv(~F, pc), N.ofkv($DH, pr), hnp)

@MACRO IBP ~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +eqs: List<&2, E.QExpr>, +hn: {CK.eqlen(eqs) == n : Nat}, +hh: {CK.allheld($DN, eqs) == True{} : Bool}, +yc: List<&2, S.D>, +pc: List<&2, S.D>, +pr: List<&2, S.D>, +hab: {CK.allbelow(Nat.add(n, KA.klen($DN, pc)), eqs) == True{} : Bool}, +lyc: {KA.klen($DN, yc) == n : Nat}, +ym: List<&2, List<&2, S.D>>, +hpn: FV.rnn(~F, M.ofdv(~F, pr)), +xb: M.Vec(~F), +xz: M.Vec(~F), +lxb: {M.len(~F, xb) == n : Nat}, +lxz: {M.len(~F, xz) == KA.klen($DN, pc) : Nat}, +hz: {C.fvals(~F, eqs, $XBZ) == GJ.zeros(~F, n) : M.Vec(~F)}, +hzr: BX.rbnd(~F, BX.vsub(~F, xz, M.ofdv(~F, pc)), M.ofdv(~F, pr))
@MACRO IBA ~F, ~H, n, eqs, hn, hh, yc, pc, pr, hab, lyc, ym, hpn, xb, xz, lxb, lxz, hz, hzr

# the unknowns' slopes at x_z carry e to f(Z)
def se_eq($IBP) -> {M.matvec(~F, $SP, $EE) == $FZ : M.Vec(~F)}:
  %CP.fvecs_con(~F, $YC, xb, xz, eqs, n, KA.klen($DN, pc), hab, lyc_d(~F, ~H, n, yc, lyc), lxb) : {_ == $FZ : M.Vec(~F)}
  %Equal.sym(M.Vec(~F), C.fvals(~F, eqs, $XBZ), GJ.zeros(~F, n), hz) : {BX.vsub(~F, $FZ, _) == $FZ : M.Vec(~F)}
  vsub_zeros(~F, $FZ, n, Equal.trans(Nat, M.len(~F, $FZ), CK.eqlen(eqs), n, CP.len_fvals(~F, eqs, $ZZ), hn))

# |Y f(P)| entrywise is the checker's first term
def yf_bnd($IBP) -> BX.rbnd(~F, M.matvec(~F, $YK, $FP), N.ofkv($DH, ayf($SVA))):
  %fit_d(~F, ~H, n, yc, lyc) : BX.rbnd(~F, M.matvec(~F, $YK, C.fvals(~F, eqs, C.app(~F, _, $PZ))), N.ofkv($DH, ayf($SVA)))
  %AP.ofkv_d(~F, ~H, pc) : BX.rbnd(~F, M.matvec(~F, $YK, C.fvals(~F, eqs, C.app(~F, C.fit(~F, n, N.ofkv($DH, yc)), _))), N.ofkv($DH, ayf($SVA)))
  FV.rbnd_rw(~F, N.ofkv($DH, KA.kmatvec($DN, ym, CK.kvals($DN, KA.kapp($DN, yc, pc), eqs))), M.matvec(~F, $YK, C.fvals(~F, eqs, C.app(~F, C.fit(~F, n, N.ofkv($DH, yc)), N.ofkv($DH, pc)))), N.ofkv($DH, ayf($SVA)),
    Equal.sym(M.Vec(~F), M.matvec(~F, $YK, C.fvals(~F, eqs, C.app(~F, C.fit(~F, n, N.ofkv($DH, yc)), N.ofkv($DH, pc)))), N.ofkv($DH, KA.kmatvec($DN, ym, CK.kvals($DN, KA.kapp($DN, yc, pc), eqs))), CP.yft_ok($DH, eqs, n, yc, ym, pc, hh, Equal.trans(Nat, M.len(~F, N.ofkv($DH, yc)), KA.klen($DN, yc), n, CP.len_ofkv($DH, yc), lyc))),
    KA.kvabs_bnd($DH, KA.kmatvec($DN, ym, CK.kvals($DN, KA.kapp($DN, yc, pc), eqs))))

def b0_nn($IBP) -> FV.rnn(~F, N.ofkv($DH, bk($SVA, Nil{}))):
  +inP = inb_d(~F, ~H, n, yc, pc, pr, lyc, $PZ, zr_p(~F, ~H, pc, pr, rnn_kv(~F, ~H, pr, hpn)), rnn_kv(~F, ~H, pr, hpn))
  %Equal.sym(M.Vec(~F), N.ofkv($DH, bk($SVA, Nil{})), M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, ym)), M.matvec(~F, $MZ0, N.ofkv($DH, pr))), bf_eq($SVA, Nil{})) : FV.rnn(~F, _)
  FV.matvec_nonneg(~F, N.ofkm($DH, KA.kmabs($DN, ym)), M.matvec(~F, $MZ0, N.ofkv($DH, pr)), KA.kmabs_nn($DH, ym), FV.matvec_nonneg(~F, $MZ0, N.ofkv($DH, pr), CP.mat_nnz($DH, $PTC, $PTC, $BX0, eqs, KA.klen($DN, pc), n, hh, inP, inP), rnn_kv(~F, ~H, pr, hpn)))

# the parameter step, over the radius-0 box: |Y (f(Z) - f(P))| <= B(0) entrywise
def bz_bnd($IBP) -> BX.rbnd(~F, M.matvec(~F, $YK, BX.vsub(~F, $FZ, $FP)), N.ofkv($DH, bk($SVA, Nil{}))):
  +m = KA.klen($DN, pc)
  +pk = N.ofkv($DH, pr)
  +hpk = rnn_kv(~F, ~H, pr, hpn)
  +sy0 = CP.smat(~F, $ZZ, $PTC, eqs, n, 0n)
  +sz0 = CP.smat(~F, $ZZ, $PTC, eqs, m, n)
  +inZ = inb_d(~F, ~H, n, yc, pc, pr, lyc, xz, zr_kk(~F, ~H, xz, pc, pr, hzr), hpk)
  +inP = inb_d(~F, ~H, n, yc, pc, pr, lyc, $PZ, zr_p(~F, ~H, pc, pr, hpk), hpk)
  +hmzn = CP.mat_nnz($DH, $ZZ, $PTC, $BX0, eqs, m, n, hh, inZ, inP)
  +hW = FV.mbnd_matvec(~F, sz0, $MZ0, BX.vsub(~F, xz, $PZ), pk, CP.mat_bndz($DH, $ZZ, $PTC, $BX0, eqs, m, n, hh, inZ, inP), zr_k(~F, ~H, xz, pc, pr, hzr), hmzn, hpk)
  +hA0 = vall_z(~F, M.matvec(~F, sy0, BX.vsub(~F, $YC, $YC)), NP.mnorm(~F, sy0, M.len(~F, BX.vsub(~F, $YC, $YC))), NP.mv_le(~F, sy0, BX.vsub(~F, $YC, $YC), @0, NW.vall_self(~F, $YC, @0, FO.le_refl(~F, @0)), FO.le_refl(~F, @0)))
  +hAW = rbnd_add0(~F, M.matvec(~F, sy0, BX.vsub(~F, $YC, $YC)), M.matvec(~F, sz0, BX.vsub(~F, xz, $PZ)), M.matvec(~F, $MZ0, pk), hA0, hW, FV.matvec_nonneg(~F, $MZ0, pk, hmzn, hpk))
  %Equal.sym(M.Vec(~F), N.ofkv($DH, bk($SVA, Nil{})), M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, ym)), M.matvec(~F, $MZ0, pk)), bf_eq($SVA, Nil{})) : BX.rbnd(~F, M.matvec(~F, $YK, BX.vsub(~F, $FZ, $FP)), _)
  %Equal.sym(M.Vec(~F), BX.vsub(~F, $FZ, $FP), M.vadd(~F, M.matvec(~F, sy0, BX.vsub(~F, $YC, $YC)), M.matvec(~F, sz0, BX.vsub(~F, xz, $PZ))), CP.fvecs_self(~F, $YC, $YC, xz, $PZ, eqs, n, m, hab, lyc_d(~F, ~H, n, yc, lyc), lyc_d(~F, ~H, n, yc, lyc))) : BX.rbnd(~F, M.matvec(~F, $YK, _), M.matvec(~F, N.ofkm($DH, KA.kmabs($DN, ym)), M.matvec(~F, $MZ0, pk)))
  FV.mbnd_matvec(~F, $YK, N.ofkm($DH, KA.kmabs($DN, ym)), M.vadd(~F, M.matvec(~F, sy0, BX.vsub(~F, $YC, $YC)), M.matvec(~F, sz0, BX.vsub(~F, xz, $PZ))), M.matvec(~F, $MZ0, pk), KA.kmabs_bnd($DH, ym), hAW, KA.kmabs_nn($DH, ym), FV.matvec_nonneg(~F, $MZ0, pk, hmzn, hpk))

def hq_at($IBP, +k: Nat) -> M.bnd(~F, @S(O.lookup(~F, $EE, k), O.lookup(~F, M.matvec(~F, $YK, $FZ), k)), NP.vn(~F, $QV)):
  %se_eq($IBA) : M.bnd(~F, @S(O.lookup(~F, $EE, k), O.lookup(~F, M.matvec(~F, $YK, _), k)), NP.vn(~F, $QV))
  %DG.look_diff(~F, $EE, M.matvec(~F, $YK, M.matvec(~F, $SP, $EE)), k) : M.bnd(~F, _, NP.vn(~F, $QV))
  AP.lkb(~F, $QV, k)

def ht_at($IBP, +k: Nat) -> M.bnd(~F, @S(O.lookup(~F, M.matvec(~F, $YK, $FZ), k), O.lookup(~F, M.matvec(~F, $YK, $FP), k)), O.lookup(~F, N.ofkv($DH, bk($SVA, Nil{})), k)):
  %DG.look_diff(~F, M.matvec(~F, $YK, $FZ), M.matvec(~F, $YK, $FP), k) : M.bnd(~F, _, O.lookup(~F, N.ofkv($DH, bk($SVA, Nil{})), k))
  %AP.mv_vsub(~F, $YK, $FZ, $FP) : M.bnd(~F, O.lookup(~F, _, k), O.lookup(~F, N.ofkv($DH, bk($SVA, Nil{})), k))
  rbnd_at(~F, M.matvec(~F, $YK, BX.vsub(~F, $FZ, $FP)), N.ofkv($DH, bk($SVA, Nil{})), k, bz_bnd($IBA), b0_nn($IBA))

def hs_at($IBP, +k: Nat) -> O.le(~F, @A(@A(O.lookup(~F, N.ofkv($DH, ayf($SVA)), k), O.lookup(~F, $B0, k)), O.lookup(~F, $G0, k)), $SD):
  RL.le_rw_l(~F, O.lookup(~F, M.vadd(~F, M.vadd(~F, N.ofkv($DH, ayf($SVA)), $B0), $G0), k), @A(@A(O.lookup(~F, N.ofkv($DH, ayf($SVA)), k), O.lookup(~F, $B0, k)), O.lookup(~F, $G0, k)), $SD, lk3(~F, N.ofkv($DH, ayf($SVA)), $B0, $G0, k),
    (%svec_f($SVA, Nil{}) : O.le(~F, O.lookup(~F, _, k), $SD)
      (%Equal.sym(M.Vec(~F), N.ofkv($DH, $S0), M.ofdv(~F, $S0), AP.ofkv_d(~F, ~H, $S0)) : O.le(~F, O.lookup(~F, _, k), $SD)
        dvmax_at(~F, $S0, k))))

# entry k: |e_k| <= S + |e - Y S' e|
def in_at($IBP, +k: Nat) -> M.bnd(~F, O.lookup(~F, $EE, k), @A($SD, NP.vn(~F, $QV))):
  in_ent(~F, O.lookup(~F, $EE, k), O.lookup(~F, M.matvec(~F, $YK, $FZ), k), O.lookup(~F, M.matvec(~F, $YK, $FP), k), O.lookup(~F, N.ofkv($DH, ayf($SVA)), k), O.lookup(~F, $B0, k), O.lookup(~F, $G0, k), $SD, NP.vn(~F, $QV), NP.vn(~F, $G0),
    hq_at($IBA, k), ht_at($IBA, k),
    rbnd_at(~F, M.matvec(~F, $YK, $FP), N.ofkv($DH, ayf($SVA)), k, yf_bnd($IBA), KA.kvabs_nn($DH, KA.kmatvec($DN, ym, CK.kvals($DN, KA.kapp($DN, yc, pc), eqs)))),
    hs_at($IBA, k), AP.lkb(~F, $G0, k), g0_bnd($SVA))

@MACRO YSE M.matvec(~F, $YK, M.matvec(~F, $SP, $EE))
@MACRO YJE M.matvec(~F, $YK, M.matvec(~F, $JCP, $EE))
@MACRO PV BX.vsub(~F, $EE, $YJE)
@MACRO MD M.madd(~F, $SP, M.mneg(~F, $JCP))
@MACRO QQ M.matvec(~F, $YK, M.matvec(~F, $MD, $EE))

# e - Y S' e = (e - Y Jc e) - Y (S' - Jc) e
def qv_at($IBP, +k: Nat) -> {O.lookup(~F, $QV, k) == @S(O.lookup(~F, $PV, k), O.lookup(~F, $QQ, k)) : @T}:
  %Equal.sym(@T, O.lookup(~F, $QV, k), @S(O.lookup(~F, $EE, k), O.lookup(~F, $YSE, k)), DG.look_diff(~F, $EE, $YSE, k)) : {_ == @S(O.lookup(~F, $PV, k), O.lookup(~F, $QQ, k)) : @T}
  %Equal.sym(@T, O.lookup(~F, $PV, k), @S(O.lookup(~F, $EE, k), O.lookup(~F, $YJE, k)), DG.look_diff(~F, $EE, $YJE, k)) : {@S(O.lookup(~F, $EE, k), O.lookup(~F, $YSE, k)) == @S(_, O.lookup(~F, $QQ, k)) : @T}
  %Equal.sym(M.Vec(~F), M.matvec(~F, $MD, $EE), BX.vsub(~F, M.matvec(~F, $SP, $EE), M.matvec(~F, $JCP, $EE)), CP.sj_ok(~F, $SP, $JCP, $EE)) : {@S(O.lookup(~F, $EE, k), O.lookup(~F, $YSE, k)) == @S(@S(O.lookup(~F, $EE, k), O.lookup(~F, $YJE, k)), O.lookup(~F, M.matvec(~F, $YK, _), k)) : @T}
  %Equal.sym(M.Vec(~F), M.matvec(~F, $YK, BX.vsub(~F, M.matvec(~F, $SP, $EE), M.matvec(~F, $JCP, $EE))), BX.vsub(~F, $YSE, $YJE), AP.mv_vsub(~F, $YK, M.matvec(~F, $SP, $EE), M.matvec(~F, $JCP, $EE))) : {@S(O.lookup(~F, $EE, k), O.lookup(~F, $YSE, k)) == @S(@S(O.lookup(~F, $EE, k), O.lookup(~F, $YJE, k)), O.lookup(~F, _, k)) : @T}
  %Equal.sym(@T, O.lookup(~F, BX.vsub(~F, $YSE, $YJE), k), @S(O.lookup(~F, $YSE, k), O.lookup(~F, $YJE, k)), DG.look_diff(~F, $YSE, $YJE, k)) : {@S(O.lookup(~F, $EE, k), O.lookup(~F, $YSE, k)) == @S(@S(O.lookup(~F, $EE, k), O.lookup(~F, $YJE, k)), _) : @T}
  FR.fring_eq(~F, [O.lookup(~F, $EE, k), O.lookup(~F, $YSE, k), O.lookup(~F, $YJE, k)], E.ZSub{E.ZVar{0n}, E.ZVar{1n}}, E.ZSub{E.ZSub{E.ZVar{0n}, E.ZVar{2n}}, E.ZSub{E.ZVar{1n}, E.ZVar{2n}}}, {==})

def add_cong(+a: Nat, +a2: Nat, +b: Nat, +b2: Nat, ha: {a == a2 : Nat}, hb: {b == b2 : Nat}) -> {Nat.add(a, b) == Nat.add(a2, b2) : Nat}:
  %Equal.sym(Nat, a, a2, ha) : {Nat.add(_, b) == Nat.add(a2, b2) : Nat}
  %Equal.sym(Nat, b, b2, hb) : {Nat.add(a2, _) == Nat.add(a2, b2) : Nat}
  {==}

def lapp_eq(~F: O.OField, +u1: M.Vec(~F), +u2: M.Vec(~F), +w1: M.Vec(~F), +w2: M.Vec(~F), h1: {M.len(~F, u1) == M.len(~F, u2) : Nat}, h2: {M.len(~F, w1) == M.len(~F, w2) : Nat}) -> {M.len(~F, C.app(~F, u1, w1)) == M.len(~F, C.app(~F, u2, w2)) : Nat}:
  Equal.trans(Nat, M.len(~F, C.app(~F, u1, w1)), Nat.add(M.len(~F, u1), M.len(~F, w1)), M.len(~F, C.app(~F, u2, w2)), NW.len_app(~F, u1, w1),
    Equal.trans(Nat, Nat.add(M.len(~F, u1), M.len(~F, w1)), Nat.add(M.len(~F, u2), M.len(~F, w2)), M.len(~F, C.app(~F, u2, w2)), add_cong(M.len(~F, u1), M.len(~F, u2), M.len(~F, w1), M.len(~F, w2), h1, h2), Equal.sym(Nat, M.len(~F, C.app(~F, u2, w2)), Nat.add(M.len(~F, u2), M.len(~F, w2)), NW.len_app(~F, u2, w2))))

@MACRO IBQ $IBP, +bb: @T, +lam: @T, +ms: @T, +hb: O.le(~F, @0, bb), +hl0: O.le(~F, @0, lam), +hq: AP.eqok(~F, bb, lam, ms, eqs), +yn: @T, +thL: @T, +hyn: O.le(~F, NP.mnorm(~F, M.ofdm(~F, ym), n), yn), +hthl: O.le(~F, NP.mnorm(~F, M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, M.ofdm(~F, ym), $JCP))), n), thL), +hyn0: O.le(~F, @0, yn), +hthl0: O.le(~F, @0, thL), +rad: @T, +hr0: O.le(~F, @0, rad), +hgb: M.vbnd.all(~F, $PTC, @S(bb, rad)), +hZr: M.vbnd.all(~F, BX.vsub(~F, $ZZ, $PTC), rad), +hBr: M.vbnd.all(~F, BX.vsub(~F, $XBZ, $PTC), rad)
@MACRO IBB $IBA, bb, lam, ms, hb, hl0, hq, yn, thL, hyn, hthl, hyn0, hthl0, rad, hr0, hgb, hZr, hBr

def le_ee($IBP) -> {M.len(~F, $EE) == n : Nat}:
  CP.len_vsub(~F, $YC, xb, n, lyc_d(~F, ~H, n, yc, lyc), lxb)

def vp_bnd($IBQ) -> O.le(~F, NP.vn(~F, $PV), @M(thL, NP.vn(~F, $EE))):
  %AP.imv(~F, n, $YK, $JCP, $EE, le_ee($IBA)) : O.le(~F, NP.vn(~F, _), @M(thL, NP.vn(~F, $EE)))
  DM.le_trans(~F, NP.vn(~F, M.matvec(~F, M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, $YK, $JCP))), $EE)), @M(NP.mnorm(~F, M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, $YK, $JCP))), n), NP.vn(~F, $EE)), @M(thL, NP.vn(~F, $EE)), NP.mv_n(~F, M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, $YK, $JCP))), n, $EE, le_ee($IBA)),
    FV.mul_le_r(~F, NP.mnorm(~F, M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, $YK, $JCP))), n), thL, NP.vn(~F, $EE), FV.vmax_nn(~F, $EE),
      (%Equal.sym(M.Mat(~F), $YK, M.ofdm(~F, ym), AP.ofkm_d(~F, ~H, ym)) : O.le(~F, NP.mnorm(~F, M.madd(~F, M.ident(~F, n), M.mneg(~F, M.matmul(~F, _, $JCP))), n), thL)
        hthl)))

# |S' - Jc| <= n lam rad, both points in the F-box of radius rad at P
def md_bnd($IBQ) -> O.le(~F, NP.mnorm(~F, $MD, n), $NL):
  +lyy = Equal.trans(Nat, M.len(~F, $YC), n, M.len(~F, $YC), lyc_d(~F, ~H, n, yc, lyc), Equal.sym(Nat, M.len(~F, $YC), n, lyc_d(~F, ~H, n, yc, lyc)))
  +lzz = Equal.trans(Nat, M.len(~F, xz), KA.klen($DN, pc), M.len(~F, $PZ), lxz, klen_d(~F, ~H, pc))
  +lbb = Equal.trans(Nat, M.len(~F, xb), n, M.len(~F, $YC), lxb, Equal.sym(Nat, M.len(~F, $YC), n, lyc_d(~F, ~H, n, yc, lyc)))
  %AP.cen_fbx(~F, $PTC, rad) : O.le(~F, NP.mnorm(~F, M.madd(~F, $SP, M.mneg(~F, DV.jac(~F, _, eqs, ST.iota(n, 0n)))), n), $NL)
  AP.smat_lip_mn(~F, rad, bb, hr0, hb, AP.fbx(~F, $PTC, rad), AP.gbox_fbx(~F, $PTC, rad, bb, hr0, hgb), $ZZ, $XBZ, AP.inbox_fbx(~F, $ZZ, $PTC, rad, hZr, lapp_eq(~F, $YC, $YC, xz, $PZ, lyy, lzz)), AP.inbox_fbx(~F, $XBZ, $PTC, rad, hBr, lapp_eq(~F, xb, $YC, xz, $PZ, lbb, lzz)), lam, ms, hl0, eqs, hq, n, 0n)

def qq_bnd($IBQ) -> O.le(~F, NP.vn(~F, $QQ), @M(yn, @M($NL, NP.vn(~F, $EE)))):
  +w = M.matvec(~F, $MD, $EE)
  +lw = Equal.trans(Nat, M.len(~F, w), GJ.nrows(~F, $MD), n, Equal.sym(Nat, GJ.nrows(~F, $MD), M.len(~F, w), GJ.len_matvec(~F, $MD, $EE)), NW.nrows_sj(~F, $ZZ, $XBZ, $PTC, eqs, n, hn))
  DM.le_trans(~F, NP.vn(~F, M.matvec(~F, $YK, w)), @M(NP.mnorm(~F, $YK, n), NP.vn(~F, w)), @M(yn, @M($NL, NP.vn(~F, $EE))), NP.mv_n(~F, $YK, n, w, lw),
    NW.mm_le(~F, NP.mnorm(~F, $YK, n), yn, NP.vn(~F, w), @M($NL, NP.vn(~F, $EE)), FV.vmax_nn(~F, w), hyn0,
      (%Equal.sym(M.Mat(~F), $YK, M.ofdm(~F, ym), AP.ofkm_d(~F, ~H, ym)) : O.le(~F, NP.mnorm(~F, _, n), yn)
        hyn),
      DM.le_trans(~F, NP.vn(~F, w), @M(NP.mnorm(~F, $MD, n), NP.vn(~F, $EE)), @M($NL, NP.vn(~F, $EE)), NP.mv_n(~F, $MD, n, $EE, le_ee($IBA)), FV.mul_le_r(~F, NP.mnorm(~F, $MD, n), $NL, NP.vn(~F, $EE), FV.vmax_nn(~F, $EE), md_bnd($IBB)))))

# x_b lies within (65/64) S of yc, given c65 (thL + yn n lam rad) <= c65 - 1
def inbox_ok($IBQ, +hk: O.le(~F, @M($C65, @A(thL, @M(yn, $NL))), @S($C65, @1))) -> O.le(~F, NP.vn(~F, $EE), @M($SD, $C65)):
  +hE = FV.vmax_lub(~F, $EE, @A($SD, NP.vn(~F, $QV)), DG.vall_by(~F, ~$EE, ~@A($SD, NP.vn(~F, $QV)), ~(k => in_at($IBA, k))), FO.nonneg_add(~F, $SD, NP.vn(~F, $QV), dvmax_nn(~F, $S0), FV.vmax_nn(~F, $QV)))
  +hD = DM.le_trans(~F, NP.vn(~F, $QV), @A(NP.vn(~F, $PV), NP.vn(~F, $QQ)), @A(@M(thL, NP.vn(~F, $EE)), @M(yn, @M($NL, NP.vn(~F, $EE)))), NW.vn_by2s(~F, ~$QV, ~$PV, ~$QQ, ~(k => qv_at($IBA, k))), RP.le_add2(~F, NP.vn(~F, $PV), @M(thL, NP.vn(~F, $EE)), NP.vn(~F, $QQ), @M(yn, @M($NL, NP.vn(~F, $EE))), vp_bnd($IBB), qq_bnd($IBB)))
  in_fin(~F, NP.vn(~F, $EE), $SD, NP.vn(~F, $QV), thL, yn, $NL, $C65, hE, hD, hk, c65_nn(~F, ~H), FV.vmax_nn(~F, $EE))
