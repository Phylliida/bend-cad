def absurd(-A: Type, x: Empty) -> A:
  match x:

@MACRO ES SK.Sketch.eqs(sk)
@MACRO OWN SV.owners(sk)
@MACRO NL List<&2, Nat>
@MACRO QL List<&2, E.QExpr>
@MACRO SL List<&2, SK.Side>
@MACRO DL List<&2, SV.Drop>
@MACRO N SV.neqs(SK.Sketch.eqs(sk))

# What a walk's drops carry
# -------------------------

def mulpos(qs: List<&2, SV.Mul>) -> $NL:
  match qs:
    case Nil{}:
      Nil{}
    case Con{SV.Mul{i, q}, t}:
      Con{i, mulpos(t)}

# each drop: a combination on positions in bp, g minus it normalizing
# to 0
def dgood(+es: $QL, +bp: $NL, ds: $DL) -> Bool:
  match ds:
    case Nil{}:
      True{}
    case Con{SV.Drop{+j, +nd, SV.WLin{+qs}}, t}:
      SV.band(L.subl(mulpos(qs), bp), SV.band(QN.qzero(E.QSub{SV.eqat(es, j), SV.mlin(es, qs)}), dgood(es, bp, t)))
    case Con{SV.Drop{+j, +nd, SV.WDer{dv}}, t}:
      False{}

def subl_snoc(xs: $NL, +bp: $NL, +k: Nat, +h: {L.subl(xs, bp) == True{} : Bool}) -> {L.subl(xs, CO.lsnoc(bp, k)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      L.subl_con(x, t, CO.lsnoc(bp, k),
        Equal.trans(Bool, SV.mem(x, CO.lsnoc(bp, k)), SV.bor(SV.mem(x, bp), SV.eq(x, k)), True{}, KB.mem_snoc(x, bp, k), L.bor_l(SV.mem(x, bp), SV.eq(x, k), L.subl_hd(x, t, bp, h))),
        subl_snoc(t, bp, k, L.subl_tl(x, t, bp, h)))

def dgood_up(+es: $QL, +bp: $NL, ds: $DL, +k: Nat, +h: {dgood(es, bp, ds) == True{} : Bool}) -> {dgood(es, CO.lsnoc(bp, k), ds) == True{} : Bool}:
  match ds:
    case Nil{}:
      {==}
    case Con{SV.Drop{+j, +nd, SV.WLin{+qs}}, +t}:
      +b2 = L.subl(mulpos(qs), bp)
      +b3 = QN.qzero(E.QSub{SV.eqat(es, j), SV.mlin(es, qs)})
      +b4 = dgood(es, bp, t)
      +h34 = L.band_r(b2, SV.band(b3, b4), h)
      L.band_i(L.subl(mulpos(qs), CO.lsnoc(bp, k)), SV.band(b3, dgood(es, CO.lsnoc(bp, k), t)), subl_snoc(mulpos(qs), bp, k, L.band_l(b2, SV.band(b3, b4), h)),
        L.band_i(b3, dgood(es, CO.lsnoc(bp, k), t), L.band_l(b3, b4, h34), dgood_up(es, bp, t, k, L.band_r(b3, b4, h34))))
    case Con{SV.Drop{+j, +nd, SV.WDer{+dv}}, +t}:
      absurd({dgood(es, CO.lsnoc(bp, k), Con{SV.Drop{j, nd, SV.WDer{dv}}, t}) == True{} : Bool}, KA.ft(h))

def mp_sub(bp: $NL, ls: List<&2, S.Q>) -> {L.subl(mulpos(PA.muls(bp, ls)), bp) == True{} : Bool}:
  match bp ls:
    case Nil{} ls:
      {==}
    case Con{+i, +it} Nil{}:
      {==}
    case Con{+i, +it} Con{+l, +lt}:
      L.subl_con(i, mulpos(PA.muls(it, lt)), Con{i, it}, L.mem_hd(i, it), L.subl_cons_r(mulpos(PA.muls(it, lt)), i, it, mp_sub(it, lt)))

# the pass's combination is lin over the basis at bp
def rhs_lin(+es: $QL, bp: $NL, ls: List<&2, S.Q>) -> {SV.mlin(es, PA.muls(bp, ls)) == SV.lin(ls, SV.picked(es, bp)) : E.QExpr}:
  match bp ls:
    case Nil{} Nil{}:
      {==}
    case Nil{} Con{l, lt}:
      {==}
    case Con{+i, +it} Nil{}:
      {==}
    case Con{+i, +it} Con{+l, +lt}:
      Equal.cong(E.QExpr, E.QExpr, y => E.QAdd{E.QMul{E.QCst{l}, SV.eqat(es, i)}, y}, SV.mlin(es, PA.muls(it, lt)), SV.lin(lt, SV.picked(es, it)), rhs_lin(es, it, lt))

@MACRO CWP +sk: SK.Sketch, +R: $NL, +D: $NL, +c: Nat, +bp0: $NL
@MACRO CWA sk, R, D, c, bp0
@MACRO RR EL.resid(rows, e)
@MACRO LS DR.dropls(DR.rescb($RR), DR.resbt($RR), e, B)
@MACRO STQ PA.CW{rows, B, bp, ds, us}

# a drop the walk records
def dg_drop($CWP, +k: Nat, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +ds: $DL, +us: $NL, +e: E.QExpr, hi: CW.CWInv($CWA, k, $STQ), +he: {SV.eqat($ES, k) == e : E.QExpr},
  +hnil: {EP.isnil(EP.resp($RR)) == True{} : Bool}, +hg: {dgood($ES, bp, ds) == True{} : Bool}) -> {dgood($ES, bp, Con{PA.drop_of(k, $RR, e, B, bp), ds}) == True{} : Bool}:
  (+hb, q1) = hi
  (hl, q2) = q1
  (hB, q3) = q2
  (hp, hbp) = q3
  +qz = QN.qzero(E.QSub{SV.eqat($ES, k), SV.mlin($ES, PA.muls(bp, $LS))})
  L.band_i(L.subl(mulpos(PA.muls(bp, $LS)), bp), SV.band(qz, dgood($ES, bp, ds)), mp_sub(bp, $LS),
    L.band_i(qz, dgood($ES, bp, ds),
      ID.qzero_ident(SV.eqat($ES, k), SV.mlin($ES, PA.muls(bp, $LS)),
        (%Equal.sym(E.QExpr, SV.eqat($ES, k), e, he) : SV.Ident(_, SV.mlin($ES, PA.muls(bp, $LS)))
          (%Equal.sym(E.QExpr, SV.mlin($ES, PA.muls(bp, $LS)), SV.lin($LS, SV.picked($ES, bp)), rhs_lin($ES, bp, $LS)) : SV.Ident(e, _)
            (%hp : SV.Ident(e, SV.lin($LS, _))
              DR.derivable(B, rows, e, CW.cwb_rinv(sk, c, k, rows, B, ds, us, hb), hnil))))),
      hg))

@MACRO IHD ih: @st2: PA.CW -> CW.CWInv($CWA, 1n+k, st2) -> {dgood($ES, CW.cw.bp(st2), CW.cw.ds(st2)) == True{} : Bool} -> {dgood($ES, CW.cw.bp(PA.cwalk(t, $OWN, c, 1n+k, st2)), CW.cw.ds(PA.cwalk(t, $OWN, c, 1n+k, st2))) == True{} : Bool}

def dg.k(b: Bool, +e: E.QExpr, +t: $QL, $CWP, +k: Nat, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +ds: $DL, +us: $NL,
  +eb: {EP.isnil(EP.resp($RR)) == b : Bool}, +heq: {SV.eq(SV.nth($OWN, k), c) == True{} : Bool}, +hq: {OW.qdrop(k, $ES) == Con{e, t} : $QL}, +hlt: {SV.lt(k, $N) == True{} : Bool},
  +hi: CW.CWInv($CWA, k, $STQ), +hg: {dgood($ES, bp, ds) == True{} : Bool}, $IHD)
  -> {dgood($ES, CW.cw.bp(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.pick(EP.isnil(EP.resp($RR)), k, e, $RR, rows, B, bp, ds, us))), CW.cw.ds(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.pick(EP.isnil(EP.resp($RR)), k, e, $RR, rows, B, bp, ds, us)))) == True{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Bool, EP.isnil(EP.resp($RR)), True{}, eb) : {dgood($ES, CW.cw.bp(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.pick(_, k, e, $RR, rows, B, bp, ds, us))), CW.cw.ds(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.pick(_, k, e, $RR, rows, B, bp, ds, us)))) == True{} : Bool}
      ih(PA.CW{rows, B, bp, Con{PA.drop_of(k, $RR, e, B, bp), ds}, us}, CW.inv_drop($CWA, k, rows, B, bp, ds, us, e, hi, heq, hlt), dg_drop($CWA, k, rows, B, bp, ds, us, e, hi, OW.eqat_of($ES, k, e, t, hq), eb, hg))
    case False{}:
      %Equal.sym(Bool, EP.isnil(EP.resp($RR)), False{}, eb) : {dgood($ES, CW.cw.bp(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.pick(_, k, e, $RR, rows, B, bp, ds, us))), CW.cw.ds(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.pick(_, k, e, $RR, rows, B, bp, ds, us)))) == True{} : Bool}
      ih(PA.CW{EL.rsnoc(rows, EL.row_of($RR)), EP.qsnoc(B, e), CO.lsnoc(bp, k), ds, CO.lsnoc(us, k)}, CW.inv_keep($CWA, k, rows, B, bp, ds, us, e, hi, heq, hlt, eb, OW.eqat_of($ES, k, e, t, hq)), dgood_up($ES, bp, ds, k, hg))

def dg.s(st: PA.CW, +e: E.QExpr, +t: $QL, $CWP, +k: Nat, +heq: {SV.eq(SV.nth($OWN, k), c) == True{} : Bool}, +hq: {OW.qdrop(k, $ES) == Con{e, t} : $QL}, +hlt: {SV.lt(k, $N) == True{} : Bool},
  +hi: CW.CWInv($CWA, k, st), +hg: {dgood($ES, CW.cw.bp(st), CW.cw.ds(st)) == True{} : Bool}, $IHD) -> {dgood($ES, CW.cw.bp(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.res(k, e, st))), CW.cw.ds(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.res(k, e, st)))) == True{} : Bool}:
  match st:
    case PA.CW{+rows, +B, +bp, +ds, +us}:
      dg.k(EP.isnil(EP.resp($RR)), e, t, $CWA, k, rows, B, bp, ds, us, {==}, heq, hq, hlt, hi, hg, ih)

def dg.o(b: Bool, +e: E.QExpr, +t: $QL, $CWP, +k: Nat, +st: PA.CW, +eb: {SV.eq(SV.nth($OWN, k), c) == b : Bool}, +hq: {OW.qdrop(k, $ES) == Con{e, t} : $QL}, +hlt: {SV.lt(k, $N) == True{} : Bool},
  +hi: CW.CWInv($CWA, k, st), +hg: {dgood($ES, CW.cw.bp(st), CW.cw.ds(st)) == True{} : Bool}, $IHD) -> {dgood($ES, CW.cw.bp(PA.cwalk(Con{e, t}, $OWN, c, k, st)), CW.cw.ds(PA.cwalk(Con{e, t}, $OWN, c, k, st))) == True{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Bool, SV.eq(SV.nth($OWN, k), c), True{}, eb) : {dgood($ES, CW.cw.bp(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.at(_, k, e, st))), CW.cw.ds(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.at(_, k, e, st)))) == True{} : Bool}
      dg.s(st, e, t, $CWA, k, eb, hq, hlt, hi, hg, ih)
    case False{}:
      %Equal.sym(Bool, SV.eq(SV.nth($OWN, k), c), False{}, eb) : {dgood($ES, CW.cw.bp(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.at(_, k, e, st))), CW.cw.ds(PA.cwalk(t, $OWN, c, 1n+k, PA.cw.at(_, k, e, st)))) == True{} : Bool}
      ih(st, CW.inv_skip($CWA, k, st, hi, eb, hlt), hg)

# the walk from position k keeps every recorded drop good
def dg_go(es: $QL, own_k: $NL, $CWP, +k: Nat, +st: PA.CW, +hq: {OW.qdrop(k, $ES) == es : $QL}, +ho: {OW.ndrop(k, $OWN) == own_k : $NL}, +hl: {SV.len(own_k) == SV.neqs(es) : Nat},
  +hi: CW.CWInv($CWA, k, st), +hg: {dgood($ES, CW.cw.bp(st), CW.cw.ds(st)) == True{} : Bool}) -> {dgood($ES, CW.cw.bp(PA.cwalk(es, $OWN, c, k, st)), CW.cw.ds(PA.cwalk(es, $OWN, c, k, st))) == True{} : Bool}:
  match es own_k:
    case Nil{} Nil{}:
      hg
    case Nil{} Con{+o, +ot}:
      absurd({dgood($ES, CW.cw.bp(st), CW.cw.ds(st)) == True{} : Bool}, CW.len_nc(o, ot, hl))
    case Con{+e, +t} Nil{}:
      absurd({dgood($ES, CW.cw.bp(PA.cwalk(Con{e, t}, $OWN, c, k, st)), CW.cw.ds(PA.cwalk(Con{e, t}, $OWN, c, k, st))) == True{} : Bool}, CW.len_cn(e, t, hl))
    case Con{+e, +t} Con{+o, +ot}:
      dg.o(SV.eq(SV.nth($OWN, k), c), e, t, $CWA, k, st, {==}, hq, SP.lt_qdrop($ES, k, e, t, hq), hi, hg,
        st2 => h2 => g2 => dg_go(t, ot, $CWA, 1n+k, st2, OW.qdrop_step(k, $ES, e, t, hq), OW.ndrop_step(k, $OWN, o, ot, ho), LN.succ_inj(SV.len(ot), SV.neqs(t), hl), h2, g2))

# Positions in the system solved
# ------------------------------

def allsol(+own: $NL, +R: $NL, +D: $NL, xs: $NL) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{+x, t}:
      SV.band(DK.solved_at(own, R, D, x), allsol(own, R, D, t))

def as_mem.c(+own: $NL, +R: $NL, +D: $NL, +x: Nat, +y: Nat, +t: $NL, b: Bool, eb: {SV.eq(x, y) == b : Bool}, hm: {SV.bor(b, SV.mem(x, t)) == True{} : Bool},
  +h: {SV.band(DK.solved_at(own, R, D, y), allsol(own, R, D, t)) == True{} : Bool}, ih: {SV.mem(x, t) == True{} : Bool} -> {allsol(own, R, D, t) == True{} : Bool} -> {DK.solved_at(own, R, D, x) == True{} : Bool})
  -> {DK.solved_at(own, R, D, x) == True{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Nat, x, y, L.eq_ok(x, y, eb)) : {DK.solved_at(own, R, D, _) == True{} : Bool}
      L.band_l(DK.solved_at(own, R, D, y), allsol(own, R, D, t), h)
    case False{}:
      ih(hm, L.band_r(DK.solved_at(own, R, D, y), allsol(own, R, D, t), h))

def as_mem(+own: $NL, +R: $NL, +D: $NL, xs: $NL, +x: Nat, +h: {allsol(own, R, D, xs) == True{} : Bool}, hm: {SV.mem(x, xs) == True{} : Bool}) -> {DK.solved_at(own, R, D, x) == True{} : Bool}:
  match xs:
    case Nil{}:
      absurd({DK.solved_at(own, R, D, x) == True{} : Bool}, KA.ft(hm))
    case Con{+y, +t}:
      as_mem.c(own, R, D, x, y, t, SV.eq(x, y), {==}, hm, h, a => b => as_mem(own, R, D, t, x, b, a))

def cs_of(+own: $NL, +R: $NL, +D: $NL, qs: List<&2, SV.Mul>, +bp: $NL, +hs: {L.subl(mulpos(qs), bp) == True{} : Bool}, +ha: {allsol(own, R, D, bp) == True{} : Bool}) -> {DK.comb.solved(own, R, D, qs) == True{} : Bool}:
  match qs:
    case Nil{}:
      {==}
    case Con{SV.Mul{+i, +q}, +t}:
      L.band_i(DK.solved_at(own, R, D, i), DK.comb.solved(own, R, D, t), as_mem(own, R, D, bp, i, ha, L.subl_hd(i, mulpos(t), bp, hs)), cs_of(own, R, D, t, bp, L.subl_tl(i, mulpos(t), bp, hs), ha))

# good drops whose bp is in the system solved pass
def dok_of(+es: $QL, +own: $NL, +R: $NL, +D: $NL, +bp: $NL, ds: $DL, +hg: {dgood(es, bp, ds) == True{} : Bool}, +ha: {allsol(own, R, D, bp) == True{} : Bool}) -> {DK.drops.ok(es, own, R, D, ds) == True{} : Bool}:
  match ds:
    case Nil{}:
      {==}
    case Con{SV.Drop{+j, +nd, SV.WLin{+qs}}, +t}:
      +b2 = L.subl(mulpos(qs), bp)
      +b3 = QN.qzero(E.QSub{SV.eqat(es, j), SV.mlin(es, qs)})
      +b4 = dgood(es, bp, t)
      +h34 = L.band_r(b2, SV.band(b3, b4), hg)
      L.band_i(DK.drop.ok(es, own, R, D, SV.Drop{j, nd, SV.WLin{qs}}), DK.drops.ok(es, own, R, D, t),
        L.band_i(DK.comb.solved(own, R, D, qs), b3, cs_of(own, R, D, qs, bp, L.band_l(b2, SV.band(b3, b4), hg), ha), L.band_l(b3, b4, h34)),
        dok_of(es, own, R, D, bp, t, L.band_r(b3, b4, h34), ha))
    case Con{SV.Drop{+j, +nd, SV.WDer{+dv}}, +t}:
      absurd({DK.drops.ok(es, own, R, D, Con{SV.Drop{j, nd, SV.WDer{dv}}, t}) == True{} : Bool}, KA.ft(hg))

def as_cat(+own: $NL, +R: $NL, +D: $NL, a: $NL, +b: $NL, +ha: {allsol(own, R, D, a) == True{} : Bool}, +hb: {allsol(own, R, D, b) == True{} : Bool}) -> {allsol(own, R, D, SV.cat(a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+x, +t}:
      L.band_i(DK.solved_at(own, R, D, x), allsol(own, R, D, SV.cat(t, b)), L.band_l(DK.solved_at(own, R, D, x), allsol(own, R, D, t), ha), as_cat(own, R, D, t, b, L.band_r(DK.solved_at(own, R, D, x), allsol(own, R, D, t), ha), hb))

# the solved positions before c
def ap_as(+own: $NL, +R: $NL, +D: $NL, +c: Nat, xs: $NL, +h: {PP.allpre(xs, own, R, D, c) == True{} : Bool}) -> {allsol(own, R, D, xs) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      L.band_i(DK.solved_at(own, R, D, x), allsol(own, R, D, t), L.band_r(SV.lt(SV.nth(own, x), c), DK.solved_at(own, R, D, x), L.band_l(PP.psel(own, R, D, c, x), PP.allpre(t, own, R, D, c), h)),
        ap_as(own, R, D, c, t, L.band_r(PP.psel(own, R, D, c, x), PP.allpre(t, own, R, D, c), h)))

# c's own, not dropped, c not red: in the system solved (the classes drop
# exactly what c's class drops among c's equations)
def us_as.d(+own: $NL, +R: $NL, +cls: List<&2, SV.Class>, +c: Nat, +u: Nat, +dd: $NL, +hu: {SV.eq(SV.nth(own, u), c) == True{} : Bool}, +hR: {SV.mem(c, R) == False{} : Bool}, +hnu: {SV.mem(u, dd) == False{} : Bool},
  +hdn: {CL.downs(own, cls, 0n) == True{} : Bool}, +hdk: {SV.kdrops(SV.class_at(cls, c)) == dd : $NL}) -> {DK.solved_at(own, R, SV.dropped(cls), u) == True{} : Bool}:
  +hc = L.eq_ok(SV.nth(own, u), c, hu)
  VR.sa_of(own, R, SV.dropped(cls), u,
    (%Equal.sym(Nat, SV.nth(own, u), c, hc) : {SV.mem(_, R) == False{} : Bool}
      hR),
    Equal.trans(Bool, SV.mem(u, SV.dropped(cls)), SV.mem(u, SV.kdrops(SV.class_at(cls, SV.nth(own, u)))), False{}, CL.mem_dropped(own, cls, u, hdn),
      (%Equal.sym(Nat, SV.nth(own, u), c, hc) : {SV.mem(u, SV.kdrops(SV.class_at(cls, _))) == False{} : Bool}
        (%Equal.sym($NL, SV.kdrops(SV.class_at(cls, c)), dd, hdk) : {SV.mem(u, _) == False{} : Bool}
          hnu))))

def us_as(+own: $NL, +R: $NL, +cls: List<&2, SV.Class>, +c: Nat, us: $NL, +dd: $NL, +hown: {KB.allo(own, us, c) == True{} : Bool}, +hR: {SV.mem(c, R) == False{} : Bool}, +hnd: {SV.none_in(us, dd) == True{} : Bool},
  +hdn: {CL.downs(own, cls, 0n) == True{} : Bool}, +hdk: {SV.kdrops(SV.class_at(cls, c)) == dd : $NL}) -> {allsol(own, R, SV.dropped(cls), us) == True{} : Bool}:
  match us:
    case Nil{}:
      {==}
    case Con{+u, +t}:
      L.band_i(DK.solved_at(own, R, SV.dropped(cls), u), allsol(own, R, SV.dropped(cls), t),
        us_as.d(own, R, cls, c, u, dd, L.band_l(SV.eq(SV.nth(own, u), c), KB.allo(own, t, c), hown), hR, KB.bnot_t(SV.mem(u, dd), L.band_l(SV.bnot(SV.mem(u, dd)), SV.none_in(t, dd), hnd)), hdn, hdk),
        us_as(own, R, cls, c, t, dd, L.band_r(SV.eq(SV.nth(own, u), c), KB.allo(own, t, c), hown), hR, L.band_r(SV.bnot(SV.mem(u, dd)), SV.none_in(t, dd), hnd), hdn, hdk))

# Amber refutations
# -----------------

def fsome(m: Maybe<&2, List<&2, SV.Ref>>) -> List<&2, SV.Ref>:
  match m:
    case None{}:
      Nil{}
    case Some{x}:
      x

def isnone(m: Maybe<&2, List<&2, SV.Ref>>) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{x}:
      False{}

def ref_of(+es: $QL, +ss: $SL, +ls: List<&2, S.Q>, +ms: List<&2, S.Q>, +k: S.Q, h: SV.Refutes0(es, ss, ls, ms, k)) -> {VD.ref.ok(es, ss, SV.Ref{ls, ms, k}) == True{} : Bool}:
  (hro, hid) = h
  L.band_i(SV.refok(ls, ms, k, es, ss), QN.qzero(E.QSub{E.QAdd{SV.lin(ls, es), SV.slin(ms, ss)}, E.QCst{k}}), hro, ID.qzero_ident(E.QAdd{SV.lin(ls, es), SV.slin(ms, ss)}, E.QCst{k}, hid))

# refute's certificate passes
def ref_ok_of(+es: $QL, +ss: $SL, +ls: List<&2, S.Q>, +ms: List<&2, S.Q>, +k: S.Q, h: {RF.refute(es, ss) == Some{RF.Cert{ls, ms, k}} : Maybe<&2, RF.Cert>}) -> {VD.ref.ok(es, ss, SV.Ref{ls, ms, k}) == True{} : Bool}:
  ref_of(es, ss, ls, ms, k,
    (%h : SA.RefOk(es, ss, _)
      SA.refute_ok(es, ss)))

@MACRO KBR SV.kept_before(sk, R, c)

def sro.c(m: Maybe<&2, RF.Cert>, r: Maybe<&2, List<&2, SV.Ref>>, +sk: SK.Sketch, +R: $NL, +c: Nat, +i: Nat, +t: $SL, +rs: List<&2, SV.Ref>,
  em: {RF.refute(SV.pre_eqs(sk, R, c), SV.neg_pre(sk, R, c, i)) == m : Maybe<&2, RF.Cert>}, er: {PA.srefs(t, sk, $KBR, c, 1n+i) == r : Maybe<&2, List<&2, SV.Ref>>}, h: {PA.srefs.c(m, r) == Some{rs} : Maybe<&2, List<&2, SV.Ref>>},
  ih: @rs2: List<&2, SV.Ref> -> {PA.srefs(t, sk, $KBR, c, 1n+i) == Some{rs2} : Maybe<&2, List<&2, SV.Ref>>} -> {VD.refs.ok(sk, R, c, SV.slen(t), rs2, 1n+i) == True{} : Bool})
  -> {VD.refs.ok(sk, R, c, 1n+SV.slen(t), rs, i) == True{} : Bool}:
  match m r:
    case None{} r:
      absurd({VD.refs.ok(sk, R, c, 1n+SV.slen(t), rs, i) == True{} : Bool}, KA.tf(Equal.cong(Maybe<&2, List<&2, SV.Ref>>, Bool, z => isnone(z), None{}, Some{rs}, h)))
    case Some{RF.Cert{ls, ms, k}} None{}:
      absurd({VD.refs.ok(sk, R, c, 1n+SV.slen(t), rs, i) == True{} : Bool}, KA.tf(Equal.cong(Maybe<&2, List<&2, SV.Ref>>, Bool, z => isnone(z), None{}, Some{rs}, h)))
    case Some{RF.Cert{+ls, +ms, +k}} Some{+rs2}:
      %Equal.cong(Maybe<&2, List<&2, SV.Ref>>, List<&2, SV.Ref>, z => fsome(z), Some{Con{SV.Ref{ls, ms, k}, rs2}}, Some{rs}, h) : {VD.refs.ok(sk, R, c, 1n+SV.slen(t), _, i) == True{} : Bool}
      L.band_i(VD.ref.ok(SV.pre_eqs(sk, R, c), SV.neg_pre(sk, R, c, i), SV.Ref{ls, ms, k}), VD.refs.ok(sk, R, c, SV.slen(t), rs2, 1n+i),
        ref_ok_of(SV.pre_eqs(sk, R, c), SV.neg_pre(sk, R, c, i), ls, ms, k, em), ih(rs2, er))

# the pass's side refutations (kb being kept_before) pass
def srefs_ok(ss: $SL, +sk: SK.Sketch, +R: $NL, +c: Nat, +i: Nat, +rs: List<&2, SV.Ref>, h: {PA.srefs(ss, sk, $KBR, c, i) == Some{rs} : Maybe<&2, List<&2, SV.Ref>>})
  -> {VD.refs.ok(sk, R, c, SV.slen(ss), rs, i) == True{} : Bool}:
  match ss:
    case Nil{}:
      {==}
    case Con{s, +t}:
      sro.c(RF.refute(SV.eqs_of(sk, $KBR), PA.neg_kb(sk, $KBR, c, i)), PA.srefs(t, sk, $KBR, c, 1n+i), sk, R, c, i, t, rs, {==}, {==}, h, rs2 => h2 => srefs_ok(t, sk, R, c, 1n+i, rs2, h2))

# A kept or amber class
# ---------------------

def kdo_onea(m: Maybe<&2, List<&2, SV.Ref>>, +es: $QL, +own: $NL, +R: $NL, +D: $NL, +dd: $DL) -> {DK.kdrops.ok(es, own, R, D, PA.one.a(m, dd)) == DK.drops.ok(es, own, R, D, dd) : Bool}:
  match m:
    case None{}:
      {==}
    case Some{rs}:
      {==}

def kdo_onek(a: Bool, +es: $QL, +own: $NL, +R: $NL, +D: $NL, +sk: SK.Sketch, +kb: $NL, +c: Nat, +dd: $DL) -> {DK.kdrops.ok(es, own, R, D, PA.one.k(a, sk, kb, c, dd)) == DK.drops.ok(es, own, R, D, dd) : Bool}:
  match a:
    case True{}:
      kdo_onea(PA.srefs(SV.csides(sk, [c]), sk, kb, c, 0n), es, own, R, D, dd)
    case False{}:
      {==}

def kam_onea(m: Maybe<&2, List<&2, SV.Ref>>, +sk: SK.Sketch, +R: $NL, +c: Nat, +dd: $DL, em: {PA.srefs(SV.csides(sk, [c]), sk, $KBR, c, 0n) == m : Maybe<&2, List<&2, SV.Ref>>})
  -> {VD.kamber.ok(sk, R, c, PA.one.a(m, dd)) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{+rs}:
      srefs_ok(SV.csides(sk, [c]), sk, R, c, 0n, rs, em)

def kam_onek(a: Bool, +sk: SK.Sketch, +R: $NL, +kb: $NL, +c: Nat, +dd: $DL, +hkb: {kb == $KBR : $NL}) -> {VD.kamber.ok(sk, R, c, PA.one.k(a, sk, kb, c, dd)) == True{} : Bool}:
  match a:
    case True{}:
      %Equal.sym($NL, kb, $KBR, hkb) : {VD.kamber.ok(sk, R, c, PA.one.k(True{}, sk, _, c, dd)) == True{} : Bool}
      kam_onea(PA.srefs(SV.csides(sk, [c]), sk, $KBR, c, 0n), sk, R, c, dd, {==})
    case False{}:
      {==}

# One constraint of the pass
# --------------------------

@MACRO RF SV.reds(PA.classes(sk))
@MACRO DF SV.dropped(PA.classes(sk))
@MACRO CLS PA.classes(sk)
@MACRO AD PA.dadjs(SK.Sketch.eqs(sk))
@MACRO NV PA.nvars(sk)
@MACRO PARGS SK.Sketch.eqs(sk), SV.owners(sk), sk, PA.dadjs(SK.Sketch.eqs(sk)), 1n+PA.nvars(sk)
@MACRO STK PA.PS{kb, rows, B, bp, vm}
@MACRO CWK PA.CW{rows2, B2, bp2, dd, us}
@MACRO AMB SV.is_amberable(sk, i, SV.drops(dd))
@MACRO K1 PA.one.k($AMB, sk, kb, i, dd)

# the class at i passes both checks
def ckb(+sk: SK.Sketch, +i: Nat, +K: SV.Class) -> Bool:
  SV.band(DK.kdrops.ok($ES, $OWN, $RF, $DF, K), VD.kamber.ok(sk, $RF, i, K))

def ck.ok(+sk: SK.Sketch, +i: Nat, +kb: $NL, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +vm: List<&2, Maybe<&2, Nat>>, +rows2: List<&2, EL.Row>, +B2: $QL, +bp2: $NL, +dd: $DL, +us: $NL,
  +hi: PP.PInv(sk, $RF, $DF, i, $STK), +hci: CW.CWInv(sk, $RF, $DF, i, bp, $N, $CWK), +hg: {dgood($ES, bp2, dd) == True{} : Bool}, +hK: {SV.class_at($CLS, i) == $K1 : SV.Class}, +hD: {CL.downs($OWN, $CLS, 0n) == True{} : Bool})
  -> {ckb(sk, i, $K1) == True{} : Bool}:
  (+hcb, c1) = hci
  (hcl, c2) = c1
  (hcB, c3) = c2
  (hcp, hbp2) = c3
  +hb = PP.pinv_b(sk, $RF, $DF, i, $STK, hi)
  +hR = Equal.trans(Bool, SV.mem(i, $RF), SV.is_red($K1), False{}, PP.red_of(sk, i, $K1, hK), PP.onek_red($AMB, sk, kb, i, dd))
  +hdk = Equal.trans($NL, SV.kdrops(SV.class_at($CLS, i)), SV.kdrops($K1), SV.drops(dd), Equal.cong(SV.Class, $NL, z => SV.kdrops(z), SV.class_at($CLS, i), $K1, hK), PP.onek_kd($AMB, sk, kb, i, dd))
  L.band_i(DK.kdrops.ok($ES, $OWN, $RF, $DF, $K1), VD.kamber.ok(sk, $RF, i, $K1),
    Equal.trans(Bool, DK.kdrops.ok($ES, $OWN, $RF, $DF, $K1), DK.drops.ok($ES, $OWN, $RF, $DF, dd), True{}, kdo_onek($AMB, $ES, $OWN, $RF, $DF, sk, kb, i, dd),
      dok_of($ES, $OWN, $RF, $DF, bp2, dd, hg,
        (%Equal.sym($NL, bp2, SV.cat(bp, us), hbp2) : {allsol($OWN, $RF, $DF, _) == True{} : Bool}
          as_cat($OWN, $RF, $DF, bp, us, ap_as($OWN, $RF, $DF, i, bp, PP.pib_pre(sk, $RF, $DF, i, rows, B, bp, vm, hb)),
            us_as($OWN, $RF, $CLS, i, us, SV.drops(dd), CW.cwb_uown(sk, i, $N, rows2, B2, dd, us, hcb), hR, CW.cwb_udisj(sk, i, $N, rows2, B2, dd, us, hcb), hD, hdk))))),
    kam_onek($AMB, sk, $RF, kb, i, dd, PP.pinv_kb(sk, $RF, $DF, i, $STK, hi)))

@MACRO OG PA.one.g(g, sk, i, kb, rows, B, bp, vm, $CWK)

def ck.g(g: ST.GS, +sk: SK.Sketch, +i: Nat, +kb: $NL, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +vm: List<&2, Maybe<&2, Nat>>, +rows2: List<&2, EL.Row>, +B2: $QL, +bp2: $NL, +dd: $DL, +us: $NL,
  +hi: PP.PInv(sk, $RF, $DF, i, $STK), +hci: CW.CWInv(sk, $RF, $DF, i, bp, $N, $CWK), +hg: {dgood($ES, bp2, dd) == True{} : Bool}, +hK: {SV.class_at($CLS, i) == PA.PO.k($OG) : SV.Class}, +hD: {CL.downs($OWN, $CLS, 0n) == True{} : Bool})
  -> {ckb(sk, i, PA.PO.k($OG)) == True{} : Bool}:
  match g:
    case ST.GFail{ST.Red{j, s, x}}:
      {==}
    case ST.GOk{+vm2}:
      ck.ok(sk, i, kb, rows, B, bp, vm, rows2, B2, bp2, dd, us, hi, hci, hg, hK, hD)

@MACRO OW1 PA.one.w(w, sk, $AD, 1n+$NV, i, kb, rows, B, bp, vm)

def ck.w(w: PA.CW, +sk: SK.Sketch, +i: Nat, +kb: $NL, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +vm: List<&2, Maybe<&2, Nat>>, +hi: PP.PInv(sk, $RF, $DF, i, $STK),
  +hci: CW.CWInv(sk, $RF, $DF, i, bp, $N, w), +hg: {dgood($ES, CW.cw.bp(w), CW.cw.ds(w)) == True{} : Bool}, +hK: {SV.class_at($CLS, i) == PA.PO.k($OW1) : SV.Class}, +hD: {CL.downs($OWN, $CLS, 0n) == True{} : Bool})
  -> {ckb(sk, i, PA.PO.k($OW1)) == True{} : Bool}:
  match w:
    case PA.CW{+rows2, +B2, +bp2, +dd, +us}:
      ck.g(PA.grpl(us, $AD, 1n+$NV, ST.GOk{vm}), sk, i, kb, rows, B, bp, vm, rows2, B2, bp2, dd, us, hi, hci, hg, hK, hD)

def cw_snd(-A: Type, -B: Data, h: (A & B)) -> B:
  (a, b) = h
  b

@MACRO OC PA.one.c(CO.refutable(sk, i, kb), $PARGS, i, kb, rows, B, bp, vm)
@MACRO FIN PA.cwalk($ES, $OWN, i, 0n, PA.CW{rows, B, bp, Nil{}, Nil{}})

# The pass
# --------

def band4(+a: Bool, +b: Bool, +c: Bool, +d: Bool, +h1: {SV.band(a, c) == True{} : Bool}, +h2: {SV.band(b, d) == True{} : Bool}) -> {SV.band(SV.band(a, b), SV.band(c, d)) == True{} : Bool}:
  L.band_i(SV.band(a, b), SV.band(c, d), L.band_i(a, b, L.band_l(a, c, h1), L.band_l(b, d, h2)), L.band_i(c, d, L.band_r(a, c, h1), L.band_r(b, d, h2)))

@MACRO PS1 PA.pass(rs, $PARGS, i, st)
@MACRO O1 PA.one($PARGS, i, st)

@MACRO DCK DK.dck($ES, $OWN, $RF, $DF, $CLS)
@MACRO ACK VD.ack(sk, $RF, $CLS, 0n)
