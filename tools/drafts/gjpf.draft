    case True{}:
      snoc_row(~F, c, i, n, DV.mrow(~F, l2(~F, a, c, r, t), i), w2(~F, a, n, c, r, t, hn, hw, hc, hr, i, hi), hc, p2(~F, a, n, c, r, t, hn, hp, hc, hcr, hr, i, hi), dl_of(~F, i, c, O.lookup(~F, DV.mrow(~F, l2(~F, a, c, r, t), i), c), True{}, e, (%Equal.sym(Nat, i, c, nateq_ok(i, c, e)) : {O.lookup(~F, DV.mrow(~F, l2(~F, a, c, r, t), _), c) == @1 : @T}
        piv2(~F, a, n, c, r, t, hn, hc, hr, ht))))
    case False{}:
      %look_mcol(~F, l2(~F, a, c, r, t), c, i) : {vtake(~F, 1n+c, M.vadd(~F, DV.mrow(~F, l2(~F, a, c, r, t), i), M.vscale(~F, @N(_), DV.mrow(~F, l2(~F, a, c, r, t), c)))) == unit(~F, 1n+c, i) : M.Vec(~F)}
      snoc_row(~F, c, i, n, M.vadd(~F, DV.mrow(~F, l2(~F, a, c, r, t), i), M.vscale(~F, @N(O.lookup(~F, DV.mrow(~F, l2(~F, a, c, r, t), i), c)), DV.mrow(~F, l2(~F, a, c, r, t), c))), clr_len(~F, n, DV.mrow(~F, l2(~F, a, c, r, t), i), DV.mrow(~F, l2(~F, a, c, r, t), c), @N(O.lookup(~F, DV.mrow(~F, l2(~F, a, c, r, t), i), c)), w2(~F, a, n, c, r, t, hn, hw, hc, hr, i, hi), w2(~F, a, n, c, r, t, hn, hw, hc, hr, c, hc)), hc, clr_take(~F, c, i, DV.mrow(~F, l2(~F, a, c, r, t), i), DV.mrow(~F, l2(~F, a, c, r, t), c), @N(O.lookup(~F, DV.mrow(~F, l2(~F, a, c, r, t), i), c)), p2(~F, a, n, c, r, t, hn, hp, hc, hcr, hr, i, hi), pz2(~F, a, n, c, r, t, hn, hp, hc, hcr, hr)), dl_of(~F, i, c, O.lookup(~F, M.vadd(~F, DV.mrow(~F, l2(~F, a, c, r, t), i), M.vscale(~F, @N(O.lookup(~F, DV.mrow(~F, l2(~F, a, c, r, t), i), c)), DV.mrow(~F, l2(~F, a, c, r, t), c))), c), False{}, e, clr_look(~F, c, DV.mrow(~F, l2(~F, a, c, r, t), i), DV.mrow(~F, l2(~F, a, c, r, t), c), piv2(~F, a, n, c, r, t, hn, hc, hr, ht))))

def p3(~F: O.OField, +a: M.Mat(~F), +n: Nat, +c: Nat, +r: Nat, +t: @T, +hn: {nrows(~F, a) == n : Nat}, +hw: All(~(j => roww(~F, a, n, j)), n), +hp: All(~(j => rowpre(~F, a, c, j)), n), +hc: {KA.natle(1n+c, n) == True{} : Bool}, +hcr: {KA.natle(c, r) == True{} : Bool}, +hr: {KA.natle(1n+r, n) == True{} : Bool}, +ht: {@M(O.lookup(~F, DV.mrow(~F, a, r), c), t) == @1 : @T}, +i: Nat, +hi: {KA.natle(1n+i, n) == True{} : Bool}) -> rowpre(~F, l3(~F, a, c, r, t), 1n+c, i):
  %row_clr(~F, l2(~F, a, c, r, t), c, mcol(~F, l2(~F, a, c, r, t), c), i, lt_n(~F, l2(~F, a, c, r, t), n, i, n2(~F, a, n, c, r, t, hn), hi)) : {vtake(~F, 1n+c, _) == unit(~F, 1n+c, i) : M.Vec(~F)}
  p3.go(~F, a, n, c, r, t, hn, hw, hp, hc, hcr, hr, ht, i, hi, KA.nateq(i, c), {==})

# The pivot search
# ----------------
# Rows below k at or after c: one with a nonzero entry in column c (with
# its inverse), or none.

def zc.at(~F: O.OField, b: Bool, +a: M.Mat(~F), +c: Nat, +j: Nat) -> Data:
  match b:
    case True{}:
      {O.lookup(~F, DV.mrow(~F, a, j), c) == @0 : @T}
    case False{}:
      Unit

def zc(~F: O.OField, +a: M.Mat(~F), +c: Nat, +j: Nat) -> Data:
  zc.at(~F, KA.natle(c, j), a, c, j)

def pivp(~F: O.OField, +a: M.Mat(~F), +c: Nat, +k: Nat, +r: Nat) -> Data:
  M.Both({KA.natle(c, r) == True{} : Bool}, M.Both({KA.natle(1n+r, k) == True{} : Bool}, {@M(O.lookup(~F, DV.mrow(~F, a, r), c), O.inv(F, O.lookup(~F, DV.mrow(~F, a, r), c))) == @1 : @T}))

def SR(~F: O.OField, +a: M.Mat(~F), +c: Nat, +k: Nat) -> Data:
  Either<&2, &2, Sigma<&2, &2, Nat, r => pivp(~F, a, c, k, r)>, All(~(j => zc(~F, a, c, j)), k)>

def piv_lift(~F: O.OField, +a: M.Mat(~F), +c: Nat, +j: Nat, +r: Nat, p: pivp(~F, a, c, j, r)) -> pivp(~F, a, c, 1n+j, r):
  match p:
    case (h1, h23):
      match h23:
        case (h2, h3):
          (h1, (le_succ(1n+r, j, h2), h3))

def sr_lift(~F: O.OField, +a: M.Mat(~F), +c: Nat, +j: Nat, s: Sigma<&2, &2, Nat, r => pivp(~F, a, c, j, r)>) -> Sigma<&2, &2, Nat, r => pivp(~F, a, c, 1n+j, r)>:
  match s:
    case (+r, p):
      (r, piv_lift(~F, a, c, j, r, p))

def zc_f(~F: O.OField, +a: M.Mat(~F), +c: Nat, +j: Nat, e: {KA.natle(c, j) == False{} : Bool}) -> zc(~F, a, c, j):
  %Equal.sym(Bool, KA.natle(c, j), False{}, e) : zc.at(~F, _, a, c, j)
  Unit{}

def zc_t(~F: O.OField, +a: M.Mat(~F), +c: Nat, +j: Nat, e: {KA.natle(c, j) == True{} : Bool}, h: {O.lookup(~F, DV.mrow(~F, a, j), c) == @0 : @T}) -> zc(~F, a, c, j):
  %Equal.sym(Bool, KA.natle(c, j), True{}, e) : zc.at(~F, _, a, c, j)
  h

def found(~F: O.OField, +a: M.Mat(~F), +c: Nat, +j: Nat, e: {KA.natle(c, j) == True{} : Bool}, ne: {O.lookup(~F, DV.mrow(~F, a, j), c) == @0 : @T} -> Empty) -> SR(~F, a, c, 1n+j):
  Inl{(j, (e, (le_refl(j), O.mul_inv(F)(O.lookup(~F, DV.mrow(~F, a, j), c))(ne))))}

def search.eq(~F: O.OField, +a: M.Mat(~F), +c: Nat, +j: Nat, z: All(~(i => zc(~F, a, c, i)), j), +e: {KA.natle(c, j) == True{} : Bool}, o: Or({O.lookup(~F, DV.mrow(~F, a, j), c) == @0 : @T}, O.lt(F, @0, O.lookup(~F, DV.mrow(~F, a, j), c)))) -> SR(~F, a, c, 1n+j):
  match o:
    case Inl{eq}:
      Inr{(z, zc_t(~F, a, c, j, e, eq))}
    case Inr{g}:
      found(~F, a, c, j, e, FO.ne_of_gt(~F, O.lookup(~F, DV.mrow(~F, a, j), c), @0, g))

def search.tot(~F: O.OField, +a: M.Mat(~F), +c: Nat, +j: Nat, z: All(~(i => zc(~F, a, c, i)), j), +e: {KA.natle(c, j) == True{} : Bool}, tot: Or(O.lt(F, O.lookup(~F, DV.mrow(~F, a, j), c), @0), Or({O.lookup(~F, DV.mrow(~F, a, j), c) == @0 : @T}, O.lt(F, @0, O.lookup(~F, DV.mrow(~F, a, j), c))))) -> SR(~F, a, c, 1n+j):
  match tot:
    case Inl{l}:
      found(~F, a, c, j, e, FO.ne_of_lt(~F, O.lookup(~F, DV.mrow(~F, a, j), c), @0, l))
    case Inr{o}:
      search.eq(~F, a, c, j, z, e, o)

def search.row(~F: O.OField, +a: M.Mat(~F), +c: Nat, +j: Nat, z: All(~(i => zc(~F, a, c, i)), j), b: Bool, e: {KA.natle(c, j) == b : Bool}, tot: Or(O.lt(F, O.lookup(~F, DV.mrow(~F, a, j), c), @0), Or({O.lookup(~F, DV.mrow(~F, a, j), c) == @0 : @T}, O.lt(F, @0, O.lookup(~F, DV.mrow(~F, a, j), c))))) -> SR(~F, a, c, 1n+j):
  match b:
    case True{}:
      search.tot(~F, a, c, j, z, e, tot)
    case False{}:
      Inr{(z, zc_f(~F, a, c, j, e))}

def search.go(~F: O.OField, +a: M.Mat(~F), +c: Nat, +j: Nat, rest: SR(~F, a, c, j), tot: Or(O.lt(F, O.lookup(~F, DV.mrow(~F, a, j), c), @0), Or({O.lookup(~F, DV.mrow(~F, a, j), c) == @0 : @T}, O.lt(F, @0, O.lookup(~F, DV.mrow(~F, a, j), c))))) -> SR(~F, a, c, 1n+j):
  match rest:
    case Inl{s}:
      Inl{sr_lift(~F, a, c, j, s)}
    case Inr{z}:
      search.row(~F, a, c, j, z, KA.natle(c, j), {==}, tot)

def search(~F: O.OField, +a: M.Mat(~F), +c: Nat, k: Nat) -> SR(~F, a, c, k):
  match k:
    case 0n:
      Inr{Unit{}}
    case 1n++j:
      search.go(~F, a, c, j, search(~F, a, c, j), O.lt_total(F)(O.lookup(~F, DV.mrow(~F, a, j), c), @0))

# No pivot: a kernel vector
# -------------------------
# Column c has no nonzero entry at or below row c, and the first c columns
# are unit, so v = (-a_0c, ..., -a_(c-1)c, 1, 0, ..., 0) has a v = 0.

def le_add_r(a: Nat, +b: Nat) -> {KA.natle(a, Nat.add(a, b)) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+i:
      le_add_r(i, b)

def le_of_add(+c: Nat, +m: Nat, +n: Nat, hk: {Nat.add(c, m) == n : Nat}) -> {KA.natle(c, n) == True{} : Bool}:
  %hk : {KA.natle(c, _) == True{} : Bool}
  le_add_r(c, m)

def lt_of_add(+c: Nat, +k: Nat, +n: Nat, hk: {Nat.add(c, 1n+k) == n : Nat}) -> {KA.natle(1n+c, n) == True{} : Bool}:
  %hk : {KA.natle(1n+c, _) == True{} : Bool}
  %LN.add_succ(c, k) : {KA.natle(1n+c, _) == True{} : Bool}
  le_add_r(c, k)

# not i < c gives c <= i
def not_lt(i: Nat, c: Nat, e: {KA.natle(1n+i, c) == False{} : Bool}) -> {KA.natle(c, i) == True{} : Bool}:
  match i c:
    case i 0n:
      {==}
    case 0n 1n+k:
      absurd({KA.natle(1n+k, 0n) == True{} : Bool}, tf(e))
    case 1n+j 1n+k:
      not_lt(j, k, e)

def ve_mk(~F: O.OField, ~n: Nat, ~u: M.Vec(~F), ~v: M.Vec(~F), ~f: @i: Nat -> {KA.natle(1n+i, n) == True{} : Bool} -> {O.lookup(~F, u, i) == O.lookup(~F, v, i) : @T}, k: Nat, +hk: {KA.natle(k, n) == True{} : Bool}) -> VE(~F, u, v, k):
  match k:
    case 0n:
      Unit{}
    case 1n++j:
      (ve_mk(~F, ~n, ~u, ~v, ~f, j, le_trans(j, 1n+j, n, le_succ(j, j, le_refl(j)), hk)), f(j, hk))

def dot_zeros_r(~F: O.OField, w: M.Vec(~F), n: Nat) -> {@0 == M.dot(~F, w, zeros(~F, n)) : @T}:
  match w n:
    case Nil{} n:
      {==}
    case Con{a, t} 0n:
      {==}
    case Con{+a, +t} 1n+k:
      %dot_zeros_r(~F, t, k) : {@0 == @A(@M(a, @0), _) : @T}
      @ZEQ[a | 0 | a * 0 + 0]

# split a product at the end of p
def dot_app(~F: O.OField, r: M.Vec(~F), p: M.Vec(~F), +q: M.Vec(~F)) -> {@A(M.dot(~F, vtake(~F, M.len(~F, p), r), p), M.dot(~F, vdrop(~F, M.len(~F, p), r), q)) == M.dot(~F, r, vapp(~F, p, q)) : @T}:
  match r p:
    case r Nil{}:
      FL.zero_add(~F, M.dot(~F, r, q))
    case Nil{} Con{x, ps}:
      O.add_zero(F)(@0)
    case Con{+a, +rs} Con{+x, +ps}:
      %dot_app(~F, rs, ps, q) : {@A(@A(@M(a, x), M.dot(~F, vtake(~F, M.len(~F, ps), rs), ps)), M.dot(~F, vdrop(~F, M.len(~F, ps), rs), q)) == @A(@M(a, x), _) : @T}
      O.add_assoc(F)(@M(a, x), M.dot(~F, vtake(~F, M.len(~F, ps), rs), ps), M.dot(~F, vdrop(~F, M.len(~F, ps), rs), q))

def dot_e0(~F: O.OField, y: M.Vec(~F), +k: Nat) -> {O.lookup(~F, y, 0n) == M.dot(~F, y, Con{@1, zeros(~F, k)}) : @T}:
  match y:
    case Nil{}:
      {==}
    case Con{+a, +t}:
      %dot_zeros_r(~F, t, k) : {a == @A(@M(a, @1), _) : @T}
      @ZEQ[a | a | a * 1 + 0]

def look_drop(~F: O.OField, c: Nat, r: M.Vec(~F)) -> {O.lookup(~F, r, c) == O.lookup(~F, vdrop(~F, c, r), 0n) : @T}:
  match c r:
    case 0n r:
      {==}
    case 1n+j Nil{}:
      {==}
    case 1n+j Con{a, t}:
      look_drop(~F, j, t)

def look_app_len(~F: O.OField, p: M.Vec(~F), +q: M.Vec(~F)) -> {O.lookup(~F, q, 0n) == O.lookup(~F, vapp(~F, p, q), M.len(~F, p)) : @T}:
  match p:
    case Nil{}:
      {==}
    case Con{a, ps}:
      look_app_len(~F, ps, q)

# zero vectors stay zero
def vset_zeros(~F: O.OField, n: Nat, i: Nat) -> {zeros(~F, n) == vset(~F, zeros(~F, n), i, @0) : M.Vec(~F)}:
  match n i:
    case 0n i:
      {==}
    case 1n+k 0n:
      {==}
    case 1n+k 1n+j:
      %vset_zeros(~F, k, j) : {Con{@0, zeros(~F, k)} == Con{@0, _} : M.Vec(~F)}
      {==}

def ent_zero(~F: O.OField, b: Bool, +m: @T) -> {@0 == vclr.ent(~F, b, @0, @0, m) : @T}:
  match b:
    case True{}:
      {==}
    case False{}:
      @ZEQ[m | 0 | 0 + (-m) * 0]

def clr_zeros(~F: O.OField, n: Nat, +c: Nat, +ms: M.Vec(~F), +u: Nat) -> {zeros(~F, n) == vclr.go(~F, zeros(~F, n), @0, c, ms, u) : M.Vec(~F)}:
  match n:
    case 0n:
      {==}
    case 1n+k:
      %ent_zero(~F, KA.nateq(u, c), vhd(~F, ms)) : {Con{@0, zeros(~F, k)} == Con{_, vclr.go(~F, zeros(~F, k), @0, c, vtl(~F, ms), 1n+u)} : M.Vec(~F)}
      %clr_zeros(~F, k, c, vtl(~F, ms), 1n+u) : {Con{@0, zeros(~F, k)} == Con{@0, _} : M.Vec(~F)}
      {==}

def vapply_zeros(~F: O.OField, +n: Nat, op: GOp<F>) -> {zeros(~F, n) == vapply(~F, zeros(~F, n), op) : M.Vec(~F)}:
  match op:
    case GSwap{+x, +y}:
      %look_zeros(~F, n, y) : {zeros(~F, n) == vset(~F, vset(~F, zeros(~F, n), x, _), y, O.lookup(~F, zeros(~F, n), x)) : M.Vec(~F)}
      %look_zeros(~F, n, x) : {zeros(~F, n) == vset(~F, vset(~F, zeros(~F, n), x, @0), y, _) : M.Vec(~F)}
      %vset_zeros(~F, n, x) : {zeros(~F, n) == vset(~F, _, y, @0) : M.Vec(~F)}
      vset_zeros(~F, n, y)
    case GScl{+c, +s, t}:
      %look_zeros(~F, n, c) : {zeros(~F, n) == vset(~F, zeros(~F, n), c, @M(s, _)) : M.Vec(~F)}
      %FL.mul_zero(~F, s) : {zeros(~F, n) == vset(~F, zeros(~F, n), c, _) : M.Vec(~F)}
      vset_zeros(~F, n, c)
    case GClr{+c, +ms}:
      %look_zeros(~F, n, c) : {zeros(~F, n) == vclr.go(~F, zeros(~F, n), _, c, ms, 0n) : M.Vec(~F)}
      clr_zeros(~F, n, c, ms, 0n)

def vapplies_zeros(~F: O.OField, +n: Nat, h: List<&2, GOp<F>>) -> {zeros(~F, n) == vapplies(~F, zeros(~F, n), h) : M.Vec(~F)}:
  match h:
    case Nil{}:
      {==}
    case Con{+op, +t}:
      %vapplies_zeros(~F, n, t) : {zeros(~F, n) == vapply(~F, _, op) : M.Vec(~F)}
      vapply_zeros(~F, n, op)

# the kernel vector: its first c entries, then 1, then k zeros
def kp(~F: O.OField, +a: M.Mat(~F), +c: Nat) -> M.Vec(~F):
  M.vneg(~F, vtake(~F, c, mcol(~F, a, c)))

def kv(~F: O.OField, +a: M.Mat(~F), +c: Nat, +k: Nat) -> M.Vec(~F):
  vapp(~F, kp(~F, a, c), Con{@1, zeros(~F, k)})

def kp_len(~F: O.OField, +a: M.Mat(~F), +c: Nat, +n: Nat, hn: {nrows(~F, a) == n : Nat}, hc: {KA.natle(c, n) == True{} : Bool}) -> {M.len(~F, kp(~F, a, c)) == c : Nat}:
  %len_vneg(~F, vtake(~F, c, mcol(~F, a, c))) : {_ == c : Nat}
  Equal.sym(Nat, c, M.len(~F, vtake(~F, c, mcol(~F, a, c))), len_vtake(~F, c, mcol(~F, a, c), (%len_mcol(~F, a, c) : {KA.natle(c, _) == True{} : Bool}
    %Equal.sym(Nat, nrows(~F, a), n, hn) : {KA.natle(c, _) == True{} : Bool}
    hc)))

def kv_len(~F: O.OField, +a: M.Mat(~F), +c: Nat, +k: Nat, +n: Nat, hn: {nrows(~F, a) == n : Nat}, +hk: {Nat.add(c, 1n+k) == n : Nat}) -> {M.len(~F, kv(~F, a, c, k)) == n : Nat}:
  %len_vapp(~F, kp(~F, a, c), Con{@1, zeros(~F, k)}) : {_ == n : Nat}
  %len_zeros(~F, k) : {Nat.add(M.len(~F, kp(~F, a, c)), 1n+_) == n : Nat}
  %Equal.sym(Nat, M.len(~F, kp(~F, a, c)), c, kp_len(~F, a, c, n, hn, le_of_add(c, 1n+k, n, hk))) : {Nat.add(_, 1n+k) == n : Nat}
  hk

def kv_look(~F: O.OField, +a: M.Mat(~F), +c: Nat, +k: Nat, +n: Nat, hn: {nrows(~F, a) == n : Nat}, hc: {KA.natle(c, n) == True{} : Bool}) -> {O.lookup(~F, kv(~F, a, c, k), c) == @1 : @T}:
  %kp_len(~F, a, c, n, hn, hc) : {O.lookup(~F, vapp(~F, kp(~F, a, c), Con{@1, zeros(~F, k)}), _) == @1 : @T}
  %look_app_len(~F, kp(~F, a, c), Con{@1, zeros(~F, k)}) : {_ == @1 : @T}
  {==}

def zc_get(~F: O.OField, +a: M.Mat(~F), +c: Nat, +i: Nat, b: Bool, e: {KA.natle(c, i) == b : Bool}, h: zc.at(~F, b, a, c, i), ht: {KA.natle(c, i) == True{} : Bool}) -> {O.lookup(~F, DV.mrow(~F, a, i), c) == @0 : @T}:
  match b:
    case True{}:
      h
    case False{}:
      absurd({O.lookup(~F, DV.mrow(~F, a, i), c) == @0 : @T}, ft(Equal.trans(Bool, False{}, KA.natle(c, i), True{}, Equal.sym(Bool, KA.natle(c, i), False{}, e), ht)))

def ker_ent.go(~F: O.OField, +a: M.Mat(~F), +n: Nat, +c: Nat, +z: All(~(j => zc(~F, a, c, j)), n), +i: Nat, +hi: {KA.natle(1n+i, n) == True{} : Bool}, b: Bool, +e: {KA.natle(1n+i, c) == b : Bool}) -> {@A(@N(O.lookup(~F, vtake(~F, c, mcol(~F, a, c)), i)), O.lookup(~F, DV.mrow(~F, a, i), c)) == @0 : @T}:
  match b:
    case True{}:
      %look_take_lo(~F, c, mcol(~F, a, c), i, e) : {@A(@N(_), O.lookup(~F, DV.mrow(~F, a, i), c)) == @0 : @T}
      %look_mcol(~F, a, c, i) : {@A(@N(_), O.lookup(~F, DV.mrow(~F, a, i), c)) == @0 : @T}
      FL.neg_add_l(~F, O.lookup(~F, DV.mrow(~F, a, i), c))
    case False{}:
      %look_take_hi(~F, c, mcol(~F, a, c), i, not_lt(i, c, e)) : {@A(@N(_), O.lookup(~F, DV.mrow(~F, a, i), c)) == @0 : @T}
      %Equal.sym(@T, O.lookup(~F, DV.mrow(~F, a, i), c), @0, zc_get(~F, a, c, i, KA.natle(c, i), {==}, all_at(~(j => zc(~F, a, c, j)), n, z, i, hi), not_lt(i, c, e))) : {@A(@N(@0), _) == @0 : @T}
      %FL.neg_zero(~F) : {@A(_, @0) == @0 : @T}
      O.add_zero(F)(@0)

def ker_ent(~F: O.OField, +a: M.Mat(~F), +n: Nat, +c: Nat, +k: Nat, +hn: {nrows(~F, a) == n : Nat}, +hp: All(~(j => rowpre(~F, a, c, j)), n), +z: All(~(j => zc(~F, a, c, j)), n), +hk: {Nat.add(c, 1n+k) == n : Nat}, +i: Nat, +hi: {KA.natle(1n+i, n) == True{} : Bool}) -> {O.lookup(~F, M.matvec(~F, a, kv(~F, a, c, k)), i) == O.lookup(~F, zeros(~F, n), i) : @T}:
  %Equal.sym(@T, O.lookup(~F, M.matvec(~F, a, kv(~F, a, c, k)), i), M.dot(~F, DV.mrow(~F, a, i), kv(~F, a, c, k)), look_matvec(~F, a, kv(~F, a, c, k), i)) : {_ == O.lookup(~F, zeros(~F, n), i) : @T}
  %look_zeros(~F, n, i) : {M.dot(~F, DV.mrow(~F, a, i), kv(~F, a, c, k)) == _ : @T}
  %dot_app(~F, DV.mrow(~F, a, i), kp(~F, a, c), Con{@1, zeros(~F, k)}) : {_ == @0 : @T}
