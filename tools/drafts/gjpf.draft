  %dot_unit(~F, c, i, kp(~F, a, c), (%Equal.sym(Nat, M.len(~F, kp(~F, a, c)), c, kp_len(~F, a, c, n, hn, le_of_add(c, 1n+k, n, hk))) : {KA.natle(_, c) == True{} : Bool}
