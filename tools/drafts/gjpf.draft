  rec(Con{GClr{c, mcol(~F, l2(~F, applies(~F, a, h), c, r, O.inv(F, O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c))), c)}, Con{GScl{c, O.inv(F, O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c)), O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c)}, Con{GSwap{c, r}, h}}}, (Unit{}, ((lt_of_add(c, k, n, hk), Equal.trans(@T, @M(O.inv(F, O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c)), O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c)), @M(O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c), O.inv(F, O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c))), @1, FL.mul_comm(~F, O.inv(F, O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c)), O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c)), hinv)), ((lt_of_add(c, k, n, hk), hr), ok))), n3(~F, applies(~F, a, h), n, c, r, O.inv(F, O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c)), hn), all_mk(~n, ~(j => roww(~F, l3(~F, applies(~F, a, h), c, r, O.inv(F, O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c))), n, j)), ~(j => hj => w3(~F, applies(~F, a, h), n, c, r, O.inv(F, O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c)), hn, hw, lt_of_add(c, k, n, hk), hr, j, hj)), n, le_refl(n)), all_mk(~n, ~(j => rowpre(~F, l3(~F, applies(~F, a, h), c, r, O.inv(F, O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c))), 1n+c, j)), ~(j => hj => p3(~F, applies(~F, a, h), n, c, r, O.inv(F, O.lookup(~F, DV.mrow(~F, applies(~F, a, h), r), c)), hn, hw, hp, lt_of_add(c, k, n, hk), hcr, hr, hinv, j, hj)), n, le_refl(n)))

def gj.found(~F: O.OField, +a: M.Mat(~F), +n: Nat, +c: Nat, +k: Nat, +h: List<&2, GOp<F>>, +hk: {Nat.add(c, 1n+k) == n : Nat}, +ok: hok(~F, h, n), +hn: {nrows(~F, applies(~F, a, h)) == n : Nat}, +hw: All(~(j => roww(~F, applies(~F, a, h), n, j)), n), +hp: All(~(j => rowpre(~F, applies(~F, a, h), c, j)), n), +r: Nat, p: pivp(~F, applies(~F, a, h), c, n, r), rec: @h2: List<&2, GOp<F>> -> hok(~F, h2, n) -> {nrows(~F, applies(~F, a, h2)) == n : Nat} -> All(~(j => roww(~F, applies(~F, a, h2), n, j)), n) -> All(~(j => rowpre(~F, applies(~F, a, h2), 1n+c, j)), n) -> GJR(~F, a, n)) -> GJR(~F, a, n):
  match p:
    case (hcr, hri):
      match hri:
        case (hr, hinv):
          gj.found2(~F, a, n, c, k, h, hk, ok, hn, hw, hp, r, hcr, hr, hinv, rec)

def gj.go(~F: O.OField, +a: M.Mat(~F), +n: Nat, +c: Nat, +k: Nat, +h: List<&2, GOp<F>>, +hk: {Nat.add(c, 1n+k) == n : Nat}, +ok: hok(~F, h, n), +hn: {nrows(~F, applies(~F, a, h)) == n : Nat}, +hw: All(~(j => roww(~F, applies(~F, a, h), n, j)), n), +hp: All(~(j => rowpre(~F, applies(~F, a, h), c, j)), n), +hA: {nrows(~F, a) == n : Nat}, sr: SR(~F, applies(~F, a, h), c, n), rec: @h2: List<&2, GOp<F>> -> hok(~F, h2, n) -> {nrows(~F, applies(~F, a, h2)) == n : Nat} -> All(~(j => roww(~F, applies(~F, a, h2), n, j)), n) -> All(~(j => rowpre(~F, applies(~F, a, h2), 1n+c, j)), n) -> GJR(~F, a, n)) -> GJR(~F, a, n):
  match sr:
    case Inl{s}:
