def w3(~F: O.OField, +a: M.Mat(~F), +n: Nat, +c: Nat, +r: Nat, +t: @T, +hn: {nrows(~F, a) == n : Nat}, +hw: All(~(j => roww(~F, a, n, j)), n), +hc: {KA.natle(1n+c, n) == True{} : Bool}, +hr: {KA.natle(1n+r, n) == True{} : Bool}, +i: Nat, +hi: {KA.natle(1n+i, n) == True{} : Bool}) -> roww(~F, l3(~F, a, c, r, t), n, i):
  %row_clr(~F, l2(~F, a, c, r, t), c, mcol(~F, l2(~F, a, c, r, t), c), i, lt_n(~F, l2(~F, a, c, r, t), n, i, n2(~F, a, n, c, r, t, hn), hi)) : {M.len(~F, _) == n : Nat}
  w3.go(~F, a, n, c, r, t, hn, hw, hc, hr, i, hi, KA.nateq(i, c))

def p3.go(~F: O.OField, +a: M.Mat(~F), +n: Nat, +c: Nat, +r: Nat, +t: @T, +hn: {nrows(~F, a) == n : Nat}, +hw: All(~(j => roww(~F, a, n, j)), n), +hp: All(~(j => rowpre(~F, a, c, j)), n), +hc: {KA.natle(1n+c, n) == True{} : Bool}, +hcr: {KA.natle(c, r) == True{} : Bool}, +hr: {KA.natle(1n+r, n) == True{} : Bool}, +ht: {@M(O.lookup(~F, DV.mrow(~F, a, r), c), t) == @1 : @T}, +i: Nat, +hi: {KA.natle(1n+i, n) == True{} : Bool}, b: Bool, +e: {KA.nateq(i, c) == b : Bool}) -> {vtake(~F, 1n+c, mclr.row(~F, b, DV.mrow(~F, l2(~F, a, c, r, t), i), DV.mrow(~F, l2(~F, a, c, r, t), c), O.lookup(~F, mcol(~F, l2(~F, a, c, r, t), c), i))) == unit(~F, 1n+c, i) : M.Vec(~F)}:
