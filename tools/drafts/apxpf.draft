# bend-cad: approximate inverses and the block's linear algebra, for
# solve_complete (DESIGN §10.4, C5a). Proofs only.
#
# C4's dinverse_ok bounds every entry of I - A J. Newton and the radius
# search use that as bounds on vectors and norms: |w - A J w| <= n e |w|,
# |A w| <= (1 + n e) b |w| when J has an inverse of norm b, the right
# defect I - J A, and Y, the inverse rounded to fewer bits. The rest
# reads the block in F: slopes against the Jacobian at a box's center,
# the dyadic Jacobian and values through any embedding of the dyadics,
# and the checker's comparisons as complete for dyadics.

import Base
import ../spec/num.bend as S
import ../spec/ring.bend as E
import ../spec/field.bend as O
import ../spec/mat.bend as M
import ../spec/box.bend as BX
import ../spec/knum.bend as N
import ../spec/deriv.bend as DV
import ./karith.bend as KA
import ./kball.bend as KB
import ./cert.bend as CK
import ./certdef.bend as C
import ./certpf.bend as CP
import ./kinst.bend as KI
import ./numer.bend as NU
import ./struct.bend as ST
import ./flaws.bend as FL
import ./fring.bend as FR
import ./ford.bend as FO
import ./fmat.bend as FM
import ./fvec.bend as FV
import ./dmat.bend as DM
import ./gjpf.bend as GJ
import ./normpf.bend as NP
import ./dgjpf.bend as DG
import ./bndpf.bend as BP
import ./roundpf.bend as RP
import ./slope.bend as SL

# The dyadics through any embedding
# ---------------------------------
# Every embedding of the dyadics in F is ofd: the dyadic m/2^e is held
# as itself, so the embedding's ofq law fixes its image.

def plog_pow2(e: Nat) -> {KI.plog(S.Pos.pow2(e)) == Some{e} : Maybe<&2, Nat>}:
  match e:
    case 0n:
      {==}
    case 1n+k:
      %Equal.sym(Maybe<&2, Nat>, KI.plog(S.Pos.pow2(k)), Some{k}, plog_pow2(k)) : {KI.plog.succ(_) == Some{1n+k} : Maybe<&2, Nat>}
      {==}

def dofq_d(+m: S.Z, +e: Nat) -> {KI.dofq(S.D.toq(S.D{m, e})) == Some{S.D{m, e}} : Maybe<&2, S.D>}:
  %Equal.sym(Maybe<&2, Nat>, KI.plog(S.Pos.pow2(e)), Some{e}, plog_pow2(e)) : {KI.dofq.go(m, _) == Some{S.D{m, e}} : Maybe<&2, S.D>}
  {==}

def hofd(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, x: S.D) -> {N.emap(KI.dnum(), F, H, x) == M.ofd(~F, x) : @T}:
  match x:
    case S.D{+m, +e}:
      N.e_ofq(KI.dnum(), F, H)(S.D.toq(S.D{m, e}))(S.D{m, e})(dofq_d(m, e))

def ofkv_d(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, v: List<&2, S.D>) -> {N.ofkv(~KI.dnum(), ~F, ~H, v) == M.ofdv(~F, v) : M.Vec(~F)}:
  match v:
    case Nil{}:
      {==}
    case Con{+x, xs}:
      %Equal.sym(@T, N.emap(KI.dnum(), F, H, x), M.ofd(~F, x), hofd(~F, ~H, x)) : {Con{_, N.ofkv(~KI.dnum(), ~F, ~H, xs)} == Con{M.ofd(~F, x), M.ofdv(~F, xs)} : M.Vec(~F)}
      %Equal.sym(M.Vec(~F), N.ofkv(~KI.dnum(), ~F, ~H, xs), M.ofdv(~F, xs), ofkv_d(~F, ~H, xs)) : {Con{M.ofd(~F, x), _} == Con{M.ofd(~F, x), M.ofdv(~F, xs)} : M.Vec(~F)}
      {==}

def ofkm_d(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, a: List<&2, List<&2, S.D>>) -> {N.ofkm(~KI.dnum(), ~F, ~H, a) == M.ofdm(~F, a) : M.Mat(~F)}:
  match a:
    case Nil{}:
      {==}
    case Con{+r, rs}:
      %Equal.sym(M.Vec(~F), N.ofkv(~KI.dnum(), ~F, ~H, r), M.ofdv(~F, r), ofkv_d(~F, ~H, r)) : {Con{_, N.ofkm(~KI.dnum(), ~F, ~H, rs)} == Con{M.ofdv(~F, r), M.ofdm(~F, rs)} : M.Mat(~F)}
      %Equal.sym(M.Mat(~F), N.ofkm(~KI.dnum(), ~F, ~H, rs), M.ofdm(~F, rs), ofkm_d(~F, ~H, rs)) : {Con{M.ofdv(~F, r), _} == Con{M.ofdv(~F, r), M.ofdm(~F, rs)} : M.Mat(~F)}
      {==}

def bcen_zip(env: List<&2, S.D>) -> {KB.bcenters(~KI.dnum(), CK.zipb(~KI.dnum(), env, Nil{})) == env : List<&2, S.D>}:
  match env:
    case Nil{}:
      {==}
    case Con{+x, xs}:
      %Equal.sym(List<&2, S.D>, KB.bcenters(~KI.dnum(), CK.zipb(~KI.dnum(), xs, Nil{})), xs, bcen_zip(xs)) : {Con{x, _} == Con{x, xs} : List<&2, S.D>}
      {==}

# the solver's Jacobian at env (the slope centers at a box of radius 0)
def djac_ofd(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +eqs: List<&2, E.QExpr>, +n: Nat, +env: List<&2, S.D>, +hh: {CK.allheld(~KI.dnum(), eqs) == True{} : Bool}) -> {M.ofdm(~F, NU.jac(eqs, n, env)) == DV.jac(~F, M.ofdv(~F, env), eqs, ST.iota(n, 0n)) : M.Mat(~F)}:
  %ofkm_d(~F, ~H, NU.jac(eqs, n, env)) : {_ == DV.jac(~F, M.ofdv(~F, env), eqs, ST.iota(n, 0n)) : M.Mat(~F)}
  %ofkv_d(~F, ~H, env) : {N.ofkm(~KI.dnum(), ~F, ~H, NU.jac(eqs, n, env)) == DV.jac(~F, _, eqs, ST.iota(n, 0n)) : M.Mat(~F)}
  %bcen_zip(env) : {N.ofkm(~KI.dnum(), ~F, ~H, NU.jac(eqs, n, env)) == DV.jac(~F, N.ofkv(~KI.dnum(), ~F, ~H, _), eqs, ST.iota(n, 0n)) : M.Mat(~F)}
  BP.mcen_jac(~KI.dnum(), ~F, ~H, CK.zipb(~KI.dnum(), env, Nil{}), n, 0n, eqs, hh)

# the solver's values at env
def dvals_ofd(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +eqs: List<&2, E.QExpr>, +env: List<&2, S.D>, +hh: {CK.allheld(~KI.dnum(), eqs) == True{} : Bool}) -> {M.ofdv(~F, NU.vals(eqs, env)) == C.fvals(~F, eqs, M.ofdv(~F, env)) : M.Vec(~F)}:
  %ofkv_d(~F, ~H, NU.vals(eqs, env)) : {_ == C.fvals(~F, eqs, M.ofdv(~F, env)) : M.Vec(~F)}
  %ofkv_d(~F, ~H, env) : {N.ofkv(~KI.dnum(), ~F, ~H, NU.vals(eqs, env)) == C.fvals(~F, eqs, _) : M.Vec(~F)}
  CP.kvals_ofk(~KI.dnum(), ~F, ~H, env, eqs, hh)

def ddot_ofd(~F: O.OField, xs: List<&2, S.D>, ys: List<&2, S.D>) -> {M.ofd(~F, NU.ddot(xs, ys)) == M.dot(~F, M.ofdv(~F, xs), M.ofdv(~F, ys)) : @T}:
  match xs ys:
    case Nil{} ys:
      Equal.sym(@T, @0, M.ofd(~F, M.d0()), DM.ofd_zero(~F))
    case Con{+x, +t} Nil{}:
      Equal.sym(@T, @0, M.ofd(~F, M.d0()), DM.ofd_zero(~F))
    case Con{+x, +t} Con{+y, +u}:
      %DM.ofd_add(~F, S.D.mul(x, y), NU.ddot(t, u)) : {_ == M.dot(~F, Con{M.ofd(~F, x), M.ofdv(~F, t)}, Con{M.ofd(~F, y), M.ofdv(~F, u)}) : @T}
      %DM.ofd_mul(~F, x, y) : {@A(_, M.ofd(~F, NU.ddot(t, u))) == M.dot(~F, Con{M.ofd(~F, x), M.ofdv(~F, t)}, Con{M.ofd(~F, y), M.ofdv(~F, u)}) : @T}
      %Equal.sym(@T, M.ofd(~F, NU.ddot(t, u)), M.dot(~F, M.ofdv(~F, t), M.ofdv(~F, u)), ddot_ofd(~F, t, u)) : {@A(@M(M.ofd(~F, x), M.ofd(~F, y)), _) == M.dot(~F, Con{M.ofd(~F, x), M.ofdv(~F, t)}, Con{M.ofd(~F, y), M.ofdv(~F, u)}) : @T}
      {==}

def dmatvec_ofd(~F: O.OField, a: List<&2, List<&2, S.D>>, +v: List<&2, S.D>) -> {M.ofdv(~F, NU.dmatvec(a, v)) == M.matvec(~F, M.ofdm(~F, a), M.ofdv(~F, v)) : M.Vec(~F)}:
  match a:
    case Nil{}:
      {==}
    case Con{+r, +t}:
      %Equal.sym(@T, M.ofd(~F, NU.ddot(r, v)), M.dot(~F, M.ofdv(~F, r), M.ofdv(~F, v)), ddot_ofd(~F, r, v)) : {Con{_, M.ofdv(~F, NU.dmatvec(t, v))} == M.matvec(~F, M.ofdm(~F, Con{r, t}), M.ofdv(~F, v)) : M.Vec(~F)}
      %Equal.sym(M.Vec(~F), M.ofdv(~F, NU.dmatvec(t, v)), M.matvec(~F, M.ofdm(~F, t), M.ofdv(~F, v)), dmatvec_ofd(~F, t, v)) : {Con{M.dot(~F, M.ofdv(~F, r), M.ofdv(~F, v)), _} == M.matvec(~F, M.ofdm(~F, Con{r, t}), M.ofdv(~F, v)) : M.Vec(~F)}
      {==}

# Sums by index
# -------------

def nateq_sym(a: Nat, b: Nat) -> {KA.nateq(a, b) == KA.nateq(b, a) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+j:
      {==}
    case 1n+i 0n:
      {==}
    case 1n+i 1n+j:
      nateq_sym(i, j)

# the first n entries of r, each at most t, sum to at most n t
def rowabs_lt(~F: O.OField, r: M.Vec(~F), n: Nat, +t: @T, +ht: O.le(~F, @0, t), +h: GJ.All(~(k => M.bnd(~F, O.lookup(~F, r, k), t)), n)) -> O.le(~F, NP.rowabs(~F, r, n), @M(FR.ofn(~F, n), t)):
  match r n:
    case Nil{} 0n:
      FV.le_rw_r(~F, @0, @0, @M(@0, t), Equal.sym(@T, @M(@0, t), @0, FL.zero_mul(~F, t)), FO.le_refl(~F, @0))
    case Nil{} 1n++k:
      FO.mul_nonneg(~F, FR.ofn(~F, 1n+k), t, DG.ofn_nn(~F, 1n+k), ht)
    case Con{+a, +xs} 0n:
      FV.le_rw_r(~F, @0, @0, @M(@0, t), Equal.sym(@T, @M(@0, t), @0, FL.zero_mul(~F, t)), FO.le_refl(~F, @0))
    case Con{+a, +xs} 1n++k:
      FV.le_rw_r(~F, NP.rowabs(~F, Con{a, xs}, 1n+k), @A(t, @M(FR.ofn(~F, k), t)), @M(FR.ofn(~F, 1n+k), t), FR.fring_eq(~F, [t, FR.ofn(~F, k)], E.ZAdd{E.ZVar{0n}, E.ZMul{E.ZVar{1n}, E.ZVar{0n}}}, E.ZMul{E.ZAdd{E.ZCst{S.Zpos{S.XH{}}}, E.ZVar{1n}}, E.ZVar{0n}}, {==}),
        RP.le_add2(~F, FV.fabs(~F, a), t, NP.rowabs(~F, xs, k), @M(FR.ofn(~F, k), t),
          FV.fabs_le(~F, a, t, GJ.all_at(~(j => M.bnd(~F, O.lookup(~F, Con{a, xs}, j), t)), 1n+k, h, 0n, {==})),
          rowabs_lt(~F, xs, k, t, ht, DG.all_shift(~(j => M.bnd(~F, O.lookup(~F, Con{a, xs}, j), t)), k, h))))

def le_len(~F: O.OField, +v: M.Vec(~F), +n: Nat, lv: {M.len(~F, v) == n : Nat}) -> {KA.natle(M.len(~F, v), n) == True{} : Bool}:
  %Equal.sym(Nat, M.len(~F, v), n, lv) : {KA.natle(_, n) == True{} : Bool}
  GJ.le_refl(n)

def lt_len(~F: O.OField, +v: M.Vec(~F), +n: Nat, lv: {M.len(~F, v) == n : Nat}, +k: Nat, hk: {KA.natle(1n+k, M.len(~F, v)) == True{} : Bool}) -> {KA.natle(1n+k, n) == True{} : Bool}:
  %lv : {KA.natle(1n+k, _) == True{} : Bool}
  hk

# Approximate inverses
# --------------------
# A with every entry of I - A J at most e (C4's agood), J n x n.

# entry i of v - A J v is (unit_i - row i of A J) . v
def vf_eq(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +A: M.Mat(~F), +v: M.Vec(~F), +lv: {M.len(~F, v) == n : Nat}, +i: Nat) -> {O.lookup(~F, BX.vsub(~F, v, M.matvec(~F, A, M.matvec(~F, jm, v))), i) == M.dot(~F, BX.vsub(~F, GJ.unit(~F, n, i), M.vecmat(~F, DV.mrow(~F, A, i), jm)), v) : @T}:
  +w = M.matvec(~F, A, M.matvec(~F, jm, v))
  +vm = M.vecmat(~F, DV.mrow(~F, A, i), jm)
  +un = GJ.unit(~F, n, i)
  %Equal.sym(@T, O.lookup(~F, BX.vsub(~F, v, w), i), @S(O.lookup(~F, v, i), O.lookup(~F, w, i)), DG.look_diff(~F, v, w, i)) : {_ == M.dot(~F, BX.vsub(~F, un, vm), v) : @T}
  %Equal.sym(@T, O.lookup(~F, v, i), M.dot(~F, un, v), GJ.dot_unit(~F, n, i, v, le_len(~F, v, n, lv))) : {@S(_, O.lookup(~F, w, i)) == M.dot(~F, BX.vsub(~F, un, vm), v) : @T}
  %Equal.sym(@T, O.lookup(~F, w, i), M.dot(~F, DV.mrow(~F, A, i), M.matvec(~F, jm, v)), GJ.look_matvec(~F, A, M.matvec(~F, jm, v), i)) : {@S(M.dot(~F, un, v), _) == M.dot(~F, BX.vsub(~F, un, vm), v) : @T}
  %Equal.sym(@T, M.dot(~F, DV.mrow(~F, A, i), M.matvec(~F, jm, v)), M.dot(~F, vm, v), FM.vecmat_dot(~F, DV.mrow(~F, A, i), jm, v)) : {@S(M.dot(~F, un, v), _) == M.dot(~F, BX.vsub(~F, un, vm), v) : @T}
  %FM.dot_vadd(~F, un, M.vneg(~F, vm), v) : {@S(M.dot(~F, un, v), M.dot(~F, vm, v)) == _ : @T}
  %FM.dot_vneg(~F, vm, v) : {@S(M.dot(~F, un, v), M.dot(~F, vm, v)) == @A(M.dot(~F, un, v), _) : @T}
  {==}

# the entries of unit_i - row i of A J, below n
def vf_ent(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +A: M.Mat(~F), +e: @T, +ha: DG.agood(~F, n, jm, A, e), +i: Nat, +hi: {KA.natle(1n+i, n) == True{} : Bool}, +k: Nat, +hk: {KA.natle(1n+k, n) == True{} : Bool}) -> M.bnd(~F, O.lookup(~F, BX.vsub(~F, GJ.unit(~F, n, i), M.vecmat(~F, DV.mrow(~F, A, i), jm)), k), e):
  +vm = M.vecmat(~F, DV.mrow(~F, A, i), jm)
  %Equal.sym(@T, O.lookup(~F, BX.vsub(~F, GJ.unit(~F, n, i), vm), k), @S(O.lookup(~F, GJ.unit(~F, n, i), k), O.lookup(~F, vm, k)), DG.look_diff(~F, GJ.unit(~F, n, i), vm, k)) : M.bnd(~F, _, e)
  %GJ.look_unit(~F, n, i, k, hk) : M.bnd(~F, @S(_, O.lookup(~F, vm, k)), e)
  %Equal.sym(@T, O.lookup(~F, vm, k), M.dot(~F, DV.mrow(~F, A, i), GJ.mcol(~F, jm, k)), DG.look_vecmat(~F, DV.mrow(~F, A, i), jm, k)) : M.bnd(~F, @S(GJ.dl(~F, KA.nateq(k, i)), _), e)
  %nateq_sym(i, k) : M.bnd(~F, @S(GJ.dl(~F, _), M.dot(~F, DV.mrow(~F, A, i), GJ.mcol(~F, jm, k))), e)
  GJ.all_at(~(q => M.bnd(~F, @S(GJ.dl(~F, KA.nateq(i, q)), M.dot(~F, DV.mrow(~F, A, i), GJ.mcol(~F, jm, q))), e)), n,
    GJ.all_at(~(p => GJ.All(~(q => M.bnd(~F, @S(GJ.dl(~F, KA.nateq(p, q)), M.dot(~F, DV.mrow(~F, A, p), GJ.mcol(~F, jm, q))), e)), n)), n, ha, i, hi), k, hk)

# |(v - A J v)_i| <= n e |v|
def vf_at(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +A: M.Mat(~F), +e: @T, +he: O.le(~F, @0, e), +ha: DG.agood(~F, n, jm, A, e), +v: M.Vec(~F), +lv: {M.len(~F, v) == n : Nat}, +i: Nat, +hi: {KA.natle(1n+i, n) == True{} : Bool}) -> M.bnd(~F, O.lookup(~F, BX.vsub(~F, v, M.matvec(~F, A, M.matvec(~F, jm, v))), i), @M(@M(FR.ofn(~F, n), e), NP.vn(~F, v))):
  +r = BX.vsub(~F, GJ.unit(~F, n, i), M.vecmat(~F, DV.mrow(~F, A, i), jm))
  +hr = rowabs_lt(~F, r, n, e, he, GJ.all_mk(~n, ~(k => M.bnd(~F, O.lookup(~F, r, k), e)), ~(k => hk => vf_ent(~F, n, jm, A, e, ha, i, hi, k, hk)), n, GJ.le_refl(n)))
  %Equal.sym(@T, O.lookup(~F, BX.vsub(~F, v, M.matvec(~F, A, M.matvec(~F, jm, v))), i), M.dot(~F, r, v), vf_eq(~F, n, jm, A, v, lv, i)) : M.bnd(~F, _, @M(@M(FR.ofn(~F, n), e), NP.vn(~F, v)))
  FM.bnd_mono(~F, M.dot(~F, r, v), @M(NP.rowabs(~F, r, n), NP.vn(~F, v)), @M(@M(FR.ofn(~F, n), e), NP.vn(~F, v)),
    (%lv : M.bnd(~F, M.dot(~F, r, v), @M(NP.rowabs(~F, r, _), NP.vn(~F, v)))
      NP.dot_le(~F, r, v, NP.vn(~F, v), FV.vmax_all(~F, v), FV.vmax_nn(~F, v))),
    FM.sub_nonneg(~F, @M(NP.rowabs(~F, r, n), NP.vn(~F, v)), @M(@M(FR.ofn(~F, n), e), NP.vn(~F, v)), FV.mul_le_r(~F, NP.rowabs(~F, r, n), @M(FR.ofn(~F, n), e), NP.vn(~F, v), FV.vmax_nn(~F, v), hr)))

def len_vfa(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +A: M.Mat(~F), +hA: {GJ.nrows(~F, A) == n : Nat}, +v: M.Vec(~F), +lv: {M.len(~F, v) == n : Nat}) -> {M.len(~F, BX.vsub(~F, v, M.matvec(~F, A, M.matvec(~F, jm, v)))) == n : Nat}:
  CP.len_vsub(~F, v, M.matvec(~F, A, M.matvec(~F, jm, v)), n, lv, GJ.len_mv(~F, A, n, M.matvec(~F, jm, v), hA))

# the vector form of C4's bound: |v - A J v| <= n e |v|
def vform(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +A: M.Mat(~F), +e: @T, +he: O.le(~F, @0, e), +ha: DG.agood(~F, n, jm, A, e), +hA: {GJ.nrows(~F, A) == n : Nat}, +v: M.Vec(~F), +lv: {M.len(~F, v) == n : Nat}) -> O.le(~F, NP.vn(~F, BX.vsub(~F, v, M.matvec(~F, A, M.matvec(~F, jm, v)))), @M(@M(FR.ofn(~F, n), e), NP.vn(~F, v))):
  +d = BX.vsub(~F, v, M.matvec(~F, A, M.matvec(~F, jm, v)))
  +t = @M(@M(FR.ofn(~F, n), e), NP.vn(~F, v))
  FV.vmax_lub(~F, d, t, DG.vall_lt(~F, ~d, ~t, ~(k => hk => vf_at(~F, n, jm, A, e, he, ha, v, lv, k, lt_len(~F, d, n, len_vfa(~F, n, jm, A, hA, v, lv), k, hk)))),
    FO.mul_nonneg(~F, @M(FR.ofn(~F, n), e), NP.vn(~F, v), FO.mul_nonneg(~F, FR.ofn(~F, n), e, DG.ofn_nn(~F, n), he), FV.vmax_nn(~F, v)))

# |q| <= |p| + |p - q|
def tri_at(~F: O.OField, +p: M.Vec(~F), +q: M.Vec(~F), +k: Nat) -> M.bnd(~F, O.lookup(~F, q, k), @A(NP.vn(~F, p), NP.vn(~F, BX.vsub(~F, p, q)))):
  KB.bnd_val(~F, @S(O.lookup(~F, p, k), O.lookup(~F, BX.vsub(~F, p, q), k)), O.lookup(~F, q, k), @A(NP.vn(~F, p), NP.vn(~F, BX.vsub(~F, p, q))),
    (%Equal.sym(@T, O.lookup(~F, BX.vsub(~F, p, q), k), @S(O.lookup(~F, p, k), O.lookup(~F, q, k)), DG.look_diff(~F, p, q, k)) : {@S(O.lookup(~F, p, k), _) == O.lookup(~F, q, k) : @T}
      FR.fring_eq(~F, [O.lookup(~F, p, k), O.lookup(~F, q, k)], E.ZSub{E.ZVar{0n}, E.ZSub{E.ZVar{0n}, E.ZVar{1n}}}, E.ZVar{1n}, {==})),
    FM.bnd_add(~F, O.lookup(~F, p, k), NP.vn(~F, p), @N(O.lookup(~F, BX.vsub(~F, p, q), k)), NP.vn(~F, BX.vsub(~F, p, q)),
      DG.look_bnd(~F, p, k, NP.vn(~F, p), FV.vmax_all(~F, p), FV.vmax_nn(~F, p)),
      FM.bnd_neg(~F, O.lookup(~F, BX.vsub(~F, p, q), k), NP.vn(~F, BX.vsub(~F, p, q)), DG.look_bnd(~F, BX.vsub(~F, p, q), k, NP.vn(~F, BX.vsub(~F, p, q)), FV.vmax_all(~F, BX.vsub(~F, p, q)), FV.vmax_nn(~F, BX.vsub(~F, p, q))))))

def vn_tri(~F: O.OField, +p: M.Vec(~F), +q: M.Vec(~F)) -> O.le(~F, NP.vn(~F, q), @A(NP.vn(~F, p), NP.vn(~F, BX.vsub(~F, p, q)))):
  FV.vmax_lub(~F, q, @A(NP.vn(~F, p), NP.vn(~F, BX.vsub(~F, p, q))), DG.vall_by(~F, ~q, ~@A(NP.vn(~F, p), NP.vn(~F, BX.vsub(~F, p, q))), ~(k => tri_at(~F, p, q, k))),
    FO.nonneg_add(~F, NP.vn(~F, p), NP.vn(~F, BX.vsub(~F, p, q)), FV.vmax_nn(~F, p), FV.vmax_nn(~F, BX.vsub(~F, p, q))))

# alpha = (1 + n e) b
def alf(~F: O.OField, +n: Nat, +e: @T, +b: @T) -> @T:
  @M(@A(@1, @M(FR.ofn(~F, n), e)), b)

def alf_nn(~F: O.OField, +n: Nat, +e: @T, +b: @T, +he: O.le(~F, @0, e), +hb: O.le(~F, @0, b)) -> O.le(~F, @0, alf(~F, n, e, b)):
  FO.mul_nonneg(~F, @A(@1, @M(FR.ofn(~F, n), e)), b, FO.nonneg_add(~F, @1, @M(FR.ofn(~F, n), e), NP.one_nn(~F), FO.mul_nonneg(~F, FR.ofn(~F, n), e, DG.ofn_nn(~F, n), he)), hb)

# |A J u| <= (1 + n e) |u|
def aju(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +A: M.Mat(~F), +e: @T, +he: O.le(~F, @0, e), +ha: DG.agood(~F, n, jm, A, e), +hA: {GJ.nrows(~F, A) == n : Nat}, +u: M.Vec(~F), +lu: {M.len(~F, u) == n : Nat}) -> O.le(~F, NP.vn(~F, M.matvec(~F, A, M.matvec(~F, jm, u))), @M(@A(@1, @M(FR.ofn(~F, n), e)), NP.vn(~F, u))):
  DM.le_trans(~F, NP.vn(~F, M.matvec(~F, A, M.matvec(~F, jm, u))), @A(NP.vn(~F, u), NP.vn(~F, BX.vsub(~F, u, M.matvec(~F, A, M.matvec(~F, jm, u))))), @M(@A(@1, @M(FR.ofn(~F, n), e)), NP.vn(~F, u)),
    vn_tri(~F, u, M.matvec(~F, A, M.matvec(~F, jm, u))),
    FV.le_rw_r(~F, @A(NP.vn(~F, u), NP.vn(~F, BX.vsub(~F, u, M.matvec(~F, A, M.matvec(~F, jm, u))))), @A(NP.vn(~F, u), @M(@M(FR.ofn(~F, n), e), NP.vn(~F, u))), @M(@A(@1, @M(FR.ofn(~F, n), e)), NP.vn(~F, u)),
      FR.fring_eq(~F, [NP.vn(~F, u), FR.ofn(~F, n), e], E.ZAdd{E.ZVar{0n}, E.ZMul{E.ZMul{E.ZVar{1n}, E.ZVar{2n}}, E.ZVar{0n}}}, E.ZMul{E.ZAdd{E.ZCst{S.Zpos{S.XH{}}}, E.ZMul{E.ZVar{1n}, E.ZVar{2n}}}, E.ZVar{0n}}, {==}),
      RP.le_add2(~F, NP.vn(~F, u), NP.vn(~F, u), NP.vn(~F, BX.vsub(~F, u, M.matvec(~F, A, M.matvec(~F, jm, u)))), @M(@M(FR.ofn(~F, n), e), NP.vn(~F, u)), FO.le_refl(~F, NP.vn(~F, u)), vform(~F, n, jm, A, e, he, ha, hA, u, lu))))

# with Z an inverse of norm <= b: |A w| <= alpha |w|
def abound.go(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +A: M.Mat(~F), +e: @T, +b: @T, +he: O.le(~F, @0, e), +ha: DG.agood(~F, n, jm, A, e), +hA: {GJ.nrows(~F, A) == n : Nat}, +hj: {GJ.nrows(~F, jm) == n : Nat}, +z: M.Mat(~F), +hinv: DV.Inverse(~F, jm, z, n), +hz: {GJ.nrows(~F, z) == n : Nat}, +hzb: O.le(~F, NP.mnorm(~F, z, n), b), +w: M.Vec(~F), +lw: {M.len(~F, w) == n : Nat}) -> O.le(~F, NP.vn(~F, M.matvec(~F, A, w)), @M(alf(~F, n, e, b), NP.vn(~F, w))):
  +u = M.matvec(~F, z, w)
  +c1 = @A(@1, @M(FR.ofn(~F, n), e))
  %GJ.inv_r(~F, jm, z, n, hinv, hj, w, lw) : O.le(~F, NP.vn(~F, M.matvec(~F, A, _)), @M(alf(~F, n, e, b), NP.vn(~F, w)))
  DM.le_trans(~F, NP.vn(~F, M.matvec(~F, A, M.matvec(~F, jm, u))), @M(c1, NP.vn(~F, u)), @M(alf(~F, n, e, b), NP.vn(~F, w)),
    aju(~F, n, jm, A, e, he, ha, hA, u, GJ.len_mv(~F, z, n, w, hz)),
    FV.le_rw_r(~F, @M(c1, NP.vn(~F, u)), @M(c1, @M(b, NP.vn(~F, w))), @M(alf(~F, n, e, b), NP.vn(~F, w)), FR.fring_eq(~F, [c1, b, NP.vn(~F, w)], E.ZMul{E.ZVar{0n}, E.ZMul{E.ZVar{1n}, E.ZVar{2n}}}, E.ZMul{E.ZMul{E.ZVar{0n}, E.ZVar{1n}}, E.ZVar{2n}}, {==}),
      FV.mul_le(~F, c1, NP.vn(~F, u), @M(b, NP.vn(~F, w)), FO.nonneg_add(~F, @1, @M(FR.ofn(~F, n), e), NP.one_nn(~F), FO.mul_nonneg(~F, FR.ofn(~F, n), e, DG.ofn_nn(~F, n), he)),
        DM.le_trans(~F, NP.vn(~F, u), @M(NP.mnorm(~F, z, n), NP.vn(~F, w)), @M(b, NP.vn(~F, w)), NP.mv_n(~F, z, n, w, lw), FV.mul_le_r(~F, NP.mnorm(~F, z, n), b, NP.vn(~F, w), FV.vmax_nn(~F, w), hzb)))))

def abound(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +A: M.Mat(~F), +e: @T, +b: @T, +he: O.le(~F, @0, e), +ha: DG.agood(~F, n, jm, A, e), +hA: {GJ.nrows(~F, A) == n : Nat}, +hj: {GJ.nrows(~F, jm) == n : Nat}, +hJ: NP.InvB(~F, jm, n, b), +w: M.Vec(~F), +lw: {M.len(~F, w) == n : Nat}) -> O.le(~F, NP.vn(~F, M.matvec(~F, A, w)), @M(alf(~F, n, e, b), NP.vn(~F, w))):
  match hJ:
    case (+z, p):
      match p:
        case (hinv, q):
          match q:
            case (hz, hzb):
              abound.go(~F, n, jm, A, e, b, he, ha, hA, hj, z, hinv, hz, hzb, w, lw)

# An operator bound gives the norm
# --------------------------------
# |M s| <= c for every s of length n with |s| <= 1 (ob, a template lemma)
# gives mnorm(M, n) <= c: each row read against its own signs.

def op_row(~F: O.OField, ~a: M.Mat(~F), ~n: Nat, ~c: @T, ~ob: @s: M.Vec(~F) -> {M.len(~F, s) == n : Nat} -> O.le(~F, NP.vn(~F, s), @1) -> O.le(~F, NP.vn(~F, M.matvec(~F, a, s)), c), +k: Nat, +r: M.Vec(~F), +t: M.Mat(~F), e: {NP.mdrop(~F, k, a) == Con{r, t} : M.Mat(~F)}) -> O.le(~F, NP.rowabs(~F, r, n), c):
  %NP.sgnv_dot(~F, r, n) : O.le(~F, _, c)
  DM.le_trans(~F, M.dot(~F, r, NP.sgnv(~F, r, n)), NP.vn(~F, M.matvec(~F, Con{r, t}, NP.sgnv(~F, r, n))), c,
    DM.le_trans(~F, M.dot(~F, r, NP.sgnv(~F, r, n)), FV.fabs(~F, M.dot(~F, r, NP.sgnv(~F, r, n))), NP.vn(~F, M.matvec(~F, Con{r, t}, NP.sgnv(~F, r, n))), NP.bnd_lo(~F, M.dot(~F, r, NP.sgnv(~F, r, n)), FV.fabs(~F, M.dot(~F, r, NP.sgnv(~F, r, n))), FV.fabs_bnd(~F, M.dot(~F, r, NP.sgnv(~F, r, n)))), FV.fmax_l(~F, FV.fabs(~F, M.dot(~F, r, NP.sgnv(~F, r, n))), NP.vn(~F, M.matvec(~F, t, NP.sgnv(~F, r, n))))),
    DM.le_trans(~F, NP.vn(~F, M.matvec(~F, Con{r, t}, NP.sgnv(~F, r, n))), NP.vn(~F, M.matvec(~F, a, NP.sgnv(~F, r, n))), c,
      (%e : O.le(~F, NP.vn(~F, M.matvec(~F, _, NP.sgnv(~F, r, n))), NP.vn(~F, M.matvec(~F, a, NP.sgnv(~F, r, n))))
        NP.drop_mv(~F, k, a, NP.sgnv(~F, r, n))),
      ob(NP.sgnv(~F, r, n), NP.sgnv_len(~F, r, n), NP.sgnv_vn(~F, r, n))))

def op_rows(~F: O.OField, ~a: M.Mat(~F), ~n: Nat, ~c: @T, ~ob: @s: M.Vec(~F) -> {M.len(~F, s) == n : Nat} -> O.le(~F, NP.vn(~F, s), @1) -> O.le(~F, NP.vn(~F, M.matvec(~F, a, s)), c), rest: M.Mat(~F), +k: Nat, +e: {NP.mdrop(~F, k, a) == rest : M.Mat(~F)}) -> NP.rowsle(~F, rest, n, c):
  match rest:
    case Nil{}:
      Unit{}
    case Con{+r, +t}:
      (op_row(~F, ~a, ~n, ~c, ~ob, k, r, t, e), op_rows(~F, ~a, ~n, ~c, ~ob, t, 1n+k, NP.drop_succ(~F, k, a, r, t, e)))

def op_mn(~F: O.OField, ~a: M.Mat(~F), ~n: Nat, ~c: @T, ~ob: @s: M.Vec(~F) -> {M.len(~F, s) == n : Nat} -> O.le(~F, NP.vn(~F, s), @1) -> O.le(~F, NP.vn(~F, M.matvec(~F, a, s)), c), +hc: O.le(~F, @0, c)) -> O.le(~F, NP.mnorm(~F, a, n), c):
  NP.mnorm_lub(~F, a, n, c, op_rows(~F, ~a, ~n, ~c, ~ob, a, 0n, NP.mdrop0(~F, a)), hc)

# c |s| <= c for |s| <= 1
def le_by1(~F: O.OField, +x: @T, +c: @T, +s: @T, +hc: O.le(~F, @0, c), hx: O.le(~F, x, @M(c, s)), hs: O.le(~F, s, @1)) -> O.le(~F, x, c):
  DM.le_trans(~F, x, @M(c, s), c, hx, FV.le_rw_r(~F, @M(c, s), @M(c, @1), c, FR.fring_eq(~F, [c], E.ZMul{E.ZVar{0n}, E.ZCst{S.Zpos{S.XH{}}}}, E.ZVar{0n}, {==}), FV.mul_le(~F, c, s, @1, hc, hs)))

# mnorm(A) <= alpha
def amn(~F: O.OField, +n: Nat, +jm: M.Mat(~F), +A: M.Mat(~F), +e: @T, +b: @T, +he: O.le(~F, @0, e), +hb: O.le(~F, @0, b), +ha: DG.agood(~F, n, jm, A, e), +hA: {GJ.nrows(~F, A) == n : Nat}, +hj: {GJ.nrows(~F, jm) == n : Nat}, +hJ: NP.InvB(~F, jm, n, b)) -> O.le(~F, NP.mnorm(~F, A, n), alf(~F, n, e, b)):
  op_mn(~F, ~A, ~n, ~alf(~F, n, e, b), ~(s => ls => hs => le_by1(~F, NP.vn(~F, M.matvec(~F, A, s)), alf(~F, n, e, b), NP.vn(~F, s), alf_nn(~F, n, e, b, he, hb), abound(~F, n, jm, A, e, b, he, ha, hA, hj, hJ, s, ls), hs)), alf_nn(~F, n, e, b, he, hb))
