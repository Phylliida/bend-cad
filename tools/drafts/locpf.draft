# The block's entries
# -------------------

@MACRO XP xperm(~F, x, vp)
@MACRO PB PP.ftake(~F, o, $XP)
@MACRO YB PP.ftake(~F, n, PP.fdrop(~F, o, $XP))
@MACRO PLOC C.app(~F, $YB, PP.zmap(~F, $PB, pars))
@MACRO RR PL.rnv(vp, e)
@MACRO BLP ~F: O.OField, +x: M.Vec(~F), +vp: List<&2, Nat>, +o: Nat, +n: Nat, +pars: List<&2, Nat>
@MACRO BLA ~F, x, vp, o, n, pars
@MACRO HX +hX: {KA.natle(Nat.add(o, n), M.len(~F, $XP)) == True{} : Bool}
@MACRO EP +e: E.QExpr, +hin: {SV.inside(e, vp) == True{} : Bool}, +hb: {SL.below(Nat.add(o, n), $RR) == True{} : Bool}, +hl: {SL.below(Nat.add(n, PL.nlen(pars)), PL.rename(o, n, pars, $RR)) == True{} : Bool}
@MACRO EA e, hin, hb, hl

