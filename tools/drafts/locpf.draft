    case E.QCst{q}:
      {==}
    case E.QAdd{+a, +b}:
      L.band_i(SV.inside(DV.deriv(a, v), w), SV.inside(DV.deriv(b, v), w), inside_deriv(a, w, v, L.band_l(SV.inside(a, w), SV.inside(b, w), h)), inside_deriv(b, w, v, L.band_r(SV.inside(a, w), SV.inside(b, w), h)))
