  %hpos : {O.eval(~F, PP.ftake(~F, Nat.add(o, n), $XP), DV.deriv($RR, _)) == O.eval(~F, x, DV.deriv(e, w)) : @T}
  %Equal.sym(E.QExpr, DV.deriv($RR, PL.pos(w, vp)), PL.rnv(vp, DV.deriv(e, w)), BP.deriv_rnv(vp, w, hw, e)) : {O.eval(~F, PP.ftake(~F, Nat.add(o, n), $XP), _) == O.eval(~F, x, DV.deriv(e, w)) : @T}
  Equal.trans(@T, O.eval(~F, PP.ftake(~F, Nat.add(o, n), $XP), PL.rnv(vp, DV.deriv(e, w))), O.eval(~F, $XP, PL.rnv(vp, DV.deriv(e, w))), O.eval(~F, x, DV.deriv(e, w)),
    eval_ftake(~F, $XP, Nat.add(o, n), hX, PL.rnv(vp, DV.deriv(e, w)), (%BP.deriv_rnv(vp, w, hw, e) : {SL.below(Nat.add(o, n), _) == True{} : Bool}
      below_deriv(Nat.add(o, n), $RR, PL.pos(w, vp), hb))),
    eval_rnv(~F, x, vp, DV.deriv(e, w), inside_deriv(e, vp, w, hin)))

# d/dx_k of the renamed equation is the renamed d/dx_(o+k)
def dk_eq(+o: Nat, +n: Nat, +pars: List<&2, Nat>, +r: E.QExpr, +k: Nat, +hk: {KA.natle(1n+k, n) == True{} : Bool}) -> {DV.deriv(PL.rename(o, n, pars, r), k) == PL.rename(o, n, pars, DV.deriv(r, Nat.add(o, k))) : E.QExpr}:
  %loc_unk(o, n, pars, k) : {DV.deriv(PL.rename(o, n, pars, r), _) == PL.rename(o, n, pars, DV.deriv(r, Nat.add(o, k))) : E.QExpr}
