  Equal.trans(@T, O.eval(~F, $PLOC, PL.rename(o, n, pars, DV.deriv($RR, ok))), O.eval(~F, C.app(~F, $PB, $YB), DV.deriv($RR, ok)), O.eval(~F, x, DV.deriv(e, w)),
    PP.subst(~F, o, n, pars, $PB, $YB, DV.deriv($RR, ok), PP.len_ftake(~F, o, $XP, hoX), PP.len_ftake(~F, n, PP.fdrop(~F, o, $XP), ld_le(~F, o, n, $XP, hX)), below_deriv(Nat.add(o, n), $RR, ok, hb), ren_deriv_below(o, n, pars, Nat.add(n, PL.nlen(pars)), $RR, ok, hl)),
    ent.r(~F, x, vp, o, n, e, w, k, hpos, hw, hin, hb, hX))

def con_eq(~F: O.OField, +a1: @T, +a2: @T, +r1: M.Vec(~F), +r2: M.Vec(~F), ea: {a1 == a2 : @T}, er: {r1 == r2 : M.Vec(~F)}) -> {Con{a1, r1} == Con{a2, r2} : M.Vec(~F)}:
  %ea : {Con{a1, r1} == Con{_, r2} : M.Vec(~F)}
  %er : {Con{a1, r1} == Con{a1, _} : M.Vec(~F)}
  {==}

def con_eqm(~F: O.OField, +a1: M.Vec(~F), +a2: M.Vec(~F), +r1: M.Mat(~F), +r2: M.Mat(~F), ea: {a1 == a2 : M.Vec(~F)}, er: {r1 == r2 : M.Mat(~F)}) -> {Con{a1, r1} == Con{a2, r2} : M.Mat(~F)}:
  %ea : {Con{a1, r1} == Con{_, r2} : M.Mat(~F)}
  %er : {Con{a1, r1} == Con{a1, _} : M.Mat(~F)}
  {==}

# ws sit at positions o + k, o + k + 1, ... of vp
def posrun(+vp: List<&2, Nat>, ws: List<&2, Nat>, +o: Nat, +k: Nat) -> Bool:
  match ws:
    case Nil{}:
      True{}
    case Con{+w, t}:
      SV.band(KA.nateq(PL.pos(w, vp), Nat.add(o, k)), posrun(vp, t, o, 1n+k))

def succ_le(+k: Nat, +l: Nat, +n: Nat, h: {KA.natle(Nat.add(k, 1n+l), n) == True{} : Bool}) -> {KA.natle(1n+Nat.add(k, l), n) == True{} : Bool}:
  %Equal.sym(Nat, 1n+Nat.add(k, l), Nat.add(k, 1n+l), LN.add_succ(k, l)) : {KA.natle(_, n) == True{} : Bool}
  h

def jrow_loc($BLP, $EP, ws: List<&2, Nat>, +k: Nat, +hrun: {posrun(vp, ws, o, k) == True{} : Bool}, +hws: {L.subl(ws, vp) == True{} : Bool}, +hkn: {KA.natle(Nat.add(k, SV.len(ws)), n) == True{} : Bool}, $HX) -> {DV.jrow(~F, $PLOC, PL.rename(o, n, pars, $RR), ST.iota(SV.len(ws), k)) == DV.jrow(~F, x, e, ws) : M.Vec(~F)}:
  match ws:
    case Nil{}:
      {==}
    case Con{+w, +t}:
      +hkn2 = succ_le(k, SV.len(t), n, hkn)
      +hk = KA.natle_trans(1n+k, 1n+Nat.add(k, SV.len(t)), n, KA.natle_add_r(k, SV.len(t)), hkn2)
      +hp = KA.nateq_ok(PL.pos(w, vp), Nat.add(o, k), L.band_l(KA.nateq(PL.pos(w, vp), Nat.add(o, k)), posrun(vp, t, o, 1n+k), hrun))
      con_eq(~F, O.eval(~F, $PLOC, DV.deriv(PL.rename(o, n, pars, $RR), k)), O.eval(~F, x, DV.deriv(e, w)), DV.jrow(~F, $PLOC, PL.rename(o, n, pars, $RR), ST.iota(SV.len(t), 1n+k)), DV.jrow(~F, x, e, t),
        ent($BLA, $EA, w, k, hk, hp, L.subl_hd(w, t, vp, hws), hX),
        jrow_loc($BLA, $EA, t, 1n+k, L.band_r(KA.nateq(PL.pos(w, vp), Nat.add(o, k)), posrun(vp, t, o, 1n+k), hrun), L.subl_tl(w, t, vp, hws), hkn2, hX))

@MACRO EJ PL.eqget(full, j)
@MACRO RJ PL.rnv(vp, PL.eqget(full, j))

# each of the block's equations uses only variables of vp, lies below
# o + n in block order and below n + m once renumbered
def rowsok(+full: List<&2, E.QExpr>, +vp: List<&2, Nat>, +o: Nat, +n: Nat, +pars: List<&2, Nat>, es: List<&2, Nat>) -> Bool:
  match es:
    case Nil{}:
      True{}
    case Con{+j, t}:
      SV.band(SV.inside($EJ, vp), SV.band(SL.below(Nat.add(o, n), $RJ), SV.band(SL.below(Nat.add(n, PL.nlen(pars)), PL.rename(o, n, pars, $RJ)), rowsok(full, vp, o, n, pars, t))))

def jrow_blk($BLP, +full: List<&2, E.QExpr>, +j: Nat, +vs: List<&2, Nat>, +hrun: {posrun(vp, vs, o, 0n) == True{} : Bool}, +hvs: {L.subl(vs, vp) == True{} : Bool}, +hn: {SV.len(vs) == n : Nat}, +hin: {SV.inside($EJ, vp) == True{} : Bool}, +hb: {SL.below(Nat.add(o, n), $RJ) == True{} : Bool}, +hl: {SL.below(Nat.add(n, PL.nlen(pars)), PL.rename(o, n, pars, $RJ)) == True{} : Bool}, $HX) -> {DV.jrow(~F, $PLOC, PL.rename(o, n, pars, $RJ), ST.iota(n, 0n)) == DV.jrow(~F, x, $EJ, vs) : M.Vec(~F)}:
  %hn : {DV.jrow(~F, $PLOC, PL.rename(o, n, pars, $RJ), ST.iota(_, 0n)) == DV.jrow(~F, x, $EJ, vs) : M.Vec(~F)}
  jrow_loc($BLA, $EJ, hin, hb, hl, vs, 0n, hrun, hvs, (%Equal.sym(Nat, SV.len(vs), n, hn) : {KA.natle(_, n) == True{} : Bool}
    KA.natle_refl(n)), hX)

# the block's local Jacobian at (its unknowns ++ its parameters' values)
# is its Jacobian at x (equations es, unknowns vs, sketch numbering)
def jac_loc($BLP, +full: List<&2, E.QExpr>, es: List<&2, Nat>, +vs: List<&2, Nat>, +hrun: {posrun(vp, vs, o, 0n) == True{} : Bool}, +hvs: {L.subl(vs, vp) == True{} : Bool}, +hn: {SV.len(vs) == n : Nat}, +hr: {rowsok(full, vp, o, n, pars, es) == True{} : Bool}, $HX) -> {DV.jac(~F, $PLOC, PL.renames(o, n, pars, PL.reorder(vp, full, es)), ST.iota(n, 0n)) == DV.jac(~F, x, KP.pickk(full, 0n, es), vs) : M.Mat(~F)}:
  match es:
    case Nil{}:
      {==}
    case Con{+j, +t}:
      +h1 = L.band_l(SV.inside($EJ, vp), SV.band(SL.below(Nat.add(o, n), $RJ), SV.band(SL.below(Nat.add(n, PL.nlen(pars)), PL.rename(o, n, pars, $RJ)), rowsok(full, vp, o, n, pars, t))), hr)
      +h2 = L.band_r(SV.inside($EJ, vp), SV.band(SL.below(Nat.add(o, n), $RJ), SV.band(SL.below(Nat.add(n, PL.nlen(pars)), PL.rename(o, n, pars, $RJ)), rowsok(full, vp, o, n, pars, t))), hr)
      +h3 = L.band_l(SL.below(Nat.add(o, n), $RJ), SV.band(SL.below(Nat.add(n, PL.nlen(pars)), PL.rename(o, n, pars, $RJ)), rowsok(full, vp, o, n, pars, t)), h2)
      +h4 = L.band_r(SL.below(Nat.add(o, n), $RJ), SV.band(SL.below(Nat.add(n, PL.nlen(pars)), PL.rename(o, n, pars, $RJ)), rowsok(full, vp, o, n, pars, t)), h2)
      +h5 = L.band_l(SL.below(Nat.add(n, PL.nlen(pars)), PL.rename(o, n, pars, $RJ)), rowsok(full, vp, o, n, pars, t), h4)
      +h6 = L.band_r(SL.below(Nat.add(n, PL.nlen(pars)), PL.rename(o, n, pars, $RJ)), rowsok(full, vp, o, n, pars, t), h4)
      con_eqm(~F, DV.jrow(~F, $PLOC, PL.rename(o, n, pars, $RJ), ST.iota(n, 0n)), DV.jrow(~F, x, $EJ, vs), DV.jac(~F, $PLOC, PL.renames(o, n, pars, PL.reorder(vp, full, t)), ST.iota(n, 0n)), DV.jac(~F, x, KP.pickk(full, 0n, t), vs),
        jrow_blk($BLA, full, j, vs, hrun, hvs, hn, h1, h3, h5, hX),
        jac_loc($BLA, full, t, vs, hrun, hvs, hn, h6, hX))

# The block's inverse, locally
# ----------------------------

# an inverse's norm (over n columns)
def ibd(~F: O.OField, +a: M.Mat(~F), +n: Nat, h: GJ.InvN(~F, a, n)) -> @T:
  match h:
    case (z, p):
      NP.mnorm(~F, z, n)

def invb_of(~F: O.OField, +a: M.Mat(~F), +n: Nat, h: GJ.InvN(~F, a, n)) -> NP.InvB(~F, a, n, ibd(~F, a, n, h)):
  match h:
    case (+z, p):
      match p:
        case (hinv, hz):
          (z, (hinv, (hz, FO.le_refl(~F, NP.mnorm(~F, z, n)))))

@MACRO JSK DV.jac(~F, x, KP.pickk(full, 0n, es), vs)

# the block's local Jacobian has an inverse of norm ibd(...) (C5's hJ)
def loc_invb($BLP, +full: List<&2, E.QExpr>, +es: List<&2, Nat>, +vs: List<&2, Nat>, +hrun: {posrun(vp, vs, o, 0n) == True{} : Bool}, +hvs: {L.subl(vs, vp) == True{} : Bool}, +hn: {SV.len(vs) == n : Nat}, +hr: {rowsok(full, vp, o, n, pars, es) == True{} : Bool}, $HX, h: GJ.InvN(~F, $JSK, SV.len(vs))) -> NP.InvB(~F, DV.jac(~F, $PLOC, PL.renames(o, n, pars, PL.reorder(vp, full, es)), ST.iota(n, 0n)), n, ibd(~F, $JSK, SV.len(vs), h)):
  %Equal.sym(M.Mat(~F), DV.jac(~F, $PLOC, PL.renames(o, n, pars, PL.reorder(vp, full, es)), ST.iota(n, 0n)), $JSK, jac_loc($BLA, full, es, vs, hrun, hvs, hn, hr, hX)) : NP.InvB(~F, _, n, ibd(~F, $JSK, SV.len(vs), h))
  %hn : NP.InvB(~F, $JSK, _, ibd(~F, $JSK, SV.len(vs), h))
  invb_of(~F, $JSK, SV.len(vs), h)
