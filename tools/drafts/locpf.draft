    KA.natle_add_mono(o, 1n+k, n, hk)), r)

# entry (row e, column k) of the local Jacobian is d e / d x_w at x, w the
# block's k-th unknown
def ent($BLP, $EP, +w: Nat, +k: Nat, +hk: {KA.natle(1n+k, n) == True{} : Bool}, +hpos: {PL.pos(w, vp) == Nat.add(o, k) : Nat}, +hw: {SV.mem(w, vp) == True{} : Bool}, $HX) -> {O.eval(~F, $PLOC, DV.deriv(PL.rename(o, n, pars, $RR), k)) == O.eval(~F, x, DV.deriv(e, w)) : @T}:
