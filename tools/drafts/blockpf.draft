# bend-cad: one block at P, for solve_complete (DESIGN §10.4, C5d).
# Proofs only.
#
# block(eqs, n, pc, pr, y0, p) as the solver runs it: Newton from the
# drawing (lib/nwtpf.bend), elimination at the center, Y rounded to
# p/2 bits, the radius search (lib/radpf.bend). From a drawing within d
# of a regular solution x_b ++ x_z of the block (parameters' balls
# holding x_z) and smallness conditions in the given constants, block
# returns BOk of a certificate the checker accepts whose box holds x_b,
# with radii at most rb.

import Base
import ../spec/num.bend as S
import ../spec/ring.bend as E
import ../spec/field.bend as O
import ../spec/mat.bend as M
import ../spec/box.bend as BX
import ../spec/knum.bend as N
import ../spec/deriv.bend as DV
import ./karith.bend as KA
import ./kball.bend as KB
import ./cert.bend as CK
import ./certdef.bend as C
import ./certpf.bend as CP
import ./kinst.bend as KI
import ./numer.bend as NU
import ./struct.bend as ST
import ./fring.bend as FR
import ./ford.bend as FO
import ./fmat.bend as FM
import ./fvec.bend as FV
import ./dmat.bend as DM
import ./gjpf.bend as GJ
import ./normpf.bend as NP
import ./dgjpf.bend as DG
import ./bndpf.bend as BP
import ./roundpf.bend as RP
import ./real.bend as RL
import ./apxpf.bend as AP
import ./nwtpf.bend as NW
import ./radpf.bend as RD
import ./nat.bend as LN

@MACRO DN ~KI.dnum()
@MACRO DH ~KI.dnum(), ~F, ~H
@MACRO KH ~K: N.Num, ~F: O.OField, ~H: N.Emb<K, F>
@MACRO KHA ~K, ~F, ~H
@MACRO KP ~F: O.OField, +n: Nat, +m: Nat, +b: @T, +lam: @T, +ms: @T, +d: @T, +rho: @T, +p: Nat
@MACRO KA ~F, n, m, b, lam, ms, d, rho, p
@MACRO KPH ~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +m: Nat, +b: @T, +lam: @T, +ms: @T, +d: @T, +rho: @T, +p: Nat
@MACRO KAH ~F, ~H, n, m, b, lam, ms, d, rho, p
@MACRO NNP +hb0: O.le(~F, @0, b), +hl0: O.le(~F, @0, lam), +hm0: O.le(~F, @0, ms), +hd0: O.le(~F, @0, d), +hr0: O.le(~F, @0, rho)
@MACRO NNA hb0, hl0, hm0, hd0, hr0
@MACRO CXP ~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +m: Nat, +eqs: List<&2, E.QExpr>, +hn: {CK.eqlen(eqs) == n : Nat}, +hh: {CK.allheld(~KI.dnum(), eqs) == True{} : Bool}, +hbl: {CK.allbelow(Nat.add(n, m), eqs) == True{} : Bool}, +pc: List<&2, S.D>, +lpc: {M.len(~F, M.ofdv(~F, pc)) == m : Nat}, +p: Nat, +xb: M.Vec(~F), +xz: M.Vec(~F), +lxb: {M.len(~F, xb) == n : Nat}, +lxz: {M.len(~F, xz) == m : Nat}, +hz: {C.fvals(~F, eqs, C.app(~F, xb, xz)) == GJ.zeros(~F, n) : M.Vec(~F)}, +bb: @T, +lam: @T, +ms: @T, +b: @T, +d: @T, +rho: @T, $NNP, +hbb0: O.le(~F, @0, bb), +hbb: M.vbnd.all(~F, C.app(~F, xb, xz), @S(bb, @1)), +hq: AP.eqok(~F, bb, lam, ms, eqs), +hJ: NP.InvB(~F, NW.jc(~F, eqs, n, C.app(~F, xb, xz)), n, b), +hzc: M.vbnd.all(~F, BX.vsub(~F, M.ofdv(~F, pc), xz), rho), +hsm: AP.small(~F, n, ms, NW.bt2(~F, b), NU.wbits(p)), +s1: O.le(~F, @A(NW.dx($KA), NW.dx($KA)), @1), +s2: O.le(~F, @A(@M(b, @M(FR.ofn(~F, n), @M(lam, NW.dx($KA)))), @M(b, @M(FR.ofn(~F, n), @M(lam, NW.dx($KA))))), @1), +s4: O.le(~F, NW.settle($KA), NW.h6(~F, p))
@MACRO CXA ~F, ~H, n, m, eqs, hn, hh, hbl, pc, lpc, p, xb, xz, lxb, lxz, hz, bb, lam, ms, b, d, rho, $NNA, hbb0, hbb, hq, hJ, hzc, hsm, s1, s2, s4
@MACRO XS C.app(~F, xb, xz)
@MACRO BIG AP.fbx(~F, $XS, NW.dx($KA))
@MACRO FB ~BP.fnum(~F), ~F, ~BP.femb(~F)
@MACRO PTC C.app(~F, M.ofdv(~F, yc), M.ofdv(~F, pc))
@MACRO S0 CK.svec($DN, eqs, n, yc, Nil{}, ym, pc, pr)
@MACRO SD M.ofd(~F, NU.dvmax($S0))
@MACRO SVA ~F, ~H, n, eqs, yc, pc, pr, ym
@MACRO KPC KA.klen($DN, pc)

# The constants
# -------------
# vb = 2^-(p/2) (Y's rounding), yn bounds |Y|, thL |I - Y J|, thR
# |I - J Y|, sbc the self-map bound S at radius 0, ubc the search's
# upper bound, rbc = ubc + rho every radius in sight.

@MACRO VB AP.vbit(~F, Nat.div(p, 2n))
@MACRO JN @M(FR.ofn(~F, n), ms)

def ync($KP) -> @T:
  @M(@A(@1, $VB), NW.al($KA))

def thlc($KP) -> @T:
  @A(@M(FR.ofn(~F, n), NW.ea($KA)), @M(@M($VB, NW.al($KA)), $JN))

def thrc($KP) -> @T:
  @A(@M($JN, @M(@M(FR.ofn(~F, n), NW.ea($KA)), NW.bt2(~F, b))), @M($JN, @M($VB, NW.al($KA))))

def sbc($KP) -> @T:
  @A(@M(ync($KA), @A(@M(@M(FR.ofn(~F, n), ms), NW.en($KA)), @M(@M(FR.ofn(~F, m), ms), rho))), @M(ync($KA), @M(@M(FR.ofn(~F, m), ms), rho)))

@MACRO C17 M.ofd(~F, S.D{S.Zpos{S.XI{S.XO{S.XO{S.XO{S.XH{}}}}}}, 4n})
@MACRO E8 M.ofd(~F, S.D{S.Zpos{S.XO{S.XH{}}}, 8n})
@MACRO C65 M.ofd(~F, S.D{S.Zpos{S.XI{S.XO{S.XO{S.XO{S.XO{S.XO{S.XH{}}}}}}}}, 6n})

def ubc($KP) -> @T:
  @M(@M($C17, @A(@1, $E8)), @A(sbc($KA), sbc($KA)))

def rbc($KP) -> @T:
  @A(ubc($KA), rho)

# S is at most the largest |entry|
# -------------------------------

def dvmax_vn(~F: O.OField, xs: List<&2, S.D>) -> O.le(~F, M.ofd(~F, NU.dvmax(xs)), NP.vn(~F, M.ofdv(~F, xs))):
  match xs:
    case Nil{}:
      %DM.ofd_zero(~F) : O.le(~F, _, @0)
      FO.le_refl(~F, @0)
    case Con{+x, +t}:
      DG.ndmax_lub(~F, x, NU.dvmax(t), NP.vn(~F, M.ofdv(~F, Con{x, t})),
        DM.le_trans(~F, M.ofd(~F, x), FV.fabs(~F, M.ofd(~F, x)), NP.vn(~F, M.ofdv(~F, Con{x, t})), FV.bnd_lo(~F, M.ofd(~F, x), FV.fabs(~F, M.ofd(~F, x)), FV.fabs_bnd(~F, M.ofd(~F, x))), FV.fmax_l(~F, FV.fabs(~F, M.ofd(~F, x)), NP.vn(~F, M.ofdv(~F, t)))),
        DM.le_trans(~F, M.ofd(~F, NU.dvmax(t)), NP.vn(~F, M.ofdv(~F, t)), NP.vn(~F, M.ofdv(~F, Con{x, t})), dvmax_vn(~F, t), FV.fmax_r(~F, FV.fabs(~F, M.ofd(~F, x)), NP.vn(~F, M.ofdv(~F, t)))))

# K's |u| has F norm at most u's
def vn_kvabs($KH, u: N.KVec(~K)) -> O.le(~F, NP.vn(~F, N.ofkv($KHA, KA.kvabs(~K, u))), NP.vn(~F, N.ofkv($KHA, u))):
  match u:
    case Nil{}:
      FO.le_refl(~F, @0)
    case Con{+a, +us}:
      FV.fmax_lub(~F, FV.fabs(~F, @H(KA.kabs(~K, a))), NP.vn(~F, N.ofkv($KHA, KA.kvabs(~K, us))), NP.vn(~F, N.ofkv($KHA, Con{a, us})),
        DM.le_trans(~F, FV.fabs(~F, @H(KA.kabs(~K, a))), FV.fabs(~F, @H(a)), NP.vn(~F, N.ofkv($KHA, Con{a, us})), RD.kabs_ent($KHA, a), FV.fmax_l(~F, FV.fabs(~F, @H(a)), NP.vn(~F, N.ofkv($KHA, us)))),
        DM.le_trans(~F, NP.vn(~F, N.ofkv($KHA, KA.kvabs(~K, us))), NP.vn(~F, N.ofkv($KHA, us)), NP.vn(~F, N.ofkv($KHA, Con{a, us})), vn_kvabs($KHA, us), FV.fmax_r(~F, FV.fabs(~F, @H(a)), NP.vn(~F, N.ofkv($KHA, us)))))

# The parameters' |J0z| + Dz over a graded box: entries <= ms
# -----------------------------------------------------------

def mzr_all($KH, +rho: @T, +bb: @T, +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +box: List<&2, KB.KB<K>>, +hg: BP.gbox($KHA, rho, bb, box), +e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}, +ms: @T, +hms: O.le(~F, BP.ms(~F, bb, e), ms), cnt: Nat, +lo: Nat) -> M.vbnd.all(~F, N.ofkv($KHA, RD.mzr($KHA, box, e, cnt, lo)), ms):
  match cnt:
    case 0n:
      Unit{}
    case 1n++k:
      +g = BP.ksl_grade($KHA, rho, bb, hr, hb, box, hg, lo, e, hh)
      +c = KB.KB.c(K, KB.ksl(~K, lo, box, e))
      +r = KB.KB.r(K, KB.ksl(~K, lo, box, e))
      ((%KA.ea($KHA, KA.kabs(~K, c), r) : M.bnd(~F, _, ms)
         RD.bnd_of01(~F, @A(@H(KA.kabs(~K, c)), @H(r)), ms, FO.nonneg_add(~F, @H(KA.kabs(~K, c)), @H(r), KA.kabs_nonneg($KHA, c), BP.gf_0(~F, rho, @H(c), @H(r), BP.ms(~F, bb, e), BP.ls(~F, bb, e), g)), DM.le_trans(~F, @A(@H(KA.kabs(~K, c)), @H(r)), BP.ms(~F, bb, e), ms, RD.gr_m($KHA, rho, KB.ksl(~K, lo, box, e), BP.ms(~F, bb, e), BP.ls(~F, bb, e), g), hms))),
       mzr_all($KHA, rho, bb, hr, hb, box, hg, e, hh, ms, hms, k, 1n+lo))

def mz_rows_le($KH, +rho: @T, +bb: @T, +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +box: List<&2, KB.KB<K>>, +hg: BP.gbox($KHA, rho, bb, box), +lam: @T, +ms: @T, +hm0: O.le(~F, @0, ms), eqs: List<&2, E.QExpr>, +hq: AP.eqok(~F, bb, lam, ms, eqs), +hh: {CK.allheld(~K, eqs) == True{} : Bool}, +cnt: Nat, +lo: Nat) -> NP.rowsle(~F, N.ofkm($KHA, RD.mzm($KHA, box, cnt, lo, eqs)), cnt, @M(FR.ofn(~F, cnt), ms)):
  match eqs:
    case Nil{}:
      Unit{}
    case Con{+e, +es}:
      +he = KA.band_l(KB.held(~K, e), CK.allheld(~K, es), hh)
      +hes = KA.band_r(KB.held(~K, e), CK.allheld(~K, es), hh)
      (DG.rowabs_le(~F, N.ofkv($KHA, RD.mzr($KHA, box, e, cnt, lo)), cnt, ms, mzr_all($KHA, rho, bb, hr, hb, box, hg, e, he, ms, AP.eqok_ms(~F, bb, lam, ms, e, es, hq), cnt, lo), hm0),
       mz_rows_le($KHA, rho, bb, hr, hb, box, hg, lam, ms, hm0, es, AP.eqok_tl(~F, bb, lam, ms, e, es, hq), hes, cnt, lo))

def mzm_mn($KH, +rho: @T, +bb: @T, +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +box: List<&2, KB.KB<K>>, +hg: BP.gbox($KHA, rho, bb, box), +lam: @T, +ms: @T, +hm0: O.le(~F, @0, ms), +eqs: List<&2, E.QExpr>, +hq: AP.eqok(~F, bb, lam, ms, eqs), +hh: {CK.allheld(~K, eqs) == True{} : Bool}, +cnt: Nat, +lo: Nat) -> O.le(~F, NP.mnorm(~F, N.ofkm($KHA, RD.mzm($KHA, box, cnt, lo, eqs)), cnt), @M(FR.ofn(~F, cnt), ms)):
  NP.mnorm_lub(~F, N.ofkm($KHA, RD.mzm($KHA, box, cnt, lo, eqs)), cnt, @M(FR.ofn(~F, cnt), ms), mz_rows_le($KHA, rho, bb, hr, hb, box, hg, lam, ms, hm0, eqs, hq, hh, cnt, lo), FO.mul_nonneg(~F, FR.ofn(~F, cnt), ms, DG.ofn_nn(~F, cnt), hm0))

# The self-map bound at radius 0, in the given constants
# -------------------------------------------------------
# S <= |Y f(P)| + |B(0)| (G(0) = 0), f(P) = f(P) - f(x_b ++ x_z) through
# the slopes between them (both in the big F-box), B(0) <= yn (m ms) rho.

@MACRO YCP +yc: List<&2, S.D>, +lyc: {M.len(~F, M.ofdv(~F, yc)) == n : Nat}, +hyc: O.le(~F, NP.vn(~F, BX.vsub(~F, M.ofdv(~F, yc), xb)), NW.en($KA))
@MACRO YCA yc, lyc, hyc
@MACRO PRP +pr: List<&2, S.D>, +lpr: {M.len(~F, M.ofdv(~F, pr)) == m : Nat}, +hpn: FV.rnn(~F, M.ofdv(~F, pr)), +hzr: BX.rbnd(~F, BX.vsub(~F, xz, M.ofdv(~F, pc)), M.ofdv(~F, pr)), +hpr: M.vbnd.all(~F, M.ofdv(~F, pr), rho)
@MACRO PRA pr, lpr, hpn, hzr, hpr
@MACRO YMP +ym: List<&2, List<&2, S.D>>, +yn: @T, +hyn: O.le(~F, NP.mnorm(~F, M.ofdm(~F, ym), n), yn), +hyn0: O.le(~F, @0, yn)
@MACRO YMA ym, yn, hyn, hyn0
@MACRO RBP +rb: @T, +hrb: O.le(~F, @0, rb), +hcr: M.vbnd.all(~F, $PTC, @S(bb, rb)), +hprb: M.vbnd.all(~F, M.ofdv(~F, pr), rb)
@MACRO RBA rb, hrb, hcr, hprb
@MACRO TF @A(@M(@M(FR.ofn(~F, n), ms), NW.en($KA)), @M(@M(FR.ofn(~F, m), ms), rho))
@MACRO YK N.ofkm($DH, ym)
@MACRO FP C.fvals(~F, eqs, $PTC)

def klen_m($CXP) -> {$KPC == m : Nat}:
  Equal.trans(Nat, $KPC, M.len(~F, M.ofdv(~F, pc)), m, RD.klen_d(~F, ~H, pc), lpc)

def lyck(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +yc: List<&2, S.D>, +lyc: {M.len(~F, M.ofdv(~F, yc)) == n : Nat}) -> {KA.klen($DN, yc) == n : Nat}:
  Equal.trans(Nat, KA.klen($DN, yc), M.len(~F, M.ofdv(~F, yc)), n, RD.klen_d(~F, ~H, yc), lyc)

def d0_le(~F: O.OField, +t: @T, +h: O.le(~F, @0, t)) -> O.le(~F, M.ofd(~F, M.d0()), t):
  %DM.ofd_zero(~F) : O.le(~F, _, t)
  h

def fp_eq($CXP, +yc: List<&2, S.D>) -> {BX.vsub(~F, $FP, C.fvals(~F, eqs, $XS)) == $FP : M.Vec(~F)}:
  %Equal.sym(M.Vec(~F), C.fvals(~F, eqs, $XS), GJ.zeros(~F, n), hz) : {BX.vsub(~F, $FP, _) == $FP : M.Vec(~F)}
  RD.vsub_zeros(~F, $FP, n, Equal.trans(Nat, M.len(~F, $FP), CK.eqlen(eqs), n, CP.len_fvals(~F, eqs, $PTC), hn))

# |f(P)| <= n ms en + m ms rho
def fp_bnd($CXP, $YCP) -> O.le(~F, NP.vn(~F, $FP), $TF):
  +e = BX.vsub(~F, M.ofdv(~F, yc), xb)
  +dz = BX.vsub(~F, M.ofdv(~F, pc), xz)
  +sy = CP.smat(~F, $PTC, $XS, eqs, n, 0n)
  +sz = CP.smat(~F, $PTC, $XS, eqs, m, n)
  +in1 = NW.inbig($CXA, yc, lyc, NW.en($KA), NW.vall_of_vn(~F, e, NW.en($KA), hyc), NW.en_le_dx($CXA))
  +in2 = NW.xs_inbig($CXA)
  +hsy = AP.smat_maj(~F, NW.dx($KA), bb, NW.dx_nn($KA, $NNA), hbb0, $BIG, NW.gbig($CXA), $PTC, $XS, in1, in2, lam, ms, hm0, eqs, hq, n, 0n)
  +hsz = AP.smat_maj(~F, NW.dx($KA), bb, NW.dx_nn($KA, $NNA), hbb0, $BIG, NW.gbig($CXA), $PTC, $XS, in1, in2, lam, ms, hm0, eqs, hq, m, n)
  +le = CP.len_vsub(~F, M.ofdv(~F, yc), xb, n, lyc, lxb)
  +ld = CP.len_vsub(~F, M.ofdv(~F, pc), xz, m, lpc, lxz)
  %fp_eq($CXA, yc) : O.le(~F, NP.vn(~F, _), $TF)
  %Equal.sym(M.Vec(~F), BX.vsub(~F, $FP, C.fvals(~F, eqs, $XS)), M.vadd(~F, M.matvec(~F, sy, e), M.matvec(~F, sz, dz)), CP.fvecs_self(~F, M.ofdv(~F, yc), xb, M.ofdv(~F, pc), xz, eqs, n, m, hbl, lyc, lxb)) : O.le(~F, NP.vn(~F, _), $TF)
  DM.le_trans(~F, NP.vn(~F, M.vadd(~F, M.matvec(~F, sy, e), M.matvec(~F, sz, dz))), @A(NP.vn(~F, M.matvec(~F, sy, e)), NP.vn(~F, M.matvec(~F, sz, dz))), $TF, AP.vn_add(~F, M.matvec(~F, sy, e), M.matvec(~F, sz, dz)),
    FV.le_add2(~F, NP.vn(~F, M.matvec(~F, sy, e)), @M(@M(FR.ofn(~F, n), ms), NW.en($KA)), NP.vn(~F, M.matvec(~F, sz, dz)), @M(@M(FR.ofn(~F, m), ms), rho),
      DM.le_trans(~F, NP.vn(~F, M.matvec(~F, sy, e)), @M(NP.mnorm(~F, sy, n), NP.vn(~F, e)), @M(@M(FR.ofn(~F, n), ms), NW.en($KA)), NP.mv_n(~F, sy, n, e, le),
        NW.mm_le(~F, NP.mnorm(~F, sy, n), @M(FR.ofn(~F, n), ms), NP.vn(~F, e), NW.en($KA), FV.vmax_nn(~F, e), FO.mul_nonneg(~F, FR.ofn(~F, n), ms, DG.ofn_nn(~F, n), hm0), NP.mnorm_lub(~F, sy, n, @M(FR.ofn(~F, n), ms), AP.both_r(DG.mall(~F, sy, ms), NP.rowsle(~F, sy, n, @M(FR.ofn(~F, n), ms)), hsy), FO.mul_nonneg(~F, FR.ofn(~F, n), ms, DG.ofn_nn(~F, n), hm0)), hyc)),
      DM.le_trans(~F, NP.vn(~F, M.matvec(~F, sz, dz)), @M(NP.mnorm(~F, sz, m), NP.vn(~F, dz)), @M(@M(FR.ofn(~F, m), ms), rho), NP.mv_n(~F, sz, m, dz, ld),
        NW.mm_le(~F, NP.mnorm(~F, sz, m), @M(FR.ofn(~F, m), ms), NP.vn(~F, dz), rho, FV.vmax_nn(~F, dz), FO.mul_nonneg(~F, FR.ofn(~F, m), ms, DG.ofn_nn(~F, m), hm0), NP.mnorm_lub(~F, sz, m, @M(FR.ofn(~F, m), ms), AP.both_r(DG.mall(~F, sz, ms), NP.rowsle(~F, sz, m, @M(FR.ofn(~F, m), ms)), hsz), FO.mul_nonneg(~F, FR.ofn(~F, m), ms, DG.ofn_nn(~F, m), hm0)), FV.vmax_lub(~F, dz, rho, hzc, hr0)))))

def yk_mn(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, $YMP) -> O.le(~F, NP.mnorm(~F, $YK, n), yn):
  %Equal.sym(M.Mat(~F), $YK, M.ofdm(~F, ym), AP.ofkm_d(~F, ~H, ym)) : O.le(~F, NP.mnorm(~F, _, n), yn)
  hyn

def vf_bnd($CXP, $YCP, $YMP) -> O.le(~F, NP.vn(~F, M.matvec(~F, $YK, $FP)), @M(yn, $TF)):
  DM.le_trans(~F, NP.vn(~F, M.matvec(~F, $YK, $FP)), @M(NP.mnorm(~F, $YK, n), NP.vn(~F, $FP)), @M(yn, $TF), NP.mv_n(~F, $YK, n, $FP, Equal.trans(Nat, M.len(~F, $FP), CK.eqlen(eqs), n, CP.len_fvals(~F, eqs, $PTC), hn)),
    NW.mm_le(~F, NP.mnorm(~F, $YK, n), yn, NP.vn(~F, $FP), $TF, FV.vmax_nn(~F, $FP), hyn0, yk_mn(~F, ~H, n, $YMA), fp_bnd($CXA, $YCA)))

# |Y f(P)| <= yn (n ms en + m ms rho)
def av_bnd($CXP, $YCP, +pr: List<&2, S.D>, $YMP) -> O.le(~F, NP.vn(~F, N.ofkv($DH, RD.ayf($SVA))), @M(yn, $TF)):
  +lycK = lyck(~F, ~H, n, yc, lyc)
  +u = KA.kmatvec($DN, ym, CK.kvals($DN, KA.kapp($DN, yc, pc), eqs))
  DM.le_trans(~F, NP.vn(~F, N.ofkv($DH, KA.kvabs($DN, u))), NP.vn(~F, N.ofkv($DH, u)), @M(yn, $TF), vn_kvabs($DH, u),
    (%CP.yft_ok($DH, eqs, n, yc, ym, pc, hh, Equal.trans(Nat, M.len(~F, N.ofkv($DH, yc)), KA.klen($DN, yc), n, CP.len_ofkv($DH, yc), lycK)) : O.le(~F, NP.vn(~F, _), @M(yn, $TF))
      (%Equal.sym(M.Vec(~F), C.fit(~F, n, N.ofkv($DH, yc)), M.ofdv(~F, yc), RD.fit_d(~F, ~H, n, yc, lycK)) : O.le(~F, NP.vn(~F, M.matvec(~F, $YK, C.fvals(~F, eqs, C.app(~F, _, N.ofkv($DH, pc))))), @M(yn, $TF))
        (%Equal.sym(M.Vec(~F), N.ofkv($DH, pc), M.ofdv(~F, pc), AP.ofkv_d(~F, ~H, pc)) : O.le(~F, NP.vn(~F, M.matvec(~F, $YK, C.fvals(~F, eqs, C.app(~F, M.ofdv(~F, yc), _)))), @M(yn, $TF))
          vf_bnd($CXA, $YCA, $YMA)))))

def vpk(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +pr: List<&2, S.D>, +rho: @T, +hr0: O.le(~F, @0, rho), +hpr: M.vbnd.all(~F, M.ofdv(~F, pr), rho)) -> O.le(~F, NP.vn(~F, N.ofkv($DH, pr)), rho):
  %Equal.sym(M.Vec(~F), N.ofkv($DH, pr), M.ofdv(~F, pr), AP.ofkv_d(~F, ~H, pr)) : O.le(~F, NP.vn(~F, _), rho)
  FV.vmax_lub(~F, M.ofdv(~F, pr), rho, hpr, hr0)

@MACRO TB2 @M(yn, @M(@M(FR.ofn(~F, $KPC), ms), rho))

# B(0) <= yn (m ms) rho
def b0_bnd($CXP, +yc: List<&2, S.D>, +lyc: {M.len(~F, M.ofdv(~F, yc)) == n : Nat}, $PRP, $YMP, $RBP) -> O.le(~F, NP.vn(~F, N.ofkv($DH, RD.bk($SVA, Nil{}))), $TB2):
  +kp = $KPC
  +b0 = CK.box($DN, n, yc, Nil{}, pc, pr)
  +mz = N.ofkm($DH, RD.mzm($DH, b0, kp, n, eqs))
  +pk = N.ofkv($DH, pr)
  +ya = N.ofkm($DH, KA.kmabs($DN, ym))
  +w = M.matvec(~F, mz, pk)
  +lycK = lyck(~F, ~H, n, yc, lyc)
  +hkm = klen_m($CXA)
  +lpp = Equal.trans(Nat, kp, m, KA.klen($DN, pr), hkm, Equal.sym(Nat, KA.klen($DN, pr), m, Equal.trans(Nat, KA.klen($DN, pr), M.len(~F, M.ofdv(~F, pr)), m, RD.klen_d(~F, ~H, pr), lpr)))
  +gb0 = RD.gbox_ckb(~F, ~H, n, yc, Nil{}, pc, pr, lycK, lpp, M.d0(), RD.kfit_nil(n), rb, bb, hcr, RD.dnn(~F, ~H, M.d0(), {==}), d0_le(~F, rb, hrb), hpn, hprb)
  +lw = Equal.trans(Nat, M.len(~F, w), GJ.nrows(~F, mz), n, Equal.sym(Nat, GJ.nrows(~F, mz), M.len(~F, w), GJ.len_matvec(~F, mz, pk)), Equal.trans(Nat, GJ.nrows(~F, mz), CK.eqlen(eqs), n, RD.nrows_mzm($DH, b0, kp, n, eqs), hn))
  +lp = Equal.trans(Nat, M.len(~F, pk), KA.klen($DN, pr), kp, CP.len_ofkv($DH, pr), Equal.sym(Nat, kp, KA.klen($DN, pr), lpp))
  %Equal.sym(M.Vec(~F), N.ofkv($DH, RD.bk($SVA, Nil{})), M.matvec(~F, ya, w), RD.bf_eq($SVA, Nil{})) : O.le(~F, NP.vn(~F, _), $TB2)
  DM.le_trans(~F, NP.vn(~F, M.matvec(~F, ya, w)), @M(NP.mnorm(~F, ya, n), NP.vn(~F, w)), $TB2, NP.mv_n(~F, ya, n, w, lw),
    NW.mm_le(~F, NP.mnorm(~F, ya, n), yn, NP.vn(~F, w), @M(@M(FR.ofn(~F, kp), ms), rho), FV.vmax_nn(~F, w), hyn0, RD.kabs_mn($DH, ym, n, yn, hyn0, yk_mn(~F, ~H, n, $YMA)),
      DM.le_trans(~F, NP.vn(~F, w), @M(NP.mnorm(~F, mz, kp), NP.vn(~F, pk)), @M(@M(FR.ofn(~F, kp), ms), rho), NP.mv_n(~F, mz, kp, pk, lp),
        NW.mm_le(~F, NP.mnorm(~F, mz, kp), @M(FR.ofn(~F, kp), ms), NP.vn(~F, pk), rho, FV.vmax_nn(~F, pk), FO.mul_nonneg(~F, FR.ofn(~F, kp), ms, DG.ofn_nn(~F, kp), hm0), mzm_mn($DH, rb, bb, hrb, hbb0, b0, gb0, lam, ms, hm0, eqs, hq, hh, kp, n), vpk(~F, ~H, pr, rho, hr0, hpr)))))

@MACRO TS @A(@M(yn, $TF), @M(yn, @M(@M(FR.ofn(~F, m), ms), rho)))

def ts_eq($CXP, +yn: @T) -> {@A(@A(@M(yn, $TF), $TB2), @0) == $TS : @T}:
  %Equal.sym(Nat, $KPC, m, klen_m($CXA)) : {@A(@A(@M(yn, $TF), @M(yn, @M(@M(FR.ofn(~F, _), ms), rho))), @0) == $TS : @T}
  FR.fring_eq(~F, [@M(yn, $TF), @M(yn, @M(@M(FR.ofn(~F, m), ms), rho))], E.ZAdd{E.ZAdd{E.ZVar{0n}, E.ZVar{1n}}, E.ZCst{S.Z0{}}}, E.ZAdd{E.ZVar{0n}, E.ZVar{1n}}, {==})

# S <= yn (n ms en + m ms rho) + yn (m ms rho)
def s_bnd($CXP, $YCP, $PRP, $YMP, $RBP) -> O.le(~F, $SD, $TS):
  +av = N.ofkv($DH, RD.ayf($SVA))
  +bv = N.ofkv($DH, RD.bk($SVA, Nil{}))
  +gv = N.ofkv($DH, CK.gvec($DN, eqs, n, yc, Nil{}, ym, pc, pr))
  DM.le_trans(~F, $SD, NP.vn(~F, M.ofdv(~F, $S0)), $TS, dvmax_vn(~F, $S0),
    (%AP.ofkv_d(~F, ~H, $S0) : O.le(~F, NP.vn(~F, _), $TS)
      (%Equal.sym(M.Vec(~F), N.ofkv($DH, $S0), M.vadd(~F, M.vadd(~F, av, bv), gv), RD.svec_f($SVA, Nil{})) : O.le(~F, NP.vn(~F, _), $TS)
        DM.le_trans(~F, NP.vn(~F, M.vadd(~F, M.vadd(~F, av, bv), gv)), @A(NP.vn(~F, M.vadd(~F, av, bv)), NP.vn(~F, gv)), $TS, AP.vn_add(~F, M.vadd(~F, av, bv), gv),
          FV.le_rw_r(~F, @A(NP.vn(~F, M.vadd(~F, av, bv)), NP.vn(~F, gv)), @A(@A(@M(yn, $TF), $TB2), @0), $TS, ts_eq($CXA, yn),
            FV.le_add2(~F, NP.vn(~F, M.vadd(~F, av, bv)), @A(@M(yn, $TF), $TB2), NP.vn(~F, gv), @0,
              DM.le_trans(~F, NP.vn(~F, M.vadd(~F, av, bv)), @A(NP.vn(~F, av), NP.vn(~F, bv)), @A(@M(yn, $TF), $TB2), AP.vn_add(~F, av, bv),
                FV.le_add2(~F, NP.vn(~F, av), @M(yn, $TF), NP.vn(~F, bv), $TB2, av_bnd($CXA, $YCA, pr, $YMA), b0_bnd($CXA, yc, lyc, $PRA, $YMA, $RBA))),
              RD.g0_bnd($SVA)))))))

# Y = A rounded to p/2 bits
# -------------------------

def nrows_ofdm(~F: O.OField, a: List<&2, List<&2, S.D>>) -> {GJ.nrows(~F, M.ofdm(~F, a)) == CK.mlen($DN, a) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{r, t}:
      %Equal.sym(Nat, GJ.nrows(~F, M.ofdm(~F, t)), CK.mlen($DN, t), nrows_ofdm(~F, t)) : {1n+_ == 1n+CK.mlen($DN, t) : Nat}
      {==}

def mlen_ysig(+b: Nat, a: List<&2, List<&2, S.D>>) -> {CK.mlen($DN, NU.ysig(b, a)) == CK.mlen($DN, a) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{r, t}:
      %Equal.sym(Nat, CK.mlen($DN, NU.ysig(b, t)), CK.mlen($DN, t), mlen_ysig(b, t)) : {1n+_ == 1n+CK.mlen($DN, t) : Nat}
      {==}

@MACRO YY NU.ysig(Nat.div(p, 2n), inv)
