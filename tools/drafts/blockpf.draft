# The block's smallness conditions
# --------------------------------
# w1: the box of radius rb about the center keeps magnitude below bb;
# w2: thR < 1; w3: the window, cw <= 1/2; w4: x_b in the box.

@MACRO WSP +w1: O.le(~F, @A(NW.dx($KA), rbc($KA)), @1), +w2: O.lt(F, thrc($KA), @1), +w3: O.le(~F, @A(@A(thlc($KA), @M(ync($KA), @M(FR.ofn(~F, n), @M(lam, rbc($KA))))), @M(ync($KA), @M(FR.ofn(~F, m), @M(lam, rbc($KA))))), M.ofd(~F, NU.half())), +w4: O.le(~F, @M($C65, @A(thlc($KA), @M(ync($KA), @M(FR.ofn(~F, n), @M(lam, NW.dx($KA)))))), @S($C65, @1))
@MACRO WSA w1, w2, w3, w4

def w3k($CXP, $WSP) -> O.le(~F, @A(@A(thlc($KA), @M(ync($KA), @M(FR.ofn(~F, n), @M(lam, rbc($KA))))), @M(ync($KA), @M(FR.ofn(~F, $KPC), @M(lam, rbc($KA))))), M.ofd(~F, NU.half())):
  %Equal.sym(Nat, $KPC, m, klen_m($CXA)) : O.le(~F, @A(@A(thlc($KA), @M(ync($KA), @M(FR.ofn(~F, n), @M(lam, rbc($KA))))), @M(ync($KA), @M(FR.ofn(~F, _), @M(lam, rbc($KA))))), M.ofd(~F, NU.half()))
  w3

def hab_k($CXP) -> {CK.allbelow(Nat.add(n, $KPC), eqs) == True{} : Bool}:
  %Equal.sym(Nat, $KPC, m, klen_m($CXA)) : {CK.allbelow(Nat.add(n, _), eqs) == True{} : Bool}
  hbl

def lxz_k($CXP) -> {M.len(~F, xz) == $KPC : Nat}:
  Equal.trans(Nat, M.len(~F, xz), m, $KPC, lxz, Equal.sym(Nat, $KPC, m, klen_m($CXA)))

def lpp_k($CXP, $PRP) -> {$KPC == KA.klen($DN, pr) : Nat}:
  Equal.trans(Nat, $KPC, m, KA.klen($DN, pr), klen_m($CXA), Equal.sym(Nat, KA.klen($DN, pr), m, Equal.trans(Nat, KA.klen($DN, pr), M.len(~F, M.ofdv(~F, pr)), m, RD.klen_d(~F, ~H, pr), lpr)))

# the center's point and the parameters stay inside magnitude bb - t
def cen_mag($CXP, $YCP, +t: @T, +hs: O.le(~F, @A(NW.dx($KA), t), @1)) -> M.vbnd.all(~F, $PTC, @S(bb, t)):
  NW.gnear(~F, $PTC, $XS, bb, NW.dx($KA), t, hbb, NW.ptnear($CXA, yc, lyc, NW.en($KA), hyc_all($CXA, $YCA), NW.en_le_dx($CXA)), hs, NW.lpt_xs($CXA, yc, lyc))

def rho_le_rb($CXP) -> O.le(~F, rho, rbc($KA)):
  FV.le_addl(~F, ubc($KA), rho, FO.mul_nonneg(~F, @M($C17, @A(@1, $E8)), @A(sbc($KA), sbc($KA)), c17e_nn(~F, ~H), FO.nonneg_add(~F, sbc($KA), sbc($KA), sbc_nn($KA, $NNA), sbc_nn($KA, $NNA))))

@MACRO S0Y CK.svec($DN, eqs, n, yc, Nil{}, $YY, pc, pr)
@MACRO SDY M.ofd(~F, NU.dvmax($S0Y))
@MACRO UBS @M(@M($C17, @A(@1, $E8)), @A($SDY, $SDY))

# the search's upper bound U is below rb
def ub_rb($CXP, $YCP, $PRP, $AIP, $WSP) -> O.le(~F, $UBS, rbc($KA)):
  +rb = rbc($KA)
  +hs = s_bnd($CXA, $YCA, $PRA, $YY, ync($KA), y_mn($CXA, $YCA, $AIA), ync_nn($KA, $NNA), rb, rbc_nn($KAH, $NNA), cen_mag($CXA, $YCA, rb, w1), NW.vall_le(~F, M.ofdv(~F, pr), rho, rb, hpr, rho_le_rb($CXA)))
  DM.le_trans(~F, $UBS, ubc($KA), rb,
    NW.mm_le(~F, @M($C17, @A(@1, $E8)), @M($C17, @A(@1, $E8)), @A($SDY, $SDY), @A(sbc($KA), sbc($KA)), FO.nonneg_add(~F, $SDY, $SDY, RD.dvmax_nn(~F, $S0Y), RD.dvmax_nn(~F, $S0Y)), c17e_nn(~F, ~H), FO.le_refl(~F, @M($C17, @A(@1, $E8))), FV.le_add2(~F, $SDY, sbc($KA), $SDY, sbc($KA), hs, hs)),
    FV.le_addr(~F, ubc($KA), rho, hr0))

# The block's outcome
# -------------------
# BOk of a certificate the checker accepts, whose box holds x_b, radii
# in [0, rb], n of them, and whose parameters' balls are the inputs pc0,
# pr0 (the plan checker reads them back).

def bgc(~F: O.OField, +n: Nat, +eqs: List<&2, E.QExpr>, +xb: M.Vec(~F), +rb: @T, +pc0: List<&2, S.D>, +pr0: List<&2, S.D>, c: C.Cert<KI.dnum()>) -> Data:
  match c:
    case C.Cert{+yc, +yr, +q, +ym, +pc, +pr}:
      M.Both({CK.check($DN, C.Block{eqs, n}, C.Cert{yc, yr, q, ym, pc, pr}) == True{} : Bool}, M.Both(BX.rbnd(~F, BX.vsub(~F, xb, M.ofdv(~F, yc)), M.ofdv(~F, yr)), M.Both(FV.rnn(~F, M.ofdv(~F, yr)), M.Both(M.vbnd.all(~F, M.ofdv(~F, yr), rb), M.Both({KA.klen($DN, yr) == n : Nat}, M.Both({pc == pc0 : List<&2, S.D>}, {pr == pr0 : List<&2, S.D>}))))))

def bgood(~F: O.OField, +n: Nat, +eqs: List<&2, E.QExpr>, +xb: M.Vec(~F), +rb: @T, +pc0: List<&2, S.D>, +pr0: List<&2, S.D>, br: NU.BR) -> Data:
  match br:
    case NU.BOk{c}:
      bgc(~F, n, eqs, xb, rb, pc0, pr0, c)
    case NU.BRetry{}:
      Empty
    case NU.BStop{}:
      Empty

def rbnd_vall(~F: O.OField, v: M.Vec(~F), +n: Nat, +t: @T, lv: {M.len(~F, v) == n : Nat}, h: M.vbnd.all(~F, v, t)) -> BX.rbnd(~F, v, RD.frep(~F, n, t)):
  match v n:
    case Nil{} n:
      Unit{}
    case Con{+a, +as} 0n:
      FO.absurd(BX.rbnd(~F, Con{a, as}, RD.frep(~F, 0n, t)), FV.succ_ne(M.len(~F, as), lv))
    case Con{+a, +as} 1n++k:
      (h1, h2) = h
      (h1, rbnd_vall(~F, as, k, t, LN.succ_inj(M.len(~F, as), k, lv), h2))

@MACRO RG RD.rgood(~F, ~H, n, eqs, yc, pc, pr, $YY, mr)

# the search's radius makes the certificate
def br_ok($CXP, $YCP, $PRP, $AIP, $WSP, +hU: O.le(~F, $UBS, rbc($KA)), +hib: O.le(~F, NP.vn(~F, BX.vsub(~F, M.ofdv(~F, yc), xb)), @M($SDY, $C65)), mr: Maybe<&2, S.D>, +hg: $RG) -> bgood(~F, n, eqs, xb, rbc($KA), pc, pr, NU.block.r(mr, n, yc, $YY, pc, pr)):
  match mr:
    case None{}:
      FO.absurd(bgood(~F, n, eqs, xb, rbc($KA), pc, pr, NU.block.r(None{}, n, yc, $YY, pc, pr)), hg)
    case Some{+r}:
      +hok = AP.both_l({NU.okr(eqs, n, yc, r, $YY, pc, pr) == True{} : Bool}, M.Both(O.le(~F, @M($SDY, $C65), M.ofd(~F, r)), O.le(~F, M.ofd(~F, r), $UBS)), hg)
      +hb2 = AP.both_r({NU.okr(eqs, n, yc, r, $YY, pc, pr) == True{} : Bool}, M.Both(O.le(~F, @M($SDY, $C65), M.ofd(~F, r)), O.le(~F, M.ofd(~F, r), $UBS)), hg)
      +hlo = AP.both_l(O.le(~F, @M($SDY, $C65), M.ofd(~F, r)), O.le(~F, M.ofd(~F, r), $UBS), hb2)
      +hhi = AP.both_r(O.le(~F, @M($SDY, $C65), M.ofd(~F, r)), O.le(~F, M.ofd(~F, r), $UBS), hb2)
      +R = M.ofd(~F, r)
      +hr0r = DM.le_trans(~F, @0, @M($SDY, $C65), R, FO.mul_nonneg(~F, $SDY, $C65, RD.dvmax_nn(~F, $S0Y), RD.c65_nn(~F, ~H)), hlo)
      +hrbr = DM.le_trans(~F, R, $UBS, rbc($KA), hhi, hU)
      (hok,
       ((%Equal.sym(M.Vec(~F), M.ofdv(~F, NU.dreps(n, r)), RD.frep(~F, n, R), RD.ofdv_dreps(~F, n, r)) : BX.rbnd(~F, BX.vsub(~F, xb, M.ofdv(~F, yc)), _)
          rbnd_vall(~F, BX.vsub(~F, xb, M.ofdv(~F, yc)), n, R, CP.len_vsub(~F, xb, M.ofdv(~F, yc), n, lxb, lyc), NW.vall_swap(~F, M.ofdv(~F, yc), xb, R, NW.vall_of_vn(~F, BX.vsub(~F, M.ofdv(~F, yc), xb), R, DM.le_trans(~F, NP.vn(~F, BX.vsub(~F, M.ofdv(~F, yc), xb)), @M($SDY, $C65), R, hib, hlo))))),
        ((%Equal.sym(M.Vec(~F), M.ofdv(~F, NU.dreps(n, r)), RD.frep(~F, n, R), RD.ofdv_dreps(~F, n, r)) : FV.rnn(~F, _)
           RD.frep_nn(~F, n, R, hr0r)),
         ((%Equal.sym(M.Vec(~F), M.ofdv(~F, NU.dreps(n, r)), RD.frep(~F, n, R), RD.ofdv_dreps(~F, n, r)) : M.vbnd.all(~F, _, rbc($KA))
            NW.vall_le(~F, RD.frep(~F, n, R), R, rbc($KA), RD.frep_all(~F, n, R, hr0r), hrbr)),
          (RD.klen_dreps(n, r), ({==}, {==}))))))

def zx_dx($CXP) -> M.vbnd.all(~F, BX.vsub(~F, xz, M.ofdv(~F, pc)), NW.dx($KA)):
  NW.vall_le(~F, BX.vsub(~F, xz, M.ofdv(~F, pc)), rho, NW.dx($KA), NW.vall_swap(~F, M.ofdv(~F, pc), xz, rho, hzc), NW.rho_le_dx($CXA))

# Y fixed: the window, the search and x_b in the box
def bym_ok($CXP, $YCP, $PRP, $AIP, $WSP) -> bgood(~F, n, eqs, xb, rbc($KA), pc, pr, NU.block.ym($YY, eqs, n, yc, pc, pr)):
  +rb = rbc($KA)
  +lycK = lyck(~F, ~H, n, yc, lyc)
  +lpp = lpp_k($CXA, $PRA)
  +hrb = rbc_nn($KAH, $NNA)
  +hcr = cen_mag($CXA, $YCA, rb, w1)
  +hprb = NW.vall_le(~F, M.ofdv(~F, pr), rho, rb, hpr, rho_le_rb($CXA))
  +hyn = y_mn($CXA, $YCA, $AIA)
  +hthl = thl_ok($CXA, $YCA, $AIA)
  +hthr = thr_ok($CXA, $YCA, $AIA)
  +hU = ub_rb($CXA, $YCA, $PRA, $AIA, $WSA)
  +hab = hab_k($CXA)
  +hw = w3k($CXA, $WSA)
  +hZr = NW.vall_appsub(~F, M.ofdv(~F, yc), M.ofdv(~F, yc), xz, M.ofdv(~F, pc), NW.dx($KA), {==}, NW.vall_self(~F, M.ofdv(~F, yc), NW.dx($KA), NW.dx_nn($KA, $NNA)), zx_dx($CXA))
  +hBr = NW.vall_appsub(~F, xb, M.ofdv(~F, yc), xz, M.ofdv(~F, pc), NW.dx($KA), Equal.trans(Nat, M.len(~F, xb), n, M.len(~F, M.ofdv(~F, yc)), lxb, Equal.sym(Nat, M.len(~F, M.ofdv(~F, yc)), n, lyc)), NW.vall_le(~F, BX.vsub(~F, xb, M.ofdv(~F, yc)), NW.en($KA), NW.dx($KA), NW.vall_swap(~F, M.ofdv(~F, yc), xb, NW.en($KA), hyc_all($CXA, $YCA)), NW.en_le_dx($CXA)), zx_dx($CXA))
  +hib = RD.inbox_ok(~F, ~H, n, eqs, hn, hh, yc, pc, pr, hab, lycK, $YY, hpn, xb, xz, lxb, lxz_k($CXA), hz, hzr, bb, lam, ms, hbb0, hl0, hq, ync($KA), thlc($KA), hyn, hthl, ync_nn($KA, $NNA), thlc_nn($KA, $NNA), NW.dx($KA), NW.dx_nn($KA, $NNA), cen_mag($CXA, $YCA, NW.dx($KA), s1), hZr, hBr, w4)
  br_ok($CXA, $YCA, $PRA, $AIA, $WSA, hU, hib, NU.rsearch(64n, NU.okr(eqs, n, yc, NU.r0(eqs, n, yc, $YY, pc, pr), $YY, pc, pr), eqs, n, yc, NU.r0(eqs, n, yc, $YY, pc, pr), $YY, pc, pr),
    RD.rs_init(~F, ~H, n, eqs, hn, hh, yc, pc, pr, lycK, lpp, $YY, bb, lam, ms, rb, hbb0, hl0, hrb, hq, hcr, hpn, hprb, ync($KA), thlc($KA), hyn, hthl, ync_nn($KA, $NNA), thlc_nn($KA, $NNA), mlen_y($CXA, inv, hA), hab, thrc($KA), thrc_nn($KA, $NNA), hthr, w2, hw, hU))

# the elimination at the center succeeded
def by2_ok($CXP, $YCP, $PRP, $WSP, minv: Maybe<&2, List<&2, List<&2, S.D>>>, hres: DG.dinv_res(~F, n, $JC, NW.ea($KA), minv)) -> bgood(~F, n, eqs, xb, rbc($KA), pc, pr, NU.block.y2(minv, p, eqs, n, yc, pc, pr)):
  match minv:
    case None{}:
      FO.absurd(bgood(~F, n, eqs, xb, rbc($KA), pc, pr, NU.block.y2(None{}, p, eqs, n, yc, pc, pr)), hres)
    case Some{+inv}:
      (hA, ha) = hres
      bym_ok($CXA, $YCA, $PRA, inv, hA, ha, $WSA)

# Newton returned a center yc
def by_yc($CXP, $YCP, $PRP, $WSP) -> bgood(~F, n, eqs, xb, rbc($KA), pc, pr, NU.block.y(Some{yc}, p, eqs, n, pc, pr)):
  by2_ok($CXA, $YCA, $PRA, $WSA, NU.dinverse(n, NU.wbits(p), NU.jac(eqs, n, NU.dapp(yc, pc))), NW.elim_pt(~F, ~H, n, NU.wbits(p), eqs, hn, hh, pc, yc, ms, NW.bt2(~F, b), hm0, NW.bt2_nn(~F, b, hb0), jc_inv($CXA, $YCA), AP.both_l(DG.mall(~F, $JC, ms), NP.rowsle(~F, $JC, n, $JN), NW.pt_maj($CXA, yc, lyc, NW.en($KA), hyc_all($CXA, $YCA), NW.en_le_dx($CXA))), hsm))

def by_ok($CXP, $PRP, $WSP, mN: Maybe<&2, List<&2, S.D>>, hN: NW.NOK($KA, xb, mN)) -> bgood(~F, n, eqs, xb, rbc($KA), pc, pr, NU.block.y(mN, p, eqs, n, pc, pr)):
  match mN:
    case None{}:
      FO.absurd(bgood(~F, n, eqs, xb, rbc($KA), pc, pr, NU.block.y(None{}, p, eqs, n, pc, pr)), hN)
    case Some{+yc}:
      (hyc, lyc) = hN
      by_yc($CXA, yc, lyc, hyc, $PRA, $WSA)

@MACRO Y0P +y0: List<&2, S.D>, +ly0: {M.len(~F, M.ofdv(~F, y0)) == n : Nat}, +hy0: M.vbnd.all(~F, BX.vsub(~F, M.ofdv(~F, y0), xb), d)
@MACRO Y0A y0, ly0, hy0
@MACRO PQP +q2: Nat, +hp2: {p == 1n+(1n+q2) : Nat}
@MACRO PQA q2, hp2

# One block at P: from a drawing within d of the regular solution x_b
# (parameters x_z in the balls pc +- pr, pr <= rho), the solver's block
# returns BOk of a certificate the checker accepts, x_b in its box, radii
# in [0, rb] with rb = (17/16)(1 + 2^-7) 2 sbar + rho.
def block_ok($CXP, $Y0P, $PQP, $PRP, $WSP) -> bgood(~F, n, eqs, xb, rbc($KA), pc, pr, NU.block(eqs, n, pc, pr, y0, p)):
  by_ok($CXA, $PRA, $WSA, NU.newton(40n, eqs, n, pc, p, NU.NMore{y0}), NW.newton_ok($CXA, $Y0A, $PQA))
