  FO.nonneg_add(~F, @M($JN, @M(@M(FR.ofn(~F, n), NW.ea($KA)), NW.bt2(~F, b))), @M($JN, @M($VB, NW.al($KA))), FO.mul_nonneg(~F, $JN, @M(@M(FR.ofn(~F, n), NW.ea($KA)), NW.bt2(~F, b)), jn0, FO.mul_nonneg(~F, @M(FR.ofn(~F, n), NW.ea($KA)), NW.bt2(~F, b), FO.mul_nonneg(~F, FR.ofn(~F, n), NW.ea($KA), DG.ofn_nn(~F, n), NW.ea_nn($KA, $NNA)), NW.bt2_nn(~F, b, hb0))), FO.mul_nonneg(~F, $JN, @M($VB, NW.al($KA)), jn0, FO.mul_nonneg(~F, $VB, NW.al($KA), vb_nn(~F, p), NW.al_nn($KA, $NNA))))

