# bend-cad: one block at P, for solve_complete (DESIGN §10.4, C5d).
# Proofs only.
#
# block(eqs, n, pc, pr, y0, p) as the solver runs it: Newton from the
# drawing (lib/nwtpf.bend), elimination at the center, Y rounded to
# p/2 bits, the radius search (lib/radpf.bend). From a drawing within d
# of a regular solution x_b ++ x_z of the block (parameters' balls
# holding x_z) and smallness conditions in the given constants, block
# returns BOk of a certificate the checker accepts whose box holds x_b,
# with radii at most rb.

import Base
import ../spec/num.bend as S
import ../spec/ring.bend as E
import ../spec/field.bend as O
import ../spec/mat.bend as M
import ../spec/box.bend as BX
import ../spec/knum.bend as N
import ../spec/deriv.bend as DV
import ./karith.bend as KA
import ./kball.bend as KB
import ./cert.bend as CK
import ./certdef.bend as C
import ./certpf.bend as CP
import ./kinst.bend as KI
import ./numer.bend as NU
import ./struct.bend as ST
import ./fring.bend as FR
import ./ford.bend as FO
import ./fmat.bend as FM
import ./fvec.bend as FV
import ./dmat.bend as DM
import ./gjpf.bend as GJ
import ./normpf.bend as NP
import ./dgjpf.bend as DG
import ./bndpf.bend as BP
import ./roundpf.bend as RP
import ./real.bend as RL
import ./apxpf.bend as AP
import ./nwtpf.bend as NW
import ./radpf.bend as RD

@MACRO DN ~KI.dnum()
@MACRO DH ~KI.dnum(), ~F, ~H
@MACRO KH ~K: N.Num, ~F: O.OField, ~H: N.Emb<K, F>
@MACRO KHA ~K, ~F, ~H
@MACRO KP ~F: O.OField, +n: Nat, +m: Nat, +b: @T, +lam: @T, +ms: @T, +d: @T, +rho: @T, +p: Nat
@MACRO KA ~F, n, m, b, lam, ms, d, rho, p
@MACRO NNP +hb0: O.le(~F, @0, b), +hl0: O.le(~F, @0, lam), +hm0: O.le(~F, @0, ms), +hd0: O.le(~F, @0, d), +hr0: O.le(~F, @0, rho)
@MACRO NNA hb0, hl0, hm0, hd0, hr0
@MACRO CXP ~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +n: Nat, +m: Nat, +eqs: List<&2, E.QExpr>, +hn: {CK.eqlen(eqs) == n : Nat}, +hh: {CK.allheld(~KI.dnum(), eqs) == True{} : Bool}, +hbl: {CK.allbelow(Nat.add(n, m), eqs) == True{} : Bool}, +pc: List<&2, S.D>, +lpc: {M.len(~F, M.ofdv(~F, pc)) == m : Nat}, +p: Nat, +xb: M.Vec(~F), +xz: M.Vec(~F), +lxb: {M.len(~F, xb) == n : Nat}, +lxz: {M.len(~F, xz) == m : Nat}, +hz: {C.fvals(~F, eqs, C.app(~F, xb, xz)) == GJ.zeros(~F, n) : M.Vec(~F)}, +bb: @T, +lam: @T, +ms: @T, +b: @T, +d: @T, +rho: @T, $NNP, +hbb0: O.le(~F, @0, bb), +hbb: M.vbnd.all(~F, C.app(~F, xb, xz), @S(bb, @1)), +hq: AP.eqok(~F, bb, lam, ms, eqs), +hJ: NP.InvB(~F, NW.jc(~F, eqs, n, C.app(~F, xb, xz)), n, b), +hzc: M.vbnd.all(~F, BX.vsub(~F, M.ofdv(~F, pc), xz), rho), +hsm: AP.small(~F, n, ms, NW.bt2(~F, b), NU.wbits(p)), +s1: O.le(~F, @A(NW.dx($KA), NW.dx($KA)), @1), +s2: O.le(~F, @A(@M(b, @M(FR.ofn(~F, n), @M(lam, NW.dx($KA)))), @M(b, @M(FR.ofn(~F, n), @M(lam, NW.dx($KA))))), @1), +s4: O.le(~F, NW.settle($KA), NW.h6(~F, p))
@MACRO CXA ~F, ~H, n, m, eqs, hn, hh, hbl, pc, lpc, p, xb, xz, lxb, lxz, hz, bb, lam, ms, b, d, rho, $NNA, hbb0, hbb, hq, hJ, hzc, hsm, s1, s2, s4
@MACRO XS C.app(~F, xb, xz)
@MACRO BIG AP.fbx(~F, $XS, NW.dx($KA))
@MACRO FB ~BP.fnum(~F), ~F, ~BP.femb(~F)
@MACRO PTC C.app(~F, M.ofdv(~F, yc), M.ofdv(~F, pc))
@MACRO S0 CK.svec($DN, eqs, n, yc, Nil{}, ym, pc, pr)
@MACRO SD M.ofd(~F, NU.dvmax($S0))
@MACRO SVA ~F, ~H, n, eqs, yc, pc, pr, ym
@MACRO KPC KA.klen($DN, pc)

# The constants
# -------------
# vb = 2^-(p/2) (Y's rounding), yn bounds |Y|, thL |I - Y J|, thR
# |I - J Y|, sbc the self-map bound S at radius 0, ubc the search's
# upper bound, rbc = ubc + rho every radius in sight.

@MACRO VB AP.vbit(~F, Nat.div(p, 2n))
@MACRO JN @M(FR.ofn(~F, n), ms)

def ync($KP) -> @T:
  @M(@A(@1, $VB), NW.al($KA))

def thlc($KP) -> @T:
  @A(@M(FR.ofn(~F, n), NW.ea($KA)), @M(@M($VB, NW.al($KA)), $JN))

def thrc($KP) -> @T:
  @A(@M($JN, @M(@M(FR.ofn(~F, n), NW.ea($KA)), NW.bt2(~F, b))), @M($JN, @M($VB, NW.al($KA))))

def sbc($KP) -> @T:
  @A(@M(ync($KA), @A(@M(@M(FR.ofn(~F, n), ms), NW.en($KA)), @M(@M(FR.ofn(~F, m), ms), rho))), @M(ync($KA), @M(@M(FR.ofn(~F, m), ms), rho)))

@MACRO C17 M.ofd(~F, S.D{S.Zpos{S.XI{S.XO{S.XO{S.XO{S.XH{}}}}}}, 4n})
@MACRO E8 M.ofd(~F, S.D{S.Zpos{S.XO{S.XH{}}}, 8n})
@MACRO C65 M.ofd(~F, S.D{S.Zpos{S.XI{S.XO{S.XO{S.XO{S.XO{S.XO{S.XH{}}}}}}}}, 6n})

def ubc($KP) -> @T:
  @M(@M($C17, @A(@1, $E8)), @A(sbc($KA), sbc($KA)))

def rbc($KP) -> @T:
  @A(ubc($KA), rho)

# S is at most the largest |entry|
# -------------------------------

def dvmax_vn(~F: O.OField, xs: List<&2, S.D>) -> O.le(~F, M.ofd(~F, NU.dvmax(xs)), NP.vn(~F, M.ofdv(~F, xs))):
  match xs:
    case Nil{}:
      %DM.ofd_zero(~F) : O.le(~F, _, @0)
      FO.le_refl(~F, @0)
    case Con{+x, +t}:
      DG.ndmax_lub(~F, x, NU.dvmax(t), NP.vn(~F, M.ofdv(~F, Con{x, t})),
        DM.le_trans(~F, M.ofd(~F, x), FV.fabs(~F, M.ofd(~F, x)), NP.vn(~F, M.ofdv(~F, Con{x, t})), NP.bnd_lo(~F, M.ofd(~F, x), FV.fabs(~F, M.ofd(~F, x)), FV.fabs_bnd(~F, M.ofd(~F, x))), FV.fmax_l(~F, FV.fabs(~F, M.ofd(~F, x)), NP.vn(~F, M.ofdv(~F, t)))),
        DM.le_trans(~F, M.ofd(~F, NU.dvmax(t)), NP.vn(~F, M.ofdv(~F, t)), NP.vn(~F, M.ofdv(~F, Con{x, t})), dvmax_vn(~F, t), FV.fmax_r(~F, FV.fabs(~F, M.ofd(~F, x)), NP.vn(~F, M.ofdv(~F, t)))))

# K's |u| has F norm at most u's
def vn_kvabs($KH, u: N.KVec(~K)) -> O.le(~F, NP.vn(~F, N.ofkv($KHA, KA.kvabs(~K, u))), NP.vn(~F, N.ofkv($KHA, u))):
  match u:
    case Nil{}:
      FO.le_refl(~F, @0)
    case Con{+a, +us}:
      FV.fmax_lub(~F, FV.fabs(~F, @H(KA.kabs(~K, a))), NP.vn(~F, N.ofkv($KHA, KA.kvabs(~K, us))), NP.vn(~F, N.ofkv($KHA, Con{a, us})),
        DM.le_trans(~F, FV.fabs(~F, @H(KA.kabs(~K, a))), FV.fabs(~F, @H(a)), NP.vn(~F, N.ofkv($KHA, Con{a, us})), RD.kabs_ent($KHA, a), FV.fmax_l(~F, FV.fabs(~F, @H(a)), NP.vn(~F, N.ofkv($KHA, us)))),
        DM.le_trans(~F, NP.vn(~F, N.ofkv($KHA, KA.kvabs(~K, us))), NP.vn(~F, N.ofkv($KHA, us)), NP.vn(~F, N.ofkv($KHA, Con{a, us})), vn_kvabs($KHA, us), FV.fmax_r(~F, FV.fabs(~F, @H(a)), NP.vn(~F, N.ofkv($KHA, us)))))

# The parameters' |J0z| + Dz over a graded box: entries <= ms
# -----------------------------------------------------------

def mzr_all($KH, +rho: @T, +bb: @T, +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +box: List<&2, KB.KB<K>>, +hg: BP.gbox($KHA, rho, bb, box), +e: E.QExpr, +hh: {KB.held(~K, e) == True{} : Bool}, +ms: @T, +hms: O.le(~F, BP.ms(~F, bb, e), ms), cnt: Nat, +lo: Nat) -> M.vbnd.all(~F, N.ofkv($KHA, RD.mzr($KHA, box, e, cnt, lo)), ms):
  match cnt:
    case 0n:
      Unit{}
    case 1n++k:
      +g = BP.ksl_grade($KHA, rho, bb, hr, hb, box, hg, lo, e, hh)
      +c = KB.KB.c(K, KB.ksl(~K, lo, box, e))
      +r = KB.KB.r(K, KB.ksl(~K, lo, box, e))
      ((%KA.ea($KHA, KA.kabs(~K, c), r) : M.bnd(~F, _, ms)
         RD.bnd_of01(~F, @A(@H(KA.kabs(~K, c)), @H(r)), ms, FO.nonneg_add(~F, @H(KA.kabs(~K, c)), @H(r), KA.kabs_nonneg($KHA, c), BP.gf_0(~F, rho, @H(c), @H(r), BP.ms(~F, bb, e), BP.ls(~F, bb, e), g)), DM.le_trans(~F, @A(@H(KA.kabs(~K, c)), @H(r)), BP.ms(~F, bb, e), ms, RD.gr_m($KHA, rho, KB.ksl(~K, lo, box, e), BP.ms(~F, bb, e), BP.ls(~F, bb, e), g), hms))),
       mzr_all($KHA, rho, bb, hr, hb, box, hg, e, hh, ms, hms, k, 1n+lo))

def mz_rows_le($KH, +rho: @T, +bb: @T, +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +box: List<&2, KB.KB<K>>, +hg: BP.gbox($KHA, rho, bb, box), +lam: @T, +ms: @T, +hm0: O.le(~F, @0, ms), eqs: List<&2, E.QExpr>, +hq: AP.eqok(~F, bb, lam, ms, eqs), +hh: {CK.allheld(~K, eqs) == True{} : Bool}, +cnt: Nat, +lo: Nat) -> NP.rowsle(~F, N.ofkm($KHA, RD.mzm($KHA, box, cnt, lo, eqs)), cnt, @M(FR.ofn(~F, cnt), ms)):
  match eqs:
    case Nil{}:
      Unit{}
    case Con{+e, +es}:
      +he = KA.band_l(KB.held(~K, e), CK.allheld(~K, es), hh)
      +hes = KA.band_r(KB.held(~K, e), CK.allheld(~K, es), hh)
      (DG.rowabs_le(~F, N.ofkv($KHA, RD.mzr($KHA, box, e, cnt, lo)), cnt, ms, mzr_all($KHA, rho, bb, hr, hb, box, hg, e, he, ms, AP.eqok_ms(~F, bb, lam, ms, e, es, hq), cnt, lo), hm0),
       mz_rows_le($KHA, rho, bb, hr, hb, box, hg, lam, ms, hm0, es, AP.eqok_tl(~F, bb, lam, ms, e, es, hq), hes, cnt, lo))

def mzm_mn($KH, +rho: @T, +bb: @T, +hr: O.le(~F, @0, rho), +hb: O.le(~F, @0, bb), +box: List<&2, KB.KB<K>>, +hg: BP.gbox($KHA, rho, bb, box), +lam: @T, +ms: @T, +hm0: O.le(~F, @0, ms), +eqs: List<&2, E.QExpr>, +hq: AP.eqok(~F, bb, lam, ms, eqs), +hh: {CK.allheld(~K, eqs) == True{} : Bool}, +cnt: Nat, +lo: Nat) -> O.le(~F, NP.mnorm(~F, N.ofkm($KHA, RD.mzm($KHA, box, cnt, lo, eqs)), cnt), @M(FR.ofn(~F, cnt), ms)):
  NP.mnorm_lub(~F, N.ofkm($KHA, RD.mzm($KHA, box, cnt, lo, eqs)), cnt, @M(FR.ofn(~F, cnt), ms), mz_rows_le($KHA, rho, bb, hr, hb, box, hg, lam, ms, hm0, eqs, hq, hh, cnt, lo), FO.mul_nonneg(~F, FR.ofn(~F, cnt), ms, DG.ofn_nn(~F, cnt), hm0))
