@MACRO DFK SV.dfacts(sk, cls, R, c, dF, k)
@MACRO CTX SV.ctx(sk, R, c)
@MACRO KB SV.kept_before(sk, R, c)
@MACRO EQK SV.eqat($ES, k)
@MACRO CWBA sk, c, k, rows, B, ds, us

def absurd(-A: Type, x: Empty) -> A:
  match x:

# The closure's decision, exact
# -----------------------------

# what a decision means: a derivation that is valid and proves e, or that
# none exists
def DDec(+es: List<&2, SK.Ent>, +fs: $FL, +ctx: $QL, +e: E.QExpr, +m: Maybe<&2, DR.DStat>, mm: Maybe<&2, DR.Der>) -> Type:
  match mm:
    case None{}:
      @dv: DR.Der -> DR.Valid(es, fs, ctx, dv) -> SV.Proves(es, m, e, DR.concl(es, fs, dv)) -> Empty
    case Some{+d}:
      DR.Valid(es, fs, ctx, d) & SV.Proves(es, m, e, DR.concl(es, fs, d))

def dd.h(b: Bool, +es: List<&2, SK.Ent>, +fs: $FL, +ctx: $QL, +t: Nat, +s: DC.Sk, +e: E.QExpr, +m: Maybe<&2, DR.DStat>, +eb: {DC.holds(es, fs, t, s, e, m) == b : Bool}, +H: RR.Hyp(es, fs, ctx, t, s),
  +hbm: {DC.fb.ds(m, t) == True{} : Bool}) -> DDec(es, fs, ctx, e, m, DPS.ddec.h(b, es, fs, t, s, e, m)):
  match b:
    case True{}:
      HLD.hold_ok(es, fs, ctx, t, s, H, e, m, eb, hbm)
    case False{}:
      dv => hv => hp => DEC.dec_none(es, fs, ctx, t, s, H, e, m, eb, dv, hv, hp)

# the decision from any outcome with Ex (lib/dcexpf.bend) is exact
def dd_ok(o: DC.Out, +es: List<&2, SK.Ent>, +fs: $FL, +ctx: $QL, +t: Nat, +e: E.QExpr, +m: Maybe<&2, DR.DStat>, hx: CX.Ex(es, fs, ctx, t, o),
  +hbm: {DC.fb.ds(m, t) == True{} : Bool}) -> DDec(es, fs, ctx, e, m, DPS.ddec.o(o, es, fs, t, e, m)):
  match o:
    case DC.OStep{+s}:
      absurd(DDec(es, fs, ctx, e, m, None{}), hx)
    case DC.OFix{+s}:
      dd.h(DC.holds(es, fs, t, s, e, m), es, fs, ctx, t, s, e, m, {==}, hx, hbm)
    case DC.OOne{+d}:
      EXP.expl_ok(DC.OOne{d}, es, fs, ctx, t, m, e, hx, {==})
    case DC.OVoid{+g, +dr, +di}:
      EXP.expl_ok(DC.OVoid{g, dr, di}, es, fs, ctx, t, m, e, hx, {==})

# The facts' bound
# ----------------

def fb_cat(xs: $FL, +ys: $FL, +t: Nat, +hx: {DC.fb(xs, t) == True{} : Bool}, +hy: {DC.fb(ys, t) == True{} : Bool}) -> {DC.fb(SV.fcat(xs, ys), t) == True{} : Bool}:
  match xs:
    case Nil{}:
      hy
    case Con{DR.Fact{+e, +nd, +ds}, +tl}:
      +h1 = LI.band_r(SEP.vbelow(e, t), SV.band(DC.fb.ds(ds, t), DC.fb(tl, t)), hx)
      LI.band_i(SEP.vbelow(e, t), SV.band(DC.fb.ds(ds, t), DC.fb(SV.fcat(tl, ys), t)), LI.band_l(SEP.vbelow(e, t), SV.band(DC.fb.ds(ds, t), DC.fb(tl, t)), hx),
        LI.band_i(DC.fb.ds(ds, t), DC.fb(SV.fcat(tl, ys), t), LI.band_l(DC.fb.ds(ds, t), DC.fb(tl, t), h1), fb_cat(tl, ys, t, LI.band_r(DC.fb.ds(ds, t), DC.fb(tl, t), h1), hy)))

def fb_ofgo(xs: $QL, +own: $NL, +sk: SK.Sketch, +c: Nat, +d: $NL, +i: Nat, +k: Nat, +n: Nat, +hw: {CV.ewithin(xs, n) == True{} : Bool}, +hz: {DC.zb($ENT, 1n+n) == True{} : Bool})
  -> {DC.fb(SV.ofacts.go(xs, own, sk, c, d, i, k), 1n+n) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      BRG.fb_pick(SV.band(SV.lt(k, i), SV.band(SV.eq(SV.nth(own, k), c), SV.bnot(SV.mem(k, d)))), e, Nil{}, SV.dstat_of($ENT, SV.kind_at(sk, c)), SV.ofacts.go(t, own, sk, c, d, i, 1n+k), 1n+n,
        BRG.vb_of(e, n, CV.and_l(BX.QExpr.within(e, n), CV.ewithin(t, n), hw)), BRG.fbds_of(SV.kind_at(sk, c), $ENT, 1n+n, hz),
        fb_ofgo(t, own, sk, c, d, i, 1n+k, n, CV.and_r(BX.QExpr.within(e, n), CV.ewithin(t, n), hw), hz))

# the facts c's i-th equation may read are below the closure's bound
def fb_df(+sk: SK.Sketch, +cls: List<&2, SV.Class>, +R: $NL, +c: Nat, +d: $NL, +i: Nat, $HC) -> {DC.fb(SV.dfacts(sk, cls, R, c, d, i), $TV) == True{} : Bool}:
  fb_cat(SV.facts.go($ES, $OWN, SV.kept_before(sk, R, c), sk, cls, True{}, 0n), SV.ofacts.go($ES, $OWN, sk, c, d, i, 0n), $TV,
    BRG.fb_go($ES, $OWN, SV.kept_before(sk, R, c), sk, cls, True{}, 0n, PA.nvars(sk), BRG.ew_of(sk, PA.nvars(sk), $HA), BRG.zb_tv(sk, hcov)),
    fb_ofgo($ES, $OWN, sk, c, d, i, 0n, PA.nvars(sk), BRG.ew_of(sk, PA.nvars(sk), $HA), BRG.zb_tv(sk, hcov)))

# The facts the walk reads
# ------------------------

@MACRO OF DR.Fact{e, Nil{}, SV.dstat_of(SV.ents(sk), SV.kind_at(sk, c))}

# drops at i or later do not change c's own facts before i
def of_cat(es: $QL, +own: $NL, +sk: SK.Sketch, +c: Nat, +X: $NL, +d: $NL, +i: Nat, +j: Nat, +hg: {OW.geall(X, i) == True{} : Bool})
  -> {SV.ofacts.go(es, own, sk, c, SV.cat(X, d), i, j) == SV.ofacts.go(es, own, sk, c, d, i, j) : $FL}:
  match es:
    case Nil{}:
      {==}
    case Con{+e, t}:
      %Equal.sym($FL, SV.ofacts.go(t, own, sk, c, SV.cat(X, d), i, 1n+j), SV.ofacts.go(t, own, sk, c, d, i, 1n+j), of_cat(t, own, sk, c, X, d, i, 1n+j, hg)) : {SV.facts.pick(SV.band(SV.lt(j, i), SV.band(SV.eq(SV.nth(own, j), c), SV.bnot(SV.mem(j, SV.cat(X, d))))), $OF, _) == SV.facts.pick(SV.band(SV.lt(j, i), SV.band(SV.eq(SV.nth(own, j), c), SV.bnot(SV.mem(j, d)))), $OF, SV.ofacts.go(t, own, sk, c, d, i, 1n+j)) : $FL}
      %SP.band_ag(SV.lt(j, i), SV.band(SV.eq(SV.nth(own, j), c), SV.bnot(SV.mem(j, d))), SV.band(SV.eq(SV.nth(own, j), c), SV.bnot(SV.mem(j, SV.cat(X, d)))), hl => Equal.sym(Bool, SV.band(SV.eq(SV.nth(own, j), c), SV.bnot(SV.mem(j, SV.cat(X, d)))), SV.band(SV.eq(SV.nth(own, j), c), SV.bnot(SV.mem(j, d))), SP.or_cat.h(SV.nth(own, j), c, X, d, i, j, hg, hl))) : {SV.facts.pick(_, $OF, SV.ofacts.go(t, own, sk, c, d, i, 1n+j)) == SV.facts.pick(SV.band(SV.lt(j, i), SV.band(SV.eq(SV.nth(own, j), c), SV.bnot(SV.mem(j, d)))), $OF, SV.ofacts.go(t, own, sk, c, d, i, 1n+j)) : $FL}
      {==}

def of_x(+sk: SK.Sketch, +c: Nat, +k: Nat, +dF: $NL, +d: $NL, xr: CW.XRel(dF, d, k)) -> {SV.ofacts.go($ES, $OWN, sk, c, d, k, 0n) == SV.ofacts.go($ES, $OWN, sk, c, dF, k, 0n) : $FL}:
  (+X, xq) = xr
  (hX, hg) = xq
  (%Equal.sym($NL, dF, SV.cat(X, d), hX) : {SV.ofacts.go($ES, $OWN, sk, c, d, k, 0n) == SV.ofacts.go($ES, $OWN, sk, c, _, k, 0n) : $FL}
    Equal.sym($FL, SV.ofacts.go($ES, $OWN, sk, c, SV.cat(X, d), k, 0n), SV.ofacts.go($ES, $OWN, sk, c, d, k, 0n), of_cat($ES, $OWN, sk, c, X, d, k, 0n, hg)))

# the walk's facts at k are the spec's, with the final drops dF
def fk_eq(+sk: SK.Sketch, +cls: List<&2, SV.Class>, +R: $NL, +c: Nat, +F0: $FL, +ds: List<&2, SV.Drop>, +k: Nat, +dF: $NL,
  +hF0: {F0 == SV.facts.go($ES, $OWN, SV.kept_before(sk, R, c), sk, cls, True{}, 0n) : $FL}, +xr: CW.XRel(dF, $DS, k)) -> {$FK == $DFK : $FL}:
  %hF0 : {SV.fcat(F0, SV.ofacts.go($ES, $OWN, sk, c, $DS, k, 0n)) == SV.fcat(_, SV.ofacts.go($ES, $OWN, sk, c, dF, k, 0n)) : $FL}
  %of_x(sk, c, k, dF, $DS, xr) : {SV.fcat(F0, SV.ofacts.go($ES, $OWN, sk, c, $DS, k, 0n)) == SV.fcat(F0, _) : $FL}
  {==}

# The decision at equation k, as the spec reads it
# ------------------------------------------------

def ddk(+sk: SK.Sketch, +cls: List<&2, SV.Class>, +R: $NL, +c: Nat, +dF: $NL, +k: Nat, +W: DC.WK, +hw: DW.WInv($ENT, SV.rfacts(sk, $KB), $CTX, $TV, W), $HC) -> DDec($ENT, $DFK, $CTX, $EQK, $M, DPS.ddec(sk, $DFK, $CTX, $EQK, $M, W)):
  dd_ok(DC.FO.o(DC.wcall($ENT, $DFK, $TV, W)), $ENT, $DFK, $CTX, $TV, $EQK, $M,
    DW.wcall_ex($ENT, SV.rfacts(sk, $KB), $DFK, $CTX, $TV, W, hw, MP.pre_cat(SV.rfacts(sk, $KB), SV.facts.go($ES, $OWN, $KB, sk, cls, True{}, 0n), SV.ofacts.go($ES, $OWN, sk, c, dF, k, 0n), DPM.facts_pre($ES, $OWN, $KB, sk, Nil{}, False{}, cls, True{}, 0n)),
      BRG.zb_tv(sk, hcov), fb_df(sk, cls, R, c, dF, k, $HA)), BRG.fbds_of(SV.kind_at(sk, c), $ENT, $TV, BRG.zb_tv(sk, hcov)))

@MACRO KP +sk: SK.Sketch, +cls: List<&2, SV.Class>, +R: $NL, +c: Nat, $WP, +ds: List<&2, SV.Drop>, +k: Nat, +e: E.QExpr, +dF: $NL, +he: {$EQK == e : E.QExpr}, +xr: CW.XRel(dF, $DS, k)
@MACRO KA sk, cls, R, c, $WAA, ds, k, e, dF, he, xr

def ddtr($KP, +mm: Maybe<&2, DR.Der>, h: {DPS.ddec(sk, $FK, cx, e, $M, W) == mm : Maybe<&2, DR.Der>}) -> {DPS.ddec(sk, $DFK, $CTX, $EQK, $M, W) == mm : Maybe<&2, DR.Der>}:
  (%Equal.sym(E.QExpr, $EQK, e, he) : {DPS.ddec(sk, $DFK, $CTX, _, $M, W) == mm : Maybe<&2, DR.Der>}
    (%hcx : {DPS.ddec(sk, $DFK, _, e, $M, W) == mm : Maybe<&2, DR.Der>}
      (%fk_eq(sk, cls, R, c, F0, ds, k, dF, hF0, xr) : {DPS.ddec(sk, _, cx, e, $M, W) == mm : Maybe<&2, DR.Der>}
        h)))

# the walk's decision at k means what the spec asks
def ddat($KP, +mm: Maybe<&2, DR.Der>, h: {DPS.ddec(sk, $FK, cx, e, $M, W) == mm : Maybe<&2, DR.Der>}, $HC) -> DDec($ENT, $DFK, $CTX, $EQK, $M, mm):
  (%ddtr($KA, mm, h) : DDec($ENT, $DFK, $CTX, $EQK, $M, _)
    ddk(sk, cls, R, c, dF, k, W, (%hcx : DW.WInv($ENT, SV.rfacts(sk, $KB), _, $TV, W)
      hw), $HA))

def dnone_k($KP, hdd: {DPS.ddec(sk, $FK, cx, e, $M, W) == None{} : Maybe<&2, DR.Der>}, $HC) -> SV.NotDirDerivable(sk, cls, R, c, dF, k):
  ddat($KA, None{}, hdd, $HA)

def dsk.go($KP, +der: DR.Der, h: DR.Valid($ENT, $DFK, $CTX, der) & SV.Proves($ENT, $M, $EQK, DR.concl($ENT, $DFK, der))) -> SV.DirDerivable(sk, cls, R, c, dF, k, DR.nd($ENT, $FK, der)):
  (hv, hp) = h
  (der, (hv, (hp, (%Equal.sym($FL, $FK, $DFK, fk_eq(sk, cls, R, c, F0, ds, k, dF, hF0, xr)) : {SV.sub(DR.nd($ENT, $DFK, der), DR.nd($ENT, _, der)) == True{} : Bool}
    PR.sub_refl(DR.nd($ENT, $DFK, der))))))

# a direction drop at k: DirDerivable with the nd it records
def dsome_k($KP, +der: DR.Der, +hds: {DPS.ddec(sk, $FK, cx, e, $M, W) == Some{der} : Maybe<&2, DR.Der>}, $HC) -> SV.DirDerivable(sk, cls, R, c, dF, k, DR.nd($ENT, $FK, der)):
  dsk.go($KA, der, ddat($KA, Some{der}, hds, $HA))

# Degree 0 at k, with the final drops
# -----------------------------------

@MACRO LS DV.dropls(DV.rescb($RR), DV.resbt($RR), e, B)

def der0(+sk: SK.Sketch, +R: $NL, +D: $NL, +c: Nat, +k: Nat, +rows: List<&2, EL.Row>, +B: $QL, +ds: List<&2, SV.Drop>, +us: $NL, +e: E.QExpr, +dF: $NL,
  +he: {$EQK == e : E.QExpr}, +hnil: {EP.isnil(EP.resp($RR)) == True{} : Bool}, +hb: {CW.cwb($CWBA) == True{} : Bool}, +hB: {B == SK.cat($P, $OR) : $QL}, +xr2: CW.XRel(dF, $DS, k))
  -> SV.Derivable(sk, R, D, c, dF, k):
  ($LS, (%Equal.sym(E.QExpr, $EQK, e, he) : SV.Ident(_, SV.lin($LS, SK.cat($P, SV.own_rest(sk, c, dF, k))))
    (%Equal.sym($QL, SV.own_rest(sk, c, dF, k), $OR, CW.or_x(sk, c, k, dF, $DS, xr2)) : SV.Ident(e, SV.lin($LS, SK.cat($P, _)))
      (%hB : SV.Ident(e, SV.lin($LS, _))
        DV.derivable(B, rows, e, CW.cwb_rinv($CWBA, hb), hnil)))))

def nder0(+sk: SK.Sketch, +R: $NL, +D: $NL, +c: Nat, +k: Nat, +rows: List<&2, EL.Row>, +B: $QL, +ds: List<&2, SV.Drop>, +us: $NL, +e: E.QExpr, +dF: $NL,
  +he: {$EQK == e : E.QExpr}, +hne: {EP.isnil(EP.resp($RR)) == False{} : Bool}, +hb: {CW.cwb($CWBA) == True{} : Bool}, +hl: {EL.rlen(rows) == SV.neqs(B) : Nat}, +hB: {B == SK.cat($P, $OR) : $QL}, +xr1: CW.XRel(dF, $DS, k))
  -> SV.NotDerivable(sk, R, D, c, dF, k):
  (%Equal.sym(E.QExpr, $EQK, e, he) : (@ls: List<&2, S.Q> -> SV.Ident(_, SV.lin(ls, SK.cat($P, SV.own_rest(sk, c, dF, k)))) -> Empty)
    (%Equal.sym($QL, SV.own_rest(sk, c, dF, k), $OR, CW.or_x(sk, c, k, dF, $DS, xr1)) : (@ls: List<&2, S.Q> -> SV.Ident(e, SV.lin(ls, SK.cat($P, _))) -> Empty)
      (%hB : (@ls: List<&2, S.Q> -> SV.Ident(e, SV.lin(ls, _)) -> Empty)
        IN.indep(B, rows, e, CW.cwb_rinv($CWBA, hb), hl, hne))))

# The invariant after a direction drop
# ------------------------------------

def inv_dropx(+sk: SK.Sketch, +R: $NL, +D: $NL, +c: Nat, +bp0: $NL, +k: Nat, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +ds: List<&2, SV.Drop>, +us: $NL, +nd: $NL, +q: SV.Why,
  hi: CW.CWInv($WA0, k, $STQ), +heq: {SV.eq(SV.nth($OWN, k), c) == True{} : Bool}, +hk: {SV.lt(k, $N) == True{} : Bool})
  -> CW.CWInv($WA0, 1n+k, PA.CW{rows, B, bp, Con{SV.Drop{k, nd, q}, ds}, us}):
  (+hb, q1) = hi
  (hl, q2) = q1
  (hB, q3) = q2
  (hp, hbp) = q3
  +hdb = CW.cwb_dbelow($CWBA, hb)
  (CW.cwb_mk(sk, c, 1n+k, rows, B, Con{SV.Drop{k, nd, q}, ds}, us, CW.cwb_rinv($CWBA, hb),
      LI.band_i(SV.lt(k, 1n+k), SV.below($DS, 1n+k), KB.lt_succ(k), KB.below_up($DS, k, hdb)),
      LI.band_i(SV.bnot(SV.mem(k, $DS)), SV.distinct($DS), KB.bnot_f(SV.mem(k, $DS), KB.below_notmem($DS, k, hdb)), CW.cwb_ddist($CWBA, hb)),
      LI.band_i(SV.eq(SV.nth($OWN, k), c), KB.allo($OWN, $DS, c), heq, CW.cwb_down($CWBA, hb)),
      CW.nonein_cons(us, k, $DS, CW.cwb_udisj($CWBA, hb), CW.cwb_ubelow($CWBA, hb)), CW.cwb_udist($CWBA, hb), KB.below_up(us, k, CW.cwb_ubelow($CWBA, hb)), CW.cwb_uown($CWBA, hb)),
    (hl, (Equal.trans($QL, B, SK.cat($P, SV.own_rest(sk, c, $DS, k)), SK.cat($P, SV.own_rest(sk, c, Con{k, $DS}, 1n+k)), hB, Equal.cong($QL, $QL, y => SK.cat($P, y), SV.own_rest(sk, c, $DS, k), SV.own_rest(sk, c, Con{k, $DS}, 1n+k), Equal.sym($QL, SV.own_rest(sk, c, Con{k, $DS}, 1n+k), SV.own_rest(sk, c, $DS, k), CW.or_drop(sk, c, $DS, k, heq, hk)))),
    (hp, hbp))))

# The walk's result from k
# ------------------------

# the drops so far suffice, then so do the final ones
def NDT(+sk: SK.Sketch, +cls: List<&2, SV.Class>, +R: $NL, +D: $NL, +c: Nat, +dF: $NL, +ds: List<&2, SV.Drop>, +dsF: List<&2, SV.Drop>) -> Type:
  DH.drops_nd(sk, cls, R, D, c, dF, ds) -> DH.drops_nd(sk, cls, R, D, c, dF, dsF)

def CWRes2($CP, +k: Nat, own_k: $NL, +st: PA.CW, +fin: PA.CW) -> Type:
  CW.XRel($DF, SV.drops(CW.cw.ds(st)), k) & (DH.drops_ok.go(sk, cls, R, D, c, $DF, own_k, k) & (CW.CWInv($WA0, $N, fin) & NDT(sk, cls, R, D, c, $DF, CW.cw.ds(st), CW.cw.ds(fin))))

def res2_skip($CP, +k: Nat, +o: Nat, +ot: $NL, st: PA.CW, +fin: PA.CW, +heo: {SV.eq(o, c) == False{} : Bool}, hi: CW.CWInv($WA0, k, st), r: CWRes2($CA, 1n+k, ot, st, fin))
  -> CWRes2($CA, k, Con{o, ot}, st, fin):
  match st:
    case PA.CW{+rows, +B, +bp, +ds, +us}:
      (+hb, hq1) = hi
      (+xr, q) = r
      (dr, q2) = q
      (fr, nt) = q2
      (CW.xr_up(k, $DF, $DS, xr), (((%Equal.sym(Bool, SV.eq(o, c), False{}, heo) : DH.drops_ok.at(sk, cls, R, D, c, $DF, _, k)
          CW.mem_x_f(k, $DF, $DS, xr, CW.cwb_dbelow($CWBA, hb))), dr), (fr, nt)))

def res2_drop($CP, +k: Nat, +o: Nat, +ot: $NL, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +ds: List<&2, SV.Drop>, +us: $NL, +e: E.QExpr, +fin: PA.CW, +heo: {SV.eq(o, c) == True{} : Bool},
  +he: {$EQK == e : E.QExpr}, +hnil: {EP.isnil(EP.resp($RR)) == True{} : Bool}, hi: CW.CWInv($WA0, k, $STQ),
  r: CWRes2($CA, 1n+k, ot, PA.CW{rows, B, bp, Con{PA.drop_of(k, $RR, e, B, bp), ds}, us}, fin)) -> CWRes2($CA, k, Con{o, ot}, $STQ, fin):
  (+hb, q1) = hi
  (hl, q2) = q1
  (+hB, q3) = q2
  (+xr, q) = r
  (dr, q4) = q
  (fr, nt) = q4
  +xr2 = CW.xr_drop(k, $DF, $DS, xr)
  (xr2, (((%Equal.sym(Bool, SV.eq(o, c), True{}, heo) : DH.drops_ok.at(sk, cls, R, D, c, $DF, _, k)
      (%Equal.sym(Bool, SV.mem(k, $DF), True{}, CW.mem_x_t(k, $DF, $DS, xr)) : DH.drops_ok.mem(sk, cls, R, D, c, $DF, _, k)
        Inl{der0(sk, R, D, c, k, rows, B, ds, us, e, $DF, he, hnil, hb, hB, xr2)})), dr),
    (fr, h => nt((Inl{der0(sk, R, D, c, k, rows, B, ds, us, e, $DF, he, hnil, hb, hB, xr2)}, h)))))

@MACRO KEEPST PA.CW{EL.rsnoc(rows, EL.row_of($RR)), EP.qsnoc(B, e), CO.lsnoc(bp, k), ds, CO.lsnoc(us, k)}
@MACRO NDK DR.nd($ENT, $FK, der)
@MACRO DDST PA.CW{rows, B, bp, Con{SV.Drop{k, $NDK, SV.WDer{der}}, ds}, us}

def res2_keep($CP, $WP, +k: Nat, +o: Nat, +ot: $NL, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +ds: List<&2, SV.Drop>, +us: $NL, +e: E.QExpr, +fin: PA.CW, +heo: {SV.eq(o, c) == True{} : Bool},
  +he: {$EQK == e : E.QExpr}, +hne: {EP.isnil(EP.resp($RR)) == False{} : Bool}, +hdd: {DPS.ddec(sk, $FK, cx, e, $M, W) == None{} : Maybe<&2, DR.Der>}, hi: CW.CWInv($WA0, k, $STQ), $HC,
  r: CWRes2($CA, 1n+k, ot, $KEEPST, fin)) -> CWRes2($CA, k, Con{o, ot}, $STQ, fin):
  (+hb, q1) = hi
  (+hl, q2) = q1
  (+hB, q3) = q2
  (+xr, q) = r
  (dr, q4) = q
  (fr, nt) = q4
  +xr1 = CW.xr_up(k, $DF, $DS, xr)
  (xr1, (((%Equal.sym(Bool, SV.eq(o, c), True{}, heo) : DH.drops_ok.at(sk, cls, R, D, c, $DF, _, k)
      (%Equal.sym(Bool, SV.mem(k, $DF), False{}, CW.mem_x_f(k, $DF, $DS, xr, CW.cwb_dbelow($CWBA, hb))) : DH.drops_ok.mem(sk, cls, R, D, c, $DF, _, k)
        (nder0(sk, R, D, c, k, rows, B, ds, us, e, $DF, he, hne, hb, hl, hB, xr1), dnone_k(sk, cls, R, c, $WAA, ds, k, e, $DF, he, xr1, hdd, $HA)))), dr), (fr, nt)))

def res2_ddrop($CP, $WP, +k: Nat, +o: Nat, +ot: $NL, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +ds: List<&2, SV.Drop>, +us: $NL, +e: E.QExpr, +der: DR.Der, +fin: PA.CW, +heo: {SV.eq(o, c) == True{} : Bool},
  +he: {$EQK == e : E.QExpr}, +hds: {DPS.ddec(sk, $FK, cx, e, $M, W) == Some{der} : Maybe<&2, DR.Der>}, $HC,
  r: CWRes2($CA, 1n+k, ot, $DDST, fin)) -> CWRes2($CA, k, Con{o, ot}, $STQ, fin):
  (+xr, q) = r
  (dr, q4) = q
  (fr, nt) = q4
  +xr2 = CW.xr_drop(k, $DF, $DS, xr)
  (xr2, (((%Equal.sym(Bool, SV.eq(o, c), True{}, heo) : DH.drops_ok.at(sk, cls, R, D, c, $DF, _, k)
      (%Equal.sym(Bool, SV.mem(k, $DF), True{}, CW.mem_x_t(k, $DF, $DS, xr)) : DH.drops_ok.mem(sk, cls, R, D, c, $DF, _, k)
        Inr{($NDK, dsome_k(sk, cls, R, c, $WAA, ds, k, e, $DF, he, xr2, der, hds, $HA))})), dr),
    (fr, h => nt((Inr{dsome_k(sk, cls, R, c, $WAA, ds, k, e, $DF, he, xr2, der, hds, $HA)}, h)))))

# The walk
# --------

@MACRO HEO Equal.trans(Bool, SV.eq(o, c), SV.eq(SV.nth($OWN, k), c), True{}, Equal.cong(Nat, Bool, x => SV.eq(x, c), o, SV.nth($OWN, k), Equal.sym(Nat, SV.nth($OWN, k), o, OW.nth_of($OWN, k, o, ot, ho))), heq)
@MACRO IH2 ih: @st2: PA.CW -> CW.CWInv($WA0, 1n+k, st2) -> CWRes2($CA, 1n+k, ot, st2, DPS.cwalk2(t, $OWN, c, 1n+k, st2, sk, F0, cx, W))
@MACRO DROPST PA.CW{rows, B, bp, Con{PA.drop_of(k, $RR, e, B, bp), ds}, us}
@MACRO STEPS +heq: {SV.eq(SV.nth($OWN, k), c) == True{} : Bool}, +hq: {OW.qdrop(k, $ES) == Con{e, t} : $QL}, +ho: {OW.ndrop(k, $OWN) == Con{o, ot} : $NL}, +hlt: {SV.lt(k, $N) == True{} : Bool}

def cw2_ok.d(mm: Maybe<&2, DR.Der>, $CP, $WP, +e: E.QExpr, +t: $QL, +o: Nat, +ot: $NL, +k: Nat, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +ds: List<&2, SV.Drop>, +us: $NL,
  +em: {DPS.ddec(sk, $FK, cx, e, $M, W) == mm : Maybe<&2, DR.Der>}, +eb: {EP.isnil(EP.resp($RR)) == False{} : Bool}, $STEPS, +hi: CW.CWInv($WA0, k, $STQ), $HC, $IH2)
  -> CWRes2($CA, k, Con{o, ot}, $STQ, DPS.cwalk2(t, $OWN, c, 1n+k, DPS.cw2.dir(mm, k, e, $RR, rows, B, bp, ds, us, $ENT, $FK), sk, F0, cx, W)):
  match mm:
    case None{}:
      res2_keep($CA, $WAA, k, o, ot, rows, B, bp, ds, us, e, DPS.cwalk2(t, $OWN, c, 1n+k, $KEEPST, sk, F0, cx, W), $HEO, OW.eqat_of($ES, k, e, t, hq), eb, em, hi, $HA,
        ih($KEEPST, CW.inv_keep($WA0, k, rows, B, bp, ds, us, e, hi, heq, hlt, eb, OW.eqat_of($ES, k, e, t, hq))))
    case Some{+der}:
      res2_ddrop($CA, $WAA, k, o, ot, rows, B, bp, ds, us, e, der, DPS.cwalk2(t, $OWN, c, 1n+k, $DDST, sk, F0, cx, W), $HEO, OW.eqat_of($ES, k, e, t, hq), em, $HA,
        ih($DDST, inv_dropx($WA0, k, rows, B, bp, ds, us, $NDK, SV.WDer{der}, hi, heq, hlt)))

def cw2_ok.k(b: Bool, $CP, $WP, +e: E.QExpr, +t: $QL, +o: Nat, +ot: $NL, +k: Nat, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL, +ds: List<&2, SV.Drop>, +us: $NL,
  +eb: {EP.isnil(EP.resp($RR)) == b : Bool}, $STEPS, +hi: CW.CWInv($WA0, k, $STQ), $HC, $IH2)
  -> CWRes2($CA, k, Con{o, ot}, $STQ, DPS.cwalk2(t, $OWN, c, 1n+k, DPS.cw2.pick(EP.isnil(EP.resp($RR)), k, e, $RR, rows, B, bp, ds, us, sk, c, F0, cx, W), sk, F0, cx, W)):
  match b:
    case True{}:
      %Equal.sym(Bool, EP.isnil(EP.resp($RR)), True{}, eb) : CWRes2($CA, k, Con{o, ot}, $STQ, DPS.cwalk2(t, $OWN, c, 1n+k, DPS.cw2.pick(_, k, e, $RR, rows, B, bp, ds, us, sk, c, F0, cx, W), sk, F0, cx, W))
      res2_drop($CA, k, o, ot, rows, B, bp, ds, us, e, DPS.cwalk2(t, $OWN, c, 1n+k, $DROPST, sk, F0, cx, W), $HEO, OW.eqat_of($ES, k, e, t, hq), eb, hi,
        ih($DROPST, CW.inv_drop($WA0, k, rows, B, bp, ds, us, e, hi, heq, hlt)))
    case False{}:
      %Equal.sym(Bool, EP.isnil(EP.resp($RR)), False{}, eb) : CWRes2($CA, k, Con{o, ot}, $STQ, DPS.cwalk2(t, $OWN, c, 1n+k, DPS.cw2.pick(_, k, e, $RR, rows, B, bp, ds, us, sk, c, F0, cx, W), sk, F0, cx, W))
      cw2_ok.d(DPS.ddec(sk, $FK, cx, e, $M, W), $CA, $WAA, e, t, o, ot, k, rows, B, bp, ds, us, {==}, eb, heq, hq, ho, hlt, hi, $HA, ih)

def cw2_ok.s(st: PA.CW, $CP, $WP, +e: E.QExpr, +t: $QL, +o: Nat, +ot: $NL, +k: Nat, $STEPS, hi: CW.CWInv($WA0, k, st), $HC, $IH2)
  -> CWRes2($CA, k, Con{o, ot}, st, DPS.cwalk2(t, $OWN, c, 1n+k, DPS.cw2.res(k, e, st, sk, c, F0, cx, W), sk, F0, cx, W)):
  match st:
    case PA.CW{+rows, +B, +bp, +ds, +us}:
      cw2_ok.k(EP.isnil(EP.resp($RR)), $CA, $WAA, e, t, o, ot, k, rows, B, bp, ds, us, {==}, heq, hq, ho, hlt, hi, $HA, ih)

def cw2_ok.o(b: Bool, $CP, $WP, +e: E.QExpr, +t: $QL, +o: Nat, +ot: $NL, +k: Nat, +st: PA.CW, +eb: {SV.eq(SV.nth($OWN, k), c) == b : Bool}, +hq: {OW.qdrop(k, $ES) == Con{e, t} : $QL}, +ho: {OW.ndrop(k, $OWN) == Con{o, ot} : $NL},
  +hlt: {SV.lt(k, $N) == True{} : Bool}, +hi: CW.CWInv($WA0, k, st), $HC, $IH2) -> CWRes2($CA, k, Con{o, ot}, st, DPS.cwalk2(Con{e, t}, $OWN, c, k, st, sk, F0, cx, W)):
  match b:
    case True{}:
      %Equal.sym(Bool, SV.eq(SV.nth($OWN, k), c), True{}, eb) : CWRes2($CA, k, Con{o, ot}, st, DPS.cwalk2(t, $OWN, c, 1n+k, DPS.cw2.at(_, k, e, st, sk, c, F0, cx, W), sk, F0, cx, W))
      cw2_ok.s(st, $CA, $WAA, e, t, o, ot, k, eb, hq, ho, hlt, hi, $HA, ih)
    case False{}:
      %Equal.sym(Bool, SV.eq(SV.nth($OWN, k), c), False{}, eb) : CWRes2($CA, k, Con{o, ot}, st, DPS.cwalk2(t, $OWN, c, 1n+k, DPS.cw2.at(_, k, e, st, sk, c, F0, cx, W), sk, F0, cx, W))
      res2_skip($CA, k, o, ot, st, DPS.cwalk2(t, $OWN, c, 1n+k, st, sk, F0, cx, W), (%OW.nth_of($OWN, k, o, ot, ho) : {SV.eq(_, c) == False{} : Bool}
        eb), hi, ih(st, CW.inv_skip($WA0, k, st, hi, eb, hlt)))

# the walk from position k
def cw2_ok(es: $QL, own_k: $NL, $CP, $WP, +k: Nat, +st: PA.CW, +hq: {OW.qdrop(k, $ES) == es : $QL}, +ho: {OW.ndrop(k, $OWN) == own_k : $NL}, +hl: {SV.len(own_k) == SV.neqs(es) : Nat},
  +hk: {Nat.add(k, SV.neqs(es)) == $N : Nat}, +hi: CW.CWInv($WA0, k, st), $HC) -> CWRes2($CA, k, own_k, st, DPS.cwalk2(es, $OWN, c, k, st, sk, F0, cx, W)):
  match es own_k:
    case Nil{} Nil{}:
      ((Nil{}, ({==}, {==})), (Unit{}, ((%Equal.trans(Nat, k, Nat.add(k, 0n), $N, LN.add_zero(k), hk) : CW.CWInv($WA0, _, st)
        hi), h => h)))
    case Nil{} Con{+o, +ot}:
      absurd(CWRes2($CA, k, Con{o, ot}, st, st), CW.len_nc(o, ot, hl))
    case Con{+e, +t} Nil{}:
      absurd(CWRes2($CA, k, Nil{}, st, DPS.cwalk2(Con{e, t}, $OWN, c, k, st, sk, F0, cx, W)), CW.len_cn(e, t, hl))
    case Con{+e, +t} Con{+o, +ot}:
      cw2_ok.o(SV.eq(SV.nth($OWN, k), c), $CA, $WAA, e, t, o, ot, k, st, {==}, hq, ho, SP.lt_qdrop($ES, k, e, t, hq), hi, $HA,
        st2 => h2 => cw2_ok(t, ot, $CA, $WAA, 1n+k, st2, OW.qdrop_step(k, $ES, e, t, hq), OW.ndrop_step(k, $OWN, o, ot, ho), LN.succ_inj(SV.len(ot), SV.neqs(t), hl),
          Equal.trans(Nat, 1n+Nat.add(k, SV.neqs(t)), Nat.add(k, 1n+SV.neqs(t)), $N, LN.add_succ(k, SV.neqs(t)), hk), h2, $HA))

# The walk's end
# --------------

@MACRO FIN2 DPS.cwalk2($ES, $OWN, c, 0n, PA.CW{rows, B, bp, Nil{}, Nil{}}, sk, F0, cx, W)
@MACRO DFIN SV.drops(CW.cw.ds($FIN2))
@MACRO GP +sk: SK.Sketch, +cls: List<&2, SV.Class>, +R: $NL, +D: $NL, +c: Nat, $WP, +rows: List<&2, EL.Row>, +B: $QL, +bp: $NL
@MACRO GA sk, cls, R, D, c, $WAA, rows, B, bp
@MACRO GOAL DH.DropsOk(sk, cls, R, D, c, $DFIN) & (DH.DropsNd(sk, cls, R, D, c, CW.cw.ds($FIN2)) & CW.CWInv(sk, R, D, c, bp, $N, $FIN2))

def cw2_final.r2($GP, dr: DH.drops_ok.go(sk, cls, R, D, c, $DFIN, $OWN, 0n), +fr: CW.CWInv(sk, R, D, c, bp, $N, $FIN2), nt: NDT(sk, cls, R, D, c, $DFIN, Nil{}, CW.cw.ds($FIN2))) -> $GOAL:
  +hb = CW.inv_b(sk, R, D, c, bp, $N, $FIN2, fr)
  ((LI.band_i(SV.distinct($DFIN), SV.below($DFIN, $N), CW.cwb_ddist(sk, c, $N, CW.cw.rows($FIN2), CW.cw.B($FIN2), CW.cw.ds($FIN2), CW.cw.us($FIN2), hb),
      CW.cwb_dbelow(sk, c, $N, CW.cw.rows($FIN2), CW.cw.B($FIN2), CW.cw.ds($FIN2), CW.cw.us($FIN2), hb)), dr),
   (nt(Unit{}), fr))

def cw2_final.r($GP, r: CWRes2(sk, cls, R, D, c, bp, 0n, $OWN, PA.CW{rows, B, bp, Nil{}, Nil{}}, $FIN2)) -> $GOAL:
  (xr, q) = r
  (dr, q2) = q
  (fr, nt) = q2
  cw2_final.r2($GA, dr, fr, nt)

# the walk's end: the extended DropsOk and DropsNd for its drops, and the
# invariant at the end
def cw2_final($GP, hr: {EP.rinv(B, rows, 0n) == True{} : Bool}, hl: {EL.rlen(rows) == SV.neqs(B) : Nat},
  hB: {B == SV.presolved(sk, R, D, c) : $QL}, hp: {B == SV.picked($ES, bp) : $QL}, $HC) -> $GOAL:
  cw2_final.r($GA, cw2_ok($ES, $OWN, sk, cls, R, D, c, bp, $WAA, 0n, PA.CW{rows, B, bp, Nil{}, Nil{}}, {==}, {==}, OW.len_owners(sk), {==}, CW.cw_start(sk, R, D, c, rows, B, bp, hr, hl, hB, hp), $HA))
