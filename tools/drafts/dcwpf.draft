@MACRO ES SK.Sketch.eqs(sk)
@MACRO OWN SV.owners(sk)
@MACRO N SV.neqs(SK.Sketch.eqs(sk))
@MACRO P SV.presolved(sk, R, D, c)
@MACRO QL List<&2, E.QExpr>
@MACRO NL List<&2, Nat>
@MACRO FL List<&2, DR.Fact>
@MACRO ENT SV.ents(sk)
@MACRO TV DCF.tv(sk)
@MACRO M DPS.cstat(sk, c)
@MACRO HC +hcov: {BX.Sketch.within(sk, PA.nvars(sk)) == True{} : Bool}, +hwf: {WF.wf_dec(sk) == True{} : Bool}
@MACRO HA hcov, hwf
@MACRO CP +sk: SK.Sketch, +cls: List<&2, SV.Class>, +R: $NL, +D: $NL, +c: Nat, +bp0: $NL
@MACRO CA sk, cls, R, D, c, bp0
@MACRO WA0 sk, R, D, c, bp0
@MACRO WP +F0: $FL, +cx: $QL, +hF0: {F0 == SV.facts.go($ES, $OWN, SV.kept_before(sk, R, c), sk, cls, True{}, 0n) : $FL}, +hcx: {cx == SV.ctx(sk, R, c) : $QL}, +W: DC.WK, +hw: DW.WInv($ENT, SV.rfacts(sk, SV.kept_before(sk, R, c)), cx, $TV, W)
@MACRO WAA F0, cx, hF0, hcx, W, hw
