    AP.abound(~F, n, jm, A, e, b, he, ha, hA, hj, hJ, dv, Equal.trans(Nat, M.len(~F, dv), GJ.nrows(~F, M.madd(~F, pm, M.mneg(~F, rm))), n, Equal.sym(Nat, GJ.nrows(~F, M.madd(~F, pm, M.mneg(~F, rm))), M.len(~F, dv), GJ.len_matvec(~F, M.madd(~F, pm, M.mneg(~F, rm)), v)), hs)),
