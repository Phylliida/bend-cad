    FV.mul_le(~F, al($KA), NP.vn(~F, M.matvec(~F, $T0, $DZ)), @M(@M(FR.ofn(~F, m), ms), rho), al_nn($KA, $NNA), t0bnd($CXA, $Y0A)))

# entry k of (y0 - A0 g0) - x_b is (e0 - A0 S0 e0)_k - (A0 T0 dz)_k
def s0_eq($CXP, $Y0P, $ST0P, +k: Nat) -> {O.lookup(~F, BX.vsub(~F, $Q0, xb), k) == @S(O.lookup(~F, $R0, k), O.lookup(~F, $AT0, k)) : @T}:
  %Equal.sym(@T, O.lookup(~F, BX.vsub(~F, $Q0, xb), k), @S(O.lookup(~F, $Q0, k), O.lookup(~F, xb, k)), DG.look_diff(~F, $Q0, xb, k)) : {_ == @S(O.lookup(~F, $R0, k), O.lookup(~F, $AT0, k)) : @T}
  %Equal.sym(@T, O.lookup(~F, $Q0, k), @S(O.lookup(~F, $Y0, k), O.lookup(~F, $V0, k)), DG.look_diff(~F, $Y0, $V0, k)) : {@S(_, O.lookup(~F, xb, k)) == @S(O.lookup(~F, $R0, k), O.lookup(~F, $AT0, k)) : @T}
  %Equal.sym(M.Vec(~F), $G0, M.vadd(~F, M.matvec(~F, $S0, $E0), M.matvec(~F, $T0, $DZ)), g0eq($CXA, $Y0A)) : {@S(@S(O.lookup(~F, $Y0, k), O.lookup(~F, M.matvec(~F, $STA0, _), k)), O.lookup(~F, xb, k)) == @S(O.lookup(~F, $R0, k), O.lookup(~F, $AT0, k)) : @T}
  %Equal.sym(M.Vec(~F), M.matvec(~F, $STA0, M.vadd(~F, M.matvec(~F, $S0, $E0), M.matvec(~F, $T0, $DZ))), M.vadd(~F, $AS0, $AT0), AP.mv_vadd(~F, $STA0, M.matvec(~F, $S0, $E0), M.matvec(~F, $T0, $DZ))) : {@S(@S(O.lookup(~F, $Y0, k), O.lookup(~F, _, k)), O.lookup(~F, xb, k)) == @S(O.lookup(~F, $R0, k), O.lookup(~F, $AT0, k)) : @T}
  %GJ.look_vadd(~F, $AS0, $AT0, k) : {@S(@S(O.lookup(~F, $Y0, k), _), O.lookup(~F, xb, k)) == @S(O.lookup(~F, $R0, k), O.lookup(~F, $AT0, k)) : @T}
  %Equal.sym(@T, O.lookup(~F, $R0, k), @S(O.lookup(~F, $E0, k), O.lookup(~F, $AS0, k)), DG.look_diff(~F, $E0, $AS0, k)) : {@S(@S(O.lookup(~F, $Y0, k), @A(O.lookup(~F, $AS0, k), O.lookup(~F, $AT0, k))), O.lookup(~F, xb, k)) == @S(_, O.lookup(~F, $AT0, k)) : @T}
  %Equal.sym(@T, O.lookup(~F, $E0, k), @S(O.lookup(~F, $Y0, k), O.lookup(~F, xb, k)), DG.look_diff(~F, $Y0, xb, k)) : {@S(@S(O.lookup(~F, $Y0, k), @A(O.lookup(~F, $AS0, k), O.lookup(~F, $AT0, k))), O.lookup(~F, xb, k)) == @S(@S(_, O.lookup(~F, $AS0, k)), O.lookup(~F, $AT0, k)) : @T}
  FR.fring_eq(~F, [O.lookup(~F, $Y0, k), O.lookup(~F, xb, k), O.lookup(~F, $AS0, k), O.lookup(~F, $AT0, k)], E.ZSub{E.ZSub{E.ZVar{0n}, E.ZAdd{E.ZVar{2n}, E.ZVar{3n}}}, E.ZVar{1n}}, E.ZSub{E.ZSub{E.ZSub{E.ZVar{0n}, E.ZVar{1n}}, E.ZVar{2n}}, E.ZVar{3n}}, {==})

# the first iterate is within e1 of x_b
def s0_near($CXP, $Y0P, $ST0P) -> O.le(~F, NP.vn(~F, BX.vsub(~F, $Y1, xb)), e1($KA)):
  +ca = @A(@M(@M(FR.ofn(~F, n), ea($KA)), d), @M(al($KA), @M(@M(FR.ofn(~F, n), @M(lam, $DRR)), d)))
  +cc = @M(al($KA), @M(@M(FR.ofn(~F, m), ms), rho))
  DM.le_trans(~F, NP.vn(~F, BX.vsub(~F, $Y1, xb)), @A(NP.vn(~F, BX.vsub(~F, $Y1, $Q0)), NP.vn(~F, BX.vsub(~F, $Q0, xb))), e1($KA),
    AP.vn_tri3(~F, $Y1, $Q0, xb),
    RP.le_add2(~F, NP.vn(~F, BX.vsub(~F, $Y1, $Q0)), hnw(~F, p), NP.vn(~F, BX.vsub(~F, $Q0, xb)), @A(ca, cc), r0bnd($CXA, y0, $ST0A),
      DM.le_trans(~F, NP.vn(~F, BX.vsub(~F, $Q0, xb)), @A(NP.vn(~F, $R0), NP.vn(~F, $AT0)), @A(ca, cc),
        vn_by2s(~F, ~BX.vsub(~F, $Q0, xb), ~$R0, ~$AT0, ~(k => s0_eq($CXA, $Y0A, $ST0A, k))),
        RP.le_add2(~F, NP.vn(~F, $R0), ca, NP.vn(~F, $AT0), cc, r0n($CXA, $Y0A, $ST0A), at0n($CXA, $Y0A, $ST0A)))))

# Step 1
# ------
# With w = Z0 g0 (Z0 the exact inverse of J0), g0 = J0 w and
# A1 g1 = A1 g0 + A1 S1 (y1 - y0) = -A1 (S1 w - J0 w) + A1 S1 (w - v0) + A1 S1 e0
# (y1 - y0 = e0 - v0, e0 the first rounding), each term second order but
# the last, which is e0 up to A1 S1 ~ I.

@MACRO STA1 st_A(~F, n, eqs, pc, p, y1, y2, ea($KA), st1)
@MACRO Y2 M.ofdv(~F, y2)
@MACRO P1 pt(~F, y1, pc)
@MACRO J1 jc(~F, eqs, n, $P1)
@MACRO G1 gv(~F, eqs, y1, pc)
@MACRO S1 CP.smat(~F, $P1, $P0, eqs, n, 0n)
@MACRO EPS BX.vsub(~F, $Y1, $Q0)
@MACRO ST1P +y2: List<&2, S.D>, +st1: Step(~F, n, eqs, pc, ea($KA), p, y1, y2)
@MACRO ST1A y2, st1
@MACRO Z0P +z0: M.Mat(~F), +hinv0: DV.Inverse(~F, $J0, z0, n), +hz0: {GJ.nrows(~F, z0) == n : Nat}, +hzb0: O.le(~F, NP.mnorm(~F, z0, n), bt2(~F, b))
@MACRO Z0A z0, hinv0, hz0, hzb0
@MACRO W M.matvec(~F, z0, $G0)

def ly1($CXP, $Y0P, $ST0P) -> {M.len(~F, $Y1) == n : Nat}:
  st_len(~F, n, eqs, pc, p, y0, y1, ea($KA), st)

def hy1($CXP, $Y0P, $ST0P) -> M.vbnd.all(~F, BX.vsub(~F, $Y1, xb), e1($KA)):
  vall_of_vn(~F, BX.vsub(~F, $Y1, xb), e1($KA), s0_near($CXA, $Y0A, $ST0A))

def e1_le_dx($CXP) -> O.le(~F, e1($KA), dx($KA)):
  DM.le_trans(~F, e1($KA), en($KA), dx($KA), e1_le_en($CXA), en_le_dx($CXA))

def lv0($CXP, $Y0P, $ST0P) -> {M.len(~F, $V0) == n : Nat}:
  GJ.len_mv(~F, $STA0, n, $G0, st_nr(~F, n, eqs, pc, p, y0, y1, ea($KA), st))

def leps($CXP, $Y0P, $ST0P) -> {M.len(~F, $EPS) == n : Nat}:
  CP.len_vsub(~F, $Y1, $Q0, n, ly1($CXA, $Y0A, $ST0A), CP.len_vsub(~F, $Y0, $V0, n, ly0, lv0($CXA, $Y0A, $ST0A)))

def dy_at($CXP, $Y0P, $ST0P, +k: Nat) -> {O.lookup(~F, BX.vsub(~F, $Y1, $Y0), k) == O.lookup(~F, BX.vsub(~F, $EPS, $V0), k) : @T}:
  %Equal.sym(@T, O.lookup(~F, BX.vsub(~F, $Y1, $Y0), k), @S(O.lookup(~F, $Y1, k), O.lookup(~F, $Y0, k)), DG.look_diff(~F, $Y1, $Y0, k)) : {_ == O.lookup(~F, BX.vsub(~F, $EPS, $V0), k) : @T}
  %Equal.sym(@T, O.lookup(~F, BX.vsub(~F, $EPS, $V0), k), @S(O.lookup(~F, $EPS, k), O.lookup(~F, $V0, k)), DG.look_diff(~F, $EPS, $V0, k)) : {@S(O.lookup(~F, $Y1, k), O.lookup(~F, $Y0, k)) == _ : @T}
  %Equal.sym(@T, O.lookup(~F, $EPS, k), @S(O.lookup(~F, $Y1, k), O.lookup(~F, $Q0, k)), DG.look_diff(~F, $Y1, $Q0, k)) : {@S(O.lookup(~F, $Y1, k), O.lookup(~F, $Y0, k)) == @S(_, O.lookup(~F, $V0, k)) : @T}
  %Equal.sym(@T, O.lookup(~F, $Q0, k), @S(O.lookup(~F, $Y0, k), O.lookup(~F, $V0, k)), DG.look_diff(~F, $Y0, $V0, k)) : {@S(O.lookup(~F, $Y1, k), O.lookup(~F, $Y0, k)) == @S(@S(O.lookup(~F, $Y1, k), _), O.lookup(~F, $V0, k)) : @T}
  FR.fring_eq(~F, [O.lookup(~F, $Y1, k), O.lookup(~F, $Y0, k), O.lookup(~F, $V0, k)], E.ZSub{E.ZVar{0n}, E.ZVar{1n}}, E.ZSub{E.ZSub{E.ZVar{0n}, E.ZSub{E.ZVar{1n}, E.ZVar{2n}}}, E.ZVar{2n}}, {==})

# y1 - y0 = e0 - v0
def dy_eq($CXP, $Y0P, $ST0P) -> {BX.vsub(~F, $Y1, $Y0) == BX.vsub(~F, $EPS, $V0) : M.Vec(~F)}:
  AP.vext(~F, ~BX.vsub(~F, $Y1, $Y0), ~BX.vsub(~F, $EPS, $V0), ~(k => dy_at($CXA, $Y0A, $ST0A, k)), n, CP.len_vsub(~F, $Y1, $Y0, n, ly1($CXA, $Y0A, $ST0A), ly0), CP.len_vsub(~F, $EPS, $V0, n, leps($CXA, $Y0A, $ST0A), lv0($CXA, $Y0A, $ST0A)))

# g0 = J0 w
def g0w($CXP, $Y0P, $Z0P) -> {M.matvec(~F, $J0, $W) == $G0 : M.Vec(~F)}:
  GJ.inv_r(~F, $J0, z0, n, hinv0, AP.nrows_jacn(~F, $P0, eqs, n, hn), $G0, lg($CXA, y0))

def lw($CXP, $Y0P, $Z0P) -> {M.len(~F, $W) == n : Nat}:
