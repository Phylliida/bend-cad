      vall_le(~F, BX.vsub(~F, xb, $Y0), d, $DRR, vall_swap(~F, $Y0, xb, d, hy0), le_addr(~F, d, rho, hr0)),
      vall_le(~F, BX.vsub(~F, xz, M.ofdv(~F, pc)), rho, $DRR, vall_swap(~F, M.ofdv(~F, pc), xz, rho, hzc), le_addl(~F, d, rho, hd0))),
    Equal.sym(Nat, M.len(~F, $P0), M.len(~F, $XS), lpt_xs($CXA, y0, ly0)))

# |S0 - J0| <= n lam (d + rho)
def lip0($CXP, $Y0P) -> O.le(~F, NP.mnorm(~F, M.madd(~F, $S0, M.mneg(~F, $J0)), n), @M(FR.ofn(~F, n), @M(lam, $DRR))):
  %AP.cen_fbx(~F, $P0, $DRR) : O.le(~F, NP.mnorm(~F, M.madd(~F, $S0, M.mneg(~F, DV.jac(~F, _, eqs, ST.iota(n, 0n)))), n), @M(FR.ofn(~F, n), @M(lam, $DRR)))
  AP.smat_lip_mn(~F, $DRR, bb, drr_nn($CXA), hbb0, $B0, gb0($CXA, $Y0A), $P0, $XS, in0($CXA, $Y0A), inx0($CXA, $Y0A), lam, ms, hl0, eqs, hq, n, 0n)

def vne0($CXP, $Y0P) -> O.le(~F, NP.vn(~F, $E0), d):
  FV.vmax_lub(~F, $E0, d, hy0, hd0)

# |e0 - A0 S0 e0| <= n ea d + al n lam (d + rho) d
def r0n($CXP, $Y0P, $ST0P) -> O.le(~F, NP.vn(~F, $R0), @A(@M(@M(FR.ofn(~F, n), ea($KA)), d), @M(al($KA), @M(@M(FR.ofn(~F, n), @M(lam, $DRR)), d)))):
  DM.le_trans(~F, NP.vn(~F, $R0), @A(@M(@M(FR.ofn(~F, n), ea($KA)), NP.vn(~F, $E0)), @M(al($KA), @M(NP.mnorm(~F, M.madd(~F, $S0, M.mneg(~F, $J0)), n), NP.vn(~F, $E0)))), @A(@M(@M(FR.ofn(~F, n), ea($KA)), d), @M(al($KA), @M(@M(FR.ofn(~F, n), @M(lam, $DRR)), d))),
    AP.ajs(~F, n, $J0, $S0, $STA0, ea($KA), bt2(~F, b), ea_nn($KA, $NNA), st_ag(~F, n, eqs, pc, p, y0, y1, ea($KA), st), st_nr(~F, n, eqs, pc, p, y0, y1, ea($KA), st), AP.nrows_jacn(~F, $P0, eqs, n, hn), pt_inv($CXA, y0, ly0, d, hy0, d_le_dx($CXA)), nrows_sj(~F, $P0, $XS, $P0, eqs, n, hn), $E0, le0($CXA, $Y0A)),
    RP.le_add2(~F, @M(@M(FR.ofn(~F, n), ea($KA)), NP.vn(~F, $E0)), @M(@M(FR.ofn(~F, n), ea($KA)), d), @M(al($KA), @M(NP.mnorm(~F, M.madd(~F, $S0, M.mneg(~F, $J0)), n), NP.vn(~F, $E0))), @M(al($KA), @M(@M(FR.ofn(~F, n), @M(lam, $DRR)), d)),
      FV.mul_le(~F, @M(FR.ofn(~F, n), ea($KA)), NP.vn(~F, $E0), d, nms_nn(~F, n, ea($KA), ea_nn($KA, $NNA)), vne0($CXA, $Y0A)),
      FV.mul_le(~F, al($KA), @M(NP.mnorm(~F, M.madd(~F, $S0, M.mneg(~F, $J0)), n), NP.vn(~F, $E0)), @M(@M(FR.ofn(~F, n), @M(lam, $DRR)), d), al_nn($KA, $NNA),
        mm_le(~F, NP.mnorm(~F, M.madd(~F, $S0, M.mneg(~F, $J0)), n), @M(FR.ofn(~F, n), @M(lam, $DRR)), NP.vn(~F, $E0), d, FV.vmax_nn(~F, $E0), AP.lr_nn(~F, n, lam, $DRR, hl0, drr_nn($CXA)), lip0($CXA, $Y0A), vne0($CXA, $Y0A)))))

def lt0($CXP, $Y0P) -> {M.len(~F, M.matvec(~F, $T0, $DZ)) == n : Nat}:
  Equal.trans(Nat, M.len(~F, M.matvec(~F, $T0, $DZ)), GJ.nrows(~F, $T0), n, Equal.sym(Nat, GJ.nrows(~F, $T0), M.len(~F, M.matvec(~F, $T0, $DZ)), GJ.len_matvec(~F, $T0, $DZ)), Equal.trans(Nat, GJ.nrows(~F, $T0), CK.eqlen(eqs), n, nrows_smat(~F, $P0, $XS, eqs, m, n), hn))

# |A0 T0 (pc - x_z)| <= al m ms rho
def at0n($CXP, $Y0P, $ST0P) -> O.le(~F, NP.vn(~F, $AT0), @M(al($KA), @M(@M(FR.ofn(~F, m), ms), rho))):
