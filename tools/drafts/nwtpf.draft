    FV.mul_le(~F, al($KA), NP.vn(~F, $G0), g0c($KA), al_nn($KA, $NNA), g0bnd($CXA, $Y0A)))

def r0bnd($CXP, +y0: List<&2, S.D>, $ST0P) -> O.le(~F, NP.vn(~F, BX.vsub(~F, $Y1, $Q0)), hnw(~F, p)):
