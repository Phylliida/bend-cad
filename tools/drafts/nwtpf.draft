    case (A, q):
      AP.both_l(DG.agood(~F, n, jc(~F, eqs, n, pt(~F, y, pc)), A, ea0), M.Both({GJ.nrows(~F, A) == n : Nat}, M.Both(M.vbnd.all(~F, BX.vsub(~F, M.ofdv(~F, y2), BX.vsub(~F, M.ofdv(~F, y), M.matvec(~F, A, gv(~F, eqs, y, pc)))), hnw(~F, p)), {M.len(~F, M.ofdv(~F, y2)) == n : Nat})), q)

def st_r1(~F: O.OField, +n: Nat, +eqs: List<&2, E.QExpr>, +pc: List<&2, S.D>, +p: Nat, $STP) -> M.Both({GJ.nrows(~F, st_A(~F, n, eqs, pc, p, y, y2, ea0, st)) == n : Nat}, M.Both(M.vbnd.all(~F, BX.vsub(~F, M.ofdv(~F, y2), BX.vsub(~F, M.ofdv(~F, y), M.matvec(~F, st_A(~F, n, eqs, pc, p, y, y2, ea0, st), gv(~F, eqs, y, pc)))), hnw(~F, p)), {M.len(~F, M.ofdv(~F, y2)) == n : Nat})):
  match st:
    case (A, q):
      AP.both_r(DG.agood(~F, n, jc(~F, eqs, n, pt(~F, y, pc)), A, ea0), M.Both({GJ.nrows(~F, A) == n : Nat}, M.Both(M.vbnd.all(~F, BX.vsub(~F, M.ofdv(~F, y2), BX.vsub(~F, M.ofdv(~F, y), M.matvec(~F, A, gv(~F, eqs, y, pc)))), hnw(~F, p)), {M.len(~F, M.ofdv(~F, y2)) == n : Nat})), q)

def st_nr(~F: O.OField, +n: Nat, +eqs: List<&2, E.QExpr>, +pc: List<&2, S.D>, +p: Nat, $STP) -> {GJ.nrows(~F, st_A(~F, n, eqs, pc, p, y, y2, ea0, st)) == n : Nat}:
