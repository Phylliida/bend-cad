def eq_g1($CXP, $Y0P, $ST0P, $ST1P, +k: Nat) -> {$DG1 == @S($GG, $GL) : @T}:
  %Equal.sym(M.Vec(~F), M.matvec(~F, $STA1, BX.vsub(~F, $G1, $G0)), BX.vsub(~F, M.matvec(~F, $STA1, $G1), M.matvec(~F, $STA1, $G0)), AP.mv_vsub(~F, $STA1, $G1, $G0)) : {O.lookup(~F, _, k) == @S($GG, $GL) : @T}
  DG.look_diff(~F, M.matvec(~F, $STA1, $G1), M.matvec(~F, $STA1, $G0), k)

def eq_g2($CXP, $Y0P, $ST0P, $ST1P, +k: Nat) -> {$DG1 == @S($DD, $CC) : @T}:
  %Equal.sym(M.Vec(~F), BX.vsub(~F, $G1, $G0), M.matvec(~F, $S1, BX.vsub(~F, $Y1, $Y0)), CP.fvecs_con(~F, $Y1, $Y0, M.ofdv(~F, pc), eqs, n, m, hbl, ly1($CXA, $Y0A, $ST0A), ly0)) : {O.lookup(~F, M.matvec(~F, $STA1, _), k) == @S($DD, $CC) : @T}
  %Equal.sym(M.Vec(~F), BX.vsub(~F, $Y1, $Y0), BX.vsub(~F, $EPS, $V0), dy_eq($CXA, $Y0A, $ST0A)) : {O.lookup(~F, M.matvec(~F, $STA1, M.matvec(~F, $S1, _)), k) == @S($DD, $CC) : @T}
  %Equal.sym(M.Vec(~F), M.matvec(~F, $S1, BX.vsub(~F, $EPS, $V0)), BX.vsub(~F, M.matvec(~F, $S1, $EPS), M.matvec(~F, $S1, $V0)), AP.mv_vsub(~F, $S1, $EPS, $V0)) : {O.lookup(~F, M.matvec(~F, $STA1, _), k) == @S($DD, $CC) : @T}
  %Equal.sym(M.Vec(~F), M.matvec(~F, $STA1, BX.vsub(~F, M.matvec(~F, $S1, $EPS), M.matvec(~F, $S1, $V0))), BX.vsub(~F, M.matvec(~F, $STA1, M.matvec(~F, $S1, $EPS)), M.matvec(~F, $STA1, M.matvec(~F, $S1, $V0))), AP.mv_vsub(~F, $STA1, M.matvec(~F, $S1, $EPS), M.matvec(~F, $S1, $V0))) : {O.lookup(~F, _, k) == @S($DD, $CC) : @T}
  DG.look_diff(~F, M.matvec(~F, $STA1, M.matvec(~F, $S1, $EPS)), M.matvec(~F, $STA1, M.matvec(~F, $S1, $V0)), k)

def eq_g3($CXP, $Y0P, $ST0P, $ST1P, $Z0P, +k: Nat) -> {$GL == $AA : @T}:
  %g0w($CXA, $Y0A, $Z0A) : {O.lookup(~F, M.matvec(~F, $STA1, _), k) == $AA : @T}
  {==}

def eq_x1($CXP, $Y0P, $ST0P, $ST1P, $Z0P, +k: Nat) -> {O.lookup(~F, $X1, k) == @S($BQ, $AA) : @T}:
  %Equal.sym(M.Vec(~F), $X1, BX.vsub(~F, M.matvec(~F, $STA1, M.matvec(~F, $S1, $W)), M.matvec(~F, $STA1, M.matvec(~F, $J0, $W))), AP.mv_vsub(~F, $STA1, M.matvec(~F, $S1, $W), M.matvec(~F, $J0, $W))) : {O.lookup(~F, _, k) == @S($BQ, $AA) : @T}
  DG.look_diff(~F, M.matvec(~F, $STA1, M.matvec(~F, $S1, $W)), M.matvec(~F, $STA1, M.matvec(~F, $J0, $W)), k)

def eq_x2($CXP, $Y0P, $ST0P, $ST1P, $Z0P, +k: Nat) -> {O.lookup(~F, $X2, k) == @S($BQ, $CC) : @T}:
  %Equal.sym(M.Vec(~F), M.matvec(~F, $S1, BX.vsub(~F, $W, $V0)), BX.vsub(~F, M.matvec(~F, $S1, $W), M.matvec(~F, $S1, $V0)), AP.mv_vsub(~F, $S1, $W, $V0)) : {O.lookup(~F, M.matvec(~F, $STA1, _), k) == @S($BQ, $CC) : @T}
  %Equal.sym(M.Vec(~F), M.matvec(~F, $STA1, BX.vsub(~F, M.matvec(~F, $S1, $W), M.matvec(~F, $S1, $V0))), BX.vsub(~F, M.matvec(~F, $STA1, M.matvec(~F, $S1, $W)), M.matvec(~F, $STA1, M.matvec(~F, $S1, $V0))), AP.mv_vsub(~F, $STA1, M.matvec(~F, $S1, $W), M.matvec(~F, $S1, $V0))) : {O.lookup(~F, _, k) == @S($BQ, $CC) : @T}
  DG.look_diff(~F, M.matvec(~F, $STA1, M.matvec(~F, $S1, $W)), M.matvec(~F, $STA1, M.matvec(~F, $S1, $V0)), k)

def add_of_sub(~F: O.OField, +x: @T, +y: @T, +t: @T, h: {@S(x, y) == t : @T}) -> {x == @A(y, t) : @T}:
  %h : {x == @A(y, _) : @T}
  FR.fring_eq(~F, [x, y], E.ZVar{0n}, E.ZAdd{E.ZVar{1n}, E.ZSub{E.ZVar{0n}, E.ZVar{1n}}}, {==})

# entry k of A1 g1 is -X1 + X2 + X3
def s1_eq($CXP, $Y0P, $ST0P, $ST1P, $Z0P, +k: Nat) -> {$GG == @A(@A(@N(O.lookup(~F, $X1, k)), O.lookup(~F, $X2, k)), O.lookup(~F, $X3, k)) : @T}:
  %Equal.sym(@T, $GG, @A($GL, @S($DD, $CC)), add_of_sub(~F, $GG, $GL, @S($DD, $CC), Equal.trans(@T, @S($GG, $GL), $DG1, @S($DD, $CC), Equal.sym(@T, $DG1, @S($GG, $GL), eq_g1($CXA, $Y0A, $ST0A, $ST1A, k)), eq_g2($CXA, $Y0A, $ST0A, $ST1A, k)))) : {_ == @A(@A(@N(O.lookup(~F, $X1, k)), O.lookup(~F, $X2, k)), O.lookup(~F, $X3, k)) : @T}
  %Equal.sym(@T, $GL, $AA, eq_g3($CXA, $Y0A, $ST0A, $ST1A, $Z0A, k)) : {@A(_, @S($DD, $CC)) == @A(@A(@N(O.lookup(~F, $X1, k)), O.lookup(~F, $X2, k)), O.lookup(~F, $X3, k)) : @T}
  %Equal.sym(@T, O.lookup(~F, $X1, k), @S($BQ, $AA), eq_x1($CXA, $Y0A, $ST0A, $ST1A, $Z0A, k)) : {@A($AA, @S($DD, $CC)) == @A(@A(@N(_), O.lookup(~F, $X2, k)), O.lookup(~F, $X3, k)) : @T}
  %Equal.sym(@T, O.lookup(~F, $X2, k), @S($BQ, $CC), eq_x2($CXA, $Y0A, $ST0A, $ST1A, $Z0A, k)) : {@A($AA, @S($DD, $CC)) == @A(@A(@N(@S($BQ, $AA)), _), O.lookup(~F, $X3, k)) : @T}
  FR.fring_eq(~F, [$AA, $BQ, $CC, $DD], E.ZAdd{E.ZVar{0n}, E.ZSub{E.ZVar{3n}, E.ZVar{2n}}}, E.ZAdd{E.ZAdd{E.ZNeg{E.ZSub{E.ZVar{1n}, E.ZVar{0n}}}, E.ZSub{E.ZVar{1n}, E.ZVar{2n}}}, E.ZVar{3n}}, {==})

# entry by entry w = -p1 + p2 + p3: |w| <= |p1| + |p2| + |p3|
def vn_by3(~F: O.OField, ~w: M.Vec(~F), ~p1: M.Vec(~F), ~p2: M.Vec(~F), ~p3: M.Vec(~F), ~eq: @k: Nat -> {O.lookup(~F, w, k) == @A(@A(@N(O.lookup(~F, p1, k)), O.lookup(~F, p2, k)), O.lookup(~F, p3, k)) : @T}) -> O.le(~F, NP.vn(~F, w), @A(@A(NP.vn(~F, p1), NP.vn(~F, p2)), NP.vn(~F, p3))):
  FV.vmax_lub(~F, w, @A(@A(NP.vn(~F, p1), NP.vn(~F, p2)), NP.vn(~F, p3)), DG.vall_by(~F, ~w, ~@A(@A(NP.vn(~F, p1), NP.vn(~F, p2)), NP.vn(~F, p3)), ~(k => KB.bnd_val(~F, @A(@A(@N(O.lookup(~F, p1, k)), O.lookup(~F, p2, k)), O.lookup(~F, p3, k)), O.lookup(~F, w, k), @A(@A(NP.vn(~F, p1), NP.vn(~F, p2)), NP.vn(~F, p3)), Equal.sym(@T, O.lookup(~F, w, k), @A(@A(@N(O.lookup(~F, p1, k)), O.lookup(~F, p2, k)), O.lookup(~F, p3, k)), eq(k)),
      FM.bnd_add(~F, @A(@N(O.lookup(~F, p1, k)), O.lookup(~F, p2, k)), @A(NP.vn(~F, p1), NP.vn(~F, p2)), O.lookup(~F, p3, k), NP.vn(~F, p3), FM.bnd_add(~F, @N(O.lookup(~F, p1, k)), NP.vn(~F, p1), O.lookup(~F, p2, k), NP.vn(~F, p2), FM.bnd_neg(~F, O.lookup(~F, p1, k), NP.vn(~F, p1), AP.lkb(~F, p1, k)), AP.lkb(~F, p2, k)), AP.lkb(~F, p3, k))))),
    FO.nonneg_add(~F, @A(NP.vn(~F, p1), NP.vn(~F, p2)), NP.vn(~F, p3), AP.vn_nn2(~F, p1, p2), FV.vmax_nn(~F, p3)))

@MACRO CX1 @M(al($KA), @M(@M(FR.ofn(~F, n), @M(lam, dl0($KA))), @M(bt2(~F, b), g0c($KA))))
@MACRO CX2 @M(al($KA), @M(@M(FR.ofn(~F, n), ms), @M(@M(FR.ofn(~F, n), ea($KA)), @M(bt2(~F, b), g0c($KA)))))
@MACRO CE @M(@M(FR.ofn(~F, n), ea($KA)), hnw(~F, p))
@MACRO CF @M(al($KA), @M(@M(FR.ofn(~F, n), @M(lam, dl0($KA))), hnw(~F, p)))
@MACRO Q1 BX.vsub(~F, $Y1, M.matvec(~F, $STA1, $G1))

# the second step moves at most 8h
def s1_go($CXP, $Y0P, $ST0P, $ST1P, $Z0P) -> O.le(~F, NP.vn(~F, BX.vsub(~F, $Y2, $Y1)), h8(~F, p)):
  +ag = M.matvec(~F, $STA1, $G1)
  DM.le_trans(~F, NP.vn(~F, BX.vsub(~F, $Y2, $Y1)), @A(NP.vn(~F, BX.vsub(~F, $Y2, $Q1)), NP.vn(~F, BX.vsub(~F, $Q1, $Y1))), h8(~F, p),
    AP.vn_tri3(~F, $Y2, $Q1, $Y1),
    DM.le_trans(~F, @A(NP.vn(~F, BX.vsub(~F, $Y2, $Q1)), NP.vn(~F, BX.vsub(~F, $Q1, $Y1))), @A(hnw(~F, p), @A(@A($CX1, $CX2), @A(hnw(~F, p), @A($CE, $CF)))), h8(~F, p),
      RP.le_add2(~F, NP.vn(~F, BX.vsub(~F, $Y2, $Q1)), hnw(~F, p), NP.vn(~F, BX.vsub(~F, $Q1, $Y1)), @A(@A($CX1, $CX2), @A(hnw(~F, p), @A($CE, $CF))),
        FV.vmax_lub(~F, BX.vsub(~F, $Y2, $Q1), hnw(~F, p), st_rb(~F, n, eqs, pc, p, y1, y2, ea($KA), st1), hnw_nn(~F, p)),
        DM.le_trans(~F, NP.vn(~F, BX.vsub(~F, $Q1, $Y1)), NP.vn(~F, ag), @A(@A($CX1, $CX2), @A(hnw(~F, p), @A($CE, $CF))), vn_back(~F, $Y1, ag),
          DM.le_trans(~F, NP.vn(~F, ag), @A(@A(NP.vn(~F, $X1), NP.vn(~F, $X2)), NP.vn(~F, $X3)), @A(@A($CX1, $CX2), @A(hnw(~F, p), @A($CE, $CF))),
            vn_by3(~F, ~ag, ~$X1, ~$X2, ~$X3, ~(k => s1_eq($CXA, $Y0A, $ST0A, $ST1A, $Z0A, k))),
            RP.le_add2(~F, @A(NP.vn(~F, $X1), NP.vn(~F, $X2)), @A($CX1, $CX2), NP.vn(~F, $X3), @A(hnw(~F, p), @A($CE, $CF)),
              RP.le_add2(~F, NP.vn(~F, $X1), $CX1, NP.vn(~F, $X2), $CX2, bx1($CXA, $Y0A, $ST0A, $ST1A, $Z0A), bx2($CXA, $Y0A, $ST0A, $ST1A, $Z0A)),
              bx3($CXA, $Y0A, $ST0A, $ST1A))))),
      RL.le_rw_l(~F, @A(@A(hnw(~F, p), hnw(~F, p)), settle($KA)), @A(hnw(~F, p), @A(@A($CX1, $CX2), @A(hnw(~F, p), @A($CE, $CF)))), h8(~F, p),
          FR.fring_eq(~F, [hnw(~F, p), $CX1, $CX2, $CE, $CF], E.ZAdd{E.ZAdd{E.ZVar{0n}, E.ZVar{0n}}, E.ZAdd{E.ZAdd{E.ZVar{3n}, E.ZVar{4n}}, E.ZAdd{E.ZVar{1n}, E.ZVar{2n}}}}, E.ZAdd{E.ZVar{0n}, E.ZAdd{E.ZAdd{E.ZVar{1n}, E.ZVar{2n}}, E.ZAdd{E.ZVar{0n}, E.ZAdd{E.ZVar{3n}, E.ZVar{4n}}}}}, {==}),
          RP.le_add2(~F, @A(hnw(~F, p), hnw(~F, p)), @A(hnw(~F, p), hnw(~F, p)), settle($KA), h6(~F, p), FO.le_refl(~F, @A(hnw(~F, p), hnw(~F, p))), s4))))

def s1_inv($CXP, $Y0P, $ST0P, $ST1P, hJ0: NP.InvB(~F, $J0, n, bt2(~F, b))) -> O.le(~F, NP.vn(~F, BX.vsub(~F, $Y2, $Y1)), h8(~F, p)):
  match hJ0:
    case (+z0, q):
      match q:
        case (hinv0, q2):
          match q2:
            case (hz0, hzb0):
              s1_go($CXA, $Y0A, $ST0A, $ST1A, $Z0A)

def s1_settle($CXP, $Y0P, $ST0P, $ST1P) -> O.le(~F, NP.vn(~F, BX.vsub(~F, $Y2, $Y1)), h8(~F, p)):
  s1_inv($CXA, $Y0A, $ST0A, $ST1A, pt_inv($CXA, y0, ly0, d, hy0, d_le_dx($CXA)))

# Newton's control flow
# ---------------------

# the settle threshold 2^-(p-2) is 8h, for p = 2 + q
def t8_q(~F: O.OField, +q: Nat) -> {M.ofd(~F, S.D{S.Zpos{S.XH{}}, q}) == h8(~F, 1n+(1n+q)) : @T}:
  @CERTEQ[t=O.ofp(~F, S.Pos.pow2(q)),, i=O.inv(F, O.ofp(~F, S.Pos.pow2(q))),, j=O.inv(F, O.ofp(~F, S.Pos.pow2(1n+(1n+(1n+q))))) | 1*i | (1*j + 1*j) + (((1*j + 1*j) + (1*j + 1*j)) + (1*j + 1*j)) | -i ; (((t + t) + (t + t)) + ((t + t) + (t + t)))*j - 1 | ((j + j) + (j + j)) + ((j + j) + (j + j)) ; t*i - 1 || QE.ofp_rel(~F, S.Pos.pow2(1n+(1n+(1n+q)))), QE.ofp_rel(~F, S.Pos.pow2(q))]

def t8_eq(~F: O.OField, +p: Nat, +q: Nat, hp: {p == 1n+(1n+q) : Nat}) -> {M.ofd(~F, S.D{S.Zpos{S.XH{}}, Nat.sub(p, 2n)}) == h8(~F, p) : @T}:
  %Equal.sym(Nat, p, 1n+(1n+q), hp) : {M.ofd(~F, S.D{S.Zpos{S.XH{}}, Nat.sub(_, 2n)}) == h8(~F, _) : @T}
  %Equal.sym(Nat, Nat.sub(q, 0n), q, RP.sub0(q)) : {M.ofd(~F, S.D{S.Zpos{S.XH{}}, _}) == h8(~F, 1n+(1n+q)) : @T}
  t8_q(~F, q)

def le_hofd(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +a: S.D, +b: S.D, h: O.le(~F, M.ofd(~F, a), M.ofd(~F, b))) -> O.le(~F, N.emap(KI.dnum(), F, H, a), N.emap(KI.dnum(), F, H, b)):
  %Equal.sym(@T, N.emap(KI.dnum(), F, H, a), M.ofd(~F, a), AP.hofd(~F, ~H, a)) : O.le(~F, _, N.emap(KI.dnum(), F, H, b))
  %Equal.sym(@T, N.emap(KI.dnum(), F, H, b), M.ofd(~F, b), AP.hofd(~F, ~H, b)) : O.le(~F, M.ofd(~F, a), _)
  h

def bnd_hsub(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +x: S.D, +y: S.D, +t: @T, h: M.bnd(~F, @A(M.ofd(~F, x), @N(M.ofd(~F, y))), t)) -> M.bnd(~F, N.emap(KI.dnum(), F, H, S.D.sub(x, y)), t):
  %Equal.sym(@T, N.emap(KI.dnum(), F, H, S.D.sub(x, y)), M.ofd(~F, S.D.sub(x, y)), AP.hofd(~F, ~H, S.D.sub(x, y))) : M.bnd(~F, _, t)
  %Equal.sym(@T, M.ofd(~F, S.D.sub(x, y)), @A(M.ofd(~F, x), @N(M.ofd(~F, y))), ofd_sub(~F, x, y)) : M.bnd(~F, _, t)
  h

def dabs_le_t(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +x: S.D, +y: S.D, +t: S.D, h: M.bnd(~F, @A(M.ofd(~F, x), @N(M.ofd(~F, y))), M.ofd(~F, t))) -> {KA.kle(~KI.dnum(), NU.dabs(S.D.sub(x, y)), t) == True{} : Bool}:
  AP.kle_of(~KI.dnum(), ~F, ~H, NU.dabs(S.D.sub(x, y)), t,
    (%Equal.sym(@T, N.emap(KI.dnum(), F, H, t), M.ofd(~F, t), AP.hofd(~F, ~H, t)) : O.le(~F, N.emap(KI.dnum(), F, H, NU.dabs(S.D.sub(x, y))), _)
      BP.kabs_le(~KI.dnum(), ~F, ~H, S.D.sub(x, y), M.ofd(~F, t), bnd_hsub(~F, ~H, x, y, M.ofd(~F, t), h))))

# entries within ofd t pass the solver's closeness test
def dclose_of(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, xs: List<&2, S.D>, ys: List<&2, S.D>, +t: S.D, hl: {M.len(~F, M.ofdv(~F, xs)) == M.len(~F, M.ofdv(~F, ys)) : Nat}, h: M.vbnd.all(~F, BX.vsub(~F, M.ofdv(~F, xs), M.ofdv(~F, ys)), M.ofd(~F, t))) -> {NU.dclose(xs, ys, t) == True{} : Bool}:
  match xs ys:
    case Nil{} Nil{}:
      {==}
    case Nil{} Con{y, yt}:
      FO.absurd({NU.dclose(Nil{}, Con{y, yt}, t) == True{} : Bool}, FV.zero_ne(M.len(~F, M.ofdv(~F, yt)), hl))
    case Con{x, xt} Nil{}:
      FO.absurd({NU.dclose(Con{x, xt}, Nil{}, t) == True{} : Bool}, FV.succ_ne(M.len(~F, M.ofdv(~F, xt)), hl))
    case Con{+x, +xt} Con{+y, +yt}:
      (h1, h2) = h
      AP.band_t(KA.kle(~KI.dnum(), NU.dabs(S.D.sub(x, y)), t), NU.dclose(xt, yt, t), dabs_le_t(~F, ~H, x, y, t, h1), dclose_of(~F, ~H, xt, yt, t, FV.succ_inj(M.len(~F, M.ofdv(~F, xt)), M.len(~F, M.ofdv(~F, yt)), hl), h2))

# what newton promises: an answer within en of x_b, n entries
def NOK($KP, +xb: M.Vec(~F), r: Maybe<&2, List<&2, S.D>>) -> Type:
  match r:
    case None{}:
      Empty
    case Some{yc}:
      M.Both(O.le(~F, NP.vn(~F, BX.vsub(~F, M.ofdv(~F, yc), xb)), en($KA)), {M.len(~F, M.ofdv(~F, yc)) == n : Nat})

@MACRO T8 S.D{S.Zpos{S.XH{}}, Nat.sub(p, 2n)}
@MACRO PQP +q2: Nat, +hp2: {p == 1n+(1n+q2) : Nat}
@MACRO PQA q2, hp2

def lsym($CXP, +u: List<&2, S.D>, +v: List<&2, S.D>, lu: {M.len(~F, M.ofdv(~F, u)) == n : Nat}, lv: {M.len(~F, M.ofdv(~F, v)) == n : Nat}) -> {M.len(~F, M.ofdv(~F, u)) == M.len(~F, M.ofdv(~F, v)) : Nat}:
  Equal.trans(Nat, M.len(~F, M.ofdv(~F, u)), n, M.len(~F, M.ofdv(~F, v)), lu, Equal.sym(Nat, M.len(~F, M.ofdv(~F, v)), n, lv))

# kle is transitive (through F, for any K)
def kle_trans(~K: N.Num, ~F: O.OField, ~H: N.Emb<K, F>, +a: N.NC(K), +b: N.NC(K), +c: N.NC(K), h1: {KA.kle(~K, a, b) == True{} : Bool}, h2: {KA.kle(~K, b, c) == True{} : Bool}) -> {KA.kle(~K, a, c) == True{} : Bool}:
  AP.kle_of(~K, ~F, ~H, a, c, DM.le_trans(~F, @H(a), @H(b), @H(c), KA.kle_ok(~K, ~F, ~H, a, b, h1), KA.kle_ok(~K, ~F, ~H, b, c, h2)))

# entries within 1 pass the 2^40 guard: kle(1, 2^40) is computed, never
# read in F (2^40 unfolds to 2^40 terms there)
def dclose_far(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, xs: List<&2, S.D>, ys: List<&2, S.D>, hl: {M.len(~F, M.ofdv(~F, xs)) == M.len(~F, M.ofdv(~F, ys)) : Nat}, h: M.vbnd.all(~F, BX.vsub(~F, M.ofdv(~F, xs), M.ofdv(~F, ys)), M.ofd(~F, M.d1()))) -> {NU.dclose(xs, ys, NU.far()) == True{} : Bool}:
  match xs ys:
    case Nil{} Nil{}:
      {==}
    case Nil{} Con{y, yt}:
      FO.absurd({NU.dclose(Nil{}, Con{y, yt}, NU.far()) == True{} : Bool}, FV.zero_ne(M.len(~F, M.ofdv(~F, yt)), hl))
    case Con{x, xt} Nil{}:
      FO.absurd({NU.dclose(Con{x, xt}, Nil{}, NU.far()) == True{} : Bool}, FV.succ_ne(M.len(~F, M.ofdv(~F, xt)), hl))
    case Con{+x, +xt} Con{+y, +yt}:
      (h1, h2) = h
      AP.band_t(KA.kle(~KI.dnum(), NU.dabs(S.D.sub(x, y)), NU.far()), NU.dclose(xt, yt, NU.far()), kle_trans(~KI.dnum(), ~F, ~H, NU.dabs(S.D.sub(x, y)), M.d1(), NU.far(), dabs_le_t(~F, ~H, x, y, M.d1(), h1), {==}), dclose_far(~F, ~H, xt, yt, FV.succ_inj(M.len(~F, M.ofdv(~F, xt)), M.len(~F, M.ofdv(~F, yt)), hl), h2))

def d1_one(~F: O.OField) -> {@1 == M.ofd(~F, M.d1()) : @T}:
  DM.ofd_one(~F)

# a move of at most s <= 1 passes the 2^40 guard
def far_ok($CXP, +u: List<&2, S.D>, +v: List<&2, S.D>, lu: {M.len(~F, M.ofdv(~F, u)) == n : Nat}, lv: {M.len(~F, M.ofdv(~F, v)) == n : Nat}, +s: @T, hs: O.le(~F, NP.vn(~F, BX.vsub(~F, M.ofdv(~F, v), M.ofdv(~F, u))), s), hs1: O.le(~F, s, @1)) -> {NU.dclose(u, v, NU.far()) == True{} : Bool}:
  dclose_far(~F, ~H, u, v, lsym($CXA, u, v, lu, lv), vall_swap(~F, M.ofdv(~F, v), M.ofdv(~F, u), M.ofd(~F, M.d1()),
    (%d1_one(~F) : M.vbnd.all(~F, BX.vsub(~F, M.ofdv(~F, v), M.ofdv(~F, u)), _)
      vall_of_vn(~F, BX.vsub(~F, M.ofdv(~F, v), M.ofdv(~F, u)), @1, DM.le_trans(~F, NP.vn(~F, BX.vsub(~F, M.ofdv(~F, v), M.ofdv(~F, u))), s, @1, hs, hs1)))))

# a move of at most 8h passes the settle test
def t8_ok($CXP, $PQP, +u: List<&2, S.D>, +v: List<&2, S.D>, lu: {M.len(~F, M.ofdv(~F, u)) == n : Nat}, lv: {M.len(~F, M.ofdv(~F, v)) == n : Nat}, hs: O.le(~F, NP.vn(~F, BX.vsub(~F, M.ofdv(~F, v), M.ofdv(~F, u))), h8(~F, p))) -> {NU.dclose(u, v, $T8) == True{} : Bool}:
  dclose_of(~F, ~H, u, v, $T8, lsym($CXA, u, v, lu, lv), vall_swap(~F, M.ofdv(~F, v), M.ofdv(~F, u), M.ofd(~F, $T8),
    (%Equal.sym(@T, M.ofd(~F, $T8), h8(~F, p), t8_eq(~F, p, q2, hp2)) : M.vbnd.all(~F, BX.vsub(~F, M.ofdv(~F, v), M.ofdv(~F, u)), _)
      vall_of_vn(~F, BX.vsub(~F, M.ofdv(~F, v), M.ofdv(~F, u)), h8(~F, p), hs))))
