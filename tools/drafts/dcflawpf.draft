import ../spec/dir.bend as DR
import ./karith.bend as KA
import ./nat.bend as LN
import ./listpf.bend as LI
import ./ownpf.bend as OW
import ./solvedpf.bend as SP
import ./fring.bend as FR
import ./ford.bend as FO
import ./dirpf.bend as DP
import ./meaning.bend as MN
import ./vsdpf.bend as VS
import ./ckpf.bend as CKP
import ./conflictpf.bend as CFP
import ./conflawpf.bend as CF
import ./dfactpf.bend as DFC

@MACRO NL List<&2, Nat>
@MACRO QL List<&2, E.QExpr>
@MACRO RL List<&2, SK.Rec>
@MACRO EL List<&2, SK.Ent>
@MACRO SL List<&2, SK.Side>
@MACRO ENV List<&2, O.C(F)>
@MACRO Z0 O.zero(F)
@MACRO CLS List<&2, SV.Class>
@MACRO OWN SV.owners(sk)
@MACRO ES SK.Sketch.eqs(sk)
@MACRO ENT SV.ents(sk)
@MACRO R SV.reds(cls)
@MACRO D SV.dropped(cls)

def absurd(-A: Type, x: Empty) -> A:
  match x:

# The Fate at c
# -------------

def go_hd(+sk: SK.Sketch, +cls: $CLS, +m: Nat, +c0: Nat, h: DH.Honest.go(sk, cls, 1n+m, c0)) -> DH.Fate(sk, cls, c0):
  match h:
    case (a, b):
      a

def go_tl(+sk: SK.Sketch, +cls: $CLS, +m: Nat, +c0: Nat, h: DH.Honest.go(sk, cls, 1n+m, c0)) -> DH.Honest.go(sk, cls, m, 1n+c0):
  match h:
    case (a, b):
      b

# the k-th fate from c0 on
def fate_at(+sk: SK.Sketch, +cls: $CLS, n: Nat, +c0: Nat, k: Nat, h: DH.Honest.go(sk, cls, n, c0), hk: {KA.natle(1n+k, n) == True{} : Bool}) -> DH.Fate(sk, cls, Nat.add(k, c0)):
  match n k:
    case 0n k:
      absurd(DH.Fate(sk, cls, Nat.add(k, c0)), KA.ft(hk))
    case 1n++m 0n:
      go_hd(sk, cls, m, c0, h)
    case 1n++m 1n++j:
      (%Equal.sym(Nat, 1n+Nat.add(j, c0), Nat.add(j, 1n+c0), LN.add_succ(j, c0)) : DH.Fate(sk, cls, _)
        fate_at(sk, cls, m, 1n+c0, j, go_tl(sk, cls, m, c0, h), hk))

def hon_len(+sk: SK.Sketch, +cls: $CLS, h: DH.Honest(sk, cls)) -> {SV.clsn(cls) == SV.ncons(sk) : Nat}:
  match h:
    case (a, b):
      a

def hon_go(+sk: SK.Sketch, +cls: $CLS, h: DH.Honest(sk, cls)) -> DH.Honest.go(sk, cls, SV.ncons(sk), 0n):
  match h:
    case (a, b):
      b

# The facts of c and s hold
# -------------------------

# an equation of one of cs holds as a fact with no nd, its constraint's
# direction statement holding with it
def rf_ok.c(~F: O.OField, b: Bool, +x: M.Vec(~F), +sk: SK.Sketch, +cs: $NL, +e: E.QExpr, +t: $QL, +k: Nat, +hq: {OW.qdrop(k, $ES) == Con{e, t} : $QL}, +hz: SK.Zeros(~F, x, SV.solved.pick(b, e, SV.eqs_of.go(t, $OWN, cs, 1n+k))),
  ih: SK.Zeros(~F, x, SV.eqs_of.go(t, $OWN, cs, 1n+k)) -> DP.AllFacts(~F, x, $ENT, SV.facts.go(t, $OWN, cs, sk, Nil{}, False{}, 1n+k)))
  -> DP.AllFacts(~F, x, $ENT, SV.facts.pick(b, DR.Fact{e, SV.fnd.pick(False{}, Nil{}, k), SV.dstat_of($ENT, SV.kind_at(sk, SV.nth($OWN, k)))}, SV.facts.go(t, $OWN, cs, sk, Nil{}, False{}, 1n+k))):
  match b:
    case True{}:
      +ze = DP.fst({O.eval(~F, x, e) == $Z0 : O.C(F)}, SK.Zeros(~F, x, SV.eqs_of.go(t, $OWN, cs, 1n+k)), hz)
      (Inr{(ze, DFC.stat_at(~F, x, sk, k, SP.lt_qdrop($ES, k, e, t, hq), (%Equal.sym(E.QExpr, SV.eqat($ES, k), e, OW.eqat_of($ES, k, e, t, hq)) : {O.eval(~F, x, _) == $Z0 : O.C(F)}
        ze)))}, ih(DP.snd({O.eval(~F, x, e) == $Z0 : O.C(F)}, SK.Zeros(~F, x, SV.eqs_of.go(t, $OWN, cs, 1n+k)), hz)))
    case False{}:
      ih(hz)

def rf_ok(~F: O.OField, +x: M.Vec(~F), +sk: SK.Sketch, +cs: $NL, es: $QL, +k: Nat, +hq: {OW.qdrop(k, $ES) == es : $QL}, hz: SK.Zeros(~F, x, SV.eqs_of.go(es, $OWN, cs, k))) -> DP.AllFacts(~F, x, $ENT, SV.facts.go(es, $OWN, cs, sk, Nil{}, False{}, k)):
  match es:
    case Nil{}:
      Unit{}
    case Con{+e, +t}:
      rf_ok.c(~F, SV.mem(SV.nth($OWN, k), cs), x, sk, cs, e, t, k, hq, hz, z => rf_ok(~F, x, sk, cs, t, 1n+k, OW.qdrop_step(k, $ES, e, t, hq), z))

# where the equations of cs hold, so do their facts
def rf_all(~F: O.OField, +x: M.Vec(~F), +sk: SK.Sketch, +cs: $NL, hz: SK.Zeros(~F, x, SV.eqs_of(sk, cs))) -> DP.AllFacts(~F, x, $ENT, SV.rfacts(sk, cs)):
  rf_ok(~F, x, sk, cs, $ES, 0n, {==}, hz)

# An Angle's side
# ---------------

@MACRO SA SK.seg(es, a)
@MACRO SB SK.seg(es, b)
@MACRO DA SK.Seg.dir(SK.dseg(es, a, ra))
@MACRO WB SK.Seg.dir(SK.dseg(es, b, rb))
@MACRO DOT DP.ev(~F, env, SK.VE.dot(SK.VE.rot(c, s, $DA), $WB))
@MACRO A1 DP.ev(~F, env, SK.VE.x(DR.zseg(es, a)))
@MACRO A2 DP.ev(~F, env, SK.VE.y(DR.zseg(es, a)))
@MACRO B1 DP.ev(~F, env, SK.VE.x(DR.zseg(es, b)))
@MACRO B2 DP.ev(~F, env, SK.VE.y(DR.zseg(es, b)))
@MACRO D1 DP.ev(~F, env, SK.VE.x($DA))
@MACRO D2 DP.ev(~F, env, SK.VE.y($DA))
@MACRO W1 DP.ev(~F, env, SK.VE.x($WB))
@MACRO W2 DP.ev(~F, env, SK.VE.y($WB))
@MACRO CV DP.ev(~F, env, c)
@MACRO SN DP.ev(~F, env, s)
@MACRO SG DP.rsign(~F, ra)
@MACRO SGB DP.rsign(~F, rb)
@MACRO U1 @S(@M($CV, $D1), @M($SN, $D2))
@MACRO U2 @A(@M($SN, $D1), @M($CV, $D2))
@MACRO ANG +env: $ENV, +es: $EL, +a: Nat, +ra: Bool, +b: Nat, +rb: Bool, +c: E.QExpr, +s: E.QExpr
@MACRO ANA env, es, a, ra, b, rb, c, s

# the side's dot is 0 where the first segment has length 0
def dot0_a(~F: O.OField, $ANG, h1: {$A1 == @0 : @T}, h2: {$A2 == @0 : @T}) -> {$DOT == @0 : @T}:
  %Equal.sym(@T, $D1, @M($SG, $A1), DP.rev_x(~F, env, $SA, ra)) : {@A(@M(@S(@M($CV, _), @M($SN, $D2)), $W1), @M(@A(@M($SN, _), @M($CV, $D2)), $W2)) == @0 : @T}
  %Equal.sym(@T, $D2, @M($SG, $A2), DP.rev_y(~F, env, $SA, ra)) : {@A(@M(@S(@M($CV, @M($SG, $A1)), @M($SN, _)), $W1), @M(@A(@M($SN, @M($SG, $A1)), @M($CV, _)), $W2)) == @0 : @T}
  FO.cert2(~F, @A(@M(@S(@M($CV, @M($SG, $A1)), @M($SN, @M($SG, $A2))), $W1), @M(@A(@M($SN, @M($SG, $A1)), @M($CV, @M($SG, $A2))), $W2)),
    @M($SG, @A(@M($CV, $W1), @M($SN, $W2))), $A1, @M($SG, @S(@M($CV, $W2), @M($SN, $W1))), $A2,
    FR.fring_eq(~F, [$A1, $A2, $W1, $W2, $CV, $SN, $SG],
      E.ZAdd{E.ZMul{E.ZSub{E.ZMul{E.ZVar{4n}, E.ZMul{E.ZVar{6n}, E.ZVar{0n}}}, E.ZMul{E.ZVar{5n}, E.ZMul{E.ZVar{6n}, E.ZVar{1n}}}}, E.ZVar{2n}}, E.ZMul{E.ZAdd{E.ZMul{E.ZVar{5n}, E.ZMul{E.ZVar{6n}, E.ZVar{0n}}}, E.ZMul{E.ZVar{4n}, E.ZMul{E.ZVar{6n}, E.ZVar{1n}}}}, E.ZVar{3n}}},
      E.ZAdd{E.ZMul{E.ZMul{E.ZVar{6n}, E.ZAdd{E.ZMul{E.ZVar{4n}, E.ZVar{2n}}, E.ZMul{E.ZVar{5n}, E.ZVar{3n}}}}, E.ZVar{0n}}, E.ZMul{E.ZMul{E.ZVar{6n}, E.ZSub{E.ZMul{E.ZVar{4n}, E.ZVar{3n}}, E.ZMul{E.ZVar{5n}, E.ZVar{2n}}}}, E.ZVar{1n}}}, {==}),
    h1, h2)

# and where the second has length 0
def dot0_b(~F: O.OField, $ANG, h1: {$B1 == @0 : @T}, h2: {$B2 == @0 : @T}) -> {$DOT == @0 : @T}:
  %Equal.sym(@T, $W1, @M($SGB, $B1), DP.rev_x(~F, env, $SB, rb)) : {@A(@M($U1, _), @M($U2, $W2)) == @0 : @T}
  %Equal.sym(@T, $W2, @M($SGB, $B2), DP.rev_y(~F, env, $SB, rb)) : {@A(@M($U1, @M($SGB, $B1)), @M($U2, _)) == @0 : @T}
  FO.cert2(~F, @A(@M($U1, @M($SGB, $B1)), @M($U2, @M($SGB, $B2))), @M($U1, $SGB), $B1, @M($U2, $SGB), $B2,
    FR.fring_eq(~F, [$B1, $B2, $U1, $U2, $SGB],
      E.ZAdd{E.ZMul{E.ZVar{2n}, E.ZMul{E.ZVar{4n}, E.ZVar{0n}}}, E.ZMul{E.ZVar{3n}, E.ZMul{E.ZVar{4n}, E.ZVar{1n}}}},
      E.ZAdd{E.ZMul{E.ZMul{E.ZVar{2n}, E.ZVar{4n}}, E.ZVar{0n}}, E.ZMul{E.ZMul{E.ZVar{3n}, E.ZVar{4n}}, E.ZVar{1n}}}, {==}),
    h1, h2)

# a^2 + b^2 = 0 gives b = 0
def sumsq_zero2(~F: O.OField, +a: @T, +b: @T, +h: {@A(@M(a, a), @M(b, b)) == @0 : @T}) -> {b == @0 : @T}:
  FO.sumsq_zero(~F, b, a, Equal.trans(@T, @A(@M(b, b), @M(a, a)), @A(@M(a, a), @M(b, b)), @0,
    FR.fring_eq(~F, [a, b], E.ZAdd{E.ZMul{E.ZVar{1n}, E.ZVar{1n}}, E.ZMul{E.ZVar{0n}, E.ZVar{0n}}}, E.ZAdd{E.ZMul{E.ZVar{0n}, E.ZVar{0n}}, E.ZMul{E.ZVar{1n}, E.ZVar{1n}}}, {==}), h))

def long_a.c(~F: O.OField, $ANG, hp: O.lt(F, @0, $DOT), d: DP.DOr(DR.Long(~F, env, es, a), {DP.ev(~F, env, SK.VE.norm2(DR.zseg(es, a))) == @0 : @T})) -> DR.Long(~F, env, es, a):
  match d:
    case Inl{l}:
      l
    case Inr{+e}:
      absurd(DR.Long(~F, env, es, a), FO.ne_of_lt(~F, @0, $DOT, hp, Equal.sym(@T, $DOT, @0, dot0_a(~F, $ANA, FO.sumsq_zero(~F, $A1, $A2, e), sumsq_zero2(~F, $A1, $A2, e)))))

def long_b.c(~F: O.OField, $ANG, hp: O.lt(F, @0, $DOT), d: DP.DOr(DR.Long(~F, env, es, b), {DP.ev(~F, env, SK.VE.norm2(DR.zseg(es, b))) == @0 : @T})) -> DR.Long(~F, env, es, b):
  match d:
    case Inl{l}:
      l
    case Inr{+e}:
      absurd(DR.Long(~F, env, es, b), FO.ne_of_lt(~F, @0, $DOT, hp, Equal.sym(@T, $DOT, @0, dot0_b(~F, $ANA, FO.sumsq_zero(~F, $B1, $B2, e), sumsq_zero2(~F, $B1, $B2, e)))))

# the side makes both segments long
def long_ab(~F: O.OField, $ANG, +hp: O.lt(F, @0, $DOT)) -> DR.Longs(~F, env, es, [a, b]):
  (long_a.c(~F, $ANA, hp, DFC.ls_seg(~F, env, es, a)), (long_b.c(~F, $ANA, hp, DFC.ls_seg(~F, env, es, b)), Unit{}))

# The sides of a constraint among c and s
# ---------------------------------------

# the sides of the constraint m, if any
def KSides(~F: O.OField, +env: $ENV, +es: $EL, m: Maybe<&2, SK.Constraint>) -> Data:
  match m:
    case Some{+k}:
      SK.Sides(~F, env, SK.Constraint.sides(es, k))
    case None{}:
      Unit

def sp_l(~F: O.OField, b: Bool, +env: $ENV, xs: $SL, +rest: $SL, eb: {b == True{} : Bool}, +h: SK.Sides(~F, env, SV.csides.pick(b, xs, rest))) -> SK.Sides(~F, env, xs):
  match b:
    case True{}:
      MN.sides_l(~F, env, xs, rest, h)
    case False{}:
      absurd(SK.Sides(~F, env, xs), KA.ft(eb))

def sp_r(~F: O.OField, b: Bool, +env: $ENV, xs: $SL, +rest: $SL, +h: SK.Sides(~F, env, SV.csides.pick(b, xs, rest))) -> SK.Sides(~F, env, rest):
  match b:
    case True{}:
      MN.sides_r(~F, env, xs, rest, h)
    case False{}:
      h

def sides_hd(~F: O.OField, dr: Bool, +env: $ENV, +es: $EL, +id: Nat, +k: SK.Constraint, +t: $RL, +cs: $NL, +i: Nat, hd: {dr == False{} : Bool}, hm: {SV.mem(i, cs) == True{} : Bool}, +hs: SK.Sides(~F, env, SV.csides.go(es, Con{SK.Rec{id, dr, k}, t}, cs, i)))
  -> SK.Sides(~F, env, SK.Constraint.sides(es, k)):
  match dr:
    case True{}:
      absurd(SK.Sides(~F, env, SK.Constraint.sides(es, k)), KA.tf(hd))
    case False{}:
      sp_l(~F, SV.mem(i, cs), env, SK.Constraint.sides(es, k), SV.csides.go(es, t, cs, 1n+i), hm, hs)

def sides_tl(~F: O.OField, dr: Bool, +env: $ENV, +es: $EL, +id: Nat, +k: SK.Constraint, +t: $RL, +cs: $NL, +i: Nat, +hs: SK.Sides(~F, env, SV.csides.go(es, Con{SK.Rec{id, dr, k}, t}, cs, i)))
  -> SK.Sides(~F, env, SV.csides.go(es, t, cs, 1n+i)):
  match dr:
    case True{}:
      hs
    case False{}:
      sp_r(~F, SV.mem(i, cs), env, SK.Constraint.sides(es, k), SV.csides.go(es, t, cs, 1n+i), hs)

# the driving record m of rs (from position i), one of cs: its sides are
# among cs's
def sides_at(~F: O.OField, +env: $ENV, +es: $EL, rs: $RL, +cs: $NL, +i: Nat, m: Nat, hm: {SV.mem(Nat.add(m, i), cs) == True{} : Bool}, hd: {SV.driven.at(rs, m) == False{} : Bool}, +hs: SK.Sides(~F, env, SV.csides.go(es, rs, cs, i)))
  -> KSides(~F, env, es, SV.rec_at(rs, m)):
  match rs m:
    case Nil{} m:
      absurd(KSides(~F, env, es, None{}), KA.tf(hd))
    case Con{SK.Rec{+id, dr, +k}, +t} 0n:
      sides_hd(~F, dr, env, es, id, k, t, cs, i, hd, hm, hs)
    case Con{SK.Rec{+id, dr, +k}, +t} 1n++q:
      sides_at(~F, env, es, t, cs, 1n+i, q, (%LN.add_succ(q, i) : {SV.mem(_, cs) == True{} : Bool}
        hm), hd, sides_tl(~F, dr, env, es, id, k, t, cs, i, hs))

def sides_of(~F: O.OField, +x: M.Vec(~F), sk: SK.Sketch, +cs: $NL, +p: Nat, hm: {SV.mem(p, cs) == True{} : Bool}, hd: {SV.driven(sk, p) == False{} : Bool}, +hs: SK.Sides(~F, x, SV.csides(sk, cs))) -> KSides(~F, x, $ENT, SV.kind_at(sk, p)):
  match sk:
    case SK.Sketch{+vs, +es, +rs}:
      sides_at(~F, x, es, rs, cs, 0n, p, (%LN.add_zero(p) : {SV.mem(_, cs) == True{} : Bool}
        hm), hd, hs)

# a driving constraint is not driven
def drv_f(+sk: SK.Sketch, +p: Nat, h: {SV.driving(sk, p) == True{} : Bool}) -> {SV.driven(sk, p) == False{} : Bool}:
  LI.bnot_f(SV.driven(sk, p), LI.band_r(SV.lt(p, SV.ncons(sk)), SV.bnot(SV.driven(sk, p)), h))

def drv_mem.c(b: Bool, +sk: SK.Sketch, +p: Nat, +q: Nat, +t: $NL, eb: {SV.eq(p, q) == b : Bool}, +had: {SV.all_driving(sk, Con{q, t}) == True{} : Bool}, hm: {SV.bor(b, SV.mem(p, t)) == True{} : Bool},
  ih: {SV.mem(p, t) == True{} : Bool} -> {SV.driven(sk, p) == False{} : Bool}) -> {SV.driven(sk, p) == False{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Nat, p, q, LI.eq_ok(p, q, eb)) : {SV.driven(sk, _) == False{} : Bool}
      drv_f(sk, q, LI.band_l(SV.driving(sk, q), SV.all_driving(sk, t), had))
    case False{}:
      ih(hm)

# a member of all driving constraints is driving
def drv_mem(+sk: SK.Sketch, +p: Nat, cs: $NL, +had: {SV.all_driving(sk, cs) == True{} : Bool}, hm: {SV.mem(p, cs) == True{} : Bool}) -> {SV.driven(sk, p) == False{} : Bool}:
  match cs:
    case Nil{}:
      absurd({SV.driven(sk, p) == False{} : Bool}, KA.ft(hm))
    case Con{+q, +t}:
      drv_mem.c(SV.eq(p, q), sk, p, q, t, {==}, had, hm, h => drv_mem(sk, p, t, LI.band_r(SV.driving(sk, q), SV.all_driving(sk, t), had), h))

# The Angles' segments are long
# -----------------------------

def aa_of.k(~F: O.OField, +env: $ENV, +es: $EL, k: SK.Constraint, +hs: SK.Sides(~F, env, SK.Constraint.sides(es, k))) -> DR.Longs(~F, env, es, SV.angle_args.of(Some{k})):
  match k:
    case SK.Angle{+a, +ra, +b, +rb, +c, +s}:
      long_ab(~F, $ANA, DP.fst(O.lt(F, @0, $DOT), Unit, hs))
    case SK.Coincident{x1, x2}:
      Unit{}
    case SK.Horizontal{x1, x2}:
      Unit{}
    case SK.Vertical{x1, x2}:
      Unit{}
    case SK.Concentric{x1, x2}:
      Unit{}
    case SK.EqualRadius{x1, x2}:
      Unit{}
    case SK.Fix{x1, x2}:
      Unit{}
    case SK.Distance{x1, x2, x3}:
      Unit{}
    case SK.HDistance{x1, x2, x3}:
      Unit{}
    case SK.VDistance{x1, x2, x3}:
      Unit{}
    case SK.Radius{x1, x2}:
      Unit{}
    case SK.Diameter{x1, x2}:
      Unit{}
    case SK.LineDistance{x1, x2, x3, x4, x5}:
      Unit{}
    case SK.EqualLength{x1, x2}:
      Unit{}
    case SK.Perpendicular{x1, x2}:
      Unit{}
    case SK.Parallel{x1, x2}:
      Unit{}
    case SK.OnLine{x1, x2}:
      Unit{}
    case SK.OnCircle{x1, x2}:
      Unit{}
    case SK.Midpoint{x1, x2}:
      Unit{}
    case SK.Symmetric{x1, x2, x3}:
      Unit{}

def aa_of(~F: O.OField, +env: $ENV, +es: $EL, m: Maybe<&2, SK.Constraint>, +hs: KSides(~F, env, es, m)) -> DR.Longs(~F, env, es, SV.angle_args.of(m)):
  match m:
    case Some{+k}:
      aa_of.k(~F, env, es, k, hs)
    case None{}:
      Unit{}

def longs_join(~F: O.OField, +env: $ENV, +es: $EL, xs: $NL, +ys: $NL, +ha: DR.Longs(~F, env, es, xs), +hb: DR.Longs(~F, env, es, ys)) -> DR.Longs(~F, env, es, SV.cat(xs, ys)):
  match xs:
    case Nil{}:
      hb
    case Con{+p, +t}:
      (DP.fst(DR.Long(~F, env, es, p), DR.Longs(~F, env, es, t), ha), longs_join(~F, env, es, t, ys, DP.snd(DR.Long(~F, env, es, p), DR.Longs(~F, env, es, t), ha), hb))

# the segments of the Angles among cs (within S, whose sides hold) are long
def aa_longs(~F: O.OField, +x: M.Vec(~F), +sk: SK.Sketch, +S: $NL, cs: $NL, +hsub: {SV.sub(cs, S) == True{} : Bool}, +had: {SV.all_driving(sk, cs) == True{} : Bool}, +hs: SK.Sides(~F, x, SV.csides(sk, S))) -> DR.Longs(~F, x, $ENT, SV.angle_args(sk, cs)):
  match cs:
    case Nil{}:
      Unit{}
    case Con{+p, +t}:
      longs_join(~F, x, $ENT, SV.angle_args.of(SV.kind_at(sk, p)), SV.angle_args(sk, t),
        aa_of(~F, x, $ENT, SV.kind_at(sk, p), sides_of(~F, x, sk, S, p, LI.band_l(SV.mem(p, S), SV.sub(t, S), hsub), drv_f(sk, p, LI.band_l(SV.driving(sk, p), SV.all_driving(sk, t), had)), hs)),
        aa_longs(~F, x, sk, S, t, LI.band_r(SV.mem(p, S), SV.sub(t, S), hsub), LI.band_r(SV.driving(sk, p), SV.all_driving(sk, t), had), hs))

# The three direction refutations have no point
# ---------------------------------------------

@MACRO AFP +af: DP.AllFacts(~F, env, es, fs)
@MACRO CON +env: $ENV, +es: $EL, +fs: List<&2, DR.Fact>, +ctx: $QL, $AFP
@MACRO COA env, es, fs, ctx, af

def kz(~F: O.OField, $CON, +d: DR.Der, hv: DR.Valid(es, fs, ctx, d), k: DR.IsK(DR.concl(es, fs, d)), +hl: DR.Longs(~F, env, es, DR.nd(es, fs, d))) -> {DP.ev(~F, env, DR.Jd.e(DR.concl(es, fs, d))) == @0 : @T}:
  DP.kval(~F, env, es, DR.concl(es, fs, d), k, DP.sound(~F, env, es, fs, ctx, af, d, hv, hl))

# a Motzkin refutation's K facts are zeros where their nd is long
def mz_zeros(~F: O.OField, $CON, ds: List<&2, DR.Der>, hv: DR.AllValidK(es, fs, ctx, ds), +hl: DR.Longs(~F, env, es, DR.nds(es, fs, ds))) -> SK.Zeros(~F, env, DR.dconcls(es, fs, ds)):
  match ds:
    case Nil{}:
      Unit{}
    case Con{+d, +t}:
      (v, q) = hv
      (k, r) = q
      +lc = DP.longs_cat(~F, env, es, DR.nd(es, fs, d), DR.nds(es, fs, t), hl)
      (kz(~F, $COA, d, v, k, DP.fst(DR.Longs(~F, env, es, DR.nd(es, fs, d)), DR.Longs(~F, env, es, DR.nds(es, fs, t)), lc)), mz_zeros(~F, $COA, t, r, DP.snd(DR.Longs(~F, env, es, DR.nd(es, fs, d)), DR.Longs(~F, env, es, DR.nds(es, fs, t)), lc)))

@MACRO NDS DR.ncat(DR.nd(es, fs, dr), DR.nd(es, fs, di))
@MACRO LC DP.longs_cat(~F, env, es, DR.nd(es, fs, dr), DR.nd(es, fs, di), hl)
@MACRO LDR DP.fst(DR.Longs(~F, env, es, DR.nd(es, fs, dr)), DR.Longs(~F, env, es, DR.nd(es, fs, di)), $LC)
@MACRO LDI DP.snd(DR.Longs(~F, env, es, DR.nd(es, fs, dr)), DR.Longs(~F, env, es, DR.nd(es, fs, di)), $LC)

# a collapse makes a long segment's squared length 0
def coll(~F: O.OField, $CON, +dr: DR.Der, +di: DR.Der, +s: Nat, hr: DR.RefColl(es, fs, ctx, dr, di, s), +hl: DR.Longs(~F, env, es, Con{s, $NDS})) -> Empty:
  (v1, q1) = hr
  (v2, q2) = q1
  (k1, q3) = q2
  (k2, q4) = q3
  (sr, q5) = q4
  (si, op) = q5
  +lc = DP.longs_cat(~F, env, es, DR.nd(es, fs, dr), DR.nd(es, fs, di), DP.snd(DR.Long(~F, env, es, s), DR.Longs(~F, env, es, $NDS), hl))
  +zx = DP.k_tr(~F, env, DR.Jd.e(DR.concl(es, fs, dr)), SK.VE.x(DR.zseg(es, s)), sr, kz(~F, $COA, dr, v1, k1, DP.fst(DR.Longs(~F, env, es, DR.nd(es, fs, dr)), DR.Longs(~F, env, es, DR.nd(es, fs, di)), lc)))
  +zy = DP.k_tr(~F, env, DR.Jd.e(DR.concl(es, fs, di)), SK.VE.y(DR.zseg(es, s)), si, kz(~F, $COA, di, v2, k2, DP.snd(DR.Longs(~F, env, es, DR.nd(es, fs, dr)), DR.Longs(~F, env, es, DR.nd(es, fs, di)), lc)))
  +x1 = DP.ev(~F, env, SK.VE.x(DR.zseg(es, s)))
  +y1 = DP.ev(~F, env, SK.VE.y(DR.zseg(es, s)))
  FO.ne_of_lt(~F, @0, DP.ev(~F, env, SK.VE.norm2(DR.zseg(es, s))), DP.fst(DR.Long(~F, env, es, s), DR.Longs(~F, env, es, $NDS), hl), Equal.sym(@T, DP.ev(~F, env, SK.VE.norm2(DR.zseg(es, s))), @0, FO.cert2(~F, DP.ev(~F, env, SK.VE.norm2(DR.zseg(es, s))), x1, x1, y1, y1, {==}, zx, zy)))

# a collapsed Angle segment's direction is 0
def AZ(~F: O.OField, +env: $ENV, +es: $EL, m: Maybe<&2, Nat>) -> Data:
  match m:
    case Some{+a}:
      SK.Both({$A1 == @0 : @T}, {$A2 == @0 : @T})
    case None{}:
      {False{} == True{} : Bool}

def az_of(~F: O.OField, +env: $ENV, +es: $EL, +fs: List<&2, DR.Fact>, +dr: DR.Der, +di: DR.Der, m: Maybe<&2, Nat>, ac: DR.AngleColl(es, fs, dr, di, m), +zr: {DP.ev(~F, env, DR.Jd.e(DR.concl(es, fs, dr))) == @0 : @T}, +zi: {DP.ev(~F, env, DR.Jd.e(DR.concl(es, fs, di))) == @0 : @T}) -> AZ(~F, env, es, m):
  match m:
    case Some{+a}:
      (sr, si) = ac
      (DP.k_tr(~F, env, DR.Jd.e(DR.concl(es, fs, dr)), SK.VE.x(DR.zseg(es, a)), sr, zr), DP.k_tr(~F, env, DR.Jd.e(DR.concl(es, fs, di)), SK.VE.y(DR.zseg(es, a)), si, zi))
    case None{}:
      absurd(AZ(~F, env, es, None{}), ac)

def ang_f(~F: O.OField, fst: Bool, $ANG, hz: AZ(~F, env, es, DR.angle_seg(SK.Angle{a, ra, b, rb, c, s}, fst)), +hp: O.lt(F, @0, $DOT)) -> Empty:
  match fst:
    case True{}:
      (z1, z2) = hz
      FO.ne_of_lt(~F, @0, $DOT, hp, Equal.sym(@T, $DOT, @0, dot0_a(~F, $ANA, z1, z2)))
    case False{}:
      (z1, z2) = hz
      FO.ne_of_lt(~F, @0, $DOT, hp, Equal.sym(@T, $DOT, @0, dot0_b(~F, $ANA, z1, z2)))

# a collapsed segment of an Angle makes its side's dot 0
def ang_k(~F: O.OField, +env: $ENV, +es: $EL, k: SK.Constraint, +fst: Bool, hz: AZ(~F, env, es, DR.angle_seg(k, fst)), +hs: SK.Sides(~F, env, SK.Constraint.sides(es, k))) -> Empty:
  match k:
    case SK.Angle{+a, +ra, +b, +rb, +c, +s}:
      ang_f(~F, fst, $ANA, hz, DP.fst(O.lt(F, @0, $DOT), Unit, hs))
    case SK.Coincident{x1, x2}:
      KA.ft(hz)
    case SK.Horizontal{x1, x2}:
      KA.ft(hz)
    case SK.Vertical{x1, x2}:
      KA.ft(hz)
    case SK.Concentric{x1, x2}:
      KA.ft(hz)
    case SK.EqualRadius{x1, x2}:
      KA.ft(hz)
    case SK.Fix{x1, x2}:
      KA.ft(hz)
    case SK.Distance{x1, x2, x3}:
      KA.ft(hz)
    case SK.HDistance{x1, x2, x3}:
      KA.ft(hz)
    case SK.VDistance{x1, x2, x3}:
      KA.ft(hz)
    case SK.Radius{x1, x2}:
      KA.ft(hz)
    case SK.Diameter{x1, x2}:
      KA.ft(hz)
    case SK.LineDistance{x1, x2, x3, x4, x5}:
      KA.ft(hz)
    case SK.EqualLength{x1, x2}:
      KA.ft(hz)
    case SK.Perpendicular{x1, x2}:
      KA.ft(hz)
    case SK.Parallel{x1, x2}:
      KA.ft(hz)
    case SK.OnLine{x1, x2}:
      KA.ft(hz)
    case SK.OnCircle{x1, x2}:
      KA.ft(hz)
    case SK.Midpoint{x1, x2}:
      KA.ft(hz)
    case SK.Symmetric{x1, x2, x3}:
      KA.ft(hz)

def ang_ref(~F: O.OField, $CON, +dr: DR.Der, +di: DR.Der, +k: SK.Constraint, +fst: Bool, hr: DR.RefAngle(es, fs, ctx, dr, di, k, fst), +hs: SK.Sides(~F, env, SK.Constraint.sides(es, k)), +hl: DR.Longs(~F, env, es, $NDS)) -> Empty:
  (v1, q1) = hr
  (v2, q2) = q1
  (k1, q3) = q2
  (k2, ac) = q3
  ang_k(~F, env, es, k, fst, az_of(~F, env, es, fs, dr, di, DR.angle_seg(k, fst), ac, kz(~F, $COA, dr, v1, k1, $LDR), kz(~F, $COA, di, v2, k2, $LDI)), hs)

# The conflict's direction refutation
# -----------------------------------

@MACRO CS Con{c, s}
@MACRO RF SV.rfacts(sk, $CS)
@MACRO SS SK.cats(SV.csides(sk, $CS), SV.esides(sk))
@MACRO RP +x: M.Vec(~F), +sk: SK.Sketch, +c: Nat, +s: $NL, +cx: $QL, +af: DP.AllFacts(~F, x, $ENT, $RF), +hss: SK.Sides(~F, x, $SS), +hcs: SK.Sides(~F, x, SV.csides(sk, $CS)), +had: {SV.all_driving(sk, $CS) == True{} : Bool}
@MACRO RA x, sk, c, s, cx, af, hss, hcs, had

def ang_m(~F: O.OField, $RP, +dr: DR.Der, +di: DR.Der, m: Maybe<&2, SK.Constraint>, +fst: Bool, ra: SV.RefAngle.at(sk, c, s, cx, dr, di, m, fst), +hks: KSides(~F, x, $ENT, m), +hl: DR.Longs(~F, x, $ENT, DR.ncat(DR.nd($ENT, $RF, dr), DR.nd($ENT, $RF, di)))) -> Empty:
  match m:
    case Some{+k}:
      ang_ref(~F, x, $ENT, $RF, cx, af, dr, di, k, fst, ra, hks, hl)
    case None{}:
      ra

def ang_p(~F: O.OField, $RP, +dr: DR.Der, +di: DR.Der, +p: Nat, +fst: Bool, ro: {SV.mem(p, $CS) == True{} : Bool} & SV.RefAngle.at(sk, c, s, cx, dr, di, SV.kind_at(sk, p), fst), +hl: DR.Longs(~F, x, $ENT, DR.ncat(DR.nd($ENT, $RF, dr), DR.nd($ENT, $RF, di)))) -> Empty:
  match ro:
    case (+hm, ra):
      ang_m(~F, $RA, dr, di, SV.kind_at(sk, p), fst, ra, sides_of(~F, x, sk, $CS, p, hm, drv_mem(sk, p, $CS, had, hm), hcs), hl)

def motz(~F: O.OField, $RP, +ds: List<&2, DR.Der>, +ls: List<&2, S.Q>, +ms: List<&2, S.Q>, +k: S.Q, hr: DR.AllValidK($ENT, $RF, cx, ds) & SV.Refutes0(DR.dconcls($ENT, $RF, ds), $SS, ls, ms, k), +hl: DR.Longs(~F, x, $ENT, DR.nds($ENT, $RF, ds))) -> Empty:
  (hv, hz) = hr
  VS.refute_at(~F, x, DR.dconcls($ENT, $RF, ds), $SS, SV.Ref{ls, ms, k}, CKP.ref_of(DR.dconcls($ENT, $RF, ds), $SS, ls, ms, k, hz), mz_zeros(~F, x, $ENT, $RF, cx, af, ds, hv, hl), hss)

# a direction refutation of c and s has no point where its nd is long
def ref_ok(~F: O.OField, $RP, r: DR.DRef, ro: SV.RefOk(sk, c, s, cx, r), +hl: DR.Longs(~F, x, $ENT, DR.ref.nd($ENT, $RF, r))) -> Empty:
  match r:
    case DR.RMotz{+ds, +ls, +ms, +k}:
      motz(~F, $RA, ds, ls, ms, k, ro, hl)
    case DR.RColl{+dr, +di, +sg}:
      coll(~F, x, $ENT, $RF, cx, af, dr, di, sg, ro, hl)
    case DR.RAngle{+dr, +di, +p, +fst}:
      ang_p(~F, $RA, dr, di, p, fst, ro, hl)

@MACRO AA SV.angle_args(sk, $CS)

def dref.r(~F: O.OField, $RP, +nd: $NL, +r: DR.DRef, q: SV.RefOk(sk, c, s, cx, r) & ({SV.sub(DR.ref.nd($ENT, $RF, r), SV.cat(nd, $AA)) == True{} : Bool} & {SV.sub(nd, DR.ref.nd($ENT, $RF, r)) == True{} : Bool}), +hl: DR.Longs(~F, x, $ENT, nd)) -> Empty:
  match q:
    case (ro, hn):
      (+hsub, hin) = hn
      ref_ok(~F, $RA, r, ro, DFC.longs_sub(~F, x, $ENT, DR.ref.nd($ENT, $RF, r), SV.cat(nd, $AA), hsub, longs_join(~F, x, $ENT, nd, $AA, hl, aa_longs(~F, x, sk, $CS, $CS, CFP.sub_refl($CS), had, hcs))))

def dref(~F: O.OField, $RP, +nd: $NL, h: SV.DirRefutes(sk, c, s, cx, nd), +hl: DR.Longs(~F, x, $ENT, nd)) -> Empty:
  match h:
    case (+r, q):
      dref.r(~F, $RA, nd, r, q, hl)

# The conflict law
# ----------------

# c, driving, and its support are all driving
def ad_cs(+sk: SK.Sketch, +c: Nat, +s: $NL, +hlt: {SV.lt(c, SV.ncons(sk)) == True{} : Bool}, +edr: {SV.driven(sk, c) == False{} : Bool}, +hads: {SV.all_driving(sk, s) == True{} : Bool}) -> {SV.all_driving(sk, $CS) == True{} : Bool}:
  %Equal.sym(Bool, SV.lt(c, SV.ncons(sk)), True{}, hlt) : {SV.band(SV.band(_, SV.bnot(SV.driven(sk, c))), SV.all_driving(sk, s)) == True{} : Bool}
  %Equal.sym(Bool, SV.driven(sk, c), False{}, edr) : {SV.band(SV.band(True{}, SV.bnot(_)), SV.all_driving(sk, s)) == True{} : Bool}
  %Equal.sym(Bool, SV.all_driving(sk, s), True{}, hads) : {SV.band(SV.band(True{}, SV.bnot(False{})), _) == True{} : Bool}
  {==}

# x meets c's and s's equations and sides: no direction refutation
def cl_dir(~F: O.OField, +x: M.Vec(~F), +sk: SK.Sketch, +c: Nat, +s: $NL, +cx: $QL, +nd: $NL, h: SV.DirRefutes(sk, c, s, cx, nd), +had: {SV.all_driving(sk, $CS) == True{} : Bool}, m: SK.Sketch.holds(~F, x, SV.only($CS, sk)), +hl: DR.Longs(~F, x, $ENT, nd)) -> Empty:
  match m:
    case (hz, hs):
      +hss = CF.sides_swap(~F, x, SV.esides(sk), SV.csides(sk, $CS), (%CF.only_sides(sk, $CS) : SK.Sides(~F, x, _)
        hs))
      dref(~F, x, sk, c, s, cx, rf_all(~F, x, sk, $CS, (%CF.only_eqs(sk, $CS) : SK.Zeros(~F, x, _)
        hz)), hss, MN.sides_l(~F, x, SV.csides(sk, $CS), SV.esides(sk), hss), had, nd, h, hl)

def cl_or(~F: O.OField, +x: M.Vec(~F), +sk: SK.Sketch, +c: Nat, +s: $NL, +cx: $QL, +nd: $NL, h: Or(SV.Ref0(sk, c, s) & {nd == Nil{} : $NL}, SV.DirRefutes(sk, c, s, cx, nd)), +had: {SV.all_driving(sk, $CS) == True{} : Bool}, m: SK.Sketch.holds(~F, x, SV.only($CS, sk)), +hl: DR.Longs(~F, x, $ENT, nd)) -> Empty:
  match h:
    case Inl{q}:
      (r0, hn) = q
      CF.cf_m(~F, x, sk, c, s, r0, m)
    case Inr{rd}:
      cl_dir(~F, x, sk, c, s, cx, nd, rd, had, m, hl)

def cl_ok(~F: O.OField, +x: M.Vec(~F), +sk: SK.Sketch, +red: $NL, +c: Nat, +s: $NL, +nd: $NL, h: DH.ConflictOk(sk, red, c, s, nd), +hlt: {SV.lt(c, SV.ncons(sk)) == True{} : Bool}, +edr: {SV.driven(sk, c) == False{} : Bool}, m: SK.Sketch.holds(~F, x, SV.only($CS, sk)), +hl: DR.Longs(~F, x, $ENT, nd)) -> Empty:
  (h1, h2) = h
  (hor, hmin) = h2
  cl_or(~F, x, sk, c, s, SV.ctx(sk, red, c), nd, hor, ad_cs(sk, c, s, hlt, edr, LI.band_l(SV.all_driving(sk, s), SV.none_in(s, red), LI.band_r(SV.below(s, c), SV.band(SV.all_driving(sk, s), SV.none_in(s, red)), LI.band_r(SV.distinct(s), SV.band(SV.below(s, c), SV.band(SV.all_driving(sk, s), SV.none_in(s, red))), h1)))), m, hl)

def cl_b(~F: O.OField, b: Bool, +x: M.Vec(~F), +sk: SK.Sketch, +cls: $CLS, +c: Nat, +s: $NL, +nd: $NL, +eb: {SV.driven(sk, c) == b : Bool}, +hlt: {SV.lt(c, SV.ncons(sk)) == True{} : Bool}, f: DH.Fate.pick(sk, cls, $R, $D, c, b, SV.Conflict{s, nd}), m: SK.Sketch.holds(~F, x, SV.only($CS, sk)), +hl: DR.Longs(~F, x, $ENT, nd)) -> Empty:
  match b:
    case True{}:
      f
    case False{}:
      cl_ok(~F, x, sk, $R, c, s, nd, f, hlt, eb, m, hl)

# c's fate, c a conflict
def cl_k(~F: O.OField, k: SV.Class, +x: M.Vec(~F), +sk: SK.Sketch, +cls: $CLS, +c: Nat, f: DH.Fate.pick(sk, cls, $R, $D, c, SV.driven(sk, c), k), hc: {SV.is_conflict(k) == True{} : Bool}, +hlt: {SV.lt(c, SV.ncons(sk)) == True{} : Bool},
  m: SK.Sketch.holds(~F, x, SV.only(Con{c, SV.support.of(k)}, sk)), +hl: DR.Longs(~F, x, $ENT, SV.conflict_nd.of(k))) -> Empty:
  match k:
    case SV.Kept{d}:
      KA.ft(hc)
    case SV.Amber{d, r}:
      KA.ft(hc)
    case SV.Over{j, s, w}:
      KA.ft(hc)
    case SV.Conflict{+s, +nd}:
      cl_b(~F, SV.driven(sk, c), x, sk, cls, c, s, nd, {==}, hlt, f, m, hl)

def cl_go(~F: O.OField, +x: M.Vec(~F), +sk: SK.Sketch, +cls: $CLS, +c: Nat, b: Bool, +e: {SV.lt(c, SV.ncons(sk)) == b : Bool}, H: DH.Honest(sk, cls), hc: {SV.is_conflict(SV.class_at(cls, c)) == True{} : Bool},
  m: SK.Sketch.holds(~F, x, SV.only(Con{c, SV.support(cls, c)}, sk)), hl: DR.Longs(~F, x, $ENT, SV.conflict_nd(cls, c))) -> Empty:
  match b:
    case True{}:
      +hk = Equal.trans(Bool, KA.natle(1n+c, SV.ncons(sk)), SV.lt(c, SV.ncons(sk)), True{}, Equal.sym(Bool, SV.lt(c, SV.ncons(sk)), KA.natle(1n+c, SV.ncons(sk)), LI.lt_sv(c, SV.ncons(sk))), e)
      cl_k(~F, SV.class_at(cls, c), x, sk, cls, c, (%Equal.sym(Nat, c, Nat.add(c, 0n), LN.add_zero(c)) : DH.Fate(sk, cls, _)
        fate_at(sk, cls, SV.ncons(sk), 0n, c, hon_go(sk, cls, H), hk)), hc, e, m, hl)
    case False{}:
      CF.cf_past(cls, c, (%Equal.sym(Nat, SV.clsn(cls), SV.ncons(sk), hon_len(sk, cls, H)) : {SV.lt(c, _) == False{} : Bool}
        e), hc)

# THE DRAFT LAW (solve_conflict over the extended Honest): in every
# ordered field, a conflicting constraint and its support cannot all hold
# where the conflict's nd segments have nonzero length
def conflict_law(~F: O.OField, +sk: SK.Sketch, +cls: $CLS, h: DH.Honest(sk, cls), +c: Nat, hc: {SV.is_conflict(SV.class_at(cls, c)) == True{} : Bool}, +x: M.Vec(~F), m: SK.Sketch.means(~F, x, SV.only(Con{c, SV.support(cls, c)}, sk)), hl: DR.Longs(~F, x, $ENT, SV.conflict_nd(cls, c))) -> Empty:
  cl_go(~F, x, sk, cls, c, SV.lt(c, SV.ncons(sk)), {==}, h, hc, MN.sketch_complete(~F, x, SV.only(Con{c, SV.support(cls, c)}, sk), m), hl)
