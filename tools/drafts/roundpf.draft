def dsu_h2(~F: O.OField, +m: S.Z, +e: Nat, +k: Nat, h: zfl(~F, S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e), NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e)))) -> O.le(~F, @A(@N(@M(O.ofz(~F, m), t2(~F, k))), @1), @M(@A(O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e))), @1), t2(~F, e))):
  %nm_eq(~F, m, k) : O.le(~F, @A(_, @1), @M(@A(O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e))), @1), t2(~F, e)))
  zfl_2(~F, S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e), NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e)), h)

def dsu_fin(~F: O.OField, +m: S.Z, +p: S.Pos, +e: Nat, +b: Nat, ea: {O.ofz(~F, M.zabs(m)) == O.ofp(~F, p) : @T}, +cc: M.Both(O.le(~F, @M(O.ofz(~F, m), O.inv(F, t2(~F, e))), @M(@N(O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))})), S.Pos.pow2(e)))), O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))))), O.le(~F, @S(@M(@N(O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))})), S.Pos.pow2(e)))), O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))))), @M(O.ofz(~F, m), O.inv(F, t2(~F, e)))), @M(@1, O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))))))) -> M.Both(O.le(~F, M.ofd(~F, S.D{m, e}), M.ofd(~F, NU.qceil(S.Q{m, S.Pos.pow2(e)}, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))))), O.le(~F, @S(M.ofd(~F, NU.qceil(S.Q{m, S.Pos.pow2(e)}, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))), M.ofd(~F, S.D{m, e})), @M(M.ofd(~F, S.D{M.zabs(m), e}), M.ofd(~F, S.D{S.Zpos{S.XO{S.XH{}}}, b})))):
  ((%FR.ofz_neg(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))})), S.Pos.pow2(e))) : O.le(~F, @M(O.ofz(~F, m), O.inv(F, t2(~F, e))), @M(_, O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))))))
     qc_1(~F, O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))})), S.Pos.pow2(e))), O.ofz(~F, m), O.inv(F, t2(~F, e)), O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))), cc)),
   (%FR.ofz_neg(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))})), S.Pos.pow2(e))) : O.le(~F, @S(@M(_, O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))))), @M(O.ofz(~F, m), O.inv(F, t2(~F, e)))), @M(@M(O.ofz(~F, M.zabs(m)), O.inv(F, t2(~F, e))), @M(@A(@1, @1), O.inv(F, t2(~F, b)))))
     DM.le_trans(~F, @S(@M(@N(O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))})), S.Pos.pow2(e)))), O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))))), @M(O.ofz(~F, m), O.inv(F, t2(~F, e)))), @M(@1, O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))))), @M(@M(O.ofz(~F, M.zabs(m)), O.inv(F, t2(~F, e))), @M(@A(@1, @1), O.inv(F, t2(~F, b)))),
       qc_2(~F, O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))})), S.Pos.pow2(e))), O.ofz(~F, m), O.inv(F, t2(~F, e)), O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))), cc),
       (%Equal.sym(@T, O.ofz(~F, M.zabs(m)), O.ofp(~F, p), ea) : O.le(~F, @M(@1, O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))))), @M(@M(_, O.inv(F, t2(~F, e))), @M(@A(@1, @1), O.inv(F, t2(~F, b)))))
         dur(~F, p, e, b)))))

# m nonzero with |m| = p
def dsu_go(~F: O.OField, +m: S.Z, +p: S.Pos, +e: Nat, +b: Nat, ea: {O.ofz(~F, M.zabs(m)) == O.ofp(~F, p) : @T}) -> M.Both(O.le(~F, M.ofd(~F, S.D{m, e}), M.ofd(~F, NU.qceil(S.Q{m, S.Pos.pow2(e)}, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))))), O.le(~F, @S(M.ofd(~F, NU.qceil(S.Q{m, S.Pos.pow2(e)}, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))), M.ofd(~F, S.D{m, e})), @M(M.ofd(~F, S.D{M.zabs(m), e}), M.ofd(~F, S.D{S.Zpos{S.XO{S.XH{}}}, b})))):
  +h = zfloor_ok(~F, S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))})), S.Pos.pow2(e))
  +cc = qc_core(~F, O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))})), S.Pos.pow2(e))), O.ofz(~F, m), t2(~F, e), t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))), O.inv(F, t2(~F, e)), O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))),
    dsu_h1(~F, m, e, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)), h), dsu_h2(~F, m, e, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)), h),
    QE.ofp_rel(~F, S.Pos.pow2(e)), QE.ofp_rel(~F, S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))), inv_nn(~F, S.Pos.pow2(e)), inv_nn(~F, S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))))
  dsu_fin(~F, m, p, e, b, ea, cc)

# x <= dsigup(x, b) <= x + |x| 2^(1-b)
def dsigup_ok(~F: O.OField, x: S.D, +b: Nat) -> M.Both(O.le(~F, M.ofd(~F, x), M.ofd(~F, NU.dsigup(x, b))), O.le(~F, @S(M.ofd(~F, NU.dsigup(x, b)), M.ofd(~F, x)), @M(M.ofd(~F, M.dabs(x)), M.ofd(~F, S.D{S.Zpos{S.XO{S.XH{}}}, b})))):
  match x:
    case S.D{S.Z0{}, +e}:
      (Inr{@ZEQ[x=O.inv(F, t2(~F, e)),, y=O.inv(F, @1) | 0*x | 0*y]},
       FV.le_of_sub(~F, @S(@M(@0, O.inv(F, @1)), @M(@0, O.inv(F, t2(~F, e)))), @M(@M(@0, O.inv(F, t2(~F, e))), @M(@A(@1, @1), O.inv(F, t2(~F, b)))), FM.nn_eq(~F, @S(@M(@M(@0, O.inv(F, t2(~F, e))), @M(@A(@1, @1), O.inv(F, t2(~F, b)))), @S(@M(@0, O.inv(F, @1)), @M(@0, O.inv(F, t2(~F, e))))), @0, @ZEQ[x=O.inv(F, t2(~F, e)),, y=O.inv(F, @1),, z=O.inv(F, t2(~F, b)) | 0 | (0*x)*((1 + 1)*z) - (0*y - 0*x)], FO.le_refl(~F, @0))))
    case S.D{S.Zpos{+p}, +e}:
      dsu_go(~F, S.Zpos{p}, p, e, b, {==})
    case S.D{S.Zneg{+p}, +e}:
      dsu_go(~F, S.Zneg{p}, p, e, b, {==})
