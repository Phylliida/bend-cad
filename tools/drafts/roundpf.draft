# bend-cad: rounding, for solve_complete (DESIGN §10.4, C3b). Proofs only.
#
# What the solver's rounding (lib/numer.bend) does to a number's value in
# every ordered field F. Underneath: Euclid's division (QRD.div, which
# lib/qreduce.bend leaves unproven because reduce checks its answer) gives
# n = q d + r with 0 <= r < d, so zfloor is a floor; pshr is a floor by
# 2^k; and size p is p's binary length, 2^(size p) <= 2p and
# p < 2^(size p). Then:
#   dround_err: |dround(x, p) - x| <= 2^-(p+1)
#   dsig_err:   |dsig(x, b) - x| <= |x| 2^-b
#   qsig_err:   |qsig(q, b) - q| <= |q| 2^-b
#   dsigup_ok:  x <= dsigup(x, b) <= x + |x| 2^-b
# Integers live in F through ofz and ofp: an integer fact a < b becomes
# a + 1 <= b there, so floors are stated as f d <= n and n + 1 <= (f + 1) d.

import Base
import ../spec/num.bend as S
import ../spec/ring.bend as E
import ../spec/field.bend as O
import ../spec/mat.bend as M
import ./zord.bend as ZO
import ./qreduce.bend as QRD
import ./numer.bend as NU
import ./karith.bend as KA
import ./dyadic.bend as DY
import ./flaws.bend as FL
import ./fring.bend as FR
import ./ford.bend as FO
import ./fmat.bend as FM
import ./fvec.bend as FV
import ./qemb.bend as QE
import ./kball.bend as KB
import ./dmat.bend as DM
import ./nat.bend as LN

# Order helpers
# -------------

# a <= b gives a + a <= b + b
def le_dbl(~F: O.OField, +a: @T, +b: @T, +h: O.le(~F, a, b)) -> O.le(~F, @A(a, a), @A(b, b)):
  FV.le_add2(~F, a, b, a, b, h, h)

# Positive integers in F
# ----------------------

# 2^k in F
def t2(~F: O.OField, k: Nat) -> @T:
  O.ofp(~F, S.Pos.pow2(k))

def ofp_ge1(~F: O.OField, p: S.Pos) -> O.le(~F, @1, O.ofp(~F, p)):
  match p:
    case S.XH{}:
      FO.le_refl(~F, @1)
    case S.XO{+q}:
      +s = FM.sub_nonneg(~F, @1, O.ofp(~F, q), ofp_ge1(~F, q))
      FV.le_of_sub(~F, @1, O.ofp(~F, S.XO{q}), FM.nn_eq(~F, @S(O.ofp(~F, S.XO{q}), @1), @A(@A(@S(O.ofp(~F, q), @1), @S(O.ofp(~F, q), @1)), @1), @ZEQ[p=O.ofp(~F, q) | ((p - 1) + (p - 1)) + 1 | (p + p) - 1], FO.nonneg_add(~F, @A(@S(O.ofp(~F, q), @1), @S(O.ofp(~F, q), @1)), @1, FO.nonneg_add(~F, @S(O.ofp(~F, q), @1), @S(O.ofp(~F, q), @1), s, s), FO.one_nn(~F))))
    case S.XI{+q}:
      +s = FM.sub_nonneg(~F, @1, O.ofp(~F, q), ofp_ge1(~F, q))
      FV.le_of_sub(~F, @1, O.ofp(~F, S.XI{q}), FM.nn_eq(~F, @S(O.ofp(~F, S.XI{q}), @1), @A(@A(@S(O.ofp(~F, q), @1), @S(O.ofp(~F, q), @1)), @A(@1, @1)), @ZEQ[p=O.ofp(~F, q) | ((p - 1) + (p - 1)) + (1 + 1) | ((p + p) + 1) - 1], FO.nonneg_add(~F, @A(@S(O.ofp(~F, q), @1), @S(O.ofp(~F, q), @1)), @A(@1, @1), FO.nonneg_add(~F, @S(O.ofp(~F, q), @1), @S(O.ofp(~F, q), @1), s, s), FO.nonneg_add(~F, @1, @1, FO.one_nn(~F), FO.one_nn(~F)))))

def ofp_nn(~F: O.OField, +p: S.Pos) -> O.le(~F, @0, O.ofp(~F, p)):
  FO.lt_le(~F, @0, O.ofp(~F, p), QE.ofp_pos(~F, p))

# 2^a 2^b = 2^(a + b)
def t2_add(~F: O.OField, +a: Nat, +b: Nat) -> {@M(t2(~F, a), t2(~F, b)) == t2(~F, Nat.add(a, b)) : @T}:
  Equal.trans(@T, @M(t2(~F, a), t2(~F, b)), O.ofp(~F, S.Pos.mul(S.Pos.pow2(a), S.Pos.pow2(b))), t2(~F, Nat.add(a, b)), FR.ofz_mul(~F, S.Zpos{S.Pos.pow2(a)}, S.Zpos{S.Pos.pow2(b)}), Equal.cong(S.Pos, @T, q => O.ofp(~F, q), S.Pos.mul(S.Pos.pow2(a), S.Pos.pow2(b)), S.Pos.pow2(Nat.add(a, b)), DY.pow2_add(a, b)))

# p + q in F
def ofp_add(~F: O.OField, +a: S.Pos, +b: S.Pos) -> {@A(O.ofp(~F, a), O.ofp(~F, b)) == O.ofp(~F, S.Pos.add(a, b)) : @T}:
  FR.ofz_add(~F, S.Zpos{a}, S.Zpos{b})

# 2^(size p) <= 2 p
def size_lo(~F: O.OField, p: S.Pos) -> O.le(~F, t2(~F, QRD.size(p)), @A(O.ofp(~F, p), O.ofp(~F, p))):
  match p:
    case S.XH{}:
      FO.le_refl(~F, @A(@1, @1))
    case S.XO{+q}:
      le_dbl(~F, t2(~F, QRD.size(q)), O.ofp(~F, S.XO{q}), size_lo(~F, q))
    case S.XI{+q}:
      le_dbl(~F, t2(~F, QRD.size(q)), O.ofp(~F, S.XI{q}), FV.le_of_sub(~F, t2(~F, QRD.size(q)), O.ofp(~F, S.XI{q}), FM.nn_eq(~F, @S(O.ofp(~F, S.XI{q}), t2(~F, QRD.size(q))), @A(@S(@A(O.ofp(~F, q), O.ofp(~F, q)), t2(~F, QRD.size(q))), @1), @ZEQ[p=O.ofp(~F, q),, t=t2(~F, QRD.size(q)) | ((p + p) - t) + 1 | ((p + p) + 1) - t], FO.nonneg_add(~F, @S(@A(O.ofp(~F, q), O.ofp(~F, q)), t2(~F, QRD.size(q))), @1, FM.sub_nonneg(~F, t2(~F, QRD.size(q)), @A(O.ofp(~F, q), O.ofp(~F, q)), size_lo(~F, q)), FO.one_nn(~F)))))

# p + 1 <= 2^(size p)
def size_hi(~F: O.OField, p: S.Pos) -> O.le(~F, @A(O.ofp(~F, p), @1), t2(~F, QRD.size(p))):
  match p:
    case S.XH{}:
      FO.le_refl(~F, @A(@1, @1))
    case S.XO{+q}:
      FV.le_of_sub(~F, @A(O.ofp(~F, S.XO{q}), @1), t2(~F, QRD.size(S.XO{q})), FM.nn_eq(~F, @S(t2(~F, QRD.size(S.XO{q})), @A(O.ofp(~F, S.XO{q}), @1)), @A(@S(@A(t2(~F, QRD.size(q)), t2(~F, QRD.size(q))), @A(@A(O.ofp(~F, q), @1), @A(O.ofp(~F, q), @1))), @1), @ZEQ[p=O.ofp(~F, q),, t=t2(~F, QRD.size(q)) | ((t + t) - ((p + 1) + (p + 1))) + 1 | (t + t) - ((p + p) + 1)], FO.nonneg_add(~F, @S(@A(t2(~F, QRD.size(q)), t2(~F, QRD.size(q))), @A(@A(O.ofp(~F, q), @1), @A(O.ofp(~F, q), @1))), @1, FM.sub_nonneg(~F, @A(@A(O.ofp(~F, q), @1), @A(O.ofp(~F, q), @1)), @A(t2(~F, QRD.size(q)), t2(~F, QRD.size(q))), le_dbl(~F, @A(O.ofp(~F, q), @1), t2(~F, QRD.size(q)), size_hi(~F, q))), FO.one_nn(~F))))
    case S.XI{+q}:
      FV.le_of_sub(~F, @A(O.ofp(~F, S.XI{q}), @1), t2(~F, QRD.size(S.XI{q})), FM.nn_eq(~F, @S(t2(~F, QRD.size(S.XI{q})), @A(O.ofp(~F, S.XI{q}), @1)), @S(@A(t2(~F, QRD.size(q)), t2(~F, QRD.size(q))), @A(@A(O.ofp(~F, q), @1), @A(O.ofp(~F, q), @1))), @ZEQ[p=O.ofp(~F, q),, t=t2(~F, QRD.size(q)) | (t + t) - ((p + 1) + (p + 1)) | (t + t) - (((p + p) + 1) + 1)], FM.sub_nonneg(~F, @A(@A(O.ofp(~F, q), @1), @A(O.ofp(~F, q), @1)), @A(t2(~F, QRD.size(q)), t2(~F, QRD.size(q))), le_dbl(~F, @A(O.ofp(~F, q), @1), t2(~F, QRD.size(q)), size_hi(~F, q)))))

# Integers in F
# -------------

# a positive integer is at least 1
def pos_ge1(~F: O.OField, s: S.Z, h: ZO.pos(s)) -> O.le(~F, @1, O.ofz(~F, s)):
  match s:
    case S.Z0{}:
      FO.absurd(O.le(~F, @1, @0), h)
    case S.Zpos{p}:
      ofp_ge1(~F, p)
    case S.Zneg{p}:
      FO.absurd(O.le(~F, @1, @N(O.ofp(~F, p))), h)

def ofz_sub(~F: O.OField, +a: S.Z, +b: S.Z) -> {@S(O.ofz(~F, b), O.ofz(~F, a)) == O.ofz(~F, S.Z.sub(b, a)) : @T}:
  %FR.ofz_add(~F, b, S.Z.neg(a)) : {@S(O.ofz(~F, b), O.ofz(~F, a)) == _ : @T}
  %FR.ofz_neg(~F, a) : {@S(O.ofz(~F, b), O.ofz(~F, a)) == @A(O.ofz(~F, b), _) : @T}
  {==}

# a + 1 <= b gives a <= b
def le_of_succ(~F: O.OField, +a: @T, +b: @T, h: O.le(~F, @A(a, @1), b)) -> O.le(~F, a, b):
  FV.le_of_sub(~F, a, b, FM.nn_eq(~F, @S(b, a), @A(@S(b, @A(a, @1)), @1), @ZEQ[a,, b | (b - (a + 1)) + 1 | b - a], FO.nonneg_add(~F, @S(b, @A(a, @1)), @1, FM.sub_nonneg(~F, @A(a, @1), b, h), FO.one_nn(~F))))

# a < b in Z: a + 1 <= b in F
def zlt(~F: O.OField, +a: S.Z, +b: S.Z, h: {S.Z.cmp(a, b) == LT{} : Cmp}) -> O.le(~F, @A(O.ofz(~F, a), @1), O.ofz(~F, b)):
  FV.le_of_sub(~F, @A(O.ofz(~F, a), @1), O.ofz(~F, b), FM.nn_eq(~F, @S(O.ofz(~F, b), @A(O.ofz(~F, a), @1)), @S(@S(O.ofz(~F, b), O.ofz(~F, a)), @1), @ZEQ[x=O.ofz(~F, a),, y=O.ofz(~F, b) | (y - x) - 1 | y - (x + 1)], FM.sub_nonneg(~F, @1, @S(O.ofz(~F, b), O.ofz(~F, a)), (%Equal.sym(@T, @S(O.ofz(~F, b), O.ofz(~F, a)), O.ofz(~F, S.Z.sub(b, a)), ofz_sub(~F, a, b)) : O.le(~F, @1, _)
    pos_ge1(~F, S.Z.sub(b, a), ZO.lt_pos(a, b, h))))))

# a = b in Z
def zeq(~F: O.OField, +a: S.Z, +b: S.Z, h: {S.Z.cmp(a, b) == EQ{} : Cmp}) -> {O.ofz(~F, b) == O.ofz(~F, a) : @T}:
  FO.eq_of_sub(~F, O.ofz(~F, b), O.ofz(~F, a), Equal.trans(@T, @S(O.ofz(~F, b), O.ofz(~F, a)), O.ofz(~F, S.Z.sub(b, a)), @0, ofz_sub(~F, a, b), Equal.cong(S.Z, @T, z => O.ofz(~F, z), S.Z.sub(b, a), S.Z0{}, ZO.eq_zero(a, b, h))))

def zgt_eq(~F: O.OField, +a: S.Z, +b: S.Z) -> {@S(O.ofz(~F, S.Z.neg(S.Z.sub(b, a))), @1) == @S(O.ofz(~F, a), @A(O.ofz(~F, b), @1)) : @T}:
  %FR.ofz_neg(~F, S.Z.sub(b, a)) : {@S(_, @1) == @S(O.ofz(~F, a), @A(O.ofz(~F, b), @1)) : @T}
  %ofz_sub(~F, a, b) : {@S(@N(_), @1) == @S(O.ofz(~F, a), @A(O.ofz(~F, b), @1)) : @T}
  @ZEQ[x=O.ofz(~F, a),, y=O.ofz(~F, b) | (-(y - x)) - 1 | x - (y + 1)]

# a > b in Z: b + 1 <= a in F
def zgt(~F: O.OField, +a: S.Z, +b: S.Z, h: {S.Z.cmp(a, b) == GT{} : Cmp}) -> O.le(~F, @A(O.ofz(~F, b), @1), O.ofz(~F, a)):
  FV.le_of_sub(~F, @A(O.ofz(~F, b), @1), O.ofz(~F, a), FM.nn_eq(~F, @S(O.ofz(~F, a), @A(O.ofz(~F, b), @1)), @S(O.ofz(~F, S.Z.neg(S.Z.sub(b, a))), @1), zgt_eq(~F, a, b), FM.sub_nonneg(~F, @1, O.ofz(~F, S.Z.neg(S.Z.sub(b, a))), pos_ge1(~F, S.Z.neg(S.Z.sub(b, a)), ZO.gt_pos(a, b, h)))))

def ofz_double(~F: O.OField, x: S.Z) -> {O.ofz(~F, S.Z.double(x)) == @A(O.ofz(~F, x), O.ofz(~F, x)) : @T}:
  match x:
    case S.Z0{}:
      Equal.sym(@T, @A(@0, @0), @0, O.add_zero(F)(@0))
    case S.Zpos{p}:
      {==}
    case S.Zneg{+p}:
      Equal.sym(@T, @A(@N(O.ofp(~F, p)), @N(O.ofp(~F, p))), @N(@A(O.ofp(~F, p), O.ofp(~F, p))), FL.neg_add(~F, O.ofp(~F, p), O.ofp(~F, p)))

def pd_ok(~F: O.OField, p: S.Pos) -> {@A(O.ofp(~F, S.Pos.pred_double(p)), @1) == @A(O.ofp(~F, p), O.ofp(~F, p)) : @T}:
  match p:
    case S.XH{}:
      {==}
    case S.XO{+q}:
      @CERTEQ[d=O.ofp(~F, S.Pos.pred_double(q)),, q=O.ofp(~F, q) | ((d + d) + 1) + 1 | (q + q) + (q + q) | 1 + 1 ; (d + 1) - (q + q) || FO.sub_of_eq(~F, @A(O.ofp(~F, S.Pos.pred_double(q)), @1), @A(O.ofp(~F, q), O.ofp(~F, q)), pd_ok(~F, q))]
    case S.XI{+q}:
      @ZEQ[q=O.ofp(~F, q) | (((q + q) + (q + q)) + 1) + 1 | ((q + q) + 1) + ((q + q) + 1)]

def ofz_sdouble(~F: O.OField, x: S.Z) -> {O.ofz(~F, S.Z.succ_double(x)) == @A(@A(O.ofz(~F, x), O.ofz(~F, x)), @1) : @T}:
  match x:
    case S.Z0{}:
      @ZEQ[a=@0 | 1 | (0 + 0) + 1]
    case S.Zpos{p}:
      {==}
    case S.Zneg{+p}:
      @CERTEQ[d=O.ofp(~F, S.Pos.pred_double(p)),, p=O.ofp(~F, p) | -d | ((-p) + (-p)) + 1 | -1 ; (d + 1) - (p + p) || FO.sub_of_eq(~F, @A(O.ofp(~F, S.Pos.pred_double(p)), @1), @A(O.ofp(~F, p), O.ofp(~F, p)), pd_ok(~F, p))]

# Euclid's division
# -----------------

# n = q d + r with 0 <= r < d (read through the projections, so that it
# applies to a division not yet computed)
def dvok(~F: O.OField, +n: S.Pos, +d: S.Pos, +v: QRD.Dv) -> Data:
  M.Both({O.ofp(~F, n) == @A(@M(O.ofz(~F, QRD.Dv.q(v)), O.ofp(~F, d)), O.ofz(~F, QRD.Dv.r(v))) : @T}, M.Both(O.le(~F, @0, O.ofz(~F, QRD.Dv.r(v))), O.le(~F, @A(O.ofz(~F, QRD.Dv.r(v)), @1), O.ofp(~F, d))))

def dv_mk(~F: O.OField, +n: S.Pos, +d: S.Pos, +v: QRD.Dv, he: {O.ofp(~F, n) == @A(@M(O.ofz(~F, QRD.Dv.q(v)), O.ofp(~F, d)), O.ofz(~F, QRD.Dv.r(v))) : @T}, h0: O.le(~F, @0, O.ofz(~F, QRD.Dv.r(v))), h1: O.le(~F, @A(O.ofz(~F, QRD.Dv.r(v)), @1), O.ofp(~F, d))) -> dvok(~F, n, d, v):
  (he, (h0, h1))

def dv_e(~F: O.OField, +n: S.Pos, +d: S.Pos, +v: QRD.Dv, h: dvok(~F, n, d, v)) -> {O.ofp(~F, n) == @A(@M(O.ofz(~F, QRD.Dv.q(v)), O.ofp(~F, d)), O.ofz(~F, QRD.Dv.r(v))) : @T}:
  (a, b) = h
  a

def dv_b(~F: O.OField, +n: S.Pos, +d: S.Pos, +v: QRD.Dv, h: dvok(~F, n, d, v)) -> M.Both(O.le(~F, @0, O.ofz(~F, QRD.Dv.r(v))), O.le(~F, @A(O.ofz(~F, QRD.Dv.r(v)), @1), O.ofp(~F, d))):
  (a, b) = h
  b

def dv_0.go(~F: O.OField, +d: S.Pos, +r: S.Z, h: M.Both(O.le(~F, @0, O.ofz(~F, r)), O.le(~F, @A(O.ofz(~F, r), @1), O.ofp(~F, d)))) -> O.le(~F, @0, O.ofz(~F, r)):
  (a, b) = h
  a

def dv_1.go(~F: O.OField, +d: S.Pos, +r: S.Z, h: M.Both(O.le(~F, @0, O.ofz(~F, r)), O.le(~F, @A(O.ofz(~F, r), @1), O.ofp(~F, d)))) -> O.le(~F, @A(O.ofz(~F, r), @1), O.ofp(~F, d)):
  (a, b) = h
  b

def dv_0(~F: O.OField, +n: S.Pos, +d: S.Pos, +v: QRD.Dv, h: dvok(~F, n, d, v)) -> O.le(~F, @0, O.ofz(~F, QRD.Dv.r(v))):
  dv_0.go(~F, d, QRD.Dv.r(v), dv_b(~F, n, d, v, h))

def dv_1(~F: O.OField, +n: S.Pos, +d: S.Pos, +v: QRD.Dv, h: dvok(~F, n, d, v)) -> O.le(~F, @A(O.ofz(~F, QRD.Dv.r(v)), @1), O.ofp(~F, d)):
  dv_1.go(~F, d, QRD.Dv.r(v), dv_b(~F, n, d, v, h))

def adj_e(~F: O.OField, +n: S.Pos, +q2: S.Z, +r2: S.Z, +d: S.Pos, he: {O.ofp(~F, n) == @A(@M(O.ofz(~F, q2), O.ofp(~F, d)), O.ofz(~F, r2)) : @T}) -> {O.ofp(~F, n) == @A(@M(O.ofz(~F, S.Z.add(q2, S.Zpos{S.XH{}})), O.ofp(~F, d)), O.ofz(~F, S.Z.sub(r2, S.Zpos{d}))) : @T}:
  %FR.ofz_add(~F, q2, S.Zpos{S.XH{}}) : {O.ofp(~F, n) == @A(@M(_, O.ofp(~F, d)), O.ofz(~F, S.Z.sub(r2, S.Zpos{d}))) : @T}
  %ofz_sub(~F, S.Zpos{d}, r2) : {O.ofp(~F, n) == @A(@M(@A(O.ofz(~F, q2), @1), O.ofp(~F, d)), _) : @T}
  @CERTEQ[n=O.ofp(~F, n),, q=O.ofz(~F, q2),, r=O.ofz(~F, r2),, d=O.ofp(~F, d) | n | (q + 1)*d + (r - d) | 1 ; n - (q*d + r) || FO.sub_of_eq(~F, O.ofp(~F, n), @A(@M(O.ofz(~F, q2), O.ofp(~F, d)), O.ofz(~F, r2)), he)]

# r2 >= d: subtract d once
def adj_ge(~F: O.OField, +n: S.Pos, +q2: S.Z, +r2: S.Z, +d: S.Pos, he: {O.ofp(~F, n) == @A(@M(O.ofz(~F, q2), O.ofp(~F, d)), O.ofz(~F, r2)) : @T}, +hge: O.le(~F, O.ofp(~F, d), O.ofz(~F, r2)), h2: O.le(~F, @A(O.ofz(~F, r2), @1), @A(O.ofp(~F, d), O.ofp(~F, d)))) -> dvok(~F, n, d, QRD.Dv{S.Z.add(q2, S.Zpos{S.XH{}}), S.Z.sub(r2, S.Zpos{d})}):
  dv_mk(~F, n, d, QRD.Dv{S.Z.add(q2, S.Zpos{S.XH{}}), S.Z.sub(r2, S.Zpos{d})}, adj_e(~F, n, q2, r2, d, he),
    (%ofz_sub(~F, S.Zpos{d}, r2) : O.le(~F, @0, _)
      FM.sub_nonneg(~F, O.ofp(~F, d), O.ofz(~F, r2), hge)),
    (%ofz_sub(~F, S.Zpos{d}, r2) : O.le(~F, @A(_, @1), O.ofp(~F, d))
      FV.le_of_sub(~F, @A(@S(O.ofz(~F, r2), O.ofp(~F, d)), @1), O.ofp(~F, d), FM.nn_eq(~F, @S(O.ofp(~F, d), @A(@S(O.ofz(~F, r2), O.ofp(~F, d)), @1)), @S(@A(O.ofp(~F, d), O.ofp(~F, d)), @A(O.ofz(~F, r2), @1)), @ZEQ[r=O.ofz(~F, r2),, d=O.ofp(~F, d) | (d + d) - (r + 1) | d - ((r - d) + 1)], FM.sub_nonneg(~F, @A(O.ofz(~F, r2), @1), @A(O.ofp(~F, d), O.ofp(~F, d)), h2)))))

def adj_ok(~F: O.OField, c: Cmp, +n: S.Pos, +q2: S.Z, +r2: S.Z, +d: S.Pos, e: {S.Z.cmp(r2, S.Zpos{d}) == c : Cmp}, he: {O.ofp(~F, n) == @A(@M(O.ofz(~F, q2), O.ofp(~F, d)), O.ofz(~F, r2)) : @T}, h0: O.le(~F, @0, O.ofz(~F, r2)), h2: O.le(~F, @A(O.ofz(~F, r2), @1), @A(O.ofp(~F, d), O.ofp(~F, d)))) -> dvok(~F, n, d, QRD.div.adj(c, q2, r2, d)):
  match c:
    case LT{}:
      dv_mk(~F, n, d, QRD.Dv{q2, r2}, he, h0, zlt(~F, r2, S.Zpos{d}, e))
    case EQ{}:
      adj_ge(~F, n, q2, r2, d, he, Inr{zeq(~F, r2, S.Zpos{d}, e)}, h2)
    case GT{}:
      adj_ge(~F, n, q2, r2, d, he, le_of_succ(~F, O.ofp(~F, d), O.ofz(~F, r2), zgt(~F, r2, S.Zpos{d}, e)), h2)

def step_e0(~F: O.OField, +m: S.Pos, +d: S.Pos, +q: S.Z, +r: S.Z, he: {O.ofp(~F, m) == @A(@M(O.ofz(~F, q), O.ofp(~F, d)), O.ofz(~F, r)) : @T}) -> {O.ofp(~F, S.XO{m}) == @A(@M(O.ofz(~F, S.Z.double(q)), O.ofp(~F, d)), O.ofz(~F, S.Z.double(r))) : @T}:
  %Equal.sym(@T, O.ofz(~F, S.Z.double(q)), @A(O.ofz(~F, q), O.ofz(~F, q)), ofz_double(~F, q)) : {O.ofp(~F, S.XO{m}) == @A(@M(_, O.ofp(~F, d)), O.ofz(~F, S.Z.double(r))) : @T}
  %Equal.sym(@T, O.ofz(~F, S.Z.double(r)), @A(O.ofz(~F, r), O.ofz(~F, r)), ofz_double(~F, r)) : {O.ofp(~F, S.XO{m}) == @A(@M(@A(O.ofz(~F, q), O.ofz(~F, q)), O.ofp(~F, d)), _) : @T}
  @CERTEQ[m=O.ofp(~F, m),, q=O.ofz(~F, q),, r=O.ofz(~F, r),, d=O.ofp(~F, d) | m + m | (q + q)*d + (r + r) | 1 + 1 ; m - (q*d + r) || FO.sub_of_eq(~F, O.ofp(~F, m), @A(@M(O.ofz(~F, q), O.ofp(~F, d)), O.ofz(~F, r)), he)]

def step_e1(~F: O.OField, +m: S.Pos, +d: S.Pos, +q: S.Z, +r: S.Z, he: {O.ofp(~F, m) == @A(@M(O.ofz(~F, q), O.ofp(~F, d)), O.ofz(~F, r)) : @T}) -> {O.ofp(~F, S.XI{m}) == @A(@M(O.ofz(~F, S.Z.double(q)), O.ofp(~F, d)), O.ofz(~F, S.Z.succ_double(r))) : @T}:
  %Equal.sym(@T, O.ofz(~F, S.Z.double(q)), @A(O.ofz(~F, q), O.ofz(~F, q)), ofz_double(~F, q)) : {O.ofp(~F, S.XI{m}) == @A(@M(_, O.ofp(~F, d)), O.ofz(~F, S.Z.succ_double(r))) : @T}
  %Equal.sym(@T, O.ofz(~F, S.Z.succ_double(r)), @A(@A(O.ofz(~F, r), O.ofz(~F, r)), @1), ofz_sdouble(~F, r)) : {O.ofp(~F, S.XI{m}) == @A(@M(@A(O.ofz(~F, q), O.ofz(~F, q)), O.ofp(~F, d)), _) : @T}
  @CERTEQ[m=O.ofp(~F, m),, q=O.ofz(~F, q),, r=O.ofz(~F, r),, d=O.ofp(~F, d) | (m + m) + 1 | (q + q)*d + ((r + r) + 1) | 1 + 1 ; m - (q*d + r) || FO.sub_of_eq(~F, O.ofp(~F, m), @A(@M(O.ofz(~F, q), O.ofp(~F, d)), O.ofz(~F, r)), he)]

def step0.go(~F: O.OField, +m: S.Pos, +d: S.Pos, +q: S.Z, +r: S.Z, +h: dvok(~F, m, d, QRD.Dv{q, r})) -> dvok(~F, S.XO{m}, d, QRD.div.step(d, False{}, QRD.Dv{q, r})):
  +h0 = dv_0(~F, m, d, QRD.Dv{q, r}, h)
  +s = FM.sub_nonneg(~F, @A(O.ofz(~F, r), @1), O.ofp(~F, d), dv_1(~F, m, d, QRD.Dv{q, r}, h))
  adj_ok(~F, S.Z.cmp(S.Z.double(r), S.Zpos{d}), S.XO{m}, S.Z.double(q), S.Z.double(r), d, {==}, step_e0(~F, m, d, q, r, dv_e(~F, m, d, QRD.Dv{q, r}, h)),
    (%Equal.sym(@T, O.ofz(~F, S.Z.double(r)), @A(O.ofz(~F, r), O.ofz(~F, r)), ofz_double(~F, r)) : O.le(~F, @0, _)
      FO.nonneg_add(~F, O.ofz(~F, r), O.ofz(~F, r), h0, h0)),
    (%Equal.sym(@T, O.ofz(~F, S.Z.double(r)), @A(O.ofz(~F, r), O.ofz(~F, r)), ofz_double(~F, r)) : O.le(~F, @A(_, @1), @A(O.ofp(~F, d), O.ofp(~F, d)))
      FV.le_of_sub(~F, @A(@A(O.ofz(~F, r), O.ofz(~F, r)), @1), @A(O.ofp(~F, d), O.ofp(~F, d)), FM.nn_eq(~F, @S(@A(O.ofp(~F, d), O.ofp(~F, d)), @A(@A(O.ofz(~F, r), O.ofz(~F, r)), @1)), @A(@A(@S(O.ofp(~F, d), @A(O.ofz(~F, r), @1)), @S(O.ofp(~F, d), @A(O.ofz(~F, r), @1))), @1), @ZEQ[r=O.ofz(~F, r),, d=O.ofp(~F, d) | ((d - (r + 1)) + (d - (r + 1))) + 1 | (d + d) - ((r + r) + 1)], FO.nonneg_add(~F, @A(@S(O.ofp(~F, d), @A(O.ofz(~F, r), @1)), @S(O.ofp(~F, d), @A(O.ofz(~F, r), @1))), @1, FO.nonneg_add(~F, @S(O.ofp(~F, d), @A(O.ofz(~F, r), @1)), @S(O.ofp(~F, d), @A(O.ofz(~F, r), @1)), s, s), FO.one_nn(~F))))))

# one step of long division, bit 0
def step0(~F: O.OField, +m: S.Pos, +d: S.Pos, v: QRD.Dv, h: dvok(~F, m, d, v)) -> dvok(~F, S.XO{m}, d, QRD.div.step(d, False{}, v)):
  match v:
    case QRD.Dv{+q, +r}:
      step0.go(~F, m, d, q, r, h)

def step1.go(~F: O.OField, +m: S.Pos, +d: S.Pos, +q: S.Z, +r: S.Z, +h: dvok(~F, m, d, QRD.Dv{q, r})) -> dvok(~F, S.XI{m}, d, QRD.div.step(d, True{}, QRD.Dv{q, r})):
  +h0 = dv_0(~F, m, d, QRD.Dv{q, r}, h)
  +s = FM.sub_nonneg(~F, @A(O.ofz(~F, r), @1), O.ofp(~F, d), dv_1(~F, m, d, QRD.Dv{q, r}, h))
  adj_ok(~F, S.Z.cmp(S.Z.succ_double(r), S.Zpos{d}), S.XI{m}, S.Z.double(q), S.Z.succ_double(r), d, {==}, step_e1(~F, m, d, q, r, dv_e(~F, m, d, QRD.Dv{q, r}, h)),
    (%Equal.sym(@T, O.ofz(~F, S.Z.succ_double(r)), @A(@A(O.ofz(~F, r), O.ofz(~F, r)), @1), ofz_sdouble(~F, r)) : O.le(~F, @0, _)
      FO.nonneg_add(~F, @A(O.ofz(~F, r), O.ofz(~F, r)), @1, FO.nonneg_add(~F, O.ofz(~F, r), O.ofz(~F, r), h0, h0), FO.one_nn(~F))),
    (%Equal.sym(@T, O.ofz(~F, S.Z.succ_double(r)), @A(@A(O.ofz(~F, r), O.ofz(~F, r)), @1), ofz_sdouble(~F, r)) : O.le(~F, @A(_, @1), @A(O.ofp(~F, d), O.ofp(~F, d)))
      FV.le_of_sub(~F, @A(@A(@A(O.ofz(~F, r), O.ofz(~F, r)), @1), @1), @A(O.ofp(~F, d), O.ofp(~F, d)), FM.nn_eq(~F, @S(@A(O.ofp(~F, d), O.ofp(~F, d)), @A(@A(@A(O.ofz(~F, r), O.ofz(~F, r)), @1), @1)), @A(@S(O.ofp(~F, d), @A(O.ofz(~F, r), @1)), @S(O.ofp(~F, d), @A(O.ofz(~F, r), @1))), @ZEQ[r=O.ofz(~F, r),, d=O.ofp(~F, d) | (d - (r + 1)) + (d - (r + 1)) | (d + d) - (((r + r) + 1) + 1)], FO.nonneg_add(~F, @S(O.ofp(~F, d), @A(O.ofz(~F, r), @1)), @S(O.ofp(~F, d), @A(O.ofz(~F, r), @1)), s, s)))))

# one step of long division, bit 1
def step1(~F: O.OField, +m: S.Pos, +d: S.Pos, v: QRD.Dv, h: dvok(~F, m, d, v)) -> dvok(~F, S.XI{m}, d, QRD.div.step(d, True{}, v)):
  match v:
    case QRD.Dv{+q, +r}:
      step1.go(~F, m, d, q, r, h)

# Euclid: div(n, d) = (q, r) with n = q d + r and 0 <= r < d
def div_ok(~F: O.OField, n: S.Pos, +d: S.Pos) -> dvok(~F, n, d, QRD.div(n, d)):
  match n:
    case S.XH{}:
      adj_ok(~F, S.Z.cmp(S.Zpos{S.XH{}}, S.Zpos{d}), S.XH{}, S.Z0{}, S.Zpos{S.XH{}}, d, {==}, @ZEQ[d=O.ofp(~F, d) | 1 | 0*d + 1], FO.one_nn(~F), le_dbl(~F, @1, O.ofp(~F, d), ofp_ge1(~F, d)))
    case S.XO{+m}:
      step0(~F, m, d, QRD.div(m, d), div_ok(~F, m, d))
    case S.XI{+m}:
      step1(~F, m, d, QRD.div(m, d), div_ok(~F, m, d))

# Floors
# ------

# f is the floor of n / d: f d <= n and n + 1 <= (f + 1) d
def zfl(~F: O.OField, +n: S.Z, +d: S.Pos, +f: S.Z) -> Data:
  M.Both(O.le(~F, @M(O.ofz(~F, f), O.ofp(~F, d)), O.ofz(~F, n)), O.le(~F, @A(O.ofz(~F, n), @1), @M(@A(O.ofz(~F, f), @1), O.ofp(~F, d))))

# a floor stated with f's value in F
def zfl_of(~F: O.OField, +n: S.Z, +d: S.Pos, +f: S.Z, +fv: @T, +ef: {O.ofz(~F, f) == fv : @T}, h1: O.le(~F, @M(fv, O.ofp(~F, d)), O.ofz(~F, n)), h2: O.le(~F, @A(O.ofz(~F, n), @1), @M(@A(fv, @1), O.ofp(~F, d)))) -> zfl(~F, n, d, f):
  ((%Equal.sym(@T, O.ofz(~F, f), fv, ef) : O.le(~F, @M(_, O.ofp(~F, d)), O.ofz(~F, n))
     h1),
   (%Equal.sym(@T, O.ofz(~F, f), fv, ef) : O.le(~F, @A(O.ofz(~F, n), @1), @M(@A(_, @1), O.ofp(~F, d)))
     h2))

@ATOMS fl = p=O.ofp(~F, p),, q=O.ofz(~F, QRD.Dv.q(v)),, r=O.ofz(~F, QRD.Dv.r(v)),, d=O.ofp(~F, d)

def zfloor_pos(~F: O.OField, +p: S.Pos, +d: S.Pos, +v: QRD.Dv, +h: dvok(~F, p, d, v)) -> zfl(~F, S.Zpos{p}, d, QRD.Dv.q(v)):
  +ee = FO.sub_of_eq(~F, O.ofp(~F, p), @A(@M(O.ofz(~F, QRD.Dv.q(v)), O.ofp(~F, d)), O.ofz(~F, QRD.Dv.r(v))), dv_e(~F, p, d, v, h))
  (FV.le_of_sub(~F, @M(O.ofz(~F, QRD.Dv.q(v)), O.ofp(~F, d)), O.ofp(~F, p), FM.nn_eq(~F, @S(O.ofp(~F, p), @M(O.ofz(~F, QRD.Dv.q(v)), O.ofp(~F, d))), O.ofz(~F, QRD.Dv.r(v)), @CERTEQ[fl | r | p - q*d | -1 ; p - (q*d + r) || ee], dv_0(~F, p, d, v, h))),
   FV.le_of_sub(~F, @A(O.ofp(~F, p), @1), @M(@A(O.ofz(~F, QRD.Dv.q(v)), @1), O.ofp(~F, d)), FM.nn_eq(~F, @S(@M(@A(O.ofz(~F, QRD.Dv.q(v)), @1), O.ofp(~F, d)), @A(O.ofp(~F, p), @1)), @S(O.ofp(~F, d), @A(O.ofz(~F, QRD.Dv.r(v)), @1)), @CERTEQ[fl | d - (r + 1) | (q + 1)*d - (p + 1) | 1 ; p - (q*d + r) || ee], FM.sub_nonneg(~F, @A(O.ofz(~F, QRD.Dv.r(v)), @1), O.ofp(~F, d), dv_1(~F, p, d, v, h)))))

def ofz_negsucc(~F: O.OField, +q: S.Z) -> {O.ofz(~F, S.Z.neg(S.Z.add(q, S.Zpos{S.XH{}}))) == @N(@A(O.ofz(~F, q), @1)) : @T}:
  %FR.ofz_neg(~F, S.Z.add(q, S.Zpos{S.XH{}})) : {_ == @N(@A(O.ofz(~F, q), @1)) : @T}
  %FR.ofz_add(~F, q, S.Zpos{S.XH{}}) : {@N(_) == @N(@A(O.ofz(~F, q), @1)) : @T}
  {==}

@ATOMS fn = p=O.ofp(~F, p),, q=O.ofz(~F, q),, d=O.ofp(~F, d)
@ATOMS fr = p=O.ofp(~F, p),, q=O.ofz(~F, q),, r=O.ofp(~F, r),, d=O.ofp(~F, d)

def zfloor_neg(~F: O.OField, +p: S.Pos, +d: S.Pos, v: QRD.Dv, +h: dvok(~F, p, d, v)) -> zfl(~F, S.Zneg{p}, d, NU.zfloor.neg(v)):
  match v:
    case QRD.Dv{+q, S.Z0{}}:
      +ee = FO.sub_of_eq(~F, O.ofp(~F, p), @A(@M(O.ofz(~F, q), O.ofp(~F, d)), @0), dv_e(~F, p, d, QRD.Dv{q, S.Z0{}}, h))
      zfl_of(~F, S.Zneg{p}, d, S.Z.neg(q), @N(O.ofz(~F, q)), Equal.sym(@T, @N(O.ofz(~F, q)), O.ofz(~F, S.Z.neg(q)), FR.ofz_neg(~F, q)),
        Inr{@CERTEQ[fn | (-q)*d | -p | 1 ; p - (q*d + 0) || ee]},
        FV.le_of_sub(~F, @A(@N(O.ofp(~F, p)), @1), @M(@A(@N(O.ofz(~F, q)), @1), O.ofp(~F, d)), FM.nn_eq(~F, @S(@M(@A(@N(O.ofz(~F, q)), @1), O.ofp(~F, d)), @A(@N(O.ofp(~F, p)), @1)), @S(O.ofp(~F, d), @1), @CERTEQ[fn | d - 1 | ((-q) + 1)*d - ((-p) + 1) | -1 ; p - (q*d + 0) || ee], FM.sub_nonneg(~F, @1, O.ofp(~F, d), ofp_ge1(~F, d)))))
    case QRD.Dv{+q, S.Zpos{+r}}:
      +ee = FO.sub_of_eq(~F, O.ofp(~F, p), @A(@M(O.ofz(~F, q), O.ofp(~F, d)), O.ofp(~F, r)), dv_e(~F, p, d, QRD.Dv{q, S.Zpos{r}}, h))
      zfl_of(~F, S.Zneg{p}, d, S.Z.neg(S.Z.add(q, S.Zpos{S.XH{}})), @N(@A(O.ofz(~F, q), @1)), ofz_negsucc(~F, q),
        FV.le_of_sub(~F, @M(@N(@A(O.ofz(~F, q), @1)), O.ofp(~F, d)), @N(O.ofp(~F, p)), FM.nn_eq(~F, @S(@N(O.ofp(~F, p)), @M(@N(@A(O.ofz(~F, q), @1)), O.ofp(~F, d))), @S(O.ofp(~F, d), O.ofp(~F, r)), @CERTEQ[fr | d - r | (-p) - (-(q + 1))*d | 1 ; p - (q*d + r) || ee], FM.sub_nonneg(~F, O.ofp(~F, r), O.ofp(~F, d), le_of_succ(~F, O.ofp(~F, r), O.ofp(~F, d), dv_1(~F, p, d, QRD.Dv{q, S.Zpos{r}}, h))))),
        FV.le_of_sub(~F, @A(@N(O.ofp(~F, p)), @1), @M(@A(@N(@A(O.ofz(~F, q), @1)), @1), O.ofp(~F, d)), FM.nn_eq(~F, @S(@M(@A(@N(@A(O.ofz(~F, q), @1)), @1), O.ofp(~F, d)), @A(@N(O.ofp(~F, p)), @1)), @S(O.ofp(~F, r), @1), @CERTEQ[fr | r - 1 | ((-(q + 1)) + 1)*d - ((-p) + 1) | -1 ; p - (q*d + r) || ee], FM.sub_nonneg(~F, @1, O.ofp(~F, r), ofp_ge1(~F, r)))))
    case QRD.Dv{+q, S.Zneg{+r}}:
      FO.absurd(zfl(~F, S.Zneg{p}, d, NU.zfloor.neg(QRD.Dv{q, S.Zneg{r}})), O.lt_irrefl(F)(@0)(FO.lt_subst_r(~F, @A(O.ofp(~F, r), @N(O.ofp(~F, r))), @0, @0, O.add_neg(F)(O.ofp(~F, r)), FO.pos_add(~F, O.ofp(~F, r), @N(O.ofp(~F, r)), QE.ofp_pos(~F, r), dv_0(~F, p, d, QRD.Dv{q, S.Zneg{r}}, h)))))

# zfloor(n, d) is the floor of n / d
def zfloor_ok(~F: O.OField, n: S.Z, +d: S.Pos) -> zfl(~F, n, d, NU.zfloor(n, d)):
  match n:
    case S.Z0{}:
      (Inr{FL.zero_mul(~F, O.ofp(~F, d))}, FV.le_of_sub(~F, @A(@0, @1), @M(@A(@0, @1), O.ofp(~F, d)), FM.nn_eq(~F, @S(@M(@A(@0, @1), O.ofp(~F, d)), @A(@0, @1)), @S(O.ofp(~F, d), @1), @ZEQ[d=O.ofp(~F, d) | d - 1 | (0 + 1)*d - (0 + 1)], FM.sub_nonneg(~F, @1, O.ofp(~F, d), ofp_ge1(~F, d)))))
    case S.Zpos{+p}:
      zfloor_pos(~F, p, d, QRD.div(p, d), div_ok(~F, p, d))
    case S.Zneg{+p}:
      zfloor_neg(~F, p, d, QRD.div(p, d), div_ok(~F, p, d))

def zfl_1(~F: O.OField, +n: S.Z, +d: S.Pos, +f: S.Z, h: zfl(~F, n, d, f)) -> O.le(~F, @M(O.ofz(~F, f), O.ofp(~F, d)), O.ofz(~F, n)):
  (a, b) = h
  a

def zfl_2(~F: O.OField, +n: S.Z, +d: S.Pos, +f: S.Z, h: zfl(~F, n, d, f)) -> O.le(~F, @A(O.ofz(~F, n), @1), @M(@A(O.ofz(~F, f), @1), O.ofp(~F, d))):
  (a, b) = h
  b

# Shifts
# ------

# a floor by t, doubled: by 2t of 2q
def fl_xo(~F: O.OField, +f: @T, +t: @T, +q: @T, h1: O.le(~F, @M(f, t), q), h2: O.le(~F, @A(q, @1), @M(@A(f, @1), t))) -> M.Both(O.le(~F, @M(f, @A(t, t)), @A(q, q)), O.le(~F, @A(@A(q, q), @1), @M(@A(f, @1), @A(t, t)))):
  +s1 = FM.sub_nonneg(~F, @M(f, t), q, h1)
  +s2 = FM.sub_nonneg(~F, @A(q, @1), @M(@A(f, @1), t), h2)
  (FV.le_of_sub(~F, @M(f, @A(t, t)), @A(q, q), FM.nn_eq(~F, @S(@A(q, q), @M(f, @A(t, t))), @A(@S(q, @M(f, t)), @S(q, @M(f, t))), @ZEQ[f,, t,, q | (q - f*t) + (q - f*t) | (q + q) - f*(t + t)], FO.nonneg_add(~F, @S(q, @M(f, t)), @S(q, @M(f, t)), s1, s1))),
   FV.le_of_sub(~F, @A(@A(q, q), @1), @M(@A(f, @1), @A(t, t)), FM.nn_eq(~F, @S(@M(@A(f, @1), @A(t, t)), @A(@A(q, q), @1)), @A(@A(@S(@M(@A(f, @1), t), @A(q, @1)), @S(@M(@A(f, @1), t), @A(q, @1))), @1), @ZEQ[f,, t,, q | (((f + 1)*t - (q + 1)) + ((f + 1)*t - (q + 1))) + 1 | (f + 1)*(t + t) - ((q + q) + 1)], FO.nonneg_add(~F, @A(@S(@M(@A(f, @1), t), @A(q, @1)), @S(@M(@A(f, @1), t), @A(q, @1))), @1, FO.nonneg_add(~F, @S(@M(@A(f, @1), t), @A(q, @1)), @S(@M(@A(f, @1), t), @A(q, @1)), s2, s2), FO.one_nn(~F)))))

# a floor by t, doubled: by 2t of 2q + 1
def fl_xi(~F: O.OField, +f: @T, +t: @T, +q: @T, h1: O.le(~F, @M(f, t), q), h2: O.le(~F, @A(q, @1), @M(@A(f, @1), t))) -> M.Both(O.le(~F, @M(f, @A(t, t)), @A(@A(q, q), @1)), O.le(~F, @A(@A(@A(q, q), @1), @1), @M(@A(f, @1), @A(t, t)))):
  +s1 = FM.sub_nonneg(~F, @M(f, t), q, h1)
  +s2 = FM.sub_nonneg(~F, @A(q, @1), @M(@A(f, @1), t), h2)
  (FV.le_of_sub(~F, @M(f, @A(t, t)), @A(@A(q, q), @1), FM.nn_eq(~F, @S(@A(@A(q, q), @1), @M(f, @A(t, t))), @A(@A(@S(q, @M(f, t)), @S(q, @M(f, t))), @1), @ZEQ[f,, t,, q | ((q - f*t) + (q - f*t)) + 1 | ((q + q) + 1) - f*(t + t)], FO.nonneg_add(~F, @A(@S(q, @M(f, t)), @S(q, @M(f, t))), @1, FO.nonneg_add(~F, @S(q, @M(f, t)), @S(q, @M(f, t)), s1, s1), FO.one_nn(~F)))),
   FV.le_of_sub(~F, @A(@A(@A(q, q), @1), @1), @M(@A(f, @1), @A(t, t)), FM.nn_eq(~F, @S(@M(@A(f, @1), @A(t, t)), @A(@A(@A(q, q), @1), @1)), @A(@S(@M(@A(f, @1), t), @A(q, @1)), @S(@M(@A(f, @1), t), @A(q, @1))), @ZEQ[f,, t,, q | ((f + 1)*t - (q + 1)) + ((f + 1)*t - (q + 1)) | (f + 1)*(t + t) - (((q + q) + 1) + 1)], FO.nonneg_add(~F, @S(@M(@A(f, @1), t), @A(q, @1)), @S(@M(@A(f, @1), t), @A(q, @1)), s2, s2))))

# p itself is its floor by 1
def fl_self(~F: O.OField, +p: @T) -> M.Both(O.le(~F, @M(p, @1), p), O.le(~F, @A(p, @1), @M(@A(p, @1), @1))):
  (Inr{@ZEQ[p | p*1 | p]}, Inr{@ZEQ[p | p + 1 | (p + 1)*1]})

# pshr(p, k) is the floor of p / 2^k
def pshr_fl(~F: O.OField, p: S.Pos, k: Nat) -> zfl(~F, S.Zpos{p}, S.Pos.pow2(k), NU.pshr(p, k)):
  match p k:
    case S.XH{} 0n:
      fl_self(~F, @1)
    case S.XH{} 1n++j:
      (FV.le_of_sub(~F, @M(@0, t2(~F, 1n+j)), @1, FM.nn_eq(~F, @S(@1, @M(@0, t2(~F, 1n+j))), @1, @ZEQ[t=t2(~F, 1n+j) | 1 | 1 - 0*t], FO.one_nn(~F))),
       FV.le_rw_r(~F, @A(@1, @1), @A(t2(~F, j), t2(~F, j)), @M(@A(@0, @1), t2(~F, 1n+j)), @ZEQ[t=t2(~F, j) | t + t | (0 + 1)*(t + t)], le_dbl(~F, @1, t2(~F, j), ofp_ge1(~F, S.Pos.pow2(j)))))
    case S.XO{+q} 0n:
      fl_self(~F, O.ofp(~F, S.XO{q}))
    case S.XO{+q} 1n++j:
      +h = pshr_fl(~F, q, j)
      fl_xo(~F, O.ofz(~F, NU.pshr(q, j)), t2(~F, j), O.ofp(~F, q), zfl_1(~F, S.Zpos{q}, S.Pos.pow2(j), NU.pshr(q, j), h), zfl_2(~F, S.Zpos{q}, S.Pos.pow2(j), NU.pshr(q, j), h))
    case S.XI{+q} 0n:
      fl_self(~F, O.ofp(~F, S.XI{q}))
    case S.XI{+q} 1n++j:
      +h = pshr_fl(~F, q, j)
      fl_xi(~F, O.ofz(~F, NU.pshr(q, j)), t2(~F, j), O.ofp(~F, q), zfl_1(~F, S.Zpos{q}, S.Pos.pow2(j), NU.pshr(q, j), h), zfl_2(~F, S.Zpos{q}, S.Pos.pow2(j), NU.pshr(q, j), h))

def sub0(j: Nat) -> {Nat.sub(j, 0n) == j : Nat}:
  match j:
    case 0n:
      {==}
    case 1n+i:
      {==}

# the floor of (P + t) / 2t is within t of P / 2t, scaled: |2t f - P| <= t
def psr_core(~F: O.OField, +f: @T, +t: @T, +p: @T, h1: O.le(~F, @M(f, @A(t, t)), @A(p, t)), h2: O.le(~F, @A(@A(p, t), @1), @M(@A(f, @1), @A(t, t)))) -> M.bnd(~F, @S(@M(f, @A(t, t)), p), t):
  (FM.nn_eq(~F, @S(t, @S(@M(f, @A(t, t)), p)), @S(@A(p, t), @M(f, @A(t, t))), @ZEQ[f,, t,, p | (p + t) - f*(t + t) | t - (f*(t + t) - p)], FM.sub_nonneg(~F, @M(f, @A(t, t)), @A(p, t), h1)),
   FM.nn_eq(~F, @A(t, @S(@M(f, @A(t, t)), p)), @A(@S(@M(@A(f, @1), @A(t, t)), @A(@A(p, t), @1)), @1), @ZEQ[f,, t,, p | ((f + 1)*(t + t) - ((p + t) + 1)) + 1 | t + (f*(t + t) - p)], FO.nonneg_add(~F, @S(@M(@A(f, @1), @A(t, t)), @A(@A(p, t), @1)), @1, FM.sub_nonneg(~F, @A(@A(p, t), @1), @M(@A(f, @1), @A(t, t)), h2), FO.one_nn(~F))))

def psr_go(~F: O.OField, +p: S.Pos, +j: Nat) -> M.bnd(~F, @S(@M(O.ofz(~F, NU.pshr(S.Pos.add(p, S.Pos.pow2(j)), 1n+j)), t2(~F, 1n+j)), O.ofp(~F, p)), t2(~F, j)):
  +h = pshr_fl(~F, S.Pos.add(p, S.Pos.pow2(j)), 1n+j)
  psr_core(~F, O.ofz(~F, NU.pshr(S.Pos.add(p, S.Pos.pow2(j)), 1n+j)), t2(~F, j), O.ofp(~F, p),
    (%Equal.sym(@T, @A(O.ofp(~F, p), t2(~F, j)), O.ofp(~F, S.Pos.add(p, S.Pos.pow2(j))), ofp_add(~F, p, S.Pos.pow2(j))) : O.le(~F, @M(O.ofz(~F, NU.pshr(S.Pos.add(p, S.Pos.pow2(j)), 1n+j)), @A(t2(~F, j), t2(~F, j))), _)
      zfl_1(~F, S.Zpos{S.Pos.add(p, S.Pos.pow2(j))}, S.Pos.pow2(1n+j), NU.pshr(S.Pos.add(p, S.Pos.pow2(j)), 1n+j), h)),
    (%Equal.sym(@T, @A(O.ofp(~F, p), t2(~F, j)), O.ofp(~F, S.Pos.add(p, S.Pos.pow2(j))), ofp_add(~F, p, S.Pos.pow2(j))) : O.le(~F, @A(_, @1), @M(@A(O.ofz(~F, NU.pshr(S.Pos.add(p, S.Pos.pow2(j)), 1n+j)), @1), @A(t2(~F, j), t2(~F, j))))
      zfl_2(~F, S.Zpos{S.Pos.add(p, S.Pos.pow2(j))}, S.Pos.pow2(1n+j), NU.pshr(S.Pos.add(p, S.Pos.pow2(j)), 1n+j), h)))

# p / 2^(j+1) rounded to nearest: |2^(j+1) f - p| <= 2^j
def psr_bnd(~F: O.OField, +p: S.Pos, +j: Nat) -> M.bnd(~F, @S(@M(O.ofz(~F, NU.pshr_round(p, 1n+j)), t2(~F, 1n+j)), O.ofp(~F, p)), t2(~F, j)):
  %Equal.sym(Nat, Nat.sub(j, 0n), j, sub0(j)) : M.bnd(~F, @S(@M(O.ofz(~F, NU.pshr(S.Pos.add(p, S.Pos.pow2(_)), 1n+j)), t2(~F, 1n+j)), O.ofp(~F, p)), t2(~F, j))
  psr_go(~F, p, j)

# m / 2^(j+1) rounded to nearest: |2^(j+1) f - m| <= 2^j
def zsr(~F: O.OField, m: S.Z, +j: Nat) -> M.bnd(~F, @S(@M(O.ofz(~F, NU.zshr_round(m, 1n+j)), t2(~F, 1n+j)), O.ofz(~F, m)), t2(~F, j)):
  match m:
    case S.Z0{}:
      KB.bnd_val(~F, @0, @S(@M(@0, t2(~F, 1n+j)), @0), t2(~F, j), @ZEQ[t=t2(~F, 1n+j) | 0 | 0*t - 0], FM.bnd_zero(~F, t2(~F, j), ofp_nn(~F, S.Pos.pow2(j))))
    case S.Zpos{+p}:
      psr_bnd(~F, p, j)
    case S.Zneg{+p}:
      %FR.ofz_neg(~F, NU.pshr_round(p, 1n+j)) : M.bnd(~F, @S(@M(_, t2(~F, 1n+j)), @N(O.ofp(~F, p))), t2(~F, j))
      KB.bnd_val(~F, @N(@S(@M(O.ofz(~F, NU.pshr_round(p, 1n+j)), t2(~F, 1n+j)), O.ofp(~F, p))), @S(@M(@N(O.ofz(~F, NU.pshr_round(p, 1n+j))), t2(~F, 1n+j)), @N(O.ofp(~F, p))), t2(~F, j), @ZEQ[f=O.ofz(~F, NU.pshr_round(p, 1n+j)),, t=t2(~F, 1n+j),, p=O.ofp(~F, p) | -(f*t - p) | (-f)*t - (-p)], FM.bnd_neg(~F, @S(@M(O.ofz(~F, NU.pshr_round(p, 1n+j)), t2(~F, 1n+j)), O.ofp(~F, p)), t2(~F, j), psr_bnd(~F, p, j)))

# Rounding to a multiple of 2^-p
# ------------------------------

def sub_succ(e: Nat, p: Nat, h: {KA.natle(e, p) == False{} : Bool}) -> {Nat.sub(e, p) == 1n+Nat.sub(e, 1n+p) : Nat}:
  match e p:
    case 0n 0n:
      FO.absurd({Nat.sub(0n, 0n) == 1n+Nat.sub(0n, 1n) : Nat}, KA.ft(Equal.sym(Bool, True{}, False{}, h)))
    case 0n 1n++q:
      FO.absurd({Nat.sub(0n, 1n+q) == 1n+Nat.sub(0n, 2n+q) : Nat}, KA.ft(Equal.sym(Bool, True{}, False{}, h)))
    case 1n++i 0n:
      Equal.cong(Nat, Nat, x => 1n+x, i, Nat.sub(i, 0n), Equal.sym(Nat, Nat.sub(i, 0n), i, sub0(i)))
    case 1n++i 1n++q:
      sub_succ(i, q, h)

def add_sub(e: Nat, p: Nat, h: {KA.natle(e, p) == False{} : Bool}) -> {Nat.add(p, Nat.sub(e, p)) == e : Nat}:
  match e p:
    case 0n 0n:
      FO.absurd({Nat.add(0n, Nat.sub(0n, 0n)) == 0n : Nat}, KA.ft(Equal.sym(Bool, True{}, False{}, h)))
    case 0n 1n++q:
      FO.absurd({Nat.add(1n+q, Nat.sub(0n, 1n+q)) == 0n : Nat}, KA.ft(Equal.sym(Bool, True{}, False{}, h)))
    case 1n++i 0n:
      {==}
    case 1n++i 1n++q:
      Equal.cong(Nat, Nat, x => 1n+x, Nat.add(q, Nat.sub(i, q)), i, add_sub(i, q, h))

# |a| <= s and 0 <= c give |a c| <= s c
def bnd_scale(~F: O.OField, +a: @T, +s: @T, +c: @T, +hc: O.le(~F, @0, c), h: M.bnd(~F, a, s)) -> M.bnd(~F, @M(a, c), @M(s, c)):
  FM.bnd_mul(~F, a, s, c, c, h, FV.bnd_self(~F, c, hc))

def inv_nn(~F: O.OField, +p: S.Pos) -> O.le(~F, @0, O.inv(F, O.ofp(~F, p))):
  FO.lt_le(~F, @0, O.inv(F, O.ofp(~F, p)), FO.inv_pos(~F, O.ofp(~F, p), QE.ofp_pos(~F, p)))

@ATOMS rc = r=O.ofz(~F, NU.zshr_round(m, 1n+j)),, mv=O.ofz(~F, m),, tp=t2(~F, p),, tj=t2(~F, j),, tq=t2(~F, Nat.add(p, 1n+j)),, ip=O.inv(F, t2(~F, p)),, iq=O.inv(F, t2(~F, Nat.add(p, 1n+j))),, i1=O.inv(F, t2(~F, 1n+p))

# m / 2^(p+j+1) rounded to a multiple of 2^-p is within 2^-(p+1)
def rnd_core(~F: O.OField, +m: S.Z, +p: Nat, +j: Nat) -> M.bnd(~F, @S(M.ofd(~F, S.D{NU.zshr_round(m, 1n+j), p}), M.ofd(~F, S.D{m, Nat.add(p, 1n+j)})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+p})):
  +r1 = QE.ofp_rel(~F, S.Pos.pow2(p))
  +r2 = QE.ofp_rel(~F, S.Pos.pow2(Nat.add(p, 1n+j)))
  +r3 = FO.sub_of_eq(~F, t2(~F, Nat.add(p, 1n+j)), @M(t2(~F, p), @A(t2(~F, j), t2(~F, j))), Equal.sym(@T, @M(t2(~F, p), @A(t2(~F, j), t2(~F, j))), t2(~F, Nat.add(p, 1n+j)), t2_add(~F, p, 1n+j)))
  +s1 = QE.ofp_rel(~F, S.Pos.pow2(1n+p))
  KB.bnd_val(~F, @M(@S(@M(O.ofz(~F, NU.zshr_round(m, 1n+j)), @A(t2(~F, j), t2(~F, j))), O.ofz(~F, m)), O.inv(F, t2(~F, Nat.add(p, 1n+j)))), @S(@M(O.ofz(~F, NU.zshr_round(m, 1n+j)), O.inv(F, t2(~F, p))), @M(O.ofz(~F, m), O.inv(F, t2(~F, Nat.add(p, 1n+j))))), @M(@1, O.inv(F, t2(~F, 1n+p))),
    @CERTEQ[rc | (r*(tj + tj) - mv)*iq | r*ip - mv*iq | -(r*iq*(tj + tj)) ; tp*ip - 1 | r*ip ; tq*iq - 1 | -(r*iq*ip) ; tq - tp*(tj + tj) || r1, r2, r3],
    FM.bnd_eq(~F, @M(@S(@M(O.ofz(~F, NU.zshr_round(m, 1n+j)), @A(t2(~F, j), t2(~F, j))), O.ofz(~F, m)), O.inv(F, t2(~F, Nat.add(p, 1n+j)))), @M(t2(~F, j), O.inv(F, t2(~F, Nat.add(p, 1n+j)))), @M(@1, O.inv(F, t2(~F, 1n+p))),
      @CERTEQ[rc | tj*iq | 1*i1 | -(tj*iq) ; (tp + tp)*i1 - 1 | i1 ; tq*iq - 1 | -(i1*iq) ; tq - tp*(tj + tj) || s1, r2, r3],
      bnd_scale(~F, @S(@M(O.ofz(~F, NU.zshr_round(m, 1n+j)), @A(t2(~F, j), t2(~F, j))), O.ofz(~F, m)), t2(~F, j), O.inv(F, t2(~F, Nat.add(p, 1n+j))), inv_nn(~F, S.Pos.pow2(Nat.add(p, 1n+j))), zsr(~F, m, j))))

def dround_go(~F: O.OField, le: Bool, +m: S.Z, +e: Nat, +p: Nat, +h: {KA.natle(e, p) == le : Bool}) -> M.bnd(~F, @S(M.ofd(~F, NU.dround.go(le, S.D{m, e}, p)), M.ofd(~F, S.D{m, e})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+p})):
  match le:
    case True{}:
      KB.bnd_subself(~F, M.ofd(~F, S.D{m, e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+p}), FO.lt_le(~F, @0, M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+p}), DM.dpos(~F, S.XH{}, 1n+p)))
    case False{}:
      %add_sub(e, p, h) : M.bnd(~F, @S(M.ofd(~F, S.D{NU.zshr_round(m, Nat.sub(e, p)), p}), M.ofd(~F, S.D{m, _})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+p}))
      %Equal.sym(Nat, Nat.sub(e, p), 1n+Nat.sub(e, 1n+p), sub_succ(e, p, h)) : M.bnd(~F, @S(M.ofd(~F, S.D{NU.zshr_round(m, _), p}), M.ofd(~F, S.D{m, Nat.add(p, Nat.sub(e, p))})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+p}))
      %Equal.sym(Nat, Nat.sub(e, p), 1n+Nat.sub(e, 1n+p), sub_succ(e, p, h)) : M.bnd(~F, @S(M.ofd(~F, S.D{NU.zshr_round(m, 1n+Nat.sub(e, 1n+p)), p}), M.ofd(~F, S.D{m, Nat.add(p, _)})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+p}))
      rnd_core(~F, m, p, Nat.sub(e, 1n+p))

# |dround(x, p) - x| <= 2^-(p+1)
def dround_err(~F: O.OField, x: S.D, +p: Nat) -> M.bnd(~F, @S(M.ofd(~F, NU.dround(x, p)), M.ofd(~F, x)), M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+p})):
  match x:
    case S.D{+m, +e}:
      dround_go(~F, KA.natle(e, p), m, e, p, {==})

# Rounding to b significant bits
# ------------------------------

def sub_add_le(x: Nat, y: Nat, h: {KA.natle(y, x) == True{} : Bool}) -> {Nat.add(Nat.sub(x, y), y) == x : Nat}:
  match x y:
    case 0n 0n:
      {==}
    case 0n 1n++j:
      FO.absurd({Nat.add(Nat.sub(0n, 1n+j), 1n+j) == 0n : Nat}, KA.ft(h))
    case 1n++i 0n:
      Equal.cong(Nat, Nat, z => 1n+z, Nat.add(i, 0n), i, Equal.sym(Nat, i, Nat.add(i, 0n), LN.add_zero(i)))
    case 1n++i 1n++j:
      %LN.add_succ(Nat.sub(i, j), j) : {_ == 1n+i : Nat}
      Equal.cong(Nat, Nat, z => 1n+z, Nat.add(Nat.sub(i, j), j), i, sub_add_le(i, j, h))

@ATOMS va = r=O.ofz(~F, z),, tc=t2(~F, c),, tk=t2(~F, k),, tck=t2(~F, Nat.add(c, k)),, ic=O.inv(F, t2(~F, c)),, ick=O.inv(F, t2(~F, Nat.add(c, k)))

# z / 2^c is (z 2^k) / 2^(c + k)
def valA(~F: O.OField, +z: S.Z, +c: Nat, +k: Nat) -> {M.ofd(~F, S.D{z, c}) == @M(@M(O.ofz(~F, z), t2(~F, k)), O.inv(F, t2(~F, Nat.add(c, k)))) : @T}:
  @CERTEQ[va | r*ic | (r*tk)*ick | r*ick*tk ; tc*ic - 1 | -(r*ic) ; tck*ick - 1 | r*ick*ic ; tck - tc*tk || QE.ofp_rel(~F, S.Pos.pow2(c)), QE.ofp_rel(~F, S.Pos.pow2(Nat.add(c, k))), FO.sub_of_eq(~F, t2(~F, Nat.add(c, k)), @M(t2(~F, c), t2(~F, k)), Equal.sym(@T, @M(t2(~F, c), t2(~F, k)), t2(~F, Nat.add(c, k)), t2_add(~F, c, k)))]

@ATOMS vb = r=O.ofz(~F, z),, tc=t2(~F, c),, te=t2(~F, e),, tce=t2(~F, Nat.add(c, e)),, i0=O.inv(F, @1),, ie=O.inv(F, t2(~F, e))

# (z 2^c) / 1 is (z 2^(c + e)) / 2^e
def valB(~F: O.OField, +z: S.Z, +c: Nat, +e: Nat) -> {M.ofd(~F, S.D{S.Z.mul(z, S.Zpos{S.Pos.pow2(c)}), 0n}) == @M(@M(O.ofz(~F, z), t2(~F, Nat.add(c, e))), O.inv(F, t2(~F, e))) : @T}:
  %FR.ofz_mul(~F, z, S.Zpos{S.Pos.pow2(c)}) : {@M(_, O.inv(F, @1)) == @M(@M(O.ofz(~F, z), t2(~F, Nat.add(c, e))), O.inv(F, t2(~F, e))) : @T}
  @CERTEQ[vb | (r*tc)*i0 | (r*tce)*ie | r*tc ; 1*i0 - 1 | -(r*tc) ; te*ie - 1 | -(r*ie) ; tce - tc*te || QE.ofp_rel(~F, S.XH{}), QE.ofp_rel(~F, S.Pos.pow2(e)), FO.sub_of_eq(~F, t2(~F, Nat.add(c, e)), @M(t2(~F, c), t2(~F, e)), Equal.sym(@T, @M(t2(~F, c), t2(~F, e)), t2(~F, Nat.add(c, e)), t2_add(~F, c, e)))]

@ATOMS dc = v,, r,, mv,, tt,, tj,, tb,, a,, ie,, ib

# a rounding's error from its floor: with v = (r T) / 2^e, |r T - m| <= 2^j,
# T = 2 2^j and 2^b T <= 2 a, |v - m / 2^e| <= (a / 2^e) 2^-b
def dsig_core(~F: O.OField, +v: @T, +r: @T, +mv: @T, +tt: @T, +tj: @T, +tb: @T, +a: @T, +ie: @T, +ib: @T, +ev: {v == @M(@M(r, tt), ie) : @T}, +et: {tt == @A(tj, tj) : @T}, hz: M.bnd(~F, @S(@M(r, tt), mv), tj), hs: O.le(~F, @M(tb, tt), @A(a, a)), +hie: O.le(~F, @0, ie), +hib: O.le(~F, @0, ib), +rb: {@S(@M(tb, ib), @1) == @0 : @T}) -> M.bnd(~F, @S(v, @M(mv, ie)), @M(@M(a, ie), @M(@1, ib))):
  KB.bnd_val(~F, @M(@S(@M(r, tt), mv), ie), @S(v, @M(mv, ie)), @M(@M(a, ie), @M(@1, ib)),
    @CERTEQ[dc | (r*tt - mv)*ie | v - mv*ie | -1 ; v - (r*tt)*ie || FO.sub_of_eq(~F, v, @M(@M(r, tt), ie), ev)],
    FM.bnd_mono(~F, @M(@S(@M(r, tt), mv), ie), @M(tj, ie), @M(@M(a, ie), @M(@1, ib)), bnd_scale(~F, @S(@M(r, tt), mv), tj, ie, hie, hz),
      FM.nn_eq(~F, @S(@M(@M(a, ie), @M(@1, ib)), @M(tj, ie)), @M(@M(ie, ib), @S(a, @M(tb, tj))), @CERTEQ[dc | (ie*ib)*(a - tb*tj) | (a*ie)*(1*ib) - tj*ie | -(tj*ie) ; tb*ib - 1 || rb],
        FO.mul_nonneg(~F, @M(ie, ib), @S(a, @M(tb, tj)), FO.mul_nonneg(~F, ie, ib, hie, hib), FM.twice_nonneg(~F, @S(a, @M(tb, tj)), FM.nn_eq(~F, @A(@S(a, @M(tb, tj)), @S(a, @M(tb, tj))), @S(@A(a, a), @M(tb, tt)), @CERTEQ[dc | (a + a) - tb*tt | (a - tb*tj) + (a - tb*tj) | -tb ; tt - (tj + tj) || FO.sub_of_eq(~F, tt, @A(tj, tj), et)], FM.sub_nonneg(~F, @M(tb, tt), @A(a, a), hs)))))))

# the value dsig's shift produces: (round(m / 2^k) 2^k) / 2^e
def dsh_val(~F: O.OField, le: Bool, +m: S.Z, +e: Nat, +k: Nat, h: {KA.natle(k, e) == le : Bool}) -> {M.ofd(~F, NU.dsig.sh(le, m, e, k)) == @M(@M(O.ofz(~F, NU.zshr_round(m, k)), t2(~F, k)), O.inv(F, t2(~F, e))) : @T}:
  match le:
    case True{}:
      %sub_add_le(e, k, h) : {M.ofd(~F, S.D{NU.zshr_round(m, k), Nat.sub(e, k)}) == @M(@M(O.ofz(~F, NU.zshr_round(m, k)), t2(~F, k)), O.inv(F, t2(~F, _))) : @T}
      valA(~F, NU.zshr_round(m, k), Nat.sub(e, k), k)
    case False{}:
      %sub_add_le(k, e, KA.natle_flip(k, e, h)) : {M.ofd(~F, S.D{S.Z.mul(NU.zshr_round(m, k), S.Zpos{S.Pos.pow2(Nat.sub(k, e))}), 0n}) == @M(@M(O.ofz(~F, NU.zshr_round(m, k)), t2(~F, _)), O.inv(F, t2(~F, e))) : @T}
      valB(~F, NU.zshr_round(m, k), Nat.sub(k, e), e)

# zsr at k = j + 1
def zsr_k(~F: O.OField, +m: S.Z, +k: Nat, +j: Nat, +hk: {k == 1n+j : Nat}) -> M.bnd(~F, @S(@M(O.ofz(~F, NU.zshr_round(m, k)), t2(~F, k)), O.ofz(~F, m)), t2(~F, j)):
  %Equal.sym(Nat, k, 1n+j, hk) : M.bnd(~F, @S(@M(O.ofz(~F, NU.zshr_round(m, _)), t2(~F, k)), O.ofz(~F, m)), t2(~F, j))
  %Equal.sym(Nat, k, 1n+j, hk) : M.bnd(~F, @S(@M(O.ofz(~F, NU.zshr_round(m, 1n+j)), t2(~F, _)), O.ofz(~F, m)), t2(~F, j))
  zsr(~F, m, j)

# 2^b 2^(size p - b) <= 2 p
def size_k(~F: O.OField, +p: S.Pos, +b: Nat, +h: {KA.natle(QRD.size(p), b) == False{} : Bool}) -> O.le(~F, @M(t2(~F, b), t2(~F, Nat.sub(QRD.size(p), b))), @A(O.ofp(~F, p), O.ofp(~F, p))):
  %Equal.sym(@T, @M(t2(~F, b), t2(~F, Nat.sub(QRD.size(p), b))), t2(~F, Nat.add(b, Nat.sub(QRD.size(p), b))), t2_add(~F, b, Nat.sub(QRD.size(p), b))) : O.le(~F, _, @A(O.ofp(~F, p), O.ofp(~F, p)))
  %Equal.sym(Nat, Nat.add(b, Nat.sub(QRD.size(p), b)), QRD.size(p), add_sub(QRD.size(p), b, h)) : O.le(~F, t2(~F, _), @A(O.ofp(~F, p), O.ofp(~F, p)))
  size_lo(~F, p)

def bound_nn(~F: O.OField, +m: S.Z, +e: Nat, +b: Nat) -> O.le(~F, @0, @M(M.ofd(~F, S.D{M.zabs(m), e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}))):
  FO.mul_nonneg(~F, M.ofd(~F, S.D{M.zabs(m), e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}), DM.dabs_nonneg(~F, S.D{m, e}), FO.lt_le(~F, @0, M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}), DM.dpos(~F, S.XH{}, b)))

# m nonzero with |m| = p
def dsig_go(~F: O.OField, le: Bool, +m: S.Z, +p: S.Pos, +e: Nat, +b: Nat, +h: {KA.natle(QRD.size(p), b) == le : Bool}, ea: {O.ofz(~F, M.zabs(m)) == O.ofp(~F, p) : @T}, hn: {S.D{m, e} == NU.dznorm(S.D{m, e}) : S.D}) -> M.bnd(~F, @S(M.ofd(~F, NU.dsig.go(le, S.D{m, e}, Nat.sub(QRD.size(p), b))), M.ofd(~F, S.D{m, e})), @M(M.ofd(~F, S.D{M.zabs(m), e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}))):
  match le:
    case True{}:
      %hn : M.bnd(~F, @S(M.ofd(~F, _), M.ofd(~F, S.D{m, e})), @M(M.ofd(~F, S.D{M.zabs(m), e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})))
      KB.bnd_subself(~F, M.ofd(~F, S.D{m, e}), @M(M.ofd(~F, S.D{M.zabs(m), e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), bound_nn(~F, m, e, b))
    case False{}:
      +k = Nat.sub(QRD.size(p), b)
      +j = Nat.sub(QRD.size(p), 1n+b)
      +hk = sub_succ(QRD.size(p), b, h)
      %Equal.sym(@T, O.ofz(~F, M.zabs(m)), O.ofp(~F, p), ea) : M.bnd(~F, @S(M.ofd(~F, NU.dsig.sh(KA.natle(k, e), m, e, k)), M.ofd(~F, S.D{m, e})), @M(@M(_, O.inv(F, t2(~F, e))), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})))
      dsig_core(~F, M.ofd(~F, NU.dsig.sh(KA.natle(k, e), m, e, k)), O.ofz(~F, NU.zshr_round(m, k)), O.ofz(~F, m), t2(~F, k), t2(~F, j), t2(~F, b), O.ofp(~F, p), O.inv(F, t2(~F, e)), O.inv(F, t2(~F, b)),
        dsh_val(~F, KA.natle(k, e), m, e, k, {==}), Equal.cong(Nat, @T, z => t2(~F, z), k, 1n+j, hk), zsr_k(~F, m, k, j, hk), size_k(~F, p, b, h), inv_nn(~F, S.Pos.pow2(e)), inv_nn(~F, S.Pos.pow2(b)), QE.ofp_rel(~F, S.Pos.pow2(b)))

def dsig_z2(~F: O.OField, le: Bool, +e: Nat, +k: Nat, +b: Nat) -> M.bnd(~F, @S(M.ofd(~F, NU.dsig.sh(le, S.Z0{}, e, k)), M.ofd(~F, S.D{S.Z0{}, e})), @M(M.ofd(~F, S.D{S.Z0{}, e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}))):
  match le:
    case True{}:
      KB.bnd_val(~F, @0, @S(M.ofd(~F, S.D{S.Z0{}, Nat.sub(e, k)}), M.ofd(~F, S.D{S.Z0{}, e})), @M(M.ofd(~F, S.D{S.Z0{}, e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), @ZEQ[x=O.inv(F, t2(~F, Nat.sub(e, k))),, y=O.inv(F, t2(~F, e)) | 0 | 0*x - 0*y], FM.bnd_zero(~F, @M(M.ofd(~F, S.D{S.Z0{}, e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), bound_nn(~F, S.Z0{}, e, b)))
    case False{}:
      KB.bnd_val(~F, @0, @S(M.ofd(~F, S.D{S.Z0{}, 0n}), M.ofd(~F, S.D{S.Z0{}, e})), @M(M.ofd(~F, S.D{S.Z0{}, e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), @ZEQ[x=O.inv(F, @1),, y=O.inv(F, t2(~F, e)) | 0 | 0*x - 0*y], FM.bnd_zero(~F, @M(M.ofd(~F, S.D{S.Z0{}, e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), bound_nn(~F, S.Z0{}, e, b)))

def dsig_z(~F: O.OField, le: Bool, +e: Nat, +b: Nat) -> M.bnd(~F, @S(M.ofd(~F, NU.dsig.go(le, S.D{S.Z0{}, e}, Nat.sub(1n, b))), M.ofd(~F, S.D{S.Z0{}, e})), @M(M.ofd(~F, S.D{S.Z0{}, e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}))):
  match le:
    case True{}:
      KB.bnd_val(~F, @0, @S(M.ofd(~F, S.D{S.Z0{}, 0n}), M.ofd(~F, S.D{S.Z0{}, e})), @M(M.ofd(~F, S.D{S.Z0{}, e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), @ZEQ[x=O.inv(F, @1),, y=O.inv(F, t2(~F, e)) | 0 | 0*x - 0*y], FM.bnd_zero(~F, @M(M.ofd(~F, S.D{S.Z0{}, e}), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), bound_nn(~F, S.Z0{}, e, b)))
    case False{}:
      dsig_z2(~F, KA.natle(Nat.sub(1n, b), e), e, Nat.sub(1n, b), b)

# |dsig(x, b) - x| <= |x| 2^-b
def dsig_err(~F: O.OField, x: S.D, +b: Nat) -> M.bnd(~F, @S(M.ofd(~F, NU.dsig(x, b)), M.ofd(~F, x)), @M(M.ofd(~F, M.dabs(x)), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}))):
  match x:
    case S.D{S.Z0{}, +e}:
      dsig_z(~F, KA.natle(1n, b), e, b)
    case S.D{S.Zpos{+p}, +e}:
      dsig_go(~F, KA.natle(QRD.size(p), b), S.Zpos{p}, p, e, b, {==}, {==}, {==})
    case S.D{S.Zneg{+p}, +e}:
      dsig_go(~F, KA.natle(QRD.size(p), b), S.Zneg{p}, p, e, b, {==}, {==}, {==})

# The exponent a rational is rounded at
# -------------------------------------

def sub_zero(s: Nat, t: Nat, h: {KA.natle(t, s) == False{} : Bool}) -> {Nat.sub(s, t) == 0n : Nat}:
  match s t:
    case 0n 0n:
      FO.absurd({Nat.sub(0n, 0n) == 0n : Nat}, KA.ft(Equal.sym(Bool, True{}, False{}, h)))
    case 1n+i 0n:
      FO.absurd({Nat.sub(1n+i, 0n) == 0n : Nat}, KA.ft(Equal.sym(Bool, True{}, False{}, h)))
    case 0n 1n+q:
      {==}
    case 1n+i 1n+q:
      sub_zero(i, q, h)

def t2_mono(~F: O.OField, +a: Nat, +c: Nat) -> O.le(~F, t2(~F, a), t2(~F, Nat.add(c, a))):
  %t2_add(~F, c, a) : O.le(~F, t2(~F, a), _)
  FV.le_of_sub(~F, t2(~F, a), @M(t2(~F, c), t2(~F, a)), FM.nn_eq(~F, @S(@M(t2(~F, c), t2(~F, a)), t2(~F, a)), @M(@S(t2(~F, c), @1), t2(~F, a)), @ZEQ[c=t2(~F, c),, a=t2(~F, a) | (c - 1)*a | c*a - a], FO.mul_nonneg(~F, @S(t2(~F, c), @1), t2(~F, a), FM.sub_nonneg(~F, @1, t2(~F, c), ofp_ge1(~F, S.Pos.pow2(c))), ofp_nn(~F, S.Pos.pow2(a)))))

@ATOMS qb = dd=O.ofp(~F, d),, a=O.ofp(~F, p),, tb=t2(~F, b),, tsd=t2(~F, QRD.size(d)),, tsp=t2(~F, QRD.size(p)),, ts=t2(~F, Nat.add(b, QRD.size(d))),, te=t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p)))

def ts_split(~F: O.OField, +p: S.Pos, +d: S.Pos, +b: Nat, +h: {KA.natle(QRD.size(p), Nat.add(b, QRD.size(d))) == True{} : Bool}) -> {@M(t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))), t2(~F, QRD.size(p))) == t2(~F, Nat.add(b, QRD.size(d))) : @T}:
  %sub_add_le(Nat.add(b, QRD.size(d)), QRD.size(p), h) : {@M(t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))), t2(~F, QRD.size(p))) == t2(~F, _) : @T}
  t2_add(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p)), QRD.size(p))

# b + size d >= size p
def qb_hi(~F: O.OField, +p: S.Pos, +d: S.Pos, +b: Nat, +h: {KA.natle(QRD.size(p), Nat.add(b, QRD.size(d))) == True{} : Bool}) -> O.le(~F, @M(O.ofp(~F, d), t2(~F, b)), @M(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))))):
  FV.le_of_sub(~F, @M(O.ofp(~F, d), t2(~F, b)), @M(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p)))), FM.nn_eq(~F, @S(@M(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p)))), @M(O.ofp(~F, d), t2(~F, b))), @A(@M(t2(~F, b), @S(t2(~F, QRD.size(d)), O.ofp(~F, d))), @M(t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))), @S(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, QRD.size(p))))),
    @CERTEQ[qb | tb*(tsd - dd) + te*((a + a) - tsp) | (a + a)*te - dd*tb | 1 ; tb*tsd - ts | -1 ; te*tsp - ts || FO.sub_of_eq(~F, @M(t2(~F, b), t2(~F, QRD.size(d))), t2(~F, Nat.add(b, QRD.size(d))), t2_add(~F, b, QRD.size(d))), FO.sub_of_eq(~F, @M(t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))), t2(~F, QRD.size(p))), t2(~F, Nat.add(b, QRD.size(d))), ts_split(~F, p, d, b, h))],
    FO.nonneg_add(~F, @M(t2(~F, b), @S(t2(~F, QRD.size(d)), O.ofp(~F, d))), @M(t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))), @S(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, QRD.size(p)))),
      FO.mul_nonneg(~F, t2(~F, b), @S(t2(~F, QRD.size(d)), O.ofp(~F, d)), ofp_nn(~F, S.Pos.pow2(b)), FM.sub_nonneg(~F, O.ofp(~F, d), t2(~F, QRD.size(d)), le_of_succ(~F, O.ofp(~F, d), t2(~F, QRD.size(d)), size_hi(~F, d)))),
      FO.mul_nonneg(~F, t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))), @S(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, QRD.size(p))), ofp_nn(~F, S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p)))), FM.sub_nonneg(~F, t2(~F, QRD.size(p)), @A(O.ofp(~F, p), O.ofp(~F, p)), size_lo(~F, p))))))

def ts_mono(~F: O.OField, +p: S.Pos, +d: S.Pos, +b: Nat, +h: {KA.natle(QRD.size(p), Nat.add(b, QRD.size(d))) == False{} : Bool}) -> O.le(~F, t2(~F, Nat.add(b, QRD.size(d))), t2(~F, QRD.size(p))):
  %sub_add_le(QRD.size(p), Nat.add(b, QRD.size(d)), KA.natle_flip(QRD.size(p), Nat.add(b, QRD.size(d)), h)) : O.le(~F, t2(~F, Nat.add(b, QRD.size(d))), t2(~F, _))
  t2_mono(~F, Nat.add(b, QRD.size(d)), Nat.sub(QRD.size(p), Nat.add(b, QRD.size(d))))

@ATOMS ql = dd=O.ofp(~F, d),, a=O.ofp(~F, p),, tb=t2(~F, b),, tsd=t2(~F, QRD.size(d)),, tsp=t2(~F, QRD.size(p)),, ts=t2(~F, Nat.add(b, QRD.size(d)))

# b + size d < size p: the exponent is 0
def qb_lo(~F: O.OField, +p: S.Pos, +d: S.Pos, +b: Nat, +h: {KA.natle(QRD.size(p), Nat.add(b, QRD.size(d))) == False{} : Bool}) -> O.le(~F, @M(O.ofp(~F, d), t2(~F, b)), @M(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))))):
  %Equal.sym(Nat, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p)), 0n, sub_zero(Nat.add(b, QRD.size(d)), QRD.size(p), h)) : O.le(~F, @M(O.ofp(~F, d), t2(~F, b)), @M(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, _)))
  FV.le_of_sub(~F, @M(O.ofp(~F, d), t2(~F, b)), @M(@A(O.ofp(~F, p), O.ofp(~F, p)), @1), FM.nn_eq(~F, @S(@M(@A(O.ofp(~F, p), O.ofp(~F, p)), @1), @M(O.ofp(~F, d), t2(~F, b))), @A(@A(@M(t2(~F, b), @S(t2(~F, QRD.size(d)), O.ofp(~F, d))), @S(t2(~F, QRD.size(p)), t2(~F, Nat.add(b, QRD.size(d))))), @S(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, QRD.size(p)))),
    @CERTEQ[ql | (tb*(tsd - dd) + (tsp - ts)) + ((a + a) - tsp) | (a + a)*1 - dd*tb | 1 ; tb*tsd - ts || FO.sub_of_eq(~F, @M(t2(~F, b), t2(~F, QRD.size(d))), t2(~F, Nat.add(b, QRD.size(d))), t2_add(~F, b, QRD.size(d)))],
    FO.nonneg_add(~F, @A(@M(t2(~F, b), @S(t2(~F, QRD.size(d)), O.ofp(~F, d))), @S(t2(~F, QRD.size(p)), t2(~F, Nat.add(b, QRD.size(d))))), @S(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, QRD.size(p))),
      FO.nonneg_add(~F, @M(t2(~F, b), @S(t2(~F, QRD.size(d)), O.ofp(~F, d))), @S(t2(~F, QRD.size(p)), t2(~F, Nat.add(b, QRD.size(d)))),
        FO.mul_nonneg(~F, t2(~F, b), @S(t2(~F, QRD.size(d)), O.ofp(~F, d)), ofp_nn(~F, S.Pos.pow2(b)), FM.sub_nonneg(~F, O.ofp(~F, d), t2(~F, QRD.size(d)), le_of_succ(~F, O.ofp(~F, d), t2(~F, QRD.size(d)), size_hi(~F, d)))),
        FM.sub_nonneg(~F, t2(~F, Nat.add(b, QRD.size(d))), t2(~F, QRD.size(p)), ts_mono(~F, p, d, b, h))),
      FM.sub_nonneg(~F, t2(~F, QRD.size(p)), @A(O.ofp(~F, p), O.ofp(~F, p)), size_lo(~F, p)))))

def qbound.go(~F: O.OField, le: Bool, +p: S.Pos, +d: S.Pos, +b: Nat, h: {KA.natle(QRD.size(p), Nat.add(b, QRD.size(d))) == le : Bool}) -> O.le(~F, @M(O.ofp(~F, d), t2(~F, b)), @M(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))))):
  match le:
    case True{}:
      qb_hi(~F, p, d, b, h)
    case False{}:
      qb_lo(~F, p, d, b, h)

# d 2^b <= 2 p 2^E for the exponent E = (b + size d) - size p a rational
# p / d is rounded at
def qbound(~F: O.OField, +p: S.Pos, +d: S.Pos, +b: Nat) -> O.le(~F, @M(O.ofp(~F, d), t2(~F, b)), @M(@A(O.ofp(~F, p), O.ofp(~F, p)), t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))))):
  qbound.go(~F, KA.natle(QRD.size(p), Nat.add(b, QRD.size(d))), p, d, b, {==})

# Rounding a rational
# -------------------

def w_eq(~F: O.OField, +n: S.Z, +d: S.Pos, +e: Nat) -> {O.ofz(~F, S.Z.add(S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), S.Zpos{d})) == @A(@A(@M(O.ofz(~F, n), t2(~F, e)), @M(O.ofz(~F, n), t2(~F, e))), O.ofp(~F, d)) : @T}:
  %FR.ofz_add(~F, S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), S.Zpos{d}) : {_ == @A(@A(@M(O.ofz(~F, n), t2(~F, e)), @M(O.ofz(~F, n), t2(~F, e))), O.ofp(~F, d)) : @T}
  %Equal.sym(@T, O.ofz(~F, S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)}))), @A(O.ofz(~F, S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), O.ofz(~F, S.Z.mul(n, S.Zpos{S.Pos.pow2(e)}))), ofz_double(~F, S.Z.mul(n, S.Zpos{S.Pos.pow2(e)}))) : {@A(_, O.ofp(~F, d)) == @A(@A(@M(O.ofz(~F, n), t2(~F, e)), @M(O.ofz(~F, n), t2(~F, e))), O.ofp(~F, d)) : @T}
  %FR.ofz_mul(~F, n, S.Zpos{S.Pos.pow2(e)}) : {@A(@A(_, O.ofz(~F, S.Z.mul(n, S.Zpos{S.Pos.pow2(e)}))), O.ofp(~F, d)) == @A(@A(@M(O.ofz(~F, n), t2(~F, e)), @M(O.ofz(~F, n), t2(~F, e))), O.ofp(~F, d)) : @T}
  %FR.ofz_mul(~F, n, S.Zpos{S.Pos.pow2(e)}) : {@A(@A(@M(O.ofz(~F, n), t2(~F, e)), _), O.ofp(~F, d)) == @A(@A(@M(O.ofz(~F, n), t2(~F, e)), @M(O.ofz(~F, n), t2(~F, e))), O.ofp(~F, d)) : @T}
  {==}

@ATOMS qr = f,, nv,, dd,, te,, ie,, id,, i2

# f = floor((2 n 2^e + d) / 2d) is within 2^-(e+1) of n / d, at scale 2^-e
def qr_core(~F: O.OField, +f: @T, +nv: @T, +dd: @T, +te: @T, +ie: @T, +id: @T, +i2: @T, h1: O.le(~F, @M(f, @A(dd, dd)), @A(@A(@M(nv, te), @M(nv, te)), dd)), h2: O.le(~F, @A(@A(@A(@M(nv, te), @M(nv, te)), dd), @1), @M(@A(f, @1), @A(dd, dd))), +rd: {@S(@M(dd, id), @1) == @0 : @T}, +re: {@S(@M(te, ie), @1) == @0 : @T}, +r2: {@S(@M(@A(te, te), i2), @1) == @0 : @T}, +hid: O.le(~F, @0, id), +hi2: O.le(~F, @0, i2)) -> M.bnd(~F, @S(@M(f, ie), @M(nv, id)), @M(@1, i2)):
  KB.bnd_val(~F, @M(@A(@S(@M(f, dd), @M(nv, te)), @S(@M(f, dd), @M(nv, te))), @M(i2, id)), @S(@M(f, ie), @M(nv, id)), @M(@1, i2),
    @CERTEQ[qr | ((f*dd - nv*te) + (f*dd - nv*te))*(i2*id) | f*ie - nv*id | (1 + 1)*f*i2 ; dd*id - 1 | -((1 + 1)*f*i2) ; te*ie - 1 | f*ie - nv*id ; (te + te)*i2 - 1 || rd, re, r2],
    FM.bnd_eq(~F, @M(@A(@S(@M(f, dd), @M(nv, te)), @S(@M(f, dd), @M(nv, te))), @M(i2, id)), @M(dd, @M(i2, id)), @M(@1, i2), @CERTEQ[qr | dd*(i2*id) | 1*i2 | i2 ; dd*id - 1 || rd],
      bnd_scale(~F, @A(@S(@M(f, dd), @M(nv, te)), @S(@M(f, dd), @M(nv, te))), dd, @M(i2, id), FO.mul_nonneg(~F, i2, id, hi2, hid),
        (FM.nn_eq(~F, @S(dd, @A(@S(@M(f, dd), @M(nv, te)), @S(@M(f, dd), @M(nv, te)))), @S(@A(@A(@M(nv, te), @M(nv, te)), dd), @M(f, @A(dd, dd))), @ZEQ[f,, nv,, dd,, te | ((nv*te + nv*te) + dd) - f*(dd + dd) | dd - ((f*dd - nv*te) + (f*dd - nv*te))], FM.sub_nonneg(~F, @M(f, @A(dd, dd)), @A(@A(@M(nv, te), @M(nv, te)), dd), h1)),
         FM.nn_eq(~F, @A(dd, @A(@S(@M(f, dd), @M(nv, te)), @S(@M(f, dd), @M(nv, te)))), @A(@S(@M(@A(f, @1), @A(dd, dd)), @A(@A(@A(@M(nv, te), @M(nv, te)), dd), @1)), @1), @ZEQ[f,, nv,, dd,, te | ((f + 1)*(dd + dd) - (((nv*te + nv*te) + dd) + 1)) + 1 | dd + ((f*dd - nv*te) + (f*dd - nv*te))], FO.nonneg_add(~F, @S(@M(@A(f, @1), @A(dd, dd)), @A(@A(@A(@M(nv, te), @M(nv, te)), dd), @1)), @1, FM.sub_nonneg(~F, @A(@A(@A(@M(nv, te), @M(nv, te)), dd), @1), @M(@A(f, @1), @A(dd, dd)), h2), FO.one_nn(~F)))))))

# n / d rounded to a multiple of 2^-e is within 2^-(e+1)
def qround_err(~F: O.OField, +n: S.Z, +d: S.Pos, +e: Nat) -> M.bnd(~F, @S(M.ofd(~F, NU.qround(S.Q{n, d}, e)), O.ofq(~F, S.Q{n, d})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+e})):
  +h = zfloor_ok(~F, S.Z.add(S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), S.Zpos{d}), S.XO{d})
  qr_core(~F, O.ofz(~F, NU.zfloor(S.Z.add(S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), S.Zpos{d}), S.XO{d})), O.ofz(~F, n), O.ofp(~F, d), t2(~F, e), O.inv(F, t2(~F, e)), O.inv(F, O.ofp(~F, d)), O.inv(F, t2(~F, 1n+e)),
    (%w_eq(~F, n, d, e) : O.le(~F, @M(O.ofz(~F, NU.zfloor(S.Z.add(S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), S.Zpos{d}), S.XO{d})), @A(O.ofp(~F, d), O.ofp(~F, d))), _)
      zfl_1(~F, S.Z.add(S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), S.Zpos{d}), S.XO{d}, NU.zfloor(S.Z.add(S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), S.Zpos{d}), S.XO{d}), h)),
    (%w_eq(~F, n, d, e) : O.le(~F, @A(_, @1), @M(@A(O.ofz(~F, NU.zfloor(S.Z.add(S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), S.Zpos{d}), S.XO{d})), @1), @A(O.ofp(~F, d), O.ofp(~F, d))))
      zfl_2(~F, S.Z.add(S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), S.Zpos{d}), S.XO{d}, NU.zfloor(S.Z.add(S.Z.double(S.Z.mul(n, S.Zpos{S.Pos.pow2(e)})), S.Zpos{d}), S.XO{d}), h)),
    QE.ofp_rel(~F, d), QE.ofp_rel(~F, S.Pos.pow2(e)), QE.ofp_rel(~F, S.Pos.pow2(1n+e)), inv_nn(~F, d), inv_nn(~F, S.Pos.pow2(1n+e)))

@ATOMS qx = a=O.ofp(~F, p),, dd=O.ofp(~F, d),, tb=t2(~F, b),, te=t2(~F, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))),, id=O.inv(F, O.ofp(~F, d)),, ib=O.inv(F, t2(~F, b)),, i2=O.inv(F, t2(~F, 1n+Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))))

# 2^-(E+1) <= (p / d) 2^-b at the exponent E p / d is rounded at
def qrel(~F: O.OField, +p: S.Pos, +d: S.Pos, +b: Nat) -> O.le(~F, @M(@1, O.inv(F, t2(~F, 1n+Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))))), @M(@M(O.ofp(~F, p), O.inv(F, O.ofp(~F, d))), @M(@1, O.inv(F, t2(~F, b))))):
  FV.le_of_sub(~F, @FT[qx | 1*i2], @FT[qx | (a*id)*(1*ib)], FM.nn_eq(~F, @FT[qx | (a*id)*(1*ib) - 1*i2], @FT[qx | ((id*ib)*i2)*((a + a)*te - dd*tb)],
    @CERTEQ[qx | ((id*ib)*i2)*((a + a)*te - dd*tb) | (a*id)*(1*ib) - 1*i2 | a*id*ib ; (te + te)*i2 - 1 | -(i2*tb*ib) ; dd*id - 1 | -i2 ; tb*ib - 1 || QE.ofp_rel(~F, S.Pos.pow2(1n+Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p)))), QE.ofp_rel(~F, d), QE.ofp_rel(~F, S.Pos.pow2(b))],
    FO.mul_nonneg(~F, @FT[qx | (id*ib)*i2], @FT[qx | (a + a)*te - dd*tb], FO.mul_nonneg(~F, @FT[qx | id*ib], @FT[qx | i2], FO.mul_nonneg(~F, @FT[qx | id], @FT[qx | ib], inv_nn(~F, d), inv_nn(~F, S.Pos.pow2(b))), inv_nn(~F, S.Pos.pow2(1n+Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))))), FM.sub_nonneg(~F, @FT[qx | dd*tb], @FT[qx | (a + a)*te], qbound(~F, p, d, b)))))

def bnd_hi(~F: O.OField, +v: @T, +s: @T, h: M.bnd(~F, v, s)) -> O.le(~F, @N(v), s):
  (h1, h2) = h
  FV.le_of_sub(~F, @N(v), s, FM.nn_eq(~F, @S(s, @N(v)), @A(s, v), @ZEQ[v,, s | s + v | s - (-v)], h2))

# the error bound 2^-(E+1) is at most |q| 2^-b, given a <= fabs q
def qsig_fin(~F: O.OField, +n: S.Z, +p: S.Pos, +d: S.Pos, +b: Nat, ha: O.le(~F, @M(O.ofp(~F, p), O.inv(F, O.ofp(~F, d))), FV.fabs(~F, O.ofq(~F, S.Q{n, d})))) -> M.bnd(~F, @S(M.ofd(~F, NU.qround(S.Q{n, d}, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p)))), O.ofq(~F, S.Q{n, d})), @M(FV.fabs(~F, O.ofq(~F, S.Q{n, d})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}))):
  FM.bnd_mono(~F, @S(M.ofd(~F, NU.qround(S.Q{n, d}, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p)))), O.ofq(~F, S.Q{n, d})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))}), @M(FV.fabs(~F, O.ofq(~F, S.Q{n, d})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), qround_err(~F, n, d, Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))),
    FM.sub_nonneg(~F, M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))}), @M(FV.fabs(~F, O.ofq(~F, S.Q{n, d})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), DM.le_trans(~F, M.ofd(~F, S.D{S.Zpos{S.XH{}}, 1n+Nat.sub(Nat.add(b, QRD.size(d)), QRD.size(p))}), @M(@M(O.ofp(~F, p), O.inv(F, O.ofp(~F, d))), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), @M(FV.fabs(~F, O.ofq(~F, S.Q{n, d})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), qrel(~F, p, d, b),
      FV.mul_le_r(~F, @M(O.ofp(~F, p), O.inv(F, O.ofp(~F, d))), FV.fabs(~F, O.ofq(~F, S.Q{n, d})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}), FO.lt_le(~F, @0, M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}), DM.dpos(~F, S.XH{}, b)), ha))))

# -(-p / d) <= fabs(-p / d)
def neg_le(~F: O.OField, +p: S.Pos, +d: S.Pos) -> O.le(~F, @M(O.ofp(~F, p), O.inv(F, O.ofp(~F, d))), FV.fabs(~F, O.ofq(~F, S.Q{S.Zneg{p}, d}))):
  %@ZEQ[a=O.ofp(~F, p),, i=O.inv(F, O.ofp(~F, d)) | -((-a)*i) | a*i] : O.le(~F, _, FV.fabs(~F, O.ofq(~F, S.Q{S.Zneg{p}, d})))
  bnd_hi(~F, O.ofq(~F, S.Q{S.Zneg{p}, d}), FV.fabs(~F, O.ofq(~F, S.Q{S.Zneg{p}, d})), FV.fabs_bnd(~F, O.ofq(~F, S.Q{S.Zneg{p}, d})))

# |qsig(q, b) - q| <= |q| 2^-b
def qsig_err(~F: O.OField, x: S.Q, +b: Nat) -> M.bnd(~F, @S(M.ofd(~F, NU.qsig(x, b)), O.ofq(~F, x)), @M(FV.fabs(~F, O.ofq(~F, x)), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}))):
  match x:
    case S.Q{S.Z0{}, +d}:
      KB.bnd_val(~F, @0, @S(M.ofd(~F, S.D{S.Z0{}, 0n}), O.ofq(~F, S.Q{S.Z0{}, d})), @M(FV.fabs(~F, O.ofq(~F, S.Q{S.Z0{}, d})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), @ZEQ[x=O.inv(F, @1),, y=O.inv(F, O.ofp(~F, d)) | 0 | 0*x - 0*y], FM.bnd_zero(~F, @M(FV.fabs(~F, O.ofq(~F, S.Q{S.Z0{}, d})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b})), FO.mul_nonneg(~F, FV.fabs(~F, O.ofq(~F, S.Q{S.Z0{}, d})), M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}), FV.fabs_nn(~F, O.ofq(~F, S.Q{S.Z0{}, d})), FO.lt_le(~F, @0, M.ofd(~F, S.D{S.Zpos{S.XH{}}, b}), DM.dpos(~F, S.XH{}, b)))))
    case S.Q{S.Zpos{+p}, +d}:
      qsig_fin(~F, S.Zpos{p}, p, d, b, FV.bnd_lo(~F, @M(O.ofp(~F, p), O.inv(F, O.ofp(~F, d))), FV.fabs(~F, O.ofq(~F, S.Q{S.Zpos{p}, d})), FV.fabs_bnd(~F, O.ofq(~F, S.Q{S.Zpos{p}, d}))))
    case S.Q{S.Zneg{+p}, +d}:
      qsig_fin(~F, S.Zneg{p}, p, d, b, neg_le(~F, p, d))

# Rounding up
# -----------

@ATOMS qc = g,, nv,, te,, tt,, ie,, it

# c = -floor(-n 2^E / 2^e): 0 <= c / 2^E - n / 2^e <= 2^-E
def qc_core(~F: O.OField, +g: @T, +nv: @T, +te: @T, +tt: @T, +ie: @T, +it: @T, h1: O.le(~F, @M(g, te), @N(@M(nv, tt))), h2: O.le(~F, @A(@N(@M(nv, tt)), @1), @M(@A(g, @1), te)), +re: {@S(@M(te, ie), @1) == @0 : @T}, +rt: {@S(@M(tt, it), @1) == @0 : @T}, +hie: O.le(~F, @0, ie), +hit: O.le(~F, @0, it)) -> M.Both(O.le(~F, @M(nv, ie), @M(@N(g), it)), O.le(~F, @S(@M(@N(g), it), @M(nv, ie)), @M(@1, it))):
  (FV.le_of_sub(~F, @M(nv, ie), @M(@N(g), it), FM.nn_eq(~F, @S(@M(@N(g), it), @M(nv, ie)), @M(@M(@S(@N(@M(nv, tt)), @M(g, te)), ie), it), @CERTEQ[qc | (((-(nv*tt)) - g*te)*ie)*it | (-g)*it - nv*ie | -(g*it) ; te*ie - 1 | -(nv*ie) ; tt*it - 1 || re, rt], FO.mul_nonneg(~F, @M(@S(@N(@M(nv, tt)), @M(g, te)), ie), it, FO.mul_nonneg(~F, @S(@N(@M(nv, tt)), @M(g, te)), ie, FM.sub_nonneg(~F, @M(g, te), @N(@M(nv, tt)), h1), hie), hit))),
   FV.le_of_sub(~F, @S(@M(@N(g), it), @M(nv, ie)), @M(@1, it), FM.nn_eq(~F, @S(@M(@1, it), @S(@M(@N(g), it), @M(nv, ie))), @M(@M(@S(te, @S(@N(@M(nv, tt)), @M(g, te))), ie), it), @CERTEQ[qc | ((te - ((-(nv*tt)) - g*te))*ie)*it | 1*it - ((-g)*it - nv*ie) | (1 + g)*it ; te*ie - 1 | nv*ie ; tt*it - 1 || re, rt],
     FO.mul_nonneg(~F, @M(@S(te, @S(@N(@M(nv, tt)), @M(g, te))), ie), it, FO.mul_nonneg(~F, @S(te, @S(@N(@M(nv, tt)), @M(g, te))), ie, FM.nn_eq(~F, @S(te, @S(@N(@M(nv, tt)), @M(g, te))), @A(@S(@M(@A(g, @1), te), @A(@N(@M(nv, tt)), @1)), @1), @ZEQ[qc | ((g + 1)*te - ((-(nv*tt)) + 1)) + 1 | te - ((-(nv*tt)) - g*te)], FO.nonneg_add(~F, @S(@M(@A(g, @1), te), @A(@N(@M(nv, tt)), @1)), @1, FM.sub_nonneg(~F, @A(@N(@M(nv, tt)), @1), @M(@A(g, @1), te), h2), FO.one_nn(~F))), hie), hit))))

def qc_1(~F: O.OField, +g: @T, +nv: @T, +ie: @T, +it: @T, h: M.Both(O.le(~F, @M(nv, ie), @M(@N(g), it)), O.le(~F, @S(@M(@N(g), it), @M(nv, ie)), @M(@1, it)))) -> O.le(~F, @M(nv, ie), @M(@N(g), it)):
  (a, b) = h
  a

def qc_2(~F: O.OField, +g: @T, +nv: @T, +ie: @T, +it: @T, h: M.Both(O.le(~F, @M(nv, ie), @M(@N(g), it)), O.le(~F, @S(@M(@N(g), it), @M(nv, ie)), @M(@1, it)))) -> O.le(~F, @S(@M(@N(g), it), @M(nv, ie)), @M(@1, it)):
  (a, b) = h
  b

def nm_eq(~F: O.OField, +m: S.Z, +k: Nat) -> {O.ofz(~F, S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)}))) == @N(@M(O.ofz(~F, m), t2(~F, k))) : @T}:
  %FR.ofz_neg(~F, S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})) : {_ == @N(@M(O.ofz(~F, m), t2(~F, k))) : @T}
  %FR.ofz_mul(~F, m, S.Zpos{S.Pos.pow2(k)}) : {@N(_) == @N(@M(O.ofz(~F, m), t2(~F, k))) : @T}
  {==}

@ATOMS du = a=O.ofp(~F, p),, te=t2(~F, e),, tb=t2(~F, b),, tt=t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))),, ie=O.inv(F, t2(~F, e)),, ib=O.inv(F, t2(~F, b)),, it=O.inv(F, t2(~F, Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))))

# 2^-E <= (p / 2^e) 2^(1-b) at the exponent E dsigup rounds p / 2^e at
def dur(~F: O.OField, +p: S.Pos, +e: Nat, +b: Nat) -> O.le(~F, @FT[du | 1*it], @FT[du | (a*ie)*((1 + 1)*ib)]):
  FV.le_of_sub(~F, @FT[du | 1*it], @FT[du | (a*ie)*((1 + 1)*ib)], FM.nn_eq(~F, @FT[du | (a*ie)*((1 + 1)*ib) - 1*it], @FT[du | ((ie*ib)*it)*((a + a)*tt - te*tb)],
    @CERTEQ[du | ((ie*ib)*it)*((a + a)*tt - te*tb) | (a*ie)*((1 + 1)*ib) - 1*it | (a + a)*ie*ib ; tt*it - 1 | -(it*tb*ib) ; te*ie - 1 | -it ; tb*ib - 1 || QE.ofp_rel(~F, S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p)))), QE.ofp_rel(~F, S.Pos.pow2(e)), QE.ofp_rel(~F, S.Pos.pow2(b))],
    FO.mul_nonneg(~F, @FT[du | (ie*ib)*it], @FT[du | (a + a)*tt - te*tb], FO.mul_nonneg(~F, @FT[du | ie*ib], @FT[du | it], FO.mul_nonneg(~F, @FT[du | ie], @FT[du | ib], inv_nn(~F, S.Pos.pow2(e)), inv_nn(~F, S.Pos.pow2(b))), inv_nn(~F, S.Pos.pow2(Nat.sub(Nat.add(b, QRD.size(S.Pos.pow2(e))), QRD.size(p))))), FM.sub_nonneg(~F, @FT[du | te*tb], @FT[du | (a + a)*tt], qbound(~F, p, S.Pos.pow2(e), b)))))

@ATOMS gz = g=O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e)))

def dsu_h1(~F: O.OField, +m: S.Z, +e: Nat, +k: Nat, h: zfl(~F, S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e), NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e)))) -> O.le(~F, @M(O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e))), t2(~F, e)), @N(@M(O.ofz(~F, m), t2(~F, k)))):
  %nm_eq(~F, m, k) : O.le(~F, @M(O.ofz(~F, NU.zfloor(S.Z.neg(S.Z.mul(m, S.Zpos{S.Pos.pow2(k)})), S.Pos.pow2(e))), t2(~F, e)), _)
