# The plan checker, run by Bend's own checker on a two-block plan over the
# dyadics (tests/chain_data.bend, generated by tools/gen_chain.py): pinned
# A = (0, 0), B = (4, 0); P with |P - A| = |P - B| = 3; Q with
# |Q - A| = |Q - P| = 3. It accepts the plan and rejects the one with Q's
# center moved by 1/4. Natively (proto/chain_run.bend) it also rejects six
# malformed plans: a block missing, blocks swapped, a pin missing, a
# parameter missing, a wrong parameter, a later variable as a parameter.

import Base
import ../lib/kinst.bend as KI
import ../lib/plan.bend as PL
import ./chain_data.bend as D

def accepts() -> {PL.check(~KI.dnum(), D.ch_eqs(), D.ch_gc(), D.ch_gr(), D.ch_plan()) == True{} : Bool}:
  {==}

def rejects_off_center() -> {PL.check(~KI.dnum(), D.ch_eqs(), D.ch_gc_bad(), D.ch_gr(), D.ch_plan_bad()) == False{} : Bool}:
  {==}

# the same system numbered otherwise (Q, A, P, B; equations shuffled), read
# in block order through the plan's lists
def accepts_reordered() -> {PL.check(~KI.dnum(), D.ch2_eqs(), D.ch2_gc(), D.ch2_gr(), D.ch2_plan()) == True{} : Bool}:
  {==}

def rejects_wrong_order() -> {PL.check(~KI.dnum(), D.ch2_eqs(), D.ch2_gc(), D.ch2_gr(), D.ch_plan()) == False{} : Bool}:
  {==}
