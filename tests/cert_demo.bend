# The block certificate checker, run by Bend's own checker on a real block:
# a circle-circle block over the dyadics (tests/cc_data.bend, generated by
# tools/gen_cc.py). It accepts the certificate centered at (2, sqrt 5) and
# rejects the same certificate centered at (2, 2.3).

import Base
import ../lib/kinst.bend as KI
import ../lib/cert.bend as CK
import ./cc_data.bend as D

def accepts() -> {CK.check(~KI.dnum(), D.cc_block(), D.cc_cert()) == True{} : Bool}:
  {==}

def rejects_off_center() -> {CK.check(~KI.dnum(), D.cc_block(), D.cc_bad_cert()) == False{} : Bool}:
  {==}
