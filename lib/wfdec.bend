# bend-cad: deciding whether a sketch is well formed (DESIGN §10.1, stage
# 1). wf_dec computes a Bool; wf_ok proves that True means Sketch.wf (every
# reference names an entity of the right kind; merges are equations, D3 as
# revised, so they ask nothing more), so the solver can certify a sketch
# only when its laws' hypothesis holds. (The converse, that a well-formed sketch is never
# refused, belongs with solve_total.)

import Base
import ../spec/sketch.bend as SK
import ./karith.bend as KA

def absurd(-A: Type, x: Empty) -> A:
  match x:

# Points
# ------

def ispt(+es: List<&2, SK.Ent>, +id: Nat) -> Bool:
  SK.is_pt(SK.find(id, es))

def isseg(+es: List<&2, SK.Ent>, +id: Nat) -> Bool:
  SK.is_seg(SK.find(id, es))

def iscirc(+es: List<&2, SK.Ent>, +id: Nat) -> Bool:
  SK.is_circ(SK.find(id, es))

# Entities
# --------

def ent(+es: List<&2, SK.Ent>, e: SK.Ent) -> Bool:
  match e:
    case SK.Ent{id, cst, SK.GPoint{x, y}}:
      True{}
    case SK.Ent{id, cst, SK.GSeg{p, q}}:
      KA.band(ispt(es, p), ispt(es, q))
    case SK.Ent{id, cst, SK.GCirc{c, r}}:
      ispt(es, c)
    case SK.Ent{id, cst, SK.GArc{s, f, b}}:
      KA.band(ispt(es, s), ispt(es, f))

def ent_ok(+es: List<&2, SK.Ent>, e: SK.Ent, +h: {ent(es, e) == True{} : Bool}) -> SK.Ent.wf_refs(es, e):
  match e:
    case SK.Ent{id, cst, SK.GPoint{x, y}}:
      Unit{}
    case SK.Ent{id, cst, SK.GSeg{+p, +q}}:
      (KA.band_l(ispt(es, p), ispt(es, q), h), KA.band_r(ispt(es, p), ispt(es, q), h))
    case SK.Ent{id, cst, SK.GCirc{+c, r}}:
      h
    case SK.Ent{id, cst, SK.GArc{+s, +f, b}}:
      (KA.band_l(ispt(es, s), ispt(es, f), h), KA.band_r(ispt(es, s), ispt(es, f), h))

# Constraints
# -----------
# Generated by a scratch script from the table of Constraint.wf_refs and
# Constraint.wf (spec/sketch.bend): references (Constraint.wf asks nothing
# more).

def crefs(+es: List<&2, SK.Ent>, k: SK.Constraint) -> Bool:
  match k:
    case SK.Coincident{a, b}:
      KA.band(ispt(es, a), ispt(es, b))
    case SK.Horizontal{a, b}:
      KA.band(ispt(es, a), ispt(es, b))
    case SK.Vertical{a, b}:
      KA.band(ispt(es, a), ispt(es, b))
    case SK.Concentric{a, b}:
      KA.band(iscirc(es, a), iscirc(es, b))
    case SK.EqualRadius{a, b}:
      KA.band(iscirc(es, a), iscirc(es, b))
    case SK.Fix{v, c}:
      True{}
    case SK.Distance{p, q, d}:
      KA.band(ispt(es, p), ispt(es, q))
    case SK.HDistance{p, q, d}:
      KA.band(ispt(es, p), ispt(es, q))
    case SK.VDistance{p, q, d}:
      KA.band(ispt(es, p), ispt(es, q))
    case SK.Radius{c, d}:
      iscirc(es, c)
    case SK.Diameter{c, d}:
      iscirc(es, c)
    case SK.LineDistance{p, a, rev, d, l}:
      KA.band(ispt(es, p), isseg(es, a))
    case SK.Angle{a, ra, b, rb, c, s}:
      KA.band(isseg(es, a), isseg(es, b))
    case SK.EqualLength{a, b}:
      KA.band(isseg(es, a), isseg(es, b))
    case SK.Perpendicular{a, b}:
      KA.band(isseg(es, a), isseg(es, b))
    case SK.Parallel{a, b}:
      KA.band(isseg(es, a), isseg(es, b))
    case SK.OnLine{p, a}:
      KA.band(ispt(es, p), isseg(es, a))
    case SK.OnCircle{p, c}:
      KA.band(ispt(es, p), iscirc(es, c))
    case SK.Midpoint{m, a}:
      KA.band(ispt(es, m), isseg(es, a))
    case SK.Symmetric{p, q, a}:
      KA.band(ispt(es, p), KA.band(ispt(es, q), isseg(es, a)))

def crefs_ok(+es: List<&2, SK.Ent>, k: SK.Constraint, +h: {crefs(es, k) == True{} : Bool}) -> SK.Constraint.wf_refs(es, k):
  match k:
    case SK.Coincident{+a, +b}:
      (KA.band_l(ispt(es, a), ispt(es, b), h), KA.band_r(ispt(es, a), ispt(es, b), h))
    case SK.Horizontal{+a, +b}:
      (KA.band_l(ispt(es, a), ispt(es, b), h), KA.band_r(ispt(es, a), ispt(es, b), h))
    case SK.Vertical{+a, +b}:
      (KA.band_l(ispt(es, a), ispt(es, b), h), KA.band_r(ispt(es, a), ispt(es, b), h))
    case SK.Concentric{+a, +b}:
      (KA.band_l(iscirc(es, a), iscirc(es, b), h), KA.band_r(iscirc(es, a), iscirc(es, b), h))
    case SK.EqualRadius{+a, +b}:
      (KA.band_l(iscirc(es, a), iscirc(es, b), h), KA.band_r(iscirc(es, a), iscirc(es, b), h))
    case SK.Fix{v, c}:
      Unit{}
    case SK.Distance{+p, +q, d}:
      (KA.band_l(ispt(es, p), ispt(es, q), h), KA.band_r(ispt(es, p), ispt(es, q), h))
    case SK.HDistance{+p, +q, d}:
      (KA.band_l(ispt(es, p), ispt(es, q), h), KA.band_r(ispt(es, p), ispt(es, q), h))
    case SK.VDistance{+p, +q, d}:
      (KA.band_l(ispt(es, p), ispt(es, q), h), KA.band_r(ispt(es, p), ispt(es, q), h))
    case SK.Radius{c, d}:
      h
    case SK.Diameter{c, d}:
      h
    case SK.LineDistance{+p, +a, rev, d, l}:
      (KA.band_l(ispt(es, p), isseg(es, a), h), KA.band_r(ispt(es, p), isseg(es, a), h))
    case SK.Angle{+a, ra, +b, rb, c, s}:
      (KA.band_l(isseg(es, a), isseg(es, b), h), KA.band_r(isseg(es, a), isseg(es, b), h))
    case SK.EqualLength{+a, +b}:
      (KA.band_l(isseg(es, a), isseg(es, b), h), KA.band_r(isseg(es, a), isseg(es, b), h))
    case SK.Perpendicular{+a, +b}:
      (KA.band_l(isseg(es, a), isseg(es, b), h), KA.band_r(isseg(es, a), isseg(es, b), h))
    case SK.Parallel{+a, +b}:
      (KA.band_l(isseg(es, a), isseg(es, b), h), KA.band_r(isseg(es, a), isseg(es, b), h))
    case SK.OnLine{+p, +a}:
      (KA.band_l(ispt(es, p), isseg(es, a), h), KA.band_r(ispt(es, p), isseg(es, a), h))
    case SK.OnCircle{+p, +c}:
      (KA.band_l(ispt(es, p), iscirc(es, c), h), KA.band_r(ispt(es, p), iscirc(es, c), h))
    case SK.Midpoint{+m, +a}:
      (KA.band_l(ispt(es, m), isseg(es, a), h), KA.band_r(ispt(es, m), isseg(es, a), h))
    case SK.Symmetric{+p, +q, +a}:
      (KA.band_l(ispt(es, p), KA.band(ispt(es, q), isseg(es, a)), h), (KA.band_l(ispt(es, q), isseg(es, a), KA.band_r(ispt(es, p), KA.band(ispt(es, q), isseg(es, a)), h)), KA.band_r(ispt(es, q), isseg(es, a), KA.band_r(ispt(es, p), KA.band(ispt(es, q), isseg(es, a)), h))))

# Sketches
# --------

def ents(+es: List<&2, SK.Ent>, xs: List<&2, SK.Ent>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{e, t}:
      KA.band(ent(es, e), ents(es, t))

def ents_ok(+es: List<&2, SK.Ent>, xs: List<&2, SK.Ent>, +h: {ents(es, xs) == True{} : Bool}) -> SK.Sketch.wf.ents(es, xs):
  match xs:
    case Nil{}:
      Unit{}
    case Con{+e, +t}:
      (ent_ok(es, e, KA.band_l(ent(es, e), ents(es, t), h)), ents_ok(es, t, KA.band_r(ent(es, e), ents(es, t), h)))

def cons(+es: List<&2, SK.Ent>, cs: List<&2, SK.Rec>) -> Bool:
  match cs:
    case Nil{}:
      True{}
    case Con{SK.Rec{id, dr, +k}, t}:
      KA.band(crefs(es, k), cons(es, t))

def cons_ok(+es: List<&2, SK.Ent>, cs: List<&2, SK.Rec>, +h: {cons(es, cs) == True{} : Bool}) -> SK.Sketch.wf.cons(es, cs):
  match cs:
    case Nil{}:
      Unit{}
    case Con{SK.Rec{id, dr, +k}, +t}:
      (crefs_ok(es, k, KA.band_l(crefs(es, k), cons(es, t), h)), (Unit{}, cons_ok(es, t, KA.band_r(crefs(es, k), cons(es, t), h))))

# the sketch is well formed
def wf_dec(sk: SK.Sketch) -> Bool:
  match sk:
    case SK.Sketch{vs, +es, cs}:
      KA.band(ents(es, es), cons(es, cs))

def wf_ok(sk: SK.Sketch, +h: {wf_dec(sk) == True{} : Bool}) -> SK.Sketch.wf(sk):
  match sk:
    case SK.Sketch{vs, +es, +cs}:
      (ents_ok(es, es, KA.band_l(ents(es, es), cons(es, cs), h)), cons_ok(es, cs, KA.band_r(ents(es, es), cons(es, cs), h)))
