# The verdict
# -----------


# the verdict in K on the mapped answer is the draft's
def final2_c(~K: N.Num, ~W: PO.POps<K>, ~R: PO.PLaws<K, W>, +sk: SK.Sketch, +g0: List<&2, S.D>, +ok: Bool, +cls: List<&2, SV.Class>, +pins: List<&2, Nat>, +gc: List<&2, S.D>, +gr: List<&2, S.D>, +p: PL.Plan<KI.dnum()>) -> {DWF.final2(~K, ~W, sk, g0, FS.FOut{ok, cls, pins, KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gc), KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gr), KH.hplan(~KI.dnum(), ~K, ~PO.hom(K, W, R), p)}) == DSO.final2(sk, g0, SO.Out{ok, cls, pins, gc, gr, p}) : Bool}:
  %FP.final_c(~K, ~W, ~R, sk, g0, ok, cls, pins, gc, gr, p) : {KA.band(PL.check_sides(~K, DR.ndsides(SV.ents(sk), SV.live_nd(cls)), KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gc), KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gr)), FS.checks(~K, ~W, sk, g0, FS.FOut{ok, cls, pins, KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gc), KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gr), KH.hplan(~KI.dnum(), ~K, ~PO.hom(K, W, R), p)})) == KA.band(PL.check_sides(~KI.dnum(), DR.ndsides(SV.ents(sk), SV.live_nd(cls)), gc, gr), _) : Bool}
  %PH.check_sides_h(~KI.dnum(), ~K, ~PO.hom(K, W, R), DR.ndsides(SV.ents(sk), SV.live_nd(cls)), gc, gr) : {KA.band(PL.check_sides(~K, DR.ndsides(SV.ents(sk), SV.live_nd(cls)), KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gc), KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gr)), FS.checks(~K, ~W, sk, g0, FS.FOut{ok, cls, pins, KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gc), KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gr), KH.hplan(~KI.dnum(), ~K, ~PO.hom(K, W, R), p)})) == KA.band(_, FS.checks(~K, ~W, sk, g0, FS.FOut{ok, cls, pins, KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gc), KH.hv(~KI.dnum(), ~K, ~PO.hom(K, W, R), gr), KH.hplan(~KI.dnum(), ~K, ~PO.hom(K, W, R), p)})) : Bool}
  {==}

def accept2_t(~K: N.Num, ~W: PO.POps<K>, ~R: PO.PLaws<K, W>, m: NU.PR, +sk: SK.Sketch, +g0: List<&2, S.D>, +cls: List<&2, SV.Class>, +pins: List<&2, Nat>) -> {DWF.accept2(~K, ~W, GM.hpr(~K, ~PO.hom(K, W, R), m), sk, g0, cls, pins) == DSO.accept2(m, sk, g0, cls, pins) : Bool}:
  match m:
    case NU.POk{NU.NP{+plan, +gc, +gr}}:
      final2_c(~K, ~W, ~R, sk, g0, True{}, cls, pins, gc, gr, plan)
    case NU.PRetry{}:
      {==}
    case NU.PStop{}:
      {==}

