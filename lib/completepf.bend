# The plan checks
# ---------------

def pinz_kt(n: Nat, u: List<&2, S.D>) -> {PL.pinz(~KI.dnum(), n, PL.ktake(~KI.dnum(), n, u)) == PL.pinz(~KI.dnum(), n, u) : Bool}:
  match n u:
    case 0n u:
      {==}
    case 1n+k Nil{}:
      {==}
    case 1n+k Con{r, t}:
      %Equal.sym(Bool, PL.pinz(~KI.dnum(), k, PL.ktake(~KI.dnum(), k, t)), PL.pinz(~KI.dnum(), k, t), pinz_kt(k, t)) : {KA.band(PL.keq(~KI.dnum(), r, N.nzero(KI.dnum())), _) == KA.band(PL.keq(~KI.dnum(), r, N.nzero(KI.dnum())), PL.pinz(~KI.dnum(), k, t)) : Bool}
      {==}

def pinz_dreps(n: Nat) -> {PL.pinz(~KI.dnum(), n, NU.dreps(n, NU.dzero())) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n++m:
      AP.band_t(PL.keq(~KI.dnum(), NU.dzero(), N.nzero(KI.dnum())), PL.pinz(~KI.dnum(), m, NU.dreps(m, NU.dzero())), {==}, pinz_dreps(m))

def pinz_of(+n: Nat, +u: List<&2, S.D>, h: {PL.ktake(~KI.dnum(), n, u) == NU.dreps(n, NU.dzero()) : List<&2, S.D>}) -> {PL.pinz(~KI.dnum(), n, u) == True{} : Bool}:
  %pinz_kt(n, u) : {_ == True{} : Bool}
  %Equal.sym(List<&2, S.D>, PL.ktake(~KI.dnum(), n, u), NU.dreps(n, NU.dzero()), h) : {PL.pinz(~KI.dnum(), n, _) == True{} : Bool}
  pinz_dreps(n)

def kvle_nil(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +grf: List<&2, S.D>, hrn: FV.rnn(~F, M.ofdv(~F, grf))) -> {KA.kvle(~KI.dnum(), Nil{}, grf) == True{} : Bool}:
  AP.kvle_of(~KI.dnum(), ~F, ~H, Nil{}, grf, (%Equal.sym(M.Vec(~F), N.ofkv(~KI.dnum(), ~F, ~H, grf), M.ofdv(~F, grf), AP.ofkv_d(~F, ~H, grf)) : FV.rle(~F, Nil{}, _)
    hrn))

