def pin_zero(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +x: M.Vec(~F), +g: List<&2, S.D>, +g0: List<&2, S.D>, +v: Nat, +h1: {O.lookup(~F, x, v) == O.lookup(~F, N.ofkv(~KI.dnum(), ~F, ~H, g0), v) : O.C(F)}, +h2: {O.lookup(~F, N.ofkv(~KI.dnum(), ~F, ~H, g), v) == O.lookup(~F, N.ofkv(~KI.dnum(), ~F, ~H, g0), v) : O.C(F)}) -> M.bnd(~F, O.sub(~F, O.lookup(~F, x, v), M.ofd(~F, NU.dlook(g, v))), M.ofd(~F, NU.dzero())):
  %DM.ofd_zero(~F) : M.bnd(~F, O.sub(~F, O.lookup(~F, x, v), M.ofd(~F, NU.dlook(g, v))), _)
  %Equal.sym(O.C(F), O.sub(~F, O.lookup(~F, x, v), M.ofd(~F, NU.dlook(g, v))), O.zero(F), FO.sub_of_eq(~F, O.lookup(~F, x, v), M.ofd(~F, NU.dlook(g, v)), Equal.trans(O.C(F), O.lookup(~F, x, v), O.lookup(~F, N.ofkv(~KI.dnum(), ~F, ~H, g0), v), M.ofd(~F, NU.dlook(g, v)), h1, Equal.trans(O.C(F), O.lookup(~F, N.ofkv(~KI.dnum(), ~F, ~H, g0), v), O.lookup(~F, N.ofkv(~KI.dnum(), ~F, ~H, g), v), M.ofd(~F, NU.dlook(g, v)), Equal.sym(O.C(F), O.lookup(~F, N.ofkv(~KI.dnum(), ~F, ~H, g), v), O.lookup(~F, N.ofkv(~KI.dnum(), ~F, ~H, g0), v), h2), PB.lk_kv(~F, ~H, g, v))))) : M.bnd(~F, _, O.zero(F))
  FM.bnd_zero(~F, O.zero(F), FO.le_refl(~F, O.zero(F)))

def pin_g(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +nv: Nat, +v: Nat, +g: List<&2, S.D>, +x: M.Vec(~F), +d: O.C(F), +pins: List<&2, Nat>, +g0: List<&2, S.D>, +hm: {SV.mem(v, pins) == True{} : Bool}, +hv: {KA.natle(1n+v, nv) == True{} : Bool}, +hN: SV.Near(~KI.dnum(), ~F, ~H, nv, 0n, g, x, d, pins, g0)) -> {O.lookup(~F, N.ofkv(~KI.dnum(), ~F, ~H, g), v) == O.lookup(~F, N.ofkv(~KI.dnum(), ~F, ~H, g0), v) : O.C(F)}:
  %hm : SV.Near.go(~KI.dnum(), ~F, ~H, _, g, x, d, g0, v)
  PB.near_at(~F, ~H, nv, 0n, v, g, x, d, pins, g0, {==}, hv, hN)

# |x - g| <= 0 at every pin
def pins_rb(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +nv: Nat, +g: List<&2, S.D>, +x: M.Vec(~F), +d: O.C(F), +pins: List<&2, Nat>, +g0: List<&2, S.D>, +hN: SV.Near(~KI.dnum(), ~F, ~H, nv, 0n, g, x, d, pins, g0), ws: List<&2, Nat>, +hs: {L.subl(ws, pins) == True{} : Bool}, +hb: {SV.below(ws, nv) == True{} : Bool}, hpa: SV.PinnedAt(~KI.dnum(), ~F, ~H, x, ws, g0)) -> BX.rbnd(~F, BX.vsub(~F, LC.xperm(~F, x, ws), M.ofdv(~F, NU.dpick(g, ws))), M.ofdv(~F, NU.dreps(ST.len(ws), NU.dzero()))):
  match ws:
    case Nil{}:
      Unit{}
    case Con{+v, +t}:
      match hpa:
        case (h1, ht):
          (pin_zero(~F, ~H, x, g, g0, v, h1, pin_g(~F, ~H, nv, v, g, x, d, pins, g0, L.subl_hd(v, t, pins, hs), (%L.lt_sv(v, nv) : {_ == True{} : Bool}
            L.band_l(SV.lt(v, nv), SV.below(t, nv), hb)), hN)),
          pins_rb(~F, ~H, nv, g, x, d, pins, g0, hN, t, L.subl_tl(v, t, pins, hs), L.band_r(SV.lt(v, nv), SV.below(t, nv), hb), ht))

def kt_eq(+u: List<&2, S.D>, +n: Nat, +h: {KA.klen(~KI.dnum(), u) == n : Nat}) -> {PL.ktake(~KI.dnum(), n, u) == u : List<&2, S.D>}:
  %h : {PL.ktake(~KI.dnum(), _, u) == u : List<&2, S.D>}
  PB.kt_len(~KI.dnum(), u)

def rnn_dreps(~F: O.OField, n: Nat) -> FV.rnn(~F, M.ofdv(~F, NU.dreps(n, NU.dzero()))):
  match n:
    case 0n:
      Unit{}
    case 1n+m:
      ((%DM.ofd_zero(~F) : O.le(~F, O.zero(F), _)
        FO.le_refl(~F, O.zero(F))), rnn_dreps(~F, m))

def vb_dreps(~F: O.OField, n: Nat, +c: O.C(F), +hc: O.le(~F, O.zero(F), c)) -> M.vbnd.all(~F, M.ofdv(~F, NU.dreps(n, NU.dzero())), c):
  match n:
    case 0n:
      Unit{}
    case 1n+m:
      ((%DM.ofd_zero(~F) : M.bnd(~F, _, c)
        FM.bnd_zero(~F, c, hc)), vb_dreps(~F, m, c, hc))


