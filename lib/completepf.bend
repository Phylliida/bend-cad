# with room at x, every side condition checks over the box
def sides_of(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +box: List<&2, KB.KB<KI.dnum()>>, +rho: O.C(F), +bb: O.C(F), +hr: O.le(~F, O.zero(F), rho), +hb: O.le(~F, O.zero(F), bb), +hg: BP.gbox(~KI.dnum(), ~F, ~H, rho, bb, box), +x: M.Vec(~F), +hx: KB.inbox(~KI.dnum(), ~F, ~H, x, box), ss: List<&2, SK.Side>, +hd: {SV.dysides(ss) == True{} : Bool}, +hs: SBud(~F, bb, rho, x, ss)) -> {PL.sides_ok(~KI.dnum(), box, ss) == True{} : Bool}:
  match ss:
    case Nil{}:
      {==}
    case Con{SK.Gt0{+e}, +t}:
      +hh = held_e(e, L.band_l(SV.dyconst(e), SV.dysides(t), hd))
      AP.band_t(PL.side_ok(~KI.dnum(), box, SK.Gt0{e}), PL.sides_ok(~KI.dnum(), box, t), AP.band_t(KB.held(~KI.dnum(), e), KA.klt(~KI.dnum(), N.nzero(KI.dnum()), KA.ksub(~KI.dnum(), KB.KB.c(KI.dnum(), KB.kball(~KI.dnum(), box, e)), KB.KB.r(KI.dnum(), KB.kball(~KI.dnum(), box, e)))), hh, gt_ok(~F, ~H, box, rho, bb, hr, hb, hg, x, hx, e, hh, AP.both_l(O.lt(F, O.add(F, O.mul(F, BP.lp(~F, bb, e), rho), O.mul(F, BP.lp(~F, bb, e), rho)), O.eval(~F, x, e)), SBud(~F, bb, rho, x, t), hs))), sides_of(~F, ~H, box, rho, bb, hr, hb, hg, x, hx, t, L.band_r(SV.dyconst(e), SV.dysides(t), hd), AP.both_r(O.lt(F, O.add(F, O.mul(F, BP.lp(~F, bb, e), rho), O.mul(F, BP.lp(~F, bb, e), rho)), O.eval(~F, x, e)), SBud(~F, bb, rho, x, t), hs)))
    case Con{SK.Ge0{+e}, +t}:
      +hh = held_e(e, L.band_l(SV.dyconst(e), SV.dysides(t), hd))
      AP.band_t(PL.side_ok(~KI.dnum(), box, SK.Ge0{e}), PL.sides_ok(~KI.dnum(), box, t), AP.band_t(KB.held(~KI.dnum(), e), KA.kle(~KI.dnum(), N.nzero(KI.dnum()), KA.ksub(~KI.dnum(), KB.KB.c(KI.dnum(), KB.kball(~KI.dnum(), box, e)), KB.KB.r(KI.dnum(), KB.kball(~KI.dnum(), box, e)))), hh, ge_ok(~F, ~H, box, rho, bb, hr, hb, hg, x, hx, e, hh, AP.both_l(O.le(~F, O.add(F, O.mul(F, BP.lp(~F, bb, e), rho), O.mul(F, BP.lp(~F, bb, e), rho)), O.eval(~F, x, e)), SBud(~F, bb, rho, x, t), hs))), sides_of(~F, ~H, box, rho, bb, hr, hb, hg, x, hx, t, L.band_r(SV.dyconst(e), SV.dysides(t), hd), AP.both_r(O.le(~F, O.add(F, O.mul(F, BP.lp(~F, bb, e), rho), O.mul(F, BP.lp(~F, bb, e), rho)), O.eval(~F, x, e)), SBud(~F, bb, rho, x, t), hs)))

# Marking constraints driven only drops side conditions
# ----------------------------------------------------

def ds_l(a: List<&2, SK.Side>, +b: List<&2, SK.Side>, +h: {SV.dysides(SK.cats(a, b)) == True{} : Bool}) -> {SV.dysides(a) == True{} : Bool}:
  match a:
    case Nil{}:
      {==}
    case Con{SK.Gt0{+e}, +t}:
      L.band_i(SV.dyconst(e), SV.dysides(t), L.band_l(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h), ds_l(t, b, L.band_r(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h)))
    case Con{SK.Ge0{+e}, +t}:
      L.band_i(SV.dyconst(e), SV.dysides(t), L.band_l(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h), ds_l(t, b, L.band_r(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h)))

def ds_r(a: List<&2, SK.Side>, +b: List<&2, SK.Side>, +h: {SV.dysides(SK.cats(a, b)) == True{} : Bool}) -> {SV.dysides(b) == True{} : Bool}:
  match a:
    case Nil{}:
      h
    case Con{SK.Gt0{+e}, +t}:
      ds_r(t, b, L.band_r(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h))
    case Con{SK.Ge0{+e}, +t}:
      ds_r(t, b, L.band_r(SV.dyconst(e), SV.dysides(SK.cats(t, b)), h))

def ds_cat(a: List<&2, SK.Side>, +b: List<&2, SK.Side>, +ha: {SV.dysides(a) == True{} : Bool}, +hb: {SV.dysides(b) == True{} : Bool}) -> {SV.dysides(SK.cats(a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{SK.Gt0{+e}, +t}:
      L.band_i(SV.dyconst(e), SV.dysides(SK.cats(t, b)), L.band_l(SV.dyconst(e), SV.dysides(t), ha), ds_cat(t, b, L.band_r(SV.dyconst(e), SV.dysides(t), ha), hb))
    case Con{SK.Ge0{+e}, +t}:
      L.band_i(SV.dyconst(e), SV.dysides(SK.cats(t, b)), L.band_l(SV.dyconst(e), SV.dysides(t), ha), ds_cat(t, b, L.band_r(SV.dyconst(e), SV.dysides(t), ha), hb))

def ds_go(+es: List<&2, SK.Ent>, +id: Nat, b: Bool, +k: SK.Constraint, +rest: List<&2, SK.Rec>, +ha: {SV.dysides(SK.Constraint.sides(es, k)) == True{} : Bool}, +hr: {SV.dysides(SK.Sketch.sides.cons(es, rest)) == True{} : Bool}) -> {SV.dysides(SK.Sketch.sides.cons(es, Con{SK.Rec{id, b, k}, rest})) == True{} : Bool}:
  match b:
    case True{}:
      hr
    case False{}:
      ds_cat(SK.Constraint.sides(es, k), SK.Sketch.sides.cons(es, rest), ha, hr)

def ds_mark(+es: List<&2, SK.Ent>, +red: List<&2, Nat>, cs: List<&2, SK.Rec>, +i: Nat, +h: {SV.dysides(SK.Sketch.sides.cons(es, cs)) == True{} : Bool}) -> {SV.dysides(SK.Sketch.sides.cons(es, SV.mark.cons(red, cs, i))) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case Con{SK.Rec{+id, True{}, +k}, +t}:
      ds_mark(es, red, t, 1n+i, h)
    case Con{SK.Rec{+id, False{}, +k}, +t}:
      ds_go(es, id, SV.mem(i, red), k, SV.mark.cons(red, t, 1n+i), ds_l(SK.Constraint.sides(es, k), SK.Sketch.sides.cons(es, t), h), ds_mark(es, red, t, 1n+i, ds_r(SK.Constraint.sides(es, k), SK.Sketch.sides.cons(es, t), h)))

def ds_sk(+red: List<&2, Nat>, sk: SK.Sketch, +h: {SV.dysides(SK.Sketch.sides(sk)) == True{} : Bool}) -> {SV.dysides(SK.Sketch.sides(SV.mark(red, sk))) == True{} : Bool}:
  match sk:
    case SK.Sketch{vs, +es, +cs}:
      ds_cat(SK.Sketch.sides.ents(es), SK.Sketch.sides.cons(es, SV.mark.cons(red, cs, 0n)), ds_l(SK.Sketch.sides.ents(es), SK.Sketch.sides.cons(es, cs), h), ds_mark(es, red, cs, 0n, ds_r(SK.Sketch.sides.ents(es), SK.Sketch.sides.cons(es, cs), h)))

# The read-back box is graded and holds x
# ---------------------------------------

def sposl(n: Nat, +k: Nat, +vp: List<&2, Nat>) -> List<&2, Nat>:
  match n:
    case 0n:
      Nil{}
    case 1n+m:
      Con{ST.pos(k, vp), sposl(m, 1n+k, vp)}

# reading back is picking at the variables' positions
def up_pick(n: Nat, +k: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>) -> {NU.unperm(n, k, u, vp) == NU.dpick(u, sposl(n, k, vp)) : List<&2, S.D>}:
  match n:
    case 0n:
      {==}
    case 1n+m:
      %up_pick(m, 1n+k, u, vp) : {Con{NU.dlook(u, ST.pos(k, vp)), NU.unperm(m, 1n+k, u, vp)} == Con{NU.dlook(u, ST.pos(k, vp)), _} : List<&2, S.D>}
      {==}

def up_rnn(~F: O.OField, +n: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>, +h: FV.rnn(~F, M.ofdv(~F, u))) -> FV.rnn(~F, M.ofdv(~F, NU.unperm(n, 0n, u, vp))):
  %Equal.sym(List<&2, S.D>, NU.unperm(n, 0n, u, vp), NU.dpick(u, sposl(n, 0n, vp)), up_pick(n, 0n, u, vp)) : FV.rnn(~F, M.ofdv(~F, _))
  PB.rnn_pick(~F, u, sposl(n, 0n, vp), h)

def up_vall(~F: O.OField, +n: Nat, +u: List<&2, S.D>, +vp: List<&2, Nat>, +c: O.C(F), +hc: O.le(~F, O.zero(F), c), +h: M.vbnd.all(~F, M.ofdv(~F, u), c)) -> M.vbnd.all(~F, M.ofdv(~F, NU.unperm(n, 0n, u, vp)), c):
  %Equal.sym(List<&2, S.D>, NU.unperm(n, 0n, u, vp), NU.dpick(u, sposl(n, 0n, vp)), up_pick(n, 0n, u, vp)) : M.vbnd.all(~F, M.ofdv(~F, _), c)
  PB.vall_pick(~F, u, sposl(n, 0n, vp), c, hc, h)

def vk_of(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +u: List<&2, S.D>, +c: O.C(F), h: M.vbnd.all(~F, M.ofdv(~F, u), c)) -> M.vbnd.all(~F, N.ofkv(~KI.dnum(), ~F, ~H, u), c):
  %Equal.sym(M.Vec(~F), N.ofkv(~KI.dnum(), ~F, ~H, u), M.ofdv(~F, u), AP.ofkv_d(~F, ~H, u)) : M.vbnd.all(~F, _, c)
  h

def rk_of(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +u: List<&2, S.D>, h: FV.rnn(~F, M.ofdv(~F, u))) -> FV.rnn(~F, N.ofkv(~KI.dnum(), ~F, ~H, u)):
  %Equal.sym(M.Vec(~F), N.ofkv(~KI.dnum(), ~F, ~H, u), M.ofdv(~F, u), AP.ofkv_d(~F, ~H, u)) : FV.rnn(~F, _)
  h

# |d| <= r <= c entrywise gives |d| <= c
def rbv(~F: O.OField, d: M.Vec(~F), r: M.Vec(~F), +c: O.C(F), +h: BX.rbnd(~F, d, r), +hr: M.vbnd.all(~F, r, c), +hl: {M.len(~F, d) == M.len(~F, r) : Nat}) -> M.vbnd.all(~F, d, c):
  match d r:
    case Nil{} r:
      Unit{}
    case Con{a, t} Nil{}:
      absurd(M.vbnd.all(~F, Con{a, t}, c), FV.succ_ne(M.len(~F, t), hl))
    case Con{+a, +t} Con{+s, +rs}:
      (FM.bnd_mono(~F, a, s, c, AP.both_l(M.bnd(~F, a, s), BX.rbnd(~F, t, rs), h), AP.both_l(O.le(~F, O.zero(F), O.sub(~F, c, s)), O.le(~F, O.zero(F), O.add(F, c, s)), AP.both_l(M.bnd(~F, s, c), M.vbnd.all(~F, rs, c), hr))),
      rbv(~F, t, rs, c, AP.both_r(M.bnd(~F, a, s), BX.rbnd(~F, t, rs), h), AP.both_r(M.bnd(~F, s, c), M.vbnd.all(~F, rs, c), hr), FV.succ_inj(M.len(~F, t), M.len(~F, rs), hl)))

def rb_of(~F: O.OField, ~H: N.Emb<KI.dnum(), F>, +sk: SK.Sketch, +ha: {D.adjb(ST.adj(SK.Sketch.eqs(sk)), SO.nvars(sk)) == True{} : Bool}, +x: M.Vec(~F), +gcf: List<&2, S.D>, +grf: List<&2, S.D>, +hlc: {KA.klen(~KI.dnum(), gcf) == SO.nvars(sk) : Nat}, +hlr: {KA.klen(~KI.dnum(), grf) == SO.nvars(sk) : Nat}, hpb: PP.pbox(~KI.dnum(), ~F, ~H, gcf, grf, SO.nvars(sk), LC.xperm(~F, x, ST.app(ST.KD.red(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))), ST.allvars(SP.kblocks(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk), ST.KD.vm(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))), ST.KD.red(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))))))))) -> BX.rbnd(~F, BX.vsub(~F, LC.xperm(~F, x, ST.app(ST.KD.red(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))), ST.allvars(SP.kblocks(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk), ST.KD.vm(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))), ST.KD.red(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))))))), M.ofdv(~F, gcf)), M.ofdv(~F, grf)):
  %AP.ofkv_d(~F, ~H, gcf) : BX.rbnd(~F, BX.vsub(~F, LC.xperm(~F, x, ST.app(ST.KD.red(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))), ST.allvars(SP.kblocks(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk), ST.KD.vm(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))), ST.KD.red(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))))))), _), M.ofdv(~F, grf))
  %AP.ofkv_d(~F, ~H, grf) : BX.rbnd(~F, BX.vsub(~F, LC.xperm(~F, x, ST.app(ST.KD.red(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))), ST.allvars(SP.kblocks(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk), ST.KD.vm(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))), ST.KD.red(MX.kvs(ST.adj(SK.Sketch.eqs(sk)), ST.len.q(SK.Sketch.eqs(sk)), SO.nvars(sk), SO.good_of(sk))))))), N.ofkv(~KI.dnum(), ~F, ~H, gcf)), _)
