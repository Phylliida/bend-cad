      {==}

def mlen_ysig(+b: Nat, a: List<&2, List<&2, S.D>>) -> {CK.mlen(~KI.dnum(), NU.ysig(b, a)) == CK.mlen(~KI.dnum(), a) : Nat}:
  match a:
    case Nil{}:
      {==}
    case Con{r, t}:
      %Equal.sym(Nat, CK.mlen(~KI.dnum(), NU.ysig(b, t)), CK.mlen(~KI.dnum(), t), mlen_ysig(b, t)) : {1n+_ == 1n+CK.mlen(~KI.dnum(), t) : Nat}
      {==}


