# The block's outcome
# -------------------
# BOk of a certificate the checker accepts, whose box holds x_b, radii
# in [0, rb].

def bgc(~F: O.OField, +n: Nat, +eqs: List<&2, E.QExpr>, +xb: M.Vec(~F), +rb: O.C(F), c: C.Cert<KI.dnum()>) -> Data:
  match c:
    case C.Cert{+yc, +yr, +q, +ym, +pc, +pr}:
      M.Both({CK.check(~KI.dnum(), C.Block{eqs, n}, C.Cert{yc, yr, q, ym, pc, pr}) == True{} : Bool}, M.Both(BX.rbnd(~F, BX.vsub(~F, xb, M.ofdv(~F, yc)), M.ofdv(~F, yr)), M.Both(FV.rnn(~F, M.ofdv(~F, yr)), M.vbnd.all(~F, M.ofdv(~F, yr), rb))))

def bgood(~F: O.OField, +n: Nat, +eqs: List<&2, E.QExpr>, +xb: M.Vec(~F), +rb: O.C(F), br: NU.BR) -> Data:
  match br:
    case NU.BOk{c}:
      bgc(~F, n, eqs, xb, rb, c)
    case NU.BRetry{}:
      Empty
    case NU.BStop{}:
      Empty

def rbnd_vall(~F: O.OField, v: M.Vec(~F), +n: Nat, +t: O.C(F), lv: {M.len(~F, v) == n : Nat}, h: M.vbnd.all(~F, v, t)) -> BX.rbnd(~F, v, RD.frep(~F, n, t)):
  match v n:
    case Nil{} n:
      Unit{}
    case Con{+a, +as} 0n:
      FO.absurd(BX.rbnd(~F, Con{a, as}, RD.frep(~F, 0n, t)), FV.succ_ne(M.len(~F, as), lv))
    case Con{+a, +as} 1n++k:
      (h1, h2) = h
      (h1, rbnd_vall(~F, as, k, t, FV.succ_inj(M.len(~F, as), k, lv), h2))


