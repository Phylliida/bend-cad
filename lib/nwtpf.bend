# |(a - b) - a| <= |b|
def back_at(~F: O.OField, +a: M.Vec(~F), +b: M.Vec(~F), +k: Nat) -> M.bnd(~F, O.lookup(~F, BX.vsub(~F, BX.vsub(~F, a, b), a), k), NP.vn(~F, b)):
  %Equal.sym(O.C(F), O.lookup(~F, BX.vsub(~F, BX.vsub(~F, a, b), a), k), O.sub(~F, O.lookup(~F, BX.vsub(~F, a, b), k), O.lookup(~F, a, k)), DG.look_diff(~F, BX.vsub(~F, a, b), a, k)) : M.bnd(~F, _, NP.vn(~F, b))
  %Equal.sym(O.C(F), O.lookup(~F, BX.vsub(~F, a, b), k), O.sub(~F, O.lookup(~F, a, k), O.lookup(~F, b, k)), DG.look_diff(~F, a, b, k)) : M.bnd(~F, O.sub(~F, _, O.lookup(~F, a, k)), NP.vn(~F, b))
  KB.bnd_val(~F, O.neg(F, O.lookup(~F, b, k)), O.sub(~F, O.sub(~F, O.lookup(~F, a, k), O.lookup(~F, b, k)), O.lookup(~F, a, k)), NP.vn(~F, b), FR.fring_eq(~F, [O.lookup(~F, a, k), O.lookup(~F, b, k)], E.ZNeg{E.ZVar{1n}}, E.ZSub{E.ZSub{E.ZVar{0n}, E.ZVar{1n}}, E.ZVar{0n}}, {==}), FM.bnd_neg(~F, O.lookup(~F, b, k), NP.vn(~F, b), AP.lkb(~F, b, k)))

def vn_back(~F: O.OField, +a: M.Vec(~F), +b: M.Vec(~F)) -> O.le(~F, NP.vn(~F, BX.vsub(~F, BX.vsub(~F, a, b), a)), NP.vn(~F, b)):
  FV.vmax_lub(~F, BX.vsub(~F, BX.vsub(~F, a, b), a), NP.vn(~F, b), DG.vall_by(~F, ~BX.vsub(~F, BX.vsub(~F, a, b), a), ~NP.vn(~F, b), ~(k => back_at(~F, a, b, k))), FV.vmax_nn(~F, b))

# entry by entry w = p - q: |w| <= |p| + |q|
def vn_by2s(~F: O.OField, ~w: M.Vec(~F), ~pv: M.Vec(~F), ~qv: M.Vec(~F), ~eq: @k: Nat -> {O.lookup(~F, w, k) == O.sub(~F, O.lookup(~F, pv, k), O.lookup(~F, qv, k)) : O.C(F)}) -> O.le(~F, NP.vn(~F, w), O.add(F, NP.vn(~F, pv), NP.vn(~F, qv))):
