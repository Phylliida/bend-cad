def hnw_nn(~F: O.OField, +p: Nat) -> O.le(~F, O.zero(F), hnw(~F, p)):
  DG.u_nn(~F, 1n+p)

def bt2_nn(~F: O.OField, +b: O.C(F), +hb0: O.le(~F, O.zero(F), b)) -> O.le(~F, O.zero(F), bt2(~F, b)):
