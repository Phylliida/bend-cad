# entry by entry w = -p1 + p2 + p3: |w| <= |p1| + |p2| + |p3|
def vn_by3(~F: O.OField, ~w: M.Vec(~F), ~p1: M.Vec(~F), ~p2: M.Vec(~F), ~p3: M.Vec(~F), ~eq: @k: Nat -> {O.lookup(~F, w, k) == O.add(F, O.add(F, O.neg(F, O.lookup(~F, p1, k)), O.lookup(~F, p2, k)), O.lookup(~F, p3, k)) : O.C(F)}) -> O.le(~F, NP.vn(~F, w), O.add(F, O.add(F, NP.vn(~F, p1), NP.vn(~F, p2)), NP.vn(~F, p3))):
  FV.vmax_lub(~F, w, O.add(F, O.add(F, NP.vn(~F, p1), NP.vn(~F, p2)), NP.vn(~F, p3)), DG.vall_by(~F, ~w, ~O.add(F, O.add(F, NP.vn(~F, p1), NP.vn(~F, p2)), NP.vn(~F, p3)), ~(k => KB.bnd_val(~F, O.add(F, O.add(F, O.neg(F, O.lookup(~F, p1, k)), O.lookup(~F, p2, k)), O.lookup(~F, p3, k)), O.lookup(~F, w, k), O.add(F, O.add(F, NP.vn(~F, p1), NP.vn(~F, p2)), NP.vn(~F, p3)), Equal.sym(O.C(F), O.lookup(~F, w, k), O.add(F, O.add(F, O.neg(F, O.lookup(~F, p1, k)), O.lookup(~F, p2, k)), O.lookup(~F, p3, k)), eq(k)),
      FM.bnd_add(~F, O.add(F, O.neg(F, O.lookup(~F, p1, k)), O.lookup(~F, p2, k)), O.add(F, NP.vn(~F, p1), NP.vn(~F, p2)), O.lookup(~F, p3, k), NP.vn(~F, p3), FM.bnd_add(~F, O.neg(F, O.lookup(~F, p1, k)), NP.vn(~F, p1), O.lookup(~F, p2, k), NP.vn(~F, p2), FM.bnd_neg(~F, O.lookup(~F, p1, k), NP.vn(~F, p1), AP.lkb(~F, p1, k)), AP.lkb(~F, p2, k)), AP.lkb(~F, p3, k))))),
